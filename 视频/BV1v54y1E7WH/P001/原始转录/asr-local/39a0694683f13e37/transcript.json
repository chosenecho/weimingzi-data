{
  "bvid": "BV1v54y1E7WH",
  "page": 1,
  "source": "asr-local",
  "language": "Chinese",
  "model": {
    "model_name": "source://production/models/Qwen3-ASR-1.7B-hf",
    "revision": "bcd2b5b7f32b480ab5790554cfa8347f246a14f3"
  },
  "content_sha256": "39a0694683f13e37ca813b2fedb6817f3f774e6ebd304ecf16db56e9bd519d2d",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 77360,
      "end_ms": 83840,
      "text": "沧海笑，滔滔两岸潮，"
    },
    {
      "ordinal": 1,
      "start_ms": 84960,
      "end_ms": 91360,
      "text": "浮沉随浪几今朝。"
    },
    {
      "ordinal": 2,
      "start_ms": 92240,
      "end_ms": 106240,
      "text": "苍天笑，纷纷世上潮，谁负谁胜出天知晓。"
    },
    {
      "ordinal": 3,
      "start_ms": 107040,
      "end_ms": 113360,
      "text": "江山笑，烟雨遥，"
    },
    {
      "ordinal": 4,
      "start_ms": 114480,
      "end_ms": 120880,
      "text": "涛浪淘尽红尘俗世知多少。"
    },
    {
      "ordinal": 5,
      "start_ms": 121760,
      "end_ms": 136240,
      "text": "清风笑，心若寂寥，豪情还剩了一襟晚照。"
    },
    {
      "ordinal": 6,
      "start_ms": 158800,
      "end_ms": 171680,
      "text": "苍生笑，不再寂寥，豪情仍在痴痴笑笑。"
    },
    {
      "ordinal": 7,
      "start_ms": 180884,
      "end_ms": 182724,
      "text": "啦啦啦啦啦，啦"
    },
    {
      "ordinal": 8,
      "start_ms": 184564,
      "end_ms": 200804,
      "text": "啦啦啦啦，啦啦啦啦啦啦啦啦，啦啦啦啦啦啦啦啦，啦啦啦啦啦啦，啦啦啦啦啦啦啦啦，啦啦啦啦啦啦啦啦，啦啦啦啦啦啦啦"
    },
    {
      "ordinal": 9,
      "start_ms": 202084,
      "end_ms": 208679,
      "text": "啦，啦啦啦啦啦啦啦啦，啦啦啦啦啦"
    },
    {
      "ordinal": 10,
      "start_ms": 211977,
      "end_ms": 234084,
      "text": "啦啦啦，他妈这歌叫拉拉之歌，我操，你知道？"
    },
    {
      "ordinal": 11,
      "start_ms": 235524,
      "end_ms": 239684,
      "text": "这歌可以叫拉拉歌，你知道？拉了个屁！"
    },
    {
      "ordinal": 12,
      "start_ms": 241044,
      "end_ms": 243044,
      "text": "我们来看有没有粤语版的。"
    },
    {
      "ordinal": 13,
      "start_ms": 247204,
      "end_ms": 254724,
      "text": "哎呀，粤语版吗？"
    },
    {
      "ordinal": 14,
      "start_ms": 262644,
      "end_ms": 265364,
      "text": "伴奏像屎一样，怎么回事？发生了啥？"
    },
    {
      "ordinal": 15,
      "start_ms": 265364,
      "end_ms": 312452,
      "text": "光搜这一个字。还是你？太糟糕了。应该是这个。下载不了。"
    },
    {
      "ordinal": 16,
      "start_ms": 313124,
      "end_ms": 322324,
      "text": "要找一个那个，找一个粤语版的。哎。"
    },
    {
      "ordinal": 17,
      "start_ms": 325444,
      "end_ms": 336324,
      "text": "但有的下载不了啊。他，嗯。"
    },
    {
      "ordinal": 18,
      "start_ms": 338804,
      "end_ms": 355844,
      "text": "其实粤语版和他伴奏是一模一样的，但是我不认识，记不得词儿了，你知道吗？八二的八二。"
    },
    {
      "ordinal": 19,
      "start_ms": 360421,
      "end_ms": 366741,
      "text": "嗯，算了，好点。"
    },
    {
      "ordinal": 20,
      "start_ms": 366741,
      "end_ms": 385221,
      "text": "感觉在人文区，妈的，唱歌已经是他的容忍的下限了，我靠。"
    },
    {
      "ordinal": 21,
      "start_ms": 407221,
      "end_ms": 414261,
      "text": "太low了，只能这个了，啊，这个这个也不行，听都不能听。"
    },
    {
      "ordinal": 22,
      "start_ms": 433541,
      "end_ms": 436021,
      "text": "他编曲会重新改，因为他没有版权，"
    },
    {
      "ordinal": 23,
      "start_ms": 437461,
      "end_ms": 438981,
      "text": "但同一个公司的。"
    },
    {
      "ordinal": 24,
      "start_ms": 441621,
      "end_ms": 445221,
      "text": "这个编曲太糟糕，太垃圾了。"
    },
    {
      "ordinal": 25,
      "start_ms": 448501,
      "end_ms": 462261,
      "text": "就看这个粤语版。哎，歌词。"
    },
    {
      "ordinal": 26,
      "start_ms": 462261,
      "end_ms": 488821,
      "text": "歌词，歌词差不多呀，没差几个字。嗯。"
    },
    {
      "ordinal": 27,
      "start_ms": 536688,
      "end_ms": 542448,
      "text": "沧海一声笑，滔滔两岸潮。"
    },
    {
      "ordinal": 28,
      "start_ms": 544848,
      "end_ms": 549088,
      "text": "浮情随浪，只记今朝。"
    },
    {
      "ordinal": 29,
      "start_ms": 549248,
      "end_ms": 566688,
      "text": "苍天笑，纷纷世上潮。谁负谁笑？天知晓。"
    },
    {
      "ordinal": 30,
      "start_ms": 566688,
      "end_ms": 573728,
      "text": "江山笑，烟雨遥。"
    },
    {
      "ordinal": 31,
      "start_ms": 575008,
      "end_ms": 579168,
      "text": "头棱头尘，红尘浊世几多娇。"
    },
    {
      "ordinal": 32,
      "start_ms": 579248,
      "end_ms": 586368,
      "text": "清风笑，惊野寂了。"
    },
    {
      "ordinal": 33,
      "start_ms": 586368,
      "end_ms": 623568,
      "text": "旧情还剩了一根晚照。苍生笑，不再寂寥。"
    },
    {
      "ordinal": 34,
      "start_ms": 624608,
      "end_ms": 631408,
      "text": "旧情仍在，痴痴笑笑。"
    },
    {
      "ordinal": 35,
      "start_ms": 631408,
      "end_ms": 718842,
      "text": "啦夜之中，许我倚星辰，"
    },
    {
      "ordinal": 36,
      "start_ms": 720202,
      "end_ms": 730762,
      "text": "从头重读我的心里日记，迟迟才去睡，原因每夜都有你，都有你。"
    },
    {
      "ordinal": 37,
      "start_ms": 730762,
      "end_ms": 737802,
      "text": "你是我全部往昔往年，也是我来日每一天一天。"
    },
    {
      "ordinal": 38,
      "start_ms": 738522,
      "end_ms": 745722,
      "text": "这日记由从前写到目前，偏偏是爱言。"
    },
    {
      "ordinal": 39,
      "start_ms": 745722,
      "end_ms": 754682,
      "text": "愿心中那日记随年变厚，而当中的角色从无分手。"
    },
    {
      "ordinal": 40,
      "start_ms": 755482,
      "end_ms": 758522,
      "text": "齐编织欢笑声和谐诗篇，"
    },
    {
      "ordinal": 41,
      "start_ms": 759722,
      "end_ms": 763002,
      "text": "为彼此抹掉愁是暖的手。"
    },
    {
      "ordinal": 42,
      "start_ms": 763402,
      "end_ms": 770202,
      "text": "愿心中那日记长年暖透，烂灰灰的冷冬，黄黄的秋。"
    },
    {
      "ordinal": 43,
      "start_ms": 770202,
      "end_ms": 780202,
      "text": "而当中的两颗红红的心，在暖火里逗留。"
    },
    {
      "ordinal": 44,
      "start_ms": 782202,
      "end_ms": 799402,
      "text": "人海中只爱你一人，为何遇事我不需说道理？"
    },
    {
      "ordinal": 45,
      "start_ms": 800122,
      "end_ms": 805402,
      "text": "旁人难细多，曾与我昵心那日记。"
    },
    {
      "ordinal": 46,
      "start_ms": 805402,
      "end_ms": 808762,
      "text": "你是我全部往昔往年，也是我来日每一天一天。"
    },
    {
      "ordinal": 47,
      "start_ms": 809322,
      "end_ms": 821562,
      "text": "这日记由从前写到目前，偏偏是爱言。"
    },
    {
      "ordinal": 48,
      "start_ms": 821722,
      "end_ms": 831402,
      "text": "愿心中那日记随年变厚，而当中的角色从无分手。"
    },
    {
      "ordinal": 49,
      "start_ms": 831402,
      "end_ms": 838192,
      "text": "齐编织欢笑声和谐诗篇，为彼此抹掉愁是暖的手。"
    },
    {
      "ordinal": 50,
      "start_ms": 838267,
      "end_ms": 846378,
      "text": "愿心中那日记长年暖透，烂灰灰的冷冬，黄黄的秋。"
    },
    {
      "ordinal": 51,
      "start_ms": 846666,
      "end_ms": 851402,
      "text": "而当中的两颗红红的心，在暖火里逗留。"
    },
    {
      "ordinal": 52,
      "start_ms": 851402,
      "end_ms": 856602,
      "text": "愿心中那日记长年变厚。"
    },
    {
      "ordinal": 53,
      "start_ms": 857162,
      "end_ms": 864682,
      "text": "哎呀，这些小的问题不管了啊，反正我的效率也是有限的啊，这不已经算半会不会的了，不管。"
    },
    {
      "ordinal": 54,
      "start_ms": 873962,
      "end_ms": 877082,
      "text": "这个廖子言二十七啊，仇兵啊，"
    },
    {
      "ordinal": 55,
      "start_ms": 878122,
      "end_ms": 881162,
      "text": "这首歌也是好歌啊，感谢你让我知道这首歌。"
    },
    {
      "ordinal": 56,
      "start_ms": 883002,
      "end_ms": 885722,
      "text": "夜之中，许我倚星辰，"
    },
    {
      "ordinal": 57,
      "start_ms": 887242,
      "end_ms": 890282,
      "text": "从头重读我的心里日记，"
    },
    {
      "ordinal": 58,
      "start_ms": 891322,
      "end_ms": 895882,
      "text": "迟迟才去睡，原因每夜都有你。"
    },
    {
      "ordinal": 59,
      "start_ms": 895882,
      "end_ms": 899562,
      "text": "你是我全部往昔。"
    },
    {
      "ordinal": 60,
      "start_ms": 911225,
      "end_ms": 912905,
      "text": "别管了，一直会错的。"
    },
    {
      "ordinal": 61,
      "start_ms": 913625,
      "end_ms": 930905,
      "text": "这一记，这一记。"
    },
    {
      "ordinal": 62,
      "start_ms": 931106,
      "end_ms": 934121,
      "text": "夜之中，偏爱已消沉。"
    },
    {
      "ordinal": 63,
      "start_ms": 934322,
      "end_ms": 938141,
      "text": "重头重读我的心里日记。"
    },
    {
      "ordinal": 64,
      "start_ms": 938342,
      "end_ms": 944025,
      "text": "迟迟才去睡，原因每夜都有你。"
    },
    {
      "ordinal": 65,
      "start_ms": 944025,
      "end_ms": 952025,
      "text": "你是我全部往昔往年，也是我来日每一天。"
    },
    {
      "ordinal": 66,
      "start_ms": 952905,
      "end_ms": 959545,
      "text": "这日记由从前写到目前，偏偏是爱言。"
    },
    {
      "ordinal": 67,
      "start_ms": 959785,
      "end_ms": 967305,
      "text": "愿心中那日记全年拼凑，而当中的角色从无分手。"
    },
    {
      "ordinal": 68,
      "start_ms": 967305,
      "end_ms": 972985,
      "text": "似编织欢笑声，何还是骗？"
    },
    {
      "ordinal": 69,
      "start_ms": 972985,
      "end_ms": 975785,
      "text": "为彼此抹掉愁，是暖的手。"
    },
    {
      "ordinal": 70,
      "start_ms": 975785,
      "end_ms": 979225,
      "text": "愿心中那日记常年暖"
    },
    {
      "ordinal": 71,
      "start_ms": 981785,
      "end_ms": 984265,
      "text": "透，难灰灰的冷冬，黄黄的秋。"
    },
    {
      "ordinal": 72,
      "start_ms": 984745,
      "end_ms": 988825,
      "text": "而当中的两颗红红"
    },
    {
      "ordinal": 73,
      "start_ms": 990025,
      "end_ms": 992345,
      "text": "的心，在暖锅里逗留。"
    },
    {
      "ordinal": 74,
      "start_ms": 994185,
      "end_ms": 996825,
      "text": "我再唱个二十遍，应该就可以比较掌握它了。"
    },
    {
      "ordinal": 75,
      "start_ms": 996825,
      "end_ms": 998345,
      "text": "那我没有时间啊，不好意思。"
    },
    {
      "ordinal": 76,
      "start_ms": 1000265,
      "end_ms": 1003305,
      "text": "人海中只爱你一人。"
    },
    {
      "ordinal": 77,
      "start_ms": 1003305,
      "end_ms": 1006745,
      "text": "为何遇事我不需说道理？"
    },
    {
      "ordinal": 78,
      "start_ms": 1006745,
      "end_ms": 1018185,
      "text": "哎呦，为何遇事我不需说道理？"
    },
    {
      "ordinal": 79,
      "start_ms": 1018185,
      "end_ms": 1021545,
      "text": "我不我不需说道理。为何遇事我不需说道理？"
    },
    {
      "ordinal": 80,
      "start_ms": 1021545,
      "end_ms": 1023465,
      "text": "我不需说道理。啊啊！"
    },
    {
      "ordinal": 81,
      "start_ms": 1023465,
      "end_ms": 1029225,
      "text": "夜之中，偏爱已消沉。"
    },
    {
      "ordinal": 82,
      "start_ms": 1029225,
      "end_ms": 1035605,
      "text": "重头重读我的心里日记。"
    },
    {
      "ordinal": 83,
      "start_ms": 1036047,
      "end_ms": 1054025,
      "text": "迟迟才去睡，原因每夜都有你。"
    },
    {
      "ordinal": 84,
      "start_ms": 1054333,
      "end_ms": 1062379,
      "text": "你是我全部往昔往年，也是我来日每一天。"
    },
    {
      "ordinal": 85,
      "start_ms": 1062602,
      "end_ms": 1069865,
      "text": "唱错了，这日记由从前写到目前，偏偏是爱言。"
    },
    {
      "ordinal": 86,
      "start_ms": 1069865,
      "end_ms": 1077465,
      "text": "愿心中那日记全年拼凑，而当中的角色从无分手。"
    },
    {
      "ordinal": 87,
      "start_ms": 1077465,
      "end_ms": 1110256,
      "text": "似不熟练呀，很多是靠回忆，不是靠真的掌握它，就是靠复制复刻性的。"
    },
    {
      "ordinal": 88,
      "start_ms": 1111376,
      "end_ms": 1114496,
      "text": "那个工作记忆不清晰的就会唱错。"
    },
    {
      "ordinal": 89,
      "start_ms": 1114496,
      "end_ms": 1119056,
      "text": "人海中只爱你一人，"
    },
    {
      "ordinal": 90,
      "start_ms": 1120736,
      "end_ms": 1123176,
      "text": "为何遇事我不需说道理？"
    },
    {
      "ordinal": 91,
      "start_ms": 1123236,
      "end_ms": 1129776,
      "text": "红颜难细读，曾与我昵心也你。"
    },
    {
      "ordinal": 92,
      "start_ms": 1129856,
      "end_ms": 1135296,
      "text": "那日记，你是我全部往昔往年，也是我来日每一天。"
    },
    {
      "ordinal": 93,
      "start_ms": 1135536,
      "end_ms": 1145536,
      "text": "这日记由从前写到目前，篇篇是爱言。"
    },
    {
      "ordinal": 94,
      "start_ms": 1146016,
      "end_ms": 1150336,
      "text": "愿心中那日记随你拼"
    },
    {
      "ordinal": 95,
      "start_ms": 1152256,
      "end_ms": 1155216,
      "text": "凑，而当中的角色从无分手。"
    },
    {
      "ordinal": 96,
      "start_ms": 1155536,
      "end_ms": 1166821,
      "text": "齐编织欢笑声，和谐诗篇，为彼此抹掉愁是暖的手。愿他留。"
    },
    {
      "ordinal": 97,
      "start_ms": 1167216,
      "end_ms": 1170336,
      "text": "不能交差，这个我自己都受不了。"
    },
    {
      "ordinal": 98,
      "start_ms": 1172336,
      "end_ms": 1183696,
      "text": "夜之中许我与星辰，重头重读我的心里日记。"
    },
    {
      "ordinal": 99,
      "start_ms": 1183696,
      "end_ms": 1186378,
      "text": "迟迟才去睡，原因每夜都有你。"
    },
    {
      "ordinal": 100,
      "start_ms": 1186509,
      "end_ms": 1190804,
      "text": "你是我全部往昔往年，也是我来日每一天。"
    },
    {
      "ordinal": 101,
      "start_ms": 1190934,
      "end_ms": 1196816,
      "text": "这日记由从前写到目前，篇篇是爱言。"
    },
    {
      "ordinal": 102,
      "start_ms": 1196816,
      "end_ms": 1201936,
      "text": "愿心中那日记随你拼凑，而当中的角色从无分手。齐编织欢笑声，和谐诗篇，为彼此抹掉愁是暖的手。"
    },
    {
      "ordinal": 103,
      "start_ms": 1201936,
      "end_ms": 1203576,
      "text": "愿心中那日记沉凝暖透，蓝灰灰的冷冬，黄黄的秋。"
    },
    {
      "ordinal": 104,
      "start_ms": 1203618,
      "end_ms": 1205936,
      "text": "而当中的冷火，红红的心，在暖火里逗留。"
    },
    {
      "ordinal": 105,
      "start_ms": 1256178,
      "end_ms": 1271298,
      "text": "人海中只系你一人，为何遇事我不需说道理？"
    },
    {
      "ordinal": 106,
      "start_ms": 1271581,
      "end_ms": 1284658,
      "text": "旁人难细度，藏于我内心那日记，底是我全部往昔往年，也是我来日每一天。"
    },
    {
      "ordinal": 107,
      "start_ms": 1286498,
      "end_ms": 1292818,
      "text": "这日记由衷情写到没情，偏偏是爱情。"
    },
    {
      "ordinal": 108,
      "start_ms": 1292898,
      "end_ms": 1298898,
      "text": "愿心中那日记随"
    },
    {
      "ordinal": 109,
      "start_ms": 1302898,
      "end_ms": 1310674,
      "text": "年拼凑，而当中的角色从无分手，似编织欢笑声和谐诗篇，为彼此抹掉愁，是暖的手。"
    },
    {
