{"segments":[{"start":0.24,"end":4.66,"text":"初中小孩说目前在家接单"},{"start":4.66,"end":7.16,"text":"说他患有精神疾病啊"},{"start":7.26,"end":8.99,"text":"我跟你讲这种信"},{"start":8.99,"end":10.04,"text":"回回应起来"},{"start":10.04,"end":13.74,"text":"我都要承担相应的风险的"},{"start":15.72,"end":16.85,"text":"初中的时候"},{"start":16.85,"end":18.74,"text":"班长会因为班主任偏袒"},{"start":18.74,"end":21.68,"text":"做一些对其他同学不公平的事情哦"},{"start":21.68,"end":24.54,"text":"然后呢在一次考试之后"},{"start":24.54,"end":25.86,"text":"组长选组员"},{"start":25.86,"end":27.36,"text":"全班同学都被选完了"},{"start":27.36,"end":30.72,"text":"只剩下他和两个只会在班上讨论的学生"},{"start":30.72,"end":32.46,"text":"有两个组长都想要他"},{"start":32.46,"end":35.67,"text":"他就可以去选择选组长了"},{"start":35.67,"end":37.68,"text":"但是两个选组长都没选"},{"start":37.68,"end":40.239,"text":"他选择他那个班长带的那个组"},{"start":40.239,"end":44.019,"text":"因为那次考试班长比两个组长考的都要好"},{"start":44.019,"end":44.739,"text":"好学生啊"},{"start":44.739,"end":45.219,"text":"班长好"},{"start":45.219,"end":47.22,"text":"学生好好"},{"start":47.86,"end":49.2,"text":"然后呢"},{"start":49.2,"end":52.32,"text":"然后呢有一次另外一个组扫地"},{"start":52.32,"end":54.0,"text":"班长看见有一团纸"},{"start":54.0,"end":55.56,"text":"不知道是另一个组没扫干净"},{"start":55.56,"end":56.04,"text":"还是扫完了"},{"start":56.04,"end":57.09,"text":"后面有人不想掉"},{"start":57.09,"end":60.8,"text":"不小心掉的就惩罚另一个组扫一个星期的地"},{"start":60.8,"end":62.12,"text":"班长权力这么大吗"},{"start":62.12,"end":63.32,"text":"班长是你帮皇帝啊"},{"start":63.32,"end":64.94,"text":"我靠叫人家扫一个星期的地"},{"start":64.94,"end":67.19,"text":"另一个组就和我们组产生了争执"},{"start":67.19,"end":69.63,"text":"班主任就来了"},{"start":69.63,"end":72.03,"text":"就叫我们组合另一个组的人蹲在地上"},{"start":72.03,"end":74.22,"text":"他坐在桌子上"},{"start":74.22,"end":76.68,"text":"把另一个组的人批评了一顿"},{"start":76.68,"end":78.99,"text":"内心十分气愤"},{"start":78.99,"end":80.31,"text":"边笑边哭"},{"start":80.31,"end":83.43,"text":"因为在我们组扫地的时候更不干净"},{"start":83.43,"end":86.37,"text":"地上经常有一些渣滓"},{"start":88.14,"end":90.8,"text":"班主任批评完之后就去找了一些"},{"start":90.8,"end":92.78,"text":"找班主任说了一些我的想法"},{"start":92.78,"end":94.7,"text":"大意就是每次都偏袒班长"},{"start":94.7,"end":96.78,"text":"从来不批评他是不公平的"},{"start":96.78,"end":100.98,"text":"班主任说他想让班长成为一个无所畏惧的人"},{"start":100.98,"end":102.24,"text":"当然是无所畏惧啊"},{"start":102.24,"end":103.789,"text":"嚣张跋扈的"},{"start":103.789,"end":106.069,"text":"然后他就说这对其他人不公平"},{"start":106.069,"end":108.199,"text":"然后这个班主任就觉得"},{"start":108.199,"end":110.699,"text":"这个写信的人很有正义感"},{"start":110.699,"end":112.439,"text":"让他另眼相看了"},{"start":112.439,"end":113.729,"text":"对话完成之后"},{"start":113.729,"end":119.24,"text":"他这个班主任说他会好好批评一次班长"},{"start":120.23,"end":123.49,"text":"在那之后他的偏袒似乎转移到了我身上啊"},{"start":123.49,"end":125.05,"text":"就这个班主任不偏袒班长了"},{"start":125.05,"end":127.969,"text":"开始偏袒写信的这个人了啊"},{"start":127.969,"end":130.249,"text":"我就再次用第一人称说啊"},{"start":130.249,"end":131.569,"text":"那时我们班上所有人"},{"start":131.569,"end":133.97,"text":"对这个班主任都有崇拜的情感"},{"start":133.97,"end":136.97,"text":"一个他妈的高中老师"},{"start":136.97,"end":137.75,"text":"初中老师"},{"start":137.75,"end":138.35,"text":"小班主任"},{"start":138.35,"end":140.94,"text":"小老师"},{"start":140.94,"end":142.38,"text":"他崇拜我"},{"start":142.38,"end":144.3,"text":"靠学生都去崇拜他了"},{"start":144.3,"end":145.02,"text":"男的啊"},{"start":145.02,"end":148.26,"text":"男的写这个信的人可能也是个女性啊"},{"start":148.26,"end":152.16,"text":"一群一群初中女生都去崇拜什么小班主任呢"},{"start":152.16,"end":154.709,"text":"我靠他真的混得开"},{"start":154.709,"end":155.729,"text":"混的牛逼"},{"start":155.729,"end":157.349,"text":"有权有势做班主任"},{"start":157.349,"end":164.74,"text":"我靠他们班主任自己都调侃的是什么什么"},{"start":166.34,"end":167.98,"text":"就跟什么什么一样的"},{"start":167.98,"end":168.73,"text":"是什么"},{"start":168.73,"end":171.89,"text":"有那个什么顺口溜是什么"},{"start":172.47,"end":175.76,"text":"怎么考"},{"start":175.76,"end":176.6,"text":"考状元"},{"start":176.6,"end":178.67,"text":"考的最挫的就进士"},{"start":178.67,"end":180.209,"text":"最挫的去做县令"},{"start":180.209,"end":181.229,"text":"然后做县令"},{"start":181.229,"end":184.589,"text":"做的最挫的是最倒霉的是做副郭县的县令"},{"start":184.589,"end":188.44,"text":"就是做那个呃那个更上一级"},{"start":188.44,"end":193.09,"text":"辅一级的那个办公所在地的那个县的县令"},{"start":193.09,"end":195.61,"text":"这个这个也是他们那个做教师的"},{"start":195.61,"end":200.36,"text":"也有人说什么最难搞的就是做初中老师"},{"start":200.36,"end":203.36,"text":"初中老师当中最难搞的是做初中班主任"},{"start":203.36,"end":205.52,"text":"最倒霉的是做初中的班主任"},{"start":205.52,"end":209.17,"text":"因为就学学生都是青春期叛逆状态"},{"start":209.17,"end":210.85,"text":"你知道吗"},{"start":215.32,"end":219.11,"text":"好他反正就是说他们班上对班主任都崇拜嗯"},{"start":219.11,"end":221.12,"text":"然后写以老师为题的作文"},{"start":221.12,"end":222.26,"text":"写的都是这个班主任"},{"start":222.26,"end":223.07,"text":"他也不例外"},{"start":223.07,"end":227.33,"text":"他拥护他所有做错事以后给人惩罚啊"},{"start":227.33,"end":228.93,"text":"拥护这班主任啊"},{"start":228.93,"end":229.89,"text":"有人做错事"},{"start":229.89,"end":231.18,"text":"他就会惩罚他"},{"start":231.18,"end":232.95,"text":"包括也会惩罚我"},{"start":232.95,"end":234.21,"text":"有时候也会批判他"},{"start":234.21,"end":237.12,"text":"那次谈话之后对班上的管理有所改观"},{"start":237.12,"end":238.86,"text":"但我越来越感到不对劲"},{"start":238.86,"end":242.68,"text":"我发现班上谁都可以得到袒护或惩罚"},{"start":242.68,"end":244.72,"text":"只在于班主任的个人偏好"},{"start":244.72,"end":246.71,"text":"这让我感到非常非常恐惧"},{"start":246.71,"end":249.71,"text":"因为我正在因为他的袒护变得偏激"},{"start":249.71,"end":251.69,"text":"渐渐的我都不知道我的观点是什么"},{"start":251.69,"end":252.88,"text":"是为什么才表达"},{"start":252.88,"end":254.2,"text":"似乎为了享受权利"},{"start":254.2,"end":255.64,"text":"或者会得到半主认同"},{"start":255.64,"end":261.06,"text":"不是你在学校主要不是应该是学学生吗"},{"start":261.06,"end":263.1,"text":"怎么变成玩权力游戏了"},{"start":263.1,"end":264.24,"text":"宫斗剧看多了"},{"start":264.24,"end":266.13,"text":"这个班主任是什么"},{"start":266.59,"end":267.51,"text":"是什么"},{"start":267.51,"end":269.13,"text":"是什么雍正皇帝耶"},{"start":269.13,"end":272.75,"text":"然后那个是什么嬛嬛什么"},{"start":272.75,"end":277.47,"text":"你在学校不是主要是是要学习吗"},{"start":277.47,"end":278.61,"text":"数学作业"},{"start":278.61,"end":280.83,"text":"每天的课堂作业蛮难的"},{"start":280.83,"end":284.159,"text":"每天的这个回家作业也蛮难的"},{"start":284.159,"end":287.699,"text":"这个物理学实验那个小测验"},{"start":287.699,"end":289.379,"text":"他那个有点操作要领"},{"start":289.379,"end":290.099,"text":"要去记一记"},{"start":290.099,"end":292.12,"text":"要把心思放在这个东西上面"},{"start":292.12,"end":296.23,"text":"一天到晚跟什么班主任怎么样怎么怎么样的"},{"start":296.87,"end":299.53,"text":"然后再知道公平正义并不存在"},{"start":299.53,"end":302.53,"text":"和和不知道我的观点是否正向的"},{"start":302.53,"end":304.69,"text":"这两个思想以后我崩溃了"},{"start":304.69,"end":307.39,"text":"因为一直认为公道正道"},{"start":307.39,"end":308.11,"text":"在人心"},{"start":308.11,"end":309.07,"text":"发现不是那样"},{"start":309.07,"end":310.51,"text":"导致他陷入巨大的恐惧"},{"start":310.51,"end":313.01,"text":"整个人处于一个抑郁的情绪中"},{"start":313.01,"end":314.45,"text":"高中3年没上好"},{"start":314.45,"end":315.35,"text":"读了个大专"},{"start":315.35,"end":316.67,"text":"忍受着极大的痛苦"},{"start":316.67,"end":318.08,"text":"在大三的时候发病"},{"start":318.08,"end":320.06,"text":"然后呢被治疗了啊"},{"start":320.06,"end":322.82,"text":"去反正去治疗了"},{"start":322.82,"end":325.1,"text":"现在吃药情绪很稳定"},{"start":325.1,"end":326.63,"text":"不知道该怎么样才好"},{"start":326.63,"end":331.089,"text":"首先首先这个东西啥呀"},{"start":331.089,"end":333.819,"text":"公平正义本来就是理念和价值"},{"start":333.819,"end":336.099,"text":"理念和价值本来就飘在天上的"},{"start":336.099,"end":340.68,"text":"在现实当中只能尽量的去促成他人知道吧"},{"start":340.68,"end":345.15,"text":"就相当于说你玩那种什么黄色游戏里面的美女"},{"start":345.15,"end":346.77,"text":"都是他妈大腿漂亮的不得了"},{"start":346.77,"end":347.61,"text":"白的不得了的"},{"start":347.61,"end":349.82,"text":"你到现实当中去看那种女人呢"},{"start":349.82,"end":351.26,"text":"那屁股白花花的肉"},{"start":351.26,"end":353.69,"text":"上面总归有点黑黑黑点的"},{"start":353.69,"end":357.47,"text":"那边一个什么总总归多长了几根毛的"},{"start":357.47,"end":359.45,"text":"现实总归是有残缺的嘛"},{"start":359.45,"end":361.31,"text":"对不对"},{"start":362.19,"end":364.88,"text":"对不对哦"},{"start":364.88,"end":367.82,"text":"那男生小时候幻想女人是不拉屎的"},{"start":367.82,"end":370.7,"text":"或者拉出来的屎就直接就是粉红色冰淇淋"},{"start":370.7,"end":372.02,"text":"可以吃的呢"},{"start":372.02,"end":373.4,"text":"你以为"},{"start":375.38,"end":377.74,"text":"但好多小男生知道女性会拉屎"},{"start":377.74,"end":378.22,"text":"也会放"},{"start":378.22,"end":380.83,"text":"屁了之后也崩溃的是吧"},{"