{"segments":[{"start":0.0,"end":1.54,"text":"来讲这个小资的激进化"},{"start":1.54,"end":4.019,"text":"和无产阶级激进化的区别啊"},{"start":4.019,"end":6.8,"text":"我今天已经在现场临场发挥"},{"start":6.8,"end":7.98,"text":"跟他们讲过了"},{"start":7.98,"end":12.1,"text":"小站街的激进化是他要去负极"},{"start":12.1,"end":16.1,"text":"每某种什么被镇压性"},{"start":17.62,"end":20.98,"text":"他有腹肌的抽象属性叫做背镇压器"},{"start":21.47,"end":24.14,"text":"being in surprise的surprise"},{"start":24.14,"end":26.18,"text":"Supreme supreity"},{"start":26.18,"end":28.38,"text":"无人机机进化"},{"start":28.38,"end":31.42,"text":"负极的是反正压性"},{"start":33.88,"end":37.0,"text":"反镇压性及革命性"},{"start":46.6,"end":48.14,"text":"小正义的镇压性"},{"start":48.14,"end":52.76,"text":"负极的就是说他由于小资阶级是无力的"},{"start":52.76,"end":55.6,"text":"他附庸于资本"},{"start":55.6,"end":57.0,"text":"小资本"},{"start":57.0,"end":64.069,"text":"附庸于观念和现实当中的标签"},{"start":64.069,"end":67.189,"text":"人的人与人之间的抽象分类"},{"start":67.189,"end":68.289,"text":"反正虚的东西"},{"start":68.289,"end":70.609,"text":"所以小资总体他就是裸吊"},{"start":70.609,"end":72.16,"text":"就这就是个人"},{"start":72.44,"end":76.46,"text":"也就是说他在进行所谓的反抗过程当中时候"},{"start":76.46,"end":80.05,"text":"小资阶级不带有生产资料的去加以反抗"},{"start":80.05,"end":82.61,"text":"不带有整体纪律的加以反抗"},{"start":82.61,"end":85.87,"text":"然而小资在这是相互之间仇视的"},{"start":86.19,"end":89.55,"text":"小森林是互仇互相仇视的啊"},{"start":89.55,"end":91.31,"text":"总体是没有这个纪律的"},{"start":91.31,"end":94.24,"text":"无组织纪律的啊"},{"start":94.24,"end":96.14,"text":"无组织纪律啊"},{"start":96.14,"end":98.68,"text":"所以他他的反抗"},{"start":100.2,"end":102.06,"text":"是裸吊反抗"},{"start":102.06,"end":104.5,"text":"是人肉反抗"},{"start":104.9,"end":109.82,"text":"他只能采取人肉的肉身化的啊"},{"start":109.82,"end":111.12,"text":"他没有办法形成"},{"start":111.12,"end":114.22,"text":"就是人与人的结合起来形成组织化的"},{"start":114.22,"end":115.18,"text":"他也没办法形成"},{"start":115.18,"end":117.26,"text":"就他也没法跟生产资料结合的"},{"start":117.26,"end":118.54,"text":"说小资的激进化"},{"start":118.54,"end":119.58,"text":"他一定是负极的"},{"start":119.58,"end":121.7,"text":"是被镇压性"},{"start":121.7,"end":124.94,"text":"那么被镇压性它生产出来的就是惨剧"},{"start":124.94,"end":128.419,"text":"他的目的就是生产惨具和景观"},{"start":129.27,"end":133.67,"text":"那把惨剧和景观也就是情感情感"},{"start":133.67,"end":137.07,"text":"我们说这个上讲小资产阶级他的被镇压性"},{"start":137.07,"end":140.63,"text":"它生产惨剧的景观就是生产社会的不安定性"},{"start":150.37,"end":152.25,"text":"你们现在采取的这个是什么"},{"start":152.25,"end":154.709,"text":"拉满了就是造我的黄谣"},{"start":158.949,"end":160.269,"text":"就是等着被镇压嘛呢"},{"start":160.269,"end":164.88,"text":"这些玩意啊等着被取缔或者被等着就消失"},{"start":164.88,"end":167.38,"text":"怎样的往里边啊"},{"start":170.44,"end":174.8,"text":"他是目的是去生成整个社会的不安定性"},{"start":174.8,"end":178.96,"text":"生成的社会不安定性"},{"start":180.58,"end":184.18,"text":"啊然后呢这个污染性极进化产生的是反镇压性"},{"start":184.18,"end":185.58,"text":"或者说我们说的更确切一点"},{"start":185.58,"end":188.06,"text":"应该叫抗震压性"},{"start":188.949,"end":192.9,"text":"无产阶级产生的就是它有抗镇压的"},{"start":192.9,"end":195.78,"text":"对于这个无端的暴力"},{"start":195.78,"end":197.1,"text":"无序的暴力"},{"start":197.1,"end":198.57,"text":"无理的暴力"},{"start":198.57,"end":201.77,"text":"对社会长长远利益有害的暴力"},{"start":201.77,"end":202.97,"text":"他有拮抗作用"},{"start":202.97,"end":204.81,"text":"他就拮抗性啊"},{"start":204.81,"end":206.27,"text":"拮抗的暴力"},{"start":206.27,"end":208.53,"text":"然后那个所以在这个上讲"},{"start":208.53,"end":211.31,"text":"无产阶级激进化同样是他是掌握暴力"},{"start":211.31,"end":212.67,"text":"并且是驾驭暴力的"},{"start":212.67,"end":215.405,"text":"掌握且驾驭暴力"},{"start":230.03,"end":234.37,"text":"使得社会关系当中的镇压是最小暴力原则"},{"start":234.37,"end":238.859,"text":"或者说他能够转化成这个接金量"},{"start":238.859,"end":241.32,"text":"对比着现实的呈现"},{"start":241.72,"end":245.7,"text":"嗯嗯那在局部无产阶级啊"},{"start":245.7,"end":247.58,"text":"他更能够深刻的去"},{"start":247.58,"end":252.42,"text":"或者说这里面就是能够使得镇压被悬置啊"},{"start":252.42,"end":254.46,"text":"能够使得镇压被悬置"},{"start":254.46,"end":256.16,"text":"镇压被悬置起来"},{"start":256.16,"end":258.579,"text":"同时那些观念就失效"},{"start":258.579,"end":260.26,"text":"一旦镇压悬置"},{"start":260.26,"end":261.339,"text":"一切镇压"},{"start":261.339,"end":263.34,"text":"一切观念失效"},{"start":264.07,"end":266.15,"text":"在一切观念失效的情境下"},{"start":267.23,"end":270.51,"text":"谁更能够和生产资料结合"},{"start":271.62,"end":273.46,"text":"谁更善于劳动"},{"start":273.46,"end":279.229,"text":"谁就能够掌握观念重新起效啊"},{"start":279.229,"end":281.389,"text":"镇压关系重新铺落"},{"start":281.389,"end":285.069,"text":"或者统治关系重新铺落之后的国家"},{"start":285.069,"end":287.659,"text":"那么这个过程叫做革命"},{"start":287.939,"end":289.579,"text":"因此无产阶级机进化"},{"start":289.579,"end":293.84,"text":"它一定是会使得自己具有抗争压能力"},{"start":293.84,"end":295.08,"text":"那么在这个意义上讲"},{"start":295.08,"end":296.92,"text":"他是会和组织纪律"},{"start":296.92,"end":301.52,"text":"会和生产资料相结合的"},{"start":301.52,"end":303.1,"text":"通用性生产资料"},{"start":303.1,"end":305.14,"text":"组织纪律相结合"},{"start":306.43,"end":310.15,"text":"通用的这个通用的机器啦"},{"start":310.96,"end":316.4,"text":"你在这个时代还是计算机内燃机这东西啊"},{"start":316.4,"end":318.32,"text":"还有就是组织纪律"},{"start":321.9,"end":326.56,"text":"那么你说这种这种这种良性的拮抗作用"},{"start":326.56,"end":329.22,"text":"它是始终是存在的嗯"},{"start":329.22,"end":332.22,"text":"他会在民间那呈现为这个什么什么"},{"start":332.22,"end":334.09,"text":"什么什么瓦雷本"},{"start":334.41,"end":336.91,"text":"然后还有在理论上来讲呢"},{"start":336.91,"end":343.63,"text":"就是说如果你要促成这个无产级进化"},{"start":343.63,"end":347.22,"text":"那你就是要让他成为上层无产阶级"},{"start":347.5,"end":349.7,"text":"但是你成为上层无产阶级之后"},{"start":349.7,"end":351.4,"text":"你不能小资化"},{"start":351.4,"end":353.74,"text":"你不能进一步变成底层小资产阶级"},{"start":353.74,"end":357.03,"text":"不能底层小资化"},{"start":357.77,"end":360.33,"text":"所以一切工作的重心在于"},{"start":360.33,"end":363.31,"text":"使得上层无产阶级去小资化"},{"start":363.31,"end":368.83,"text":"同时作为一个可以激进化的无产阶级"},{"start":369.23,"end":372.31,"text":"可以和就是说这具有历史正当性的"},{"start":372.31,"end":374.73,"text":"你可以具有历史正当性的"},{"start":374.73,"end":377.07,"text":"在竞争层面啊"},{"start":377.07,"end":379.05,"text":"就是有组织"},{"start":379.05,"end":380.67,"text":"有有有纪律"},{"start":380.67,"end":382.18,"text":"有有技巧"},{"start":382.18,"end":385.65,"text":"有能耐的去啊"},{"start":386.01,"end":390.13,"text":"获得其他无阶级意识"},{"start":399.26,"end":401.62,"text":"的对着小字画的"},{"start":408.09,"end":409.67,"text":"在产业里面卷死他们"},{"start":409.67,"end":410.55,"text":"卷他们的"},{"start":410.55,"end":411.77,"text":"也就是主要的说"},{"start":411.77,"end":415.03,"text":"如果以培训部作为一个运动载体的话"},{"start":415.03,"end":418.5,"text":"主要的功能就是要我们有这意识"},{"start":418.5,"end":419.62,"text":"然后我们更团结"},{"start":419.62,"end":420.72,"text":"我们更有技巧"},{"start":420.72,"end":423.66,"text":"我们在商业活动当中要去呃"},{"start":423.66,"end":426.88,"text":"卷其他的上层无产和底层小资产阶级"},{"start":426.88,"end":429.5,"text":"他们的利益啊"},{"start":429.5,"end":433.66,"text":"以此来使得这么一个无产阶级的这个区间"},{"start":433.66,"end":436.74,"text":"上层无产这个区间当中的无产者"},{"start":436.74,"end":440.12,"text":"更多的是具有阶级意识的无产者啊"},{"start":440.12,"end":441.24,"text":"更多是具有阶级意识"},{"start":441.24,"end":445.12,"text":"更多的是具有团结纪律和这个通用机器"},{"start":445.12,"end":447.289,"text":"武装起来的无产阶级"},{"start":447.649,"end":449.489,"text":"那么这个是基本理论"},{"start":450.769,"end":452.609,"text":"这是基本理论"},{"start":455.94,"end":457.3,"text":"两种极进化理论"},{"start":457.3,"end":461.38,"text":"我们现在明确的看到小战这集的时代激进化哈"},{"start":461.38,"end":463.72,"text":"造黄谣还是拼了命的发那玩意"},{"start":463.72,"end":465.68,"text":"You are radical alization"},{"start":465.68,"end":466.92,"text":"you are radicalizing啊"},{"start":466.92,"end":467.9,"text":"你们是在激进化"},{"start":467.9,"end":471.89,"text":"但是你们的激进化最后就只能生产被镇压性"},{"start":472.25,"end":474.45,"text":"注定就是弱呀"},{"start":474.45,"end":475.09,"text":"惨剧啊"},{"start":475.09,"end":476.26,"text":"景观呀"},{"start":476.26,"end":478.14,"text":"所以你们讲究道德嘛"},{"start":478.14,"end":479.66,"text":"名义上你们讲究道德"},{"start":479.66,"end":481.77,"text":"其实你们不是讲究道德"},{"start":481.77,"end":485.67,"text":"你们是试图以道德主义的方式生产惨剧"},{"start":485.67,"end":487.11,"text":"你们要的不是道德"},{"start":487.11,"end":488.45,"text":"你们从来要的不是道德"},{"start":488.45,"end":490.09,"text":"你们要的是悲剧"},{"start":490.09,"end":491.13,"text":"是惨剧"},{"start":491.13,"end":493.54,"text":"甚至说啊你们要的是惨剧"},{"start":496.16,"end":501.71,"text":"你们试图是动摇瓦解整个国家的士气基础"},{"start":502.33,"end":504.95,"text":"情感凝聚的基础"},{"start":505.47,"end":508.27,"text":"以为这样可以打倒这个什么阶级敌人"},{"start":508.27,"end":510.27,"text":"打倒资产阶级"},{"start":511.799,"end":514.058,"text":"他弄得人心惶惶"},{"start":514.058,"end":516.739,"text":"弄崩了是什么的啊"},{"start":516.739,"end":520.789,"text":"就这样就是这样一种你们的斗争策略"},{"start":524.01,"end":527.62,"text":"所以你们再玩这种基本就是就喜欢这样搞"},{"start":527.62,"end":529.2,"text":"什么网暴带节奏"},{"start":529.2,"end":532.2,"text":"拉满了自己的日子不要过了"},{"start":532.2,"end":534.44,"text":"因为你不忠于无产阶级"},{"start":534.44,"end":538.13,"text":"你只希望持续的生产恐慌"},{"start":538.45,"end":541.61,"text":"这样这恐慌恐慌恐的让这个社会崩盘"},{"start":543.849,"end":545.369,"text":"然后你们自己的内心"},{"start":545.369,"end":548.689,"text":"就是说我用恐慌让这个事"},{"start":548.689,"end":552.54,"text":"你们自诩为在情绪上是无是武装起来的"},{"start":552.54,"end":553.18,"text":"情绪上"},{"start":553.18,"end":554.7,"text":"其实你们这什么义愤填膺"},{"start":554.7,"end":555.84,"text":"全是假装的"},{"start":555.84,"end":557.55,"text":"你真以为别人不知道吗"},{"start":557.55,"end":559.55,"text":"就是说他是伪装的小赞"},{"start":559.55,"end":562.95,"text":"你通过伪装的义愤填膺"},{"start":565.76,"end":567.48,"text":"哇靠英怎么写"},{"start":567.48,"end":568.44,"text":"哇"},{"start":568.44,"end":570.71,"text":"伪装的义愤填膺"},{"start":571.19,"end":573.27,"text":"然后去生产恐慌"},{"start":573.27,"end":575.39,"text":"试图让这种恐慌变成情绪"},{"start":577.23,"end":579.97,"text":"然后形成这个呃动荡了"},{"start":579.97,"end":581.73,"text":"其实希望形成政治动荡"},{"start":581.73,"end":583.26,"text":"形成动荡"},{"start":583.26,"end":585.0,"text":"形成了这样动荡之后"},{"start":585.0,"end":587.9,"text":"由于你是伪装的义愤填膺"},{"start":588.5,"end":590.6,"text":"哎他们就占了先机了"},{"start":590.6,"end":592.32,"text":"占了情趣先机"},{"start":592.32,"end":595.26,"text":"谁不知道你们这些一分钱都是演的嘛"},{"start":595.26,"end":598.69,"text":"你们试图就占据某种情绪的先机"},{"start":598.69,"end":602.61,"text":"你们是第一个恢复什么情绪冷静的"},{"start":602.61,"end":605.48,"text":"然后你们去开展审慎的投机"},{"start":605.76,"end":606.82,"text":"抓住先机"},{"start":606.82,"end":609.08,"text":"以此从动荡中牟利"},{"start":609.08,"end":612.89,"text":"甚至妄想获得事物的统治权"},{"start":612.89,"end":614.81,"text":"就这点把戏玩来玩去"},{"start":614.81,"end":616.52,"text":"你们这些货的这些把戏"},{"start":616.52,"end":618.7,"text":"你包括那几个什么独走的"},{"start":618.7,"end":620.4,"text":"反叛的这个所谓俱乐部啊"},{"start":620.4,"end":622.04,"text":"还是那票人弄完了"},{"start":622.04,"end":623.38,"text":"你不就是要蔓延恐慌"},{"start":623.38,"end":625.15,"text":"拼命制造恐慌吗"},{"start":625.15,"end":627.73,"text":"这就是你们阶级意识使然"},{"start":627.73,"end":630.07,"text":"这就是你们阶级本性使然"},{"start":630.07,"end":631.61,"text":"这就是你们所谓的"},{"start":631.61,"end":635.25,"text":"非常就是奴隶般的一个篡权计划使然"},{"start":635.25,"end":636.85,"text":"你不仅仅是在俱乐部内"},{"start":636.85,"end":637.77,"text":"你想这样做"},{"start":637.77,"end":639.01,"text":"你对于整个国家"},{"start":639.01,"end":641.1,"text":"你们都试图这样做"},{"start":641.54,"end":643.42,"text":"你以为我们不知道吗"},{"start":643.42,"end":645.24,"text":"掌握情绪先机"},{"start":645.24,"end":646.34,"text":"装的义愤填膺"},{"start":646.34,"end":647.86,"text":"装的好像很重视这些东西"},{"start":647.86,"end":648.86,"text":"真重视吗"},{"start":648.86,"end":650.76,"text":"真讲道德吗"},{"start":651.47,"end":653.03,"text":"装模作样"},{"start":653.03,"end":656.039,"text":"虚头巴脑玩来玩去"},{"start":656.039,"end":658.959,"text":"所以你们的这种目的必然失败"},{"start":658.959,"end":662.89,"text":"因为你们最终能触及到的是一种被镇压性"},{"start":662.89,"end":664.33,"text":"你不顶多被镇压"},{"start":664.33,"end":666.15,"text":"只能生产被镇压性质"},{"start":666.15,"end":668.97,"text":"那就是说从物理上你就失败了"},{"start":668.97,"end":671.03,"text":"从客观上你注定失败"},{"start":671.03,"end":675.81,"text":"就是情绪上是给对手弄点无名指什么的玩意的"},{"start":675.81,"end":677.11,"text":"那有啥用啊"},{"start":677.11,"end":681.56,"text":"那这个现实公共服务生产资料"},{"start":681.56,"end":682.24,"text":"生活资料"},{"start":682.24,"end":683.98,"text":"这玩意是你们生产的吗"},{"start":683.98,"end":686.44,"text":"跟你们有半毛钱关系吗"},{"start":687.2,"end":688.2,"text":"就滚一边去"},{"start":688.2,"end":689.0,"text":"对不对哦"},{"start":689.0,"end":690.28,"text":"那就讲到这里啊"}],"source":"subtitle"}
