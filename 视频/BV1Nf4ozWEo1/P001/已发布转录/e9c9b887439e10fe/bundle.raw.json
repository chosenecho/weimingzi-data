{"segments":[{"start":2.06,"end":4.54,"text":"如果曾经参与过"},{"start":4.54,"end":9.36,"text":"或者说被裹挟的参与过一些犯罪活动"},{"start":11.36,"end":15.84,"text":"对于这个底层人民劳动群众啊"},{"start":15.84,"end":17.46,"text":"施加过伤害"},{"start":17.46,"end":19.64,"text":"犯下过罪孽"},{"start":19.64,"end":22.0,"text":"那么对于这种人呢"},{"start":22.0,"end":23.98,"text":"实际上从阶级分析上讲"},{"start":23.98,"end":27.48,"text":"他们实际上是资产阶级的帮凶"},{"start":27.48,"end":29.7,"text":"也就是说它是一种小资产阶级"},{"start":29.7,"end":30.1,"text":"是什么"},{"start":30.1,"end":32.22,"text":"小资产阶级呢是暴利"},{"start":32.22,"end":33.72,"text":"小资产阶级啊"},{"start":33.72,"end":35.2,"text":"恐吓暴力的小战役"},{"start":35.2,"end":37.99,"text":"用来生产这种统治工具的"},{"start":37.99,"end":40.71,"text":"这些人实际上是统治机器的一部分"},{"start":40.71,"end":45.0,"text":"是统治机器的最底层是他的微真啊"},{"start":45.0,"end":49.58,"text":"或者说是用来啊汲取榨取啊"},{"start":49.58,"end":53.18,"text":"被剥削者被体系化的榨取之后"},{"start":53.18,"end":55.86,"text":"剩下的残渣里的最后一滴"},{"start":57.46,"end":58.18,"text":"生命力"},{"start":59.5,"end":61.06,"text":"那么对于这种存在呢"},{"start":61.06,"end":65.22,"text":"对于这类人呢不能够直接争取"},{"start":66.82,"end":71.04,"text":"也不要以为通过温情抚慰"},{"start":71.04,"end":73.26,"text":"宽容原谅"},{"start":73.84,"end":76.04,"text":"把他们变成温和的存在"},{"start":76.04,"end":78.58,"text":"变成看似无罪的存在"},{"start":78.58,"end":80.26,"text":"就是在解放他们"},{"start":80.26,"end":82.56,"text":"就是在对历史"},{"start":85.66,"end":89.34,"text":"负责为什么呢"},{"start":91.86,"end":93.18,"text":"因为这样做的话"},{"start":94.26,"end":97.02,"text":"一个这种犯罪分子要靠一个革命家"},{"start":97.02,"end":100.45,"text":"而且往往最最最糟糕的事"},{"start":101.74,"end":102.96,"text":"女性活动家"},{"start":102.96,"end":111.46,"text":"女性革命家永远永远不应当用你的爱情怜悯"},{"start":111.46,"end":112.62,"text":"但有的时候不是爱情啊"},{"start":112.62,"end":116.96,"text":"我觉得怜悯情感情欲性关系"},{"start":116.96,"end":123.68,"text":"甚至说是婚姻或者说是生育权来收买它"},{"start":123.68,"end":125.18,"text":"贿赂他"},{"start":125.61,"end":128.59,"text":"这会造成极为恶劣的历史影响"},{"start":128.59,"end":130.35,"text":"因为这意味着什么"},{"start":130.35,"end":133.31,"text":"犯错误是可以被奖励的"},{"start":133.59,"end":134.71,"text":"他不需要赎罪"},{"start":135.75,"end":138.93,"text":"竟然直接可以获得历史的奖励"},{"start":139.45,"end":142.82,"text":"这样做的女性活动者"},{"start":142.82,"end":146.93,"text":"女性革命家犯了严重的小钻这一错误"},{"start":146.93,"end":151.35,"text":"他以为啊我把这个犯罪型的人"},{"start":151.35,"end":157.17,"text":"或者把这样一个误入歧途的人拯救了"},{"start":157.29,"end":160.67,"text":"可以让他不再去残害很多人"},{"start":160.67,"end":163.19,"text":"那么他不再残害很多人"},{"start":163.19,"end":166.21,"text":"就是我对历史的贡献了"},{"start":166.21,"end":167.93,"text":"那么我搞定这一个"},{"start":167.93,"end":169.53,"text":"我就可以过日子了"},{"start":169.53,"end":172.72,"text":"我就可以不再去做一个坚决的革命者"},{"start":172.72,"end":173.74,"text":"继续去努力的"},{"start":173.74,"end":176.77,"text":"我就可以做一些外围的事务性的"},{"start":176.77,"end":177.65,"text":"无意义的"},{"start":177.65,"end":180.39,"text":"无烈度的工作了"},{"start":180.39,"end":182.73,"text":"我就可以过日子了"},{"start":182.73,"end":185.61,"text":"这个账怎么算都是错的"},{"start":186.36,"end":187.48,"text":"他犯下的罪孽"},{"start":187.48,"end":189.04,"text":"凭什么他直接过日子"},{"start":189.04,"end":192.56,"text":"而且还对子对调了一个革命者"},{"start":193.55,"end":198.95,"text":"这种二元关系实际上是洗白了罪恶"},{"start":200.68,"end":202.4,"text":"如果他真的要被救赎"},{"start":202.4,"end":203.54,"text":"要被解放"},{"start":203.54,"end":205.75,"text":"他应当先去赎罪"},{"start":206.15,"end":209.61,"text":"依凭他所造成的伤害损害"},{"start":209.61,"end":210.67,"text":"他要赎罪"},{"start":211.71,"end":214.23,"text":"他不能那么轻易地被洗白"},{"start":216.16,"end":217.82,"text":"被奖励"},{"start":218.26,"end":220.08,"text":"那么如何赎罪呢"},{"start":220.08,"end":221.78,"text":"造成多少伤害"},{"start":221.78,"end":223.38,"text":"导致了多少家庭"},{"start":223.38,"end":224.74,"text":"多少更无辜的"},{"start":224.74,"end":227.23,"text":"更弱小的人的伤害"},{"start":227.51,"end":229.75,"text":"他必须沉痛承担"},{"start":229.75,"end":231.07,"text":"同等的或者加倍"},{"start":231.07,"end":235.45,"text":"这样的伤害由他自己在现实的利益当中承担"},{"start":235.45,"end":237.75,"text":"而不是仅仅在主观状态下承担"},{"start":237.75,"end":242.209,"text":"他必须在现实的利益上去承担"},{"start":242.209,"end":243.649,"text":"如果他因为他所作所为"},{"start":243.649,"end":244.969,"text":"导致别