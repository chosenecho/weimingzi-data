62,"end":330.14,"text":"所以我没捅你九刀"},{"start":330.14,"end":332.18,"text":"我就对你有恩了吗"},{"start":333.01,"end":334.63,"text":"哪有这样算的"},{"start":334.63,"end":336.09,"text":"这是标准的倒错"},{"start":337.33,"end":341.15,"text":"因为这样去所谓的女性革命家"},{"start":341.15,"end":344.75,"text":"这样去爱这么一个潜在的施暴者"},{"start":344.75,"end":346.91,"text":"有罪恶者"},{"start":348.27,"end":349.83,"text":"这样去所谓的爱啊"},{"start":349.83,"end":351.19,"text":"说怜悯和宽恕他"},{"start":351.19,"end":353.09,"text":"包容他实际上是什么"},{"start":355.36,"end":359.8,"text":"这个男性就代表凶恶的强力暴力"},{"start":361.0,"end":366.04,"text":"残害压迫力这一侧"},{"start":366.04,"end":369.14,"text":"那个女的呢代表洗白这一侧"},{"start":370.64,"end":374.339,"text":"他不是他所作所为"},{"start":374.339,"end":375.139,"text":"不是在拯救"},{"start":375.139,"end":375.899,"text":"在解放"},{"start":375.899,"end":377.159,"text":"他是在洗白"},{"start":377.159,"end":380.219,"text":"那么这个双生子长出来就是什么呢"},{"start":380.219,"end":386.22,"text":"强力策和意识形态侧就是统治机器的两侧"},{"start":386.22,"end":388.7,"text":"强力和意识形态"},{"start":389.92,"end":394.56,"text":"看上去是个最基本的拯救性的噢单元"},{"start":394.56,"end":397.48,"text":"实际上它是最基本的统治单元"},{"start":400.74,"end":404.47,"text":"那么这样的女性呢要摆脱这种小自然义幻想"},{"start":404.47,"end":407.07,"text":"摆脱这种好像去搞定的这一个"},{"start":407.07,"end":409.31,"text":"他就承担了全全部历史使命"},{"start":409.31,"end":411.18,"text":"然后就可以去过日子"},{"start":411.18,"end":413.74,"text":"摆脱这样一种对子的妄想"},{"start":414.9,"end":416.44,"text":"你拯救这一个人"},{"start":416.44,"end":420.01,"text":"那么所谓的拯救只是说他不在"},{"start":420.01,"end":423.38,"text":"加害了所谓的过平凡日子之前的账怎么算"},{"start":423.38,"end":424.5,"text":"那你说哦"},{"start":424.5,"end":425.72,"text":"大他者不存在"},{"start":425.72,"end":427.76,"text":"所以之前的上是不能累积的"},{"start":427.76,"end":429.1,"text":"大他者不存在"},{"start":429.1,"end":430.96,"text":"人民群众不存在吗"},{"start":430.96,"end":433.72,"text":"他所作所为造成的损害"},{"start":433.72,"end":435.88,"text":"造成的家破人亡"},{"start":437.54,"end":441.92,"text":"造成造成了弱小的孩子的悲惨的童年"},{"start":441.92,"end":445.97,"text":"造成的那些孤苦无依的老人"},{"start":447.86,"end":449.68,"text":"绝望地面对死亡"},{"start":449.68,"end":450.7,"text":"面对病痛"},{"start":450.7,"end":452.82,"text":"这东西不存在吗"},{"start":453.68,"end":455.28,"text":"它散播开来"},{"start":455.28,"end":457.38,"text":"沉淀在那里"},{"start":457.66,"end":459.66,"text":"他只要作为凶手逃遁掉"},{"start":459.66,"end":461.62,"text":"你还你还帮助他逃遁"},{"start":461.62,"end":468.669,"text":"还通过所谓的爱情享乐婚姻来帮助他们逃遁"},{"start":468.669,"end":470.229,"text":"那些伤害就不存在了吗"},{"start":470.229,"end":471.669,"text":"那些罪恶就不存在了吗"},{"start":471.669,"end":473.549,"text":"就可以这样被取消吗"},{"start":473.549,"end":476.989,"text":"你有什么资格代表历史来宽恕他"},{"start":479.18,"end":481.62,"text":"你有什么代表那么多受害者"},{"start":481.62,"end":487.859,"text":"人民群众的广大的根基来包容他"},{"start":487.859,"end":489.279,"text":"如果他要赎罪"},{"start":489.279,"end":491.239,"text":"他应当被埋葬"},{"start":493.58,"end":500.38,"text":"而不是继续把罪恶的根茎掩藏起来"},{"start":500.92,"end":504.76,"text":"自肆的蔓延滋长"},{"start":505.74,"end":509.74,"text":"这种人对待他的后代会怎么教育他"},{"start":510.63,"end":511.65,"text":"去犯罪吧"},{"start":511.65,"end":512.75,"text":"去作恶吧"},{"start":512.75,"end":514.59,"text":"会奖励你命运"},{"start":514.59,"end":515.549,"text":"会奖励你"},{"start":515.549,"end":517.309,"text":"你的母亲"},{"start":519.22,"end":522.02,"text":"就在用这种方式奖励着我"},{"start":523.659,"end":528.18,"text":"你的到来就是这种不正义的"},{"start":529.54,"end":533.48,"text":"所谓的报应的一个最直接的证据"},{"start":533.48,"end":537.62,"text":"你的存在就意味着恶应当被激励"},{"start":539.64,"end":540.72,"text":"应当被贿赂"},{"start":541.96,"end":543.72,"text":"应当被满足"},{"start":545.04,"end":546.64,"text":"酱的孩子"},{"start":550.06,"end":551.1,"text":"他要走回正道"},{"start":551.1,"end":554.82,"text":"他要付出无限大的大无限大的代价"},{"start":558.18,"end":559.3,"text":"另外一方面呢"},{"start":561.34,"end":564.92,"text":"我们说的孩子犯这种错误的"},{"start":566.96,"end":568.6,"text":"或者我们说是暴力小资产阶级也好"},{"start":568.6,"end":571.04,"text":"最底层的暴力小自然阶级帮凶"},{"start":571.44,"end":572.72,"text":"他们难道不是孩子吗"},{"start":574.08,"end":575.16,"text":"他们也处在痛苦中"},{"start":575.16,"end":576.72,"text":"也在挣扎"},{"start":577.55,"end":580.95,"text":"他们也不知道他们为什么会犯罪"},{"start":580.95,"end":584.31,"text":"为什么会制造痛苦创伤"},{"start":586.02,"end":589.26,"text":"他们本来有机会从这种痛苦当中"},{"start":590.46,"end":595.1,"text":"重新锚定自己的价值去赎罪"},{"start":596.52,"end":599.02,"text":"去背叛曾经的作恶的自己"},{"start":599.02,"end":601.6,"text":"去背叛自己的雇主"},{"start":603.08,"end":604.6,"text":"却不再做一个帮凶"},{"start":604.6,"end":607.8,"text":"但是他竟然被奖励了"},{"start":609.84,"end":612.4,"text":"被这些所谓女性的革命者"},{"start":614.159,"end":614.999,"text":"被奖励了"},{"start":614.999,"end":616.839,"text":"被圣母奖励了"},{"start":617.54,"end":624.95,"text":"他自己对于自己不正义的认定都会被取消"},{"start":624.95,"end":625.47,"text":"被掩盖"},{"start":625.47,"end":626.17,"text":"被遮蔽"},{"start":626.17,"end":627.91,"text":"被欺骗"},{"start":628.9,"end":631.51,"text":"这些长不大的孩子永远长不大了"},{"start":631.71,"end":634.47,"text":"他永远不愿意去面对自己的罪恶了"},{"start":634.47,"end":638.25,"text":"永远不会想到犯错要付出代价"},{"start":638.25,"end":642.63,"text":"犯错创制造伤害要去弥补"},{"start":642.63,"end":644.85,"text":"别人不能弥补"},{"start":644.85,"end":646.67,"text":"就应当承受痛苦"},{"start":646.67,"end":650.929,"text":"他永远不知道他的痛苦由别人来弥补"},{"start":650.929,"end":652.589,"text":"由阴道来弥补"},{"start":652.589,"end":654.349,"text":"由享乐来弥补"},{"start":654.349,"end":656.49,"text":"由子嗣来弥补"},{"start":656.77,"end":659.21,"text":"天底下哪有这样的道理"},{"start":665.64,"end":672.12,"text":"气绝这样的邪恶的双生术砍掉他"},{"start":673.84,"end":678.1,"text":"这是革命团体的必然的历史使命"},{"start":679.1,"end":680.18,"text":"那么要做到这一点"},{"start":680.18,"end":682.34,"text":"单枪匹马是不够的"},{"start":682.95,"end":684.55,"text":"做到这一点"},{"start":685.61,"end":686.71,"text":"要做到这一点"},{"start":686.71,"end":688.93,"text":"你要意识到你的敌人比你更凶恶"},{"start":688.93,"end":693.48,"text":"或者说一旦你直接把他设定为敌人"},{"start":694.64,"end":695.52,"text":"他们是罪恶的"},{"start":695.52,"end":696.24,"text":"是肮脏的"},{"start":697.52,"end":699.8,"text":"他们就会成为敌人"},{"start":700.74,"end":702.74,"text":"如何做到这点的"},{"start":704.34,"end":706.44,"text":"要通过集体的力量"},{"start":706.44,"end":707.94,"text":"要通过组织的力量"},{"start":709.3,"end":710.72,"text":"要通过共识"},{"start":710.72,"end":713.56,"text":"这些人如何赎罪呢"},{"start":718.5,"end":723.22,"text":"俯首堕落的社会关联会继续给他们妄想幻想"},{"start":724.46,"end":727.329,"text":"所谓革命者女性圣母"},{"start":727.43,"end":731.95,"text":"对于他们违背历史铁律的"},{"start":731.95,"end":738.51,"text":"违背根本的解放性的纪律的这种奖赏"},{"start":739.16,"end":741.5,"text":"会彻底的腐蚀他们的灵魂"},{"start":741.5,"end":744.38,"text":"会使让会让他们堕落的更深刻"},{"start":744.38,"end":746.08,"text":"无可拯救"},{"start":746.08,"end":749.0,"text":"首先要剥夺这些东西"},{"start":749.7,"end":751.66,"text":"要把他们从这些泥潭当中"},{"start":752.98,"end":757.61,"text":"从这些眩晕混乱当中连根拔起"},{"start":759.05,"end":761.17,"text":"往往采取的方式就是劳改"},{"start":764.16,"end":765.48,"text":"好洗澡"},{"start":765.48,"end":766.32,"text":"现在洗的干干净净"},{"start":766.32,"end":766.76,"text":"排排队"},{"start":766.76,"end":769.1,"text":"然后弄个小铁床上下铺睡着"},{"start":769.1,"end":771.04,"text":"然后去领领盆"},{"start":771.04,"end":772.38,"text":"领毛巾"},{"start":772.38,"end":775.52,"text":"领这个牙刷茶缸"},{"start":776.3,"end":778.4,"text":"然后备调理"},{"start":778.4,"end":780.26,"text":"第二天出早操"},{"start":781.66,"end":784.63,"text":"给他们建立重新的奖惩机制"},{"start":784.63,"end":787.15,"text":"全新的奖惩机制才碍于上"},{"start":787.15,"end":790.93,"text":"让他知道犯错误要被惩罚就做对了"},{"start":790.93,"end":794.22,"text":"维护弱者的共同体"},{"start":794.22,"end":797.5,"text":"长远的利益才可以得到奖励"},{"start":799.02,"end":800.86,"text":"不是说在加害别人之后"},{"start":800.86,"end":802.04,"text":"在犯了罪孽之后"},{"start":802.04,"end":804.74,"text":"装出一副自己也是无辜的受害者的样子"},{"start":804.74,"end":806.22,"text":"其实是什么呢"},{"start":806.22,"end":808.54,"text":"其实你只是绑架了预期的"},{"start":808.54,"end":811.94,"text":"未来的更多的受害者在这里要挟而已"},{"start":812.45,"end":814.49,"text":"好像你不收买我"},{"start":814.49,"end":816.03,"text":"你不收买它"},{"start":816.03,"end":818.69,"text":"他就能够去加害更多人"},{"start":819.25,"end":820.87,"text":"然后你去收买了它"},{"start":820.87,"end":822.13,"text":"你这个就不仅仅是收买"},{"start":822.13,"end":823.01,"text":"不仅仅是资长"},{"start":823.01,"end":824.01,"text":"不仅仅是助长了"},{"start":824.01,"end":826.319,"text":"而变成一种德性"},{"start":826.559,"end":829.099,"text":"变成一种功绩"},{"start":829.099,"end":832.35,"text":"这些人是卖什么的呀"},{"start":837.24,"end":840.9,"text":"当时指向未来的要挟着要加害"},{"start":840.9,"end":846.11,"text":"然后你就满足我给各式样的东西满足我"},{"start":846.11,"end":847.81,"text":"我就不加H"},{"start":847.81,"end":850.85,"text":"所以你的这种满足就是神圣的"},{"start":850.85,"end":851.61,"text":"就是奉献"},{"start":851.61,"end":852.73,"text":"就是有功劳的"},{"start":852.73,"end":854.89,"text":"这是一张罪恶的交易"},{"start":855.62,"end":857.38,"text":"你提供给这些东西给他"},{"start":858.66,"end":860.78,"text":"表面上他会假装好像乖了"},{"start":860.78,"end":861.74,"text":"好像安定了"},{"start":861.74,"end":863.22,"text":"实际上呢"},{"start":868.66,"end":871.7,"text":"未来或许能安定"},{"start":871.7,"end":874.42,"text":"但是那些罪恶就这样算了吗"},{"start":876.82,"end":879.58,"text":"你的伤痛痛苦就这样算了吧"},{"start":880.15,"end":881.79,"text":"谁有资格原谅他们吧"},{"start":883.11,"end":884.23,"text":"哪应当是那些受害者"},{"start":885.23,"end":887.39,"text":"那应当是更朴素的逻辑"},{"start":894.54,"end":897.54,"text":"我们应当心如铁石"},{"start":898.38,"end":902.3,"text":"才能敲碎他们身上的锈壳"},{"start":903.41,"end":908.97,"text":"才能把禁锢在这种铁锈坚硬的外壳当中"},{"start":908.97,"end":910.93,"text":"的他们的"},{"start":912.82,"end":915.74,"text":"还尚有生命力的"},{"start":923.3,"end":932.9,"text":"肌体肌里或者说是血肉拯救出来"},{"start":937.22,"end":938.22,"text":"最后我要说的"},{"start":939.42,"end":942.6,"text":"凡是对我们成员"},{"start":942.6,"end":951.56,"text":"我们团队的正式成员施加过人身武力威胁的"},{"start":952.2,"end":960.63,"text":"施加过违禁的一些非法的那些伤害的威胁的"},{"start":961.17,"end":963.57,"text":"或者说啊我说是施加过威胁"},{"start":963.57,"end":969.27,"text":"甚至说施加过实际行动的拘禁过恐吓过这个"},{"start":969.27,"end":975.17,"text":"或者说现场殴打过或怎么样的"},{"start":975.93,"end":977.89,"text":"我们不会原谅"},{"start":980.3,"end":982.0,"text":"而且我们是当真的"},{"start":982.0,"end":986.34,"text":"我不会认为这些东西是一时的口嗨"},{"start":986.34,"end":988.569,"text":"或者说一时的这个"},{"start":993.8,"end":995.88,"text":"大话谎话"},{"start":995.88,"end":997.64,"text":"我明确说一个"},{"start":997.64,"end":999.78,"text":"我们统统都是当真的"},{"start":999.78,"end":1001.87,"text":"我们现在弱小"},{"start":1002.11,"end":1003.47,"text":"几乎什么都没有"},{"start":1003.47,"end":1004.95,"text":"但是我们是当真的"},{"start":1004.95,"end":1007.53,"text":"我们把这些威胁当真"},{"start":1008.09,"end":1010.17,"text":"我们不会束手待毙"},{"start":1011.97,"end":1014.17,"text":"我们不会任人揉捏"},{"start":1014.37,"end":1016.33,"text":"我们不会被你们骑在头上拉屎"},{"start":1017.33,"end":1018.93,"text":"你说出这些话的时候"},{"start":1018.93,"end":1021.49,"text":"你一定会承受历史的代价"},{"start":1025.06,"end":1026.74,"text":"你做出这些伤害的时候"},{"start":1028.06,"end":1030.46,"text":"你要考虑好你如何赎罪"},{"start":1032.659,"end":1034.759,"text":"你不愿意面对这些东西"},{"start":1034.759,"end":1036.699,"text":"逃避到所谓的安定的"},{"start":1036.699,"end":1037.858,"text":"上了岸的"},{"start":1037.858,"end":1038.539,"text":"被收买"},{"start":1038.539,"end":1043.919,"text":"被贿赂的不义的幸福生活能量曲"},{"start":1043.919,"end":1045.878,"text":"你逃不了"},{"start":1049.02,"end":1052.78,"text":"你一定会接受历史的正义的制裁"},{"start":1053.74,"end":1056.22,"text":"我们责无旁贷"},{"start":1057.69,"end":1060.09,"text":"我们不抱有任何的幻想"},{"start":1062.46,"end":1063.78,"text":"就讲到这里"}],"source":"subtitle"}
