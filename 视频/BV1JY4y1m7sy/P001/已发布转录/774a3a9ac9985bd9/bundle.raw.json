rt":1880.46,"end":1882.64,"text":"他肯定会坠崖"},{"start":1882.64,"end":1885.34,"text":"坠楼肯定会瞎搞啊"},{"start":1885.34,"end":1887.71,"text":"这个就是我上一讲讲的那些苍蝇"},{"start":1887.71,"end":1890.54,"text":"这苍蝇就是做梦的梦游的这些人"},{"start":1891.06,"end":1892.74,"text":"你了解吗啊"},{"start":1892.74,"end":1895.38,"text":"我们是需要踏踏实实的清醒的"},{"start":1895.38,"end":1900.32,"text":"在现实当中的尝人间冷暖的懂吧"},{"start":1900.32,"end":1901.5,"text":"一个炊饼"},{"start":1902.66,"end":1904.15,"text":"一个手套"},{"start":1904.15,"end":1907.66,"text":"一个这个塑料袋都是自己亲手戴上"},{"start":1907.66,"end":1908.56,"text":"亲手炸出来"},{"start":1908.56,"end":1909.84,"text":"亲手包好的"},{"start":1910.32,"end":1912.08,"text":"这样去过日子"},{"start":1912.08,"end":1914.48,"text":"这个日子本来这个平凡的日子"},{"start":1914.48,"end":1916.1,"text":"大家过了好多年了"},{"start":1916.1,"end":1917.48,"text":"只不过从今天开始"},{"start":1917.48,"end":1919.1,"text":"从你的行动的那一瞬间开始"},{"start":1919.1,"end":1921.46,"text":"你把它赋予的一个神圣的意义"},{"start":1925.2,"end":1927.0,"text":"你本来就是说掏个口香糖"},{"start":1927.0,"end":1927.84,"text":"大家分着吃一点"},{"start":1927.84,"end":1928.68,"text":"难道不会吗"},{"start":1928.68,"end":1930.32,"text":"本来只是为了大家乐一乐"},{"start":1930.32,"end":1931.88,"text":"本来就是为了舒缓一下"},{"start":1931.88,"end":1933.62,"text":"但是这个乐一乐舒缓一下"},{"start":1933.62,"end":1934.28,"text":"从今天开始"},{"start":1934.28,"end":1935.57,"text":"它有个意义的"},{"start":1935.57,"end":1938.3,"text":"它有一个就是大家相互信任"},{"start":1938.3,"end":1940.24,"text":"大家相互连结"},{"start":1941.76,"end":1943.19,"text":"相互认同"},{"start":1943.19,"end":1944.54,"text":"他有个目的的"},{"start":1945.5,"end":1951.6,"text":"有点政治的追求了理想图景的"},{"start":1951.6,"end":1954.56,"text":"现实的追求了现实的追求了"},{"start":1956.46,"end":1958.1,"text":"可能作为一个习惯"},{"start":1958.1,"end":1958.88,"text":"有些老好人"},{"start":1958.88,"end":1960.56,"text":"在现实中他早已经做这种事情"},{"start":1960.56,"end":1962.22,"text":"做了好多好多年了"},{"start":1962.4,"end":1963.24,"text":"懂了吧"},{"start":1963.24,"end":1966.06,"text":"只不过说他他所以说这个人可能在现实生活中"},{"start":1966.06,"end":1969.63,"text":"大家都跟他关系都挺好是吧懂吧"},{"start":1969.63,"end":1972.87,"text":"但是他没有那个方向"},{"start":1972.87,"end":1974.52,"text":"没有那个路径"},{"start":1974.52,"end":1978.26,"text":"没有一个名义啊"},{"start":1978.26,"end":1981.75,"text":"没有一个组织和纪律啊"},{"start":1981.75,"end":1982.92,"text":"懂了吧"},{"start":1982.92,"end":1984.42,"text":"所以我希望大家啊"},{"start":1984.42,"end":1989.18,"text":"就是说清醒的踏踏实实的去去做事情"},{"start":1989.18,"end":1989.98,"text":"去行动"},{"start":1990.28,"end":1993.52,"text":"那些梦游的那些人啊"},{"start":1993.52,"end":1995.32,"text":"就是说就不要跟着他们走"},{"start":1995.32,"end":1996.82,"text":"他们自己去跌落就摔"},{"start":1996.82,"end":1997.9,"text":"摔得粉身碎骨了哇"},{"start":1997.9,"end":1999.18,"text":"他一边关我屁事"},{"start":1999.18,"end":2000.92,"text":"他如果影响到"},{"start":2003.14,"end":2006.38,"text":"要阻止他做梦的那些家伙不负责任"},{"start":2006.38,"end":2009.2,"text":"我们不负责让做梦的人醒过来"},{"start":2009.94,"end":2012.51,"text":"或者说换句话说"},{"start":2012.51,"end":2014.88,"text":"我们醒着的人闹出来的动静"},{"start":2014.88,"end":2016.26,"text":"我们醒着的人"},{"start":2016.26,"end":2019.2,"text":"我们在这个厨房当中"},{"start":2019.2,"end":2021.49,"text":"在餐厅当中的那个饭香"},{"start":2021.49,"end":2023.62,"text":"那个家庭的温暖"},{"start":2023.62,"end":2028.2,"text":"我们的这个这个讨论的声音哦"},{"start":2028.2,"end":2030.5,"text":"就是我们的这个日常的言语"},{"start":2030.5,"end":2032.42,"text":"就是我们弄出来响动啊"},{"start":2032.42,"end":2034.04,"text":"越温馨越真实"},{"start":2034.04,"end":2036.7,"text":"他可能他才愿意醒过来"},{"start":2036.78,"end":2038.49,"text":"我们过好我们自己"},{"start":2038.49,"end":2040.11,"text":"我们做好我们自己的"},{"start":2040.11,"end":2042.35,"text":"他醒不醒来是他自己的决定"},{"start":2042.35,"end":2044.21,"text":"他有个睡眠的欲望的吗"},{"start":2044.21,"end":2045.47,"text":"学过精神分析的人都知道"},{"start":2045.47,"end":2047.12,"text":"睡眠本身有它的欲望"},{"start":2047.12,"end":2049.28,"text":"是机体需要修复它自身"},{"start":2049.28,"end":2050.3,"text":"或者说whatever"},{"start":2050.3,"end":2051.98,"text":"或者他是个神经症的"},{"start":2051.98,"end":2052.699,"text":"或者是怎么样的"},{"start":2052.699,"end":2055.46,"text":"它有任何某种原因啊"},{"start":2055.58,"end":2058.28,"text":"他的他的这个醒来的欲望"},{"start":2058.28,"end":2060.17,"text":"什么时候压过他睡着的欲望"},{"start":2060.17,"end":2061.719,"text":"他自己决定的"},{"start":2061.739,"end":2064.259,"text":"我不可能说去他醒不过来"},{"start":2064.259,"end":2065.9,"text":"我用个锤子把他敲醒"},{"start":2066.339,"end":2067.779,"text":"还朝我生气呢"},{"start":2067.779,"end":2069.099,"text":"我没有这个义务"},{"start":2072.039,"end":2072.88,"text":"明白吗"},{"start":2073.659,"end":2075.179,"text":"我们没有这个义务"},{"start":2075.179,"end":2076.739,"text":"对于那些精神病理化的"},{"start":2076.739,"end":2080.46,"text":"把左翼文化叙事当成是卧槽啊"},{"start":2080.46,"end":2082.5,"text":"从他那个病理化状态解脱出来"},{"start":2082.5,"end":2082.92,"text":"那群人"},{"start":2082.92,"end":2085.8,"text":"我没有义务专门去一个一个给他们做精神分析"},{"start":2085.8,"end":2087.33,"text":"做什么常谈常聊"},{"start":2087.33,"end":2089.55,"text":"鬼知道他是追星的还是干什么的"},{"start":2089.55,"end":2090.51,"text":"鬼知道他过来"},{"start":2090.51,"end":2094.089,"text":"他妈的想要想要就是跟我说说话什么的"},{"start":2094.089,"end":2095.409,"text":"关我屁事"},{"start":2095.409,"end":2099.68,"text":"就这些小孩这些你睡你睡着了"},{"start":2099.68,"end":2100.76,"text":"你还要求别人去"},{"start":2100.76,"end":2101.66,"text":"怎么啊"},{"start":2101.66,"end":2105.54,"text":"这个小声小气的把你轻轻把你叫醒唤醒"},{"start":2108.32,"end":2109.24,"text":"你要不要醒他"},{"start":2109.24,"end":2110.11,"text":"关我屁事"},{"start":2110.11,"end":2111.04,"text":"你继续做"},{"start":2111.04,"end":2111.84,"text":"你这个梦"},{"start":2112.16,"end":2113.72,"text":"就这些货色呢"},{"start":2113.72,"end":2118.28,"text":"我们不必要抱有任何的不说一厢情愿"},{"start":2118.28,"end":2121.61,"text":"连半厢不情愿的那种理财"},{"start":2121.61,"end":2125.96,"text":"那种那种那种什么关注都不要有"},{"start":2127.459,"end":2129.759,"text":"自己选的得了吧"},{"start":2129.759,"end":2131.079,"text":"这家伙装睡的"},{"start":2131.079,"end":2134.499,"text":"或者说你看这个梦也是强迫自己做了一个梦"},{"start":2134.499,"end":2136.46,"text":"脑子里胡思乱想的一个梦"},{"start":2140.82,"end":2142.16,"text":"这一点弄清楚了吧"},{"start":2142.16,"end":2142.88,"text":"好吧"},{"start":2143.6,"end":2145.6,"text":"有人说我直播确实水"},{"start":2145.6,"end":2147.86,"text":"因为也在做梦"},{"start":2148.24,"end":2151.83,"text":"你不是说是线下活动当中"},{"start":2151.83,"end":2154.11,"text":"我们各地小组都遇到这种人"},{"start":2154.11,"end":2156.36,"text":"这个是我今天要讲的第二种人"},{"start":2156.36,"end":2158.94,"text":"这种人他做他的老梦鬼"},{"start":2158.94,"end":2160.14,"text":"没他愿意行动"},{"start":2160.14,"end":2162.06,"text":"那他这还是说在行动当中"},{"start":2162.06,"end":2163.77,"text":"他逐步逐步把自己唤醒"},{"start":2163.77,"end":2167.18,"text":"我们不负责额外唤醒他啊"},{"start":2167.18,"end":2169.34,"text":"他如果就是做了之后回去还做梦"},{"start":2169.34,"end":2170.66,"text":"那就这样去做梦"},{"start":2173.28,"end":2175.28,"text":"你身边就有这种人"},{"start":2175.6,"end":2177.46,"text":"哪怕是线下做公益的"},{"start":2177.46,"end":2179.11,"text":"它可能来个一次两次那种"},{"start":2179.11,"end":2180.37,"text":"确实也有这种人"},{"start":2180.37,"end":2181.42,"text":"或者他不做公益的"},{"start":2181.42,"end":2182.52,"text":"他也有这种人"},{"start":2182.52,"end":2184.17,"text":"那这种人的话就说"},{"start":2184.17,"end":2187.249,"text":"不要说她可能这个女的长得比较漂亮"},{"start":2187.249,"end":2189.469,"text":"你要是非要去追求她或者怎么样"},{"start":2189.469,"end":2191.329,"text":"或者那个男的比较有什么好"},{"start":2191.329,"end":2191.989,"text":"比较幽默"},{"start":2191.989,"end":2193.189,"text":"你非要去让他觉醒"},{"start":2193.189,"end":2194.13,"text":"放屁滚"},{"start":2194.13,"end":2195.51,"text":"没必要的"},{"start":2195.51,"end":2196.62,"text":"懂了吧"},{"start":2197.479,"end":2200.379,"text":"没有必要了解吗"},{"start":2200.379,"end":2202.14,"text":"那不是一路人呐"},{"start":2203.399,"end":2206.839,"text":"你你你可能是你的家庭成长过程当中"},{"start":2206.839,"end":2210.24,"text":"或者说你这个确实是一系列的原因"},{"start":2210.54,"end":2212.22,"text":"你很明确地说"},{"start":2214.02,"end":2215.75,"text":"我不这样做不行了"},{"start":2215.75,"end":2216.53,"text":"我不想做"},{"start":2216.53,"end":2217.79,"text":"我这辈子没有意义的"},{"start":2217.79,"end":2218.69,"text":"我不这样做"},{"start":2218.69,"end":2221.1,"text":"我这个人生这个国家啊"},{"start":2221.1,"end":2222.93,"text":"我这个家庭的发展方向"},{"start":2222.93,"end":2223.98,"text":"我不能认同了"},{"start":2223.98,"end":2225.98,"text":"我不愿意过那种生活"},{"start":2226.1,"end":2228.74,"text":"你很明确的懂吗"},{"start":2228.74,"end":2229.96,"text":"那是清醒的"},{"start":2230.0,"end":2232.22,"text":"你其他很多就是做梦的"},{"start":2232.22,"end":2232.64,"text":"你知道吗"},{"start":2232.64,"end":2234.779,"text":"他因为做了这个东西是怎么怎么地的"},{"start":2234.799,"end":2237.959,"text":"但我不说他就沾了点这些文化"},{"start":2237.959,"end":2239.159,"text":"沾了点这种道理"},{"start":2239.159,"end":2240.269,"text":"他就怎么怎么地的"},{"start":2240.269,"end":2242.44,"text":"他是个做梦的或者梦游的"},{"start":2242.939,"end":2246.32,"text":"不要对他们抱有什么期待"},{"start":2246.959,"end":2247.759,"text":"明确吗"},{"start":2247.759,"end":2249.819,"text":"这个就是我长久以来的"},{"start":2249.819,"end":2254.559,"text":"我作为一个老老的在黑夜中行走的"},{"start":2254.559,"end":2255.459,"text":"很多人睡着了"},{"start":2255.459,"end":2258.9,"text":"我在黑夜中独自行走的一个老独行者"},{"start":2258.919,"end":2260.539,"text":"现在我不算独行的呢"},{"start":2260.539,"end":2262.96,"text":"我有一群人在黑夜当中这样徘徊着"},{"start":2263.22,"end":2267.6,"text":"也用探照灯照顾很多装睡的人的眼皮子"},{"start":2267.6,"end":2270.14,"text":"照着他眼皮子闪到一边去"},{"start":2270.379,"end":2273.48,"text":"隔着个眼皮给我翻白眼的一些王八蛋"},{"start":2274.14,"end":2276.74,"text":"用用手电筒照着眼皮子"},{"start":2276.74,"end":2278.3,"text":"他隔着个眼皮子给老子翻白眼"},{"start":2278.3,"end":2280.16,"text":"他这个瞳孔受不了这个亮光"},{"start":2280.16,"end":2281.9,"text":"但也他不愿意醒来"},{"start":2282.319,"end":2285.679,"text":"我照过无数次类似的人"},{"start":2285.679,"end":2288.54,"text":"我打过无数次教导了啊"},{"start":2289.06,"end":2293.32,"text":"我的观点就是说让他们自生自灭好了吧"},{"start":2293.32,"end":2294.2,"text":"明白吗"},{"start":2296.359,"end":2298.329,"text":"嗯那就讲到这边啊"},{"start":2298.329,"end":2299.82,"text":"就是第二种人"}],"source":"subtitle"}
