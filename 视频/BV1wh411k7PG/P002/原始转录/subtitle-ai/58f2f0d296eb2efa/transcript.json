    {
      "ordinal": 46,
      "start_ms": 156450,
      "end_ms": 157890,
      "text": "外部时间是真实的"
    },
    {
      "ordinal": 47,
      "start_ms": 157890,
      "end_ms": 160680,
      "text": "内时间意识是一种体验详细的体验"
