  "segments": [
    {
      "ordinal": 0,
      "start_ms": 700,
      "end_ms": 2260,
      "text": "啊在康德的时间性里面"
    },
    {
      "ordinal": 1,
      "start_ms": 2260,
      "end_ms": 5020,
      "text": "其实已经对时间进行了去空间化"
    },
    {
      "ordinal": 2,
      "start_ms": 5020,
      "end_ms": 6460,
      "text": "这是很了不起的"
    },
    {
      "ordinal": 3,
      "start_ms": 6460,
      "end_ms": 7899,
      "text": "对时间"
    },
    {
      "ordinal": 4,
      "start_ms": 10239,
      "end_ms": 11460,
      "text": "进行了"
    },
    {
      "ordinal": 5,
      "start_ms": 15260,
      "end_ms": 20300,
      "text": "空间化就是再也不是那种针筒式的时间了"
    },
    {
      "ordinal": 6,
      "start_ms": 22720,
      "end_ms": 24400,
      "text": "真懂事的时间"
    },
    {
      "ordinal": 7,
      "start_ms": 27440,
      "end_ms": 31000,
      "text": "为什么他如何对时间进行数工业化的"
    },
    {
      "ordinal": 8,
      "start_ms": 31580,
      "end_ms": 33710,
      "text": "我们不是说他两面镜子吗"
