    {
      "ordinal": 55,
      "start_ms": 179020,
      "end_ms": 180540,
      "text": "高级知识分子"
    },
    {
      "ordinal": 56,
      "start_ms": 183100,
      "end_ms": 185130,
      "text": "对于时间的一个想象"
    },
    {
      "ordinal": 57,
      "start_ms": 185130,
      "end_ms": 186240,
      "text": "而且是聪明的"
