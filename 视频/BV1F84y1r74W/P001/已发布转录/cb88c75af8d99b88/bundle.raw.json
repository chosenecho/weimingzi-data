xt":"莴苣全部削干净"},{"start":190.629,"end":192.159,"text":"消掉太多了"},{"start":192.159,"end":194.229,"text":"淦你这你这样会喷"},{"start":194.229,"end":195.42,"text":"会被喷的"},{"start":195.42,"end":197.16,"text":"ok没事没事没事"},{"start":197.16,"end":198.84,"text":"你把他正脸拍上"},{"start":198.84,"end":201.42,"text":"这表情一层消掉就可以了"},{"start":201.42,"end":203.58,"text":"这样你笑没了"},{"start":205.53,"end":206.9,"text":"折腾了这么多米"},{"start":209.64,"end":213.52,"text":"你花刀啊"},{"start":220.7,"end":222.67,"text":"我是个第二刀是干什么的"},{"start":222.67,"end":223.9,"text":"空切了一下"},{"start":223.9,"end":225.62,"text":"看一下哪边效果更好"},{"start":227.48,"end":229.66,"text":"那你悟到的手法又又变回来了"},{"start":229.66,"end":230.38,"text":"你知道吗"},{"start":248.48,"end":250.24,"text":"卧槽吓老子饭"},{"start":250.24,"end":254.68,"text":"饿了饿了饿了饿了"},{"start":260.899,"end":264.04,"text":"什么慢慢什么米拉德效应啊"},{"start":264.04,"end":265.45,"text":"曼德拉效应"},{"start":265.45,"end":267.86,"text":"美美美拉德效应"},{"start":271.12,"end":272.67,"text":"哦呦这个声音"},{"start":277.5,"end":278.84,"text":"要用那么多油吗"},{"start":280.639,"end":281.319,"text":"搞一搞"},{"start":281.319,"end":283.5,"text":"放保鲜膜"},{"start":287.88,"end":288.96,"text":"这个很着急啊"},{"start":288.96,"end":292.06,"text":"我没有说我是好人了没了呀"},{"start":301.56,"end":304.52,"text":"我靠这都重开了"},{"start":306.04,"end":307.92,"text":"这炒蛋怎么还扣上呢"},{"start":307.92,"end":309.6,"text":"剩这么多土豆丝"},{"start":309.6,"end":310.68,"text":"谁装一下"},{"start":314.58,"end":317.0,"text":"那个蔬菜非常好好评"},{"start":317.0,"end":318.26,"text":"我们吃了也觉得很棒"},{"start":319.52,"end":320.3,"text":"胡萝卜丝"},{"start":320.3,"end":321.32,"text":"西红柿鸡蛋"},{"start":321.32,"end":324.17,"text":"然后那个呃就是他的口味"},{"start":324.17,"end":325.28,"text":"我自己啊"},{"start":325.28,"end":326.48,"text":"如果孩子们吃的"},{"start":326.48,"end":328.58,"text":"我觉得是平淡适中啊"},{"start":328.58,"end":330.47,"text":"酸甜可口很开胃"},{"start":330.47,"end":332.18,"text":"然后米饭有点硬"},{"start":332.18,"end":334.07,"text":"从我个人以及孩子的角度"},{"start":334.07,"end":337.73,"text":"我不知道干活的人可能硬一点会好一些"},{"start":337.73,"end":341.209,"text":"但是如果比