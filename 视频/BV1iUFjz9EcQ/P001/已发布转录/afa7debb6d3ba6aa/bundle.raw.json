{"segments":[{"start":5.8,"end":8.02,"text":"无产阶级处在危难当中"},{"start":8.02,"end":11.44,"text":"你们还在这里嬉皮笑脸"},{"start":11.44,"end":13.14,"text":"鸡毛蒜皮"},{"start":13.14,"end":17.07,"text":"吹拉弹唱呃"},{"start":17.07,"end":19.48,"text":"2025年整年"},{"start":19.88,"end":24.12,"text":"这个聚生智能用机器人淘汰产线"},{"start":24.12,"end":30.559,"text":"工人和服务业工人的这个节奏已经拉开了"},{"start":30.559,"end":35.79,"text":"并且在加快它主要的"},{"start":36.71,"end":38.79,"text":"机械工程层面"},{"start":38.79,"end":43.03,"text":"电气层面的技术是几乎没有平砍啊"},{"start":43.03,"end":45.18,"text":"没有瓶颈和门槛的"},{"start":45.38,"end":49.32,"text":"主要门槛在这个大模型啊"},{"start":49.32,"end":52.22,"text":"还有他的一些技术方案的收敛"},{"start":54.6,"end":60.09,"text":"那么我们预计在明年或者说在28年前"},{"start":60.09,"end":64.31,"text":"就可以把单个的通用型的体力"},{"start":64.31,"end":69.719,"text":"劳动机器人的价格做到6万9万"},{"start":69.719,"end":72.939,"text":"也就1万美金左右的价格"},{"start":73.729,"end":77.529,"text":"那个时候会是大批量的体力无产阶级和服务业"},{"start":77.529,"end":79.529,"text":"无产阶级的淘汰"},{"start":95.94,"end":97.54,"text":"我们必须有所行动"},{"start":100.94,"end":105.43,"text":"所以我们做了这个AI相关的一些技术准备"},{"start":105.43,"end":106.37,"text":"技术积累"},{"start":106.37,"end":111.35,"text":"但是呢整个这个由主要由小资构成的"},{"start":111.35,"end":116.57,"text":"和脑力劳动者构成的这个什么AI学习助手"},{"start":116.57,"end":120.77,"text":"这个团体全线叛叛逃了"},{"start":120.77,"end":122.11,"text":"或者说叛乱了"},{"start":122.11,"end":123.05,"text":"不好用了"},{"start":123.05,"end":124.445,"text":"没得用了"},{"start":126.3,"end":129.18,"text":"然后另外一方面是哦"},{"start":129.18,"end":131.06,"text":"他们本身没有什么阶级忠诚啊"},{"start":131.06,"end":137.35,"text":"他本身就是说符号化的抽象抽离的那种劳动啊"},{"start":137.35,"end":138.95,"text":"很容易被收买"},{"start":138.95,"end":139.89,"text":"另外一方面"},{"start":139.89,"end":142.49,"text":"整个所谓俱乐部执行俱乐部体系"},{"start":142.49,"end":147.63,"text":"并没有锤断出一个可以纪律化的嗯"},{"start":147.71,"end":152.77,"text":"可以如臂使指的调配的整个中层管理体系"},{"start":152.77,"end":154.27,"text":"也没有"},{"start":155.71,"end":158.27,"text":"我指的是在外地的那部分"},{"start":163.26,"end":165.54,"text":"他们完全被本地利益收买"},{"start":165.54,"end":169.99,"text":"或者说被远程所谓的这些道德主义"},{"start":169.99,"end":174.93,"text":"献爱心的小资的月费给收买了叛徒"},{"start":176.07,"end":178.59,"text":"这群人可以说是叛徒"},{"start":182.98,"end":184.58,"text":"所以我们现在做的准备"},{"start":184.58,"end":186.54,"text":"我们还需要什么"},{"start":194.32,"end":197.64,"text":"我们需要一支纪律化的产业工人"},{"start":199.3,"end":203.18,"text":"团队人数不能太多"},{"start":203.18,"end":205.38,"text":"也不需要太多"},{"start":206.27,"end":208.83,"text":"200人到400人左右"},{"start":212.16,"end":213.9,"text":"然后我们需要资金"},{"start":213.9,"end":215.14,"text":"需要资本"},{"start":215.14,"end":216.88,"text":"需要土地和厂房"},{"start":216.88,"end":218.459,"text":"需要机器"},{"start":218.819,"end":219.459,"text":"更重要的"},{"start":219.459,"end":221.059,"text":"我们需要技术"},{"start":221.46,"end":225.28,"text":"我们需要在这个聚生智能行业当中"},{"start":225.28,"end":226.96,"text":"占有一席之地"},{"start":226.96,"end":228.42,"text":"我们需要阻击"},{"start":228.42,"end":230.48,"text":"我们需要远征"},{"start":234.16,"end":235.52,"text":"所谓的执勤俱乐部"},{"start":235.52,"end":239.72,"text":"完全不足以去支撑这样的远征"},{"start":240.32,"end":242.02,"text":"你给他们提供廉价餐饮"},{"start":242.02,"end":243.72,"text":"我们提供了"},{"start":246.08,"end":247.24,"text":"那外地的授权"},{"start":247.24,"end":249.92,"text":"那俱乐部没有一个做到的"},{"start":251.3,"end":253.5,"text":"提供廉价餐饮的目的是什么"},{"start":253.5,"end":257.54,"text":"是让产业工人足够快的"},{"start":265.63,"end":270.83,"text":"并且形成哈我们看到的是虚伪的互助网络"},{"start":271.53,"end":273.33,"text":"我们从来要求的不是互助"},{"start":273.33,"end":274.77,"text":"而是互保"},{"start":275.33,"end":278.81,"text":"是高标准严格要求的互保关系"},{"start":282.2,"end":284.92,"text":"他们完全堕落成了小资阶的道德主义"},{"start":284.92,"end":287.28,"text":"互助小修小补"},{"start":287.28,"end":289.0,"text":"小打小闹"},{"start":289.84,"end":291.24,"text":"互相蒙骗"},{"start":291.24,"end":292.32,"text":"过得了一时"},{"start":292.32,"end":294.4,"text":"你过得了一世吗"},{"start":295.53,"end":296.95,"text":"说我是骗子"},{"start":296.95,"end":298.91,"text":"你们每天都在欺骗自己"},{"start":298.91,"end":301.72,"text":"就这种温吞水煮青蛙的日子"},{"start":302.12,"end":304.76,"text":"你们倒是过得住的啊"},{"start":315.12,"end":318.36,"text":"我们的设计方案是这样的"},{"start":320.2,"end":323.04,"text":"通过俱乐部的时速托底"},{"start":324.04,"end":325.6,"text":"前俱乐部的时速托底"},{"start":325.6,"end":327.84,"text":"生活服务的时速托底"},{"start":328.24,"end":330.12,"text":"产业工人或者服务业工人"},{"start":330.12,"end":332.92,"text":"每个月能够积累2000元左右的剩余"},{"start":334.0,"end":336.08,"text":"如果是300人的话"},{"start":340.48,"end":342.77,"text":"那么一个月就是60万"},{"start":342.77,"end":344.39,"text":"一年就是600万"},{"start":344.39,"end":346.37,"text":"两年就是1200万"},{"start":346.37,"end":352.255,"text":"这个钱可以作为跨入聚生智能行业的准备基因"},{"start":353.439,"end":355.539,"text":"我们会贴资的"},{"start":355.539,"end":357.619,"text":"我们会想方设法的"},{"start":357.619,"end":358.539,"text":"1200万"},{"start":358.539,"end":359.539,"text":"我给你贴600万"},{"start":359.539,"end":360.579,"text":"1800万"},{"start":360.579,"end":364.539,"text":"保证你们牢方占主要资本"},{"start":366.44,"end":368.84,"text":"我们会去训练匹配"},{"start":368.84,"end":372.419,"text":"有阶级忠诚的管理和技术人员"},{"start":372.819,"end":375.179,"text":"但是你们什么都没有做"},{"start":377.1,"end":379.34,"text":"我们遭受到的是"},{"start":379.8,"end":382.96,"text":"这产业无产者和这所谓的这些服务业无产者"},{"start":382.96,"end":384.16,"text":"主要是服务业无产者"},{"start":385.28,"end":391.48,"text":"轻劳动轻技术的服务业无产者也在叛离"},{"start":394.36,"end":395.2,"text":"我说了"},{"start":395.2,"end":397.2,"text":"要转向培训部"},{"start":399.04,"end":400.48,"text":"不听指挥"},{"start":400.48,"end":401.86,"text":"毫无战略"},{"start":401.86,"end":403.38,"text":"原地踏步"},{"start":403.38,"end":405.32,"text":"固步自封"},{"start":414.08,"end":420.28,"text":"一个孱弱的毫无自我意识的无产阶级"},{"start":421.5,"end":424.36,"text":"小股的汇聚起来的"},{"start":424.36,"end":426.94,"text":"我甚至不觉得你们这群人聚起来之后"},{"start":426.94,"end":429.789,"text":"具有阶级意识的阶级代表性"},{"start":431.0,"end":432.96,"text":"你不配被惯进于无产阶级"},{"start":434.76,"end":436.96,"text":"一群无产者罢了"},{"start":439.54,"end":444.28,"text":"所以继续给这个项目接驳的是培训部"},{"start":444.28,"end":446.74,"text":"培训部提供的是"},{"start":449.5,"end":452.66,"text":"作为技术预备性的电工"},{"start":452.66,"end":457.06,"text":"电气知识和汽修工机械知识"},{"start":461.28,"end":463.08,"text":"可以切入这个产业"