{
  "bvid": "BV1xw41167Kh",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "ce0408697f603e3f4d86e1dc55d3b4e8e99a6ed7abdf15933b6fcfe936200eb7",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 620,
      "end_ms": 4970,
      "text": "你们不要一天到晚嘲笑这个过继承"
    },
    {
      "ordinal": 1,
      "start_ms": 4970,
      "end_ms": 7890,
      "text": "他名字里面带继承两个字"
    },
    {
      "ordinal": 2,
      "start_ms": 8530,
      "end_ms": 9690,
      "text": "他姓郭啊"
    },
    {
      "ordinal": 3,
      "start_ms": 9690,
      "end_ms": 11190,
      "text": "这个名字郭陈强"
    },
    {
      "ordinal": 4,
      "start_ms": 13050,
      "end_ms": 14760,
      "text": "郭继承"
    },
    {
      "ordinal": 5,
      "start_ms": 15280,
      "end_ms": 16740,
      "text": "国外还有这个城市"
    },
    {
      "ordinal": 6,
      "start_ms": 16740,
      "end_ms": 19350,
      "text": "就城墙里面的世界"
    },
    {
      "ordinal": 7,
      "start_ms": 19350,
      "end_ms": 20950,
      "text": "这个意味在里面"
    },
    {
      "ordinal": 8,
      "start_ms": 20950,
      "end_ms": 24610,
      "text": "他讲的这套鹿角这吊东西为什么臭脚"
    },
    {
      "ordinal": 9,
      "start_ms": 24610,
      "end_ms": 25090,
      "text": "有人捧他"
    },
    {
      "ordinal": 10,
      "start_ms": 25090,
      "end_ms": 26080,
      "text": "或者说怎么样"
    },
    {
      "ordinal": 11,
      "start_ms": 26080,
      "end_ms": 28440,
      "text": "它代表一种沉默的"
    },
    {
      "ordinal": 12,
      "start_ms": 28440,
      "end_ms": 30060,
      "text": "大多数就是你们这些年轻人"
    },
    {
      "ordinal": 13,
      "start_ms": 30060,
      "end_ms": 34770,
      "text": "你们都要想想你爹妈老病死问题怎么解决"
    },
    {
      "ordinal": 14,
      "start_ms": 35230,
      "end_ms": 37740,
      "text": "前现代儒教复苏是有它的社会根源的"
    },
    {
      "ordinal": 15,
      "start_ms": 37740,
      "end_ms": 41070,
      "text": "你这爹妈的老病死的问题怎么解决"
    },
    {
      "ordinal": 16,
      "start_ms": 41770,
      "end_ms": 42990,
      "text": "全靠国家兜底嘛"
    },
    {
      "ordinal": 17,
      "start_ms": 42990,
      "end_ms": 47030,
      "text": "养老金或者说这个医疗保险够吗"
    },
    {
      "ordinal": 18,
      "start_ms": 47130,
      "end_ms": 48980,
      "text": "对每个家长都够吗"
    },
    {
      "ordinal": 19,
      "start_ms": 48980,
      "end_ms": 52970,
      "text": "对每个家长的每一种疑难杂症都够吗"
    },
    {
      "ordinal": 20,
      "start_ms": 55340,
      "end_ms": 56560,
      "text": "更不要说你自己"
    },
    {
      "ordinal": 21,
      "start_ms": 56560,
      "end_ms": 57400,
      "text": "你自己怎么办"
    },
    {
      "ordinal": 22,
      "start_ms": 58840,
      "end_ms": 60610,
      "text": "这是个大的压抑"
    },
    {
      "ordinal": 23,
      "start_ms": 60610,
      "end_ms": 61480,
      "text": "大的压力"
    },
    {
      "ordinal": 24,
      "start_ms": 61480,
      "end_ms": 63790,
      "text": "有时候我问我刚刚还说了"
    },
    {
      "ordinal": 25,
      "start_ms": 63790,
      "end_ms": 65950,
      "text": "年轻人头脑里冒出来的想法"
    },
    {
      "ordinal": 26,
      "start_ms": 65950,
      "end_ms": 67510,
      "text": "都只是意识形态大乱斗"
    },
    {
      "ordinal": 27,
      "start_ms": 67510,
      "end_ms": 70549,
      "text": "那最后冒出来一个啊自动生成的一个结果"
    },
    {
      "ordinal": 28,
      "start_ms": 70549,
      "end_ms": 72409,
      "text": "每个人你们的自由意志"
    },
    {
      "ordinal": 29,
      "start_ms": 72409,
      "end_ms": 75679,
      "text": "只不过是这个社会上的各种符号啊"
    },
    {
      "ordinal": 30,
      "start_ms": 75679,
      "end_ms": 79350,
      "text": "话语它的那个什么训练出来的"
    },
    {
      "ordinal": 31,
      "start_ms": 79350,
      "end_ms": 80670,
      "text": "我刚刚还是这样说的"
    },
    {
      "ordinal": 32,
      "start_ms": 80670,
      "end_ms": 84450,
      "text": "但是你有一个最基本的最低限度的自由度"
    },
    {
      "ordinal": 33,
      "start_ms": 84450,
      "end_ms": 86780,
      "text": "这个最低限度的自由度是什么"
    },
    {
      "ordinal": 34,
      "start_ms": 86780,
      "end_ms": 89900,
      "text": "是你的父母在训练你的意识的时候"
    },
    {
      "ordinal": 35,
      "start_ms": 89900,
      "end_ms": 92530,
      "text": "把像把你像人工智能一样训练出来的时候"
    },
    {
      "ordinal": 36,
      "start_ms": 92530,
      "end_ms": 94030,
      "text": "你的父母的话语本身"
    },
    {
      "ordinal": 37,
      "start_ms": 94030,
      "end_ms": 97330,
      "text": "也包含了他自己的生存焦虑"
    },
    {
      "ordinal": 38,
      "start_ms": 103260,
      "end_ms": 104900,
      "text": "你爹妈不要老病死吗"
    },
    {
      "ordinal": 39,
      "start_ms": 104900,
      "end_ms": 106040,
      "text": "你父母的老病死"
    },
    {
      "ordinal": 40,
      "start_ms": 106040,
      "end_ms": 107120,
      "text": "你可以逃脱吗"
    },
    {
      "ordinal": 41,
      "start_ms": 107120,
      "end_ms": 108770,
      "text": "你可以视而不见吗"
    },
    {
      "ordinal": 42,
      "start_ms": 108770,
      "end_ms": 111440,
      "text": "有多少人可以视而不见"
    },
    {
      "ordinal": 43,
      "start_ms": 113060,
      "end_ms": 115539,
      "text": "有几个人可以视而不见"
    },
    {
      "ordinal": 44,
      "start_ms": 115879,
      "end_ms": 117639,
      "text": "这不是保守不保守的问题"
    },
    {
      "ordinal": 45,
      "start_ms": 117639,
      "end_ms": 119109,
      "text": "这是必然的问题"
    },
    {
      "ordinal": 46,
      "start_ms": 119109,
      "end_ms": 120579,
      "text": "这是个必然性啊"
    },
    {
      "ordinal": 47,
      "start_ms": 121599,
      "end_ms": 122679,
      "text": "这是个绝对啊"
    },
    {
      "ordinal": 48,
      "start_ms": 126270,
      "end_ms": 128220,
      "text": "这也是个绝对"
    },
    {
      "ordinal": 49,
      "start_ms": 128440,
      "end_ms": 130139,
      "text": "你老了之后的孤独的问题"
    },
    {
      "ordinal": 50,
      "start_ms": 130139,
      "end_ms": 130919,
      "text": "你说不要子女"
    },
    {
      "ordinal": 51,
      "start_ms": 130919,
      "end_ms": 131460,
      "text": "不要后代"
    },
    {
      "ordinal": 52,
      "start_ms": 131460,
      "end_ms": 133020,
      "text": "你老了之后孤独的问题"
    },
    {
      "ordinal": 53,
      "start_ms": 133020,
      "end_ms": 134160,
      "text": "没人给赡养的问题"
    },
    {
      "ordinal": 54,
      "start_ms": 134160,
      "end_ms": 135120,
      "text": "缺乏保障的问题"
    },
    {
      "ordinal": 55,
      "start_ms": 135120,
      "end_ms": 137340,
      "text": "缺衣少药的问题"
    },
    {
      "ordinal": 56,
      "start_ms": 139340,
      "end_ms": 140800,
      "text": "社会啊"
    },
    {
      "ordinal": 57,
      "start_ms": 140800,
      "end_ms": 142480,
      "text": "如果说经济上有什么波动"
    },
    {
      "ordinal": 58,
      "start_ms": 142480,
      "end_ms": 143770,
      "text": "你积累一生的财富"
    },
    {
      "ordinal": 59,
      "start_ms": 143770,
      "end_ms": 145090,
      "text": "可能屁都不是"
    },
    {
      "ordinal": 60,
      "start_ms": 145090,
      "end_ms": 147860,
      "text": "你还是要靠你后代作为一个劳动力"
    },
    {
      "ordinal": 61,
      "start_ms": 147860,
      "end_ms": 149570,
      "text": "从社会当中获得一些财富"
    },
    {
      "ordinal": 62,
      "start_ms": 149570,
      "end_ms": 151010,
      "text": "才能给你治病养老"
    },
    {
      "ordinal": 63,
      "start_ms": 152150,
      "end_ms": 153970,
      "text": "这个都是根本问题"
    },
    {
      "ordinal": 64,
      "start_ms": 153970,
      "end_ms": 156190,
      "text": "你在笑别人保守的时候"
    },
    {
      "ordinal": 65,
      "start_ms": 156190,
      "end_ms": 157750,
      "text": "别人至少开了某种药方"
    },
    {
      "ordinal": 66,
      "start_ms": 157750,
      "end_ms": 160630,
      "text": "向前现代向儒教去靠拢"
    },
    {
      "ordinal": 67,
      "start_ms": 160630,
      "end_ms": 161780,
      "text": "他开了药方"
    },
    {
      "ordinal": 68,
      "start_ms": 161780,
      "end_ms": 163850,
      "text": "他至少他看到这个问题啊"
    },
    {
      "ordinal": 69,
      "start_ms": 163850,
      "end_ms": 165500,
      "text": "或者他至少他这个药方本身"
    },
    {
      "ordinal": 70,
      "start_ms": 165500,
      "end_ms": 167510,
      "text": "是对这个问题的回应"
    },
    {
      "ordinal": 71,
      "start_ms": 167510,
      "end_ms": 169070,
      "text": "有意或无意的回应"
    },
    {
      "ordinal": 72,
      "start_ms": 169070,
      "end_ms": 171889,
      "text": "你们呢你们连这个问题看都不看"
    },
    {
      "ordinal": 73,
      "start_ms": 171889,
      "end_ms": 173209,
      "text": "逃避这个问题"
    },
    {
      "ordinal": 74,
      "start_ms": 173209,
      "end_ms": 175309,
      "text": "不去设想任何去改变"
    },
    {
      "ordinal": 75,
      "start_ms": 175309,
      "end_ms": 176449,
      "text": "解决这个问题"
    },
    {
      "ordinal": 76,
      "start_ms": 176449,
      "end_ms": 178730,
      "text": "你连钱现在都不如"
    },
    {
      "ordinal": 77,
      "start_ms": 179010,
      "end_ms": 181810,
      "text": "你们这连钱现在都不如唉"
    },
    {
      "ordinal": 78,
      "start_ms": 181810,
      "end_ms": 183670,
      "text": "你那种哗众取宠的"
    },
    {
      "ordinal": 79,
      "start_ms": 183670,
      "end_ms": 185890,
      "text": "举世都视之为小丑啊"
    },
    {
      "ordinal": 80,
      "start_ms": 185890,
      "end_ms": 188350,
      "text": "视之为这个这个不学无术的小丑的人"
    },
    {
      "ordinal": 81,
      "start_ms": 188350,
      "end_ms": 192330,
      "text": "你都不如你好意思嘲笑他"
    },
    {
      "ordinal": 82,
      "start_ms": 194040,
      "end_ms": 197510,
      "text": "你们似乎好像就是说不活在这人世间一样诶"
    },
    {
      "ordinal": 83,
      "start_ms": 197510,
      "end_ms": 199640,
      "text": "你不是爹妈生的"
    },
    {
      "ordinal": 84,
      "start_ms": 199640,
      "end_ms": 201090,
      "text": "你自己"
    },
    {
      "ordinal": 85,
      "start_ms": 201090,
      "end_ms": 204750,
      "text": "好像你自己身上那套生殖器就不会产生后代"
    },
    {
      "ordinal": 86,
      "start_ms": 204750,
      "end_ms": 205110,
      "text": "一样的"
    },
    {
      "ordinal": 87,
      "start_ms": 205110,
      "end_ms": 207150,
      "text": "你好像整个东方不败"
    },
    {
      "ordinal": 88,
      "start_ms": 207150,
      "end_ms": 209870,
      "text": "或者说飘在天上的人呢"
    },
    {
      "ordinal": 89,
      "start_ms": 210270,
      "end_ms": 211880,
      "text": "小孩活在梦里"
    },
    {
      "ordinal": 90,
      "start_ms": 211880,
      "end_ms": 215680,
      "text": "才永远把这东西当成儿戏来看待"
    },
    {
      "ordinal": 91,
      "start_ms": 216140,
      "end_ms": 218710,
      "text": "他是一个保守主义的人物"
    },
    {
      "ordinal": 92,
      "start_ms": 218710,
      "end_ms": 221140,
      "text": "讲的那些话也都是非常愚蠢的"
    },
    {
      "ordinal": 93,
      "start_ms": 221140,
      "end_ms": 223540,
      "text": "前现代保守主义bullshit没错"
    },
    {
      "ordinal": 94,
      "start_ms": 223540,
      "end_ms": 226940,
      "text": "但是有根本的利益的纠葛"
    },
    {
      "ordinal": 95,
      "start_ms": 226940,
      "end_ms": 231140,
      "text": "根本的数亿人口的绝对的一个未来"
    },
    {
      "ordinal": 96,
      "start_ms": 231140,
      "end_ms": 234530,
      "text": "在等着在验证"
    },
    {
      "ordinal": 97,
      "start_ms": 234690,
      "end_ms": 237110,
      "text": "在作为一个非常坚硬的"
    },
    {
      "ordinal": 98,
      "start_ms": 237110,
      "end_ms": 242329,
      "text": "而且是铺天盖地巨大的一个神圣的事件集"
    },
    {
      "ordinal": 99,
      "start_ms": 242329,
      "end_ms": 244009,
      "text": "那么多人的妈妈"
    },
    {
      "ordinal": 100,
      "start_ms": 244009,
      "end_ms": 245389,
      "text": "爸爸一下子癌症了"
    },
    {
      "ordinal": 101,
      "start_ms": 245389,
      "end_ms": 246889,
      "text": "一下子卧槽中风了"
    },
    {
      "ordinal": 102,
      "start_ms": 246889,
      "end_ms": 248209,
      "text": "心脑血管疾病了哦"
    },
    {
      "ordinal": 103,
      "start_ms": 248209,
      "end_ms": 249829,
      "text": "一下子什么疑难杂症了"
    },
    {
      "ordinal": 104,
      "start_ms": 249829,
      "end_ms": 250429,
      "text": "要几10万"
    },
    {
      "ordinal": 105,
      "start_ms": 250429,
      "end_ms": 253070,
      "text": "几百万上千万要死啊死啊"
    },
    {
      "ordinal": 106,
      "start_ms": 253070,
      "end_ms": 253960,
      "text": "好痛苦"
    },
    {
      "ordinal": 107,
      "start_ms": 253960,
      "end_ms": 255340,
      "text": "几十年的记忆"
    },
    {
      "ordinal": 108,
      "start_ms": 255340,
      "end_ms": 256660,
      "text": "几十年的这一下子"
    },
    {
      "ordinal": 109,
      "start_ms": 256660,
      "end_ms": 257560,
      "text": "我没有爸爸了"
    },
    {
      "ordinal": 110,
      "start_ms": 257560,
      "end_ms": 258579,
      "text": "我没有妈妈了"
    },
    {
      "ordinal": 111,
      "start_ms": 258579,
      "end_ms": 260140,
      "text": "这都是海量的痛苦"
    },
    {
      "ordinal": 112,
      "start_ms": 260140,
      "end_ms": 261839,
      "text": "绝对是痛苦"
    },
    {
      "ordinal": 113,
      "start_ms": 261839,
      "end_ms": 263310,
      "text": "你以为你可以逃避"
    },
    {
      "ordinal": 114,
      "start_ms": 263310,
      "end_ms": 264540,
      "text": "你以为你现在年轻"
    },
    {
      "ordinal": 115,
      "start_ms": 264540,
      "end_ms": 265500,
      "text": "你爸爸妈也年轻"
    },
    {
      "ordinal": 116,
      "start_ms": 265500,
      "end_ms": 266250,
      "text": "四五十岁"
    },
    {
      "ordinal": 117,
      "start_ms": 266250,
      "end_ms": 267450,
      "text": "你就可以逃避"
    },
    {
      "ordinal": 118,
      "start_ms": 267450,
      "end_ms": 270340,
      "text": "你可以一辈子不面对这东西"
    },
    {
      "ordinal": 119,
      "start_ms": 270800,
      "end_ms": 272260,
      "text": "你爷爷奶奶去世的时候"
    },
    {
      "ordinal": 120,
      "start_ms": 272260,
      "end_ms": 275560,
      "text": "你也感受到你父母身上的痛苦了吧"
    },
    {
      "ordinal": 121,
      "start_ms": 277960,
      "end_ms": 282320,
      "text": "这是这是没有办法逃避的"
    },
    {
      "ordinal": 122,
      "start_ms": 282660,
      "end_ms": 285140,
      "text": "这不是说你现在一天到晚玩游戏"
    },
    {
      "ordinal": 123,
      "start_ms": 285140,
      "end_ms": 286740,
      "text": "一天到晚看什么短视频"
    },
    {
      "ordinal": 124,
      "start_ms": 286740,
      "end_ms": 289680,
      "text": "因为他会在一个年轻人的那个社群空间里面"
    },
    {
      "ordinal": 125,
      "start_ms": 289680,
      "end_ms": 292549,
      "text": "互联网虚拟世界里面就可以逃避这些东西的"
    },
    {
      "ordinal": 126,
      "start_ms": 292549,
      "end_ms": 293719,
      "text": "不可能的"
    },
    {
      "ordinal": 127,
      "start_ms": 293719,
      "end_ms": 295819,
      "text": "你让代沟无限大"
    },
    {
      "ordinal": 128,
      "start_ms": 295819,
      "end_ms": 300679,
      "text": "不意味着说到时候你就不感受到任何的创伤"
    },
    {
      "ordinal": 129,
      "start_ms": 300679,
      "end_ms": 302809,
      "text": "因为你作为一个人工智能"
    },
    {
      "ordinal": 130,
      "start_ms": 302809,
      "end_ms": 304879,
      "text": "是你爹妈亲手训练出来的"
    },
    {
      "ordinal": 131,
      "start_ms": 305800,
      "end_ms": 308800,
      "text": "当然你爹妈这个人工智能也是由他们的爹妈"
    },
    {
      "ordinal": 132,
      "start_ms": 308800,
      "end_ms": 311740,
      "text": "或者说整个社会训练出来的啊"
    },
    {
      "ordinal": 133,
      "start_ms": 311740,
      "end_ms": 313200,
      "text": "意识的传承"
    },
    {
      "ordinal": 134,
      "start_ms": 313200,
      "end_ms": 315450,
      "text": "他名字里面带继承这两个字"
    },
    {
      "ordinal": 135,
      "start_ms": 315450,
      "end_ms": 319020,
      "text": "就已经代表他那讲他这套东西的"
    },
    {
      "ordinal": 136,
      "start_ms": 319020,
      "end_ms": 321210,
      "text": "为什么其他人没有火呢"
    },
    {
      "ordinal": 137,
      "start_ms": 321490,
      "end_ms": 324450,
      "text": "仅仅是因为他表现的比较相对比较滑稽一点"
    },
    {
      "ordinal": 138,
      "start_ms": 324450,
      "end_ms": 326610,
      "text": "或者说讲的如如如如"
    },
    {
      "ordinal": 139,
      "start_ms": 326610,
      "end_ms": 329890,
      "text": "如如如如的一点好玩一点嘛"
    },
    {
      "ordinal": 140,
      "start_ms": 330170,
      "end_ms": 332410,
      "text": "是因为它代表了一个严肃的问题"
    },
    {
      "ordinal": 141,
      "start_ms": 332410,
      "end_ms": 333730,
      "text": "与这个严肃的问题"
    },
    {
      "ordinal": 142,
      "start_ms": 333730,
      "end_ms": 335140,
      "text": "与你们这些小孩"
    },
    {
      "ordinal": 143,
      "start_ms": 335140,
      "end_ms": 337860,
      "text": "你们这败类没有去面对它"
    },
    {
      "ordinal": 144,
      "start_ms": 337860,
      "end_ms": 338970,
      "text": "不思考"
    },
    {
      "ordinal": 145,
      "start_ms": 338970,
      "end_ms": 341400,
      "text": "严肃的去面对它"
    },
    {
      "ordinal": 146,
      "start_ms": 346900,
      "end_ms": 348000,
      "text": "所以在这个意义上讲"
    },
    {
      "ordinal": 147,
      "start_ms": 348000,
      "end_ms": 349200,
      "text": "就不要一直耻笑人家"
    },
    {
      "ordinal": 148,
      "start_ms": 349200,
      "end_ms": 350130,
      "text": "嘲笑他"
    },
    {
      "ordinal": 149,
      "start_ms": 350130,
      "end_ms": 352920,
      "text": "是他确实蛮挫的"
    },
    {
      "ordinal": 150,
      "start_ms": 352920,
      "end_ms": 355960,
      "text": "很low啊"
    },
    {
      "ordinal": 151,
      "start_ms": 355960,
      "end_ms": 357070,
      "text": "是什么"
    },
    {
      "ordinal": 152,
      "start_ms": 357070,
      "end_ms": 358480,
      "text": "亚里士多德来了"
    },
    {
      "ordinal": 153,
      "start_ms": 358480,
      "end_ms": 359830,
      "text": "我一定要跪下去啊"
    },
    {
      "ordinal": 154,
      "start_ms": 359830,
      "end_ms": 361930,
      "text": "什么什么苏格拉底的跪倒"
    },
    {
      "ordinal": 155,
      "start_ms": 361930,
      "end_ms": 366160,
      "text": "很多人就是说直接我在B站看到了"
    },
    {
      "ordinal": 156,
      "start_ms": 366160,
      "end_ms": 368200,
      "text": "直接人身攻击侮辱他的视频"
    },
    {
      "ordinal": 157,
      "start_ms": 368200,
      "end_ms": 370660,
      "text": "那个铺天盖地的"
    },
    {
      "ordinal": 158,
      "start_ms": 371940,
      "end_ms": 375440,
      "text": "但我也不是说站在一个法律中立主义角度"
    },
    {
      "ordinal": 159,
      "start_ms": 375440,
      "end_ms": 377180,
      "text": "要去维护他的合法权益啊"
    },
    {
      "ordinal": 160,
      "start_ms": 377180,
      "end_ms": 378620,
      "text": "这不是说我在意的"
    },
    {
      "ordinal": 161,
      "start_ms": 378620,
      "end_ms": 381140,
      "text": "我在意的就是说你们不要小瞧了"
    },
    {
      "ordinal": 162,
      "start_ms": 381260,
      "end_ms": 387620,
      "text": "不要小瞧了这个人所代表的那个如海四川啊"
    },
    {
      "ordinal": 163,
      "start_ms": 387620,
      "end_ms": 395600,
      "text": "如山如丘壑一般的那样的巨大的社会力量"
    },
    {
      "ordinal": 164,
      "start_ms": 395760,
      "end_ms": 397820,
      "text": "巨大的社会现实"
    },
    {
      "ordinal": 165,
      "start_ms": 397820,
      "end_ms": 399290,
      "text": "你们都在忽视"
    },
    {
      "ordinal": 166,
      "start_ms": 399290,
      "end_ms": 401900,
      "text": "想要把这个这个人作为一个丑角"
    },
    {
      "ordinal": 167,
      "start_ms": 401900,
      "end_ms": 402740,
      "text": "儒教一形态前"
    },
    {
      "ordinal": 168,
      "start_ms": 402740,
      "end_ms": 404120,
      "text": "现在一形态作为一个丑角"
    },
    {
      "ordinal": 169,
      "start_ms": 404120,
      "end_ms": 404780,
      "text": "把他打掉了"
    },
    {
      "ordinal": 170,
      "start_ms": 404780,
      "end_ms": 406340,
      "text": "你好像不面对这些东西了"
    },
    {
      "ordinal": 171,
      "start_ms": 406340,
      "end_ms": 410060,
      "text": "你的人生具有这样的使命"
    },
    {
      "ordinal": 172,
      "start_ms": 410060,
      "end_ms": 413110,
      "text": "也具有这样的宿命"
    },
    {
      "ordinal": 173,
      "start_ms": 413110,
      "end_ms": 414490,
      "text": "悲剧性的宿命"
    },
    {
      "ordinal": 174,
      "start_ms": 414490,
      "end_ms": 417070,
      "text": "甚至说要去面对"
    },
    {
      "ordinal": 175,
      "start_ms": 419540,
      "end_ms": 421240,
      "text": "你们绝大部分"
    },
    {
      "ordinal": 176,
      "start_ms": 421240,
      "end_ms": 423940,
      "text": "你们这些小孩都还是在怎么样在逃避啊"
    },
    {
      "ordinal": 177,
      "start_ms": 423940,
      "end_ms": 425750,
      "text": "你爹妈不要死的吗"
    },
    {
      "ordinal": 178,
      "start_ms": 425750,
      "end_ms": 427190,
      "text": "你爹妈是神仙"
    },
    {
      "ordinal": 179,
      "start_ms": 427190,
      "end_ms": 428690,
      "text": "可以长生不老"
    },
    {
      "ordinal": 180,
      "start_ms": 428690,
      "end_ms": 431510,
      "text": "那你自己不要死的吗"
    },
    {
      "ordinal": 181,
      "start_ms": 432480,
      "end_ms": 434780,
      "text": "你以为你在逃避"
    },
    {
      "ordinal": 182,
      "start_ms": 438089,
      "end_ms": 441250,
      "text": "就像一个烟民一天到晚说啊"
    },
    {
      "ordinal": 183,
      "start_ms": 441250,
      "end_ms": 442990,
      "text": "我的肺癌什么算什么啊"
    },
    {
      "ordinal": 184,
      "start_ms": 442990,
      "end_ms": 445810,
      "text": "你说谁谁谁抽烟活了90几岁呢"
    },
    {
      "ordinal": 185,
      "start_ms": 445810,
      "end_ms": 447350,
      "text": "什么什么什么"
    },
    {
      "ordinal": 186,
      "start_ms": 447750,
      "end_ms": 448370,
      "text": "真的"
    },
    {
      "ordinal": 187,
      "start_ms": 448370,
      "end_ms": 450650,
      "text": "周围有一个朋友他妈得肺癌死了"
    },
    {
      "ordinal": 188,
      "start_ms": 450650,
      "end_ms": 452310,
      "text": "他妈立刻戒了"
    },
    {
      "ordinal": 189,
      "start_ms": 452310,
      "end_ms": 455520,
      "text": "你们这只不过是只不过就是马虎"
    },
    {
      "ordinal": 190,
      "start_ms": 455520,
      "end_ms": 457260,
      "text": "你们这些人只是马虎"
    },
    {
      "ordinal": 191,
      "start_ms": 457260,
      "end_ms": 457950,
      "text": "不严肃"
    },
    {
      "ordinal": 192,
      "start_ms": 457950,
      "end_ms": 460500,
      "text": "不认真啊"
    },
    {
      "ordinal": 193,
      "start_ms": 460500,
      "end_ms": 462500,
      "text": "幼稚而已"
    },
    {
      "ordinal": 194,
      "start_ms": 464420,
      "end_ms": 466120,
      "text": "幼稚而愚蠢"
    },
    {
      "ordinal": 195,
      "start_ms": 466120,
      "end_ms": 468020,
      "text": "无能而幼稚"
    },
    {
      "ordinal": 196,
      "start_ms": 468240,
      "end_ms": 471320,
      "text": "你们比你们所耻笑的人不好到哪里去"
    },
    {
      "ordinal": 197,
      "start_ms": 471320,
      "end_ms": 473409,
      "text": "根本不好到哪里去"
    },
    {
      "ordinal": 198,
      "start_ms": 473629,
      "end_ms": 475869,
      "text": "你真的比他好到哪里去"
    },
    {
      "ordinal": 199,
      "start_ms": 475869,
      "end_ms": 478580,
      "text": "请问你给这些开开药方"
    },
    {
      "ordinal": 200,
      "start_ms": 478580,
      "end_ms": 480860,
      "text": "你爹妈如果是城市普通职工"
    },
    {
      "ordinal": 201,
      "start_ms": 480860,
      "end_ms": 483350,
      "text": "将来养老金一个月2000块钱"
    },
    {
      "ordinal": 202,
      "start_ms": 483350,
      "end_ms": 484610,
      "text": "如果得了癌症"
    },
    {
      "ordinal": 203,
      "start_ms": 484610,
      "end_ms": 486080,
      "text": "需要他妈的300万"
    },
    {
      "ordinal": 204,
      "start_ms": 486080,
      "end_ms": 487040,
      "text": "200万"
    },
    {
      "ordinal": 205,
      "start_ms": 487040,
      "end_ms": 487910,
      "text": "哪里来"
    },
    {
      "ordinal": 206,
      "start_ms": 487910,
      "end_ms": 490400,
      "text": "天天去卖屁股钱都不够"
    },
    {
      "ordinal": 207,
      "start_ms": 490800,
      "end_ms": 492200,
      "text": "而且你爸妈得癌的时候"
    },
    {
      "ordinal": 208,
      "start_ms": 492200,
      "end_ms": 493040,
      "text": "你可能四五十岁"
    },
    {
      "ordinal": 209,
      "start_ms": 493040,
      "end_ms": 494930,
      "text": "你已经不适合去卖屁股了"
    },
    {
      "ordinal": 210,
      "start_ms": 494930,
      "end_ms": 498950,
      "text": "你靠什么来支撑巨大的海量的悲剧"
    },
    {
      "ordinal": 211,
      "start_ms": 498950,
      "end_ms": 500690,
      "text": "天天这个借酒浇愁"
    },
    {
      "ordinal": 212,
      "start_ms": 500690,
      "end_ms": 501830,
      "text": "把自己灌醉了"
    },
    {
      "ordinal": 213,
      "start_ms": 501830,
      "end_ms": 503570,
      "text": "逃避"
    },
    {
      "ordinal": 214,
      "start_ms": 506680,
      "end_ms": 509250,
      "text": "可笑可笑"
    },
    {
      "ordinal": 215,
      "start_ms": 509250,
      "end_ms": 510930,
      "text": "你还在这个时候笑人家"
    },
    {
      "ordinal": 216,
      "start_ms": 510930,
      "end_ms": 512340,
      "text": "笑笑笑笑笑笑"
    },
    {
      "ordinal": 217,
      "start_ms": 512340,
      "end_ms": 515610,
      "text": "他真的一直在笑你自己"
    },
    {
      "ordinal": 218,
      "start_ms": 515789,
      "end_ms": 518099,
      "text": "你对这些问题根本没有任何解决方案"
    },
    {
      "ordinal": 219,
      "start_ms": 518099,
      "end_ms": 519448,
      "text": "根本没有任何办法"
    },
    {
      "ordinal": 220,
      "start_ms": 519448,
      "end_ms": 521140,
      "text": "待宰羔羊"
    },
    {
      "ordinal": 221,
      "start_ms": 521140,
      "end_ms": 523059,
      "text": "你只是一个砧板上的肉"
    },
    {
      "ordinal": 222,
      "start_ms": 523059,
      "end_ms": 524860,
      "text": "只不过剁的不是你自己"
    },
    {
      "ordinal": 223,
      "start_ms": 524860,
      "end_ms": 527630,
      "text": "首先被剁的可能是爹妈"
    },
    {
      "ordinal": 224,
      "start_ms": 527970,
      "end_ms": 529550,
      "text": "他能够安稳的养老"
    },
    {
      "ordinal": 225,
      "start_ms": 529550,
      "end_ms": 534340,
      "text": "安稳的致致癌老人基本上都是很多得癌死的"
    },
    {
      "ordinal": 226,
      "start_ms": 534340,
      "end_ms": 536620,
      "text": "或者是什么冠心病或者疑难杂症"
    },
    {
      "ordinal": 227,
      "start_ms": 536620,
      "end_ms": 540300,
      "text": "反正都是要高昂的手术费才能治好或者保存"
    },
    {
      "ordinal": 228,
      "start_ms": 540300,
      "end_ms": 543330,
      "text": "保证他要这个临终生活质量的话"
    },
    {
      "ordinal": 229,
      "start_ms": 543330,
      "end_ms": 544590,
      "text": "你也要花很多钱"
    },
    {
      "ordinal": 230,
      "start_ms": 544590,
      "end_ms": 546650,
      "text": "几10万少不了的"
    },
    {
      "ordinal": 231,
      "start_ms": 547110,
      "end_ms": 550860,
      "text": "你们做什么准备有吗"
    },
    {
      "ordinal": 232,
      "start_ms": 552100,
      "end_ms": 553320,
      "text": "不好意思"
    },
    {
      "ordinal": 233,
      "start_ms": 553320,
      "end_ms": 554880,
      "text": "那我不是说纯粹教练"
    },
    {
      "ordinal": 234,
      "start_ms": 554880,
      "end_ms": 555960,
      "text": "你们做金钱上的准备"
    },
    {
      "ordinal": 235,
      "start_ms": 555960,
      "end_ms": 557790,
      "text": "你也可以想想别的准备"
    },
    {
      "ordinal": 236,
      "start_ms": 557790,
      "end_ms": 560350,
      "text": "别的方法的准备啊"
    },
    {
      "ordinal": 237,
      "start_ms": 560510,
      "end_ms": 562390,
      "text": "对不对"
    },
    {
      "ordinal": 238,
      "start_ms": 566180,
      "end_ms": 569440,
      "text": "所以我们不说考虑这些东西就会变得保守"
    },
    {
      "ordinal": 239,
      "start_ms": 569440,
      "end_ms": 572140,
      "text": "并不一定如此"
    },
    {
      "ordinal": 240,
      "start_ms": 573080,
      "end_ms": 575320,
      "text": "考虑这些东西并不一定会变得保守"
    },
    {
      "ordinal": 241,
      "start_ms": 575320,
      "end_ms": 579580,
      "text": "而是会更积极主动的去寻找思路"
    },
    {
      "ordinal": 242,
      "start_ms": 579580,
      "end_ms": 581690,
      "text": "寻找变化的契机"
    },
    {
      "ordinal": 243,
      "start_ms": 584340,
      "end_ms": 586700,
      "text": "但是目的不是为了满足个人的权益"
    },
    {
      "ordinal": 244,
      "start_ms": 586700,
      "end_ms": 588320,
      "text": "不是为了个人的野心"
    },
    {
      "ordinal": 245,
      "start_ms": 588320,
      "end_ms": 590270,
      "text": "目的不是为了个人享乐"
    },
    {
      "ordinal": 246,
      "start_ms": 590270,
      "end_ms": 591620,
      "text": "个人逞一时风头"
    },
    {
      "ordinal": 247,
      "start_ms": 591620,
      "end_ms": 592940,
      "text": "一时快活"
    },
    {
      "ordinal": 248,
      "start_ms": 593310,
      "end_ms": 596210,
      "text": "这个目的是数亿同胞"
    },
    {
      "ordinal": 249,
      "start_ms": 596210,
      "end_ms": 597530,
      "text": "那么多人口"
    },
    {
      "ordinal": 250,
      "start_ms": 597530,
      "end_ms": 599730,
      "text": "大家都在共同面对这个问题"
    },
    {
      "ordinal": 251,
      "start_ms": 599730,
      "end_ms": 602250,
      "text": "你说让主角前现代什么吃个中药"
    },
    {
      "ordinal": 252,
      "start_ms": 602250,
      "end_ms": 602790,
      "text": "5000块钱"
    },
    {
      "ordinal": 253,
      "start_ms": 602790,
      "end_ms": 604530,
      "text": "让他妈的慢性中毒死了"
    },
    {
      "ordinal": 254,
      "start_ms": 604530,
      "end_ms": 607010,
      "text": "拉倒背后残酷的真相"
    },
    {
      "ordinal": 255,
      "start_ms": 607010,
      "end_ms": 609230,
      "text": "可能是这个他需要儒教来包装一下"
    },
    {
      "ordinal": 256,
      "start_ms": 609230,
      "end_ms": 610790,
      "text": "需要前现代的东西来包装一下"
    },
    {
      "ordinal": 257,
      "start_ms": 610790,
      "end_ms": 611210,
      "text": "算个命"
    },
    {
      "ordinal": 258,
      "start_ms": 611210,
      "end_ms": 613270,
      "text": "但不知算了命"
    },
    {
      "ordinal": 259,
      "start_ms": 613270,
      "end_ms": 614710,
      "text": "算命先生说你能好的"
    },
    {
      "ordinal": 260,
      "start_ms": 614710,
      "end_ms": 615370,
      "text": "回去喝中药"
    },
    {
      "ordinal": 261,
      "start_ms": 615370,
      "end_ms": 615790,
      "text": "5000块钱"
    },
    {
      "ordinal": 262,
      "start_ms": 615790,
      "end_ms": 616690,
      "text": "慢性中毒他妈死了"
    },
    {
      "ordinal": 263,
      "start_ms": 616690,
      "end_ms": 618180,
      "text": "这个东西多了去了"
    },
    {
      "ordinal": 264,
      "start_ms": 618180,
      "end_ms": 620540,
      "text": "或者是讲纯粹的孝道"
    },
    {
      "ordinal": 265,
      "start_ms": 620540,
      "end_ms": 622220,
      "text": "讲儒教传统前现代"
    },
    {
      "ordinal": 266,
      "start_ms": 622220,
      "end_ms": 622760,
      "text": "热泪盈眶"
    },
    {
      "ordinal": 267,
      "start_ms": 622760,
      "end_ms": 624080,
      "text": "然后神儿子要儿子水"
    },
    {
      "ordinal": 268,
      "start_ms": 624080,
      "end_ms": 626420,
      "text": "儿子老人他妈直接就自杀了"
    },
    {
      "ordinal": 269,
      "start_ms": 626420,
      "end_ms": 629140,
      "text": "也有无论如何"
    },
    {
      "ordinal": 270,
      "start_ms": 629140,
      "end_ms": 631930,
      "text": "它能够让这个过关关关难过关关过"
    },
    {
      "ordinal": 271,
      "start_ms": 631930,
      "end_ms": 634390,
      "text": "那赵本山那个什么电视剧里面的主题曲"
    },
    {
      "ordinal": 272,
      "start_ms": 634390,
      "end_ms": 635500,
      "text": "不是这样说的吗"
    },
    {
      "ordinal": 273,
      "start_ms": 635500,
      "end_ms": 638550,
      "text": "他是个惨痛的现实吗"
    },
    {
      "ordinal": 274,
      "start_ms": 638550,
      "end_ms": 640740,
      "text": "你们能面对这个残酷的现实吗"
    },
    {
      "ordinal": 275,
      "start_ms": 640740,
      "end_ms": 642150,
      "text": "或者这个单你买这个单吗"
    },
    {
      "ordinal": 276,
      "start_ms": 642150,
      "end_ms": 642870,
      "text": "你骂郭继承"
    },
    {
      "ordinal": 277,
      "start_ms": 642870,
      "end_ms": 644030,
      "text": "你是这样骂了"
    },
    {
      "ordinal": 278,
      "start_ms": 644030,
      "end_ms": 645050,
      "text": "你爹妈"
    },
    {
      "ordinal": 279,
      "start_ms": 645050,
      "end_ms": 646640,
      "text": "到时候老了病了要死啊"
    },
    {
      "ordinal": 280,
      "start_ms": 646640,
      "end_ms": 648620,
      "text": "你有本事不走他那条路"
    },
    {
      "ordinal": 281,
      "start_ms": 648620,
      "end_ms": 651290,
      "text": "你有本事让他接受完整的现代治疗"
    },
    {
      "ordinal": 282,
      "start_ms": 651290,
      "end_ms": 653450,
      "text": "或者给他现代现代人的体面"
    },
    {
      "ordinal": 283,
      "start_ms": 653450,
      "end_ms": 654900,
      "text": "你怎么能维持"
    },
    {
      "ordinal": 284,
      "start_ms": 654900,
      "end_ms": 657270,
      "text": "你说你不要儒教开的药方"
    },
    {
      "ordinal": 285,
      "start_ms": 657270,
      "end_ms": 658920,
      "text": "临终问题怎么解决"
    },
    {
      "ordinal": 286,
      "start_ms": 658920,
      "end_ms": 660970,
      "text": "笑的问题怎么解决"
    },
    {
      "ordinal": 287,
      "start_ms": 661070,
      "end_ms": 662290,
      "text": "你有本事吗"
    },
    {
      "ordinal": 288,
      "start_ms": 662290,
      "end_ms": 664170,
      "text": "你有想法吗"
    },
    {
      "ordinal": 289,
      "start_ms": 664510,
      "end_ms": 665430,
      "text": "没有呀"
    },
    {
      "ordinal": 290,
      "start_ms": 665430,
      "end_ms": 668970,
      "text": "真他妈笑别人自己是个废物"
    },
    {
      "ordinal": 291,
      "start_ms": 671120,
      "end_ms": 672340,
      "text": "在搞笑"
    },
    {
      "ordinal": 292,
      "start_ms": 672340,
      "end_ms": 676120,
      "text": "所以我所以我们对这些小孩他妈的"
    },
    {
      "ordinal": 293,
      "start_ms": 676120,
      "end_ms": 677200,
      "text": "一天到晚喷这个东西"
    },
    {
      "ordinal": 294,
      "start_ms": 677200,
      "end_ms": 679710,
      "text": "喷也喷不到点子上"
    },
    {
      "ordinal": 295,
      "start_ms": 680350,
      "end_ms": 681630,
      "text": "喷喷喷到点子"
    },
    {
      "ordinal": 296,
      "start_ms": 681630,
      "end_ms": 682830,
      "text": "儒教核心是笑"
    },
    {
      "ordinal": 297,
      "start_ms": 682830,
      "end_ms": 684750,
      "text": "其实儒教等级是七"
    },
    {
      "ordinal": 298,
      "start_ms": 684750,
      "end_ms": 686180,
      "text": "人口再生产"
    },
    {
      "ordinal": 299,
      "start_ms": 686180,
      "end_ms": 687500,
      "text": "满足人口再生产"
    },
    {
      "ordinal": 300,
      "start_ms": 687500,
      "end_ms": 689570,
      "text": "人口再生产当然有淘汰的问题"
    },
    {
      "ordinal": 301,
      "start_ms": 689570,
      "end_ms": 692410,
      "text": "当然有生老病死的问题"
    },
    {
      "ordinal": 302,
      "start_ms": 692990,
      "end_ms": 694570,
      "text": "你们又开不出别的药方"
    },
    {
      "ordinal": 303,
      "start_ms": 694570,
      "end_ms": 696890,
      "text": "就他妈因为他笑别人"
    },
    {
      "ordinal": 304,
      "start_ms": 696890,
      "end_ms": 698630,
      "text": "你以为拼命的笑他"
    },
    {
      "ordinal": 305,
      "start_ms": 698630,
      "end_ms": 699770,
      "text": "你自己就没问题了"
    },
    {
      "ordinal": 306,
      "start_ms": 699770,
      "end_ms": 701570,
      "text": "很多人脑子里面是这样想的"
    },
    {
      "ordinal": 307,
      "start_ms": 701570,
      "end_ms": 703550,
      "text": "拼命的笑他过我自己的生活"
    },
    {
      "ordinal": 308,
      "start_ms": 703550,
      "end_ms": 705140,
      "text": "现代生活享乐生活"
    },
    {
      "ordinal": 309,
      "start_ms": 705140,
      "end_ms": 707810,
      "text": "单身贵族在城市里面像个小孩一样"
    },
    {
      "ordinal": 310,
      "start_ms": 707810,
      "end_ms": 710690,
      "text": "一天到晚的吃他妈电子榨菜"
    },
    {
      "ordinal": 311,
      "start_ms": 710690,
      "end_ms": 711920,
      "text": "玩手游"
    },
    {
      "ordinal": 312,
      "start_ms": 711920,
      "end_ms": 713720,
      "text": "充钱啊"
    },
    {
      "ordinal": 313,
      "start_ms": 713720,
      "end_ms": 716750,
      "text": "一些低档次的一些城市消费"
    },
    {
      "ordinal": 314,
      "start_ms": 716750,
      "end_ms": 717770,
      "text": "享乐消费"
    },
    {
      "ordinal": 315,
      "start_ms": 717770,
      "end_ms": 719930,
      "text": "然后一切问题就假装不存在"
    },
    {
      "ordinal": 316,
      "start_ms": 719930,
      "end_ms": 721430,
      "text": "混到个三四十岁"
    },
    {
      "ordinal": 317,
      "start_ms": 721430,
      "end_ms": 722420,
      "text": "四五十岁"
    },
    {
      "ordinal": 318,
      "start_ms": 722420,
      "end_ms": 724390,
      "text": "然后再去攒点钱"
    },
    {
      "ordinal": 319,
      "start_ms": 724390,
      "end_ms": 726430,
      "text": "全球去穷游或者怎么样的啊"
    },
    {
      "ordinal": 320,
      "start_ms": 726430,
      "end_ms": 727740,
      "text": "快一些啊"
    },
    {
      "ordinal": 321,
      "start_ms": 727740,
      "end_ms": 728850,
      "text": "快意享乐"
    },
    {
      "ordinal": 322,
      "start_ms": 728850,
      "end_ms": 731520,
      "text": "卧槽混个艾滋病或者梅毒出来"
    },
    {
      "ordinal": 323,
      "start_ms": 731520,
      "end_ms": 731880,
      "text": "死了"
    },
    {
      "ordinal": 324,
      "start_ms": 731880,
      "end_ms": 732720,
      "text": "拉倒烂大街"
    },
    {
      "ordinal": 325,
      "start_ms": 732720,
      "end_ms": 734670,
      "text": "爹妈哦"
    },
    {
      "ordinal": 326,
      "start_ms": 734670,
      "end_ms": 735330,
      "text": "爹妈的事"
    },
    {
      "ordinal": 327,
      "start_ms": 735330,
      "end_ms": 739980,
      "text": "当然你就不需要再去再去面对你这种烂人"
    },
    {
      "ordinal": 328,
      "start_ms": 739980,
      "end_ms": 741500,
      "text": "活着干什么"
    },
    {
      "ordinal": 329,
      "start_ms": 741500,
      "end_ms": 743570,
      "text": "你比郭麒麟好在哪里吗"
    },
    {
      "ordinal": 330,
      "start_ms": 743570,
      "end_ms": 744920,
      "text": "好不到哪里去"
    },
    {
      "ordinal": 331,
      "start_ms": 744920,
      "end_ms": 747210,
      "text": "你烂多了"
    },
    {
      "ordinal": 332,
      "start_ms": 747670,
      "end_ms": 751409,
      "text": "失球奖明白吗"
    },
    {
      "ordinal": 333,
      "start_ms": 751409,
      "end_ms": 754930,
      "text": "所以我说这种比较挫的这种意识形态"
    },
    {
      "ordinal": 334,
      "start_ms": 754930,
      "end_ms": 756430,
      "text": "比较落后的前线"
    },
    {
      "ordinal": 335,
      "start_ms": 756430,
      "end_ms": 758230,
      "text": "这种意识在开的这种垃圾药方"
    },
    {
      "ordinal": 336,
      "start_ms": 758230,
      "end_ms": 761860,
      "text": "几百年前上几百年前的老药方"
    },
    {
      "ordinal": 337,
      "start_ms": 761860,
      "end_ms": 763360,
      "text": "开出来狗皮膏药"
    },
    {
      "ordinal": 338,
      "start_ms": 763360,
      "end_ms": 765780,
      "text": "拿出来是因为"
    },
    {
      "ordinal": 339,
      "start_ms": 766660,
      "end_ms": 769440,
      "text": "狗皮膏药拿出来大型鱼市"
    },
    {
      "ordinal": 340,
      "start_ms": 769440,
      "end_ms": 773780,
      "text": "是因为你应当做现代药理学实验的"
    },
    {
      "ordinal": 341,
      "start_ms": 778640,
      "end_ms": 781069,
      "text": "看自己的精液的没有"
    },
    {
      "ordinal": 342,
      "start_ms": 781069,
      "end_ms": 782270,
      "text": "在制药"
    },
    {
      "ordinal": 343,
      "start_ms": 782270,
      "end_ms": 783410,
      "text": "你该做的"
    },
    {
      "ordinal": 344,
      "start_ms": 783410,
      "end_ms": 784430,
      "text": "你们这些年轻人该做的"
    },
    {
      "ordinal": 345,
      "start_ms": 784430,
      "end_ms": 785210,
      "text": "该去研究的"
    },
    {
      "ordinal": 346,
      "start_ms": 785210,
      "end_ms": 786110,
      "text": "该去思考的"
    },
    {
      "ordinal": 347,
      "start_ms": 786110,
      "end_ms": 787250,
      "text": "该去探索的"
    },
    {
      "ordinal": 348,
      "start_ms": 787250,
      "end_ms": 789140,
      "text": "该去成为一个社会共识的"
    },
    {
      "ordinal": 349,
      "start_ms": 789140,
      "end_ms": 790130,
      "text": "该去反思的"
    },
    {
      "ordinal": 350,
      "start_ms": 790130,
      "end_ms": 791845,
      "text": "统统都没有"
    },
    {
      "ordinal": 351,
      "start_ms": 794040,
      "end_ms": 795490,
      "text": "对不对"
    },
    {
      "ordinal": 352,
      "start_ms": 795710,
      "end_ms": 796990,
      "text": "所以我看不起你们"
    },
    {
      "ordinal": 353,
      "start_ms": 796990,
      "end_ms": 798070,
      "text": "我真看不起你们"
    },
    {
      "ordinal": 354,
      "start_ms": 798070,
      "end_ms": 799090,
      "text": "我真的看不起你"
    },
    {
      "ordinal": 355,
      "start_ms": 799090,
      "end_ms": 799690,
      "text": "没什么好说的"
    },
    {
      "ordinal": 356,
      "start_ms": 799690,
      "end_ms": 800500,
      "text": "对不对"
    },
    {
      "ordinal": 357,
      "start_ms": 800500,
      "end_ms": 801850,
      "text": "好不好啊"
    },
    {
      "ordinal": 358,
      "start_ms": 801850,
      "end_ms": 802750,
      "text": "那就讲到这边啊"
    },
    {
      "ordinal": 359,
      "start_ms": 802750,
      "end_ms": 803890,
      "text": "今天晚上就讲到这里"
    },
    {
      "ordinal": 360,
      "start_ms": 803890,
      "end_ms": 804120,
      "text": "不"
    }
