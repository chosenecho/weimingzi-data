{"segments":[{"start":2.24,"end":4.61,"text":"啊回应信件可公开啊"},{"start":4.61,"end":6.8,"text":"他说呃你好"},{"start":6.8,"end":10.009,"text":"请许我花仙花一些篇幅介绍自己"},{"start":10.009,"end":11.569,"text":"我是一名即将毕业大学生"},{"start":13.189,"end":15.74,"text":"结果取决于明年3月份的军检啊"},{"start":15.74,"end":16.7,"text":"我父母都是工人"},{"start":16.7,"end":18.98,"text":"而且他们在工作中都很上进"},{"start":18.98,"end":20.3,"text":"所以我家条件不差"},{"start":20.3,"end":22.07,"text":"工得了我读书"},{"start":22.07,"end":23.99,"text":"但我读书可能和周围人有些差别"},{"start":25.31,"end":26.619,"text":"我考上双非一本"},{"start":26.619,"end":29.289,"text":"那纯是父母紧逼和砸钱进辅导班的手段"},{"start":29.289,"end":30.82,"text":"拉扯进了这样的"},{"start":30.82,"end":32.02,"text":"我身上埋了个炸弹"},{"start":32.02,"end":34.27,"text":"却被我和家人忽视啊"},{"start":34.27,"end":35.35,"text":"到了大学他爆炸了"},{"start":35.35,"end":36.07,"text":"在大学课堂上"},{"start":36.07,"end":38.11,"text":"我几乎没法听一节课"},{"start":38.11,"end":39.19,"text":"在教室里我只有发"},{"start":39.19,"end":40.63,"text":"呆玩睡觉玩手机"},{"start":40.63,"end":43.06,"text":"偶尔想听也就听五分钟就走神了"},{"start":43.06,"end":46.8,"text":"这样的我面临考试时只能临时临考啊"},{"start":46.8,"end":48.0,"text":"只能靠抱佛脚"},{"start":48.0,"end":51.0,"text":"他就靠写成考考抱佛脚恶补"},{"start":51.0,"end":53.72,"text":"但以往我是在辅导班老师指导一下"},{"start":53.72,"end":54.14,"text":"整理知识"},{"start":54.14,"end":54.5,"text":"没老师"},{"start":55.88,"end":56.54,"text":"一盘散沙"},{"start":56.54,"end":57.44,"text":"挂科成了必然"},{"start":57.44,"end":59.58,"text":"连续亮红灯刀到大二"},{"start":59.8,"end":60.58,"text":"我崩溃了"},{"start":60.58,"end":61.54,"text":"我想不出办法了"},{"start":62.92,"end":64.18,"text":"每天我坐在教室"},{"start":64.18,"end":64.959,"text":"图书馆只有哭"},{"start":64.959,"end":66.1,"text":"我不知道该怎么做"},{"start":66.1,"end":67.48,"text":"我被焦虑和悲伤打败了"},{"start":67.48,"end":68.19,"text":"我生病了"},{"start":68.19,"end":71.01,"text":"母亲拿着确诊单走出脑科医院"},{"start":71.01,"end":71.61,"text":"满脸通红"},{"start":71.61,"end":72.41,"text":"眼里还有泪"},{"start":72.41,"end":73.55,"text":"我不是这个东西"},{"start":73.55,"end":74.03,"text":"怎么查"},{"start":74.03,"end":74.99,"text":"都他妈是抑郁症"},{"st