    {
      "ordinal": 151,
      "start_ms": 419570,
      "end_ms": 420590,
      "text": "物理学法则啊"
    },
    {
      "ordinal": 152,
      "start_ms": 420590,
      "end_ms": 421670,
      "text": "经济学定律啊"
    },
    {
      "ordinal": 153,
      "start_ms": 421670,
      "end_ms": 423320,
      "text": "政治学的一些关联啊"
    },
    {
      "ordinal": 154,
      "start_ms": 423320,
      "end_ms": 423770,
      "text": "了解吗"
    },
    {
      "ordinal": 155,
      "start_ms": 423770,
      "end_ms": 425360,
      "text": "是这些法则起作用"
    },
    {
      "ordinal": 156,
      "start_ms": 427199,
      "end_ms": 429379,
      "text": "或者是尚未被认识的一些法则"
    },
    {
      "ordinal": 157,
      "start_ms": 429379,
      "end_ms": 430399,
      "text": "你甚至给尚未被的"
