    {
      "ordinal": 147,
      "start_ms": 410130,
      "end_ms": 412870,
      "text": "它是看得见有意义啊"
    },
    {
      "ordinal": 148,
      "start_ms": 412870,
      "end_ms": 414190,
      "text": "看得见无意是表象"
    },
    {
      "ordinal": 149,
      "start_ms": 414190,
      "end_ms": 417050,
      "text": "看不见无意义是本体看不见"
    },
    {
      "ordinal": 150,
      "start_ms": 417050,
      "end_ms": 419570,
      "text": "但是有意义是这个法则归根结底是这个法则"
