    {
      "ordinal": 227,
      "start_ms": 624980,
      "end_ms": 627580,
      "text": "有良心的人知道我在这里说的是什么"
    },
    {
      "ordinal": 228,
      "start_ms": 627580,
      "end_ms": 629599,
      "text": "没有良心的人继续做你的梦"
    },
    {
      "ordinal": 229,
      "start_ms": 629820,
      "end_ms": 632190,
      "text": "因为要成为一个真正的唯物主义者"
