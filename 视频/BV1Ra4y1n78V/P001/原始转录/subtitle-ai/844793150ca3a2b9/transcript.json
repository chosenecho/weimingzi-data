      "text": "表象和法则"
    },
    {
      "ordinal": 166,
      "start_ms": 450209,
      "end_ms": 452579,
      "text": "它表象没有背后的东西"
    },
    {
      "ordinal": 167,
      "start_ms": 452579,
      "end_ms": 453719,
      "text": "没有背后的东西"
    },
    {
      "ordinal": 168,
      "start_ms": 453719,
      "end_ms": 455100,
      "text": "没有背后的东西"
    },
    {
      "ordinal": 169,
      "start_ms": 455100,
