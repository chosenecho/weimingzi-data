{
  "bvid": "BV1cf4y1q7ay",
  "page": 1,
  "source": "subtitle-cc",
  "language": "zh-CN",
  "model": null,
  "content_sha256": "85cd5b99d2fba3e3e3474065fd8475bdb6fd4948aed9cb54aa7767401e16b5c9",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 1300,
      "end_ms": 2880,
      "text": "好，那……我们还要讲"
    },
    {
      "ordinal": 1,
      "start_ms": 2880,
      "end_ms": 4840,
      "text": "另外一个非常经典的对立"
    },
    {
      "ordinal": 2,
      "start_ms": 4920,
      "end_ms": 7120,
      "text": "叫做现实主义和理想主义的对立"
    },
    {
      "ordinal": 3,
      "start_ms": 7600,
      "end_ms": 8720,
      "text": "那么用哲学的话说"
    },
    {
      "ordinal": 4,
      "start_ms": 8720,
      "end_ms": 9640,
      "text": "叫做"
    },
    {
      "ordinal": 5,
      "start_ms": 10240,
      "end_ms": 12160,
      "text": "“实然”和“应然”间的对立"
    },
    {
      "ordinal": 6,
      "start_ms": 12160,
      "end_ms": 15360,
      "text": "就是“being”和“ought”之间的对立"
    },
    {
      "ordinal": 7,
      "start_ms": 17160,
      "end_ms": 19520,
      "text": "然后正题，简单介绍【现实主义】"
    },
    {
      "ordinal": 8,
      "start_ms": 19520,
      "end_ms": 21480,
      "text": "就是说从现实利益出发"
    },
    {
      "ordinal": 9,
      "start_ms": 21480,
      "end_ms": 23440,
      "text": "从什么，比如说"
    },
    {
      "ordinal": 10,
      "start_ms": 23480,
      "end_ms": 26280,
      "text": "如果你是一个国家的领袖"
    },
    {
      "ordinal": 11,
      "start_ms": 26480,
      "end_ms": 31200,
      "text": "就是从国家的生死存亡出发"
    },
    {
      "ordinal": 12,
      "start_ms": 31480,
      "end_ms": 33840,
      "text": "那么如果你是个理想主义者的话"
    },
    {
      "ordinal": 13,
      "start_ms": 34000,
      "end_ms": 34880,
      "text": "你就是从一个"
    },
    {
      "ordinal": 14,
      "start_ms": 34880,
      "end_ms": 36000,
      "text": "比如说我要"
    },
    {
      "ordinal": 15,
      "start_ms": 36240,
      "end_ms": 38480,
      "text": "建构一个非常好的社会秩序"
    },
    {
      "ordinal": 16,
      "start_ms": 39400,
      "end_ms": 40720,
      "text": "要创造一个乌托邦"
    },
    {
      "ordinal": 17,
      "start_ms": 41240,
      "end_ms": 42360,
      "text": "你是个普通人的话"
    },
    {
      "ordinal": 18,
      "start_ms": 42360,
      "end_ms": 43040,
      "text": "理想主义者的话"
    },
    {
      "ordinal": 19,
      "start_ms": 43280,
      "end_ms": 46800,
      "text": "我是生命当中，是几个便士？"
    },
    {
      "ordinal": 20,
      "start_ms": 46800,
      "end_ms": 49360,
      "text": "和什么《月亮和六便士》"
    },
    {
      "ordinal": 21,
      "start_ms": 49640,
      "end_ms": 51000,
      "text": "我就去追求“月亮”"
    },
    {
      "ordinal": 22,
      "start_ms": 51000,
      "end_ms": 52920,
      "text": "追求那种虚无缥缈的"
    },
    {
      "ordinal": 23,
      "start_ms": 52960,
      "end_ms": 54960,
      "text": "比较诗情画意的这种生活"
    },
    {
      "ordinal": 24,
      "start_ms": 55560,
      "end_ms": 57520,
      "text": "（这是）一般人的理解"
    },
    {
      "ordinal": 25,
      "start_ms": 57560,
      "end_ms": 59360,
      "text": "现实主义和理想主义"
    },
    {
      "ordinal": 26,
      "start_ms": 59360,
      "end_ms": 60120,
      "text": "就是这种差别"
    },
    {
      "ordinal": 27,
      "start_ms": 62120,
      "end_ms": 64840,
      "text": "然后它的一个庸俗的合题"
    },
    {
      "ordinal": 28,
      "start_ms": 64840,
      "end_ms": 66880,
      "text": "就是调和主义"
    },
    {
      "ordinal": 29,
      "start_ms": 70200,
      "end_ms": 73080,
      "text": "我不知道是中国清朝"
    },
    {
      "ordinal": 30,
      "start_ms": 73080,
      "end_ms": 74400,
      "text": "有哪一个革新人物（谭嗣同）"
    },
    {
      "ordinal": 31,
      "start_ms": 74400,
      "end_ms": 75600,
      "text": "他说的就是"
    },
    {
      "ordinal": 32,
      "start_ms": 75920,
      "end_ms": 77480,
      "text": "“中国几千年的思想”"
    },
    {
      "ordinal": 33,
      "start_ms": 77480,
      "end_ms": 78240,
      "text": "“就两个字”"
    },
    {
      "ordinal": 34,
      "start_ms": 78240,
      "end_ms": 79000,
      "text": "“乡愿”"
    },
    {
      "ordinal": 35,
      "start_ms": 79000,
      "end_ms": 83000,
      "text": "也就是那种老好人，调和主义"
    },
    {
      "ordinal": 36,
      "start_ms": 83520,
      "end_ms": 85320,
      "text": "它一方面就是说"
    },
    {
      "ordinal": 37,
      "start_ms": 85440,
      "end_ms": 87200,
      "text": "具有现实主义的面向"
    },
    {
      "ordinal": 38,
      "start_ms": 87320,
      "end_ms": 87960,
      "text": "什么面向？"
    },
    {
      "ordinal": 39,
      "start_ms": 88160,
      "end_ms": 91440,
      "text": "就是说它会把道德本身"
    },
    {
      "ordinal": 40,
      "start_ms": 91440,
      "end_ms": 93520,
      "text": "把理想本身"
    },
    {
      "ordinal": 41,
      "start_ms": 93520,
      "end_ms": 94200,
      "text": "当成是一种"
    },
    {
      "ordinal": 42,
      "start_ms": 94240,
      "end_ms": 95360,
      "text": "谋取现实利益的"
    },
    {
      "ordinal": 43,
      "start_ms": 95400,
      "end_ms": 96320,
      "text": "一种手段"
    },
    {
      "ordinal": 44,
      "start_ms": 97120,
      "end_ms": 98360,
      "text": "一个工具"
    },
    {
      "ordinal": 45,
      "start_ms": 99040,
      "end_ms": 99720,
      "text": "另一方面"
    },
    {
      "ordinal": 46,
      "start_ms": 101200,
      "end_ms": 102840,
      "text": "他又有理想主义的面向"
    },
    {
      "ordinal": 47,
      "start_ms": 102920,
      "end_ms": 105080,
      "text": "但是它不是一种高尚的理想主义"
    },
    {
      "ordinal": 48,
      "start_ms": 105080,
      "end_ms": 107120,
      "text": "它是一种比较低劣的理想主义"
    },
    {
      "ordinal": 49,
      "start_ms": 107120,
      "end_ms": 108760,
      "text": "就是说，它会把享乐本身"
    },
    {
      "ordinal": 50,
      "start_ms": 108800,
      "end_ms": 109760,
      "text": "获取利益本身"
    },
    {
      "ordinal": 51,
      "start_ms": 109760,
      "end_ms": 111160,
      "text": "当成是一种理想"
    },
    {
      "ordinal": 52,
      "start_ms": 111520,
      "end_ms": 112560,
      "text": "这两个调和在一块"
    },
    {
      "ordinal": 53,
      "start_ms": 112560,
      "end_ms": 113680,
      "text": "就是所谓的"
    },
    {
      "ordinal": 54,
      "start_ms": 114280,
      "end_ms": 115600,
      "text": "我们日常所说的"
    },
    {
      "ordinal": 55,
      "start_ms": 115600,
      "end_ms": 116400,
      "text": "“中庸”"
    },
    {
      "ordinal": 56,
      "start_ms": 116640,
      "end_ms": 119000,
      "text": "“中庸”就是乡愿"
    },
    {
      "ordinal": 57,
      "start_ms": 119200,
      "end_ms": 122840,
      "text": "那么真正的合题"
    },
    {
      "ordinal": 58,
      "start_ms": 123000,
      "end_ms": 125080,
      "text": "它应该是现实【主义】"
    },
    {
      "ordinal": 59,
      "start_ms": 125080,
      "end_ms": 127600,
      "text": "我们要把重音放在主义这两个字上"
    },
    {
      "ordinal": 60,
      "start_ms": 127600,
      "end_ms": 129039,
      "text": "什么意思？就是说"
    },
    {
      "ordinal": 61,
      "start_ms": 129039,
      "end_ms": 130560,
      "text": "所谓的现实主义"
    },
    {
      "ordinal": 62,
      "start_ms": 130560,
      "end_ms": 132880,
      "text": "你就是要追求利益"
    },
    {
      "ordinal": 63,
      "start_ms": 133800,
      "end_ms": 134920,
      "text": "要注重现实"
    },
    {
      "ordinal": 64,
      "start_ms": 134920,
      "end_ms": 136520,
      "text": "但是问题是，什么是“现实”？"
    },
    {
      "ordinal": 65,
      "start_ms": 136520,
      "end_ms": 137720,
      "text": "什么是“利益”？"
    },
    {
      "ordinal": 66,
      "start_ms": 138800,
      "end_ms": 139480,
      "text": "什么是“现实”？"
    },
    {
      "ordinal": 67,
      "start_ms": 139480,
      "end_ms": 140200,
      "text": "什么是“利益”？"
    },
    {
      "ordinal": 68,
      "start_ms": 140200,
      "end_ms": 141560,
      "text": "它是需要一种“主义”"
    },
    {
      "ordinal": 69,
      "start_ms": 141560,
      "end_ms": 142880,
      "text": "一种理论去定义的"
    },
    {
      "ordinal": 70,
      "start_ms": 142880,
      "end_ms": 145200,
      "text": "甚至需要一种【理想化】的理论"
    },
    {
      "ordinal": 71,
      "start_ms": 145240,
      "end_ms": 147840,
      "text": "它是需要一种【观念】去"
    },
    {
      "ordinal": 72,
      "start_ms": 148000,
      "end_ms": 149840,
      "text": "认定“什么是现实”的"
    },
    {
      "ordinal": 73,
      "start_ms": 149960,
      "end_ms": 151720,
      "text": "海德格尔讨论过"
    },
    {
      "ordinal": 74,
      "start_ms": 152240,
      "end_ms": 153560,
      "text": "马克思的名言"
    },
    {
      "ordinal": 75,
      "start_ms": 153560,
      "end_ms": 154480,
      "text": "墓志铭"
    },
    {
      "ordinal": 76,
      "start_ms": 154520,
      "end_ms": 155560,
      "text": "“哲学家的任务”"
    },
    {
      "ordinal": 77,
      "start_ms": 155560,
      "end_ms": 158360,
      "text": "“不在于批判世界”"
    },
    {
      "ordinal": 78,
      "start_ms": 158360,
      "end_ms": 160960,
      "text": "“而在于改造世界”"
    },
    {
      "ordinal": 79,
      "start_ms": 160960,
      "end_ms": 162240,
      "text": "那么问题是"
    },
    {
      "ordinal": 80,
      "start_ms": 162480,
      "end_ms": 163280,
      "text": "海德格尔就说了"
    },
    {
      "ordinal": 81,
      "start_ms": 163320,
      "end_ms": 165280,
      "text": "这句话的问题就在于说"
    },
    {
      "ordinal": 82,
      "start_ms": 165680,
      "end_ms": 168320,
      "text": "当你要说改造世界的时候"
    },
    {
      "ordinal": 83,
      "start_ms": 168320,
      "end_ms": 169960,
      "text": "你已经在批判它"
    },
    {
      "ordinal": 84,
      "start_ms": 169960,
      "end_ms": 172360,
      "text": "你已经在观念上在说"
    },
    {
      "ordinal": 85,
      "start_ms": 172720,
      "end_ms": 174360,
      "text": "当前何为“世界”"
    },
    {
      "ordinal": 86,
      "start_ms": 174360,
      "end_ms": 175680,
      "text": "这个世界观是有问题的"
    },
    {
      "ordinal": 87,
      "start_ms": 175680,
      "end_ms": 176720,
      "text": "什么是“现实”"
    },
    {
      "ordinal": 88,
      "start_ms": 176720,
      "end_ms": 177800,
      "text": "这个现实观是有问题的"
    },
    {
      "ordinal": 89,
      "start_ms": 177840,
      "end_ms": 179320,
      "text": "我要批判这个观念"
    },
    {
      "ordinal": 90,
      "start_ms": 179560,
      "end_ms": 180600,
      "text": "我才能知道"
    },
    {
      "ordinal": 91,
      "start_ms": 180600,
      "end_ms": 181840,
      "text": "我要改造的世界"
    },
    {
      "ordinal": 92,
      "start_ms": 181880,
      "end_ms": 183280,
      "text": "是什么样的世界"
    },
    {
      "ordinal": 93,
      "start_ms": 183320,
      "end_ms": 184000,
      "text": "我才能知道"
    },
    {
      "ordinal": 94,
      "start_ms": 184000,
      "end_ms": 185680,
      "text": "我要改造的对象是什么"
    },
    {
      "ordinal": 95,
      "start_ms": 185680,
      "end_ms": 187000,
      "text": "我不要认错"
    },
    {
      "ordinal": 96,
      "start_ms": 187040,
      "end_ms": 188360,
      "text": "所以现实主义本身"
    },
    {
      "ordinal": 97,
      "start_ms": 188360,
      "end_ms": 189400,
      "text": "它就包含"
    },
    {
      "ordinal": 98,
      "start_ms": 189440,
      "end_ms": 190760,
      "text": "理想主义的维度"
    },
    {
      "ordinal": 99,
      "start_ms": 190960,
      "end_ms": 193120,
      "text": "所以真正的问题就在于"
    },
    {
      "ordinal": 100,
      "start_ms": 193360,
      "end_ms": 196480,
      "text": "理想主义、理想化的这种思维"
    },
    {
      "ordinal": 101,
      "start_ms": 196520,
      "end_ms": 198640,
      "text": "对于现实本身的不满和批判"
    },
    {
      "ordinal": 102,
      "start_ms": 198640,
      "end_ms": 200520,
      "text": "它为什么不可避免地"
    },
    {
      "ordinal": 103,
      "start_ms": 200520,
      "end_ms": 202520,
      "text": "要从现实当中萌生出来？"
    },
    {
      "ordinal": 104,
      "start_ms": 202760,
      "end_ms": 204400,
      "text": "那么一个真正的现实主义者"
    },
    {
      "ordinal": 105,
      "start_ms": 204400,
      "end_ms": 206760,
      "text": "他就必然要去思考这个问题"
    },
    {
      "ordinal": 106,
      "start_ms": 206760,
      "end_ms": 207840,
      "text": "而不仅仅就是说"
    },
    {
      "ordinal": 107,
      "start_ms": 207840,
      "end_ms": 209320,
      "text": "我把所有一切"
    },
    {
      "ordinal": 108,
      "start_ms": 209600,
      "end_ms": 210240,
      "text": "批判性的"
    },
    {
      "ordinal": 109,
      "start_ms": 210240,
      "end_ms": 211040,
      "text": "反思性的"
    },
    {
      "ordinal": 110,
      "start_ms": 211040,
      "end_ms": 211640,
      "text": "否定性的"
    },
    {
      "ordinal": 111,
      "start_ms": 211640,
      "end_ms": 212760,
      "text": "观念性的"
    },
    {
      "ordinal": 112,
      "start_ms": 212760,
      "end_ms": 213800,
      "text": "理想性的内容"
    },
    {
      "ordinal": 113,
      "start_ms": 213840,
      "end_ms": 214720,
      "text": "全给它删掉"
    },
    {
      "ordinal": 114,
      "start_ms": 214720,
      "end_ms": 218120,
      "text": "然后就去追求所谓的“现实”的“意义”"
    },
    {
      "ordinal": 115,
      "start_ms": 218400,
      "end_ms": 219480,
      "text": "那实际上是一种"
    },
    {
      "ordinal": 116,
      "start_ms": 219720,
      "end_ms": 221280,
      "text": "“反理想主义”"
    },
    {
      "ordinal": 117,
      "start_ms": 221280,
      "end_ms": 222520,
      "text": "而不是现实主义"
    }
  ],
