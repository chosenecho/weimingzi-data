{"segments":[{"start":0.14,"end":2.84,"text":"呃我还是继续回信件啊"},{"start":2.84,"end":8.0,"text":"他是成都的一位叫邢锐呀"},{"start":11.2,"end":12.72,"text":"啊这个是神殿瑞啊"},{"start":12.72,"end":15.15,"text":"没文化啊"},{"start":15.15,"end":18.24,"text":"确实吴瑞啊"},{"start":19.68,"end":22.619,"text":"那么他说魏明子你好"},{"start":22.619,"end":25.679,"text":"我是一名被分流的普通中职生"},{"start":25.679,"end":28.439,"text":"曾1度沉浸在某种享乐中无法自拔"},{"start":28.439,"end":30.46,"text":"对前途试图"},{"start":30.46,"end":32.339,"text":"他竟然写了个视图啊"},{"start":33.1,"end":35.46,"text":"单人旁的不抱有期望"},{"start":35.46,"end":37.2,"text":"深谙知足常乐之道"},{"start":37.2,"end":40.62,"text":"幻想着日后能过上闲云野鹤般的生活"},{"start":40.62,"end":41.64,"text":"一个普通人的"},{"start":41.64,"end":46.83,"text":"且不参与或者是少参与那种世俗的争名夺利"},{"start":46.83,"end":48.93,"text":"然后我随便上了一个技校"},{"start":48.93,"end":49.86,"text":"在技校的生活"},{"start":49.86,"end":52.099,"text":"我拥有了相当多的空闲时间"},{"start":53.7,"end":56.82,"text":"加上比以往多了一点点社会认识"},{"start":57.22,"end":59.23,"text":"我的思想发生转变"},{"start":59.23,"end":63.31,"text":"我开始不再像以前那样靠享乐来麻痹自己"},{"start":63.31,"end":64.789,"text":"也可能是玩腻了啊"},{"start":64.789,"end":69.349,"text":"更多的时间用来做自己认为有意义的事"},{"start":69.349,"end":71.269,"text":"上课也不是萎靡不振了"},{"start":71.269,"end":72.58,"text":"参加了校团委"},{"start":72.58,"end":73.96,"text":"经常上台演讲"},{"start":73.96,"end":76.84,"text":"以全校第一的成绩拿到了团员资格"},{"start":77.76,"end":79.67,"text":"还有获得了一些荣誉"},{"start":79.67,"end":82.04,"text":"但我知道这些都不能算做什么"},{"start":82.04,"end":83.36,"text":"因为绩效水平很有限"},{"start":83.36,"end":87.2,"text":"我也只是在跟一帮正在走路的人比跑步"},{"start":87.2,"end":89.18,"text":"我还很清楚自身的弱"},{"start":89.18,"end":89.7,"text":"小"},{"start":89.74,"end":91.78,"text":"学到第2年的时候"},{"start":91.78,"end":93.67,"text":"因为家里的矛盾激烈到了极点"},{"start":93.67,"end":96.52,"text":"且我很讨厌学校的宿舍制度"},{"start":96.52,"end":100.84,"text":"还有我自身身体和心理上早已有之的问题"},{"start":101.22,"end":104.61,"text":"在两次什么什么什么之后呢"},{"start":104.61,"end":106.6,"text":"家里给我办了休学"},{"start":106.8,"end":108.18,"text":"在休学这段时间"},{"start":108.18,"end":109.56,"text":"我还是沉浸于享乐"},{"start":109.56,"end":111.54,"text":"和之前一样啊"},{"start":111.54,"end":112.98,"text":"再后来我转学了"},{"start":112.98,"end":117.71,"text":"妈妈把我从啊某省带到了这个四川"},{"start":117.71,"end":120.98,"text":"我也和从小把我带大"},{"start":120.98,"end":125.679,"text":"带到大的奶奶做了长久的告别哦"},{"start":128.539,"end":131.98,"text":"呃我不确定是不是你奶奶去世啊"},{"start":131.98,"end":133.39,"text":"如果是去世的话呢"},{"start":133.39,"end":134.56,"text":"如果不是去世的话"},{"start":134.56,"end":136.12,"text":"那祝他健康长寿啊"},{"start":136.12,"end":137.14,"text":"如果是去世的话"},{"start":137.14,"end":141.87,"text":"那就表达一个哀悼啊"},{"start":141.87,"end":143.25,"text":"希望他不是趋势"},{"start":143.25,"end":145.02,"text":"那么到了四川后"},{"start":145.02,"end":146.94,"text":"家里给我找了个公办职校"},{"start":146.94,"end":148.02,"text":"在这所学校中"},{"start":148.02,"end":152.3,"text":"我也要重新开始为期3年的学习生涯"},{"start":152.3,"end":153.56,"text":"办的是走读"},{"start":153.56,"end":155.18,"text":"家里不算富裕"},{"start":155.18,"end":155.84,"text":"妈妈很苦"},{"start":155.84,"end":158.54,"text":"我就自然地玩腻游戏了"},{"start":158.54,"end":161.3,"text":"在这期间我看到了未老哥"},{"start":161.3,"end":163.34,"text":"2021年3月30日的"},{"start":163.34,"end":164.72,"text":"尤其应该努力学习"},{"start":164.72,"end":167.0,"text":"积极应试里面有有目的的学习"},{"start":167.0,"end":167.72,"text":"拿到筹码"},{"start":167.72,"end":168.829,"text":"让我有所感触"},{"start":168.829,"end":170.509,"text":"3年时间说长不长"},{"start":170.509,"end":171.109,"text":"说短不短"},{"start":171.109,"end":173.029,"text":"期间我肯定会遇到各种挫折"},{"start":173.029,"end":174.289,"text":"但我会尽力克服的"},{"start":174.289,"end":176.449,"text":"我想同您未来站在一个战线上"},{"start":176.449,"end":179.63,"text":"为劳动者的解放斗争啊"},{"start":179.63,"end":181.66,"text":"最后就是五一假期期间"},{"start":181.66,"end":184.0,"text":"因为对家里的事情怎么说呢"},{"start":184.0,"end":185.56,"text":"就是有感而发"},{"start":185.56,"end":187.96,"text":"用自己可怜的文才做的首饰"},{"start":187.96,"end":189.64,"text":"魏老哥不要见笑"},{"start":190.88,"end":195.999,"text":"他说七绝家亲父母今何在"},{"start":195.999,"end":199.039,"text":"漫步清醉呃"},{"start":199.039,"end":200.359,"text":"满目山"},{"start":203.419,"end":205.8,"text":"啊心更无力"},{"start":205.8,"end":207.36,"text":"摧花之折纸"},{"start":207.36,"end":208.8,"text":"一事无力来"},{"start":212.1,"end":215.3,"text":"然后我让妈妈取个名字为这首诗"},{"start":215.3,"end":217.58,"text":"他说忆苦思甜"},{"start":217.58,"end":219.14,"text":"我想他是想告诉我"},{"start":219.14,"end":220.64,"text":"纵使回忆是苦涩的"},{"start":220.64,"end":222.08,"text":"但只要心中有希望"},{"start":222.08,"end":222.82,"text":"好好干"},{"start":222.82,"end":225.34,"text":"日子会越来越甜的啊"},{"start":225.34,"end":226.69,"text":"允许公开啊"},{"start":226.69,"end":228.7,"text":"那么我要说的就是"},{"start":234.16,"end":239.64,"text":"他是回了这个四川去职校里面学习了啊"},{"start":240.279,"end":244.619,"text":"我觉得还是要在职业技术学校里面啊"},{"start":244.619,"end":251.42,"text":"啊职业学校里面要努力掌握这个劳动技能"},{"start":251.42,"end":252.59,"text":"劳动技能"},{"start":252.59,"end":255.14,"text":"然后呢现在跟你说积极应试"},{"start":255.14,"end":258.939,"text":"这个应试呢呃应当就是说不简"},{"start":258.939,"end":263.889,"text":"简单单是啊要职校升大专再升本科这种意义"},{"start":263.889,"end":267.18,"text":"而是要啊一些技术性的考试啊"},{"start":267.18,"end":269.4,"text":"技术性的标准性的那种啊"},{"start":269.4,"end":272.4,"text":"作为劳动资格的门槛的一些考试"},{"start":272.4,"end":274.17,"text":"你要努力去准备"},{"start":274.17,"end":275.52,"text":"积极去应试"},{"start":275.539,"end":279.679,"text":"你拿到筹码呢不一定是学历啊"},{"start":279.679,"end":282.229,"text":"不一定是某种这个呃"},{"start":282.229,"end":285.68,"text":"就是说鄙视链上面的东西啊"},{"start":285.68,"end":289.04,"text":"拿到了就可以去鄙视别人或者不被别人鄙视"},{"start":289.04,"end":289.88,"text":"不是这种东西"},{"start":289.88,"end":296.5,"text":"你拿到的筹码呢应当是一个劳动技技能以及劳"},{"start":296.5,"end":299.02,"text":"动参与某种特定劳动的"},{"start":299.02,"end":301.24,"text":"比如说他的资格啊"},{"start":301.24,"end":303.64,"text":"他可能是主要是社会安全的考虑啊"},{"start":303.64,"end":306.74,"text":"或者说比如电工啊"},{"start":306.74,"end":308.66,"text":"比如说什么消防啊"},{"start":308.66,"end":313.349,"text":"这这样的这样的筹码啊"},{"start":313.349,"end":315.359,"text":"有目的的学习啊"},{"start":315.359,"end":316.439,"text":"你学好了之后"},{"start":316.439,"end":322.58,"text":"你就有一个相对还比较有发展空间的啊"},{"start":322.58,"end":326.51,"text":"能够覆盖你本人的生存和你家人的一定的生存"},{"start":326.51,"end":329.33,"text":"还有一定发展性的一些工作"},{"start":329.33,"end":330.44,"text":"呃"},{"start":330.44,"end":332.84,"text":"呃我都想用您了"},{"start":332.84,"end":333.26,"text":"对不对啊"},{"start":333.26,"end":333.98,"text":"你呀"},{"start":333.98,"end":335.81,"text":"所以说你大概率"},{"start":335.81,"end":340.28,"text":"将来是会成为体力无产者的一员"},{"start":340.539,"end":341.58,"text":"那么"},{"start":344.96,"end":347.02,"text":"家庭的事情"},{"start":347.02,"end":350.74,"text":"上一代人有他们上一代的局限性"},{"start":350.74,"end":355.06,"text":"有他们对于这个社会的一些迷惘啊"},{"start":355.06,"end":356.98,"text":"以及对于家庭关系"},{"start":356.98,"end":360.22,"text":"对于情感关系的一些呃片面啊"},{"start":360.22,"end":365.25,"text":"或者说也没有人曾经非常系统性的教过他们"},{"start":365.25,"end":365.97,"text":"怎么去应对"},{"start":365.97,"end":366.48,"text":"对不对"},{"start":366.48,"end":373.0,"text":"因为我们国家啊啊在前前面这几十年"},{"start":373.0,"end":376.78,"text":"他发生了翻天覆地的变化啊"},{"start":376.8,"end":381.78,"text":"然后在乡村或者说在小的城镇当中生存的"},{"start":381.78,"end":383.22,"text":"世世代代的人"},{"start":383.22,"end":388.35,"text":"他的一些传统的家族关系被现代化的过程啊"},{"start":388.35,"end":390.87,"text":"被这个工业文明的发展啊"},{"start":390.87,"end":393.42,"text":"被甚至说信息技术"},{"start":393.42,"end":397.459,"text":"互联网的发展已经是完全彻底的改变了啊"},{"start":397.459,"end":402.0,"text":"所以家庭内部的一些年纪大的成员"},{"start":402.0,"end":404.34,"text":"甚至叫你爸爸妈妈啊"},{"start":404.34,"end":410.52,"text":"他们很多是在这样的变化当中是迷茫的啊"},{"start":410.659,"end":414.04,"text":"是会犯错的"},{"start":414.819,"end":419.74,"text":"这样的错误可能对于啊你这样比较幼幼小的"},{"start":419.74,"end":421.9,"text":"这是他们自己都是迷茫的"},{"start":421.9,"end":423.1,"text":"虽然他们犯错了"},{"start":423.1,"end":426.309,"text":"所以很多一些情绪的失控啊"},{"start":426.309,"end":433.599,"text":"或者说一些呃啊家庭关系的一些呃重组破裂"},{"start":433.599,"end":435.96,"text":"或者说一些whatever"},{"start":436.34,"end":438.44,"text":"这些你心里面没说离婚"},{"start":438.44,"end":440.06,"text":"那我我我爸妈都离婚了"},{"start":440.06,"end":440.96,"text":"对不对啊"},{"start":440.96,"end":444.11,"text":"这样类似他都会给幼小的个体带来某些伤害"},{"start":444.11,"end":448.18,"text":"但是父母并不是刻意要去要去伤害自己小孩"},{"start":448.18,"end":448.93,"text":"你明白吗"},{"start":448.93,"end":451.66,"text":"他并不是说以这个以此为目的的"},{"start":451.7,"end":454.16,"text":"哪怕有一些父母啊"},{"start":454.16,"end":458.52,"text":"他呃会以发泄到孩子身上的方式"},{"start":458.52,"end":461.34,"text":"来减轻他的这个自己的痛苦"},{"start":461.34,"end":463.95,"text":"或者说来来来来伤害别人"},{"start":463.95,"end":466.43,"text":"来伤害其他成年人啊"},{"start":466.43,"end":467.66,"text":"这个都只是"},{"start":469.94,"end":472.9,"text":"有些恶性嘛能让孩子受伤害"},{"start":472.9,"end":476.11,"text":"父母肯定是有他的问题的"},{"start":476.11,"end":481.07,"text":"但是上一个世代的这些成年人"},{"start":481.07,"end":483.35,"text":"在面对很多事情上面"},{"start":483.35,"end":485.23,"text":"他没有接受良好教育"},{"start":485.23,"end":490.03,"text":"或者说他自己没有办法从社会的公开的讨"},{"start":490.03,"end":497.269,"text":"论和文化当中获得一些经验"},{"start":497.269,"end":498.889,"text":"获得一些指导的话"},{"start":498.889,"end":500.38,"text":"他们的思考"},{"start":500.539,"end":504.98,"text":"他们的情绪反应本身都是有局限性的"},{"start":506.579,"end":509.72,"text":"这个我要说的就是说呃"},{"start":513.159,"end":517.549,"text":"啊而且尤其是亲人之间"},{"start":517.549,"end":522.0,"text":"他可能就是说会把这个血缘关系"},{"start":522.0,"end":524.22,"text":"就汤臣是天经地义的"},{"start":524.22,"end":526.18,"text":"然后因为天经地义是自己人"},{"start":526.34,"end":529.46,"text":"那么有的时候在算计一些利益的时候"},{"start":529.46,"end":533.43,"text":"反而会这个面目更狰狞一些对吧"},{"start":533.43,"end":537.24,"text":"反而会这个更不客客气气一些"},{"start":537.24,"end":538.29,"text":"客气客气"},{"start":538.29,"end":539.73,"text":"家里人不用客气"},{"start":539.73,"end":543.0,"text":"反而会有的时候会造成伤害啊"},{"start":543.0,"end":546.19,"text":"比陌生人的争执"},{"start":546.19,"end":547.0,"text":"家人的争执"},{"start":547.0,"end":550.3,"text":"比陌生人争执带来的伤害更要严重啊"},{"start":550.3,"end":554.18,"text":"如果大家这反而是很团结的爆拧成一团的"},{"start":554.18,"end":557.6,"text":"那么再辛苦其实也都还能承受啊"},{"start":557.6,"end":559.06,"text":"对不对啊"},{"start":559.06,"end":559.9,"text":"就害怕"},{"start":559.9,"end":564.28,"text":"就是说啊就冷嘲热讽或者说那种啊"},{"start":564.28,"end":566.479,"text":"反而伤了自己家人的心啊"},{"start":566.92,"end":568.06,"text":"那我的意思"},{"start":568.06,"end":570.04,"text":"你作为一个年轻人啊"},{"start":570.04,"end":571.64,"text":"作为一个新一代的人"},{"start":571.72,"end":575.23,"text":"要认识到很多事情"},{"start":575.23,"end":581.62,"text":"他的当中呢年老一代人他犯的错误啊"},{"start":582.04,"end":584.2,"text":"啊情有可原嘛"},{"start":584.2,"end":586.87,"text":"我觉得情有可原"},{"start":586.87,"end":591.359,"text":"但是如果说是一些啊真的是错了"},{"start":591.56,"end":593.06,"text":"错需要改"},{"start":593.06,"end":595.67,"text":"情有可原有可原"},{"start":595.67,"end":597.68,"text":"但是错都需要改正"},{"start":597.68,"end":599.859,"text":"但是有的错误的改正呢"},{"start":599.94,"end":602.73,"text":"不是说你要强迫是老一代人改"},{"start":602.73,"end":605.54,"text":"还说你自己不犯啊"},{"start":605.54,"end":607.37,"text":"你自己逐步长大了之后"},{"start":607.37,"end":608.78,"text":"尤其是你工作了"},{"start":608.78,"end":609.8,"text":"有收入了"},{"start":609.8,"end":612.56,"text":"家里面的事情你有发言权了之后"},{"start":613.32,"end":617.9,"text":"你要保证自己不犯一些错误与利益的分配啊"},{"start":617.9,"end":620.859,"text":"比如说家族呃"},{"start":621.18,"end":628.28,"text":"一些责任的承担啊啊就是说要更去体恤弱者"},{"start":628.28,"end":630.26,"text":"强者要更承担责任"},{"start":630.26,"end":633.819,"text":"而不是强者用自己的强大去伤害弱者"},{"start":633.819,"end":636.8,"text":"这些相对朴素的正义"},{"start":637.5,"end":642.8,"text":"那么在你这里需要有一个成熟理性的算计"},{"start":642.8,"end":646.76,"text":"成熟的呃有有技巧"},{"start":646.76,"end":651.51,"text":"有手段的一种方式去实现它"},{"start":651.51,"end":654.5,"text":"所以我的观点就是说呃"},{"start":658.16,"end":661.72,"text":"你现在的态度在学校教育当中啊"},{"start":661.72,"end":664.9,"text":"在应试教育或者说在劳动教育啊"},{"start":664.9,"end":667.99,"text":"啊我觉得是可取的"},{"start":667.99,"end":669.85,"text":"已经是不错的了啊"},{"start":669.85,"end":673.25,"text":"可以去继续保持嗯"},{"start":673.25,"end":677.9,"text":"但是对于你自己对于自己人生的态度"},{"start":677.9,"end":682.06,"text":"或者说对于你自己的一些啊选择"},{"start":682.06,"end":683.839,"text":"对于家人的影响"},{"start":684.6,"end":688.699,"text":"以及说你做的一些事情啊啊"},{"start":692.52,"end":694.58,"text":"其实你不是一个孤立的人"},{"start":694.58,"end":697.22,"text":"你是和你的父母是有一个不可斩断的"},{"start":697.22,"end":700.45,"text":"一个一个一个一个一个纽带的"},{"start":700.45,"end":702.22,"text":"情感上的纽带啊"},{"start":702.22,"end":703.84,"text":"那