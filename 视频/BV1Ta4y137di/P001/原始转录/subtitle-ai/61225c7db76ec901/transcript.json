{
  "bvid": "BV1Ta4y137di",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "61225c7db76ec9019acd65f205cefd5e6fbe852e6f941cdfb6c5bcf17a2522f7",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 140,
      "end_ms": 2840,
      "text": "呃我还是继续回信件啊"
    },
    {
      "ordinal": 1,
      "start_ms": 2840,
      "end_ms": 8000,
      "text": "他是成都的一位叫邢锐呀"
    },
    {
      "ordinal": 2,
      "start_ms": 11200,
      "end_ms": 12720,
      "text": "啊这个是神殿瑞啊"
    },
    {
      "ordinal": 3,
      "start_ms": 12720,
      "end_ms": 15150,
      "text": "没文化啊"
    },
    {
      "ordinal": 4,
      "start_ms": 15150,
      "end_ms": 18240,
      "text": "确实吴瑞啊"
    },
    {
      "ordinal": 5,
      "start_ms": 19680,
      "end_ms": 22619,
      "text": "那么他说魏明子你好"
    },
    {
      "ordinal": 6,
      "start_ms": 22619,
      "end_ms": 25679,
      "text": "我是一名被分流的普通中职生"
    },
    {
      "ordinal": 7,
      "start_ms": 25679,
      "end_ms": 28439,
      "text": "曾1度沉浸在某种享乐中无法自拔"
    },
    {
      "ordinal": 8,
      "start_ms": 28439,
      "end_ms": 30460,
      "text": "对前途试图"
    },
    {
      "ordinal": 9,
      "start_ms": 30460,
      "end_ms": 32339,
      "text": "他竟然写了个视图啊"
    },
    {
      "ordinal": 10,
      "start_ms": 33100,
      "end_ms": 35460,
      "text": "单人旁的不抱有期望"
    },
    {
      "ordinal": 11,
      "start_ms": 35460,
      "end_ms": 37200,
      "text": "深谙知足常乐之道"
    },
    {
      "ordinal": 12,
      "start_ms": 37200,
      "end_ms": 40620,
      "text": "幻想着日后能过上闲云野鹤般的生活"
    },
    {
      "ordinal": 13,
      "start_ms": 40620,
      "end_ms": 41640,
      "text": "一个普通人的"
    },
    {
      "ordinal": 14,
      "start_ms": 41640,
      "end_ms": 46830,
      "text": "且不参与或者是少参与那种世俗的争名夺利"
    },
    {
      "ordinal": 15,
      "start_ms": 46830,
      "end_ms": 48930,
      "text": "然后我随便上了一个技校"
    },
    {
      "ordinal": 16,
      "start_ms": 48930,
      "end_ms": 49860,
      "text": "在技校的生活"
    },
    {
      "ordinal": 17,
      "start_ms": 49860,
      "end_ms": 52099,
      "text": "我拥有了相当多的空闲时间"
    },
    {
      "ordinal": 18,
      "start_ms": 53700,
      "end_ms": 56820,
      "text": "加上比以往多了一点点社会认识"
    },
    {
      "ordinal": 19,
      "start_ms": 57220,
      "end_ms": 59230,
      "text": "我的思想发生转变"
    },
    {
      "ordinal": 20,
      "start_ms": 59230,
      "end_ms": 63310,
      "text": "我开始不再像以前那样靠享乐来麻痹自己"
    },
    {
      "ordinal": 21,
      "start_ms": 63310,
      "end_ms": 64789,
      "text": "也可能是玩腻了啊"
    },
    {
      "ordinal": 22,
      "start_ms": 64789,
      "end_ms": 69349,
      "text": "更多的时间用来做自己认为有意义的事"
    },
    {
      "ordinal": 23,
      "start_ms": 69349,
      "end_ms": 71269,
      "text": "上课也不是萎靡不振了"
    },
    {
      "ordinal": 24,
      "start_ms": 71269,
      "end_ms": 72580,
      "text": "参加了校团委"
    },
    {
      "ordinal": 25,
      "start_ms": 72580,
      "end_ms": 73960,
      "text": "经常上台演讲"
    },
    {
      "ordinal": 26,
      "start_ms": 73960,
      "end_ms": 76840,
      "text": "以全校第一的成绩拿到了团员资格"
    },
    {
      "ordinal": 27,
      "start_ms": 77760,
      "end_ms": 79670,
      "text": "还有获得了一些荣誉"
    },
    {
      "ordinal": 28,
      "start_ms": 79670,
      "end_ms": 82040,
      "text": "但我知道这些都不能算做什么"
    },
    {
      "ordinal": 29,
      "start_ms": 82040,
      "end_ms": 83360,
      "text": "因为绩效水平很有限"
    },
    {
      "ordinal": 30,
      "start_ms": 83360,
      "end_ms": 87200,
      "text": "我也只是在跟一帮正在走路的人比跑步"
    },
    {
      "ordinal": 31,
      "start_ms": 87200,
      "end_ms": 89180,
      "text": "我还很清楚自身的弱"
    },
    {
      "ordinal": 32,
      "start_ms": 89180,
      "end_ms": 89700,
      "text": "小"
    },
    {
      "ordinal": 33,
      "start_ms": 89740,
      "end_ms": 91780,
      "text": "学到第2年的时候"
    },
    {
      "ordinal": 34,
      "start_ms": 91780,
      "end_ms": 93670,
      "text": "因为家里的矛盾激烈到了极点"
    },
    {
      "ordinal": 35,
      "start_ms": 93670,
      "end_ms": 96520,
      "text": "且我很讨厌学校的宿舍制度"
    },
    {
      "ordinal": 36,
      "start_ms": 96520,
      "end_ms": 100840,
      "text": "还有我自身身体和心理上早已有之的问题"
    },
    {
      "ordinal": 37,
      "start_ms": 101220,
      "end_ms": 104610,
      "text": "在两次什么什么什么之后呢"
    },
    {
      "ordinal": 38,
      "start_ms": 104610,
      "end_ms": 106600,
      "text": "家里给我办了休学"
    },
    {
      "ordinal": 39,
      "start_ms": 106800,
      "end_ms": 108180,
      "text": "在休学这段时间"
    },
    {
      "ordinal": 40,
      "start_ms": 108180,
      "end_ms": 109560,
      "text": "我还是沉浸于享乐"
    },
    {
      "ordinal": 41,
      "start_ms": 109560,
      "end_ms": 111540,
      "text": "和之前一样啊"
    },
    {
      "ordinal": 42,
      "start_ms": 111540,
      "end_ms": 112980,
      "text": "再后来我转学了"
    },
    {
      "ordinal": 43,
      "start_ms": 112980,
      "end_ms": 117710,
      "text": "妈妈把我从啊某省带到了这个四川"
    },
    {
      "ordinal": 44,
      "start_ms": 117710,
      "end_ms": 120980,
      "text": "我也和从小把我带大"
    },
    {
      "ordinal": 45,
      "start_ms": 120980,
      "end_ms": 125679,
      "text": "带到大的奶奶做了长久的告别哦"
    },
    {
      "ordinal": 46,
      "start_ms": 128539,
      "end_ms": 131980,
      "text": "呃我不确定是不是你奶奶去世啊"
    },
    {
      "ordinal": 47,
      "start_ms": 131980,
      "end_ms": 133390,
      "text": "如果是去世的话呢"
    },
    {
      "ordinal": 48,
      "start_ms": 133390,
      "end_ms": 134560,
      "text": "如果不是去世的话"
    },
    {
      "ordinal": 49,
      "start_ms": 134560,
      "end_ms": 136120,
      "text": "那祝他健康长寿啊"
    },
    {
      "ordinal": 50,
      "start_ms": 136120,
      "end_ms": 137140,
      "text": "如果是去世的话"
    },
    {
      "ordinal": 51,
      "start_ms": 137140,
      "end_ms": 141870,
      "text": "那就表达一个哀悼啊"
    },
    {
      "ordinal": 52,
      "start_ms": 141870,
      "end_ms": 143250,
      "text": "希望他不是趋势"
    },
    {
      "ordinal": 53,
      "start_ms": 143250,
      "end_ms": 145020,
      "text": "那么到了四川后"
    },
    {
      "ordinal": 54,
      "start_ms": 145020,
      "end_ms": 146940,
      "text": "家里给我找了个公办职校"
    },
    {
      "ordinal": 55,
      "start_ms": 146940,
      "end_ms": 148020,
      "text": "在这所学校中"
    },
    {
      "ordinal": 56,
      "start_ms": 148020,
      "end_ms": 152300,
      "text": "我也要重新开始为期3年的学习生涯"
    },
    {
      "ordinal": 57,
      "start_ms": 152300,
      "end_ms": 153560,
      "text": "办的是走读"
    },
    {
      "ordinal": 58,
      "start_ms": 153560,
      "end_ms": 155180,
      "text": "家里不算富裕"
    },
    {
      "ordinal": 59,
      "start_ms": 155180,
      "end_ms": 155840,
      "text": "妈妈很苦"
    },
    {
      "ordinal": 60,
      "start_ms": 155840,
      "end_ms": 158540,
      "text": "我就自然地玩腻游戏了"
    },
    {
      "ordinal": 61,
      "start_ms": 158540,
      "end_ms": 161300,
      "text": "在这期间我看到了未老哥"
    },
    {
      "ordinal": 62,
      "start_ms": 161300,
      "end_ms": 163340,
      "text": "2021年3月30日的"
    },
    {
      "ordinal": 63,
      "start_ms": 163340,
      "end_ms": 164720,
      "text": "尤其应该努力学习"
    },
    {
      "ordinal": 64,
      "start_ms": 164720,
      "end_ms": 167000,
      "text": "积极应试里面有有目的的学习"
    },
    {
      "ordinal": 65,
      "start_ms": 167000,
      "end_ms": 167720,
      "text": "拿到筹码"
    },
    {
      "ordinal": 66,
      "start_ms": 167720,
      "end_ms": 168829,
      "text": "让我有所感触"
    },
    {
      "ordinal": 67,
      "start_ms": 168829,
      "end_ms": 170509,
      "text": "3年时间说长不长"
    },
    {
      "ordinal": 68,
      "start_ms": 170509,
      "end_ms": 171109,
      "text": "说短不短"
    },
    {
      "ordinal": 69,
      "start_ms": 171109,
      "end_ms": 173029,
      "text": "期间我肯定会遇到各种挫折"
    },
    {
      "ordinal": 70,
      "start_ms": 173029,
      "end_ms": 174289,
      "text": "但我会尽力克服的"
    },
    {
      "ordinal": 71,
      "start_ms": 174289,
      "end_ms": 176449,
      "text": "我想同您未来站在一个战线上"
    },
    {
      "ordinal": 72,
      "start_ms": 176449,
      "end_ms": 179630,
      "text": "为劳动者的解放斗争啊"
    },
    {
      "ordinal": 73,
      "start_ms": 179630,
      "end_ms": 181660,
      "text": "最后就是五一假期期间"
    },
    {
      "ordinal": 74,
      "start_ms": 181660,
      "end_ms": 184000,
      "text": "因为对家里的事情怎么说呢"
    },
    {
      "ordinal": 75,
      "start_ms": 184000,
      "end_ms": 185560,
      "text": "就是有感而发"
    },
    {
      "ordinal": 76,
      "start_ms": 185560,
      "end_ms": 187960,
      "text": "用自己可怜的文才做的首饰"
    },
    {
      "ordinal": 77,
      "start_ms": 187960,
      "end_ms": 189640,
      "text": "魏老哥不要见笑"
    },
    {
      "ordinal": 78,
      "start_ms": 190880,
      "end_ms": 195999,
      "text": "他说七绝家亲父母今何在"
    },
    {
      "ordinal": 79,
      "start_ms": 195999,
      "end_ms": 199039,
      "text": "漫步清醉呃"
    },
    {
      "ordinal": 80,
      "start_ms": 199039,
      "end_ms": 200359,
      "text": "满目山"
    },
    {
      "ordinal": 81,
      "start_ms": 203419,
      "end_ms": 205800,
      "text": "啊心更无力"
    },
    {
      "ordinal": 82,
      "start_ms": 205800,
      "end_ms": 207360,
      "text": "摧花之折纸"
    },
    {
      "ordinal": 83,
      "start_ms": 207360,
      "end_ms": 208800,
      "text": "一事无力来"
    },
    {
      "ordinal": 84,
      "start_ms": 212100,
      "end_ms": 215300,
      "text": "然后我让妈妈取个名字为这首诗"
    },
    {
      "ordinal": 85,
      "start_ms": 215300,
      "end_ms": 217580,
      "text": "他说忆苦思甜"
    },
    {
      "ordinal": 86,
      "start_ms": 217580,
      "end_ms": 219140,
      "text": "我想他是想告诉我"
    },
    {
      "ordinal": 87,
      "start_ms": 219140,
      "end_ms": 220640,
      "text": "纵使回忆是苦涩的"
    },
    {
      "ordinal": 88,
      "start_ms": 220640,
      "end_ms": 222080,
      "text": "但只要心中有希望"
    },
    {
      "ordinal": 89,
      "start_ms": 222080,
      "end_ms": 222820,
      "text": "好好干"
    },
    {
      "ordinal": 90,
      "start_ms": 222820,
      "end_ms": 225340,
      "text": "日子会越来越甜的啊"
    },
    {
      "ordinal": 91,
      "start_ms": 225340,
      "end_ms": 226690,
      "text": "允许公开啊"
    },
    {
      "ordinal": 92,
      "start_ms": 226690,
      "end_ms": 228700,
      "text": "那么我要说的就是"
    },
    {
      "ordinal": 93,
      "start_ms": 234160,
      "end_ms": 239640,
      "text": "他是回了这个四川去职校里面学习了啊"
    },
    {
      "ordinal": 94,
      "start_ms": 240279,
      "end_ms": 244619,
      "text": "我觉得还是要在职业技术学校里面啊"
    },
    {
      "ordinal": 95,
      "start_ms": 244619,
      "end_ms": 251420,
      "text": "啊职业学校里面要努力掌握这个劳动技能"
    },
    {
      "ordinal": 96,
      "start_ms": 251420,
      "end_ms": 252590,
      "text": "劳动技能"
    },
    {
      "ordinal": 97,
      "start_ms": 252590,
      "end_ms": 255140,
      "text": "然后呢现在跟你说积极应试"
    },
    {
      "ordinal": 98,
      "start_ms": 255140,
      "end_ms": 258939,
      "text": "这个应试呢呃应当就是说不简"
    },
    {
      "ordinal": 99,
      "start_ms": 258939,
      "end_ms": 263889,
      "text": "简单单是啊要职校升大专再升本科这种意义"
    },
    {
      "ordinal": 100,
      "start_ms": 263889,
      "end_ms": 267180,
      "text": "而是要啊一些技术性的考试啊"
    },
    {
      "ordinal": 101,
      "start_ms": 267180,
      "end_ms": 269400,
      "text": "技术性的标准性的那种啊"
    },
    {
      "ordinal": 102,
      "start_ms": 269400,
      "end_ms": 272400,
      "text": "作为劳动资格的门槛的一些考试"
    },
    {
      "ordinal": 103,
      "start_ms": 272400,
      "end_ms": 274170,
      "text": "你要努力去准备"
    },
    {
      "ordinal": 104,
      "start_ms": 274170,
      "end_ms": 275520,
      "text": "积极去应试"
    },
    {
      "ordinal": 105,
      "start_ms": 275539,
      "end_ms": 279679,
      "text": "你拿到筹码呢不一定是学历啊"
    },
    {
      "ordinal": 106,
      "start_ms": 279679,
      "end_ms": 282229,
      "text": "不一定是某种这个呃"
    },
    {
      "ordinal": 107,
      "start_ms": 282229,
      "end_ms": 285680,
      "text": "就是说鄙视链上面的东西啊"
    },
    {
      "ordinal": 108,
      "start_ms": 285680,
      "end_ms": 289040,
      "text": "拿到了就可以去鄙视别人或者不被别人鄙视"
    },
    {
      "ordinal": 109,
      "start_ms": 289040,
      "end_ms": 289880,
      "text": "不是这种东西"
    },
    {
      "ordinal": 110,
      "start_ms": 289880,
      "end_ms": 296500,
      "text": "你拿到的筹码呢应当是一个劳动技技能以及劳"
    },
    {
      "ordinal": 111,
      "start_ms": 296500,
      "end_ms": 299020,
      "text": "动参与某种特定劳动的"
    },
    {
      "ordinal": 112,
      "start_ms": 299020,
      "end_ms": 301240,
      "text": "比如说他的资格啊"
    },
    {
      "ordinal": 113,
      "start_ms": 301240,
      "end_ms": 303640,
      "text": "他可能是主要是社会安全的考虑啊"
    },
    {
      "ordinal": 114,
      "start_ms": 303640,
      "end_ms": 306740,
      "text": "或者说比如电工啊"
    },
    {
      "ordinal": 115,
      "start_ms": 306740,
      "end_ms": 308660,
      "text": "比如说什么消防啊"
    },
    {
      "ordinal": 116,
      "start_ms": 308660,
      "end_ms": 313349,
      "text": "这这样的这样的筹码啊"
    },
    {
      "ordinal": 117,
      "start_ms": 313349,
      "end_ms": 315359,
      "text": "有目的的学习啊"
    },
    {
      "ordinal": 118,
      "start_ms": 315359,
      "end_ms": 316439,
      "text": "你学好了之后"
    },
    {
      "ordinal": 119,
      "start_ms": 316439,
      "end_ms": 322580,
      "text": "你就有一个相对还比较有发展空间的啊"
    },
    {
      "ordinal": 120,
      "start_ms": 322580,
      "end_ms": 326510,
      "text": "能够覆盖你本人的生存和你家人的一定的生存"
    },
    {
      "ordinal": 121,
      "start_ms": 326510,
      "end_ms": 329330,
      "text": "还有一定发展性的一些工作"
    },
    {
      "ordinal": 122,
      "start_ms": 329330,
      "end_ms": 330440,
      "text": "呃"
    },
    {
      "ordinal": 123,
      "start_ms": 330440,
      "end_ms": 332840,
      "text": "呃我都想用您了"
    },
    {
      "ordinal": 124,
      "start_ms": 332840,
      "end_ms": 333260,
      "text": "对不对啊"
    },
    {
      "ordinal": 125,
      "start_ms": 333260,
      "end_ms": 333980,
      "text": "你呀"
    },
    {
      "ordinal": 126,
      "start_ms": 333980,
      "end_ms": 335810,
      "text": "所以说你大概率"
    },
    {
      "ordinal": 127,
      "start_ms": 335810,
      "end_ms": 340280,
      "text": "将来是会成为体力无产者的一员"
    },
    {
      "ordinal": 128,
      "start_ms": 340539,
      "end_ms": 341580,
      "text": "那么"
    },
    {
      "ordinal": 129,
      "start_ms": 344960,
      "end_ms": 347020,
      "text": "家庭的事情"
    },
    {
      "ordinal": 130,
      "start_ms": 347020,
      "end_ms": 350740,
      "text": "上一代人有他们上一代的局限性"
    },
    {
      "ordinal": 131,
      "start_ms": 350740,
      "end_ms": 355060,
      "text": "有他们对于这个社会的一些迷惘啊"
    },
    {
      "ordinal": 132,
      "start_ms": 355060,
      "end_ms": 356980,
      "text": "以及对于家庭关系"
    },
    {
      "ordinal": 133,
      "start_ms": 356980,
      "end_ms": 360220,
      "text": "对于情感关系的一些呃片面啊"
    },
    {
      "ordinal": 134,
      "start_ms": 360220,
      "end_ms": 365250,
      "text": "或者说也没有人曾经非常系统性的教过他们"
    },
    {
      "ordinal": 135,
      "start_ms": 365250,
      "end_ms": 365970,
      "text": "怎么去应对"
    },
    {
      "ordinal": 136,
      "start_ms": 365970,
      "end_ms": 366480,
      "text": "对不对"
    },
    {
      "ordinal": 137,
      "start_ms": 366480,
      "end_ms": 373000,
      "text": "因为我们国家啊啊在前前面这几十年"
    },
    {
      "ordinal": 138,
      "start_ms": 373000,
      "end_ms": 376780,
      "text": "他发生了翻天覆地的变化啊"
    },
    {
      "ordinal": 139,
      "start_ms": 376800,
      "end_ms": 381780,
      "text": "然后在乡村或者说在小的城镇当中生存的"
    },
    {
      "ordinal": 140,
      "start_ms": 381780,
      "end_ms": 383220,
      "text": "世世代代的人"
    },
    {
      "ordinal": 141,
      "start_ms": 383220,
      "end_ms": 388350,
      "text": "他的一些传统的家族关系被现代化的过程啊"
    },
    {
      "ordinal": 142,
      "start_ms": 388350,
      "end_ms": 390870,
      "text": "被这个工业文明的发展啊"
    },
    {
      "ordinal": 143,
      "start_ms": 390870,
      "end_ms": 393420,
      "text": "被甚至说信息技术"
    },
    {
      "ordinal": 144,
      "start_ms": 393420,
      "end_ms": 397459,
      "text": "互联网的发展已经是完全彻底的改变了啊"
    },
    {
      "ordinal": 145,
      "start_ms": 397459,
      "end_ms": 402000,
      "text": "所以家庭内部的一些年纪大的成员"
    },
    {
      "ordinal": 146,
      "start_ms": 402000,
      "end_ms": 404340,
      "text": "甚至叫你爸爸妈妈啊"
    },
    {
      "ordinal": 147,
      "start_ms": 404340,
      "end_ms": 410520,
      "text": "他们很多是在这样的变化当中是迷茫的啊"
    },
    {
      "ordinal": 148,
      "start_ms": 410659,
      "end_ms": 414040,
      "text": "是会犯错的"
    },
    {
      "ordinal": 149,
      "start_ms": 414819,
      "end_ms": 419740,
      "text": "这样的错误可能对于啊你这样比较幼幼小的"
    },
    {
      "ordinal": 150,
      "start_ms": 419740,
      "end_ms": 421900,
      "text": "这是他们自己都是迷茫的"
    },
    {
      "ordinal": 151,
      "start_ms": 421900,
      "end_ms": 423100,
      "text": "虽然他们犯错了"
    },
    {
      "ordinal": 152,
      "start_ms": 423100,
      "end_ms": 426309,
      "text": "所以很多一些情绪的失控啊"
    },
    {
      "ordinal": 153,
      "start_ms": 426309,
      "end_ms": 433599,
      "text": "或者说一些呃啊家庭关系的一些呃重组破裂"
    },
    {
      "ordinal": 154,
      "start_ms": 433599,
      "end_ms": 435960,
      "text": "或者说一些whatever"
    },
    {
      "ordinal": 155,
      "start_ms": 436340,
      "end_ms": 438440,
      "text": "这些你心里面没说离婚"
    },
    {
      "ordinal": 156,
      "start_ms": 438440,
      "end_ms": 440060,
      "text": "那我我我爸妈都离婚了"
    },
    {
      "ordinal": 157,
      "start_ms": 440060,
      "end_ms": 440960,
      "text": "对不对啊"
    },
    {
      "ordinal": 158,
      "start_ms": 440960,
      "end_ms": 444110,
      "text": "这样类似他都会给幼小的个体带来某些伤害"
    },
    {
      "ordinal": 159,
      "start_ms": 444110,
      "end_ms": 448180,
      "text": "但是父母并不是刻意要去要去伤害自己小孩"
    },
    {
      "ordinal": 160,
      "start_ms": 448180,
      "end_ms": 448930,
      "text": "你明白吗"
    },
    {
      "ordinal": 161,
      "start_ms": 448930,
      "end_ms": 451660,
      "text": "他并不是说以这个以此为目的的"
    },
    {
      "ordinal": 162,
      "start_ms": 451700,
      "end_ms": 454160,
      "text": "哪怕有一些父母啊"
    },
    {
      "ordinal": 163,
      "start_ms": 454160,
      "end_ms": 458520,
      "text": "他呃会以发泄到孩子身上的方式"
    },
    {
      "ordinal": 164,
      "start_ms": 458520,
      "end_ms": 461340,
      "text": "来减轻他的这个自己的痛苦"
    },
    {
      "ordinal": 165,
      "start_ms": 461340,
      "end_ms": 463950,
      "text": "或者说来来来来伤害别人"
    },
    {
      "ordinal": 166,
      "start_ms": 463950,
      "end_ms": 466430,
      "text": "来伤害其他成年人啊"
    },
    {
      "ordinal": 167,
      "start_ms": 466430,
      "end_ms": 467660,
      "text": "这个都只是"
    },
    {
      "ordinal": 168,
      "start_ms": 469940,
      "end_ms": 472900,
      "text": "有些恶性嘛能让孩子受伤害"
    },
    {
      "ordinal": 169,
      "start_ms": 472900,
      "end_ms": 476110,
      "text": "父母肯定是有他的问题的"
    },
    {
      "ordinal": 170,
      "start_ms": 476110,
      "end_ms": 481070,
      "text": "但是上一个世代的这些成年人"
    },
    {
      "ordinal": 171,
      "start_ms": 481070,
      "end_ms": 483350,
      "text": "在面对很多事情上面"
    },
    {
      "ordinal": 172,
      "start_ms": 483350,
      "end_ms": 485230,
      "text": "他没有接受良好教育"
    },
    {
      "ordinal": 173,
      "start_ms": 485230,
      "end_ms": 490030,
      "text": "或者说他自己没有办法从社会的公开的讨"
    },
    {
      "ordinal": 174,
      "start_ms": 490030,
      "end_ms": 497269,
      "text": "论和文化当中获得一些经验"
    },
    {
      "ordinal": 175,
      "start_ms": 497269,
      "end_ms": 498889,
      "text": "获得一些指导的话"
    },
    {
      "ordinal": 176,
      "start_ms": 498889,
      "end_ms": 500380,
      "text": "他们的思考"
    },
    {
      "ordinal": 177,
      "start_ms": 500539,
      "end_ms": 504980,
      "text": "他们的情绪反应本身都是有局限性的"
    },
    {
      "ordinal": 178,
      "start_ms": 506579,
      "end_ms": 509720,
      "text": "这个我要说的就是说呃"
    },
    {
      "ordinal": 179,
      "start_ms": 513159,
      "end_ms": 517549,
      "text": "啊而且尤其是亲人之间"
    },
    {
      "ordinal": 180,
      "start_ms": 517549,
      "end_ms": 522000,
      "text": "他可能就是说会把这个血缘关系"
    },
    {
      "ordinal": 181,
      "start_ms": 522000,
      "end_ms": 524220,
      "text": "就汤臣是天经地义的"
    },
    {
      "ordinal": 182,
      "start_ms": 524220,
      "end_ms": 526180,
      "text": "然后因为天经地义是自己人"
    },
    {
      "ordinal": 183,
      "start_ms": 526340,
      "end_ms": 529460,
      "text": "那么有的时候在算计一些利益的时候"
    },
    {
      "ordinal": 184,
      "start_ms": 529460,
      "end_ms": 533430,
      "text": "反而会这个面目更狰狞一些对吧"
    },
    {
      "ordinal": 185,
      "start_ms": 533430,
      "end_ms": 537240,
      "text": "反而会这个更不客客气气一些"
    },
    {
      "ordinal": 186,
      "start_ms": 537240,
      "end_ms": 538290,
      "text": "客气客气"
    },
    {
      "ordinal": 187,
      "start_ms": 538290,
      "end_ms": 539730,
      "text": "家里人不用客气"
    },
    {
      "ordinal": 188,
      "start_ms": 539730,
      "end_ms": 543000,
      "text": "反而会有的时候会造成伤害啊"
    },
    {
      "ordinal": 189,
      "start_ms": 543000,
      "end_ms": 546190,
      "text": "比陌生人的争执"
    },
    {
      "ordinal": 190,
      "start_ms": 546190,
      "end_ms": 547000,
      "text": "家人的争执"
    },
    {
      "ordinal": 191,
      "start_ms": 547000,
      "end_ms": 550300,
      "text": "比陌生人争执带来的伤害更要严重啊"
    },
    {
      "ordinal": 192,
      "start_ms": 550300,
      "end_ms": 554180,
      "text": "如果大家这反而是很团结的爆拧成一团的"
    },
    {
      "ordinal": 193,
      "start_ms": 554180,
      "end_ms": 557600,
      "text": "那么再辛苦其实也都还能承受啊"
    },
    {
      "ordinal": 194,
      "start_ms": 557600,
      "end_ms": 559060,
      "text": "对不对啊"
    },
    {
      "ordinal": 195,
      "start_ms": 559060,
      "end_ms": 559900,
      "text": "就害怕"
    },
    {
      "ordinal": 196,
      "start_ms": 559900,
      "end_ms": 564280,
      "text": "就是说啊就冷嘲热讽或者说那种啊"
    },
    {
      "ordinal": 197,
      "start_ms": 564280,
      "end_ms": 566479,
      "text": "反而伤了自己家人的心啊"
    },
    {
      "ordinal": 198,
      "start_ms": 566920,
      "end_ms": 568060,
      "text": "那我的意思"
    },
    {
      "ordinal": 199,
      "start_ms": 568060,
      "end_ms": 570040,
      "text": "你作为一个年轻人啊"
    },
    {
      "ordinal": 200,
      "start_ms": 570040,
      "end_ms": 571640,
      "text": "作为一个新一代的人"
    },
    {
      "ordinal": 201,
      "start_ms": 571720,
      "end_ms": 575230,
      "text": "要认识到很多事情"
    },
    {
      "ordinal": 202,
      "start_ms": 575230,
      "end_ms": 581620,
      "text": "他的当中呢年老一代人他犯的错误啊"
    },
    {
      "ordinal": 203,
      "start_ms": 582040,
      "end_ms": 584200,
      "text": "啊情有可原嘛"
    },
    {
      "ordinal": 204,
      "start_ms": 584200,
      "end_ms": 586870,
      "text": "我觉得情有可原"
    },
    {
      "ordinal": 205,
      "start_ms": 586870,
      "end_ms": 591359,
      "text": "但是如果说是一些啊真的是错了"
    },
    {
      "ordinal": 206,
      "start_ms": 591560,
      "end_ms": 593060,
      "text": "错需要改"
    },
    {
      "ordinal": 207,
      "start_ms": 593060,
      "end_ms": 595670,
      "text": "情有可原有可原"
    },
    {
      "ordinal": 208,
      "start_ms": 595670,
      "end_ms": 597680,
      "text": "但是错都需要改正"
    },
    {
      "ordinal": 209,
      "start_ms": 597680,
      "end_ms": 599859,
      "text": "但是有的错误的改正呢"
    },
    {
      "ordinal": 210,
      "start_ms": 599940,
      "end_ms": 602730,
      "text": "不是说你要强迫是老一代人改"
    },
    {
      "ordinal": 211,
      "start_ms": 602730,
      "end_ms": 605540,
      "text": "还说你自己不犯啊"
    },
    {
      "ordinal": 212,
      "start_ms": 605540,
      "end_ms": 607370,
      "text": "你自己逐步长大了之后"
    },
    {
      "ordinal": 213,
      "start_ms": 607370,
      "end_ms": 608780,
      "text": "尤其是你工作了"
    },
    {
      "ordinal": 214,
      "start_ms": 608780,
      "end_ms": 609800,
      "text": "有收入了"
    },
    {
      "ordinal": 215,
      "start_ms": 609800,
      "end_ms": 612560,
      "text": "家里面的事情你有发言权了之后"
    },
    {
      "ordinal": 216,
      "start_ms": 613320,
      "end_ms": 617900,
      "text": "你要保证自己不犯一些错误与利益的分配啊"
    },
    {
      "ordinal": 217,
      "start_ms": 617900,
      "end_ms": 620859,
      "text": "比如说家族呃"
    },
    {
      "ordinal": 218,
      "start_ms": 621180,
      "end_ms": 628280,
      "text": "一些责任的承担啊啊就是说要更去体恤弱者"
    },
    {
      "ordinal": 219,
      "start_ms": 628280,
      "end_ms": 630260,
      "text": "强者要更承担责任"
    },
    {
      "ordinal": 220,
      "start_ms": 630260,
      "end_ms": 633819,
      "text": "而不是强者用自己的强大去伤害弱者"
    },
    {
      "ordinal": 221,
      "start_ms": 633819,
      "end_ms": 636800,
      "text": "这些相对朴素的正义"
    },
    {
      "ordinal": 222,
      "start_ms": 637500,
      "end_ms": 642800,
      "text": "那么在你这里需要有一个成熟理性的算计"
    },
    {
      "ordinal": 223,
      "start_ms": 642800,
      "end_ms": 646760,
      "text": "成熟的呃有有技巧"
    },
    {
      "ordinal": 224,
      "start_ms": 646760,
      "end_ms": 651510,
      "text": "有手段的一种方式去实现它"
    },
    {
      "ordinal": 225,
      "start_ms": 651510,
      "end_ms": 654500,
      "text": "所以我的观点就是说呃"
    },
    {
      "ordinal": 226,
      "start_ms": 658160,
      "end_ms": 661720,
      "text": "你现在的态度在学校教育当中啊"
    },
    {
      "ordinal": 227,
      "start_ms": 661720,
      "end_ms": 664900,
      "text": "在应试教育或者说在劳动教育啊"
    },
    {
      "ordinal": 228,
      "start_ms": 664900,
      "end_ms": 667990,
      "text": "啊我觉得是可取的"
    },
    {
      "ordinal": 229,
      "start_ms": 667990,
      "end_ms": 669850,
      "text": "已经是不错的了啊"
    },
    {
      "ordinal": 230,
      "start_ms": 669850,
      "end_ms": 673250,
      "text": "可以去继续保持嗯"
    },
    {
      "ordinal": 231,
      "start_ms": 673250,
      "end_ms": 677900,
      "text": "但是对于你自己对于自己人生的态度"
    },
    {
      "ordinal": 232,
      "start_ms": 677900,
      "end_ms": 682060,
      "text": "或者说对于你自己的一些啊选择"
    },
    {
      "ordinal": 233,
      "start_ms": 682060,
      "end_ms": 683839,
      "text": "对于家人的影响"
    },
    {
      "ordinal": 234,
      "start_ms": 684600,
      "end_ms": 688699,
      "text": "以及说你做的一些事情啊啊"
    },
    {
      "ordinal": 235,
      "start_ms": 692520,
      "end_ms": 694580,
      "text": "其实你不是一个孤立的人"
    },
    {
      "ordinal": 236,
      "start_ms": 694580,
      "end_ms": 697220,
      "text": "你是和你的父母是有一个不可斩断的"
    },
    {
      "ordinal": 237,
      "start_ms": 697220,
      "end_ms": 700450,
      "text": "一个一个一个一个一个纽带的"
    },
    {
      "ordinal": 238,
      "start_ms": 700450,
      "end_ms": 702220,
      "text": "情感上的纽带啊"
    },
    {
      "ordinal": 239,
      "start_ms": 702220,
      "end_ms": 703840,
      "text": "那个啊"
    },
    {
      "ordinal": 240,
      "start_ms": 703840,
      "end_ms": 709030,
      "text": "然后我的意思就是说玩游戏总会玩腻的"
    },
    {
      "ordinal": 241,
      "start_ms": 709030,
      "end_ms": 711010,
      "text": "自己玩游戏怎么玩腻的"
    },
    {
      "ordinal": 242,
      "start_ms": 711010,
      "end_ms": 716720,
      "text": "但是你与其独乐乐不如众乐乐是吧"
    },
    {
      "ordinal": 243,
      "start_ms": 716720,
      "end_ms": 718460,
      "text": "培养感情啊"
    },
    {
      "ordinal": 244,
      "start_ms": 718460,
      "end_ms": 721780,
      "text": "你可以陪你的父母啊"
    },
    {
      "ordinal": 245,
      "start_ms": 731120,
      "end_ms": 734400,
      "text": "因为你这个信里面只提到你的妈妈"
    },
    {
      "ordinal": 246,
      "start_ms": 738100,
      "end_ms": 740010,
      "text": "没有怎么提到你的爸爸"
    },
    {
      "ordinal": 247,
      "start_ms": 740010,
      "end_ms": 741180,
      "text": "所以我不确定啊"
    },
    {
      "ordinal": 248,
      "start_ms": 741180,
      "end_ms": 744530,
      "text": "我不确定呃"
    },
    {
      "ordinal": 249,
      "start_ms": 744530,
      "end_ms": 745979,
      "text": "无论如何"
    },
    {
      "ordinal": 250,
      "start_ms": 747360,
      "end_ms": 749060,
      "text": "你要意识到一件事情"
    },
    {
      "ordinal": 251,
      "start_ms": 749060,
      "end_ms": 751940,
      "text": "你不是孤独的存活在这个世界上的啊"
    },
    {
      "ordinal": 252,
      "start_ms": 751940,
      "end_ms": 754130,
      "text": "你做了很多选择啊"
    },
    {
      "ordinal": 253,
      "start_ms": 754130,
      "end_ms": 754839,
      "text": "是"
    },
    {
      "ordinal": 254,
      "start_ms": 757740,
      "end_ms": 760970,
      "text": "对周围的人造成实质性影响的"
    },
    {
      "ordinal": 255,
      "start_ms": 760970,
      "end_ms": 764260,
      "text": "尤其是你的亲人明白"
    },
    {
      "ordinal": 256,
      "start_ms": 764260,
      "end_ms": 766090,
      "text": "尤其是你的亲人啊"
    },
    {
      "ordinal": 257,
      "start_ms": 766090,
      "end_ms": 771600,
      "text": "所以首先要想一些要对得起你父母"
    },
    {
      "ordinal": 258,
      "start_ms": 771600,
      "end_ms": 773310,
      "text": "对得起你亲人的方式"
    },
    {
      "ordinal": 259,
      "start_ms": 773310,
      "end_ms": 776020,
      "text": "去解决生活当中的一些问题"
    },
    {
      "ordinal": 260,
      "start_ms": 776020,
      "end_ms": 778780,
      "text": "去想要去去设想"
    },
    {
      "ordinal": 261,
      "start_ms": 778900,
      "end_ms": 782980,
      "text": "达成一些大家共识的解决方案啊"
    },
    {
      "ordinal": 262,
      "start_ms": 782980,
      "end_ms": 786010,
      "text": "这种能力就是首先团结的家人"
    },
    {
      "ordinal": 263,
      "start_ms": 786010,
      "end_ms": 788440,
      "text": "只要你的你和你的啊"
    },
    {
      "ordinal": 264,
      "start_ms": 788440,
      "end_ms": 790840,
      "text": "你和你的家人团结起来啊"
    },
    {
      "ordinal": 265,
      "start_ms": 790840,
      "end_ms": 791780,
      "text": "无论如何"
    },
    {
      "ordinal": 266,
      "start_ms": 792520,
      "end_ms": 795360,
      "text": "但团结起来不是说要团结起来对付邻居啊"
    },
    {
      "ordinal": 267,
      "start_ms": 795360,
      "end_ms": 797040,
      "text": "或者团结起来去坑别人啊"
    },
    {
      "ordinal": 268,
      "start_ms": 797040,
      "end_ms": 798090,
      "text": "不是这个意思"
    },
    {
      "ordinal": 269,
      "start_ms": 798090,
      "end_ms": 801240,
      "text": "而是你们相互之间能相互体谅啊"
    },
    {
      "ordinal": 270,
      "start_ms": 801240,
      "end_ms": 805740,
      "text": "能够公允的强者帮弱者多承担一点的啊"
    },
    {
      "ordinal": 271,
      "start_ms": 805740,
      "end_ms": 808620,
      "text": "而且是打配合的这样啊"
    },
    {
      "ordinal": 272,
      "start_ms": 810280,
      "end_ms": 811080,
      "text": "明白吗"
    },
    {
      "ordinal": 273,
      "start_ms": 812280,
      "end_ms": 817420,
      "text": "所以生活啊你妈妈说忆苦思甜"
    },
    {
      "ordinal": 274,
      "start_ms": 817700,
      "end_ms": 821900,
      "text": "我觉得就是说能够一起去忆苦思甜"
    },
    {
      "ordinal": 275,
      "start_ms": 821900,
      "end_ms": 824960,
      "text": "这已经是一种甜了啊"
    },
    {
      "ordinal": 276,
      "start_ms": 824960,
      "end_ms": 826310,
      "text": "你不孤独的吗"
    },
    {
      "ordinal": 277,
      "start_ms": 826310,
      "end_ms": 828080,
      "text": "啊有所陪伴的啊"
    },
    {
      "ordinal": 278,
      "start_ms": 828080,
      "end_ms": 829959,
      "text": "已经是一种幸福了"
    },
    {
      "ordinal": 279,
      "start_ms": 830260,
      "end_ms": 833560,
      "text": "嗯所以我我我我我"
    },
    {
      "ordinal": 280,
      "start_ms": 834760,
      "end_ms": 836640,
      "text": "所以啊我的意思就是说"
    },
    {
      "ordinal": 281,
      "start_ms": 838880,
      "end_ms": 841910,
      "text": "啊一起悲伤"
    },
    {
      "ordinal": 282,
      "start_ms": 841910,
      "end_ms": 846979,
      "text": "其实这已经有有有有一个有一个温馨在里面了"
    },
    {
      "ordinal": 283,
      "start_ms": 847200,
      "end_ms": 850260,
      "text": "不是日文"
    },
    {
      "ordinal": 284,
      "start_ms": 850260,
      "end_ms": 855840,
      "text": "有首歌叫咿呀得得得得得得"
    },
    {
      "ordinal": 285,
      "start_ms": 855840,
      "end_ms": 857700,
      "text": "就是两个人一起哭嘛"
    },
    {
      "ordinal": 286,
      "start_ms": 857700,
      "end_ms": 861860,
      "text": "有首歌那是个情感歌啊"
    },
    {
      "ordinal": 287,
      "start_ms": 861860,
      "end_ms": 865380,
      "text": "那那那那是个那个whatever"
    },
    {
      "ordinal": 288,
      "start_ms": 867720,
      "end_ms": 874819,
      "text": "呃我希望你就是说你能够不要盯着生活的好坏"
    },
    {
      "ordinal": 289,
      "start_ms": 874980,
      "end_ms": 877680,
      "text": "而是要盯着你和你最亲近的人"
    },
    {
      "ordinal": 290,
      "start_ms": 877680,
      "end_ms": 880640,
      "text": "是不是不是大家是自己人"
    },
    {
      "ordinal": 291,
      "start_ms": 881200,
      "end_ms": 883710,
      "text": "这样去看待你的生活啊"
    },
    {
      "ordinal": 292,
      "start_ms": 883710,
      "end_ms": 885240,
      "text": "那个要拧绳啊"
    },
    {
      "ordinal": 293,
      "start_ms": 885240,
      "end_ms": 886980,
      "text": "要抱团啊"
    },
    {
      "ordinal": 294,
      "start_ms": 886980,
      "end_ms": 890240,
      "text": "就尤其是和你的家人啊"
    },
    {
      "ordinal": 295,
      "start_ms": 890240,
      "end_ms": 892460,
      "text": "这这就意味着你就是你的享乐"
    },
    {
      "ordinal": 296,
      "start_ms": 892460,
      "end_ms": 895100,
      "text": "不要陷于自己的一个孤零零的享乐啊"
    },
    {
      "ordinal": 297,
      "start_ms": 895100,
      "end_ms": 896600,
      "text": "一定要玩玩腻了"
    },
    {
      "ordinal": 298,
      "start_ms": 896600,
      "end_ms": 897800,
      "text": "然后我就不玩了"
    },
    {
      "ordinal": 299,
      "start_ms": 897800,
      "end_ms": 898510,
      "text": "不是的"
    },
    {
      "ordinal": 300,
      "start_ms": 898510,
      "end_ms": 901870,
      "text": "而是你会发现和大家一起和你亲近的人"
    },
    {
      "ordinal": 301,
      "start_ms": 901870,
      "end_ms": 905990,
      "text": "一起比你一个人孤立着玩要更有意思"
    },
    {
      "ordinal": 302,
      "start_ms": 905990,
      "end_ms": 907220,
      "text": "要更有意义"
    },
    {
      "ordinal": 303,
      "start_ms": 907220,
      "end_ms": 911650,
      "text": "至少那么先学着做到这一点"
    },
    {
      "ordinal": 304,
      "start_ms": 911650,
      "end_ms": 914740,
      "text": "等到你比较善于做到这一点之后"
    },
    {
      "ordinal": 305,
      "start_ms": 915100,
      "end_ms": 918700,
      "text": "那么你在毕业了之后加入了工作岗位了之后"
    },
    {
      "ordinal": 306,
      "start_ms": 918700,
      "end_ms": 925410,
      "text": "你就会发现和你有同样的命运走向的啊"
    },
    {
      "ordinal": 307,
      "start_ms": 925410,
      "end_ms": 928890,
      "text": "你的兄弟姐妹也是你的工友劳动群"
    },
    {
      "ordinal": 308,
      "start_ms": 930480,
      "end_ms": 933060,
      "text": "如果你将来是个体力无产者的话"
    },
    {
      "ordinal": 309,
      "start_ms": 933060,
      "end_ms": 935280,
      "text": "他也如同像你的家人一样"
    },
    {
      "ordinal": 310,
      "start_ms": 935280,
      "end_ms": 937770,
      "text": "到时候你会因为你在家庭里面"
    },
    {
      "ordinal": 311,
      "start_ms": 937770,
      "end_ms": 939720,
      "text": "你在你自己家庭里面就能做到这些"
    },
    {
      "ordinal": 312,
      "start_ms": 939720,
      "end_ms": 943850,
      "text": "那么你在劳动群众当中啊"
    },
    {
      "ordinal": 313,
      "start_ms": 943850,
      "end_ms": 950420,
      "text": "你就同样可以非常自如的就是大家抱成一团啊"
    },
    {
      "ordinal": 314,
      "start_ms": 950420,
      "end_ms": 953520,
      "text": "联合起来争取自己的力量"
    },
    {
      "ordinal": 315,
      "start_ms": 953520,
      "end_ms": 955200,
      "text": "就是说按照你所说的"
    },
    {
      "ordinal": 316,
      "start_ms": 955200,
      "end_ms": 957600,
      "text": "站在和我站在一个战线上"
    },
    {
      "ordinal": 317,
      "start_ms": 957600,
      "end_ms": 961730,
      "text": "为劳动者的解放斗争而斗争"
    },
    {
      "ordinal": 318,
      "start_ms": 961730,
      "end_ms": 965750,
      "text": "那么要让大家为劳动者的解放斗争呢"
    },
    {
      "ordinal": 319,
      "start_ms": 965750,
      "end_ms": 972180,
      "text": "首先要作为劳动者和劳动者团结在一起对吧"
    },
    {
      "ordinal": 320,
      "start_ms": 972180,
      "end_ms": 974730,
      "text": "要有清源的纽带啊"
    },
    {
      "ordinal": 321,
      "start_ms": 974730,
      "end_ms": 978060,
      "text": "一种亲近的亲密的纽带啊"
    },
    {
      "ordinal": 322,
      "start_ms": 978060,
      "end_ms": 979050,
      "text": "那个团结在一起"
    },
    {
      "ordinal": 323,
      "start_ms": 979050,
      "end_ms": 981859,
      "text": "那么这个"
    },
    {
      "ordinal": 324,
      "start_ms": 983880,
      "end_ms": 987699,
      "text": "我不是说把你的家庭作为一个练兵场"
    },
    {
      "ordinal": 325,
      "start_ms": 987860,
      "end_ms": 990980,
      "text": "而作为一个新手村去练这个能力"
    },
    {
      "ordinal": 326,
      "start_ms": 990980,
      "end_ms": 991700,
      "text": "不是这样的"
    },
    {
      "ordinal": 327,
      "start_ms": 991700,
      "end_ms": 992570,
      "text": "不是这个意思"
    },
    {
      "ordinal": 328,
      "start_ms": 992570,
      "end_ms": 994280,
      "text": "明白不是这个意思"
    },
    {
      "ordinal": 329,
      "start_ms": 994280,
      "end_ms": 995180,
      "text": "我的意思就是说"
    },
    {
      "ordinal": 330,
      "start_ms": 995180,
      "end_ms": 996380,
      "text": "无论在哪里"
    },
    {
      "ordinal": 331,
      "start_ms": 996600,
      "end_ms": 999300,
      "text": "有同样的命运"
    },
    {
      "ordinal": 332,
      "start_ms": 999300,
      "end_ms": 1003200,
      "text": "有同样的这个休戚与共的关系的人"
    },
    {
      "ordinal": 333,
      "start_ms": 1003200,
      "end_ms": 1006180,
      "text": "就应当团结啊"
    },
    {
      "ordinal": 334,
      "start_ms": 1009120,
      "end_ms": 1011000,
      "text": "当然再加上亲上加亲的"
    },
    {
      "ordinal": 335,
      "start_ms": 1011000,
      "end_ms": 1012680,
      "text": "那你父母他对你有恩情"
    },
    {
      "ordinal": 336,
      "start_ms": 1012680,
      "end_ms": 1013979,
      "text": "对不对啊"
    },
    {
      "ordinal": 337,
      "start_ms": 1014200,
      "end_ms": 1015220,
      "text": "他们的矛盾"
    },
    {
      "ordinal": 338,
      "start_ms": 1015220,
      "end_ms": 1017500,
      "text": "我说老一代人很多矛盾产生"
    },
    {
      "ordinal": 339,
      "start_ms": 1017500,
      "end_ms": 1019620,
      "text": "那是有有他的现实原因"
    },
    {
      "ordinal": 340,
      "start_ms": 1019620,
      "end_ms": 1020580,
      "text": "有它的历史背景"
    },
    {
      "ordinal": 341,
      "start_ms": 1020580,
      "end_ms": 1021780,
      "text": "也有他自己不成熟"
    },
    {
      "ordinal": 342,
      "start_ms": 1021780,
      "end_ms": 1023580,
      "text": "也有他自己的一些主观的恶了"
    },
    {
      "ordinal": 343,
      "start_ms": 1023580,
      "end_ms": 1024050,
      "text": "对不对"
    },
    {
      "ordinal": 344,
      "start_ms": 1024050,
      "end_ms": 1025910,
      "text": "但这个具体问题具体分析"
    },
    {
      "ordinal": 345,
      "start_ms": 1025910,
      "end_ms": 1026630,
      "text": "我不是很了解"
    },
    {
      "ordinal": 346,
      "start_ms": 1026630,
      "end_ms": 1028190,
      "text": "你心里面也没写啊"
    },
    {
      "ordinal": 347,
      "start_ms": 1028190,
      "end_ms": 1030098,
      "text": "你自己去思考啊"
    },
    {
      "ordinal": 348,
      "start_ms": 1033099,
      "end_ms": 1034500,
      "text": "啊对于你本人的话"
    },
    {
      "ordinal": 349,
      "start_ms": 1034500,
      "end_ms": 1040319,
      "text": "我就祝愿你在这个3年在学习过程当中啊"
    },
    {
      "ordinal": 350,
      "start_ms": 1040740,
      "end_ms": 1045690,
      "text": "学习过程当中能够顺利掌握劳动技能啊"
    },
    {
      "ordinal": 351,
      "start_ms": 1045690,
      "end_ms": 1046460,
      "text": "能够"
    },
    {
      "ordinal": 352,
      "start_ms": 1048319,
      "end_ms": 1050710,
      "text": "圆满完成学业啊"
    },
    {
      "ordinal": 353,
      "start_ms": 1050710,
      "end_ms": 1053340,
      "text": "获得这个劳动资格"
    },
    {
      "ordinal": 354,
      "start_ms": 1055680,
      "end_ms": 1060120,
      "text": "能够出色的啊参与劳动"
    },
    {
      "ordinal": 355,
      "start_ms": 1060120,
      "end_ms": 1061950,
      "text": "参与工作啊"
    },
    {
      "ordinal": 356,
      "start_ms": 1061950,
      "end_ms": 1063750,
      "text": "有出色的表现"
    },
    {
      "ordinal": 357,
      "start_ms": 1063750,
      "end_ms": 1069160,
      "text": "然后还能够啊有力的坚定的团结众人啊"
    },
    {
      "ordinal": 358,
      "start_ms": 1069160,
      "end_ms": 1074520,
      "text": "维护啊劳动者的切身利益和长远利益"
    },
    {
      "ordinal": 359,
      "start_ms": 1074520,
      "end_ms": 1075000,
      "text": "好吧"
    },
    {
      "ordinal": 360,
      "start_ms": 1075000,
      "end_ms": 1076140,
      "text": "那我就讲到这边啊"
