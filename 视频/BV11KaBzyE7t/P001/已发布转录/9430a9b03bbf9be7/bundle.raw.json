{"segments":[{"start":2.46,"end":4.86,"text":"今天要讲这个主题叫重复是吧"},{"start":4.86,"end":6.46,"text":"能再录一遍吧"},{"start":7.5,"end":10.62,"text":"或者我们说他就是作为重复的哲学"},{"start":12.18,"end":13.1,"text":"有人告诉我"},{"start":13.1,"end":16.42,"text":"就是说哲学里面"},{"start":19.4,"end":22.5,"text":"都是全新的突破性的智慧嘛"},{"start":22.5,"end":25.4,"text":"那我们也梳理了哲学史的脉络"},{"start":25.98,"end":31.48,"text":"它里面充满了大量的重复的那些论题"},{"start":31.48,"end":36.13,"text":"反复出现在上千年里"},{"start":36.13,"end":40.67,"text":"困扰人类思维的误区反复被澄清"},{"start":41.359,"end":44.159,"text":"一些我们所谓的二流哲学"},{"start":44.159,"end":45.399,"text":"垃圾哲学"},{"start":45.399,"end":46.139,"text":"举个例子"},{"start":46.139,"end":47.74,"text":"比如说"},{"start":48.56,"end":50.48,"text":"新康德主义"},{"start":55.54,"end":58.74,"text":"啊人家说什么新黑格尔主义"},{"start":63.419,"end":69.52,"text":"啊再比如说什么哎呀大家都知道的一些"},{"start":70.96,"end":72.4,"text":"实证主义哲学"},{"start":72.4,"end":74.44,"text":"新实证主义还有什么"},{"start":74.44,"end":79.65,"text":"最现在最典型的就是什么新时代论或者叫批判时代论"},{"start":83.76,"end":90.12,"text":"这些哲学呢总体上都是相当于你可以理解成"},{"start":90.12,"end":93.34,"text":"就是说次一等的智力的蠢人啊"},{"start":93.34,"end":96.66,"text":"他没有跟得上哲学史的激烈进步"},{"start":96.66,"end":98.54,"text":"他对于同时代的"},{"start":98.54,"end":103.48,"text":"或者说上一时代的重要的标志性的哲学家的问题与论点"},{"start":103.48,"end":105.46,"text":"没有切中没有理解"},{"start":105.66,"end":108.6,"text":"他依然是带着庸人的步伐"},{"start":108.6,"end":112.98,"text":"把上一个世代停留在拥鉴当中的那些问题"},{"start":114.54,"end":118.9,"text":"进一步讨论的哲学当中是充满了这样重复的"},{"start":118.9,"end":127.53,"text":"那么突破性的哲学是对哲学本身当中庸俗的重复进行了戳穿啊"},{"start":127.53,"end":129.255,"text":"戳破啧"},{"start":130.13,"end":130.889,"text":"戳怎么写"},{"start":131.89,"end":134.9,"text":"花点英语的热"},{"start":138.18,"end":142.54,"text":"就是那个戳穿戳破好多哲学家都是这个"},{"start":142.54,"end":143.9,"text":"比如说新唐德主义"},{"start":143.9,"end":147.12,"text":"还有人把戳破了冲掉了"},{"start":147.32,"end":152.48,"text":"那个时候占统治地位的是一些我名字都记不得的一些哲学家"},{"start":152.48,"end":154.56,"text":"所谓的哲学家啊"},{"start":156.12,"end":159.12,"text":"那比如说批判实在论实际上是很挫的"},{"start":159.12,"end":161.41,"text":"很臭的一个东西啊"},{"start":161.41,"end":163.65,"text":"说齐泽克对他进行了超越吗"},{"start":163.65,"end":166.12,"text":"不确定我能理解啊"},{"start":166.12,"end":171.07,"text":"有大量的作为智性上的失败啊"},{"start":171.07,"end":173.49,"text":"止足不前的哲学"},{"start":173.49,"end":177.589,"text":"他在历史当中仅仅是作为无聊的复回想"},{"start":177.589,"end":179.109,"text":"它体现了一个什么呢"},{"start":179.109,"end":182.389,"text":"体现了人类致敬在统治的常态"},{"start":182.389,"end":186.269,"text":"这些哲学我们叫做统治的常态哲学"},{"start":189.14,"end":191.28,"text":"他呼应的是统治的常态"},{"start":191.28,"end":193.74,"text":"下面折磨人口"},{"start":193.74,"end":197.829,"text":"折磨着这些人口心智的结构性的问题"},{"start":198.33,"end":203.29,"text":"然后都得到的是一些缝合的敷衍性的回答"},{"start":204.5,"end":208.34,"text":"哎呀比如说新黑白主义里面有一个是什么"},{"start":208.34,"end":212.62,"text":"用关系来代替实体啊"},{"start":212.62,"end":215.1,"text":"把所有东西都理解成是关系"},{"start":215.1,"end":217.12,"text":"然后用很蹩脚的一些"},{"start":217.12,"end":219.9,"text":"因为新黑格尔为其实是不懂黑格尔"},{"start":219.9,"end":224.52,"text":"他是啊剑桥还是反正英国的一些哲学家"},{"start":224.52,"end":225.75,"text":"他用这个"},{"start":225.75,"end":231.27,"text":"他们对于黑格尔逻辑学的理解也就停留在那个本质论的那种阶段啊"},{"start":231.27,"end":233.33,"text":"又很憋着的嗯"},{"start":233.33,"end":234.63,"text":"所谓的辩证逻辑"},{"start":234.63,"end":238.34,"text":"然后去构建一个知识谱系"},{"start":238.34,"end":240.62,"text":"所以他完全错失了黑格尔主义的"},{"start":240.62,"end":245.68,"text":"他的长远的人类命运的一些讨论"},{"start":246.9,"end":248.54,"text":"叫布拉德雷还叫啥了"},{"start":248.54,"end":250.94,"text":"就搞了一种"},{"start":255.599,"end":263.09,"text":"然后用一些关系性的或类位置逻辑的一些东西来来思考现实"},{"start":263.09,"end":267.17,"text":"整个的是根本没有切中黑格尔的辩证法"},{"start":269.18,"end":273.49,"text":"这些哲学在观念当中"},{"start":273.49,"end":275.77,"text":"其实他们是什么"},{"start":276.77,"end":277.93,"text":"我们就更不要说了"},{"start":277.93,"end":279.95,"text":"比如说那个什么"},{"start":279.95,"end":283.01,"text":"还有很典型的是要素论"},{"start":284.66,"end":286.58,"text":"一元论要素论"},{"start":286.58,"end":288.54,"text":"这个是列宁的靶子"},{"start":288.54,"end":289.3,"text":"对不对"},{"start":289.3,"end":291.46,"text":"列宁就是劈大树"},{"start":291.96,"end":294.16,"text":"马赫的阿森纳"},{"start":294.16,"end":297.45,"text":"留斯的要素论"},{"start":297.45,"end":299.25,"text":"这些哲学在思维中"},{"start":299.25,"end":303.51,"text":"在观念中它具有一种廉价的总体性"},{"start":303.99,"end":306.27,"text":"嗯他不能停留在哲学"},{"start":307.43,"end":311.64,"text":"这个就是我们要说的另外一个啊"},{"start":311.64,"end":318.66,"text":"作为虚假合并的常态革命的常态化的革命"},{"start":318.66,"end":319.46,"text":"往危机化"},{"start":319.46,"end":323.45,"text":"常态化危机的一种哲学当中的重复"},{"start":323.89,"end":325.33,"text":"他的靶子是什么呢"},{"start":325.33,"end":326.71,"text":"是胡塞尔现象学"},{"start":326.71,"end":328.69,"text":"或者说在场形而上学"},{"start":328.69,"end":330.33,"text":"后现代集中批的"},{"start":330.33,"end":332.29,"text":"在场形而上学"},{"start":336.7,"end":342.14,"text":"他主靶子主要的靶子主要靶子是胡塞尔的"},{"start":343.2,"end":343.92,"text":"罗纳尔学学"},{"start":343.92,"end":345.68,"text":"我们之前讲过了那个现象"},{"start":345.68,"end":348.6,"text":"学院那个图样大家都知道"},{"start":355.34,"end":360.14,"text":"或者我们叫叫叫罗格斯中心主义"},{"start":372.76,"end":374.8,"text":"从海德格尔开始就已经批这个东西了"},{"start":374.8,"end":377.89,"text":"一代又一代的所谓的后现代哲学家啊"},{"start":377.89,"end":379.21,"text":"不是后现代主义啊"},{"start":379.21,"end":382.95,"text":"后现代的哲学家一直在批所谓在长相而上学"},{"start":382.95,"end":383.93,"text":"批了几十年"},{"start":383.93,"end":384.85,"text":"上百年了"},{"start":384.85,"end":386.57,"text":"还在有开始"},{"start":388.4,"end":391.29,"text":"奶妈得了字也批过啊"},{"start":391.29,"end":393.09,"text":"那个什么狗屁呃"},{"start":393.09,"end":396.14,"text":"这个什么德里达也系这东西"},{"start":396.14,"end":398.7,"text":"它就形成一种新的常态"},{"start":398.7,"end":401.18,"text":"每一个法国的"},{"start":401.18,"end":405.81,"text":"德国的这种啊青年的有巨大野心的责任"},{"start":405.81,"end":409.01,"text":"都要去攻击信仰学体系"},{"start":409.01,"end":411.47,"text":"要去攻击这个在长年上学体系"},{"start":411.47,"end":415.07,"text":"然后呢呃在这个攻击过程当中"},{"start":415.07,"end":420.729,"text":"把德国关键论也临时的制造成打包成这样的东西"},{"start":420.729,"end":424.42,"text":"其实第一个做这种事情的是什么"},{"start":427.56,"end":431.76,"text":"马克思啊就是引入意识性的引入"},{"start":431.76,"end":435.26,"text":"超出这个呃在场想要上学"},{"start":435.26,"end":438.2,"text":"在场的想要上学啊"},{"start":438.96,"end":442.06,"text":"现在当下县城将要上学"},{"start":442.06,"end":443.96,"text":"在海子哥那边"},{"start":443.96,"end":447.99,"text":"他就开始批判这个现成性"},{"start":448.09,"end":453.33,"text":"那么在马克思里批判形而上学和金泰的将死的"},{"start":453.42,"end":458.1,"text":"那后面一票这些哲学家都开始怎么样"},{"start":458.1,"end":460.76,"text":"不是把哲学作为革命的预备"},{"start":460.76,"end":463.98,"text":"而是把哲学作为革命本身"},{"start":466.62,"end":470.74,"text":"所有后现代哲学的这个赘生物"},{"start":470.74,"end":475.16,"text":"都是开始把哲学自己啊"},{"start":475.16,"end":476.88,"text":"观念上的这些挑衅呀"},{"start":476.88,"end":481.409,"text":"还有对于既有这些建筑的这个摧毁当成是一种革命"},{"start":481.409,"end":484.509,"text":"而事实上呢没有变成隔壁"},{"start":484.509,"end":488.93,"text":"而是变成什么时尚变成一种风尚啊"},{"start":488.93,"end":490.49,"text":"这就是时尚"},{"start":493.08,"end":497.16,"text":"那就说时尚和革命就一定是对立的关系吗"},{"start":497.47,"end":500.41,"text":"不是时尚是革命的子集"},{"start":500.41,"end":502.07,"text":"革命一定会带来时尚"},{"start":503.07,"end":505.12,"text":"所有革命一定会带来时尚"},{"start":505.12,"end":510.18,"text":"意味着对于青年的新生代的生活方式的强大吸引力"},{"start":510.18,"end":512.5,"text":"但是光有时尚是革命吗"},{"start":512.5,"end":515.34,"text":"当然不是新的生活方式"},{"start":515.34,"end":516.559,"text":"有速朽的"},{"start":516.559,"end":518.059,"text":"有只能维持几年的"},{"start":518.059,"end":520.5,"text":"有作为快餐的"},{"start":520.5,"end":522.12,"text":"作为一时享乐的"},{"start":522.12,"end":525.02,"text":"他不一定能够具有终身性"},{"start":525.02,"end":526.64,"text":"就算具有终身性"},{"start":526.64,"end":528.82,"text":"它也会变成亚文化"},{"start":528.82,"end":532.319,"text":"变成一个市民社会享乐的分支"},{"start":533.599,"end":536.199,"text":"所以革命意味着一种"},{"start":538.86,"end":540.44,"text":"具有统治力的时尚"},{"start":540.44,"end":542.7,"text":"并且是不会迭代的"},{"start":542.7,"end":547.68,"text":"并且是深入渗透到基本的生产关系当中"},{"start":547.68,"end":549.36,"text":"取得市场风尚"},{"start":550.44,"end":552.7,"text":"否则革命就是什么"},{"start":552.7,"end":557.1,"text":"我的革命就是阿Q脑子里幻想的白衣白甲"},{"start":557.1,"end":558.44,"text":"天兵天将"},{"start":558.44,"end":559.82,"text":"革命来啦"},{"start":559.82,"end":561.92,"text":"运动来了"},{"start":564.8,"end":569.0,"text":"但是呢在后现代我是说在很多你这这个风向来"},{"start":569.0,"end":572.45,"text":"在革命年代就已经开始显现出来了啊"},{"start":572.77,"end":577.17,"text":"奥地利的说德语的所谓的马克思主义者"},{"start":577.17,"end":581.38,"text":"他们就已经开始把马克思的哲学啊"},{"start":581.38,"end":588.35,"text":"或者说革命理论转变成一种哎呀部长有利于候选人啊"},{"start":588.35,"end":594.25,"text":"议员代表或者他们的子女在咖啡馆沙龙里面的侃侃而谈"},{"start":594.25,"end":597.69,"text":"变成知识分子争先体现自己的先锋性"},{"start":597.69,"end":602.21,"text":"自己的未来性的一种秀啊"},{"start":602.21,"end":603.19,"text":"一种表演"},{"start":603.19,"end":606.05,"text":"他这样做的目的是什么呢"},{"start":610.34,"end":611.14,"text":"不知道啊"},{"start":611.14,"end":614.62,"text":"就是让他们在他们的贵族世系"},{"start":614.62,"end":616.96,"text":"封建王权面前"},{"start":617.32,"end":618.8,"text":"它具有被收买价值"},{"start":619.92,"end":621.84,"text":"他是个严肃的坏孩子"},{"start":621.84,"end":623.98,"text":"这怎么去啊"},{"start":623.98,"end":626.61,"text":"让他们的父母感到真正的痛苦"},{"start":627.66,"end":630.79,"text":"所以他们最后是走向了软弱的道路"},{"start":631.07,"end":633.59,"text":"他们在这个苏俄以后"},{"start":633.59,"end":638.43,"text":"来苏联提倡的美学是一种古典主义重复人理解学"},{"start":638.99,"end":644.63,"text":"所以就文艺复兴还包括这个理性主义时代的重复"},{"start":644.71,"end":651.99,"text":"他们审慎地退回到了革命尚未发生的哲学"},{"start":651.99,"end":656.89,"text":"处在一个宁静安定状态下的美学风尚"},{"start":656.89,"end":658.63,"text":"并且更进一步"},{"start":658.63,"end":660.87,"text":"他们的哲学怎么样"},{"start":663.76,"end":666.48,"text":"也退回到了前康德的独断论"},{"start":667.76,"end":673.59,"text":"退回到类似啊这种什么洛克嘛"},{"start":673.59,"end":675.23,"text":"就美英国的经验主义"},{"start":675.23,"end":682.26,"text":"或者说法国的这个实证主义的那样一种前杠和前关键认的"},{"start":682.86,"end":689.06,"text":"所以这里有一个真正重复的意义是什么"},{"start":692.66,"end":694.76,"text":"哲革命者像列宁"},{"start":694.76,"end":695.78,"text":"像斯大林这种人"},{"start":696.94,"end":699.5,"text":"他们明知道自己的这个"},{"start":701.06,"end":704.32,"text":"所见过的教科书的哲学体系会是愚蠢的"},{"start":704.32,"end":706.02,"text":"会是缺乏吸引力的"},{"start":706.02,"end":707.26,"text":"不够先锋的"},{"start":707.26,"end":708.74,"text":"会十分积极性的"},{"start":708.74,"end":713.16,"text":"但是它是一种重失败的呃"},{"start":713.16,"end":714.88,"text":"是对于"},{"start":718.92,"end":720.32,"text":"权力斗争的重复啊"},{"start":720.32,"end":722.32,"text":"或者说换言之就是现实的重复"},{"start":723.48,"end":727.77,"text":"通过教育来模拟雨水的惰性的现实"},{"start":729.5,"end":730.84,"text":"在这个上讲"},{"start":730.84,"end":734.72,"text":"哲学教育只要领先现实一步就可以了"},{"start":734.72,"end":736.94,"text":"领先的这一步"},{"start":738.25,"end":743.06,"text":"是让你获得针对那些更为惰性的部落名"},{"start":743.06,"end":745.38,"text":"还有有什么农奴残余啊"},{"start":745.38,"end":747.34,"text":"反正他的那些少数民族"},{"start":747.34,"end":751.1,"text":"还有加盟共和国里面的那些具体社会实际情况"},{"start":752.19,"end":756.27,"text":"他是对于现实权利格局的一个重复"},{"start":757.4,"end":761.6,"text":"哲学是对于当时的苏联或者说俄国"},{"start":761.6,"end":766.77,"text":"他的现实权力土壤的状况的一个勾勒"},{"start":766.77,"end":770.65,"text":"那我们今天并不是说要对这些垃圾哲学做辩护啊"},{"start":770.65,"end":777.67,"text":"说哲学的重复它具有这个现实的深刻的社会和权力根源啊"},{"start":777.67,"end":782.38,"text":"所以他的重复会有很愚蠢的东西在重复嗯"},{"start":782.38,"end":783.88,"text":"但是我们已经说了"},{"start":783.88,"end":788.32,"text":"人家花了这个接近这个一半课堂时间"},{"start":788.32,"end":791.45,"text":"把上一讲要讲的东西重新讲一遍"},{"start":791.67,"end":796.48,"text":"那么重复在这里就感受到上一讲是用什么"},{"start":796.48,"end":797.4,"text":"用爱欲"},{"start":797.4,"end":797.78,"text":"对不对"},{"start":797.78,"end":799.98,"text":"用享乐再给你们点明这一点"},{"start":799.98,"end":801.64,"text":"今天是一个重复"},{"start":801.64,"end":803.96,"text":"给垃圾东西做辩护"},{"start":804.699,"end":806.099,"text":"也符合今天的主题"},{"start":808.699,"end":810.179,"text":"那我们进进一步要讲"},{"start":810.179,"end":813.58,"text":"就是说在这个背景之下"},{"start":813.58,"end":817.66,"text":"我们看到了哲学所特有的一种什么性质啊"},{"start":820.84,"end":822.42,"text":"他应对于享乐"},{"start":822.42,"end":826.32,"text":"还有一个特定的功能是什么呢"},{"start":832.98,"end":839.58,"text":"无聊order哲学可以用来生产无聊"},{"start":843.0,"end":847.72,"text":"那就是对上一讲的补充哲学历来被人类当成是繁琐的"},{"start":847.72,"end":849.19,"text":"复杂的"},{"start":849.59,"end":852.47,"text":"冰冷的无聊的建筑"},{"start":853.32,"end":855.2,"text":"这是对于喜爱哲学的人来讲"},{"start":855.2,"end":856.68,"text":"意味着激情"},{"start":856.68,"end":860.32,"text":"对意味着这个致敬上的挑战啊"},{"start":860.32,"end