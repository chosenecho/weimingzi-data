{
  "bvid": "BV1Hv4y197BN",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "f65c8f9aa8168ea47048157ad839bb885642d8179b7eb3a36004cf5b78ad752b",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 0,
      "end_ms": 2760,
      "text": "啊这个家伙还竟然嘴巴拳手"
    },
    {
      "ordinal": 1,
      "start_ms": 2760,
      "end_ms": 7180,
      "text": "给这个给这个实践王者下指导棋啊"
    },
    {
      "ordinal": 2,
      "start_ms": 12460,
      "end_ms": 13260,
      "text": "好吧"
    },
    {
      "ordinal": 3,
      "start_ms": 18200,
      "end_ms": 20300,
      "text": "呃说这是我的原话"
    },
    {
      "ordinal": 4,
      "start_ms": 21740,
      "end_ms": 25070,
      "text": "而且他的组织保密程度必须比黑帮还要严格"
    },
    {
      "ordinal": 5,
      "start_ms": 25070,
      "end_ms": 27520,
      "text": "否则根本幸存不下来啊"
    },
    {
      "ordinal": 6,
      "start_ms": 27520,
      "end_ms": 28330,
      "text": "说什么"
    },
    {
      "ordinal": 7,
      "start_ms": 28330,
      "end_ms": 30720,
      "text": "然后他说他说他甚至不知道"
    },
    {
      "ordinal": 8,
      "start_ms": 30720,
      "end_ms": 32880,
      "text": "布尔什维克及其前身有个很长的时间"
    },
    {
      "ordinal": 9,
      "start_ms": 32880,
      "end_ms": 34140,
      "text": "就是在这也没有"
    },
    {
      "ordinal": 10,
      "start_ms": 34140,
      "end_ms": 34920,
      "text": "那也没有情况下"
    },
    {
      "ordinal": 11,
      "start_ms": 36000,
      "end_ms": 39910,
      "text": "以及领导工人的日常经济斗争中发展起来"
    },
    {
      "ordinal": 12,
      "start_ms": 42520,
      "end_ms": 47310,
      "text": "谁有领导工人的日常经济斗争的团团伙团体"
    },
    {
      "ordinal": 13,
      "start_ms": 47310,
      "end_ms": 49200,
      "text": "我有你有没有"
    },
    {
      "ordinal": 14,
      "start_ms": 49200,
      "end_ms": 50940,
      "text": "i have do you have"
    },
    {
      "ordinal": 15,
      "start_ms": 51160,
      "end_ms": 54400,
      "text": "我有你有没有我再唱一遍"
    },
    {
      "ordinal": 16,
      "start_ms": 54400,
      "end_ms": 56480,
      "text": "我有你有没有"
    },
    {
      "ordinal": 17,
      "start_ms": 56880,
      "end_ms": 57660,
      "text": "这个话"
    },
    {
      "ordinal": 18,
      "start_ms": 57660,
      "end_ms": 58500,
      "text": "我再问一句"
    },
    {
      "ordinal": 19,
      "start_ms": 58500,
      "end_ms": 60660,
      "text": "我有数十人"
    },
    {
      "ordinal": 20,
      "start_ms": 60660,
      "end_ms": 61800,
      "text": "你有没有"
    },
    {
      "ordinal": 21,
      "start_ms": 63180,
      "end_ms": 66260,
      "text": "我有你有没有再问一遍"
    },
    {
      "ordinal": 22,
      "start_ms": 66260,
      "end_ms": 68360,
      "text": "现在你就不要抽自己耳光了"
    },
    {
      "ordinal": 23,
      "start_ms": 68360,
      "end_ms": 69620,
      "text": "你再问一问自己"
    },
    {
      "ordinal": 24,
      "start_ms": 69620,
      "end_ms": 72350,
      "text": "你有没有再问一下你有没有"
    },
    {
      "ordinal": 25,
      "start_ms": 82500,
      "end_ms": 84340,
      "text": "我们成员很多就是工人"
    },
    {
      "ordinal": 26,
      "start_ms": 85280,
      "end_ms": 88240,
      "text": "我们不需要额外的在我们小组之外去领导他们"
    },
    {
      "ordinal": 27,
      "start_ms": 88240,
      "end_ms": 89860,
      "text": "我们只要说我们自己商量着来"
    },
    {
      "ordinal": 28,
      "start_ms": 89860,
      "end_ms": 92650,
      "text": "我们自己领导我们自己就行了"
    },
    {
      "ordinal": 29,
      "start_ms": 94200,
      "end_ms": 95040,
      "text": "自己"
    },
    {
      "ordinal": 30,
      "start_ms": 95040,
      "end_ms": 98759,
      "text": "就是说在厂里面想办法改善自己的劳动地位"
    },
    {
      "ordinal": 31,
      "start_ms": 98760,
      "end_ms": 100080,
      "text": "我有你有没有"
    },
    {
      "ordinal": 32,
      "start_ms": 100080,
      "end_ms": 100950,
      "text": "我再问一遍"
    },
    {
      "ordinal": 33,
      "start_ms": 100950,
      "end_ms": 103840,
      "text": "我有你有没有啊"
    },
    {
      "ordinal": 34,
      "start_ms": 105060,
      "end_ms": 106640,
      "text": "由于超阶级的国家观"
    },
    {
      "ordinal": 35,
      "start_ms": 106640,
      "end_ms": 109170,
      "text": "我从来没有超阶级的国家观"
    },
    {
      "ordinal": 36,
      "start_ms": 109170,
      "end_ms": 111450,
      "text": "他使他根本无法认识到当前的情况"
    },
    {
      "ordinal": 37,
      "start_ms": 111450,
      "end_ms": 113670,
      "text": "我天天在认识当前的情况"
    },
    {
      "ordinal": 38,
      "start_ms": 113670,
      "end_ms": 116360,
      "text": "我们我的羽翼"
    },
    {
      "ordinal": 39,
      "start_ms": 118980,
      "end_ms": 121460,
      "text": "我说对布尔什维克发展历史"
    },
    {
      "ordinal": 40,
      "start_ms": 123320,
      "end_ms": 125300,
      "text": "由于什么既想成为一个人物"
    },
    {
      "ordinal": 41,
      "start_ms": 125300,
      "end_ms": 126789,
      "text": "又不想承担任何风险"
    },
    {
      "ordinal": 42,
      "start_ms": 126789,
      "end_ms": 130030,
      "text": "这个话我我你你你承担任何风险了吗"
    },
    {
      "ordinal": 43,
      "start_ms": 130030,
      "end_ms": 132850,
      "text": "我有你有没有你承担任何风险吗"
    },
    {
      "ordinal": 44,
      "start_ms": 132850,
      "end_ms": 134560,
      "text": "我有你有没有"
    },
    {
      "ordinal": 45,
      "start_ms": 134560,
      "end_ms": 135790,
      "text": "于是他又创造"
    },
    {
      "ordinal": 46,
      "start_ms": 135790,
      "end_ms": 138080,
      "text": "现在提出了全公开的组织策略"
    },
    {
      "ordinal": 47,
      "start_ms": 138119,
      "end_ms": 139619,
      "text": "我的组织全公开吗"
    },
    {
      "ordinal": 48,
      "start_ms": 139619,
      "end_ms": 142979,
      "text": "你知道你知道我手下的人姓甚名谁吗"
    },
    {
      "ordinal": 49,
      "start_ms": 142979,
      "end_ms": 144720,
      "text": "你知道他们在哪里活动吗"
    },
    {
      "ordinal": 50,
      "start_ms": 145520,
      "end_ms": 146980,
      "text": "我的组织全公开吗"
    },
    {
      "ordinal": 51,
      "start_ms": 146980,
      "end_ms": 148640,
      "text": "我的组织策略全公开吗"
    },
    {
      "ordinal": 52,
      "start_ms": 152059,
      "end_ms": 152719,
      "text": "为什么不能公开"
    },
    {
      "ordinal": 53,
      "start_ms": 158119,
      "end_ms": 161000,
      "text": "公开的宣称你的一些钱账目"
    },
    {
      "ordinal": 54,
      "start_ms": 162619,
      "end_ms": 165440,
      "text": "我没有叫你公开你在地下活动啊"
    },
    {
      "ordinal": 55,
      "start_ms": 167339,
      "end_ms": 169579,
      "text": "说稍微有点国际工业史"
    },
    {
      "ordinal": 56,
      "start_ms": 169579,
      "end_ms": 171540,
      "text": "这是一个叛徒式的组织策略"
    },
    {
      "ordinal": 57,
      "start_ms": 173939,
      "end_ms": 175729,
      "text": "我背叛我自己了"
    },
    {
      "ordinal": 58,
      "start_ms": 175729,
      "end_ms": 177139,
      "text": "我背叛我自己了"
    },
    {
      "ordinal": 59,
      "start_ms": 177139,
      "end_ms": 178620,
      "text": "按照这个说法的话"
    },
    {
      "ordinal": 60,
      "start_ms": 178720,
      "end_ms": 180640,
      "text": "我要把我自己私下里"
    },
    {
      "ordinal": 61,
      "start_ms": 180640,
      "end_ms": 183640,
      "text": "我吃饭拉屎撒尿这些东西都公开"
    },
    {
      "ordinal": 62,
      "start_ms": 185200,
      "end_ms": 186260,
      "text": "我会坐牢的"
    },
    {
      "ordinal": 63,
      "start_ms": 193900,
      "end_ms": 195820,
      "text": "指导创造公开和秘密结合的"
    },
    {
      "ordinal": 64,
      "start_ms": 195820,
      "end_ms": 198120,
      "text": "你也知道公开和秘密结合的工作方式啊"
    },
    {
      "ordinal": 65,
      "start_ms": 198120,
      "end_ms": 200670,
      "text": "你也知道公开和秘密结合的工作方式啊"
    },
    {
      "ordinal": 66,
      "start_ms": 200670,
      "end_ms": 202560,
      "text": "那你为什么指责我全是公开呢"
    },
    {
      "ordinal": 67,
      "start_ms": 202560,
      "end_ms": 204200,
      "text": "你知道我哪些秘密吗"
    },
    {
      "ordinal": 68,
      "start_ms": 204239,
      "end_ms": 207539,
      "text": "你就说你不能因为你不知道我的秘密"
    },
    {
      "ordinal": 69,
      "start_ms": 207539,
      "end_ms": 208920,
      "text": "就说我没有秘密"
    },
    {
      "ordinal": 70,
      "start_ms": 209179,
      "end_ms": 212920,
      "text": "我也我也从来没有说向别人公开他的秘密啊"
    },
    {
      "ordinal": 71,
      "start_ms": 214339,
      "end_ms": 215139,
      "text": "对不对"
    },
    {
      "ordinal": 72,
      "start_ms": 215139,
      "end_ms": 216639,
      "text": "我对于杨和平"
    },
    {
      "ordinal": 73,
      "start_ms": 216639,
      "end_ms": 219099,
      "text": "对于这个这个刘海庆的要求"
    },
    {
      "ordinal": 74,
      "start_ms": 219099,
      "end_ms": 220419,
      "text": "就是说你不能公开的话"
    },
    {
      "ordinal": 75,
      "start_ms": 220419,
      "end_ms": 221559,
      "text": "你不要公开你私下"
    },
    {
      "ordinal": 76,
      "start_ms": 221559,
      "end_ms": 223620,
      "text": "你们对私下里你们是自己人"
    },
    {
      "ordinal": 77,
      "start_ms": 223620,
      "end_ms": 224880,
      "text": "你们对就行了"
    },
    {
      "ordinal": 78,
      "start_ms": 224880,
      "end_ms": 227400,
      "text": "你们把他对账对清楚就可以了"
    },
    {
      "ordinal": 79,
      "start_ms": 230010,
      "end_ms": 231700,
      "text": "相互之间互相信任"
    },
    {
      "ordinal": 80,
      "start_ms": 233160,
      "end_ms": 235730,
      "text": "我从来都是说公开和秘密要结合"
    },
    {
      "ordinal": 81,
      "start_ms": 235730,
      "end_ms": 236660,
      "text": "我说的公开"
    },
    {
      "ordinal": 82,
      "start_ms": 236660,
      "end_ms": 237920,
      "text": "就是说你的名义要公开"
    },
    {
      "ordinal": 83,
      "start_ms": 239320,
      "end_ms": 240100,
      "text": "我说说公开"
    },
    {
      "ordinal": 84,
      "start_ms": 240100,
      "end_ms": 242260,
      "text": "你就留着你的台面上的经济活动要公开"
    },
    {
      "ordinal": 85,
      "start_ms": 242260,
      "end_ms": 244880,
      "text": "为什么这个不能公开台面上的竞技活动"
    },
    {
      "ordinal": 86,
      "start_ms": 244880,
      "end_ms": 246140,
      "text": "你为什么不能公开"
    },
    {
      "ordinal": 87,
      "start_ms": 248320,
      "end_ms": 250740,
      "text": "你也知道公开的秘密要结合"
    },
    {
      "ordinal": 88,
      "start_ms": 250980,
      "end_ms": 254040,
      "text": "而且你也知道是公开和秘密结合的工作方式"
    },
    {
      "ordinal": 89,
      "start_ms": 254040,
      "end_ms": 256290,
      "text": "首先你们根本没有工作"
    },
    {
      "ordinal": 90,
      "start_ms": 256290,
      "end_ms": 257880,
      "text": "你没有做我们的工作"
    },
    {
      "ordinal": 91,
      "start_ms": 257880,
      "end_ms": 261079,
      "text": "其次你根本都没有秘密"
    },
    {
      "ordinal": 92,
      "start_ms": 261459,
      "end_ms": 265659,
      "text": "再其次你这个你这个这种讲的这些东西"
    },
    {
      "ordinal": 93,
      "start_ms": 265659,
      "end_ms": 267729,
      "text": "你就是在知乎里面公开的"
    },
    {
      "ordinal": 94,
      "start_ms": 267729,
      "end_ms": 269079,
      "text": "你自己是完全公开的"
    },
    {
      "ordinal": 95,
      "start_ms": 269079,
      "end_ms": 270480,
      "text": "你有啥秘密活动啊"
    },
    {
      "ordinal": 96,
      "start_ms": 273280,
      "end_ms": 274740,
      "text": "什么好不容易做这些东西"
    },
    {
      "ordinal": 97,
      "start_ms": 274740,
      "end_ms": 276000,
      "text": "这么说"
    },
    {
      "ordinal": 98,
      "start_ms": 276000,
      "end_ms": 277050,
      "text": "我是取消派"
    },
    {
      "ordinal": 99,
      "start_ms": 277050,
      "end_ms": 278040,
      "text": "我是取消派"
    },
    {
      "ordinal": 100,
      "start_ms": 278040,
      "end_ms": 279540,
      "text": "我如果我真是取消派"
    },
    {
      "ordinal": 101,
      "start_ms": 279540,
      "end_ms": 282450,
      "text": "我为什么我要我要我要我要做这么多事情"
    },
    {
      "ordinal": 102,
      "start_ms": 282450,
      "end_ms": 283710,
      "text": "我是取消败的话"
    },
    {
      "ordinal": 103,
      "start_ms": 283710,
      "end_ms": 286160,
      "text": "为什么我的我的店有二楼"
    },
    {
      "ordinal": 104,
      "start_ms": 288480,
      "end_ms": 290820,
      "text": "为什么我们的店有二楼"
    },
    {
      "ordinal": 105,
      "start_ms": 297540,
      "end_ms": 299120,
      "text": "一边加强巩固什么"
    },
    {
      "ordinal": 106,
      "start_ms": 299120,
      "end_ms": 301490,
      "text": "一边大力探索利用合法空间"
    },
    {
      "ordinal": 107,
      "start_ms": 301490,
      "end_ms": 305120,
      "text": "请问一边大力探索"
    },
    {
      "ordinal": 108,
      "start_ms": 305120,
      "end_ms": 307580,
      "text": "你只看见我大力探索利用合法空间"
    },
    {
      "ordinal": 109,
      "start_ms": 307580,
      "end_ms": 309770,
      "text": "你看不见我加强巩固什么什么的"
    },
    {
      "ordinal": 110,
      "start_ms": 309770,
      "end_ms": 312540,
      "text": "你不能因为我我我不告诉你"
    },
    {
      "ordinal": 111,
      "start_ms": 312540,
      "end_ms": 313260,
      "text": "我在加强巩固"
    },
    {
      "ordinal": 112,
      "start_ms": 313260,
      "end_ms": 315840,
      "text": "是不是你就说我没有再加强巩固什么什么"
    },
    {
      "ordinal": 113,
      "start_ms": 315840,
      "end_ms": 317120,
      "text": "你知道什么呀"
    },
    {
      "ordinal": 114,
      "start_ms": 317479,
      "end_ms": 319519,
      "text": "你是我的团队成员吗"
    },
    {
      "ordinal": 115,
      "start_ms": 320539,
      "end_ms": 322000,
      "text": "你是我小弟吗"
    },
    {
      "ordinal": 116,
      "start_ms": 323759,
      "end_ms": 325399,
      "text": "我的团队成员不是我的小弟啊"
    },
    {
      "ordinal": 117,
      "start_ms": 325399,
      "end_ms": 326359,
      "text": "这和并列关系啊"
    },
    {
      "ordinal": 118,
      "start_ms": 326359,
      "end_ms": 327079,
      "text": "你是我的小弟"
    },
    {
      "ordinal": 119,
      "start_ms": 327079,
      "end_ms": 327919,
      "text": "你不是我小弟"
    },
    {
      "ordinal": 120,
      "start_ms": 327919,
      "end_ms": 329440,
      "text": "你也不是我团队成员"
    },
    {
      "ordinal": 121,
      "start_ms": 330199,
      "end_ms": 331989,
      "text": "100多年过去了"
    },
    {
      "ordinal": 122,
      "start_ms": 334059,
      "end_ms": 335769,
      "text": "又在我身上获得的经验存在"
    },
    {
      "ordinal": 123,
      "start_ms": 335769,
      "end_ms": 336909,
      "text": "新的叛徒又诞生"
    },
    {
      "ordinal": 124,
      "start_ms": 336909,
      "end_ms": 338140,
      "text": "直接说我是叛徒"
    },
    {
      "ordinal": 125,
      "start_ms": 338140,
      "end_ms": 340240,
      "text": "你有什么证据说我是叛徒"
    },
    {
      "ordinal": 126,
      "start_ms": 340240,
      "end_ms": 343690,
      "text": "我在地下说说我是把哪些情报给了给了谁"
    },
    {
      "ordinal": 127,
      "start_ms": 343690,
      "end_ms": 345160,
      "text": "我是把什么东西给了谁"
    },
    {
      "ordinal": 128,
      "start_ms": 345160,
      "end_ms": 346480,
      "text": "你说我是骗子叛徒"
    },
    {
      "ordinal": 129,
      "start_ms": 346480,
      "end_ms": 347740,
      "text": "你有什么证据说我是叛徒"
    },
    {
      "ordinal": 130,
      "start_ms": 349660,
      "end_ms": 351300,
      "text": "你有何证据说我是叛徒"
    },
    {
      "ordinal": 131,
      "start_ms": 351360,
      "end_ms": 353370,
      "text": "我是领了什么"
    },
    {
      "ordinal": 132,
