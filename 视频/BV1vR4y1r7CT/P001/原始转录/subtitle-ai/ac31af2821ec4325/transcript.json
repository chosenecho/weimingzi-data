  "segments": [
    {
      "ordinal": 0,
      "start_ms": 26560,
      "end_ms": 29140,
      "text": "啊"
    },
    {
      "ordinal": 1,
      "start_ms": 46960,
      "end_ms": 48360,
      "text": "白云悠悠"
    },
    {
      "ordinal": 2,
      "start_ms": 48360,
      "end_ms": 49620,
      "text": "一路飞去"
    },
    {
      "ordinal": 3,
      "start_ms": 49620,
      "end_ms": 51180,
      "text": "秋风起"
    },
    {
      "ordinal": 4,
      "start_ms": 52200,
      "end_ms": 54200,
      "text": "花儿都谢了"
    },
    {
      "ordinal": 5,
      "start_ms": 54200,
      "end_ms": 56180,
      "text": "燕子都去了"
    },
    {
      "ordinal": 6,
      "start_ms": 57200,
      "end_ms": 59660,
      "text": "漫漫长夜黯然相思"
    },
    {
      "ordinal": 7,
      "start_ms": 59660,
      "end_ms": 61920,
      "text": "秋风里"
    },
    {
      "ordinal": 8,
      "start_ms": 61920,
      "end_ms": 64230,
      "text": "月儿都倦了"
    },
    {
      "ordinal": 9,
      "start_ms": 64230,
      "end_ms": 67250,
      "text": "鱼儿都睡了"
    },
    {
      "ordinal": 10,
      "start_ms": 67650,
      "end_ms": 72110,
      "text": "波月见诺言"
    },
    {
      "ordinal": 11,
      "start_ms": 72720,
      "end_ms": 75410,
      "text": "搜云空余"
    },
    {
      "ordinal": 12,
      "start_ms": 75410,
      "end_ms": 81920,
      "text": "闲在这般凄凉的午夜"
    },
    {
      "ordinal": 13,
      "start_ms": 82700,
      "end_ms": 87160,
      "text": "苍白的语言"
    },
    {
      "ordinal": 14,
      "start_ms": 89320,
      "end_ms": 92760,
      "text": "这秋风无依无靠"
    },
    {
      "ordinal": 15,
      "start_ms": 92760,
      "end_ms": 95280,
      "text": "无端无聊"
    },
    {
      "ordinal": 16,
      "start_ms": 95280,
      "end_ms": 97940,
      "text": "不说不笑"
    },
    {
      "ordinal": 17,
      "start_ms": 98400,
      "end_ms": 101930,
      "text": "苦恼苦寂灭"
    },
    {
      "ordinal": 18,
      "start_ms": 101930,
      "end_ms": 104630,
      "text": "道真难分"
    },
    {
      "ordinal": 19,
      "start_ms": 104630,
      "end_ms": 110400,
      "text": "难料什么这么说"
    },
    {
      "ordinal": 20,
      "start_ms": 110740,
      "end_ms": 112380,
      "text": "无需知道"
    },
    {
      "ordinal": 21,
      "start_ms": 113400,
      "end_ms": 115820,
      "text": "几乎明了"
    },
    {
      "ordinal": 22,
      "start_ms": 115820,
      "end_ms": 117920,
      "text": "早就分享"
    },
    {
      "ordinal": 23,
      "start_ms": 117920,
      "end_ms": 121520,
      "text": "这秋风让目光"
    },
    {
      "ordinal": 24,
      "start_ms": 121520,
      "end_ms": 128300,
      "text": "你个沙渗出了迷惘"
    },
    {
      "ordinal": 25,
      "start_ms": 130479,
      "end_ms": 131879,
      "text": "你不肯说"
    },
    {
      "ordinal": 26,
      "start_ms": 133199,
      "end_ms": 135460,
      "text": "你不肯说"
    },
    {
      "ordinal": 27,
      "start_ms": 135500,
      "end_ms": 140140,
      "text": "你不肯说心底的思量"
    },
    {
      "ordinal": 28,
      "start_ms": 140460,
      "end_ms": 142680,
      "text": "你不肯说"
    },
    {
      "ordinal": 29,
      "start_ms": 142960,
      "end_ms": 144360,
      "text": "你不肯说"
    },
    {
      "ordinal": 30,
      "start_ms": 145680,
      "end_ms": 149540,
      "text": "你不肯说心底的思量"
    },
    {
      "ordinal": 31,
      "start_ms": 150420,
      "end_ms": 155460,
      "text": "白云悠悠一缕飞去千万里"
    },
    {
      "ordinal": 32,
      "start_ms": 155460,
      "end_ms": 158040,
      "text": "花儿不见了"
    },
    {
      "ordinal": 33,
      "start_ms": 158040,
      "end_ms": 160350,
      "text": "燕子不见了"
    },
    {
      "ordinal": 34,
      "start_ms": 160350,
      "end_ms": 161940,
      "text": "漫漫长夜"
    },
    {
      "ordinal": 35,
      "start_ms": 161940,
      "end_ms": 164960,
      "text": "伊人相思在梦里"
    },
    {
      "ordinal": 36,
      "start_ms": 165080,
      "end_ms": 167720,
      "text": "月儿不见了"
    },
    {
      "ordinal": 37,
      "start_ms": 167720,
      "end_ms": 170700,
      "text": "月儿不见了"
    },
    {
      "ordinal": 38,
      "start_ms": 170860,
      "end_ms": 172260,
      "text": "到如今"
    },
    {
      "ordinal": 39,
      "start_ms": 172260,
      "end_ms": 173520,
      "text": "秋风破"
    },
    {
      "ordinal": 40,
      "start_ms": 174720,
      "end_ms": 177080,
      "text": "月渐落雁"
    },
    {
      "ordinal": 41,
      "start_ms": 177960,
      "end_ms": 182040,
      "text": "搜云空余弦"
    },
    {
      "ordinal": 42,
      "start_ms": 182080,
      "end_ms": 187080,
      "text": "只听见起亮的屋檐"
    },
    {
      "ordinal": 43,
      "start_ms": 188020,
      "end_ms": 192900,
      "text": "苍白的语言若风"
    },
    {
      "ordinal": 44,
      "start_ms": 192900,
      "end_ms": 197200,
      "text": "鼓楼战士长夜"
    },
    {
      "ordinal": 45,
      "start_ms": 198080,
      "end_ms": 201820,
      "text": "天下竟无眠"
    },
    {
      "ordinal": 46,
      "start_ms": 202100,
      "end_ms": 203560,
      "text": "下着飘零"
    },
    {
      "ordinal": 47,
      "start_ms": 204760,
      "end_ms": 212020,
      "text": "躺好荒野上车挂林间"
    },
    {
      "ordinal": 48,
      "start_ms": 215960,
      "end_ms": 219780,
      "text": "8月秋高风怒号"
    },
    {
      "ordinal": 49,
      "start_ms": 219780,
      "end_ms": 223860,
      "text": "卷我屋上三重茅"
    },
    {
      "ordinal": 50,
      "start_ms": 223860,
      "end_ms": 227380,
      "text": "入竹去归来"
    },
    {
      "ordinal": 51,
      "start_ms": 227380,
      "end_ms": 230840,
      "text": "倚仗自叹叹息"
    },
    {
      "ordinal": 52,
      "start_ms": 230840,
      "end_ms": 236420,
      "text": "安得广厦千万寒的光"
    },
    {
      "ordinal": 53,
      "start_ms": 236420,
      "end_ms": 238160,
      "text": "杀千换"
    },
    {
      "ordinal": 54,
      "start_ms": 238160,
      "end_ms": 240500,
      "text": "大悲天下"
    },
    {
      "ordinal": 55,
      "start_ms": 240500,
      "end_ms": 243020,
      "text": "寒士俱欢"
    },
    {
      "ordinal": 56,
      "start_ms": 243020,
      "end_ms": 244940,
      "text": "变俱欢"
    },
    {
      "ordinal": 57,
      "start_ms": 244940,
      "end_ms": 247460,
      "text": "燕南村群童"
    },
    {
      "ordinal": 58,
      "start_ms": 247460,
      "end_ms": 254800,
      "text": "人们对面为盗贼为盗贼"
    },
    {
      "ordinal": 59,
      "start_ms": 256000,
      "end_ms": 258160,
      "text": "你不肯说"
    },
    {
      "ordinal": 60,
      "start_ms": 258320,
      "end_ms": 259720,
      "text": "你不肯说"
    },
    {
      "ordinal": 61,
      "start_ms": 261040,
      "end_ms": 265289,
      "text": "也不肯说心底的思量"
    },
    {
      "ordinal": 62,
      "start_ms": 265929,
      "end_ms": 268060,
      "text": "你不肯说"
    },
    {
      "ordinal": 63,
      "start_ms": 268220,
      "end_ms": 269680,
      "text": "你不肯说"
    },
    {
