{
  "bvid": "BV1aRTA6mEGF",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "1ca058912f484605833b3f70cd933ce1634ff983d60a9f0b800e2e6b277364a4",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 40,
      "end_ms": 960,
      "text": "头上拉屎啊"
    },
    {
      "ordinal": 1,
      "start_ms": 960,
      "end_ms": 2880,
      "text": "这个首先呢改名叫安全屋"
    },
    {
      "ordinal": 2,
      "start_ms": 2880,
      "end_ms": 3860,
      "text": "你配吗"
    },
    {
      "ordinal": 3,
      "start_ms": 3860,
      "end_ms": 4680,
      "text": "你妈的"
    },
    {
      "ordinal": 4,
      "start_ms": 4680,
      "end_ms": 5820,
      "text": "你们又不是反贼团体"
    },
    {
      "ordinal": 5,
      "start_ms": 5820,
      "end_ms": 7940,
      "text": "我靠你配叫安全屋吗"
    },
    {
      "ordinal": 6,
      "start_ms": 7940,
      "end_ms": 8880,
      "text": "对不对"
    },
    {
      "ordinal": 7,
      "start_ms": 8880,
      "end_ms": 10220,
      "text": "安全屋用干嘛的"
    },
    {
      "ordinal": 8,
      "start_ms": 10220,
      "end_ms": 11500,
      "text": "躲避侦查用的"
    },
    {
      "ordinal": 9,
      "start_ms": 11500,
      "end_ms": 14500,
      "text": "你们有没有侦查价值不对"
    },
    {
      "ordinal": 10,
      "start_ms": 14500,
      "end_ms": 17560,
      "text": "一群小屁孩叫安全屋"
    },
    {
      "ordinal": 11,
      "start_ms": 17560,
      "end_ms": 18980,
      "text": "没资格"
    },
    {
      "ordinal": 12,
      "start_ms": 18980,
      "end_ms": 19780,
      "text": "明白吗"
    },
    {
      "ordinal": 13,
      "start_ms": 19780,
      "end_ms": 21100,
      "text": "我都没有安全屋"
    },
    {
      "ordinal": 14,
      "start_ms": 21100,
      "end_ms": 23130,
      "text": "你们还他妈叫安全屋"
    },
    {
      "ordinal": 15,
      "start_ms": 23130,
      "end_ms": 25330,
      "text": "给自己脸上抹这个格气"
    },
    {
      "ordinal": 16,
      "start_ms": 25330,
      "end_ms": 25830,
      "text": "你知道吗"
    },
    {
      "ordinal": 17,
      "start_ms": 25830,
      "end_ms": 27370,
      "text": "抹这个反气啊"
    },
    {
      "ordinal": 18,
      "start_ms": 27370,
      "end_ms": 28010,
      "text": "太挫了"
    },
    {
      "ordinal": 19,
      "start_ms": 28010,
      "end_ms": 29690,
      "text": "然后另外这个这不是重点"
    },
    {
      "ordinal": 20,
      "start_ms": 29690,
      "end_ms": 32950,
      "text": "重点是这个叫做什么270元"
    },
    {
      "ordinal": 21,
      "start_ms": 32950,
      "end_ms": 33930,
      "text": "掌握电工技能"
    },
    {
      "ordinal": 22,
      "start_ms": 33930,
      "end_ms": 35850,
      "text": "他要搞在线电工培训啊"
    },
    {
      "ordinal": 23,
      "start_ms": 35850,
      "end_ms": 37370,
      "text": "那我在此宣布"
    },
    {
      "ordinal": 24,
      "start_ms": 37370,
      "end_ms": 40010,
      "text": "我们也要搞这个在线电工培训"
    },
    {
      "ordinal": 25,
      "start_ms": 40010,
      "end_ms": 44530,
      "text": "然后我们的电工每个月培训出来的学员啊"
    },
    {
      "ordinal": 26,
      "start_ms": 44530,
      "end_ms": 46515,
      "text": "有这个什么"
    },
    {
      "ordinal": 27,
      "start_ms": 48280,
      "end_ms": 54440,
      "text": "一般我想都十个十个十个十个十个"
    },
    {
      "ordinal": 28,
      "start_ms": 54850,
      "end_ms": 57990,
      "text": "20额有80个左右"
    },
    {
      "ordinal": 29,
      "start_ms": 58390,
      "end_ms": 60070,
      "text": "有80个左右啊"
    },
    {
      "ordinal": 30,
      "start_ms": 60070,
      "end_ms": 62110,
      "text": "里面挑一半算掌握的比较好的"
    },
    {
      "ordinal": 31,
      "start_ms": 62110,
      "end_ms": 64870,
      "text": "或者说挑这个四四分之一"
    },
    {
      "ordinal": 32,
      "start_ms": 64870,
      "end_ms": 67610,
      "text": "那就有20个优秀学员啊"
    },
    {
      "ordinal": 33,
      "start_ms": 67610,
      "end_ms": 72740,
      "text": "所以说我们开展这个在线电工培训的这个硬件"
    },
    {
      "ordinal": 34,
      "start_ms": 72740,
      "end_ms": 74160,
      "text": "硬实力能力也比较强的多啊"
    },
    {
      "ordinal": 35,
      "start_ms": 74160,
      "end_ms": 75180,
      "text": "我们还有个工厂"
    },
    {
      "ordinal": 36,
      "start_ms": 75180,
      "end_ms": 79140,
      "text": "因为这个等会我听着"
    },
    {
      "ordinal": 37,
      "start_ms": 79140,
      "end_ms": 83220,
      "text": "因为这个电工培训实操培训比较重要的"
    },
    {
      "ordinal": 38,
      "start_ms": 83220,
      "end_ms": 84640,
      "text": "就是反复的去接线"
    },
    {
      "ordinal": 39,
      "start_ms": 84640,
      "end_ms": 86900,
      "text": "反复的去练啊这些东西"
    },
    {
      "ordinal": 40,
      "start_ms": 86900,
      "end_ms": 93710,
      "text": "所以说我们打算开设这个在线的电工培训教啊"
    },
    {
      "ordinal": 41,
      "start_ms": 93710,
      "end_ms": 94950,
      "text": "不仅是教程"
    },
    {
      "ordinal": 42,
      "start_ms": 94950,
      "end_ms": 96470,
      "text": "还有就是分班组"
    },
    {
      "ordinal": 43,
      "start_ms": 96470,
      "end_ms": 99050,
      "text": "然后是啊可以一对一的"
    },
    {
      "ordinal": 44,
      "start_ms": 99050,
      "end_ms": 100330,
      "text": "甚至说来教你啊"
    },
    {
      "ordinal": 45,
      "start_ms": 100330,
      "end_ms": 101090,
      "text": "一个个来教"
    },
    {
      "ordinal": 46,
      "start_ms": 102250,
      "end_ms": 104110,
      "text": "当然不可能全部是一对一的啊"
    },
    {
      "ordinal": 47,
      "start_ms": 104110,
      "end_ms": 106980,
      "text": "就是会有啊一部分的时间是一对一的"
    },
    {
      "ordinal": 48,
      "start_ms": 106980,
      "end_ms": 108280,
      "text": "来教你这个实操的"
    },
    {
      "ordinal": 49,
      "start_ms": 108280,
      "end_ms": 111780,
      "text": "还有一对多的这个价格的啊"
    },
    {
      "ordinal": 50,
      "start_ms": 111780,
      "end_ms": 114610,
      "text": "我这个进口预言在这里定了150"
    },
    {
      "ordinal": 51,
      "start_ms": 115050,
      "end_ms": 115930,
      "text": "150啊"
    },
    {
      "ordinal": 52,
      "start_ms": 116890,
      "end_ms": 119870,
      "text": "然后那个这个用的这个器具啊"
    },
    {
      "ordinal": 53,
      "start_ms": 119870,
      "end_ms": 122010,
      "text": "这个我们会寄过去啊"
    },
    {
      "ordinal": 54,
      "start_ms": 122010,
      "end_ms": 127060,
      "text": "用的器具我们会给你寄过去好吧"
    },
    {
      "ordinal": 55,
      "start_ms": 127340,
      "end_ms": 129220,
      "text": "不是你就不用来了"
    },
    {
      "ordinal": 56,
      "start_ms": 129220,
      "end_ms": 129539,
      "text": "知道吗"
    },
    {
      "ordinal": 57,
      "start_ms": 129539,
      "end_ms": 131120,
      "text": "你包括你所有的实操"
    },
    {
      "ordinal": 58,
      "start_ms": 131120,
      "end_ms": 133300,
      "text": "你要用的这个接线盘啊"
    },
    {
      "ordinal": 59,
      "start_ms": 133300,
      "end_ms": 133940,
      "text": "什么这些东西的"
    },
    {
      "ordinal": 60,
      "start_ms": 133940,
      "end_ms": 136020,
      "text": "我直接给你寄过去"
    },
    {
      "ordinal": 61,
      "start_ms": 137090,
      "end_ms": 140890,
      "text": "而且我们就比价格换来比我们有优势"
    },
    {
      "ordinal": 62,
      "start_ms": 140890,
      "end_ms": 142130,
      "text": "人力优势"
    },
    {
      "ordinal": 63,
      "start_ms": 142130,
      "end_ms": 146650,
      "text": "包括这个这个我们自己的工厂可以去生产"
    },
    {
      "ordinal": 64,
      "start_ms": 146650,
      "end_ms": 148190,
      "text": "我就是要卷死你"
    },
    {
      "ordinal": 65,
      "start_ms": 148190,
      "end_ms": 149330,
      "text": "怎么样"
    },
    {
      "ordinal": 66,
      "start_ms": 149330,
      "end_ms": 150890,
      "text": "我就看你们不顺眼"
    },
    {
      "ordinal": 67,
      "start_ms": 150890,
      "end_ms": 152010,
      "text": "我就把你干掉"
    },
    {
      "ordinal": 68,
      "start_ms": 152010,
      "end_ms": 154500,
      "text": "就是把你卷死啊"
    },
    {
      "ordinal": 69,
      "start_ms": 154500,
      "end_ms": 156980,
      "text": "我换一里边去这个发广告啊"
    },
    {
      "ordinal": 70,
      "start_ms": 156980,
      "end_ms": 157700,
      "text": "反正怎样的"
    },
    {
      "ordinal": 71,
      "start_ms": 157700,
      "end_ms": 161580,
      "text": "把他们的这个全全全拉过来懂吗"
    },
    {
      "ordinal": 72,
      "start_ms": 162630,
      "end_ms": 166450,
      "text": "然后这个东西呢不是一时意气所致"
    },
    {
      "ordinal": 73,
      "start_ms": 166450,
      "end_ms": 167890,
      "text": "就是看见这个消息"
    },
    {
      "ordinal": 74,
      "start_ms": 167890,
      "end_ms": 169130,
      "text": "我这好久就看见了吗"
    },
    {
      "ordinal": 75,
      "start_ms": 171490,
      "end_ms": 175770,
      "text": "这个东西呢实际上是一个深远的谋划"
    },
    {
      "ordinal": 76,
      "start_ms": 176550,
      "end_ms": 178830,
      "text": "那我们我们最近几天我收到一份报告"
    },
    {
      "ordinal": 77,
      "start_ms": 178830,
      "end_ms": 181650,
      "text": "上面写的就是苏州本地电工学员21人"
    },
    {
      "ordinal": 78,
      "start_ms": 181650,
      "end_ms": 183470,
      "text": "激进度很低啊"
    },
    {
      "ordinal": 79,
      "start_ms": 183470,
      "end_ms": 185600,
      "text": "苏州这里太舒服了啊"
    },
    {
      "ordinal": 80,
      "start_ms": 185600,
      "end_ms": 186180,
      "text": "你知道吧"
    },
    {
      "ordinal": 81,
      "start_ms": 186180,
      "end_ms": 190579,
      "text": "就是说学出来你懂的"
    },
    {
      "ordinal": 82,
      "start_ms": 190579,
      "end_ms": 191219,
      "text": "学出来"
    },
    {
      "ordinal": 83,
      "start_ms": 191219,
      "end_ms": 195990,
      "text": "就是说这个啊一找找个什么五六千的工作啊"
    },
    {
      "ordinal": 84,
      "start_ms": 195990,
      "end_ms": 200780,
      "text": "然后这里什么抱团生活的这个住宿也搞定了"
    },
    {
      "ordinal": 85,
      "start_ms": 200780,
      "end_ms": 201960,
      "text": "太舒服了"
    },
    {
      "ordinal": 86,
      "start_ms": 201960,
      "end_ms": 203980,
      "text": "零基进零机进度啊"
    },
    {
      "ordinal": 87,
      "start_ms": 203980,
      "end_ms": 204740,
      "text": "硬度很低"
    },
    {
      "ordinal": 88,
      "start_ms": 205780,
      "end_ms": 211690,
      "text": "所以说这个状况呢我们短期之内没办法改变"
    },
    {
      "ordinal": 89,
      "start_ms": 211690,
      "end_ms": 213510,
      "text": "但是长期之内啊"
    },
    {
      "ordinal": 90,
      "start_ms": 213510,
      "end_ms": 215110,
      "text": "就是说是这样的"
    },
    {
      "ordinal": 91,
      "start_ms": 215110,
      "end_ms": 216730,
      "text": "我们也想了一招"
    },
    {
      "ordinal": 92,
      "start_ms": 216730,
      "end_ms": 223700,
      "text": "就是说你看我我这个一个月能够训练80个人"
    },
    {
      "ordinal": 93,
      "start_ms": 223700,
      "end_ms": 227100,
      "text": "一年呢就是这个1000个人"
    },
    {
      "ordinal": 94,
      "start_ms": 227100,
      "end_ms": 228640,
      "text": "1000个呃"
    },
    {
      "ordinal": 95,
      "start_ms": 228640,
      "end_ms": 231000,
      "text": "那这个是说是不5年呢"
    },
    {
      "ordinal": 96,
      "start_ms": 231000,
      "end_ms": 232580,
      "text": "就是一就是5000人"
    },
    {
      "ordinal": 97,
      "start_ms": 232580,
      "end_ms": 234860,
      "text": "那如果说还能够有一个扩张"
    },
    {
      "ordinal": 98,
      "start_ms": 234860,
      "end_ms": 238939,
      "text": "就是在这个嘶通过线上培训的方式"
    },
    {
      "ordinal": 99,
      "start_ms": 238939,
      "end_ms": 240199,
      "text": "我给他加个十倍"
    },
    {
      "ordinal": 100,
      "start_ms": 240199,
      "end_ms": 241299,
      "text": "那就是5万人"
    },
    {
      "ordinal": 101,
      "start_ms": 241299,
      "end_ms": 243279,
      "text": "5万人的话够不够"
    },
    {
      "ordinal": 102,
      "start_ms": 243279,
      "end_ms": 245810,
      "text": "把你这里的这个工价给你卷低"
    },
    {
      "ordinal": 103,
      "start_ms": 246130,
      "end_ms": 247050,
      "text": "够不够"
    },
    {
      "ordinal": 104,
      "start_ms": 247050,
      "end_ms": 249320,
      "text": "够不够把你工价卷低"
    },
    {
      "ordinal": 105,
      "start_ms": 249600,
      "end_ms": 250320,
      "text": "不知道"
    },
    {
      "ordinal": 106,
      "start_ms": 250320,
      "end_ms": 252640,
      "text": "也可能到时候是因为我我我输出了很多"
    },
    {
      "ordinal": 107,
      "start_ms": 252640,
      "end_ms": 254200,
      "text": "这个高素质的这个电工人才"
    },
    {
      "ordinal": 108,
      "start_ms": 254200,
      "end_ms": 255480,
      "text": "他这些企业越做越好"
    },
    {
      "ordinal": 109,
      "start_ms": 255480,
      "end_ms": 256380,
      "text": "越做越大了"
    },
    {
      "ordinal": 110,
      "start_ms": 256380,
      "end_ms": 259019,
      "text": "然后在国际市场份额赚的越来越多了"
    },
    {
      "ordinal": 111,
      "start_ms": 259019,
      "end_ms": 260939,
      "text": "估价反而反而越来越高呢"
    },
    {
      "ordinal": 112,
      "start_ms": 260939,
      "end_ms": 263899,
      "text": "所以这个东西呢就是说说格格说造啊"
    },
    {
      "ordinal": 113,
      "start_ms": 263899,
      "end_ms": 266059,
      "text": "说说饱饱说造造"
    },
    {
      "ordinal": 114,
      "start_ms": 266320,
      "end_ms": 269040,
      "text": "我们会大量的通过线上培训"
    },
    {
      "ordinal": 115,
      "start_ms": 269040,
      "end_ms": 271520,
      "text": "然后是寄送这个呃"
    },
    {
      "ordinal": 116,
      "start_ms": 271520,
      "end_ms": 274740,
      "text": "租借这个培训教材啊"
    },
    {
      "ordinal": 117,
      "start_ms": 274740,
      "end_ms": 276860,
      "text": "培训的这个教具的这种方式"
    },
    {
      "ordinal": 118,
      "start_ms": 277900,
      "end_ms": 283160,
      "text": "大量的去啊培训这个对"
    },
    {
      "ordinal": 119,
      "start_ms": 284280,
      "end_ms": 286480,
      "text": "就是想办法想尽办法去"
    },
    {
      "ordinal": 120,
      "start_ms": 286480,
      "end_ms": 289560,
      "text": "那你不知道有没有点加速主义的意味在里面"
    },
    {
      "ordinal": 121,
      "start_ms": 289560,
      "end_ms": 291240,
      "text": "这叫局部的加速"
    },
    {
      "ordinal": 122,
      "start_ms": 291240,
      "end_ms": 292640,
      "text": "加速的方式啊"
    },
    {
      "ordinal": 123,
      "start_ms": 292640,
      "end_ms": 293720,
      "text": "局部的加速"
    },
    {
      "ordinal": 124,
      "start_ms": 293720,
      "end_ms": 299080,
      "text": "因为这个行业是一个文科知识分子"
    },
    {
      "ordinal": 125,
      "start_ms": 299080,
      "end_ms": 302440,
      "text": "跌落文科的毕业生找不到工作"
    },
    {
      "ordinal": 126,
      "start_ms": 302440,
      "end_ms": 304700,
      "text": "他你知道脑袋是有序的啊"
    },
    {
      "ordinal": 127,
      "start_ms": 304700,
      "end_ms": 306140,
      "text": "Well educated"
    },
    {
      "ordinal": 128,
      "start_ms": 306140,
      "end_ms": 311240,
      "text": "就很容易就是说和这个工作结合了之后"
    },
    {
      "ordinal": 129,
      "start_ms": 311240,
      "end_ms": 313550,
      "text": "有饭吃啊"
    },
    {
      "ordinal": 130,
      "start_ms": 316510,
      "end_ms": 322270,
      "text": "所以我们就是然后我们会搞一个电工论坛啊"
    },
    {
      "ordinal": 131,
      "start_ms": 322270,
      "end_ms": 323510,
      "text": "这就和这个配套的"
    },
    {
      "ordinal": 132,
      "start_ms": 323510,
      "end_ms": 328070,
      "text": "和这相当于app的这个教学的这个教学软件"
    },
    {
      "ordinal": 133,
      "start_ms": 328070,
      "end_ms": 329510,
      "text": "教学平台配套的"
    },
    {
      "ordinal": 134,
      "start_ms": 329510,
      "end_ms": 330950,
      "text": "会搞一个电工论坛里面"
    },
    {
      "ordinal": 135,
      "start_ms": 330950,
      "end_ms": 335240,
      "text": "就是说不停的是让这些嗯装备电工啊"
    },
    {
      "ordinal": 136,
      "start_ms": 335240,
      "end_ms": 338440,
      "text": "还是说是国内的这个电工行业的"
    },
    {
      "ordinal": 137,
      "start_ms": 338440,
      "end_ms": 341760,
      "text": "来进行一个经验技能的一个分享"
    },
    {
      "ordinal": 138,
      "start_ms": 342080,
      "end_ms": 344070,
      "text": "电工岗位有那么多吗"
    },
    {
      "ordinal": 139,
      "start_ms": 344070,
      "end_ms": 346430,
      "text": "他有的好多的非标自动化呀"
    },
    {
      "ordinal": 140,
      "start_ms": 346430,
      "end_ms": 348630,
      "text": "还有甚至就是机器人"
    },
    {
      "ordinal": 141,
      "start_ms": 348630,
      "end_ms": 348990,
      "text": "你知道吗"
    },
    {
      "ordinal": 142,
      "start_ms": 348990,
      "end_ms": 352330,
      "text": "他有个机器人厂是造那机器人轮子的"
    },
    {
      "ordinal": 143,
      "start_ms": 352330,
      "end_ms": 354650,
      "text": "那我们那个厂是造机器人的机"
    },
    {
      "ordinal": 144,
      "start_ms": 354650,
      "end_ms": 355810,
      "text": "就轮壁机"
    },
    {
      "ordinal": 145,
      "start_ms": 355810,
      "end_ms": 358090,
      "text": "造机机机械臂的啊"
    },
    {
      "ordinal": 146,
      "start_ms": 358090,
      "end_ms": 359260,
      "text": "机械臂的"
    },
    {
      "ordinal": 147,
      "start_ms": 359260,
      "end_ms": 362200,
      "text": "他那个厂就是说把那两个东西拼起来"
    },
    {
      "ordinal": 148,
      "start_ms": 362200,
      "end_ms": 368170,
      "text": "然后呢就是说这个啊到到这个中国台湾去贴牌"
    },
    {
      "ordinal": 149,
      "start_ms": 368170,
      "end_ms": 369430,
      "text": "然后去往美国卖"
    },
    {
      "ordinal": 150,
      "start_ms": 369430,
      "end_ms": 371730,
      "text": "你们知道一台卖多少钱吗"
    },
    {
      "ordinal": 151,
      "start_ms": 373880,
      "end_ms": 377840,
      "text": "20个刀"
    },
    {
      "ordinal": 152,
      "start_ms": 380800,
      "end_ms": 382710,
      "text": "卖到美国去"
    },
    {
      "ordinal": 153,
      "start_ms": 383110,
      "end_ms": 386290,
      "text": "狠狠赚美国人的那个智商税"
    },
    {
      "ordinal": 154,
      "start_ms": 386290,
      "end_ms": 387990,
      "text": "所以他们的工价都还可以"
    },
    {
      "ordinal": 155,
      "start_ms": 387990,
      "end_ms": 389250,
      "text": "都比较高啊"
    },
    {
      "ordinal": 156,
      "start_ms": 389250,
      "end_ms": 390930,
      "text": "他们的工价都比较高"
    },
    {
      "ordinal": 157,
      "start_ms": 390930,
      "end_ms": 396160,
      "text": "这个那我们要做的就是说怎样啊"
    },
    {
      "ordinal": 158,
      "start_ms": 396160,
      "end_ms": 397820,
      "text": "我就是加大节流啊"
    },
    {
      "ordinal": 159,
      "start_ms": 397820,
      "end_ms": 401080,
      "text": "就把这个利润都截留在我这个大陆啊"
    },
    {
      "ordinal": 160,
      "start_ms": 401080,
      "end_ms": 403640,
      "text": "在这个本地在劳动者的口袋里面"
    },
    {
      "ordinal": 161,
      "start_ms": 403640,
      "end_ms": 406060,
      "text": "我不是说是要啊"
    },
    {
      "ordinal": 162,
      "start_ms": 406060,
      "end_ms": 408020,
      "text": "这个真的是什么搞加速主义"
    },
    {
      "ordinal": 163,
      "start_ms": 408020,
      "end_ms": 409340,
      "text": "把这个行业给卷没了"
    },
    {
      "ordinal": 164,
      "start_ms": 409340,
      "end_ms": 410160,
      "text": "不是这个意思"
    },
    {
      "ordinal": 165,
      "start_ms": 410160,
      "end_ms": 415200,
      "text": "而是说这确实这是一个有效疏解啊"
    },
    {
      "ordinal": 166,
      "start_ms": 415200,
      "end_ms": 416730,
      "text": "开始叠甲了啊"
    },
    {
      "ordinal": 167,
      "start_ms": 416730,
      "end_ms": 419810,
      "text": "有效疏解这个应届的"
    },
    {
      "ordinal": 168,
      "start_ms": 419810,
      "end_ms": 422970,
      "text": "或者说是往届的文科方向的毕业生啊"
    },
    {
      "ordinal": 169,
      "start_ms": 422970,
      "end_ms": 424860,
      "text": "或者反正就是结构性的"
    },
    {
      "ordinal": 170,
      "start_ms": 424860,
      "end_ms": 428640,
      "text": "未能良好就业的这些年轻人啊"
    },
    {
      "ordinal": 171,
      "start_ms": 428640,
      "end_ms": 431080,
      "text": "你就要培训好了"
    },
    {
      "ordinal": 172,
      "start_ms": 431680,
      "end_ms": 434020,
      "text": "唉就比较容易找到饭吃啊"
    },
    {
      "ordinal": 173,
      "start_ms": 434020,
      "end_ms": 437159,
      "text": "然后呢你在在家里面培训好"
    },
    {
      "ordinal": 174,
      "start_ms": 437159,
      "end_ms": 439519,
      "text": "然后我我给个模拟面试啊"
    },
    {
      "ordinal": 175,
      "start_ms": 439519,
      "end_ms": 441039,
      "text": "或者说一个测试啊"
    },
    {
      "ordinal": 176,
      "start_ms": 441039,
      "end_ms": 445400,
      "text": "这个之后我们就啊达标的啊"
    },
    {
      "ordinal": 177,
      "start_ms": 445400,
      "end_ms": 448159,
      "text": "我们觉得你来这里肯定能找到工作哦"
    },
    {
      "ordinal": 178,
      "start_ms": 448159,
      "end_ms": 451939,
      "text": "我们甚至可以提前给你把这个床位宿舍安排好"
    },
    {
      "ordinal": 179,
      "start_ms": 451939,
      "end_ms": 457220,
      "text": "你过来直接到厂里去找工作就行了好吧"
    },
    {
      "ordinal": 180,
      "start_ms": 457220,
      "end_ms": 460500,
      "text": "有啥办法给电工降工时涨工资"
    },
    {
      "ordinal": 181,
      "start_ms": 461600,
      "end_ms": 463200,
      "text": "他们工资已经很高了"
    },
    {
      "ordinal": 182,
      "start_ms": 463200,
      "end_ms": 466830,
      "text": "30多个这个一一小时"
    },
    {
      "ordinal": 183,
      "start_ms": 466830,
      "end_ms": 468990,
      "text": "甚至有40多个一小时的"
    },
    {
      "ordinal": 184,
      "start_ms": 468990,
      "end_ms": 471190,
      "text": "他们哼哼哼哼赚钱了"
    },
    {
      "ordinal": 185,
      "start_ms": 471190,
      "end_ms": 472630,
      "text": "他们愿意降工时吗"
    },
    {
      "ordinal": 186,
      "start_ms": 472630,
      "end_ms": 475750,
      "text": "他们不愿意不愿意降工时的"
    },
    {
      "ordinal": 187,
      "start_ms": 477820,
      "end_ms": 482270,
      "text": "好吧这个是一个呃我们要铺开来去"
    },
    {
      "ordinal": 188,
      "start_ms": 482270,
      "end_ms": 484770,
      "text": "就是战略思路是这样的"
    },
    {
      "ordinal": 189,
      "start_ms": 484770,
      "end_ms": 486750,
      "text": "这个行业是一个巨大的"
    },
    {
      "ordinal": 190,
      "start_ms": 486750,
      "end_ms": 489640,
      "text": "这个海绵能吸好多水啊"
    },
    {
      "ordinal": 191,
      "start_ms": 489640,
      "end_ms": 490920,
      "text": "我们能不能把它刺穿"
    },
    {
      "ordinal": 192,
      "start_ms": 490920,
      "end_ms": 493620,
      "text": "或者说对于这个资本主义的生产纪律"
    },
    {
      "ordinal": 193,
      "start_ms": 493620,
      "end_ms": 495330,
      "text": "形成某种影响"
    },
    {
      "ordinal": 194,
      "start_ms": 495330,
      "end_ms": 501070,
      "text": "就看我们能不能批量的大规模的培训出这个呃"
    },
    {
      "ordinal": 195,
      "start_ms": 501070,
      "end_ms": 502710,
      "text": "这方面的电工人才啊"
    },
    {
      "ordinal": 196,
      "start_ms": 502710,
      "end_ms": 503390,
      "text": "装配电工啊"
    },
    {
      "ordinal": 197,
      "start_ms": 503390,
      "end_ms": 504230,
      "text": "POC电工啊"
    },
    {
      "ordinal": 198,
      "start_ms": 504230,
      "end_ms": 508280,
      "text": "啊这个维修电工啊"
    },
    {
      "ordinal": 199,
      "start_ms": 509820,
      "end_ms": 513580,
      "text": "然后把这一个单一行业给他卷出来"
    },
    {
      "ordinal": 200,
      "start_ms": 513580,
      "end_ms": 514460,
      "text": "卷的呢"
    },
    {
      "ordinal": 201,
      "start_ms": 514460,
      "end_ms": 515500,
      "text": "就是说"
    },
    {
      "ordinal": 202,
      "start_ms": 515500,
      "end_ms": 520190,
      "text": "而且这里面就会有很多是受到我们的影响的啊"
    },
    {
      "ordinal": 203,
      "start_ms": 520190,
      "end_ms": 521710,
      "text": "啊别笑了啊"
    },
    {
      "ordinal": 204,
      "start_ms": 521710,
      "end_ms": 522990,
      "text": "然后那个时候再把我逮了"
    },
    {
      "ordinal": 205,
      "start_ms": 522990,
      "end_ms": 523909,
      "text": "治罪不迟啊"
    },
    {
      "ordinal": 206,
      "start_ms": 523909,
      "end_ms": 529270,
      "text": "现在反正目前看来是个利国利民的事好吧"
    },
    {
      "ordinal": 207,
      "start_ms": 531220,
      "end_ms": 531820,
      "text": "行吧"
    },
    {
      "ordinal": 208,
      "start_ms": 531820,
      "end_ms": 534780,
      "text": "那这个消息就先说到这"
    },
    {
      "ordinal": 209,
      "start_ms": 534780,
      "end_ms": 537760,
      "text": "就是我们会这个价格记得是150啊"
    },
    {
      "ordinal": 210,
      "start_ms": 543330,
      "end_ms": 547420,
      "text": "然后那个器具是我们会寄过去哎"
    },
    {
      "ordinal": 211,
      "start_ms": 547420,
      "end_ms": 548340,
      "text": "可以有押金啊"
    },
    {
      "ordinal": 212,
      "start_ms": 548340,
      "end_ms": 549300,
      "text": "或有押金寄过去"
    },
    {
      "ordinal": 213,
      "start_ms": 549300,
      "end_ms": 551069,
      "text": "然后你用完寄回来就行了"
    },
    {
      "ordinal": 214,
      "start_ms": 551069,
      "end_ms": 552909,
      "text": "那个这些东西是不收钱的"
    },
    {
      "ordinal": 215,
      "start_ms": 552909,
      "end_ms": 554269,
      "text": "还有一些免费软件"
    },
    {
      "ordinal": 216,
      "start_ms": 554269,
      "end_ms": 555849,
      "text": "比如说那个什么限号机呀"
    },
    {
      "ordinal": 217,
      "start_ms": 555849,
      "end_ms": 558069,
      "text": "这个东西不可能我寄个真的限号机给你"
    },
    {
      "ordinal": 218,
      "start_ms": 558069,
      "end_ms": 560780,
      "text": "但是我们会开发一个软件啊"
    },
    {
      "ordinal": 219,
      "start_ms": 560780,
      "end_ms": 564660,
      "text": "可以就是在这个按照他那个规则"
    },
    {
      "ordinal": 220,
      "start_ms": 564660,
      "end_ms": 569620,
      "text": "和现实实物一一对应的几把啊"
    },
    {
      "ordinal": 221,
      "start_ms": 569620,
      "end_ms": 570620,
      "text": "那先这样"
    }
