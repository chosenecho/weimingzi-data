{"segments":[{"start":0.68,"end":8.51,"text":"我今天讲这个哲学基础学基础的第一讲八讲啊"},{"start":8.99,"end":11.61,"text":"这个疤横过来就是个无线"},{"start":11.61,"end":14.79,"text":"这样肯定是"},{"start":17.34,"end":19.76,"text":"享乐啊享乐"},{"start":19.76,"end":20.74,"text":"通过享乐"},{"start":20.74,"end":25.06,"text":"我们可以去划分两种哲学"},{"start":37.2,"end":42.0,"text":"哪两种哲学呢啊一种叫做惊喜哲学"},{"start":42.0,"end":46.07,"text":"还有一种哲学叫做叫做镇定性的哲学"},{"start":52.42,"end":54.18,"text":"那么这两种垂直呢"},{"start":54.18,"end":59.24,"text":"甚至我们可以进一步的定义他们的阶级归属"},{"start":60.8,"end":63.76,"text":"资产阶级哲学啊"},{"start":63.76,"end":66.08,"text":"和这个某种意义上讲"},{"start":66.08,"end":69.199,"text":"我们叫做暂时无产性哲学"},{"start":69.199,"end":73.479,"text":"哎你说这个你以前讲的时候都要写"},{"start":73.479,"end":76.14,"text":"那个爱智慧的过度"},{"start":76.34,"end":77.62,"text":"怎么到这一讲"},{"start":77.62,"end":79.68,"text":"但是不讲究这个过度了呢"},{"start":79.68,"end":84.02,"text":"因为这里享乐哲学作为一种享乐啊"},{"start":86.94,"end":88.22,"text":"哲学作为一种享受"},{"start":89.46,"end":92.03,"text":"它就不再具有过渡性"},{"start":92.03,"end":94.09,"text":"它就具有他的直接性"},{"start":94.09,"end":97.32,"text":"那么但是他的直接性是片面的"},{"start":97.32,"end":99.74,"text":"这样的哲学要么他们作为爱"},{"start":99.74,"end":101.64,"text":"要么他们作为智慧"},{"start":101.64,"end":106.06,"text":"但是呢他又同时是什"},{"start":108.48,"end":111.68,"text":"嗯考试是作为爱好者的"},{"start":111.68,"end":114.099,"text":"你们听着这东西"},{"start":114.099,"end":116.139,"text":"有没有大致的有一些自己的想法"},{"start":117.379,"end":120.399,"text":"这个端倪从这个端倪出发"},{"start":120.399,"end":123.66,"text":"相当于我们在一趟列车上"},{"start":123.66,"end":126.14,"text":"他逐步要驶出这个车站"},{"start":126.14,"end":128.44,"text":"我们已经看到一些远方的景色了"},{"start":128.44,"end":130.13,"text":"预料到没有看到什"},{"start":130.13,"end":131.45,"text":"没看到"},{"start":131.45,"end":133.82,"text":"我再加个名字"},{"start":135.36,"end":137.96,"text":"人类什么时候进入一个普遍享乐的时代"},{"start":139.28,"end":140.84,"text":"或者说"},{"start":141.76,"end":144.48,"text":"啊人类进入了这么一个时代啊"},{"start":146.36,"end":153.19,"text":"命苦病痛带来的这个痛苦是不可忍受的"},{"start":153.19,"end":154.97,"text":"很想治愈他"},{"start":155.02,"end":156.82,"text":"我要注意注意"},{"start":158.74,"end":160.56,"text":"现代医学成熟"},{"start":160.56,"end":163.46,"text":"然后工业化了什么"},{"start":164.4,"end":166.85,"text":"好普遍的工业化还是嗯"},{"start":166.85,"end":168.33,"text":"这个时候人的生活情态"},{"start":168.33,"end":170.41,"text":"发生了一个非常戏剧化的变化"},{"start":170.41,"end":172.6,"text":"就是说有小毛小病"},{"start":172.6,"end":173.3,"text":"痛苦了"},{"start":173.3,"end":173.76,"text":"小猫小"},{"start":173.76,"end":174.98,"text":"你本身不是很重要"},{"start":174.98,"end":176.2,"text":"但是你痛苦也不行"},{"start":176.2,"end":177.44,"text":"不太行"},{"start":177.76,"end":178.96,"text":"你痛苦的话"},{"start":178.96,"end":184.04,"text":"会妨碍你在工业化的分工当中去执行你的分工"},{"start":184.04,"end":188.14,"text":"尤其是工业化对于人的劳动的要求"},{"start":188.14,"end":189.86,"text":"更多的是精细劳动"},{"start":189.86,"end":194.63,"text":"而不是提到更多的是你要去输出你的神经系统"},{"start":194.63,"end":198.84,"text":"高度精密控制之下的这些精准动作"},{"start":198.84,"end":200.5,"text":"怕你在厂里面打螺丝"},{"start":200.5,"end":202.55,"text":"那来了个剑"},{"start":202.55,"end":205.99,"text":"这个螺丝刀拿下来要很精准的戳进它"},{"start":205.99,"end":207.79,"text":"那你必须在很大程度上"},{"start":207.79,"end":212.24,"text":"你的身体和神经性都处在一个稳定的状态"},{"start":212.24,"end":216.53,"text":"不痛苦的相对舒适的一种工业化天然的需要"},{"start":216.53,"end":221.19,"text":"对于人类的整个的神经稳定度"},{"start":221.19,"end":223.31,"text":"精细度的输出"},{"start":224.46,"end":226.14,"text":"提出巨大的需求"},{"start":226.14,"end":228.78,"text":"那么现代医学"},{"start":231.399,"end":233.119,"text":"首先他一定是精准医学"},{"start":234.199,"end":234.619,"text":"对不对"},{"start":234.619,"end":235.679,"text":"而且是非常稳固的"},{"start":235.679,"end":237.599,"text":"现代医学是哪三个标记"},{"start":237.599,"end":239.479,"text":"哪三个东西"},{"start":239.95,"end":242.99,"text":"这个有一般知识就是一抗生素"},{"start":242.99,"end":244.54,"text":"对不对"},{"start":245.22,"end":249.529,"text":"现代医学课或者其实他是他的免疫学"},{"start":250.049,"end":251.689,"text":"首先先来学点抗生素"},{"start":251.689,"end":254.809,"text":"能够把这个侵入到人体的影响"},{"start":254.809,"end":257.769,"text":"人体稳态的在人体的内环境当中"},{"start":257.769,"end":261.209,"text":"可以封装增值的细菌"},{"start":261.209,"end":263.51,"text":"病原体的干掉呃"},{"start":263.51,"end":265.25,"text":"主要代表就抗生素是这样的"},{"start":265.25,"end":269.58,"text":"再进一步的说就是免疫学内环的便宜"},{"start":269.58,"end":273.06,"text":"还有一个是什么手术"},{"start":274.94,"end":277.76,"text":"有了抗生素才可以搞手术"},{"start":277.76,"end":278.84,"text":"对不对"},{"start":278.84,"end":281.94,"text":"因为否则的话疮垫切开来"},{"start":281.94,"end":283.669,"text":"空气当中全是细菌"},{"start":283.77,"end":285.43,"text":"切还得死啊"},{"start":285.43,"end":286.31,"text":"对不对"},{"start":286.31,"end":287.65,"text":"本来不切还好的"},{"start":287.65,"end":288.45,"text":"切还得死"},{"start":288.45,"end":289.95,"text":"除非是那种什么武将"},{"start":289.95,"end":293.49,"text":"我本身就是免疫力很强的嘛"},{"start":293.49,"end":296.95,"text":"切开了之后给它缝好了之后还要熬一宿的吗"},{"start":296.95,"end":298.29,"text":"出大汗了啊"},{"start":298.29,"end":299.05,"text":"热得不得了"},{"start":299.05,"end":300.78,"text":"我这手术"},{"start":300.78,"end":301.86,"text":"现代医学"},{"start":301.86,"end":307.2,"text":"这个通过抗生素使的手术可以普遍推推推展开"},{"start":307.2,"end":311.909,"text":"但是呢还有一个最重要的是什么"},{"start":311.909,"end":313.629,"text":"你是外部的因素"},{"start":313.629,"end":314.889,"text":"排除了做手术"},{"start":314.889,"end":316.789,"text":"但是你人本身很疼的"},{"start":316.789,"end":317.349,"text":"对不对"},{"start":317.349,"end":319.11,"text":"人自己会乱动啊"},{"start":319.11,"end":321.77,"text":"你要把人作为一个冷静的客体"},{"start":321.77,"end":324.62,"text":"客观的客体固定在那边好去操作"},{"start":324.9,"end":325.82,"text":"干什么"},{"start":325.82,"end":326.9,"text":"止止痛药"},{"start":326.9,"end":329.1,"text":"麻醉手术在"},{"start":333.58,"end":338.389,"text":"这三个是现代医学的支柱"},{"start":339.429,"end":340.549,"text":"好像做麻醉术"},{"start":340.549,"end":342.269,"text":"还有手术吧"},{"start":343.48,"end":346.8,"text":"那么在这项东西普及之下"},{"start":347.82,"end":350.72,"text":"现代国家也应运而生"},{"start":350.72,"end":352.88,"text":"其真正意义上的现代国家"},{"start":352.88,"end":357.69,"text":"它是从战争的洗礼当中真正出来的啊"},{"start":357.69,"end":359.94,"text":"战争当中最重要的是啥"},{"start":360.54,"end":361.68,"text":"杀人是吧"},{"start":361.68,"end":365.49,"text":"不是是救治伤兵啊"},{"start":365.49,"end":368.51,"text":"杀人其实是并不是说留下这个现代国家"},{"start":368.51,"end":370.15,"text":"那个主要精神的"},{"start":370.15,"end":372.72,"text":"能有一个战地医院体系"},{"start":372.72,"end":375.48,"text":"能够对于他的这个民众吧"},{"start":375.48,"end":380.15,"text":"或者说在战争当中最大程度上保有了他的"},{"start":380.15,"end":386.49,"text":"我总想这种把人作为可贵的工业部件保存下来"},{"start":386.93,"end":387.91,"text":"这样的鬼啊"},{"start":387.91,"end":390.49,"text":"哦就算他战败"},{"start":390.88,"end":392.38,"text":"他在战败的废墟上面"},{"start":392.38,"end":394.76,"text":"很快又会长出他的工业文明"},{"start":395.4,"end":400.39,"text":"看他整个的这个民族机体当中有新的现代意识"},{"start":400.39,"end":401.55,"text":"这个新的现代意识"},{"start":401.55,"end":406.925,"text":"就是把人类作为最宝贵的工业零部件来"},{"start":408.72,"end":410.8,"text":"生产出来保障好"},{"start":410.8,"end":412.54,"text":"维护好使用它"},{"start":412.54,"end":413.76,"text":"还有一点什么"},{"start":413.76,"end":416.04,"text":"定期淘汰它"},{"start":417.17,"end":421.61,"text":"所以整个享乐要从这个角度去理解"},{"start":422.01,"end":423.47,"text":"要从现代国家"},{"start":423.47,"end":424.85,"text":"现代工业国"},{"start":424.85,"end":431.215,"text":"对于最宝贵的工业零部件的需求去思考"},{"start":432.52,"end":436.0,"text":"那么现代医学在中医上讲它是工业的一部分"},{"start":436.0,"end":437.9,"text":"它是工业化的一部分"},{"start":437.9,"end":440.2,"text":"那我们要讲啊"},{"start":440.65,"end":443.09,"text":"那原价值法律规就不说了啊"},{"start":443.09,"end":444.64,"text":"你也是痛苦"},{"start":444.64,"end":446.64,"text":"那手稿里面就说了啊"},{"start":446.64,"end":450.48,"text":"痛苦还有那种不被满足的需求啊"},{"start":450.48,"end":451.04,"text":"催使污染"},{"start":451.04,"end":452.75,"text":"你出卖他自身"},{"start":453.23,"end":456.7,"text":"这种已经不符合现在的实践了"},{"start":456.7,"end":458.46,"text":"已经不符合现在的观察了"},{"start":458.46,"end":461.54,"text":"无产阶级现在更多的是被什么刺痛"},{"start":461.54,"end":465.61,"text":"但是是对精神共鸣"},{"start":471.82,"end":474.62,"text":"是被精神痛苦驱使的"},{"start":476.34,"end":478.49,"text":"而非直接的肉体痛苦"},{"start":478.49,"end":483.11,"text":"这里面非常具有典型代表性的是什么"},{"start":483.11,"end":484.39,"text":"比如说性压抑"},{"start":484.39,"end":486.57,"text":"性压抑是一种肉体痛苦吗"},{"start":487.16,"end":488.4,"text":"当然不是啊"},{"start":488.4,"end":490.76,"text":"因为你撸管也是在抚慰你自己啊"},{"start":490.76,"end":492.2,"text":"你摸摸你自己身上的肉"},{"start":492.2,"end":494.32,"text":"和女人的肉有多大区别吗"},{"start":494.99,"end":496.67,"text":"它实际上是一种精神痛苦"},{"start":498.15,"end":499.55,"text":"他需要一个意在的身体"},{"start":500.87,"end":504.125,"text":"他需要一个这个审美符号结构起来的一个身体"},{"start":506.8,"end":507.32,"text":"所以"},{"start":509.32,"end":511.909,"text":"这个时候我们要去思考了"},{"start":512.589,"end":517.03,"text":"普遍小应绝大部分的人口"},{"start":517.03,"end":522.28,"text":"他的神经是处在被享乐充盈的镇定状态"},{"start":523.159,"end":531.02,"text":"至少说他能够有序的结构一个感官的领域"},{"start":535.02,"end":540.01,"text":"所以这个时代是一个我们用这话就叫精神病"},{"start":540.01,"end":542.67,"text":"比神经症要要要多的时代"},{"start":542.67,"end":545.99,"text":"精神病理化会导更多的导致精神病"},{"start":545.99,"end":547.71,"text":"就是说不知道自己疯了"},{"start":547.71,"end":550.59,"text":"或者说在官能上感觉不到自己疯了"},{"start":550.59,"end":554.73,"text":"真正的是比如说你眼睛看上面也看不见了"},{"start":554.73,"end":556.75,"text":"或者读那东西我读不出来的"},{"start":556.75,"end":558.89,"text":"这样的精神病的话是较少的"},{"start":558.89,"end":560.79,"text":"就是绝大部分人他的病理话"},{"start":560.79,"end":564.47,"text":"他的痛苦是引发的是一种隐形的"},{"start":564.47,"end":565.97,"text":"他自身察觉不到的"},{"start":565.97,"end":567.14,"text":"他的病况"},{"start":567.14,"end":569.46,"text":"那我回到我们的这个主题上面来讲"},{"start":569.46,"end":573.71,"text":"我现在要就是说爱智慧"},{"start":573.71,"end":574.93,"text":"作为爱智慧的哲学"},{"start":574.93,"end":576.17,"text":"为什么他是分裂的"},{"start":576.17,"end":577.4,"text":"又是同一个"},{"start":578.04,"end":580.12,"text":"首先对于小资产阶级来讲"},{"start":580.12,"end":581.6,"text":"或者对于自然界来讲"},{"start":581.6,"end":585.14,"text":"经济哲学的主要功能是什么"},{"start":585.14,"end":587.14,"text":"现在经济哲学主要功能是什"},{"start":587.47,"end":589.76,"text":"下个"},{"start":593.6,"end":594.84,"text":"围绕什么的想法"},{"start":596.04,"end":597.82,"text":"围绕什么智慧的想法"},{"start":597.82,"end":602.96,"text":"所以我们说它承载了他的似乎不再过度"},{"start":602.96,"end":606.66,"text":"实际上在在过度的这个片面性"},{"start":607.31,"end":609.05,"text":"对于经济哲学来讲的话"},{"start":609.05,"end":613.39,"text":"他始终认为自己是直接就在消费这之中"},{"start":613.39,"end":615.47,"text":"在享用这之中"},{"start":615.95,"end":617.87,"text":"那么为什么会在"},{"start":617.87,"end":621.79,"text":"你为什么会对经济学类会出现需求呢"},{"start":622.9,"end":627.24,"text":"或者说我们把这个范围再放大一点小分也行"},{"start":629.46,"end":631.22,"text":"为什么他们需要哲学死"},{"start":632.54,"end":635.06,"text":"因为他们的身体毫无痛苦"},{"start":636.53,"end":641.33,"text":"因为他们是无无痛阶级的"},{"start":644.82,"end":647.44,"text":"因为他是无统阶级"},{"start":647.44,"end":652.52,"text":"所以他们一定需要哲学来制造恐怖"},{"start":654.06,"end":655.06,"text":"在这个意义上讲"},{"start":655.06,"end":659.7,"text":"他们的爱情也是更加精致的"},{"start":660.82,"end":662.98,"text":"爱情的结构更加复杂"},{"start":664.38,"end":666.7,"text":"这个痛点就是肉体痛苦啊"},{"start":667.3,"end":671.76,"text":"就是在现代文明的普遍享乐的基础上"},{"start":671.76,"end":675.07,"text":"小三阶级和自然连结是事实上的无痛阶级"},{"start":675.07,"end":678.05,"text":"他们的肉体不需要承担几乎所有的痛苦"},{"start":678.05,"end":678.99,"text":"就是空调啊"},{"start":678.99,"end":682.63,"text":"人家美国可能什么197几年就撞车了"},{"start":682.63,"end":683.33,"text":"压缩机嘛"},{"start":684.33,"end":689.09,"text":"这不就是什么福利阳什么啊"},{"start":689.09,"end":691.97,"text":"什么压缩机在它会放热是吧"},{"start":691.97,"end":696.17,"text":"对用用热量可换换它的温度变化吗"},{"start":698.24,"end":703.26,"text":"在他们那里爱实际上就是享乐吧"},{"start":703.26,"end":707.87,"text":"哲学对我们来讲就是以智慧本身作为想象对象"},{"start":710.919,"end":714.599,"text":"而且这样的经济哲学它往往是怎么样"},{"start":714.599,"end":720.0,"text":"他的演绎顺序是从成熟"},{"start":721.78,"end":723.56,"text":"盗用指示"},{"start":727.36,"end":732.6,"text":"就是说我们说的在越南是从智慧到讲究"},{"start":738.82,"end":743.54,"text":"或者说是通过复杂的繁复的智慧论证体系"},{"start":743.54,"end":745.96,"text":"给他的初阶享受做辩护"},{"start":745.96,"end":748.41,"text":"就是最近在播华华的兄弟"},{"start":748.41,"end":750.89,"text":"就是以那种文化圈子"},{"start":750.89,"end":755.77,"text":"法国哲学的那样一个精巧精密智慧"},{"start":756.46,"end":759.06,"text":"然后进行精神上的退行"},{"start":759.06,"end":763.85,"text":"总体上我把这个整个这些后现代哲学评价"},{"start":763.85,"end":766.89,"text":"我是第二个从成熟到幼稚的退行"},{"start":766.89,"end":770.24,"text":"或者说是从智慧到享受的退行"},{"start":770.24,"end":775.64,"text":"他终究发现自己这些激进性围绕什么主理性啊"},{"start":775