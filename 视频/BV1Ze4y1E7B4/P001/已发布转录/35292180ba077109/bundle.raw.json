{"segments":[{"start":0.0,"end":1.86,"text":"我今天来回应信件"},{"start":2.36,"end":4.72,"text":"他说可以公开啊"},{"start":4.72,"end":6.64,"text":"他叫邓家潮"},{"start":6.88,"end":7.6,"text":"你好"},{"start":10.06,"end":10.24,"text":"性"},{"start":10.24,"end":13.62,"text":"之前在在读某中流985大学"},{"start":15.42,"end":18.49,"text":"和学校的规训化活动而休学了"},{"start":18.49,"end":21.04,"text":"因为我的父母沉迷于资本增值的活动"},{"start":21.04,"end":22.98,"text":"我一直只为管饱"},{"start":22.98,"end":23.64,"text":"除此以外"},{"start":23.64,"end":24.93,"text":"我除了沉迷网络之外"},{"start":24.93,"end":26.34,"text":"没有参与过任何社会实践"},{"start":26.34,"end":27.76,"text":"对此深感惭愧"},{"start":28.0,"end":29.26,"text":"不过从今天开始"},{"start":29.26,"end":31.78,"text":"我决定为人类解放事业贡献自己的一份力"},{"start":31.78,"end":33.82,"text":"但我却不知道走上这条路以后"},{"start":33.82,"end":35.5,"text":"我究竟应该具体做什么"},{"start":35.5,"end":37.019,"text":"我基本没有什么欲望"},{"start":37.019,"end":38.279,"text":"可以过很亲民的生活"},{"start":38.279,"end":39.419,"text":"我和家里人讨论过"},{"start":39.419,"end":41.759,"text":"家里可以为我提供一片场地"},{"start":41.759,"end":44.18,"text":"我是否应该向你那样开酒吧"},{"start":44.18,"end":46.22,"text":"可是好像我有的场地也做不了什么"},{"start":46.22,"end":49.92,"text":"我在家人朋友间尝试多次寻找同伴也无果"},{"start":49.92,"end":52.26,"text":"还是我应该回到大学混文凭"},{"start":52.26,"end":53.16,"text":"但一个学术文明"},{"start":53.16,"end":54.48,"text":"对我们共同自己有多少帮助"},{"start":54.48,"end":55.35,"text":"我也不明白"},{"start":55.35,"end":57.45,"text":"我不想在一个人上人的环境生活"},{"start":57.45,"end":58.77,"text":"我也不想出卖脑力"},{"start":58.77,"end":60.15,"text":"对此我很想知道你的看法"},{"start":60.15,"end":61.65,"text":"以及你到底会做什么"},{"start":61.65,"end":62.19,"text":"在做什么"},{"start":62.19,"end":64.36,"text":"因为我在网上看到什么"},{"start":64.36,"end":66.01,"text":"什么等词汇来描述你"},{"start":66.01,"end":67.3,"text":"如果我不害怕这些"},{"start":67.3,"end":70.9,"text":"我要如何为这些运动提供我的力量呢"},{"start":70.9,"end":72.1,"text":"我从现在起"},{"start":72.1,"end":75.98,"text":"又该如何汇集力量来为将来做准备呢"},{"start":76.46,"end":78.74,"text":"我祝愿同志们的事业顺利"},{"start":78.74,"end":79.46,"text":"这是我的手机号"},{"start":79.46,"end":80.12,"text":"哒哒哒"},{"start":80.12,"end":81.68,"text":"如果我的情况具有普遍性"},{"start":81.68,"end":83.36,"text":"我很乐意公开我的信件"},{"start":83.36,"end":86.68,"text":"就是对于这位呢啊什么他手机号给了"},{"start":86.68,"end":87.72,"text":"先拍个照啊"},{"start":88.68,"end":90.39,"text":"呃对于这位老哥"},{"start":90.39,"end":91.44,"text":"我给的建议啊"},{"start":91.44,"end":94.72,"text":"就是说你可以开个餐馆儿啊"},{"start":94.72,"end":97.16,"text":"一个人哪怕你一个人"},{"start":97.68,"end":99.45,"text":"你就学我的模式呗"},{"start":99.45,"end":100.26,"text":"开个餐馆"},{"start":100.26,"end":105.94,"text":"然后呢呃星期123567做生意赚钱"},{"start":105.94,"end":111.44,"text":"星期四免费为周围的呃底层劳动者啊"},{"start":111.44,"end":113.41,"text":"赤贫劳动者无产者"},{"start":113.41,"end":114.67,"text":"但是得劳动者啊"},{"start":114.67,"end":115.42,"text":"他得劳动"},{"start":115.42,"end":117.85,"text":"他得用体力换取生生存资料啊"},{"start":117.85,"end":121.51,"text":"最好是用体力或者重复性的压迫性的脑力"},{"start":121.51,"end":122.95,"text":"折磨性的脑力"},{"start":122.95,"end":125.2,"text":"体力劳动者和底层脑力劳动者"},{"start":125.2,"end":127.7,"text":"可以给他们免费提供一餐饭"},{"start":128.639,"end":130.249,"text":"你不是有个场地吗"},{"start":130.249,"end":131.479,"text":"如果你做成的话"},{"start":131.479,"end":133.459,"text":"你可以申请加入我们啊"},{"start":133.459,"end":134.8,"text":"申请加入我们"},{"start":146.919,"end":147.879,"text":"不要老问我啊"},{"start":147.879,"end":148.929,"text":"自己多去学"},{"start":148.929,"end":150.699,"text":"自己多学啊"},{"start":150.699,"end":152.979,"text":"把实践和这个理论结合到一起"},{"start":152.979,"end":157.94,"text":"多和人民群众交流啊啊啊打成一片啊"},{"start":157.94,"end":159.24,"text":"那就讲到这边好吧"}],"source":"subtitle"}
