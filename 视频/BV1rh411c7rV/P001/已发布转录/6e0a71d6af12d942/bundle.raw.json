{"segments":[{"start":0.24,"end":3.96,"text":"开始啊我们集中回应信件啊"},{"start":4.88,"end":9.3,"text":"呃可公开一封是一个小朋友写的"},{"start":11.899,"end":12.98,"text":"姓管"},{"start":14.8,"end":16.8,"text":"他说魏明子你好"},{"start":16.8,"end":19.78,"text":"我是一名杭州的普高高二学生"},{"start":20.0,"end":21.74,"text":"我的父亲是工厂工人"},{"start":21.74,"end":23.54,"text":"我的母亲是酒店服务员"},{"start":26.19,"end":30.3,"text":"那么在我初二那年得了一个疾病"},{"start":30.58,"end":33.44,"text":"根据我的理解"},{"start":33.44,"end":40.24,"text":"应该是初中时在学校排球校队训练过于辛苦"},{"start":40.24,"end":42.22,"text":"导致没有体力在网上学习"},{"start":42.22,"end":44.41,"text":"于是退出训练之后呢"},{"start":44.41,"end":47.93,"text":"这个身体的机能下降"},{"start":47.93,"end":51.35,"text":"但是仍保持原来高度的自主刷题学习"},{"start":51.35,"end":55.7,"text":"再加上小时候爸爸妈妈没钱买房"},{"start":55.7,"end":60.58,"text":"寄宿在他可能是到城市里面打工的吧"},{"start":61.38,"end":63.62,"text":"他在城市上学"},{"start":63.78,"end":65.099,"text":"杭州嘛"},{"start":65.099,"end":67.14,"text":"然后寄宿在伯父家"},{"start":67.14,"end":69.84,"text":"形成了压抑的性格啊"},{"start":69.84,"end":72.619,"text":"最终形成了疾病"},{"start":72.8,"end":76.88,"text":"此后啊我一直都有焦虑"},{"start":76.88,"end":81.31,"text":"以上是我对这类疾病的成因的理解"},{"start":81.31,"end":83.47,"text":"疾病带给我很大的影响"},{"start":83.47,"end":88.22,"text":"我初二以后这个精力大不如前啊"},{"start":88.22,"end":89.48,"text":"本来学习成绩很好"},{"start":89.48,"end":92.12,"text":"老师认为我可以去重点高中"},{"start":92.12,"end":94.78,"text":"但是初三那年没有经历刷卷子"},{"start":94.78,"end":96.58,"text":"也经常请假回家休息"},{"start":96.58,"end":99.92,"text":"最后考上了一所普高"},{"start":100.14,"end":102.75,"text":"那么在这5年期间啊"},{"start":102.75,"end":104.04,"text":"我的病情有所好转"},{"start":104.04,"end":104.88,"text":"也吃了很多药"},{"start":104.88,"end":108.99,"text":"但大脑精力少仍然是我学习的主要影响因素"},{"start":108.99,"end":110.91,"text":"再加上是普高"},{"start":110.91,"end":113.73,"text":"我的任课老师一半是缺乏经验"},{"start":113.73,"end":116.05,"text":"对题目没有研究的年轻老师"},{"start":116.05,"end":117.85,"text":"由于以上两个原因"},{"start":117.85,"end":119.17,"text":"我对考上重点大学"},{"start":119.17,"end":122.22,"text":"将来实现阶级跃升的希望算是破裂了"},{"start":122.58,"end":124.02,"text":"