{
  "bvid": "BV15y4y1k72L",
  "page": 1,
  "source": "subtitle-cc",
  "language": "zh-CN",
  "model": null,
  "content_sha256": "d0fe61327a39c6f9e9c98c79af07d19023dd0848d94323b963454afe05b2ba46",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 1480,
      "end_ms": 2240,
      "text": "从今天开始"
    },
    {
      "ordinal": 1,
      "start_ms": 2240,
      "end_ms": 4080,
      "text": "我们要讲一个专题"
    },
    {
      "ordinal": 2,
      "start_ms": 4080,
      "end_ms": 5920,
      "text": "我手上拿这个漏斗是三分钟的"
    },
    {
      "ordinal": 3,
      "start_ms": 5960,
      "end_ms": 9880,
      "text": "我以后所有的内容"
    },
    {
      "ordinal": 4,
      "start_ms": 9880,
      "end_ms": 12200,
      "text": "都会尽量在三分钟之内讲完"
    },
    {
      "ordinal": 5,
      "start_ms": 12200,
      "end_ms": 14240,
      "text": "我们这个专题讲的就是辩证法"
    },
    {
      "ordinal": 6,
      "start_ms": 14240,
      "end_ms": 15960,
      "text": "然后我国教科书体系里面"
    },
    {
      "ordinal": 7,
      "start_ms": 15960,
      "end_ms": 16560,
      "text": "叫做辩证法"
    },
    {
      "ordinal": 8,
      "start_ms": 16560,
      "end_ms": 17720,
      "text": "实际上是假的"
    },
    {
      "ordinal": 9,
      "start_ms": 17720,
      "end_ms": 18560,
      "text": "它不是辩证法啊"
    },
    {
      "ordinal": 10,
      "start_ms": 18600,
      "end_ms": 19760,
      "text": "实际上都是"
    },
    {
      "ordinal": 11,
      "start_ms": 20840,
      "end_ms": 22000,
      "text": "都诡辩骗骗人的"
    },
    {
      "ordinal": 12,
      "start_ms": 22280,
      "end_ms": 23520,
      "text": "它骗人的"
    },
    {
      "ordinal": 13,
      "start_ms": 26080,
      "end_ms": 27320,
      "text": "教科书"
    },
    {
      "ordinal": 14,
      "start_ms": 27320,
      "end_ms": 28480,
      "text": "我国的教科书里面讲的"
    },
    {
      "ordinal": 15,
      "start_ms": 28480,
      "end_ms": 28920,
      "text": "辩证法"
    },
    {
      "ordinal": 16,
      "start_ms": 28920,
      "end_ms": 29760,
      "text": "实际上很简单"
    },
    {
      "ordinal": 17,
      "start_ms": 29800,
      "end_ms": 33560,
      "text": "它概括起来就是整体主义"
    },
    {
      "ordinal": 18,
      "start_ms": 33600,
      "end_ms": 35520,
      "text": "它叫你看问题"
    },
    {
      "ordinal": 19,
      "start_ms": 35520,
      "end_ms": 36240,
      "text": "不要片面对不对"
    },
    {
      "ordinal": 20,
      "start_ms": 36240,
      "end_ms": 37680,
      "text": "要看整体的话"
    },
    {
      "ordinal": 21,
      "start_ms": 37680,
      "end_ms": 39360,
      "text": "就容易把你自己的利益"
    },
    {
      "ordinal": 22,
      "start_ms": 39360,
      "end_ms": 41520,
      "text": "把你自己的立场给牺牲掉"
    },
    {
      "ordinal": 23,
      "start_ms": 41560,
      "end_ms": 42400,
      "text": "辩证法不是这样的"
    },
    {
      "ordinal": 24,
      "start_ms": 42400,
      "end_ms": 43920,
      "text": "辩证法不是要你"
    },
    {
      "ordinal": 25,
      "start_ms": 43920,
      "end_ms": 44960,
      "text": "牺牲你自己的利益"
    },
    {
      "ordinal": 26,
      "start_ms": 44960,
      "end_ms": 46200,
      "text": "不要你舍弃小我"
    },
    {
      "ordinal": 27,
      "start_ms": 46200,
      "end_ms": 47480,
      "text": "然后成就大我的"
    },
    {
      "ordinal": 28,
      "start_ms": 49480,
      "end_ms": 51480,
      "text": "我直接说辩证法是什么吧辩证法"
    },
    {
      "ordinal": 29,
      "start_ms": 52200,
      "end_ms": 53520,
      "text": "很简单正题"
    },
    {
      "ordinal": 30,
      "start_ms": 53520,
      "end_ms": 54720,
      "text": "如果是A的话反题"
    },
    {
      "ordinal": 31,
      "start_ms": 54720,
      "end_ms": 57920,
      "text": "那么一般是非A，就是对A的否定"
    },
    {
      "ordinal": 32,
      "start_ms": 58480,
      "end_ms": 59480,
      "text": "那么我们就要问"
    },
    {
      "ordinal": 33,
      "start_ms": 59520,
      "end_ms": 60520,
      "text": "它的合题是什么"
    },
    {
      "ordinal": 34,
      "start_ms": 61440,
      "end_ms": 62400,
      "text": "正反合"
    },
    {
      "ordinal": 35,
      "start_ms": 62920,
      "end_ms": 65800,
      "text": "正题是A，反题是非A"
    },
    {
      "ordinal": 36,
      "start_ms": 65800,
      "end_ms": 67200,
      "text": "那么我们一般会认为"
    },
    {
      "ordinal": 37,
      "start_ms": 67200,
      "end_ms": 69680,
      "text": "它的合题应该是A加上非A"
    },
    {
      "ordinal": 38,
      "start_ms": 69680,
      "end_ms": 70760,
      "text": "对不对"
    },
    {
      "ordinal": 39,
      "start_ms": 71080,
      "end_ms": 72600,
      "text": "你既能变成"
    },
    {
      "ordinal": 40,
      "start_ms": 72960,
      "end_ms": 75240,
      "text": "既有A又有非A，是两个"
    },
    {
      "ordinal": 41,
      "start_ms": 75520,
      "end_ms": 77000,
      "text": "结合起来的一个大全"
    },
    {
      "ordinal": 42,
      "start_ms": 77000,
      "end_ms": 78040,
      "text": "A是片面的"
    },
    {
      "ordinal": 43,
      "start_ms": 78040,
      "end_ms": 79080,
      "text": "非A也是片面的"
    },
    {
      "ordinal": 44,
      "start_ms": 79080,
      "end_ms": 80080,
      "text": "这两个结合起来"
    },
    {
      "ordinal": 45,
      "start_ms": 80080,
      "end_ms": 80880,
      "text": "它才是"
    },
    {
      "ordinal": 46,
      "start_ms": 81400,
      "end_ms": 83160,
      "text": "它才是一个完整的东西"
    },
    {
      "ordinal": 47,
      "start_ms": 84080,
      "end_ms": 85400,
      "text": "这不是辩证法"
    },
    {
      "ordinal": 48,
      "start_ms": 85640,
      "end_ms": 88920,
      "text": "你如果说这里的反题是非A"
    },
    {
      "ordinal": 49,
      "start_ms": 88920,
      "end_ms": 90960,
      "text": "A（之外）的其他东西"
    },
    {
      "ordinal": 50,
      "start_ms": 90960,
      "end_ms": 92400,
      "text": "比如说反题是B"
    },
    {
      "ordinal": 51,
      "start_ms": 92400,
      "end_ms": 93520,
      "text": "那么所谓的合题"
    },
    {
      "ordinal": 52,
      "start_ms": 93560,
      "end_ms": 94760,
      "text": "就是A+B吗"
    },
    {
      "ordinal": 53,
      "start_ms": 94800,
      "end_ms": 95520,
      "text": "不是这样的"
    },
    {
      "ordinal": 54,
      "start_ms": 96120,
      "end_ms": 97720,
      "text": "辩证法很简单"
    },
    {
      "ordinal": 55,
      "start_ms": 98280,
      "end_ms": 99160,
      "text": "辩证法很简单"
    },
    {
      "ordinal": 56,
      "start_ms": 99200,
      "end_ms": 102040,
      "text": "但是它需要你思维要动一动"
    },
    {
      "ordinal": 57,
      "start_ms": 102520,
      "end_ms": 104320,
      "text": "你要掌握一种思维模式"
    },
    {
      "ordinal": 58,
      "start_ms": 104320,
      "end_ms": 105960,
      "text": "这个思维模式就叫做"
    },
    {
      "ordinal": 59,
      "start_ms": 107240,
      "end_ms": 108760,
      "text": "你要学会去为一个东西"
    },
    {
      "ordinal": 60,
      "start_ms": 108800,
      "end_ms": 110080,
      "text": "创造它的镜像"
    },
    {
      "ordinal": 61,
      "start_ms": 111120,
      "end_ms": 113120,
      "text": "镜像，去找到它"
    },
    {
      "ordinal": 62,
      "start_ms": 113160,
      "end_ms": 115160,
      "text": "自己分裂的东西"
    },
    {
      "ordinal": 63,
      "start_ms": 115160,
      "end_ms": 117440,
      "text": "它自己内在的不一致性"
    },
    {
      "ordinal": 64,
      "start_ms": 118040,
      "end_ms": 119080,
      "text": "我这样说"
    },
    {
      "ordinal": 65,
      "start_ms": 120400,
      "end_ms": 122600,
      "text": "它的合题就是A本身"
    },
    {
      "ordinal": 66,
      "start_ms": 122680,
      "end_ms": 123240,
      "text": "为什么？？"
    },
    {
      "ordinal": 67,
      "start_ms": 123240,
      "end_ms": 124480,
      "text": "他的合题就是A呢"
    },
    {
      "ordinal": 68,
      "start_ms": 124520,
      "end_ms": 129000,
      "text": "因为这个正题是A，反题是非A对不对"
    },
    {
      "ordinal": 69,
      "start_ms": 130520,
      "end_ms": 132400,
      "text": "你要想所谓的“非A”"
    },
    {
      "ordinal": 70,
      "start_ms": 132440,
      "end_ms": 132880,
      "text": "就是说"
    },
    {
      "ordinal": 71,
      "start_ms": 132880,
      "end_ms": 134560,
      "text": "和A不一样的东西"
    },
    {
      "ordinal": 72,
      "start_ms": 134640,
      "end_ms": 137000,
      "text": "但是当我们把 A写到纸上去的"
    },
    {
      "ordinal": 73,
      "start_ms": 137000,
      "end_ms": 137480,
      "text": "时候"
    },
    {
      "ordinal": 74,
      "start_ms": 137520,
      "end_ms": 138600,
      "text": "当我们把这个东西"
    },
    {
      "ordinal": 75,
      "start_ms": 138600,
      "end_ms": 141080,
      "text": "用一个符号A来指称它的时候"
    },
    {
      "ordinal": 76,
      "start_ms": 141640,
      "end_ms": 143520,
      "text": "那么这个符号A本身"
    },
    {
      "ordinal": 77,
      "start_ms": 144160,
      "end_ms": 146640,
      "text": "这个符号本身和 A这个东西"
    },
    {
      "ordinal": 78,
      "start_ms": 146640,
      "end_ms": 147040,
      "text": "本身"
    },
    {
      "ordinal": 79,
      "start_ms": 147040,
      "end_ms": 148840,
      "text": "它实际上已经是两个东西了"
    },
    {
      "ordinal": 80,
      "start_ms": 148840,
      "end_ms": 151080,
      "text": "它相互之间是有差异存在的"
    },
    {
      "ordinal": 81,
      "start_ms": 151720,
      "end_ms": 155520,
      "text": "所以它的合题不需要是A加上非A"
    },
    {
      "ordinal": 82,
      "start_ms": 155520,
      "end_ms": 156040,
      "text": "它的合题"
    },
    {
      "ordinal": 83,
      "start_ms": 156080,
      "end_ms": 157600,
      "text": "只要是A就行了"
    },
    {
      "ordinal": 84,
      "start_ms": 157600,
      "end_ms": 159160,
      "text": "因为A就代表了"
    },
    {
      "ordinal": 85,
      "start_ms": 159240,
      "end_ms": 162400,
      "text": "这个东西本身和符号A之间的"
    },
    {
      "ordinal": 86,
      "start_ms": 162400,
      "end_ms": 163360,
      "text": "那种分裂"
    },
    {
      "ordinal": 87,
      "start_ms": 163400,
      "end_ms": 164760,
      "text": "你把 A写在这边"
    },
    {
      "ordinal": 88,
      "start_ms": 164760,
      "end_ms": 166080,
      "text": "就代表的东西"
    },
    {
      "ordinal": 89,
      "start_ms": 166120,
      "end_ms": 168920,
      "text": "而且这样你可以理解"
    },
    {
      "ordinal": 90,
      "start_ms": 169200,
      "end_ms": 170240,
      "text": "比如说你的名字"
    },
    {
      "ordinal": 91,
      "start_ms": 170240,
      "end_ms": 172920,
      "text": "和你本身就是分裂的"
    },
    {
      "ordinal": 92,
      "start_ms": 174040,
      "end_ms": 174800,
      "text": "三分钟已经到了"
    },
    {
      "ordinal": 93,
      "start_ms": 174840,
      "end_ms": 175840,
      "text": "但是我漏斗感觉"
    },
    {
      "ordinal": 94,
      "start_ms": 175880,
      "end_ms": 177200,
      "text": "我买了个劣质漏斗"
    },
    {
      "ordinal": 95,
      "start_ms": 177200,
      "end_ms": 178720,
      "text": "它三分钟比三分钟长"
    },
    {
      "ordinal": 96,
      "start_ms": 179560,
      "end_ms": 181280,
      "text": "所以辩证法的核心观念"
    },
    {
      "ordinal": 97,
      "start_ms": 181280,
      "end_ms": 183800,
      "text": "就是发现那个东西的内在分裂"
    },
    {
      "ordinal": 98,
      "start_ms": 183800,
      "end_ms": 185960,
      "text": "它自己本身和自己的矛盾"
    },
    {
      "ordinal": 99,
      "start_ms": 186400,
      "end_ms": 187400,
      "text": "这就是辩证法"
    },
    {
      "ordinal": 100,
      "start_ms": 187440,
      "end_ms": 188960,
      "text": "然后把这个东西（矛盾）摆出来"
    },
    {
      "ordinal": 101,
      "start_ms": 189320,
      "end_ms": 190440,
      "text": "它就是合题"
    },
    {
      "ordinal": 102,
      "start_ms": 190480,
      "end_ms": 191960,
      "text": "抓住它的内在矛盾"
    },
    {
      "ordinal": 103,
      "start_ms": 191960,
      "end_ms": 195040,
      "text": "就是辩证法的思维的要点所在"
    },
    {
      "ordinal": 104,
      "start_ms": 195560,
      "end_ms": 196520,
      "text": "所谓的合题"
    },
    {
      "ordinal": 105,
      "start_ms": 196520,
      "end_ms": 197680,
      "text": "就是这个东西本身"
    },
    {
      "ordinal": 106,
      "start_ms": 197720,
      "end_ms": 198380,
      "text": "不需要否定"
    },
    {
      "ordinal": 107,
      "start_ms": 198380,
      "end_ms": 199840,
      "text": "它会否定它自己的"
    },
    {
      "ordinal": 108,
      "start_ms": 199840,
      "end_ms": 201480,
      "text": "它内在地否定他自己的"
    },
    {
      "ordinal": 109,
      "start_ms": 202880,
      "end_ms": 203560,
      "text": "那就这样"
    }
  ],
  "text": "从今天开始\n我们要讲一个专题\n我手上拿这个漏斗是三分钟的\n我以后所有的内容\n都会尽量在三分钟之内讲完\n我们这个专题讲的就是辩证法\n然后我国教科书体系里面\n叫做辩证法\n实际上是假的\n它不是辩证法啊\n实际上都是\n都诡辩骗骗人的\n它骗人的\n教科书\n我国的教科书里面讲的\n辩证法\n实际上很简单\n它概括起来就是整体主义\n它叫你看问题\n不要片面对不对\n要看整体的话\n就容易把你自己的利益\n把你自己的立场给牺牲掉\n辩证法不是这样的\n辩证法不是要你\n牺牲你自己的利益\n不要你舍弃小我\n然后成就大我的\n我直接说辩证法是什么吧辩证法\n很简单正题\n如果是A的话反题\n那么一般是非A，就是对A的否定\n那么我们就要问\n它的合题是什么\n正反合\n正题是A，反题是非A\n那么我们一般会认为\n它的合题应该是A加上非A\n对不对\n你既能变成\n既有A又有非A，是两个\n结合起来的一个大全\nA是片面的\n非A也是片面的\n这两个结合起来\n它才是\n它才是一个完整的东西\n这不是辩证法\n你如果说这里的反题是非A\nA（之外）的其他东西\n比如说反题是B\n那么所谓的合题\n就是A+B吗\n不是这样的\n辩证法很简单\n辩证法很简单\n但是它需要你思维要动一动\n你要掌握一种思维模式\n这个思维模式就叫做\n你要学会去为一个东西\n创造它的镜像\n镜像，去找到它\n自己分裂的东西\n它自己内在的不一致性\n我这样说\n它的合题就是A本身\n为什么？？\n他的合题就是A呢\n因为这个正题是A，反题是非A对不对\n你要想所谓的“非A”\n就是说\n和A不一样的东西\n但是当我们把 A写到纸上去的\n时候\n当我们把这个东西\n用一个符号A来指称它的时候\n那么这个符号A本身\n这个符号本身和 A这个东西\n本身\n它实际上已经是两个东西了\n它相互之间是有差异存在的\n所以它的合题不需要是A加上非A\n它的合题\n只要是A就行了\n因为A就代表了\n这个东西本身和符号A之间的\n那种分裂\n你把 A写在这边\n就代表的东西\n而且这样你可以理解\n比如说你的名字\n和你本身就是分裂的\n三分钟已经到了\n但是我漏斗感觉\n我买了个劣质漏斗\n它三分钟比三分钟长\n所以辩证法的核心观念\n就是发现那个东西的内在分裂\n它自己本身和自己的矛盾\n这就是辩证法\n然后把这个东西（矛盾）摆出来\n它就是合题\n抓住它的内在矛盾\n就是辩证法的思维的要点所在\n所谓的合题\n就是这个东西本身\n不需要否定\n它会否定它自己的\n它内在地否定他自己的\n那就这样",
  "timing_issue": null
}
