{"segments":[{"start":0.0,"end":1.48,"text":"我们今天要来讲这个"},{"start":3.64,"end":8.24,"text":"这个革命的三元丹法啊"},{"start":8.24,"end":10.64,"text":"他的这个小周天运行"},{"start":12.24,"end":14.4,"text":"小周天运行啊"},{"start":20.04,"end":23.6,"text":"的大三元丹法"},{"start":26.6,"end":28.58,"text":"小周天"},{"start":31.84,"end":36.22,"text":"那我直接把学到的说是什么了"},{"start":36.22,"end":37.68,"text":"关元穴啊"},{"start":37.68,"end":39.1,"text":"就是丹田下丹田"},{"start":39.1,"end":41.86,"text":"这就是你的情欲"},{"start":43.46,"end":45.02,"text":"从情欲出发"},{"start":45.02,"end":48.06,"text":"然后伪旅学是"},{"start":61.38,"end":62.86,"text":"情欲出发"},{"start":67.89,"end":70.21,"text":"实现性关系"},{"start":72.08,"end":77.02,"text":"就是我们之前讲过督脉运行相当于什么"},{"start":77.02,"end":80.93,"text":"相当于两人关系当中的一个个难关"},{"start":84.52,"end":88.18,"text":"任脉回来的运行相当于两人关系"},{"start":88.18,"end":89.0,"text":"情感关系"},{"start":89.0,"end":89.8,"text":"情欲关系"},{"start":89.8,"end":93.81,"text":"性关系当中的一个个比较美好的部分啊"},{"start":93.81,"end":98.22,"text":"啊一桩桩美式啊"},{"start":103.66,"end":105.06,"text":"他指的就是性关系"},{"start":105.06,"end":107.99,"text":"直接就是肉体关系"},{"start":107.99,"end":109.43,"text":"这是第一个不可能性"},{"start":109.43,"end":110.77,"text":"就是性吸引啊"},{"start":110.77,"end":112.59,"text":"性吸引"},{"start":118.32,"end":120.06,"text":"然后到伪女学"},{"start":120.06,"end":123.92,"text":"这个时候是信忠臣"},{"start":125.56,"end":127.56,"text":"两人不仅有性吸引"},{"start":127.56,"end":132.19,"text":"还能两人实现性对等的性忠诚啊"},{"start":133.27,"end":134.53,"text":"获得这个信忠诚"},{"start":134.53,"end":137.31,"text":"然后呢到了命门穴"},{"start":137.31,"end":140.13,"text":"这里是两人行程是什么啊"},{"start":140.13,"end":142.13,"text":"他们的冲突啊"},{"start":142.13,"end":143.41,"text":"主要的冲突"},{"start":143.41,"end":145.97,"text":"这里是两者的是什么"},{"start":145.97,"end":148.86,"text":"命门是什么"},{"start":150.04,"end":153.78,"text":"是他们结构性的困境啊"},{"start":153.78,"end":156.84,"text":"困境家庭困境"},{"start":161.04,"end":165.0,"text":"这个家庭困境往往会呈现为他们的"},{"start":165.0,"end":166.76,"text":"其实就是原生家庭困境啊"},{"start":166.76,"end":171.82,"text":"原生家庭困境呈现为他们的情感缺陷"},{"start":171.82,"end":173.94,"text":"性格缺陷啊"},{"start":178.58,"end":180.14,"text":"啊性格缺陷"},{"start":180.14,"end":183.43,"text":"那么再往上两个人的情感关系"},{"start":183.43,"end":185.67,"text":"就克服了彼此的性格缺陷"},{"start":185.67,"end":186.51,"text":"磨合了"},{"start":186.51,"end":190.209,"text":"也就接受了彼此家原生家庭困境"},{"start":190.569,"end":192.249,"text":"所导致的性格缺陷"},{"start":192.249,"end":196.209,"text":"其实也就是克服了两个家庭相互之间做到的"},{"start":196.209,"end":200.88,"text":"对于这个对方家庭困境的一个一个接纳"},{"start":200.88,"end":201.54,"text":"一个容忍"},{"start":201.54,"end":205.83,"text":"那么再到往上是到了夹脊穴啊"},{"start":205.83,"end":207.19,"text":"夹起去"},{"start":210.52,"end":211.8,"text":"夹脊穴"},{"start":211.8,"end":216.08,"text":"它所对应的是"},{"start":220.7,"end":224.64,"text":"理想的亲密关系啊"},{"start":224.64,"end":225.68,"text":"他是夹脊穴"},{"start":225.68,"end":227.16,"text":"在两星中间嘛"},{"start":227.16,"end":232.35,"text":"所以它对应的是理想的亲密关系啊"},{"start":237.08,"end":242.06,"text":"理想的亲密关系之间的差异要冲破这个难关"},{"start":242.06,"end":247.829,"text":"就是两人要对于理想的亲密关系能达成共识"},{"start":248.309,"end":249.629,"text":"达成共识啊"},{"start":249.629,"end":252.7,"text":"然后再往上的是这个"},{"start":253.92,"end":254.84,"text":"大椎穴"},{"start":256.24,"end":259.7,"text":"大椎穴顾名思义是啊"},{"start":259.7,"end":261.14,"text":"他是这个穴道"},{"start":261.14,"end":264.86,"text":"他是对应的有物质实体凸出来"},{"start":264.86,"end":267.02,"text":"那么大椎穴对应的是什么"},{"start":267.02,"end":268.35,"text":"是"},{"start":271.82,"end":272.82,"text":"财产关系啊"},{"start":274.26,"end":276.1,"text":"财产的差差别"},{"start":276.1,"end":277.82,"text":"财产关系"},{"start":278.57,"end":282.13,"text":"也就是这个时候的性关系开始进入大脑"},{"start":282.13,"end":286.25,"text":"头脑开始正式的要转向婚姻化了啊"},{"start":286.25,"end":288.91,"text":"所以从大椎穴开始往上的"},{"start":288.91,"end":295.589,"text":"所有的这个对于两性关系的运思思考探索"},{"start":295.589,"end":298.86,"text":"就是他的一个周天运行"},{"start":298.86,"end":303.2,"text":"就开始集中到实质阶段了啊"},{"start":303.2,"end":305.38,"text":"实质阶段了"},{"start":306.22,"end":308.87,"text":"大椎穴就是物质准备"},{"start":308.87,"end":310.07,"text":"有钱没钱吧"},{"start":310.07,"end":311.01,"text":"简单来讲啊"},{"start":311.01,"end":312.59,"text":"或者在财富上啊"},{"start":312.59,"end":318.17,"text":"或者在两两方的两个家庭的物质准备上面"},{"start":318.17,"end":320.11,"text":"能不能瞧好啊"},{"start":320.11,"end":322.63,"text":"利利的勾兑上面勾兑好"},{"start":322.63,"end":324.69,"text":"然后再往后面就是玉枕穴"},{"start":324.69,"end":325.71,"text":"风府穴"},{"start":325.71,"end":330.31,"text":"这个代表的是他们的这两个家庭"},{"start":330.31,"end":332.23,"text":"在财产上达成了一致"},{"start":332.23,"end":333.85,"text":"那么他进一步要达成什么"},{"start":333.85,"end":336.04,"text":"很难达成一致是什么"},{"start":336.12,"end":337.0,"text":"可能达成一致"},{"start":337.0,"end":340.12,"text":"是他们对着他们共同的社会不满"},{"start":341.26,"end":343.9,"text":"玉枕啊或风府穴"},{"start":346.52,"end":351.169,"text":"丰富越刺了之后是能够让眼睛看看清楚啊"},{"start":351.889,"end":356.119,"text":"风府穴他这里又叫做反骨啊"},{"start":356.119,"end":359.379,"text":"那就对应的是双方就是两个家庭"},{"start":359.379,"end":361.639,"text":"或者说两方男女两方啊"},{"start":361.639,"end":365.17,"text":"是说这个情感的两方他要分有共同社会不满"},{"start":365.17,"end":368.75,"text":"这个社会就是说或者说他所不能接受的"},{"start":368.75,"end":373.0,"text":"两方要能够分有共同的不能接受的啊"},{"start":373.0,"end":375.5,"text":"一些社会问题"},{"start":375.5,"end":381.159,"text":"就啊他们得有共同的那个否定性的那一面"},{"start":381.159,"end":384.759,"text":"那么这一点上达成了一致的话"},{"start":384.759,"end":387.81,"text":"那么再进一步发展到泥丸穴"},{"start":387.81,"end":391.79,"text":"那意味着这个男女两方或者这个情爱的两方"},{"start":391.79,"end":393.929,"text":"两方家庭和两个个体"},{"start":393.929,"end":397.009,"text":"他们要达成共同的社会目标"},{"start":397.009,"end":398.329,"text":"权利目标啊"},{"start":398.329,"end":401.17,"text":"社会目标啊"},{"start":401.17,"end":404.65,"text":"社会目标要耦合出共同的"},{"start":404.65,"end":407.019,"text":"那个家庭的社会目标哎"},{"start":407.019,"end":410.06,"text":"我就要要运作着孩子能够上下一代"},{"start":410.06,"end":411.22,"text":"能上更好的教育"},{"start":411.22,"end":412.14,"text":"能上更好的学校"},{"start":412.14,"end":413.66,"text":"或者说能够让这个夫妻两个"},{"start":413.66,"end":415.38,"text":"在体制内能够进一步发展"},{"start":415.38,"end":415.82,"text":"Whatever"},{"start":415.82,"end":417.63,"text":"反正这个泥丸学这个学到"},{"start":417.63,"end":421.45,"text":"意味着这个点