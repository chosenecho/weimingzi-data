  "content_sha256": "2498e87fde0e73bb586beb8ee3b914b5c3cbb7b6d07f103b7815865f92fbfcb7",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 740,
      "end_ms": 2480,
      "text": "呃我们的呃"
    },
    {
      "ordinal": 1,
      "start_ms": 3860,
      "end_ms": 6780,
      "text": "开展俱乐部项目的公司"
    },
    {
      "ordinal": 2,
      "start_ms": 7760,
      "end_ms": 15190,
      "text": "啊的成员工合伙的呃伙伴"
    },
    {
      "ordinal": 3,
      "start_ms": 15190,
      "end_ms": 22750,
      "text": "还有这个参与志愿活动的会员志愿者"
    },
    {
      "ordinal": 4,
      "start_ms": 24460,
      "end_ms": 26280,
      "text": "这里面的成员"
    },
    {
      "ordinal": 5,
      "start_ms": 28860,
      "end_ms": 31240,
      "text": "必须进爵"
    },
    {
      "ordinal": 6,
      "start_ms": 32119,
      "end_ms": 37600,
      "text": "严肃严厉地禁绝一切迷信活动"
    },
    {
      "ordinal": 7,
      "start_ms": 38920,
      "end_ms": 44510,
      "text": "迷信思想不得进行占卜术"
    },
    {
      "ordinal": 8,
      "start_ms": 44510,
      "end_ms": 47470,
      "text": "数魔法"
    },
    {
      "ordinal": 9,
      "start_ms": 48050,
      "end_ms": 53110,
      "text": "还有一些神秘主义修炼类似的活动"
    },
    {
      "ordinal": 10,
      "start_ms": 56150,
      "end_ms": 58060,
      "text": "这是严厉禁绝的"
    },
    {
      "ordinal": 11,
      "start_ms": 58060,
      "end_ms": 61450,
      "text": "其次对于我们的正式伙伴"
    },
    {
      "ordinal": 12,
      "start_ms": 61450,
      "end_ms": 63430,
      "text": "正式的就合伙嘛"
    },
    {
      "ordinal": 13,
      "start_ms": 63430,
      "end_ms": 65340,
      "text": "因为很多这个呃"
    },
    {
      "ordinal": 14,
      "start_ms": 65340,
      "end_ms": 69229,
      "text": "是实质上就是相当于就是合伙来进行的"
    },
    {
      "ordinal": 15,
      "start_ms": 69229,
      "end_ms": 71089,
      "text": "L是按劳分配的"
    },
    {
      "ordinal": 16,
      "start_ms": 73129,
      "end_ms": 80760,
      "text": "以及公司的成员必须坚持历史唯物主义的辩证"
    },
    {
      "ordinal": 17,
      "start_ms": 80760,
      "end_ms": 85320,
      "text": "唯物主义的无神论信仰"
    },
    {
      "ordinal": 18,
      "start_ms": 86090,
      "end_ms": 87980,
      "text": "必须"
    },
    {
      "ordinal": 19,
      "start_ms": 90040,
      "end_ms": 92250,
      "text": "放弃一切宗教信仰"
    },
    {
      "ordinal": 20,
      "start_ms": 92250,
      "end_ms": 94260,
      "text": "这是我们的原则"
    },
    {
      "ordinal": 21,
      "start_ms": 94260,
      "end_ms": 96460,
      "text": "但我的公司我可以这样管了"
    },
    {
      "ordinal": 22,
      "start_ms": 96460,
      "end_ms": 97540,
      "text": "我的团队"
    },
    {
      "ordinal": 23,
      "start_ms": 97540,
      "end_ms": 99310,
      "text": "我我的朋友我可以这样管"
    },
    {
      "ordinal": 24,
      "start_ms": 99310,
      "end_ms": 103720,
      "text": "那么我建议其他的想要开展俱乐部项目的"
    },
    {
      "ordinal": 25,
      "start_ms": 103720,
      "end_ms": 111460,
      "text": "这个公司和这个经营实体都采取这一基本策略"
    },
    {
      "ordinal": 26,
      "start_ms": 111460,
      "end_ms": 114550,
      "text": "基本原则它不是一个短期的策略"
    },
    {
      "ordinal": 27,
      "start_ms": 114550,
      "end_ms": 115990,
      "text": "它是个长期的原则"
    },
    {
      "ordinal": 28,
      "start_ms": 115990,
      "end_ms": 121260,
      "text": "坚持唯物主义底色啊"
    },
    {
      "ordinal": 29,
      "start_ms": 121720,
      "end_ms": 125020,
      "text": "坚决拥护科学"
    },
    {
      "ordinal": 30,
      "start_ms": 126800,
      "end_ms": 132750,
      "text": "现代科学的人类普遍立场"
    },
    {
      "ordinal": 31,
      "start_ms": 133150,
      "end_ms": 138630,
      "text": "不要自绝于人类主流文明之外"
    },
    {
      "ordinal": 32,
      "start_ms": 140200,
      "end_ms": 144640,
      "text": "那么对于我们的顾客呃"
    },
    {
      "ordinal": 33,
      "start_ms": 144640,
      "end_ms": 147460,
      "text": "我们参与这个俱乐部活动的"
    },
    {
      "ordinal": 34,
      "start_ms": 147460,
      "end_ms": 150460,
      "text": "俱乐部项目的这些会员顾客的"
    },
    {
      "ordinal": 35,
      "start_ms": 150460,
      "end_ms": 154390,
      "text": "我们的立场是引导其啊"
    },
    {
      "ordinal": 36,
      "start_ms": 155710,
      "end_ms": 162759,
      "text": "能够去除一些宗教迷信"
    },
    {
      "ordinal": 37,
      "start_ms": 164060,
      "end_ms": 165700,
      "text": "啊这个算命啊"
    },
    {
      "ordinal": 38,
      "start_ms": 165700,
      "end_ms": 166690,
      "text": "树树啊"
    },
    {
      "ordinal": 39,
      "start_ms": 166690,
      "end_ms": 169420,
      "text": "风水啊等等等等"
    },
    {
      "ordinal": 40,
      "start_ms": 169420,
      "end_ms": 172180,
      "text": "魔法呀等等等这些神秘主修炼啊"
    },
    {
      "ordinal": 41,
      "start_ms": 172180,
      "end_ms": 173110,
      "text": "这些玩意"
    },
    {
      "ordinal": 42,
      "start_ms": 173110,
      "end_ms": 181980,
      "text": "去除这些他固有的本来带着一些疾患坏毛病"
    },
    {
      "ordinal": 43,
      "start_ms": 182800,
      "end_ms": 187210,
      "text": "引导他们学习科学啊"
    },
    {
      "ordinal": 44,
      "start_ms": 187210,
      "end_ms": 188770,
      "text": "认识科学信仰"
    },
    {
      "ordinal": 45,
      "start_ms": 188770,
      "end_ms": 195400,
      "text": "科学能够建构起正常的历史"
    },
    {
      "ordinal": 46,
      "start_ms": 195400,
      "end_ms": 195880,
      "text": "唯物主义"
    },
    {
      "ordinal": 47,
      "start_ms": 195880,
      "end_ms": 196600,
      "text": "辩证唯物主义"
    },
    {
      "ordinal": 48,
      "start_ms": 196600,
      "end_ms": 199430,
      "text": "无神论的观点"
    },
    {
      "ordinal": 49,
      "start_ms": 200480,
      "end_ms": 203950,
      "text": "但是也不至于堕落到这个科学独断论啊"
    },
    {
      "ordinal": 50,
      "start_ms": 203950,
      "end_ms": 205600,
      "text": "这个时代论上面去"
    },
    {
      "ordinal": 51,
      "start_ms": 205600,
      "end_ms": 207340,
      "text": "我们的辩证唯物主义"
    },
    {
      "ordinal": 52,
      "start_ms": 207340,
      "end_ms": 211390,
      "text": "历史唯物主义是建立在啊"
    },
    {
      "ordinal": 53,
      "start_ms": 211390,
      "end_ms": 216940,
      "text": "是建立在人类哲学的最高成就后"
    },
    {
      "ordinal": 54,
      "start_ms": 216940,
      "end_ms": 222020,
      "text": "结构主义现象学和啊"
    },
    {
      "ordinal": 55,
      "start_ms": 222020,
      "end_ms": 224690,
      "text": "这个观念论后观念论"
    },
    {
      "ordinal": 56,
      "start_ms": 224690,
      "end_ms": 231020,
      "text": "辩证法的马克思主义的唯物主义的版本上的"
    },
    {
      "ordinal": 57,
      "start_ms": 231200,
      "end_ms": 233750,
      "text": "那么这样的哲学探索"
    },
    {
      "ordinal": 58,
      "start_ms": 233750,
      "end_ms": 235250,
      "text": "这样的哲学基础"
    },
    {
      "ordinal": 59,
      "start_ms": 235250,
      "end_ms": 239750,
      "text": "在我的往期视频里面都有比较清楚透彻的啊"
    },
    {
      "ordinal": 60,
      "start_ms": 239750,
      "end_ms": 243080,
      "text": "系统化的一个讨论就在这里就不多说了"
    },
    {
      "ordinal": 61,
      "start_ms": 243080,
      "end_ms": 245000,
      "text": "那么对于一般的会员啊"
    },
    {
      "ordinal": 62,
      "start_ms": 245000,
      "end_ms": 245900,
      "text": "对于一般的客户"
    },
    {
      "ordinal": 63,
      "start_ms": 245900,
      "end_ms": 246500,
      "text": "我们的客户"
    },
    {
      "ordinal": 64,
      "start_ms": 246500,
      "end_ms": 254080,
      "text": "我们的会员就是引导其改掉小的毛病啊"
    },
    {
      "ordinal": 65,
      "start_ms": 254080,
      "end_ms": 256660,
      "text": "建立起大的信仰"
    },
    {
      "ordinal": 66,
      "start_ms": 257719,
      "end_ms": 261659,
      "text": "可以和这些邪教迷信活动绝缘"
    },
    {
      "ordinal": 67,
      "start_ms": 263199,
      "end_ms": 269589,
      "text": "我们也向来倡导鼓励这个社会上的"
    },
    {
      "ordinal": 68,
      "start_ms": 269589,
      "end_ms": 270669,
      "text": "无论什么人"
    },
    {
      "ordinal": 69,
      "start_ms": 270669,
      "end_ms": 272409,
      "text": "只要你发现类似的线索"
    },
    {
      "ordinal": 70,
      "start_ms": 272409,
      "end_ms": 274959,
      "text": "发现类似的违法犯罪的活动"
    },
    {
      "ordinal": 71,
      "start_ms": 274959,
      "end_ms": 277064,
      "text": "都可以向我们举报"
    },
    {
      "ordinal": 72,
      "start_ms": 278000,
      "end_ms": 279220,
      "text": "都可以向我们举报"
    },
    {
      "ordinal": 73,
      "start_ms": 280480,
      "end_ms": 284440,
      "text": "我们会始终一贯的坚持一个反邪教"
    },
    {
      "ordinal": 74,
      "start_ms": 284440,
      "end_ms": 286669,
      "text": "反迷信的一个立场"
    },
    {
      "ordinal": 75,
      "start_ms": 288340,
      "end_ms": 294080,
      "text": "然后嗯最后的话是要讲给这些"
    },
    {
      "ordinal": 76,
      "start_ms": 294080,
      "end_ms": 297380,
      "text": "想要通过这种方式蛊惑世人"
    },
    {
      "ordinal": 77,
      "start_ms": 297380,
      "end_ms": 299980,
      "text": "敛财也好啊"
    },
    {
      "ordinal": 78,
      "start_ms": 299980,
      "end_ms": 301390,
      "text": "骗色也好"
    },
    {
      "ordinal": 79,
      "start_ms": 303250,
      "end_ms": 304270,
      "text": "野心也好"
    },
    {
      "ordinal": 80,
      "start_ms": 304270,
      "end_ms": 306610,
      "text": "用这样的一种反智主义"
    },
    {
      "ordinal": 81,
      "start_ms": 306610,
      "end_ms": 307210,
      "text": "神秘主义"
    },
    {
      "ordinal": 82,
      "start_ms": 307210,
      "end_ms": 309720,
      "text": "蒙昧主义的方式"
    },
    {
      "ordinal": 83,
      "start_ms": 310120,
      "end_ms": 315360,
      "text": "玩弄一些低幼的卑劣的符号学把戏"
    },
    {
      "ordinal": 84,
      "start_ms": 316560,
      "end_ms": 321680,
      "text": "那么我要说的你最好先去算一个算式"
    },
    {
      "ordinal": 85,
      "start_ms": 322020,
      "end_ms": 324870,
      "text": "你走到这条路的尽头"
    },
    {
      "ordinal": 86,
      "start_ms": 324870,
      "end_ms": 327090,
      "text": "就是一个只讲功利"
    },
    {
      "ordinal": 87,
      "start_ms": 327090,
      "end_ms": 328980,
      "text": "不讲农历的地方了"
    },
    {
      "ordinal": 88,
      "start_ms": 328980,
      "end_ms": 331230,
      "text": "这个镜头你在那里面呆着的时候"
    },
    {
      "ordinal": 89,
      "start_ms": 331230,
      "end_ms": 332070,
      "text": "你要算来算去"
    },
    {
      "ordinal": 90,
      "start_ms": 332070,
      "end_ms": 335290,
      "text": "你要算一个算是大月31天"
    },
    {
      "ordinal": 91,
      "start_ms": 335290,
      "end_ms": 336190,
      "text": "小月30天"
    },
    {
      "ordinal": 92,
      "start_ms": 336190,
      "end_ms": 339490,
      "text": "这两个加起来乘以工作日五天"
    },
    {
      "ordinal": 93,
      "start_ms": 339490,
      "end_ms": 340570,
      "text": "双休日两天"
    },
    {
      "ordinal": 94,
      "start_ms": 340570,
      "end_ms": 345740,
      "text": "你得到那个数字就是就是你的宿命"
    },
    {
      "ordinal": 95,
      "start_ms": 345740,
      "end_ms": 348440,
      "text": "就是你的最终结局"
    },
    {
      "ordinal": 96,
      "start_ms": 349680,
      "end_ms": 351740,
      "text": "我们话先提前放在这里"
    },
    {
      "ordinal": 97,
      "start_ms": 353240,
      "end_ms": 355820,
      "text": "我们向来是和"
    },
    {
      "ordinal": 98,
      "start_ms": 357420,
      "end_ms": 359360,
      "text": "啊反邪教"
    },
    {
      "ordinal": 99,
      "start_ms": 359360,
      "end_ms": 360770,
      "text": "反迷信"
    },
    {
      "ordinal": 100,
      "start_ms": 360770,
      "end_ms": 363380,
      "text": "反极端激进的啊"
    },
    {
      "ordinal": 101,
      "start_ms": 363380,
      "end_ms": 365240,
      "text": "宗教信仰和宗教活动"
    },
    {
      "ordinal": 102,
      "start_ms": 365240,
      "end_ms": 374060,
      "text": "宗教组织的主流社会科学的"
    },
    {
      "ordinal": 103,
      "start_ms": 376780,
      "end_ms": 379470,
      "text": "社会主流价值观站在一起"
    },
    {
      "ordinal": 104,
      "start_ms": 379470,
      "end_ms": 382080,
      "text": "我们是其中的一部分"
    },
    {
      "ordinal": 105,
      "start_ms": 383220,
      "end_ms": 392670,
      "text": "我们永远不会借用这一类预言算命术数啊"
    },
    {
      "ordinal": 106,
      "start_ms": 392670,
      "end_ms": 393720,
      "text": "什么风水"
    },
    {
      "ordinal": 107,
      "start_ms": 393720,
      "end_ms": 399150,
      "text": "我们绝对不会借用这一类前现代的低劣的"
    },
    {
      "ordinal": 108,
      "start_ms": 399150,
      "end_ms": 401770,
      "text": "拙劣的啊"
    },
    {
      "ordinal": 109,
      "start_ms": 401770,
      "end_ms": 408440,
      "text": "精神像就是受人民精神鸦片的这类"
    },
    {
      "ordinal": 110,
      "start_ms": 410460,
      "end_ms": 415310,
      "text": "肮脏的手段我们不会用这类肮脏的手段来实现"
    },
    {
      "ordinal": 111,
      "start_ms": 415310,
      "end_ms": 416300,
      "text": "来作为人"
    },
    {
      "ordinal": 112,
      "start_ms": 416300,
      "end_ms": 417590,
      "text": "作为他啊"
    },
    {
      "ordinal": 113,
      "start_ms": 417590,
      "end_ms": 420770,
      "text": "本来作为一个实现我们某些目的的一个工具"
    },
    {
      "ordinal": 114,
      "start_ms": 420770,
      "end_ms": 423690,
      "text": "我们绝对不会走这样的路"
    },
    {
      "ordinal": 115,
      "start_ms": 423690,
      "end_ms": 427680,
      "text": "任何走这样的路的人都是我们的陌路人"
    },
    {
      "ordinal": 116,
      "start_ms": 427680,
      "end_ms": 429880,
      "text": "都是我们的敌人"
    },
    {
      "ordinal": 117,
      "start_ms": 430340,
      "end_ms": 431909,
      "text": "好吧"
    },
    {
      "ordinal": 118,
      "start_ms": 432249,
      "end_ms": 434489,
      "text": "然后这个我们要讲的就是说"
    },
    {
      "ordinal": 119,
      "start_ms": 434489,
      "end_ms": 438700,
      "text": "所以我们说作为列宁主义者啊"
    },
    {
      "ordinal": 120,
      "start_ms": 438700,
      "end_ms": 440320,
      "text": "这个是死线"
    },
    {
      "ordinal": 121,
      "start_ms": 440320,
      "end_ms": 443500,
      "text": "你要划分划分啊"
    },
    {
      "ordinal": 122,
      "start_ms": 443500,
      "end_ms": 447190,
      "text": "划分真正列宁主义者其实也有一个参考标准"
    },
    {
      "ordinal": 123,
      "start_ms": 447190,
      "end_ms": 452370,
      "text": "他会不会容忍这个无神论之外的一个是什么"
    },
    {
      "ordinal": 124,
      "start_ms": 452710,
      "end_ms": 453630,
      "text": "宗教信仰"
    },
    {
      "ordinal": 125,
      "start_ms": 453630,
      "end_ms": 458880,
      "text": "会不会和之外的这些人过从甚密啊"
    },
    {
      "ordinal": 126,
      "start_ms": 461739,
      "end_ms": 465119,
      "text": "你像那个马前卒啊哈哈我们这边扯扯过来"
    },
    {
      "ordinal": 127,
      "start_ms": 465119,
      "end_ms": 465599,
      "text": "就是老马"
    },
    {
      "ordinal": 128,
      "start_ms": 465599,
      "end_ms": 468419,
      "text": "他当年那个临高启明那里面"
    },
    {
      "ordinal": 129,
      "start_ms": 468419,
      "end_ms": 470710,
      "text": "还有一个叫什么张应承道长"
    },
    {
      "ordinal": 130,
      "start_ms": 470710,
      "end_ms": 471760,
      "text": "那是个啥"
    },
    {
      "ordinal": 131,
      "start_ms": 471760,
      "end_ms": 472750,
      "text": "那在那个小说里面"
    },
    {
      "ordinal": 132,
      "start_ms": 472750,
      "end_ms": 474670,
      "text": "那张逸臣所谓张一成道长"
    },
    {
      "ordinal": 133,
      "start_ms": 474670,
      "end_ms": 478940,
      "text": "他当然他把宗教本身也就当成一个工具了"
    },
    {
      "ordinal": 134,
      "start_ms": 478940,
      "end_ms": 481520,
      "text": "而且他是一个在那个小说里面"
    },
    {
      "ordinal": 135,
      "start_ms": 481520,
      "end_ms": 483990,
      "text": "那个是个栾童癖啊"
    },
    {
      "ordinal": 136,
      "start_ms": 483990,
      "end_ms": 487770,
      "text": "然后他们又是他又是一个激进的汉民族主义者"
    },
    {
      "ordinal": 137,
      "start_ms": 488790,
      "end_ms": 492600,
      "text": "因为那个小说拒绝什么"
    },
    {
      "ordinal": 138,
      "start_ms": 492600,
      "end_ms": 495660,
      "text": "呵呵反正就是那个临高启明的小说里面"
    },
    {
      "ordinal": 139,
      "start_ms": 495660,
      "end_ms": 497910,
      "text": "最后是跟野猪皮做生意的嘛"
    },
    {
      "ordinal": 140,
      "start_ms": 497910,
      "end_ms": 503550,
      "text": "嗯所以这个张逸晨好像就退出那个群川的"
    },
    {
      "ordinal": 141,
      "start_ms": 503550,
      "end_ms": 505800,
      "text": "小小说创作团队了"
    },
    {
      "ordinal": 142,
      "start_ms": 505800,
      "end_ms": 511160,
      "text": "所以对于这种呃或者幻想当中的自己"
    },
    {
      "ordinal": 143,
      "start_ms": 511160,
      "end_ms": 514119,
      "text": "是直接投机政客的那些人这种迷信啊"
    },
    {
      "ordinal": 144,
      "start_ms": 514119,
      "end_ms": 517510,
      "text": "这宗教都是它的一个工具而已啊"
    },
    {
      "ordinal": 145,
      "start_ms": 517510,
      "end_ms": 518620,
      "text": "都是他的工具"
    },
    {
      "ordinal": 146,
      "start_ms": 518620,
      "end_ms": 519610,
      "text": "但是我反过来讲"
    },
    {
      "ordinal": 147,
      "start_ms": 519610,
      "end_ms": 520929,
      "text": "那些迷信他的人当中"
    },
    {
      "ordinal": 148,
      "start_ms": 520929,
      "end_ms": 522700,
      "text": "有一部分当然是迷信他的"
    },
    {
      "ordinal": 149,
      "start_ms": 522700,
      "end_ms": 525180,
      "text": "有一部分当然是迷信这种东西的"
    },
    {
      "ordinal": 150,
      "start_ms": 525180,
      "end_ms": 527790,
      "text": "但是还有一部分适合在相互利用"
    },
    {
      "ordinal": 151,
      "start_ms": 527790,
      "end_ms": 529020,
      "text": "相互利用啊"
    },
    {
      "ordinal": 152,
      "start_ms": 529020,
      "end_ms": 533380,
      "text": "生活当中缺乏这个变发生变化的那种机会啊"
    },
    {
      "ordinal": 153,
      "start_ms": 533380,
      "end_ms": 534250,
      "text": "摸到一个苗头"
    },
    {
      "ordinal": 154,
      "start_ms": 534250,
      "end_ms": 535090,
      "text": "他也不是真的信"
    },
    {
      "ordinal": 155,
      "start_ms": 535090,
      "end_ms": 538210,
      "text": "只要这个东西能够给我带来带来这个"
    },
    {
      "ordinal": 156,
      "start_ms": 538210,
      "end_ms": 542350,
      "text": "所以这个也是一个意识形态的二阶二阶特征啊"
    },
    {
      "ordinal": 157,
      "start_ms": 542350,
      "end_ms": 545490,
      "text": "像传销进传销的人很多是不信这东西的"
    },
    {
      "ordinal": 158,
      "start_ms": 545490,
      "end_ms": 547050,
      "text": "他他就要忽悠别人"
    },
    {
      "ordinal": 159,
      "start_ms": 547050,
      "end_ms": 547890,
      "text": "忽悠傻子信"
    },
    {
      "ordinal": 160,
      "start_ms": 547890,
      "end_ms": 551420,
      "text": "但是问题就是说他信的就是觉得有傻子会信"
    },
    {
      "ordinal": 161,
      "start_ms": 551420,
      "end_ms": 552800,
      "text": "他所迷信的东西"
    },
    {
      "ordinal": 162,
      "start_ms": 552800,
      "end_ms": 555080,
      "text": "就是觉得会有傻子真的信这个东西"
    },
    {
      "ordinal": 163,
      "start_ms": 555080,
      "end_ms": 557360,
      "text": "然后他可以骗傻子从里面敛财"
    },
    {
      "ordinal": 164,
      "start_ms": 557360,
      "end_ms": 559910,
      "text": "从里面攫取权力"
    },
    {
      "ordinal": 165,
      "start_ms": 560250,
      "end_ms": 562760,
      "text": "你信这个东西已经是信了"
    },
    {
      "ordinal": 166,
      "start_ms": 562760,
      "end_ms": 565810,
      "text": "你相信这个世界上存在一种呃"
    },
    {
      "ordinal": 167,
      "start_ms": 565810,
      "end_ms": 570089,
      "text": "会被这样的简单的拙劣的骗局啊"
    },
    {
      "ordinal": 168,
      "start_ms": 570089,
      "end_ms": 572309,
      "text": "呃是有的时候自恋的恶臭的"
    },
    {
      "ordinal": 169,
      "start_ms": 572309,
      "end_ms": 573959,
      "text": "这样一种一种什么预言"
    },
    {
      "ordinal": 170,
      "start_ms": 573959,
      "end_ms": 576879,
      "text": "什么什么紫紫薇还是紫辉"
    },
    {
      "ordinal": 171,
      "start_ms": 576879,
      "end_ms": 578439,
      "text": "我都不知道紫薇格格"
    },
    {
      "ordinal": 172,
      "start_ms": 578439,
      "end_ms": 579339,
      "text": "你妈什么东西"
    },
    {
      "ordinal": 173,
      "start_ms": 579339,
      "end_ms": 580479,
      "text": "这是什么圣人下凡"
    },
    {
      "ordinal": 174,
      "start_ms": 580479,
      "end_ms": 585220,
      "text": "这的会被这些诸类的肮脏的预言嗯俘获你"
    },
    {
      "ordinal": 175,
      "start_ms": 585220,
      "end_ms": 586840,
      "text": "你如果真的相信有这样的人"
    },
    {
      "ordinal": 176,
      "start_ms": 586840,
      "end_ms": 588760,
      "text": "你本身或者你真的相信"
    },
    {
      "ordinal": 177,
      "start_ms": 588760,
      "end_ms": 593480,
      "text": "现代人会彻底的无反思的相信你这样的谎言"
    },
    {
      "ordinal": 178,
      "start_ms": 593480,
      "end_ms": 595690,
      "text": "你就在你骗你自己"
    },
    {
      "ordinal": 179,
      "start_ms": 595690,
      "end_ms": 597970,
      "text": "就像你相信这个鱼塘里面有鱼一样的"
    },
    {
      "ordinal": 180,
      "start_ms": 597970,
      "end_ms": 600190,
      "text": "但实际上这是个硫酸池或者是化粪池"
    },
    {
      "ordinal": 181,
      "start_ms": 600190,
      "end_ms": 602110,
      "text": "你觉得化粪池里面真的会有鱼吗"
    },
    {
      "ordinal": 182,
      "start_ms": 602110,
      "end_ms": 606250,
      "text": "所以这样的欺骗欺骗者本身也是受骗者"
    },
    {
      "ordinal": 183,
      "start_ms": 606250,
      "end_ms": 610150,
      "text": "受骗者本身也是在想要试图尚未成为欺骗者"
    },
    {
      "ordinal": 184,
      "start_ms": 610150,
      "end_ms": 612190,
      "text": "至于互相骗的骗"
    },
    {
      "ordinal": 185,
      "start_ms": 612190,
      "end_ms": 614290,
      "text": "就是骗骗骗子大群啊"
    },
    {
      "ordinal": 186,
      "start_ms": 614290,
      "end_ms": 616600,
      "text": "骗骗子集群明白吗"
    },
    {
      "ordinal": 187,
      "start_ms": 616600,
      "end_ms": 617710,
      "text": "那么这样的团队"
    },
    {
      "ordinal": 188,
      "start_ms": 617710,
      "end_ms": 621100,
      "text": "这样的团体归根结底他就陷于内耗呃"
    },
    {
      "ordinal": 189,
      "start_ms": 621100,
      "end_ms": 623260,
      "text": "限于或者就变成敛财"
    },
    {
      "ordinal": 190,
      "start_ms": 623260,
      "end_ms": 624540,
      "text": "传教化啊"
    },
    {
      "ordinal": 191,
      "start_ms": 624540,
      "end_ms": 627090,
      "text": "或者就变成性混乱而变得肮脏"
    },
    {
      "ordinal": 192,
      "start_ms": 627090,
      "end_ms": 629460,
      "text": "他不会有什么政治动能"
    },
    {
      "ordinal": 193,
      "start_ms": 629460,
      "end_ms": 632940,
      "text": "但是它会祸害治安"
    },
    {
      "ordinal": 194,
      "start_ms": 632940,
      "end_ms": 633900,
      "text": "它会变成诈骗"
    },
    {
      "ordinal": 195,
      "start_ms": 633900,
      "end_ms": 635280,
      "text": "会变成乱乱七八糟的东西"
    },
    {
      "ordinal": 196,
      "start_ms": 635280,
      "end_ms": 636900,
      "text": "它会成为一个治安的一个事件"
    },
    {
      "ordinal": 197,
      "start_ms": 636900,
      "end_ms": 638480,
      "text": "或者形式性的世界"
    },
    {
      "ordinal": 198,
      "start_ms": 638480,
      "end_ms": 641180,
      "text": "但是你要说这种东西能有什么政治性"
    },
    {
      "ordinal": 199,
      "start_ms": 641180,
      "end_ms": 644839,
      "text": "不会有任何的系统化的大规模的政治性"
    },
    {
      "ordinal": 200,
      "start_ms": 644839,
      "end_ms": 646819,
      "text": "嗯所以我说了"
    },
    {
      "ordinal": 201,
      "start_ms": 646819,
      "end_ms": 648079,
      "text": "这是显见之患"
    },
    {
      "ordinal": 202,
      "start_ms": 648079,
      "end_ms": 652279,
      "text": "但是你如果说是这个肚子里面啊"
    },
    {
      "ordinal": 203,
      "start_ms": 652279,
      "end_ms": 655440,
      "text": "你的那个肠胃里面长癣了"
    },
    {
      "ordinal": 204,
      "start_ms": 655440,
      "end_ms": 656340,
      "text": "那就啥"
    },
    {
      "ordinal": 205,
      "start_ms": 657360,
      "end_ms": 658800,
      "text": "那发展到后面就变成胃癌"
    },
    {
      "ordinal": 206,
      "start_ms": 658800,
      "end_ms": 660150,
      "text": "你知道吗"
    },
    {
      "ordinal": 207,
      "start_ms": 660250,
      "end_ms": 663330,
      "text": "还有一些上皮细胞异常增生"
    },
    {
      "ordinal": 208,
      "start_ms": 664470,
      "end_ms": 667290,
      "text": "你这个显如果是在皮肤啊"
    },
    {
      "ordinal": 209,
      "start_ms": 667290,
      "end_ms": 669720,
      "text": "它可以就免疫系统识别的人怎么样"
    },
    {
      "ordinal": 210,
      "start_ms": 669720,
      "end_ms": 673170,
      "text": "但你如果说这个显长在它愈合了就没了"
    },
    {
      "ordinal": 211,
      "start_ms": 673170,
      "end_ms": 674340,
      "text": "长在肚子里面"
    },
    {
      "ordinal": 212,
      "start_ms": 674340,
      "end_ms": 677530,
      "text": "那他又反复要反复摩擦"
    },
    {
      "ordinal": 213,
      "start_ms": 677530,
      "end_ms": 678550,
      "text": "反复愈合"
    },
    {
      "ordinal": 214,
      "start_ms": 678550,
      "end_ms": 681820,
      "text": "最后那基因表达失败变变成癌症啊"
    },
    {
      "ordinal": 215,
      "start_ms": 681820,
      "end_ms": 684070,
      "text": "这里面就会有比我们比较担心的"
    },
    {
      "ordinal": 216,
      "start_ms": 684070,
      "end_ms": 685630,
      "text": "就是说这些团体"
    },
    {
      "ordinal": 217,
      "start_ms": 685630,
      "end_ms": 687470,
      "text": "这些群体啊啊"
    },
    {
      "ordinal": 218,
      "start_ms": 687470,
      "end_ms": 691890,
      "text": "里面会酝酿出那种可以快速复制裂变的"
    },
    {
      "ordinal": 219,
      "start_ms": 691890,
      "end_ms": 695130,
      "text": "我上个视频讲的第五阶段的魔怔人"
    },
    {
      "ordinal": 220,
      "start_ms": 695130,
      "end_ms": 699270,
      "text": "第五阶段的病理化的是刑事犯罪导向意向"
    },
    {
      "ordinal": 221,
      "start_ms": 699270,
      "end_ms": 700970,
      "text": "那种魔怔人"
    },
    {
      "ordinal": 222,
      "start_ms": 700970,
      "end_ms": 702350,
      "text": "而且可以裂变"
    },
    {
      "ordinal": 223,
      "start_ms": 702350,
      "end_ms": 704930,
      "text": "可以通过某种符号学编码裂变"
    },
    {
      "ordinal": 224,
      "start_ms": 704930,
      "end_ms": 707330,
      "text": "你这个东西呢"
    },
    {
      "ordinal": 225,
      "start_ms": 708050,
      "end_ms": 711370,
      "text": "贼啊此为贼也"
    },
    {
      "ordinal": 226,
      "start_ms": 712120,
      "end_ms": 715320,
      "text": "他主要成员是城市小市民阶级啊"
    },
    {
      "ordinal": 227,
      "start_ms": 715320,
      "end_ms": 717180,
      "text": "这还不是什么古代黄巾军"
    },
    {
      "ordinal": 228,
      "start_ms": 717180,
      "end_ms": 720750,
      "text": "什么这个农民阶级起义的"
    },
    {
      "ordinal": 229,
      "start_ms": 721150,
      "end_ms": 721890,
      "text": "这种"
    },
    {
      "ordinal": 230,
      "start_ms": 721890,
      "end_ms": 728850,
      "text": "都是具有严重的政治投机和经济投机色彩的啊"
    },
    {
      "ordinal": 231,
      "start_ms": 730100,
      "end_ms": 731530,
      "text": "那么我们的团体"
    },
    {
      "ordinal": 232,
      "start_ms": 731530,
      "end_ms": 734500,
      "text": "我们自己的经营团体和我们的一个支持者"
    },
    {
      "ordinal": 233,
      "start_ms": 734500,
      "end_ms": 735790,
      "text": "关注者群体啊"
    },
    {
      "ordinal": 234,
      "start_ms": 735790,
      "end_ms": 738440,
      "text": "希望你们始终保持警觉"
    },
    {
      "ordinal": 235,
      "start_ms": 738440,
      "end_ms": 741119,
      "text": "不要参与这样的活动啊"
    },
    {
      "ordinal": 236,
      "start_ms": 741119,
      "end_ms": 742319,
      "text": "然后这样的群体"
    },
    {
      "ordinal": 237,
      "start_ms": 742319,
      "end_ms": 746819,
      "text": "这样的团体我们会想办法来来这个搜集资料啊"
    },
    {
      "ordinal": 238,
      "start_ms": 746819,
      "end_ms": 748719,
      "text": "举报处理的啊"
    },
    {
      "ordinal": 239,
      "start_ms": 748719,
      "end_ms": 752120,
      "text": "这个也是应有之义啊"
    },
    {
      "ordinal": 240,
      "start_ms": 752120,
      "end_ms": 754820,
      "text": "啊这个让这个互联网空间一"
    },
    {
      "ordinal": 241,
      "start_ms": 754820,
      "end_ms": 757220,
      "text": "让这个群众尤其是青年啊"
    },
    {
      "ordinal": 242,
      "start_ms": 757220,
      "end_ms": 764749,
      "text": "青年的精神生活和这个文化消费的活动"
    },
    {
      "ordinal": 243,
      "start_ms": 764749,
      "end_ms": 768289,
      "text": "能够得到一个得到一个维护"
    },
    {
      "ordinal": 244,
      "start_ms": 768289,
      "end_ms": 771740,
      "text": "得到一个清洁好吧"
    },
    {
      "ordinal": 245,
      "start_ms": 771740,
      "end_ms": 772820,
      "text": "那就讲到这里啊"
    },
    {
      "ordinal": 246,
      "start_ms": 772820,
      "end_ms": 773560,
      "text": "讲到这里"
    },
    {
      "ordinal": 247,
      "start_ms": 773560,
      "end_ms": 774880,
      "text": "我刚刚讲的那个公式"
    },
    {
      "ordinal": 248,
      "start_ms": 774880,
      "end_ms": 776410,
      "text": "你们真的要去算一算啊"
    },
    {
      "ordinal": 249,
      "start_ms": 776410,
      "end_ms": 779800,
      "text": "我指的你们指的就是这帮想要吃这口饭"
    },
    {
      "ordinal": 250,
      "start_ms": 779800,
      "end_ms": 782080,
      "text": "想要通过这种方式是什么"
    },
    {
      "ordinal": 251,
      "start_ms": 782080,
      "end_ms": 784480,
      "text": "乘势而上的这群野心家啊"
    },
    {
      "ordinal": 252,
      "start_ms": 784480,
      "end_ms": 785260,
      "text": "这样的野心家"
    },
    {
      "ordinal": 253,
      "start_ms": 785260,
      "end_ms": 787079,
      "text": "这样的骗子"
    },
    {
      "ordinal": 254,
      "start_ms": 787479,
      "end_ms": 789359,
      "text": "你总归也会算乘法和加法"
    },
    {
      "ordinal": 255,
      "start_ms": 789359,
      "end_ms": 789779,
      "text": "对不对"
    },
    {
      "ordinal": 256,
      "start_ms": 789779,
      "end_ms": 792690,
      "text": "结合律是不是你总归会算的呗"
    },
    {
      "ordinal": 257,
      "start_ms": 792690,
      "end_ms": 794280,
      "text": "拿去算一算"
    },
    {
      "ordinal": 258,
      "start_ms": 794280,
      "end_ms": 798480,
      "text": "算一算那个数字就是答案啊"
    },
    {
      "ordinal": 259,
      "start_ms": 798480,
      "end_ms": 803040,
      "text": "就是你答案你自己好自为之"
    },
    {
      "ordinal": 260,
      "start_ms": 804180,
      "end_ms": 807150,
      "text": "好好的把自己准确答案算出来"
    },
    {
      "ordinal": 261,
