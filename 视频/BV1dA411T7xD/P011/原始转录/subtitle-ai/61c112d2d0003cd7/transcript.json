    {
      "ordinal": 148,
      "start_ms": 388390,
      "end_ms": 389830,
      "text": "崇高的通路的话"
    },
    {
      "ordinal": 149,
      "start_ms": 389830,
      "end_ms": 391760,
      "text": "他必须要把自己的头发"
