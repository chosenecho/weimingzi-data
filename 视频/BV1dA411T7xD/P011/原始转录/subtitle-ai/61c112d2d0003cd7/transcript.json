    {
      "ordinal": 152,
      "start_ms": 396969,
      "end_ms": 397839,
      "text": "剪掉了之后"
    },
    {
      "ordinal": 153,
      "start_ms": 397839,
      "end_ms": 401439,
      "text": "它就能避免这个鼻梁到鼻啊"
