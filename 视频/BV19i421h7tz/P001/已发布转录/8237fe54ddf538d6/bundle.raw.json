{"segments":[{"start":0.0,"end":1.96,"text":"比王佐更糟的是望左"},{"start":3.36,"end":6.08,"text":"望左的规模现在也挺大的了"},{"start":6.6,"end":9.22,"text":"那么去年我们端掉了一个望左"},{"start":9.22,"end":10.64,"text":"他不是往左啊"},{"start":10.64,"end":14.76,"text":"他有线下的一些可以说比较危险的行动了"},{"start":14.76,"end":15.89,"text":"行为了"},{"start":15.89,"end":19.95,"text":"这些行为只会给人民群众造造成损害伤害"},{"start":19.95,"end":21.69,"text":"然后他对他的这个行动行为"},{"start":21.69,"end":28.24,"text":"又是在网络上大肆宣扬望左肆意妄为"},{"start":28.24,"end":32.189,"text":"往左而往左是很低龄化了"},{"start":32.189,"end":36.17,"text":"往左最小是到这个小学生都有了"},{"start":36.17,"end":38.459,"text":"那么这些望左呢"},{"start":38.459,"end":40.619,"text":"望佐的年龄在越来越小"},{"start":40.619,"end":42.119,"text":"越来越低龄化"},{"start":42.119,"end":43.619,"text":"望佐年龄低龄化"},{"start":43.619,"end":44.82,"text":"目前是高中"},{"start":44.82,"end":47.38,"text":"去年呢是大学在校学生"},{"start":47.38,"end":48.66,"text":"大一大二的水准"},{"start":49.9,"end":52.79,"text":"大一刚刚就读大二的一个水准"},{"start":52.95,"end":55.59,"text":"现在这个情况已经进展到发展到高中了"},{"start":55.59,"end":59.12,"text":"一些望族肆意妄为的望族"},{"start":59.12,"end":61.16,"text":"那么这个左呢不是真的左"},{"start":62.16,"end":65.959,"text":"它并不是真正是在进行劳工运动"},{"start":65.959,"end":70.019,"text":"它只是借助在我们国家政治正确的劳工的话语"},{"start":70.019,"end":75.31,"text":"劳工权益的话语实际上是在表达的是自由派的"},{"start":75.31,"end":77.33,"text":"代表的是小资产阶级的利益"},{"start":77.33,"end":78.87,"text":"代表的是城市小市民"},{"start":78.87,"end":81.21,"text":"小资产阶级小富人的利益"},{"start":82.49,"end":87.17,"text":"他们没有这个呃把握经济结构啊"},{"start":87.17,"end":89.69,"text":"生产再生产关系的能力"},{"start":89.69,"end":92.47,"text":"思考能力上就是没有这个能力"},{"start":92.71,"end":94.89,"text":"那么这一批望左呢"},{"start":94.89,"end":98.93,"text":"目前在为代表的是啊"},{"start":98.93,"end":105.73,"text":"被B站的一群网左所追吹捧追捧的几个up主"},{"start":105.73,"end":106.95,"text":"哪几个我不点名"},{"start":106.95,"end":110.86,"text":"大家都知道他们的妄狂妄妄在哪里呢"},{"start":110.86,"end":116.949,"text":"在QQ群群聊里面已经说自己具有什么军社啊"},{"start":121.909,"end":126.33,"text":"他们还把自己的QQ群啊弄了好多个群"},{"start":126.33,"end":131.66,"text":"把这叫这个组织叫做鹿鹿马呃"},{"start":131.66,"end":133.88,"text":"那个那个指鹿为马的鹿啊"},{"start":133.88,"end":138.179,"text":"然后里面有各种是什么联络部啊"},{"start":138.179,"end":139.67,"text":"总参谋部"},{"start":139.67,"end":142.07,"text":"中央什么什么局啊"},{"start":142.07,"end":143.97,"text":"已经开始沐猴而冠了"},{"start":143.97,"end":146.81,"text":"自封各种是什么职务了"},{"start":146.81,"end":150.79,"text":"而且有明明确的那种等级人身依附关系"},{"start":150.79,"end":156.25,"text":"谁是把他们那个最大的up主称之为成就"},{"start":156.25,"end":157.53,"text":"当成领袖啊什么的"},{"start":157.53,"end":163.94,"text":"然后呃这完全是妄作妄作凶啊"},{"start":165.02,"end":166.86,"text":"只是一些不谙世事"},{"start":166.86,"end":174.03,"text":"然后是被一些行愚之人坐过牢的一些老逼灯啊"},{"start":174.03,"end":176.73,"text":"给他养出这些小孩的野心"},{"start":176.73,"end":178.67,"text":"让这些小孩去冲"},{"start":179.15,"end":180.29,"text":"甚至在线下冲"},{"start":180.29,"end":183.69,"text":"他们群聊里面竟然还狂妄的说什么"},{"start":183.69,"end":186.16,"text":"要把他们小组拆拆"},{"start":186.16,"end":187.6,"text":"散到各地去"},{"start":187.6,"end":191.11,"text":"成立新小组已经很狂妄了"},{"start":191.11,"end":192.27,"text":"妄作凶啊"},{"start":192.27,"end":195.25,"text":"这东西都发生在我们眼皮子底下"},{"start":195.25,"end":197.83,"text":"就是某种疯狂"},{"start":198.2,"end":202.24,"text":"而且是啊是成年人和未成年人"},{"start":202.24,"end":204.68,"text":"是掺杂在他们那些群里面的"},{"start":204.68,"end":208.91,"text":"有一些是一些有老案底的老人"},{"start":209.39,"end":210.83,"text":"那是国家可怜你"},{"start":210.83,"end":212.11,"text":"给你恢复了通信自由"},{"start":212.11,"end":215.22,"text":"有一些是些中年人有社会不满的"},{"start":219.13,"end":222.45,"text":"那有一些是一些20多岁社会化失败的"},{"start":222.45,"end":223.79,"text":"一些年轻人"},{"start":223.79,"end":225.98,"text":"还有一些就是这种小孩儿"},{"start":225.98,"end":227.64,"text":"十几岁的小孩儿"},{"start":227.64,"end":231.579,"text":"这些人都是望人狂妄至极"},{"start":231.819,"end":233.859,"text":"一点现实的社会力量都没有"},{"start":233.859,"end":237.839,"text":"你说他已经掌握了什么多少个村庄啊"},{"start":237.839,"end":240.579,"text":"已经是掌握了多少个地下工厂啊"},{"start":240.579,"end":241.759,"text":"这个他妈的"},{"start":241.759,"end":244.339,"text":"好歹我们也把当成是他妈正常人看待"},{"start":244.339,"end":246.819,"text":"比如说他这个是现实的"},{"start":246.819,"end":248.79,"text":"有物质基础的在做事情"},{"start":248.79,"end":249.67,"text":"这些人在干嘛"},{"start":250.71,"end":251.83,"text":"这些人搞来搞去"},{"start":251.83,"end":252.47,"text":"搞来搞去"},{"start":252.47,"end":256.339,"text":"最后拱这些高中生小屁孩"},{"start":256.339,"end":257.779,"text":"他是少年犯啊"},{"start":257.779,"end":258.779,"text":"我说不是"},{"start":258.779,"end":262.499,"text":"目前不是你拱他们去做的那些错事了之后"},{"start":262.499,"end":263.319,"text":"那就变少年犯"},{"start":263.319,"end":265.019,"text":"国家很难处理呀"},{"start":265.019,"end":267.289,"text":"很头很大呀"},{"start":267.289,"end":268.729,"text":"不处理不是处理的"},{"start":268.729,"end":271.03,"text":"不是啊"},{"start":271.03,"end":272.89,"text":"他们就开始玩这一招了"},{"start":272.89,"end":277.96,"text":"下沉那妄作凶比旺比王佐更糟糕的是"},{"start":277.96,"end":282.43,"text":"望族这群妄佐呢已经开始下沉到高中生市场了"},{"start":282.63,"end":284.87,"text":"搁这他妈的cosplay也就算了"},{"start":284.87,"end":290.63,"text":"还还要向现实投射输送权力体系和暴力"},{"start":291.05,"end":292.21,"text":"在群里面装逼"},{"start":292.21,"end":296.17,"text":"说自己有什么有枪到这种程度了"},{"start":298.88,"end":300.0,"text":"口嗨啊"},{"start":300.0,"end":301.48,"text":"口嗨涉及暴力"},{"start":301.48,"end":301.8,"text":"口嗨"},{"start":301.8,"end":303.96,"text":"那不是一般的口嗨啊"},{"start":305.47,"end":307.55,"text":"狂妄至极"},{"start":308.58,"end":310.14,"text":"这个就跟什么理论"},{"start":310.14,"end":310.82,"text":"什么科学"},{"start":310.82,"end":314.36,"text":"什么什么都没关系啦"},{"start":321.74,"end":323.12,"text":"你还是打什么女权"},{"start":323.12,"end":324.38,"text":"什么什么旗号"},{"start":324.38,"end":328.35,"text":"你就开始各地封官爵了"},{"start":328.47,"end":332.03,"text":"就开始吹嘘自己有武装力量了"},{"start":332.03,"end":333.59,"text":"你口嗨口嗨"},{"start":333.59,"end":337.19,"text":"这个东西不管你的政治意识形态是什么的"},{"start":337.87,"end":339.51,"text":"你用任何政治意识形态"},{"start":343.39,"end":344.51,"text":"还搞人身崇拜"},{"start":344.51,"end":345.68,"text":"人身依附"},{"start":345.68,"end":349.48,"text":"龚一群高中小孩玩这个游戏"},{"start":351.2,"end":355.54,"text":"这是妄作妄作在妄作啊"},{"start":355.54,"end":358.04,"text":"不知常妄作凶"},{"start":360.14,"end":363.14,"text":"啊所有这些往左"},{"start":364.18,"end":367.54,"text":"我们这个术语是我发明的"},{"start":367.54,"end":369.58,"text":"我会比较详细的"},{"start":374.53,"end":375.99,"text":"然后我告诉你们啊"},{"start":375.99,"end":378.05,"text":"比如说你们崇拜的一些老同志"},{"start":378.05,"end":380.23,"text":"在我们看来也是妄作"},{"start":380.23,"end":381.67,"text":"他不是王左"},{"start":381.67,"end":383.19,"text":"他也不是什么线下的"},{"start":383.19,"end":386.3,"text":"什么非常有根基的行行动派"},{"start":386.3,"end":389.14,"text":"他就是倍狂背"},{"start":389.14,"end":390.909,"text":"狂妄至极"},{"start":390.909,"end":394.529,"text":"他做的那事情根本在现实中没有生根发芽"},{"start":394.529,"end":395.609,"text":"落地的"},{"start":395.609,"end":398.169,"text":"获得历史的回响的那种机会的"},{"start":398.169,"end":400.049,"text":"纯粹是捣乱"},{"start":400.209,"end":401.889,"text":"纯粹是弄丑闻"},{"start":401.889,"end":403.289,"text":"干脏事儿"},{"start":403.289,"end":405.669,"text":"纯粹是自杀性的"},{"start":405.669,"end":406.649,"text":"毁灭性的"},{"start":406.649,"end":408.37,"text":"自杀性的"},{"start":408.37,"end":410.73,"text":"就这些好"},{"start":410.73,"end":413.2,"text":"好像自己是革命战士"},{"start":413.2,"end":416.51,"text":"好像自己是伟大的这个革命家"},{"start":416.51,"end":417.91,"text":"这都啥呀"},{"start":417.91,"end":421.31,"text":"纯粹破坏这个做的严重的是恐怖分子"},{"start":421.31,"end":424.67,"text":"做的轻微的就是疯子精神病"},{"start":425.09,"end":428.55,"text":"这都处处于一种精神病理化狂妄的一个状态"},{"start":428.55,"end":433.08,"text":"那么这种狂妄的状态延伸到小孩身上去了啊"},{"start":433.08,"end":435.76,"text":"这小孩他这个心里还有修复的可能性"},{"start":435.76,"end":437.489,"text":"那些二三十岁的啊"},{"start":437.489,"end":439.169,"text":"这那中年的还是那老年的"},{"start":439.169,"end":442.78,"text":"那精神失常已经没有修复的可能性了"},{"start":443.34,"end":447.1,"text":"王佐开始崇拜这群望左了"},{"start":447.73,"end":450.79,"text":"这是个很值得观察的现象"},{"start":450.79,"end":453.27,"text":"越狂妄越他妈无脑"},{"start":453.27,"end":454.35,"text":"越"},{"start":454.35,"end":456.61,"text":"越好像犯病一样的"},{"start":456.61,"end":458.53,"text":"这些王佐越崇拜他们"},{"start":458.53,"end":460.33,"text":"这是个小自然界的逻辑"},{"start":460.33,"end":462.17,"text":"就像那群望族里面的"},{"start":462.17,"end":463.13,"text":"有些唯唯诺诺的"},{"start":463.13,"end":466.41,"text":"一些小孩会崇拜他那个大哥领袖一样"},{"start":466.41,"end":468.13,"text":"其实那大哥领袖屁都不是"},{"start":468.13,"end":470.25,"text":"就是狂妄勇莽"},{"start":470.25,"end":471.19,"text":"仅此而已"},{"start":471.19,"end":472.41,"text":"一一点学问都没有的"},{"start":472.41,"end":474.37,"text":"包括之前那个编选集的那个"},{"start":474.37,"end":477.05,"text":"包括现在这个小孩一点本事"},{"start":477.05,"end":477.85,"text":"一点能力都没有"},{"start":477.85,"end":479.99,"text":"他就是狂妄瞎做瞎搞"},{"start":479.99,"end":482.049,"text":"他敢去担责任嘛"},{"start":482.049,"end":483.329,"text":"他真的能担责任吗"},{"start":483.329,"end":485.62,"text":"担不了他就是鲁莽"},{"start":485.62,"end":490.38,"text":"那么类似的这群王佐崇拜这群望族也是一样的"},{"start":490.38,"end":491.06,"text":"思想"},{"start":491.06,"end":493.049,"text":"一样的规则"},{"start":493.049,"end":495.549,"text":"就是无非就是一群孬货"},{"start":495.549,"end":498.03,"text":"孬种去拜一个疯子"},{"start":498.03,"end":500.81,"text":"拜一群好像有胆有勇的一个人"},{"start":500.81,"end":501.57,"text":"这个东西的嘛"},{"start":501.57,"end":503.09,"text":"我们精确的评价定义"},{"start":503.09,"end":506.64,"text":"这个东西是小资产阶级里面长出来的"},{"start":506.64,"end":507.92,"text":"Protofascism"},{"start":507.92,"end":509.87,"text":"原法西斯主义"},{"start":509.87,"end":512.57,"text":"他是亲自由主义经济秩序的"},{"start":512.57,"end":515.578,"text":"他是亲近于自由主义经济秩序的"},{"start":515.578,"end":519.558,"text":"但是呢他是要一个没有资本主义的"},{"start":519.558,"end":523.01,"text":"或者没有自由主义的弊端的自由主义"},{"start":523.01,"end":527.8,"text":"他们所所盼望所所想要获得的是没有"},{"start":527.8,"end":530.7,"text":"比如说没有道德败坏"},{"start":530.7,"end":532.36,"text":"没有贪污腐败"},{"start":532.36,"end":534.0,"text":"没有环境污染"},{"start":534.0,"end":537.96,"text":"没有这个家庭生活的窒息啊"},{"start":537.96,"end":539.6,"text":"没有是没有压迫"},{"start":539.6,"end":541.16,"text":"没有什么的资本主义"},{"start":541.16,"end":543.28,"text":"没有资本主义的坏处的资本主义"},{"start":543.28,"end":545.79,"text":"他们要的是一个纯资本主义"},{"start":545.99,"end":547.03,"text":"明白吗"},{"start":554.18,"end":555.64,"text":"也意味着集权"},{"start":555.64,"end":557.01,"text":"也意味着控制"},{"start":557.01,"end":560.4,"text":"也意味着某种形式上的剥夺和压迫"},{"start":566.32,"end":569.57,"text":"他们