{"segments":[{"start":0.0,"end":1.02,"text":"这个人还给我扣帽子"},{"start":1.02,"end":1.98,"text":"说我是黑格尔主义者"},{"start":1.98,"end":3.0,"text":"说的是唯心主义者"},{"start":3.0,"end":4.74,"text":"这本质上是唯心主义的"},{"start":5.2,"end":8.14,"text":"是我在不同视频中都能发现我的唯心主义错误"},{"start":13.9,"end":16.89,"text":"乌托邦那个空想"},{"start":16.89,"end":19.71,"text":"你只在一个场的时候是空想"},{"start":19.71,"end":21.84,"text":"你能够数千万人陷入空想"},{"start":21.84,"end":23.82,"text":"你就是很厉害的地缘玩家"},{"start":27.46,"end":29.52,"text":"它有批量的组织动员力"},{"start":29.62,"end":31.3,"text":"你手下超过十个人"},{"start":31.3,"end":32.2,"text":"你就知道了"},{"start":32.2,"end":33.22,"text":"就是这个东西"},{"start":33.22,"end":34.32,"text":"我再强调一遍"},{"start":34.64,"end":39.2,"text":"乌托邦理想国理想性的一个社会图景"},{"start":39.2,"end":42.46,"text":"你必然要给你的你你的同伴"},{"start":42.46,"end":44.58,"text":"你的追随者一定要告诉他们的"},{"start":44.8,"end":45.88,"text":"你一定要说清楚"},{"start":45.88,"end":47.41,"text":"而且这是个理论斗争"},{"start":47.41,"end":50.2,"text":"因为瞄准这个乌托邦的种种路线"},{"start":53.11,"end":54.43,"text":"现实的你的路线"},{"start":57.34,"end":59.44,"text":"这个这个东西就是乌托邦"},{"start":59.44,"end":60.16,"text":"在这个意义上讲"},{"start":63.1,"end":64.129,"text":"实践工具"},{"start":64.129,"end":65.689,"text":"他不是个理论"},{"start":65.689,"end":67.28,"text":"他甚至都不是个理论"},{"start":68.28,"end":69.26,"text":"你没有这个东西"},{"start":69.26,"end":70.58,"text":"你怎么团结人嘛"},{"start":70.58,"end":71.72,"text":"怎么批量团结人"},{"start":71.72,"end":74.38,"text":"你要描绘一个理想世界图景告诉你们"},{"start":74.38,"end":75.64,"text":"然后你要告诉他们"},{"start":75.64,"end":77.62,"text":"我们要抵达这个理想世界的图景"},{"start":77.62,"end":78.94,"text":"我们的权利怎么分配的"},{"start":78.94,"end":80.2,"text":"你十个人投票"},{"start":80.2,"end":81.96,"text":"大家的权重是怎么样的"},{"start":84.32,"end":85.66,"text":"这叫唯心主义"},{"start":86.98,"end":88.72,"text":"你们我求求你们多学学"},{"start":88.72,"end":91.94,"text":"还有一个或者说真正正儿八经的"},{"start":97.84,"end":99.4,"text":"你必然要做"},{"start":99.4,"end":101.56,"text":"有可能说你悬置乌托邦"},{"start":101.56,"end":104.16,"text":"悬置你们最终的那个理想"},{"start":104.16,"end":106.06,"text":"纲领性的理想的这个状况"},{"start":106.68,"end":108.38,"text":"那你就给不出路线啊"},{"start":108.38,"end":109.46,"text":"你要抵达那边"},{"start":109.46,"end":111.32,"text":"你就有个路线往哪走啊"},{"start":112.2,"end":113.54,"text":"什么在未明子看来"},{"start":115.64,"end":118.08,"text":"从自发走向自觉的必然产物"},{"start":118.2,"end":120.09,"text":"这就是走向自觉啊"},{"start":120.09,"end":123.48,"text":"这已经是走向自觉统合所有人头打当中"},{"start":123.48,"end":125.24,"text":"对于乌托邦的幻想"},{"start":125.34,"end":127.02,"text":"要批量分发乌托邦"},{"start":129.36,"end":130.329,"text":"它对于乌托邦"},{"start":130.329,"end":132.62,"text":"但有人想的是田园诗歌"},{"start":132.62,"end":136.04,"text":"有的想象成就是住这个这个高级公寓"},{"start":136.04,"end":138.2,"text":"有的想象成就是说可以做人上人"},{"start":138.2,"end":139.99,"text":"有的想象成可以当皇帝"},{"start":139.99,"end":140.59,"text":"你懂吗"},{"start":141.43,"end":142.81,"text":"他的乌托邦想法是不一样"},{"start":142.81,"end":143.83,"text":"你要统合它"},{"start":143.83,"end":147.22,"text":"这本身就是从自发走向自觉要整合"},{"start":148.279,"end":151.119,"text":"说什么猎灵机占有了数千万人"},{"start":151.119,"end":153.039,"text":"陷入了某种乌托邦式的空想"},{"start":153.039,"end":153.789,"text":"对没错"},{"start":153.789,"end":155.56,"text":"确实让他们陷入了"},{"start":155.78,"end":158.12,"text":"让他们获得了乌托邦式的空想"},{"start":158.12,"end":160.64,"text":"同时也让他们沉浸在抵达"},{"start":160.64,"end":163.4,"text":"走向那个乌托邦的现实斗争过程啊"},{"start":163.66,"end":166.72,"text":"让数千万人都有一个同样的乌托邦"},{"start":166.72,"end":169.34,"text":"然后大家都往那个方向去努力"},{"start":169.619,"end":171.059,"text":"据实践"},{"start":173.699,"end":174.72,"text":"给工分"},{"start":175.719,"end":177.1,"text":"给义务劳动"},{"start":179.1,"end":180.68,"text":"你必须要有这个东西啊"},{"start":180.68,"end":184.28,"text":"你必须要有你的最终的这个理想理想图景"},{"start":184.28,"end":185.52,"text":"社会理想图景啊"},{"start":188.58,"end":192.42,"text":"这本身这本身就是革命的一部分啊"},{"start":192.7,"end":194.44,"text":"这本身就是观念革命"},{"start":194.44,"end":198.82,"text":"一代人对于人类要走向生活的终极模式"},{"start":198.82,"end":200.68,"text":"要发展身边这本来就观念革命"},{"start":200.68,"end":202.26,"text":"当然是现实革命的一部分啊"},{"start":202.839,"end":205.119,"text":"我所以你这个也就是说"},{"start":207.309,"end":210.26,"text":"纯粹你自己在胡诌革命"},{"start":210.26,"end":213.68,"text":"当然是社会经济政治矛盾的必然产物啊"},{"start":213.899,"end":216.269,"text":"但是它甚至这个必然性"},{"start":216.269,"end":219.94,"text":"它是需要精神作为它的一个环节的"},{"start":220.1,"end":222.14,"text":"精神上要达到统一了"},{"start":222.14,"end":224.54,"text":"那么多人都有一个指向共同的乌托邦"},{"start":224.54,"end":225.84,"text":"才能更好的去"},{"start":227.0,"end":230.48,"text":"更好的去指引引导这个革命的发生"},{"start":233.85,"end":234.66,"text":"成功的灌输"},{"start":234.66,"end":238.38,"text":"使得很多人陷入某种乌托邦式的理想"},{"start":238.38,"end":240.5,"text":"我告诉你没错"},{"start":242.96,"end":243.92,"text":"成功的灌输"},{"start":243.92,"end":248.18,"text":"使得很多人陷入同一种乌托邦式的理想主义"},{"start":248.18,"end":250.04,"text":"这就是强大的社会动能"},{"start":250.04,"end":251.24,"text":"那么再进一步分析"},{"start":251.24,"end":251.96,"text":"在威尼斯看来"},{"start":251.96,"end":253.82,"text":"革命的热情和意愿不是矛盾的"},{"start":253.82,"end":255.55,"text":"现实产当然是矛盾的"},{"start":255.55,"end":257.659,"text":"现实产生的是现实的矛盾产生的"},{"start":257.659,"end":259.099,"text":"而是知识分子"},{"start":259.099,"end":262.309,"text":"知识分子灌输本身也是矛盾的现实产生的呀"},{"start":262.309,"end":264.79,"text":"知识分子为什么愿意去做这个灌输工作吗"},{"start":264.79,"end":268.12,"text":"太原工业是现实的经济政治矛盾导致的吗"},{"start":268.86,"end":269.75,"text":"在搞笑"},{"start":269.75,"end":273.38,"text":"恰恰是这个作者本人在把知识分子的灌输"},{"start":273.38,"end":276.52,"text":"好像剥离到社会经济现实之外去"},{"start":276.88,"end":278.92,"text":"知识分子的灌输活动"},{"start":278.92,"end":280.18,"text":"先锋队的灌输活动"},{"start":280.18,"end":284.24,"text":"本也是政治经济现实的矛盾的内在显现"},{"start":284.76,"end":286.92,"text":"不是离开的乌托邦"},{"start":286.92,"end":288.63,"text":"本也是乌托邦"},{"start":288.63,"end":293.94,"text":"知识分子灌输本就是政治经济矛盾的内在显现"},{"start":301.07,"end":302.64,"text":"不同侧面而已"},{"start":302.7,"end":304.14,"text":"恰恰是这个人"},{"start":304.14,"end":306.66,"text":"他认为知识分子的灌输就是高级的"},{"start":306.66,"end":309.62,"text":"就是不是你明白吗"},{"start":309.62,"end":312.08,"text":"他预设了知识分子的灌输乌托邦"},{"start":312.08,"end":313.82,"text":"这种东西是游离在社会之外的"},{"start":313.82,"end":314.96,"text":"游离在现实之外的"},{"start":314.96,"end":317.53,"text":"所以他觉得这种东西不应该去指导现实"},{"start":317.53,"end":320.12,"text":"但是它本就是现实的一部分啊"},{"start":321.66,"end":323.84,"text":"说因此不是革命的政治经济环境"},{"start":323.84,"end":325.58,"text":"使人产生革命的意识"},{"start":326.86,"end":328.98,"text":"进而产生革命的行动"},{"start":328.98,"end":330.18,"text":"本来就是这样"},{"start":330.18,"end":333.24,"text":"本不是说革命的政治经济环境"},{"start":333.24,"end":335.78,"text":"政治经济环境本身没有什么革命的可言"},{"start":335.94,"end":338.83,"text":"政治经济环境没有什么革命不革命的"},{"start":338.83,"end":340.6,"text":"没有什么革命不革命的"},{"start":340.6,"end":341.83,"text":"政治经济环境"},{"start":341.83,"end":343.72,"text":"产生了革命性的社会运动"},{"start":343.72,"end":347.18,"text":"就革命性的社会运动本身就包含革命性的意识"},{"start":349.18,"end":352.41,"text":"说r是在就是这个人一直在认为"},{"start":352.41,"end":355.88,"text":"知识分子的头脑好像可以离开这个东西啊"},{"start":356.56,"end":358.14,"text":"说现实不是第一位的"},{"start":358.14,"end":358.92,"text":"意识是第一位的"},{"start":358.92,"end":361.76,"text":"这是未名子的唯心主义现实"},{"start":362.12,"end":364.76,"text":"当然是不是你的产业"},{"start":364.76,"end":368.0,"text":"我们说现实的内在矛盾是第一位的"},{"start":368.0,"end":371.26,"text":"现实人们他这个现实的内在矛盾"},{"start":371.26,"end":373.66,"text":"它所中介出来的有两层运动"},{"start":373.66,"end":374.83,"text":"一层是经验"},{"start":374.83,"end":375.96,"text":"观念上的"},{"start":375.96,"end":377.22,"text":"是观念上的运动"},{"start":377.22,"end":378.06,"text":"精神上的运动"},{"start":378.06,"end":381.59,"text":"一层是物质力量对比的一个运动"},{"start":381.59,"end":385.52,"text":"这两种运动都是现实的内在矛盾产生的"},{"start":388.639,"end":390.079,"text":"达成他的统一性"},{"start":393.859,"end":395.26,"text":"达成他的统一性"},{"start":397.42,"end":399.39,"text":"弑君权的抢夺"},{"start":399.39,"end":402.06,"text":"说说我认为精神是试金权"},{"start":402.06,"end":403.86,"text":"抢夺只是我的工作的一部分"},{"start":403.86,"end":405.96,"text":"我没有说他这是个唯一的工作"},{"start":406.26,"end":407.52,"text":"他只是工作一部分"},{"start":407.52,"end":412.2,"text":"他就我开学习黑客三大目的"},{"start":412.2,"end":413.25,"text":"第一项是抢答"},{"start":413.25,"end":414.18,"text":"抢夺视金权"},{"start":414.18,"end":416.91,"text":"但并不意味着这是唯一的唯一的工作"},{"start":416.91,"end":420.64,"text":"学习黑格也只是你学习的东西