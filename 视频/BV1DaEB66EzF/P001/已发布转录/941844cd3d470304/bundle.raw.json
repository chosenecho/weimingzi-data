{"segments":[{"start":0.0,"end":1.56,"text":"肯定失效的啊"},{"start":1.56,"end":3.46,"text":"缠斗论是会失效的"},{"start":3.46,"end":5.54,"text":"缠斗论是呃"},{"start":5.54,"end":7.02,"text":"目前在这个阶段"},{"start":7.02,"end":10.16,"text":"发展到我们这个体量或者这种这种行的"},{"start":10.16,"end":12.659,"text":"这种形势之下"},{"start":12.659,"end":14.159,"text":"缠斗论是失效的"},{"start":14.159,"end":17.819,"text":"你们在线下肯定有人听过我讲什么叫缠斗论啊"},{"start":17.819,"end":19.479,"text":"缠斗论已经失效了"},{"start":19.479,"end":23.46,"text":"然后你也不能指望所谓你中有我"},{"start":23.46,"end":24.06,"text":"我中有你"},{"start":24.06,"end":27.46,"text":"那种状态可以给你提供多大的活动空间"},{"start":27.46,"end":29.86,"text":"你只能被吞噬啊"},{"start":29.86,"end":31.52,"text":"这个层层叠叠的"},{"start":31.52,"end":32.6,"text":"谁的层次多"},{"start":32.6,"end":33.96,"text":"谁的这种弯绕多"},{"start":33.96,"end":34.76,"text":"那更不要想了"},{"start":34.76,"end":35.88,"text":"肯定会被吞噬啊"},{"start":36.92,"end":42.72,"text":"那要发展一个好的呃运动的思路"},{"start":42.72,"end":46.54,"text":"我们把它叫做拟是吧"},{"start":47.4,"end":49.62,"text":"拟态拟态论啊"},{"start":49.62,"end":51.08,"text":"模拟它的情形态"},{"start":51.08,"end":52.52,"text":"模拟其形态"},{"start":52.52,"end":59.42,"text":"那么拟态论的一个要旨就在于化繁为简啊"},{"start":59.42,"end":61.04,"text":"化繁为简"},{"start":61.04,"end":64.14,"text":"然后就是要"},{"start":66.06,"end":69.15,"text":"怎么样就是一点啊"},{"start":69.15,"end":70.15,"text":"我们先讲这一点"},{"start":70.15,"end":71.83,"text":"可能第二点就呼之欲出了"},{"start":71.83,"end":73.61,"text":"就是说他的层级多"},{"start":73.61,"end":76.13,"text":"他的这个表象繁复"},{"start":76.13,"end":80.01,"text":"那实际上是他在失之于额偏薄啊"},{"start":80.01,"end":81.47,"text":"偏失至于杂糅了"},{"start":81.47,"end":84.11,"text":"杂糅的话反而就是照不到关键点"},{"start":84.11,"end":86.05,"text":"资源投射不到该用的地方去"},{"start":86.05,"end":87.32,"text":"效率低下"},{"start":87.32,"end":88.56,"text":"那我们这拟态论的话"},{"start":88.56,"end":91.18,"text":"就是说在其效率无数"},{"start":91.18,"end":96.189,"text":"结构性的没有办法逆转的低下的那些事情当中"},{"start":96.189,"end":99.44,"text":"我们成为一个就是他本该成为的样子"},{"start":99.44,"end":103.46,"text":"然后在一个就是充沛的富有朝气的意识形态"},{"start":103.46,"end":106.0,"text":"理想信念所驱动的状况之下"},{"start":106.0,"end":107.32,"text":"他本该成为的样子"},{"start":107.32,"end":108.68,"text":"我们把它呈现出来"},{"start":108.68,"end":115.93,"text":"我们作为那样的小的体系存在着要杀便杀"},{"start":116.09,"end":116.53,"text":"我"},{"start":116.53,"end":117.69,"text":"实事求是讲他就不敢了"},{"start":117.69,"end":118.13,"text":"你知道吗"},{"start":118.13,"end":123.62,"text":"实事求是就相当于说是一个这个是什么"},{"start":124.34,"end":127.94,"text":"就是哎这个东西有点恶心啊"},{"start":127.94,"end":133.03,"text":"有点你要把人民群众比喻成是这个就是什么"},{"start":133.54,"end":135.88,"text":"这是甚至说某种审美竞争啊"},{"start":135.88,"end":139.75,"text":"一个就是已经呃坠油的"},{"start":139.75,"end":141.99,"text":"然后靠疯狂擦脂抹粉啊"},{"start":141.99,"end":144.81,"text":"反正就是靠疯狂的这个堆砌的"},{"start":144.81,"end":150.71,"text":"好像来显得还有某种这个年轻和活力的啊"},{"start":150.71,"end":153.51,"text":"一个老的啊"},{"start":153.51,"end":157.17,"text":"或者说已经是比较腐朽的"},{"start":157.17,"end":159.36,"text":"你再说"},{"start":160.48,"end":162.98,"text":"就现在有一个清亮的嗓子"},{"start":162.98,"end":166.7,"text":"或者说一个非常有活力的一个鲜活的"},{"start":166.7,"end":169.06,"text":"他翩然而至"},{"start":169.06,"end":172.1,"text":"然后这个是歌唱吟咏"},{"start":172.1,"end":176.35,"text":"我觉得没有那么轻易的就能够说服观众"},{"start":176.35,"end":179.829,"text":"说这么一个你懂的"},{"start":180.069,"end":181.749,"text":"就是你明白吧"},{"start":181.749,"end":183.909,"text":"这样一种就是坠生物啊"},{"start":183.909,"end":187.43,"text":"那样一种堆叠的褶皱的那样一种存在"},{"start":187.43,"end":189.23,"text":"就能够堂而皇之"},{"start":189.23,"end":193.419,"text":"轻而易举的就去把这样一个呃"},{"start":193.419,"end":195.47,"text":"轻盈的灵动的存在"},{"start":195.47,"end":197.27,"text":"就给它吞噬掉"},{"start":197.27,"end":198.35,"text":"或者污染掉"},{"start":198.35,"end":201.05,"text":"或者纯粹就是除这后快"},{"start":201.05,"end":202.65,"text":"那这个没什么好说的"},{"start":202.65,"end":203.25,"text":"明白吗"},{"start":203.25,"end":204.29,"text":"这是一方面啊"},{"start":204.29,"end":207.21,"text":"就是说你要化繁为简啊"},{"start":207.21,"end":209.03,"text":"要是抓到主要矛盾"},{"start":209.03,"end":213.71,"text":"然后用有限的资源来实现一个就是结构性的"},{"start":213.71,"end":216.85,"text":"沉重而迟滞的那样一个体系"},{"start":216.85,"end":218.67,"text":"他没有办法去解决的"},{"start":218.67,"end":222.37,"text":"没有办法去快速梳理出来的一些工作思路"},{"start":222.37,"end":225.01,"text":"方法啊"},{"start":225.01,"end":226.37,"text":"这样轻装上阵"},{"start":226.37,"end":228.15,"text":"船小好掉头"},{"start":228.15,"end":232.91,"text":"然后抓到结构性的那些要点和关键实实行"},{"start":232.91,"end":238.93,"text":"这个就是说呃权责统一落实到位的一种分工"},{"start":240.01,"end":243.55,"text":"把路他就对啊"},{"start":243.55,"end":246.23,"text":"就相当于一个呃"},{"start":248.14,"end":251.899,"text":"呃就是历史碑刻上的痕迹"},{"start":251.899,"end":254.439,"text":"不需要你拿一大坨"},{"start":254.439,"end":256.49,"text":"那是什么油墨"},{"start":256.49,"end":258.769,"text":"什么朱漆往上面全给糊上去了"},{"start":258.769,"end":261.329,"text":"最后一坨红的一坨黑的什么玩意"},{"start":261.329,"end":264.27,"text":"你知道用毛笔去描摹勾勒"},{"start":264.27,"end":267.47,"text":"顺着他的这个这个走向啊"},{"start":267.47,"end":271.83,"text":"顺着他的这个凿痕呐去运转"},{"start":271.83,"end":274.99,"text":"这个就是我们要做的真正在深刻的地方"},{"start":274.99,"end":279.849,"text":"真正在这个转折曲折困难的地方"},{"start":279.849,"end":282.659,"text":"就顺应历史的这根本逻辑"},{"start":282.659,"end":285.679,"text":"然后就是说让这个人类文明"},{"start":285.679,"end":288.92,"text":"还以这个有意义的转折来呈现"},{"start":288.92,"end":292.68,"text":"体现出文化文明的追求的这样一种努力"},{"start":294.08,"end":300.379,"text":"没有他就是完全糊糊糊住那个大字碑"},{"start":300.379,"end":301.259,"text":"全给他糊上"},{"start":301.259,"end":303.479,"text":"我们还是能打我们的小草稿的嘛"},{"start":303.479,"end":305.58,"text":"我们就是打这种呃"},{"start":305.58,"end":310.649,"text":"就是真的能能够折射出书法灵韵的"},{"start":310.649,"end":313.31,"text":"那种小草稿啊"},{"start":313.59,"end":314.99,"text":"应该是可以的"},{"start":314.99,"end":316.57,"text":"这个是我们可以做到的"},{"start":316.57,"end":322.8,"text":"所以所以这第一步就是这个要删繁就简啊"},{"start":322.8,"end":324.6,"text":"要这个抓住关键"},{"start":324.6,"end":333.989,"text":"这个所谓的拟态你不像不是因为你太多哦"},{"start":333.989,"end":334.909,"text":"不是因为你太少"},{"start":334.909,"end":335.769,"text":"是因为你太多"},{"start":335.769,"end":336.589,"text":"你要像的话"},{"start":336.589,"end":337.809,"text":"把关键点抓住"},{"start":337.809,"end":341.62,"text":"他本该像或者说他曾经像样过"},{"start":341.62,"end":344.86,"text":"曾经有那种灵动的气质"},{"start":344.86,"end":348.06,"text":"那种清新的那种风貌"},{"start":348.06,"end":349.34,"text":"曾经像样过"},{"start":349.34,"end":354.37,"text":"那曾经的那个他的这个眉眼是如何线条勾勒的"},{"start":354.37,"end":357.56,"text":"曾经的气度和曾经的这个姿态"},{"start":357.56,"end":364.22,"text":"是这个举手投足间是如何这个呃接续转折的"},{"start":364.22,"end":365.72,"text":"我们要做到位"},{"start":365.72,"end":367.2,"text":"这就不是模仿了"},{"start":367.2,"end":367.76,"text":"对不对"},{"start":367.76,"end":369.26,"text":"就是说抓住灵魂"},{"start":369.26,"end":370.57,"text":"抓住关键"},{"start":370.57,"end":374.63,"text":"那么这个叫删繁就简这一步"},{"start":374.99,"end":376.27,"text":"然后是第二部的话"},{"start":376.27,"end":378.11,"text":"就是"},{"start":380.62,"end":382.02,"text":"既然是拟态论"},{"start":382.02,"end":387.41,"text":"那就是说要在细节上进行自主的闭合啊"},{"start":387.41,"end":389.87,"text":"其实要要怎么样逻辑自主"},{"start":389.87,"end":392.23,"text":"要做到逻辑上自主"},{"start":392.23,"end":398.56,"text":"这个要有这个问题导向的系统性思维"},{"start":398.56,"end":400.64,"text":"有科学的理论"},{"start":400.64,"end":404.24,"text":"这个理论是在意识形态哲学层面的"},{"start":404.24,"end":405.32,"text":"甚至是宇宙论"},{"start":405.32,"end":409.25,"text":"本体论层面的理论所一以贯之的见基啊"},{"start":409.25,"end":412.13,"text":"那么这是能够重新塑造"},{"start":412.13,"end":415.439,"text":"这个是我要说的信仰的理论啊"},{"start":415.439,"end":418.219,"text":"就是能够形成逻辑独立"},{"start":418.219,"end":419.95,"text":"逻辑的闭合"},{"start":420.19,"end":422.25,"text":"这是非常重要的"},{"start":422.25,"end":425.43,"text":"要有一个呃拟态论的话"},{"start":425.43,"end":428.12,"text":"就是要有一个他都他不的"},{"start":428.12,"end":429.76,"text":"他全是阿谀奉承"},{"start":429.76,"end":430.64,"text":"矫揉造作"},{"start":430.64,"end":431.4,"text":"虚头巴脑"},{"start":431.4,"end":432.4,"text":"繁文褥节"},{"start":432.4,"end":434.22,"text":"垃圾玩意一堆"},{"start":434.22,"end":436.14,"text":"拼命写那种什么黑话"},{"start":436.14,"end":437.02,"text":"弯弯绕材料"},{"start":437.02,"end":437.82,"text":"什么东西的"},{"start":437.82,"end":439.94,"text":"不能够鞭辟就里"},{"start":439.94,"end":444.09,"text":"不能够这个切入实情"},{"start":444.09,"end":451.769,"text":"也就是说要有一个叫通过有一个啊这个开明的"},{"start":45