    {
      "ordinal": 298,
      "start_ms": 796680,
      "end_ms": 800100,
      "text": "应当有社群性和合租阶段一样"
    },
    {
      "ordinal": 299,
      "start_ms": 800100,
      "end_ms": 802410,
      "text": "和青年的合租时期是一样的"
    },
    {
      "ordinal": 300,
      "start_ms": 802410,
      "end_ms": 805980,
      "text": "应当有继续有无产阶级的社群性"
    },
    {
      "ordinal": 301,
      "start_ms": 805980,
      "end_ms": 809980,
      "text": "但是没有任何政治组织"
    },
    {
      "ordinal": 302,
      "start_ms": 809980,
      "end_ms": 813000,
      "text": "不抱任何政治性的团"
    },
    {
      "ordinal": 303,
      "start_ms": 813400,
      "end_ms": 815160,
