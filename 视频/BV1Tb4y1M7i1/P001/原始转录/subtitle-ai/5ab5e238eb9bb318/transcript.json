{
  "bvid": "BV1Tb4y1M7i1",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "5ab5e238eb9bb318c8db8d5e2bd9263118fb4089265ab300dde70e350d90676b",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 80,
      "end_ms": 3050,
      "text": "呃这个要澄清一个误会啊"
    },
    {
      "ordinal": 1,
      "start_ms": 3050,
      "end_ms": 10090,
      "text": "就是说我们一贯的我我的团队"
    },
    {
      "ordinal": 2,
      "start_ms": 10090,
      "end_ms": 13000,
      "text": "我的团队所帮助的人"
    },
    {
      "ordinal": 3,
      "start_ms": 13000,
      "end_ms": 17430,
      "text": "我们一贯的立场是没有叫你离开城市啊"
    },
    {
      "ordinal": 4,
      "start_ms": 17430,
      "end_ms": 21650,
      "text": "无产青年没有说让你离开城市"
    },
    {
      "ordinal": 5,
      "start_ms": 21650,
      "end_ms": 26510,
      "text": "你应当尽可能地在城市当中"
    },
    {
      "ordinal": 6,
      "start_ms": 26510,
      "end_ms": 30555,
      "text": "获得工作机会和发展机会"
    },
    {
      "ordinal": 7,
      "start_ms": 31880,
      "end_ms": 34060,
      "text": "但是"
    },
    {
      "ordinal": 8,
      "start_ms": 38440,
      "end_ms": 42390,
      "text": "有些游戏它像击鼓传花"
    },
    {
      "ordinal": 9,
      "start_ms": 42390,
      "end_ms": 46760,
      "text": "最后那一棒你不要接"
    },
    {
      "ordinal": 10,
      "start_ms": 48960,
      "end_ms": 52820,
      "text": "有些明显让你陷于不利的处境"
    },
    {
      "ordinal": 11,
      "start_ms": 54020,
      "end_ms": 57890,
      "text": "明显是击鼓传花的第一棒"
    },
    {
      "ordinal": 12,
      "start_ms": 57890,
      "end_ms": 62640,
      "text": "第二棒的人占大便宜的一些游戏不要去玩"
    },
    {
      "ordinal": 13,
      "start_ms": 64199,
      "end_ms": 66739,
      "text": "那么具体怎么说呢"
    },
    {
      "ordinal": 14,
      "start_ms": 67369,
      "end_ms": 71529,
      "text": "无产青年呢在接受了一定的城市教育"
    },
    {
      "ordinal": 15,
      "start_ms": 71529,
      "end_ms": 73239,
      "text": "在城市啊接受了一定的教育"
    },
    {
      "ordinal": 16,
      "start_ms": 73239,
      "end_ms": 74570,
      "text": "学历教育"
    },
    {
      "ordinal": 17,
      "start_ms": 74570,
      "end_ms": 76970,
      "text": "文化教育和技能教育之后"
    },
    {
      "ordinal": 18,
      "start_ms": 79250,
      "end_ms": 85880,
      "text": "应当在自己能够获得尽量多的便利的"
    },
    {
      "ordinal": 19,
      "start_ms": 85880,
      "end_ms": 87650,
      "text": "比如说你有老乡"
    },
    {
      "ordinal": 20,
      "start_ms": 87650,
      "end_ms": 89940,
      "text": "有长辈在这里工作"
    },
    {
      "ordinal": 21,
      "start_ms": 89940,
      "end_ms": 91800,
      "text": "比如说你这里有朋友"
    },
    {
      "ordinal": 22,
      "start_ms": 91800,
      "end_ms": 93000,
      "text": "有同学"
    },
    {
      "ordinal": 23,
      "start_ms": 93340,
      "end_ms": 95190,
      "text": "比如说你的行业"
    },
    {
      "ordinal": 24,
      "start_ms": 95190,
      "end_ms": 98790,
      "text": "你的学习的内容在这里特别有发展机会"
    },
    {
      "ordinal": 25,
      "start_ms": 98790,
      "end_ms": 101160,
      "text": "应当在此"
    },
    {
      "ordinal": 26,
      "start_ms": 102170,
      "end_ms": 103660,
      "text": "某种意义上讲啊"
    },
    {
      "ordinal": 27,
      "start_ms": 103660,
      "end_ms": 106500,
      "text": "叫暂时性的扎根"
    },
    {
      "ordinal": 28,
      "start_ms": 107080,
      "end_ms": 109680,
      "text": "那么要做到几点啊"
    },
    {
      "ordinal": 29,
      "start_ms": 109680,
      "end_ms": 112530,
      "text": "首先要降低生活成本"
    },
    {
      "ordinal": 30,
      "start_ms": 113350,
      "end_ms": 115050,
      "text": "要降低生活成本"
    },
    {
      "ordinal": 31,
      "start_ms": 115050,
      "end_ms": 116730,
      "text": "怎么降低生活成本呢"
    },
    {
      "ordinal": 32,
      "start_ms": 116730,
      "end_ms": 117810,
      "text": "你花的钱要少花"
    },
    {
      "ordinal": 33,
      "start_ms": 117810,
      "end_ms": 118920,
      "text": "怎么降低生活成本"
    },
    {
      "ordinal": 34,
      "start_ms": 118920,
      "end_ms": 123130,
      "text": "合租合租"
    },
    {
      "ordinal": 35,
      "start_ms": 124840,
      "end_ms": 126480,
      "text": "然后要自食其力"
    },
    {
      "ordinal": 36,
      "start_ms": 126480,
      "end_ms": 128580,
      "text": "各种事情呢能够自己解决的"
    },
    {
      "ordinal": 37,
      "start_ms": 128580,
      "end_ms": 130669,
      "text": "要自己去解决"
    },
    {
      "ordinal": 38,
      "start_ms": 131070,
      "end_ms": 134930,
      "text": "那么你说你没有朋友"
    },
    {
      "ordinal": 39,
      "start_ms": 134930,
      "end_ms": 137950,
      "text": "没有朋友怎么合租呢"
    },
    {
      "ordinal": 40,
      "start_ms": 138290,
      "end_ms": 143440,
      "text": "那你在你的行业当中能认识类似的啊"
    },
    {
      "ordinal": 41,
      "start_ms": 143440,
      "end_ms": 145390,
      "text": "同样专业的青年"
    },
    {
      "ordinal": 42,
      "start_ms": 145390,
      "end_ms": 148420,
      "text": "同样出身条件的青年"
    },
    {
      "ordinal": 43,
      "start_ms": 148760,
      "end_ms": 150460,
      "text": "这个成为朋友了"
    },
    {
      "ordinal": 44,
      "start_ms": 150460,
      "end_ms": 151510,
      "text": "怎么成为朋友"
    },
    {
      "ordinal": 45,
      "start_ms": 151510,
      "end_ms": 155720,
      "text": "通过玩乐往往是通过娱乐活动"
    },
    {
      "ordinal": 46,
      "start_ms": 155720,
      "end_ms": 156740,
      "text": "对不对"
    },
    {
      "ordinal": 47,
      "start_ms": 156740,
      "end_ms": 158180,
      "text": "往往是首先通过"
    },
    {
      "ordinal": 48,
      "start_ms": 158180,
      "end_ms": 159380,
      "text": "那这个我们要说的"
    },
    {
      "ordinal": 49,
      "start_ms": 159380,
      "end_ms": 160940,
      "text": "你要有目的的"
    },
    {
      "ordinal": 50,
      "start_ms": 160940,
      "end_ms": 164959,
      "text": "是要找那些可以和你一块租房子住的"
    },
    {
      "ordinal": 51,
      "start_ms": 164959,
      "end_ms": 167059,
      "text": "那么你要和别人一块居住"
    },
    {
      "ordinal": 52,
      "start_ms": 167059,
      "end_ms": 168829,
      "text": "你的一些陋习"
    },
    {
      "ordinal": 53,
      "start_ms": 168829,
      "end_ms": 172450,
      "text": "一些有这个让别人感到有恶感的"
    },
    {
      "ordinal": 54,
      "start_ms": 172450,
      "end_ms": 175770,
      "text": "一些陋习就要改掉啊"
    },
    {
      "ordinal": 55,
      "start_ms": 175770,
      "end_ms": 177899,
      "text": "你要讲卫生"
    },
    {
      "ordinal": 56,
      "start_ms": 178419,
      "end_ms": 181769,
      "text": "要有比较良好的作息啊"
    },
    {
      "ordinal": 57,
      "start_ms": 181769,
      "end_ms": 184439,
      "text": "不赌不嫖"
    },
    {
      "ordinal": 58,
      "start_ms": 185849,
      "end_ms": 187279,
      "text": "要干净"
    },
    {
      "ordinal": 59,
      "start_ms": 188860,
      "end_ms": 189870,
      "text": "明白吧"
    },
    {
      "ordinal": 60,
      "start_ms": 189870,
      "end_ms": 193950,
      "text": "那你找这些朋友呢也要找类似的朋友"
    },
    {
      "ordinal": 61,
      "start_ms": 193950,
      "end_ms": 195480,
      "text": "要少良家子"
    },
    {
      "ordinal": 62,
      "start_ms": 195480,
      "end_ms": 199030,
      "text": "良家子干干净净的"
    },
    {
      "ordinal": 63,
      "start_ms": 199850,
      "end_ms": 202630,
      "text": "你找到这些类似的朋友了之后呢"
    },
    {
      "ordinal": 64,
      "start_ms": 202630,
      "end_ms": 206260,
      "text": "可以不要太多太多"
    },
    {
      "ordinal": 65,
      "start_ms": 206260,
      "end_ms": 207460,
      "text": "你也租不了那房子"
    },
    {
      "ordinal": 66,
      "start_ms": 207460,
      "end_ms": 208030,
      "text": "对不对"
    },
    {
      "ordinal": 67,
      "start_ms": 208030,
      "end_ms": 208900,
      "text": "三五个人"
    },
    {
      "ordinal": 68,
      "start_ms": 208900,
      "end_ms": 209380,
      "text": "四五个人"
    },
    {
      "ordinal": 69,
      "start_ms": 209380,
      "end_ms": 211410,
      "text": "五六个人合租"
    },
    {
      "ordinal": 70,
      "start_ms": 211410,
      "end_ms": 215550,
      "text": "这样便宜的工作相对比较稳定"
    },
    {
      "ordinal": 71,
      "start_ms": 215890,
      "end_ms": 220790,
      "text": "那么你是通过这个呃玩啊"
    },
    {
      "ordinal": 72,
      "start_ms": 220790,
      "end_ms": 223670,
      "text": "往往是动物玩耍玩耍玩乐"
    },
    {
      "ordinal": 73,
      "start_ms": 223670,
      "end_ms": 225710,
      "text": "实际上因为刚出校门"
    },
    {
      "ordinal": 74,
      "start_ms": 225710,
      "end_ms": 227640,
      "text": "大家头脑都比较简单"
    },
    {
      "ordinal": 75,
      "start_ms": 227640,
      "end_ms": 229380,
      "text": "光是玩耍玩乐"
    },
    {
      "ordinal": 76,
      "start_ms": 229380,
      "end_ms": 231000,
      "text": "你们只是一个玩伴"
    },
    {
      "ordinal": 77,
      "start_ms": 231000,
      "end_ms": 235830,
      "text": "那么在有的关键节点上要互相帮助啊"
    },
    {
      "ordinal": 78,
      "start_ms": 235830,
      "end_ms": 237090,
      "text": "比如说他被欺负了"
    },
    {
      "ordinal": 79,
      "start_ms": 237090,
      "end_ms": 237930,
      "text": "找你谈心"
    },
    {
      "ordinal": 80,
      "start_ms": 237930,
      "end_ms": 238920,
      "text": "你要有耐心"
    },
    {
      "ordinal": 81,
      "start_ms": 238920,
      "end_ms": 240510,
      "text": "你要帮他开解"
    },
    {
      "ordinal": 82,
      "start_ms": 240510,
      "end_ms": 241170,
      "text": "他"
    },
    {
      "ordinal": 83,
      "start_ms": 241170,
      "end_ms": 242340,
      "text": "想要争取一些"
    },
    {
      "ordinal": 84,
      "start_ms": 242340,
      "end_ms": 244605,
      "text": "你要帮他去争取"
    },
    {
      "ordinal": 85,
      "start_ms": 245220,
      "end_ms": 247160,
      "text": "这样你们共同生活"
    },
    {
      "ordinal": 86,
      "start_ms": 247160,
      "end_ms": 248000,
      "text": "共同帮助"
    },
    {
      "ordinal": 87,
      "start_ms": 248000,
      "end_ms": 248990,
      "text": "共同扶持"
    },
    {
      "ordinal": 88,
      "start_ms": 248990,
      "end_ms": 250760,
      "text": "生活成本就低的"
    },
    {
      "ordinal": 89,
      "start_ms": 250760,
      "end_ms": 253160,
      "text": "不要"
    },
    {
      "ordinal": 90,
      "start_ms": 254230,
      "end_ms": 257700,
      "text": "谈朋友谈朋友就是想要找女人"
    },
    {
      "ordinal": 91,
      "start_ms": 257700,
      "end_ms": 259339,
      "text": "找异性"
    },
    {
      "ordinal": 92,
      "start_ms": 259800,
      "end_ms": 260360,
      "text": "谈朋友"
    },
    {
      "ordinal": 93,
      "start_ms": 260360,
      "end_ms": 263960,
      "text": "谈朋友实际上是想要找工友啊"
    },
    {
      "ordinal": 94,
      "start_ms": 263960,
      "end_ms": 265160,
      "text": "找这个劳动伙伴"
    },
    {
      "ordinal": 95,
      "start_ms": 265160,
      "end_ms": 267800,
      "text": "生活伙伴合租"
    },
    {
      "ordinal": 96,
      "start_ms": 267800,
      "end_ms": 269240,
      "text": "大家几个认识"
    },
    {
      "ordinal": 97,
      "start_ms": 269240,
      "end_ms": 270170,
      "text": "成为朋友了"
    },
    {
      "ordinal": 98,
      "start_ms": 270170,
      "end_ms": 271340,
      "text": "降低生活成本"
    },
    {
      "ordinal": 99,
      "start_ms": 272360,
      "end_ms": 274220,
      "text": "那么它规模比较大的情况"
    },
    {
      "ordinal": 100,
      "start_ms": 274220,
      "end_ms": 276820,
      "text": "就是我的俱乐部的情况"
    },
    {
      "ordinal": 101,
      "start_ms": 276980,
      "end_ms": 278290,
      "text": "我们的俱乐部啊"
    },
    {
      "ordinal": 102,
      "start_ms": 278290,
      "end_ms": 281380,
      "text": "其实就是有很多个这样的一个"
    },
    {
      "ordinal": 103,
      "start_ms": 281380,
      "end_ms": 285600,
      "text": "一起工作的年轻人啊"
    },
    {
      "ordinal": 104,
      "start_ms": 285600,
      "end_ms": 286830,
      "text": "就我说了"
    },
    {
      "ordinal": 105,
      "start_ms": 286830,
      "end_ms": 287700,
      "text": "我始终说了"
    },
    {
      "ordinal": 106,
      "start_ms": 287700,
      "end_ms": 290409,
      "text": "我的主要受众是无产青年"
    },
    {
      "ordinal": 107,
      "start_ms": 290409,
      "end_ms": 291549,
      "text": "中上层的"
    },
    {
      "ordinal": 108,
      "start_ms": 291549,
      "end_ms": 293649,
      "text": "在城市里面接受过中专以上"
    },
    {
      "ordinal": 109,
      "start_ms": 293649,
      "end_ms": 296649,
      "text": "大专本科甚至本科教育的无产青年"
    },
    {
      "ordinal": 110,
      "start_ms": 296649,
      "end_ms": 300550,
      "text": "他们的家庭不可能让他成为城市小资产阶级的"
    },
    {
      "ordinal": 111,
      "start_ms": 300550,
      "end_ms": 302050,
      "text": "凑不出那几百万"
    },
    {
      "ordinal": 112,
      "start_ms": 302050,
      "end_ms": 302650,
      "text": "给他几10万"
    },
    {
      "ordinal": 113,
      "start_ms": 302650,
      "end_ms": 304700,
      "text": "给他出首付的"
    },
    {
      "ordinal": 114,
      "start_ms": 304980,
      "end_ms": 308780,
      "text": "他们最优解就是几个一起抱团合租个房子"
    },
    {
      "ordinal": 115,
      "start_ms": 308780,
      "end_ms": 309890,
      "text": "降低生活成本"
    },
    {
      "ordinal": 116,
      "start_ms": 309890,
      "end_ms": 313310,
      "text": "一块找工作找机会啊"
    },
    {
      "ordinal": 117,
      "start_ms": 313310,
      "end_ms": 316030,
      "text": "还有个文化生态文化形态"
    },
    {
      "ordinal": 118,
      "start_ms": 316190,
      "end_ms": 317620,
      "text": "所以我们再强调一遍"
    },
    {
      "ordinal": 119,
      "start_ms": 317620,
      "end_ms": 320110,
      "text": "我说对于无产阶级青年啊"
    },
    {
      "ordinal": 120,
      "start_ms": 320110,
      "end_ms": 322700,
      "text": "没有说让你离开大城市"
    },
    {
      "ordinal": 121,
      "start_ms": 322700,
      "end_ms": 326150,
      "text": "没有说让你回到这个对于你们更没有发展机会"
    },
    {
      "ordinal": 122,
      "start_ms": 326150,
      "end_ms": 328570,
      "text": "对于你们更难以去啊"
    },
    {
      "ordinal": 123,
      "start_ms": 328570,
      "end_ms": 333200,
      "text": "承受相应的一些潜规则的剥削和侵略啊"
    },
    {
      "ordinal": 124,
      "start_ms": 333200,
      "end_ms": 335060,
      "text": "没有说让你们回到那边去"
    },
    {
      "ordinal": 125,
      "start_ms": 335060,
      "end_ms": 338130,
      "text": "那么有一个例外的情况"
    },
    {
      "ordinal": 126,
      "start_ms": 338590,
      "end_ms": 341880,
      "text": "有一个例外的情况呃"
    },
    {
      "ordinal": 127,
      "start_ms": 341880,
      "end_ms": 344670,
      "text": "就是你要为你的子女注册公民权"
    },
    {
      "ordinal": 128,
      "start_ms": 344670,
      "end_ms": 347900,
      "text": "公民身份要落户口"
    },
    {
      "ordinal": 129,
      "start_ms": 347900,
      "end_ms": 351620,
      "text": "那么夫妻两个这个情况之下是这样的"
    },
    {
      "ordinal": 130,
      "start_ms": 351620,
      "end_ms": 355380,
      "text": "你们积攒的财富应该回老家去买房"
    },
    {
      "ordinal": 131,
      "start_ms": 355380,
      "end_ms": 356900,
      "text": "不要在大城市买"
    },
    {
      "ordinal": 132,
      "start_ms": 356900,
      "end_ms": 358280,
      "text": "入城税太高了"
    },
    {
      "ordinal": 133,
      "start_ms": 358280,
      "end_ms": 360530,
      "text": "它的小资产阶级有个概念叫入城税"
    },
    {
      "ordinal": 134,
      "start_ms": 360530,
      "end_ms": 363440,
      "text": "把这个房价高高涨的房价叫入城税"
    },
    {
      "ordinal": 135,
      "start_ms": 363440,
      "end_ms": 365300,
      "text": "这是整个地价体系不会崩的"
    },
    {
      "ordinal": 136,
      "start_ms": 365300,
      "end_ms": 366620,
      "text": "很难崩的"
    },
    {
      "ordinal": 137,
      "start_ms": 366710,
      "end_ms": 369050,
      "text": "它牵引的是后面的这个工业地价"
    },
    {
      "ordinal": 138,
      "start_ms": 369050,
      "end_ms": 372290,
      "text": "也包括那个大片的土地的定价"
    },
    {
      "ordinal": 139,
      "start_ms": 373780,
      "end_ms": 374820,
      "text": "就很难崩的"
    },
    {
      "ordinal": 140,
      "start_ms": 375900,
      "end_ms": 377340,
      "text": "高昂的入城税"
    },
    {
      "ordinal": 141,
      "start_ms": 377340,
      "end_ms": 381730,
      "text": "不要支付你和你的伴侣"
    },
    {
      "ordinal": 142,
      "start_ms": 381730,
      "end_ms": 383660,
      "text": "你们组建的家庭生出来的小孩"
    },
    {
      "ordinal": 143,
      "start_ms": 383660,
      "end_ms": 387200,
      "text": "如果说为了让这个孩子在大城市里面接受什么"
    },
    {
      "ordinal": 144,
      "start_ms": 387200,
      "end_ms": 388880,
      "text": "什么叫游说的你无产阶级家庭"
    },
    {
      "ordinal": 145,
      "start_ms": 388880,
      "end_ms": 392850,
      "text": "你的子女想要凭借一个所谓环境的改变"
    },
    {
      "ordinal": 146,
      "start_ms": 392850,
      "end_ms": 395760,
      "text": "所谓一个受教育权的一个一个什么什么提升"
    },
    {
      "ordinal": 147,
      "start_ms": 395760,
      "end_ms": 401900,
      "text": "然后能够跨越这个在目前来讲很难很难"
    },
    {
      "ordinal": 148,
      "start_ms": 402480,
      "end_ms": 404840,
      "text": "那自然阶级小资产阶级家庭都是什么"
    },
    {
      "ordinal": 149,
      "start_ms": 404840,
      "end_ms": 406970,
      "text": "三四点钟就去接孩子的"
    },
    {
      "ordinal": 150,
      "start_ms": 406970,
      "end_ms": 410360,
      "text": "那都是车停在大门口的学校"
    },
    {
      "ordinal": 151,
      "start_ms": 410360,
      "end_ms": 411410,
      "text": "大门口的"
    },
    {
      "ordinal": 152,
      "start_ms": 411410,
      "end_ms": 414530,
      "text": "接了之后就直接送补习班"
    },
    {
      "ordinal": 153,
      "start_ms": 414530,
      "end_ms": 416480,
      "text": "那补习班都是一个月七八千"
    },
    {
      "ordinal": 154,
      "start_ms": 416480,
      "end_ms": 417350,
      "text": "你们哪有钱"
    },
    {
      "ordinal": 155,
      "start_ms": 417350,
      "end_ms": 418070,
      "text": "你卷不过的"
    },
    {
      "ordinal": 156,
      "start_ms": 418070,
      "end_ms": 419730,
      "text": "玩不过的"
    },
    {
      "ordinal": 157,
      "start_ms": 419730,
      "end_ms": 426090,
      "text": "所以说你们组建家庭可以回回你老家小县城"
    },
    {
      "ordinal": 158,
      "start_ms": 426090,
      "end_ms": 428250,
      "text": "或者说四五线小城市"
    },
    {
      "ordinal": 159,
      "start_ms": 429270,
      "end_ms": 432179,
      "text": "中小城市边缘线城市啊"
    },
    {
      "ordinal": 160,
      "start_ms": 432179,
      "end_ms": 433930,
      "text": "去买房"
    },
    {
      "ordinal": 161,
      "start_ms": 433930,
      "end_ms": 435910,
      "text": "如果是这个东西是比较保守的"
    },
    {
      "ordinal": 162,
      "start_ms": 435910,
      "end_ms": 436420,
      "text": "对不对"
    },
    {
      "ordinal": 163,
      "start_ms": 436420,
      "end_ms": 437890,
      "text": "因为你只有买了房"
    },
    {
      "ordinal": 164,
      "start_ms": 437890,
      "end_ms": 440030,
      "text": "你的你的子女才有城市户口啊"
    },
    {
      "ordinal": 165,
      "start_ms": 440030,
      "end_ms": 442040,
      "text": "只不过是在小城市的城市户口"
    },
    {
      "ordinal": 166,
      "start_ms": 442040,
      "end_ms": 447340,
      "text": "它有相应的相应的它才有相应的这些权利"
    },
    {
      "ordinal": 167,
      "start_ms": 447340,
      "end_ms": 450300,
      "text": "受教育权撤点并校"
    },
    {
      "ordinal": 168,
      "start_ms": 450300,
      "end_ms": 453810,
      "text": "并出来的那个学校稍微还算是相对的"
    },
    {
      "ordinal": 169,
      "start_ms": 453810,
      "end_ms": 457030,
      "text": "这个评价标准就是说什么样的初衷"
    },
    {
      "ordinal": 170,
      "start_ms": 457030,
      "end_ms": 460930,
      "text": "他还是正儿八经学文化课的初衷"
    },
    {
      "ordinal": 171,
      "start_ms": 461390,
      "end_ms": 462550,
      "text": "那么现在目前看来"
    },
    {
      "ordinal": 172,
      "start_ms": 462550,
      "end_ms": 463390,
      "text": "他是在县城"
    },
    {
      "ordinal": 173,
      "start_ms": 463390,
      "end_ms": 464770,
      "text": "县中可能还好一点"
    },
    {
      "ordinal": 174,
      "start_ms": 464770,
      "end_ms": 469240,
      "text": "那么稍微再差一点的五线六线的小城市的"
    },
    {
      "ordinal": 175,
      "start_ms": 469240,
      "end_ms": 472240,
      "text": "他的他的这个市中市集中市二中"
    },
    {
      "ordinal": 176,
      "start_ms": 472240,
      "end_ms": 472720,
      "text": "13中"
    },
    {
      "ordinal": 177,
      "start_ms": 472720,
      "end_ms": 474220,
      "text": "这些中学可能还好点"
    },
    {
      "ordinal": 178,
      "start_ms": 474220,
      "end_ms": 475470,
      "text": "初中还好一点"
    },
    {
      "ordinal": 179,
      "start_ms": 475470,
      "end_ms": 476880,
      "text": "还能文化课里面"
    },
    {
      "ordinal": 180,
      "start_ms": 476880,
      "end_ms": 478950,
      "text": "就是学生在那样的学校里面"
    },
    {
      "ordinal": 181,
      "start_ms": 478950,
      "end_ms": 481850,
      "text": "还不会早恋到怀孕的那种程度"
    },
    {
      "ordinal": 182,
      "start_ms": 481850,
      "end_ms": 485220,
      "text": "抽烟喝酒到相互斗殴的那种程度"
    },
    {
      "ordinal": 183,
      "start_ms": 485440,
      "end_ms": 489000,
      "text": "确保你的子女在那样的那样的初中里面"
    },
    {
      "ordinal": 184,
      "start_ms": 489000,
      "end_ms": 491460,
      "text": "能够念上书"
    },
    {
      "ordinal": 185,
      "start_ms": 492240,
      "end_ms": 497060,
      "text": "这个要求就是对于无产阶级夫妻来讲啊"
    },
    {
      "ordinal": 186,
      "start_ms": 497060,
      "end_ms": 498450,
      "text": "小的家庭来讲"
    },
    {
      "ordinal": 187,
      "start_ms": 498450,
      "end_ms": 499290,
      "text": "就是这个建议"
    },
    {
      "ordinal": 188,
      "start_ms": 499290,
      "end_ms": 502650,
      "text": "你要确保你的孩子要在这个限度上"
    },
    {
      "ordinal": 189,
      "start_ms": 502650,
      "end_ms": 505080,
      "text": "能读上一个干净的初衷"
    },
    {
      "ordinal": 190,
      "start_ms": 505080,
      "end_ms": 506190,
      "text": "干净哦"
    },
    {
      "ordinal": 191,
      "start_ms": 506190,
      "end_ms": 507450,
      "text": "他的底线是干净"
    },
    {
      "ordinal": 192,
      "start_ms": 507450,
      "end_ms": 508170,
      "text": "甚至都不需要"
    },
    {
      "ordinal": 193,
      "start_ms": 508170,
      "end_ms": 510270,
      "text": "就是里面的学生很聪明"
    },
    {
      "ordinal": 194,
      "start_ms": 510270,
      "end_ms": 511470,
      "text": "底线就是干净"
    },
    {
      "ordinal": 195,
      "start_ms": 511470,
      "end_ms": 514620,
      "text": "不需要他的那个文化教育特别好干净"
    },
    {
      "ordinal": 196,
      "start_ms": 514620,
      "end_ms": 517590,
      "text": "女生不会因为早恋啊这个什么"
    },
    {
      "ordinal": 197,
      "start_ms": 523339,
      "end_ms": 526309,
      "text": "然后不会有是什么这个劣迹斑斑的"
    },
    {
      "ordinal": 198,
      "start_ms": 526309,
      "end_ms": 527749,
      "text": "这个什么校园性侵"
    },
    {
      "ordinal": 199,
      "start_ms": 527749,
      "end_ms": 530400,
      "text": "包括是什么性骚扰这种东西"
    },
    {
      "ordinal": 200,
      "start_ms": 530400,
      "end_ms": 532230,
      "text": "男生不会抽烟烫头"
    },
    {
      "ordinal": 201,
      "start_ms": 532230,
      "end_ms": 534620,
      "text": "不会打架斗殴"
    },
    {
      "ordinal": 202,
      "start_ms": 537180,
      "end_ms": 539660,
      "text": "主要就是干净"
    },
    {
      "ordinal": 203,
      "start_ms": 540780,
      "end_ms": 543800,
      "text": "不要对你的孩子卷学历"
    },
    {
      "ordinal": 204,
      "start_ms": 543800,
      "end_ms": 546020,
      "text": "升学教育什么这个东西有什么期盼"
    },
    {
      "ordinal": 205,
      "start_ms": 546020,
      "end_ms": 547220,
      "text": "主要是干净"
    },
    {
      "ordinal": 206,
      "start_ms": 547220,
      "end_ms": 549339,
      "text": "我再强调一遍"
    },
    {
      "ordinal": 207,
      "start_ms": 549780,
      "end_ms": 554830,
      "text": "干净对于现在的无产阶级很重要很重要"
    },
    {
      "ordinal": 208,
      "start_ms": 554830,
      "end_ms": 556690,
      "text": "干净很重要"
    },
    {
      "ordinal": 209,
      "start_ms": 556690,
      "end_ms": 559930,
      "text": "不干净的就没有力量了"
    },
    {
      "ordinal": 210,
      "start_ms": 561520,
      "end_ms": 562260,
      "text": "不干净的"
    },
    {
      "ordinal": 211,
      "start_ms": 562260,
      "end_ms": 563820,
      "text": "到时候黑帮化被俘获的话"
    },
    {
      "ordinal": 212,
      "start_ms": 563820,
      "end_ms": 566220,
      "text": "就是给小资产阶级自然界送死了"
    },
    {
      "ordinal": 213,
      "start_ms": 566220,
      "end_ms": 567090,
      "text": "做炮灰了"
    },
    {
      "ordinal": 214,
      "start_ms": 567090,
      "end_ms": 569150,
      "text": "你们的长远利益就被牺牲了"
    },
    {
      "ordinal": 215,
      "start_ms": 569150,
      "end_ms": 575210,
      "text": "因为它可以用很小的很小的用一些啊性享乐啊"
    },
    {
      "ordinal": 216,
      "start_ms": 575210,
      "end_ms": 578320,
      "text": "就是色情啊"
    },
    {
      "ordinal": 217,
      "start_ms": 578320,
      "end_ms": 581800,
      "text": "还或者说用一些成瘾性的违禁品"
    },
    {
      "ordinal": 218,
      "start_ms": 581800,
      "end_ms": 584980,
      "text": "就可以让你们用一点点小的成本"
    },
    {
      "ordinal": 219,
      "start_ms": 584980,
      "end_ms": 587140,
      "text": "就可以让你支付非常大的代价"
    },
    {
      "ordinal": 220,
      "start_ms": 587140,
      "end_ms": 588400,
      "text": "给他们送死卖命了"
    },
    {
      "ordinal": 221,
      "start_ms": 589480,
      "end_ms": 592850,
      "text": "所以说所以说我对这个无产阶级家庭的建议"
    },
    {
      "ordinal": 222,
      "start_ms": 592850,
      "end_ms": 596339,
      "text": "就是说做潮汐式的服务器"
    },
    {
      "ordinal": 223,
      "start_ms": 596919,
      "end_ms": 600950,
      "text": "你们青年趁着年轻要在城市里面继续生活"
    },
    {
      "ordinal": 224,
      "start_ms": 600950,
      "end_ms": 603020,
      "text": "那么也是和朋友合租"
    },
    {
      "ordinal": 225,
      "start_ms": 603020,
      "end_ms": 606490,
      "text": "或者说以一个俱乐部作为单位的这样的来合租"
    },
    {
      "ordinal": 226,
      "start_ms": 606490,
      "end_ms": 608320,
      "text": "来共同共同工作"
    },
    {
      "ordinal": 227,
      "start_ms": 608320,
      "end_ms": 611980,
      "text": "然后有这个共同的这个健身锻炼"
    },
    {
      "ordinal": 228,
      "start_ms": 611980,
      "end_ms": 614050,
      "text": "青年在俱乐部"
    },
    {
      "ordinal": 229,
      "start_ms": 614050,
      "end_ms": 615100,
      "text": "不在俱乐部的话"
    },
    {
      "ordinal": 230,
      "start_ms": 615100,
      "end_ms": 619240,
      "text": "那就是说各种合租的这个合租的寝室里面"
    },
    {
      "ordinal": 231,
      "start_ms": 619240,
      "end_ms": 622680,
      "text": "宿舍里面青年无论在俱乐部还是在宿舍"
    },
    {
      "ordinal": 232,
      "start_ms": 622680,
      "end_ms": 624660,
      "text": "都要养成良好的生活习惯"
    },
    {
      "ordinal": 233,
      "start_ms": 624660,
      "end_ms": 625589,
      "text": "要锻炼"
    },
    {
      "ordinal": 234,
      "start_ms": 625589,
      "end_ms": 627179,
      "text": "要脱离低级趣味"
    },
    {
      "ordinal": 235,
      "start_ms": 627179,
      "end_ms": 631469,
      "text": "不要有一些成瘾性的赌博嫖娼这些东西"
    },
    {
      "ordinal": 236,
      "start_ms": 632640,
      "end_ms": 638529,
      "text": "更重要的是不要上小资产阶级的政治口语癖啊"
    },
    {
      "ordinal": 237,
      "start_ms": 638529,
      "end_ms": 640719,
      "text": "不要被小资阶级媒体鼓动了"
    },
    {
      "ordinal": 238,
      "start_ms": 640719,
      "end_ms": 644260,
      "text": "然后冲塔不要负政治代价"
    },
    {
      "ordinal": 239,
      "start_ms": 644260,
      "end_ms": 646060,
      "text": "因为付出的这些政治代价"
    },
    {
      "ordinal": 240,
      "start_ms": 646060,
      "end_ms": 650179,
      "text": "如果触及一些啊监视的红线的话"
    },
    {
      "ordinal": 241,
      "start_ms": 650179,
      "end_ms": 654919,
      "text": "你们这个集群性的生活的这个低成本的优势"
    },
    {
      "ordinal": 242,
      "start_ms": 654919,
      "end_ms": 656800,
      "text": "也就没有了"
    },
    {
      "ordinal": 243,
      "start_ms": 656800,
      "end_ms": 659020,
      "text": "你甚至租房子都租不到的"
    },
    {
      "ordinal": 244,
      "start_ms": 659020,
      "end_ms": 661210,
      "text": "你甚至租房子都租不到了"
    },
    {
      "ordinal": 245,
      "start_ms": 661210,
      "end_ms": 662800,
      "text": "在大城市租房子都租不到"
    },
    {
      "ordinal": 246,
      "start_ms": 662800,
      "end_ms": 664500,
      "text": "大城市治安都比较好的"
    },
    {
      "ordinal": 247,
      "start_ms": 664500,
      "end_ms": 666750,
      "text": "你甚至租房子都没有这个资格"
    },
    {
      "ordinal": 248,
      "start_ms": 666750,
      "end_ms": 668940,
      "text": "这个是我下个视频要讲的"
    },
    {
      "ordinal": 249,
      "start_ms": 668940,
      "end_ms": 673940,
      "text": "那么这个视频我们再回过头来就叫夫妻回乡"
    },
    {
      "ordinal": 250,
      "start_ms": 673940,
      "end_ms": 674900,
      "text": "回乡"
    },
    {
      "ordinal": 251,
      "start_ms": 674900,
      "end_ms": 675920,
      "text": "不是回农村啊"
    },
    {
      "ordinal": 252,
      "start_ms": 675920,
      "end_ms": 677840,
      "text": "回你老家的小县城"
    },
    {
      "ordinal": 253,
      "start_ms": 677840,
      "end_ms": 680300,
      "text": "或者说四五线啊"
    },
    {
      "ordinal": 254,
      "start_ms": 680300,
      "end_ms": 685030,
      "text": "这这个城市中小城市结婚买房生小孩"
    },
    {
      "ordinal": 255,
      "start_ms": 685030,
      "end_ms": 689800,
      "text": "孩子尽量让他们上到一个干净的初衷"
    },
    {
      "ordinal": 256,
      "start_ms": 689800,
      "end_ms": 691060,
      "text": "干净的初中"
    },
    {
      "ordinal": 257,
      "start_ms": 691060,
      "end_ms": 692080,
      "text": "毕业了之后呢"
    },
    {
      "ordinal": 258,
      "start_ms": 692080,
      "end_ms": 693580,
      "text": "他无论是去学技术"
    },
    {
      "ordinal": 259,
      "start_ms": 693580,
      "end_ms": 694240,
      "text": "上中专呢"
    },
    {
      "ordinal": 260,
      "start_ms": 694240,
      "end_ms": 696280,
      "text": "还是说还是高中要尝试尝试这个东西"
    },
    {
      "ordinal": 261,
      "start_ms": 696280,
      "end_ms": 699830,
      "text": "再说这个东西要看大气候了"
    },
    {
      "ordinal": 262,
      "start_ms": 699830,
      "end_ms": 700610,
      "text": "目前来讲的话"
    },
    {
      "ordinal": 263,
      "start_ms": 700610,
      "end_ms": 704050,
      "text": "你们我给的建议就是说你们先走这一步"
    },
    {
      "ordinal": 264,
      "start_ms": 704930,
      "end_ms": 707500,
      "text": "很多无产阶级选择的也就是这一步"
    },
    {
      "ordinal": 265,
      "start_ms": 707500,
      "end_ms": 709690,
      "text": "他们也就是这样选的"
    },
    {
      "ordinal": 266,
      "start_ms": 709690,
      "end_ms": 711880,
      "text": "小学是带到城市里面来念的"
    },
    {
      "ordinal": 267,
      "start_ms": 711880,
      "end_ms": 714130,
      "text": "初中回去就要挑干净的初衷"
    },
    {
      "ordinal": 268,
      "start_ms": 714130,
      "end_ms": 714850,
      "text": "不能脏"
    },
    {
      "ordinal": 269,
      "start_ms": 714850,
      "end_ms": 717070,
      "text": "孩子不能脏掉"
    },
    {
      "ordinal": 270,
      "start_ms": 718120,
      "end_ms": 722780,
      "text": "要洁净肮脏的话就会变成反无产阶级"
    },
    {
      "ordinal": 271,
      "start_ms": 724910,
      "end_ms": 727940,
      "text": "流氓打手嘛"
    },
    {
      "ordinal": 272,
      "start_ms": 732320,
      "end_ms": 736040,
      "text": "他是无产阶级当中的反动无产阶级"
    },
    {
      "ordinal": 273,
      "start_ms": 736140,
      "end_ms": 739730,
      "text": "他们要通想要通过出卖肉体"
    },
    {
      "ordinal": 274,
      "start_ms": 739730,
      "end_ms": 742550,
      "text": "出卖暴力来实现阶级跃迁"
    },
    {
      "ordinal": 275,
      "start_ms": 742550,
      "end_ms": 746349,
      "text": "快速的阶级跃迁是违背无产阶级的整体利益的"
    },
    {
      "ordinal": 276,
      "start_ms": 746349,
      "end_ms": 747909,
      "text": "虽然他们也是无产阶级"
    },
    {
      "ordinal": 277,
      "start_ms": 747909,
      "end_ms": 751080,
      "text": "但是他们是反无产阶级"
    },
    {
      "ordinal": 278,
      "start_ms": 752680,
      "end_ms": 754680,
      "text": "就不要做打手"
    },
    {
      "ordinal": 279,
      "start_ms": 758180,
      "end_ms": 759760,
      "text": "啊不要做流氓"
    },
    {
      "ordinal": 280,
      "start_ms": 759760,
      "end_ms": 761170,
      "text": "那么我们回过头来讲"
    },
    {
      "ordinal": 281,
      "start_ms": 761170,
      "end_ms": 763000,
      "text": "让孩子保证有捷径的"
    },
    {
      "ordinal": 282,
      "start_ms": 763000,
      "end_ms": 763960,
      "text": "到初中教育就行了"
    },
    {
      "ordinal": 283,
      "start_ms": 763960,
      "end_ms": 765100,
      "text": "因为初中成人了"
    },
    {
      "ordinal": 284,
      "start_ms": 765100,
      "end_ms": 766030,
      "text": "差不多成人了"
    },
    {
      "ordinal": 285,
      "start_ms": 766030,
      "end_ms": 768950,
      "text": "无产阶级的子女就是这初中毕业的话"
    },
    {
      "ordinal": 286,
      "start_ms": 768950,
      "end_ms": 772490,
      "text": "这个耳濡目染的家庭的生存烈度"
    },
    {
      "ordinal": 287,
      "start_ms": 772490,
      "end_ms": 773990,
      "text": "在他有这个压力啊"
    },
    {
      "ordinal": 288,
      "start_ms": 773990,
      "end_ms": 775589,
      "text": "有这个生存烈度的"
    },
    {
      "ordinal": 289,
      "start_ms": 775589,
      "end_ms": 776609,
      "text": "那么回过头来讲"
    },
    {
      "ordinal": 290,
      "start_ms": 776609,
      "end_ms": 779909,
      "text": "就是说这些夫妻要做潮汐式的"
    },
    {
      "ordinal": 291,
      "start_ms": 779909,
      "end_ms": 783500,
      "text": "但是一起的这个潮汐指的就是说"
    },
    {
      "ordinal": 292,
      "start_ms": 783500,
      "end_ms": 785930,
      "text": "并不是说你们分离啊"
    },
    {
      "ordinal": 293,
      "start_ms": 785930,
      "end_ms": 787010,
      "text": "分离开来"
    },
    {
      "ordinal": 294,
      "start_ms": 787010,
      "end_ms": 789100,
      "text": "孩子让老人带啊"
    },
    {
      "ordinal": 295,
      "start_ms": 789100,
      "end_ms": 791280,
      "text": "孩子让老人带"
    },
    {
      "ordinal": 296,
      "start_ms": 791740,
      "end_ms": 794610,
      "text": "孩子寒暑假可以到城市里来居住"
    },
    {
      "ordinal": 297,
      "start_ms": 794610,
      "end_ms": 796680,
      "text": "但是在城市里面居住的话"
