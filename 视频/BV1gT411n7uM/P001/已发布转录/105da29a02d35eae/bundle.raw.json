{"segments":[{"start":0.0,"end":2.04,"text":"我来回应一封信件啊"},{"start":2.04,"end":5.22,"text":"他说刘思墨先生你好"},{"start":5.22,"end":6.36,"text":"我是一名高二学生"},{"start":6.36,"end":7.8,"text":"还有13天就参加考试了"},{"start":7.8,"end":10.2,"text":"按理说我现在应该全力奋考"},{"start":10.2,"end":11.74,"text":"但是没有这个心思"},{"start":12.78,"end":15.68,"text":"我对我未来的人生感到迷茫"},{"start":15.68,"end":20.3,"text":"他高二学生13年参加的是高2年级考试"},{"start":20.84,"end":21.94,"text":"人生感到迷茫"},{"start":21.94,"end":24.34,"text":"此次写信是给他指点一下"},{"start":24.34,"end":25.06,"text":"你"},{"start":25.06,"end":27.64,"text":"写个信教给他人生要指点一下"},{"start":29.94,"end":32.0,"text":"接下来我要讲述困扰我的问题"},{"start":32.0,"end":32.84,"text":"以及原油啊"},{"start":32.84,"end":34.62,"text":"希望花几分钟看一下"},{"start":34.7,"end":36.74,"text":"那他还是单亲家庭长大"},{"start":36.74,"end":38.36,"text":"爹妈八岁的时候离异了"},{"start":38.36,"end":39.65,"text":"跟跟他妈呀啊"},{"start":39.65,"end":40.82,"text":"跟着他妈啊"},{"start":40.82,"end":43.07,"text":"由他母亲抚养单亲家庭啊"},{"start":43.07,"end":45.47,"text":"然后可能这种家庭关系的原因"},{"start":45.47,"end":47.03,"text":"他与他人交往"},{"start":47.03,"end":48.77,"text":"我与他人交往的方式很幼稚"},{"start":48.77,"end":51.47,"text":"或者说我不懂如何真正与他人交往"},{"start":51.47,"end":52.85,"text":"我从小性格比较内向"},{"start":52.85,"end":53.86,"text":"胆小怕事"},{"start":53.86,"end":56.08,"text":"不善与他人开口沟通交流"},{"start":56.08,"end":58.06,"text":"其实我原本是不在乎人际关系的"},{"start":58.06,"end":59.86,"text":"用其他人给我的评价来讲"},{"start":59.86,"end":60.88,"text":"有些没心没肺"},{"start":60.88,"end":61.36,"text":"初中的时候"},{"start":61.36,"end":62.98,"text":"我因为有严重拖延症"},{"start":62.98,"end":64.12,"text":"写作业不专心"},{"start":64.12,"end":64.66,"text":"速度很慢"},{"start":64.66,"end":67.65,"text":"母亲便把我送到当地的晚托班"},{"start":67.65,"end":69.0,"text":"让人监督我写作业"},{"start":69.0,"end":71.67,"text":"晚托班的一个教室里有好几个孩子"},{"start":71.67,"end":73.21,"text":"多数年龄比我大"},{"start":73.21,"end":75.01,"text":"我因为自身比较幼稚"},{"start":75.01,"end":75.73,"text":"又不会说话"},{"start":75.73,"end":78.13,"text":"在一群孩子中和其他人关系都很差"},{"start":78.13,"end":79.27,"text":"正如我前面所说的"},{"start":79.27,"end":81.35,"text":"我当时是一个比较没心没肺的人"},{"start":81.35,"end":83.87,"text":"对于我在晚托班中受到一些排挤"},{"start":83.87,"end":86.83,"text":"往往主要受到的排挤"},{"start":86.83,"end":89.26,"text":"主要来自一个高他一个年级的学姐"},{"start":91.21,"end":92.05,"text":"有些瞧不起我"},{"start":92.05,"end":93.97,"text":"你看很明显这个高他一个年级的学姐"},{"start":93.97,"end":96.4,"text":"就是他对他母亲单亲母亲"},{"start":96.4,"end":97.93,"text":"的啊"},{"start":99.58,"end":104.65,"text":"就是说或者说比她要优化优秀一点或者更合群一点的女人"},{"start":104.65,"end":108.95,"text":"其实就是他妈呀代表能力或者社会社会关系测"},{"start":110.63,"end":111.5,"text":"然后"},{"start":113.8,"end":115.06,"text":"说什么"},{"start":119.36,"end":123.3,"text":"说这个女那个学姐就是比他高一个年级嘛"},{"start":123.3,"end":123.72,"text":"有点卡"},{"start":123.72,"end":124.14,"text":"瞧不起他"},{"start":124.14,"end":125.1,"text":"他没有过于在意"},{"start":125.1,"end":125.49,"text":"他"},{"start":125.49,"end":131.57,"text":"当时不认为身边人对我的想法可能影响到我的一些比较看重的现实力"},{"start":131.57,"end":133.07,"text":"但在初二的时候发生转折"},{"start":133.07,"end":133.91,"text":"主要因为两件事"},{"start":133.91,"end":134.33,"text":"第一件"},{"start":134.33,"end":135.17,"text":"他成绩一直很差"},{"start":135.17,"end":135.89,"text":"不擅长数学"},{"start":135.89,"end":137.21,"text":"虽然在文科上比较优秀"},{"start":137.21,"end":138.769,"text":"在班级中还排上号"},{"start":138.769,"end":140.269,"text":"但也并非很出类拔萃"},{"start":140.269,"end":141.949,"text":"不能弥补我在数学上劣势"},{"start":141.949,"end":143.389,"text":"而中考又眼看快到了"},{"start":143.389,"end":144.75,"text":"当时的我十分焦虑"},{"start":144.75,"end":146.28,"text":"现在依然为数学头疼"},{"start":149.31,"end":150.39,"text":"她指着我的鼻子骂"},{"start":150.39,"end":151.17,"text":"等到初三的时候"},{"start":151.17,"end":152.56,"text":"你等死吧"},{"start":154.31,"end":156.5,"text":"你看她举的例子都是女性"},{"start":156.5,"end":158.54,"text":"一个是比较大一个年级的女生"},{"start":158.54,"end":160.38,"text":"一个是成绩很好的一个女生"},{"start":160.519,"end":162.499,"text":"他的成绩也不是特别差"},{"start":162.499,"end":162.859,"text":"对不对"},{"start":162.859,"end":163.609,"text":"排的上号"},{"start":163.609,"end":165.559,"text":"但是呢他的理科不行"},{"start":165.559,"end":166.72,"text":"数学不行"},{"start":166.72,"end":169.63,"text":"但那个那个女孩子成绩比他更好对吧"},{"start":169.63,"end":171.07,"text":"他还是投射他妈呀"},{"start":171.07,"end":171.43,"text":"你知道吗"},{"start":171.43,"end":174.28,"text":"他提到的例子都是比他大一个年纪的女的"},{"start":174.28,"end":176.29,"text":"社会关系比他会处啊"},{"start":176.29,"end":179.22,"text":"比她成绩更好的一个女的成绩比他更好啊"},{"start":179.22,"end":180.06,"text":"只要他鼻子骂"},{"start":180.06,"end":181.44,"text":"等到初三时候就等死吧"},{"start":184.28,"end":188.159,"text":"是对于是对于母性母亲"},{"start":188.159,"end":190.019,"text":"母亲否定他的价值"},{"start":190.019,"end":192.779,"text":"引起他的这个就是这些女人都是他投射的"},{"start":192.779,"end":193.68,"text":"她的妈"},{"start":194.04,"end":196.23,"text":"第二件事也是在初二"},{"start":196.23,"end":198.72,"text":"我对学校里的一个女生有了好感"},{"start":198.72,"end":200.1,"text":"在几个男同学怂恿下"},{"start":200.1,"end":201.82,"text":"当众对女生表白"},{"start":202.2,"end":203.58,"text":"被对方拒绝"},{"start":203.58,"end":205.32,"text":"明确表示这种行为是骚扰行为"},{"start":205.32,"end":205.83,"text":"如此"},{"start":205.83,"end":206.94,"text":"如果再次冒犯他"},{"start":206.94,"end":208.92,"text":"他会报告给老师啊"},{"start":209.44,"end":213.58,"text":"呃在男同学的怂恿之下去表白了"},{"start":213.58,"end":214.96,"text":"的才初二"},{"start":214.96,"end":216.4,"text":"你表白了干嘛"},{"start":217.16,"end":218.579,"text":"表白了你能干嘛"},{"start":218.579,"end":221.579,"text":"你都做的事都违法犯罪的啊"},{"start":221.579,"end":223.379,"text":"幸亏这个是警示骚扰你"},{"start":223.379,"end":224.159,"text":"表白成功了"},{"start":224.159,"end":226.96,"text":"我才反倒觉得你有违法犯罪的可能性了"},{"start":227.2,"end":231.1,"text":"明白监护人会作为什么监护失责"},{"start":231.1,"end":234.58,"text":"我靠这件事情给了我沉重打击是吧"},{"start":236.38,"end":238.06,"text":"没意义的小孩一样的"},{"start":238.06,"end":240.28,"text":"这件事情给了我沉重打击"},{"start":240.28,"end":245.24,"text":"我正是因为这起事件开始回顾自己过去与他人的交往方式"},{"start":245.24,"end":247.79,"text":"所以其实你会发现就是说她喜欢那个女生"},{"start":247.79,"end":250.86,"text":"她还是一群男人怂恿他去表白"},{"start":250.94,"end":251.84,"text":"you don't understand"},{"start":251.84,"end":253.94,"text":"所以他是很明显"},{"start":253.94,"end":255.47,"text":"他缺失父亲"},{"start":255.47,"end":256.89,"text":"就跟我小时一样"},{"start":258.39,"end":259.31,"text":"缺失父亲"},{"start":259.31,"end":261.709,"text":"她喜欢男喜欢的女性"},{"start":261.709,"end":263.54,"text":"要么就是很像她的母亲"},{"start":263.54,"end":264.71,"text":"或者说比他强势"},{"start":264.71,"end":265.79,"text":"或者说比他有能力"},{"start":265.79,"end":267.179,"text":"或者比她更开朗"},{"start":267.179,"end":269.249,"text":"更有社会人员"},{"start":269.249,"end":271.679,"text":"要么就是其他男人"},{"start":271.679,"end":275.28,"text":"其他男性都那个氛围"},{"start":275.28,"end":279.39,"text":"父亲就是缺失了父亲的这个共同体的氛围"},{"start":279.39,"end":281.34,"text":"同时指向了一个女性"},{"start":282.3,"end":285.32,"text":"所以他他就是说要么就是迷失的方向"},{"start":285.32,"end":286.43,"text":"要找一个爸爸"},{"start":286.43,"end":288.94,"text":"要么就是很明确的有一个妈妈"},{"start":289.0,"end":291.1,"text":"他就是这个家伙就处在找爸爸"},{"start":291.1,"end":291.7,"text":"找妈妈"},{"start":293.44,"end":295.3,"text":"或者在意一些人对他的看法"},{"start":295.3,"end":297.42,"text":"他在意的那些人都是他爸爸妈妈"},{"start":297.42,"end":298.56,"text":"他爸爸是缺失的"},{"start":298.56,"end":301.32,"text":"他妈妈是就是很明确的"},{"start":301.539,"end":302.86,"text":"你中了"},{"start":304.98,"end":306.2,"text":"因为这件事情"},{"start":306.2,"end":309.35,"text":"我正是因为这件事开始回顾自己与他人交往方式"},{"start":309.35,"end":312.92,"text":"意识到我过去和现在人际关系简直一塌糊涂"},{"start":312.96,"end":315.06,"text":"因为你这个人际关系还没有"},{"start":315.06,"end":316.08,"text":"还不是人际关系"},{"start":316.08,"end":318.6,"text":"是一个你家庭关系缺失"},{"start":318.6,"end":322.06,"text":"你要弥补你现在没有人际关系"},{"start":323.74,"end":327.4,"text":"你你对于你想象一个完整的家庭里面"},{"start":327.4,"end":330.56,"text":"有一个啊比你稍强一点的母亲"},{"start":330.56,"end":333.53,"text":"还有一个比你很强大的一个父亲"},{"start":333.53,"end":335.72,"text":"指引着你的很强大的父亲"},{"start":336.18,"end":338.46,"text":"幻幻想一个完整的家庭"},{"start":338.46,"end":341.28,"text":"然后所以你你你喜欢的女人"},{"start":341.28,"end":342.74,"text":"要么他就是"},{"start":344.32,"end":346.86,"text":"一个很强大的父亲"},{"start":346.86,"end":351.65,"text":"要或者说就是所有男人都认为你应当去追求追寻的一个女人"},{"start":351.65,"end":355.669,"text":"要么他就是一个比你稍强一点点的一个一个"},{"start":355.669,"end":359.479,"text":"或者说在某些方面被比你有一定优势的女的"},{"start":359.479,"end":363.229,"text":"你就会觉得这这这这样的女性啊"},{"start":363.229,"end":365.08,"text":"会引发你的爱意啊"},{"start":365.86,"end":368.8,"text":"哎呀什么学学业和社交的双重失败"},{"start":368.8,"end":371.19,"text":"使我陷入无尽的无尽焦虑中"},{"start":371.19,"end":373.11,"text":"每当我想认真做一件事情的时候"},{"start":373.11,"end":374.55,"text":"思想会不受控制的内耗"},{"start":374.55,"end":376.17,"text":"我会担心结果是否成功"},{"start":376.17,"end":377.91,"text":"担心他人对我看法"},{"start":377.91,"end":379.53,"text":"而不能专注于当下所做的事情"},{"start":379.53,"end":381.63,"text":"而且我发现我的生活失去力量来源呢"},{"start":381.63,"end":383.01,"text":"从小没什么高尚的理想"},{"start":383.01,"end":384.74,"text":"胆小怕麻烦又喜欢"},{"start":384.74,"end":386.12,"text":"只喜欢打游戏"},{"start":386.12,"end":387.38,"text":"只要有游戏玩"},{"start":387.38,"end":389.12,"text":"可以不在乎其他人的想法"},{"start":389.12,"end":390.68,"text":"但这次在现实中的失败"},{"start":390.68,"end":393.39,"text":"将他从将我从幻想中拉了出来"},{"start":393.39,"end":394.97,"text":"失败就表白失败吧"},{"start":394.97,"end":399.58,"text":"我意识到游戏中虚假头衔和成就点数不能长久的解决我的困境"},{"start":399.58,"end":401.62,"text":"最终还是要面对现实中那么多人和事"},{"start":401.62,"end":404.2,"text":"我也不是没有找过其他的兴趣爱好"},{"start":404.2,"end":405.4,"text":"我从小喜欢看书"},{"start":405.4,"end":406.36,"text":"但不是看红楼梦"},{"start":406.36,"end":406.78,"text":"西游记"},{"start":406.78,"end":409.489,"text":"而是国外的什么名著或是国外的什么命座"},{"start":409.489,"end":410.509,"text":"他喜欢看什么"},{"start":410.509,"end":411.799,"text":"只是看一些小说"},{"start":411.799,"end":414.179,"text":"多数还是游戏的官方小说"},{"start":414.179,"end":416.279,"text":"我也曾对物理感兴趣"},{"start":416.279,"end":417.599,"text":"但我的数学水平极差"},{"start":417.599,"end":419.22,"text":"虽然物理考过年级第一"},{"start":419.22,"end":423.409,"text":"但我也不觉得自己真的能学好高考物理啊"},{"start":423.409,"end":425.569,"text":"电学当中的一些计算公式就让我头疼"},{"start":425.569,"end":427.489,"text":"我其实也明白我想要什么"},{"start":427.489,"end":428.81,"text":"我想要面子"},{"start":435.05,"end":436.97,"text":"你妈是你妈"},{"start":436.97,"end":438.29,"text":"是一个不完整的爹"},{"start":438.29,"end":440.9,"text":"你妈是一个不够温柔的妈"},{"start":441.14,"end":443.12,"text":"你妈是个不够强势的爹"},{"start":443.12,"end":444.53,"text":"已经不够温柔的吗"},{"start":444.53,"end":448.16,"text":"所以你想要有一个强势的爹和一个温柔的妈"},{"start":450.1,"end":454.2,"text":"最好有个女人在在他身上同时扮演两种角色"},{"start":454.2,"end":455.58,"text":"一方面他是个强势的爹"},{"start":455.58,"end":457.46,"text":"另一方面他是个温柔的妈"},{"start":458.139,"end":460.44,"text":"哪里是要面子呀"},{"start":460.88,"end":466.58,"text":"你是幻想一个在一个你是幻想在和谁谁谁的交往当中和"},{"start":466.58,"end":471.01,"text":"或者说幻想在某件事情的这个呃努力奋斗当中"},{"start":471.01,"end":472.75,"text":"你就能得到一个爹和一个妈"},{"start":472.75,"end":474.28,"text":"一个完整的家庭"},{"start":476.0,"end":476.92,"text":"但以我的能力"},{"start":476.92,"end":478.84,"text":"我得不到我想要的良好的人际关系"},{"start":478.84,"end":481.52,"text":"优异的成绩而让我望而却步"},{"start":481.52,"end":483.2,"text":"但我又如此渴望它"},{"start":483.2,"end":484.34,"text":"我不想被瞧不起"},{"start":484.34,"end":486.2,"text":"以至于我内心无比痛苦"},{"start":486.2,"end":488.0,"text":"谁他妈瞧不起你呀"},{"start":489.0,"end":490.16,"text":"谁想瞧谁"},{"start":490.16,"end":492.26,"text":"有那么多时间一天让我也瞧不起你啊"},{"start":493.7,"end":494.56,"text":"对不对"},{"start":494.979,"end":497.619,"text":"主要是可能是他妈叫皮特啊"},{"start":497.619,"end":499.719,"text":"我给我自己先找个办法带"},{"start":499.719,"end":500.379,"text":"考试结束后"},{"start":500.379,"end":502.78,"text":"打算利用假期时间去兼职"},{"start":502.78,"end":504.64,"text":"一是想感受一下劳动生产的过程"},{"start":504.64,"end":505.72,"text":"给自己找点事做"},{"start":507.58,"end":509.14,"text":"二是想多长点见识"},{"start":509.14,"end":510.04,"text":"认识更多的人"},{"start":510.04,"end":512.409,"text":"我想跳出学校这个封闭的小圈子"},{"start":512.409,"end":514.82,"text":"此外想在假期里多看一点书"},{"start":514.82,"end":516.74,"text":"我已经3年来没怎么看过书了"},{"start":516.74,"end":518.36,"text":"仅有的阅读时间啊"},{"start":518.36,"end":521.01,"text":"是学校里每周固定的一节阅读课"},{"start":521.01,"end":524.01,"text":"我想利用好假期时间把以前买的小说看完"},{"start":524.01,"end":529.81,"text":"我的建议把你买的小说都扔光扔掉啊啊你在那些游戏同人小说看了"},{"start":529.81,"end":530.71,"text":"这就是鸦片啊"},{"start":530.71,"end":531.43,"text":"看了变"},{"start":531.43,"end":533.19,"text":"叫我建议你"},{"start":533.19,"end":535.47,"text":"我命令你不要看这些垃圾而已"},{"start":535.47,"end":536.37,"text":"全部扔掉"},{"start":536.37,"end":539.45,"text":"烧掉没有任何意义"},{"start":539.45,"end":541.68,"text":"他都是文化垃圾"},{"start":543.2,"end":544.24,"text":"啊我的建议"},{"start":544.24,"end":545.5,"text":"那你应该看什么书呢"},{"start":545.5,"end":547.06,"text":"我建议你去看"},{"start":547.66,"end":550.17,"text":"加强你的文化"},{"start":550.17,"end":553.02,"text":"因为这个这个这这封信我已经读完了"},{"start":553.02,"end":555.52,"text":"我建议你看中国古代历史"},{"start":555.6,"end":557.13,"text":"看历史书"},{"start":557.13,"end":559.38,"text":"比如说你甚至可以把三国演义"},{"start":559.38,"end":561.03,"text":"水浒传看完"},{"start":561.03,"end":562.47,"text":"红楼梦看完"},{"start":562.47,"end":568.219,"text":"然后请你去看一些中国古代历史史记"},{"start":568.92,"end":571.67,"text":"资治通鉴或者一些断代史"},{"start":571.67,"end":575.24,"text":"你不不想看文言文"},{"start":575.24,"end":581.42,"text":"你可以去看百度百科里面的魏晋南北朝人物的那些"},{"start":584.42,"end":585.68,"text":"有什么重大历史性"},{"start":585.68,"end":587.84,"text":"我我我的建议就是你去看历史"},{"start":587.84,"end":589.28,"text":"中国古代历史书"},{"start":589.28,"end":592.04,"text":"那里面有现实的赤裸裸的残酷的斗争"},{"start":593.38,"end":594.72,"text":"你的那些垃圾小说"},{"start":594.72,"end":596.52,"text":"我我的建议就是全部烧光"},{"start":596.52,"end":597.81,"text":"全部扔完"},{"start":597.81,"end":600.27,"text":"和那些游戏小说"},{"start":600.27,"end":604.789,"text":"游戏可以玩那些游戏背后的那种文化衍生品"},{"start":604.789,"end":605.869,"text":"那么全是垃圾"},{"start":605.869,"end":607.09,"text":"全是忽悠人的"},{"start":617.38,"end":618.94,"text":"关于校尉兼职的事情"},{"start":618.94,"end":620.86,"text":"我目前还没有把这个想法告诉我的母亲"},{"start":620.86,"end":621.94,"text":"对于这件事我还比较纠结"},{"start":621.94,"end":623.02,"text":"我的母亲是比较强势的人"},{"start":623.02,"end":626.65,"text":"总是要求我按照他的安排形式出门在外时"},{"start":626.65,"end":628.15,"text":"又常常在他人面前打压我"},{"start":628.15,"end":630.79,"text":"比如江国与我的某某同学比较合适"},{"start":630.79,"end":633.56,"text":"跟其他人想我以前做的一些蠢事来嘲笑我"},{"start":633.56,"end":635.24,"text":"我担心他不能理解我的想法"},{"start":636.839,"end":640.38,"text":"害怕他以后等某天要把我这个幼稚的想法公布出来"},{"start":640.38,"end":641.28,"text":"换取他人"},{"start":641.28,"end":642.72,"text":"你这个想法就是幼稚的"},{"start":642.72,"end":643.86,"text":"不仅你的母亲是幼稚"},{"start":643.86,"end":646.02,"text":"而且我明确告诉一个高二学生"},{"start":646.02,"end":647.78,"text":"你出去打个气功啊"},{"start":647.78,"end":648.86,"text":"你被人家吸血"},{"start":655.96,"end":657.359,"text":"一天干下来"},{"start":657.359,"end":659.099,"text":"同样的劳动量可能拿200块钱"},{"start":659.099,"end":660.359,"text":"你这个高中生去打工"},{"start":660.359,"end":662.279,"text":"被你就给你50块钱"},{"start":662.279,"end":663.779,"text":"你被吸血吸大血"},{"start":663.779,"end":664.319,"text":"你神经病"},{"start":664.319,"end":665.199,"text":"我靠"},{"start":666.92,"end":668.72,"text":"我和父亲谈到过这件事"},{"start":668.72,"end":670.4,"text":"他鼓励我出去吃点苦"},{"start":670.4,"end":671.3,"text":"但要注意安全"},{"start":671.3,"end":673.28,"text":"你这个八不靠谱啊"},{"start":673.28,"end":674.599,"text":"我很明确的"},{"start":674.84,"end":676.94,"text":"你很明显不靠谱的是高二学生"},{"start":676.94,"end":678.44,"text":"一点社会经验都没有的"},{"start":678.44,"end":680.9,"text":"一点不是一点社会经验的问题"},{"start":680.9,"end":683.329,"text":"你一点社会自保能力都没有"},{"start":683.329,"end":684.829,"text":"你这妈是单亲妈"},{"start":684.829,"end":685.94,"text":"她要上班"},{"start":685.94,"end":688.22,"text":"出去万一出个好歹"},{"start":688.22,"end":689.45,"text":"你说你妈怎么办"},{"start":689.45,"end":691.7,"text":"你一点社会自保能力都没有"},{"start":691.7,"end":692.66,"text":"你就算要出去打工"},{"start":692.66,"end":695.13,"text":"请你最起码有五个同学都去"},{"start":695.13,"end":696.18,"text":"你再去"},{"start":697.26,"end":701.58,"text":"高二学生打个屁功能好好在家里看书啊啊"},{"start":701.58,"end":706.28,"text":"也也跟几位有校外兼职经历的同学聊过"},{"start":706.28,"end":708.53,"text":"他们说可以在劳务所找到工作"},{"start":708.53,"end":709.94,"text":"劳务所是什么东西"},{"start":709.94,"end":711.72,"text":"啥是劳务所"},{"start":711.72,"end":714.06,"text":"你知道校外兼职经历是真的假的"},{"start":714.06,"end":717.69,"text":"我有一位女性同学还暑假给人折千纸鹤"},{"start":717.69,"end":720.21,"text":"早九到晚把午休一小时"},{"start":720.21,"end":722.199,"text":"一天能拿150块钱"},{"start":722.28,"end":724.8,"text":"你不要去赚这个小钱啊"},{"start":724.8,"end":726.24,"text":"我打算去尝试着干几天"},{"start":727.5,"end":728.82,"text":"因为我不是什么心灵手巧"},{"start":728.82,"end":729.06,"text":"人"},{"start":729.06,"end":731.5,"text":"折欠之后只能说会折"},{"start":731.5,"end":733.38,"text":"但不算有多好看"},{"start":733.66,"end":735.34,"text":"折千纸鹤这种活"},{"start":735.34,"end":738.199,"text":"我真的不建议高中生去干这活"},{"start":741.18,"end":744.12,"text":"就是说你在接受教育"},{"start":748.34,"end":750.02,"text":"应当去休息"},{"start":750.02,"end":750.89,"text":"高中教育"},{"start":753.8,"end":755.54,"text":"是很伤体力的"},{"start":755.54,"end":757.86,"text":"应该充分的休息啊"},{"start":757.86,"end":759.54,"text":"充分的休息"},{"start":763.5,"end":765.839,"text":"首要任务是巩固你的知识"},{"start":767.2,"end":769.15,"text":"我不建议高中生这么高"},{"start":769.15,"end":772.0,"text":"你你你说如果说你是一个中专毕业的"},{"start":772.0,"end":773.57,"text":"那这这中专生"},{"start":773.57,"end":774.23,"text":"那你出去打工"},{"start":774.23,"end":777.41,"text":"我觉得就是这个社会分工已经在某种意象定型了"},{"start":777.41,"end":778.61,"text":"你是高中生活"},{"start":778.61,"end":780.35,"text":"就是一些初阶的社会分工"},{"start":780.35,"end":782.05,"text":"你还是要去服从他"},{"start":782.05,"end":785.68,"text":"我的建议就是请你在家里好好看书啊"},{"start":787.08,"end":788.79,"text":"这个千纸鹤啊"},{"start":788.79,"end":791.22,"text":"我不是说看不起这种重复的题"},{"start":791.22,"end":792.66,"text":"劳动者"},{"start":792.66,"end":795.359,"text":"我是看不起重复的题劳动"},{"start":795.7,"end":797.26,"text":"你听懂我的意思吗"},{"start":797.26,"end":800.77,"text":"原来是人类这样的高级动物"},{"start":800.77,"end":803.02,"text":"不应当把那么长的时间"},{"start":803.02,"end":805.02,"text":"一天干九个小时"},{"start":805.26,"end":807.52,"text":"早酒的晚吧"},{"start":807.76,"end":809.44,"text":"一天午休一小时"},{"start":809.44,"end":810.82,"text":"一天干11个小时"},{"start":810.82,"end":812.27,"text":"拿150块钱"},{"start":812.27,"end":814.28,"text":"这种重复性的劳动"},{"start":816.29,"end":818.74,"text":"应当是一天最多一两个小时"},{"start":819.24,"end":821.3,"text":"一天最多一两个小时"},{"start":821.94,"end":826.8,"text":"这种劳动它就是对于人类的成长和提高是无意义的"},{"start":826.9,"end":828.82,"text":"除非它本身具有艺术性啊"},{"start":828.82,"end":831.04,"text":"我我这样重复这种就像练钢琴一样"},{"start":831.04,"end":831.91,"text":"后面才钢琴"},{"start":831.91,"end":833.77,"text":"它能够让你有个技术性的提高"},{"start":833.77,"end":837.58,"text":"能够让你越来你折千纸鹤折半个月"},{"start":837.58,"end":840.58,"text":"然后后面就变成折纸大师了"},{"start":840.58,"end":842.37,"text":"你做的事情有艺术性"},{"start":842.37,"end":846.21,"text":"你如果是就是这种劳动本身是有点泯灭人性的"},{"start":846.21,"end":846.87,"text":"你知道吗"},{"start":846.87,"end":848.19,"text":"让你无法重复"},{"start":848.19,"end":850.38,"text":"那边把你驯化成机器"},{"start":851.36,"end":852.14,"text":"懂了吗"},{"start":852.14,"end":854.3,"text":"我没有看不起这里面的劳动者"},{"start":854.3,"end":856.01,"text":"我是看不起这种劳动"},{"start":856.01,"end":859.73,"text":"而且这种长时间低薪资的这个劳动过程"},{"start":859.73,"end":862.28,"text":"这个现实这种不合理的分配"},{"start":862.28,"end":865.53,"text":"不合理的工作的待遇"},{"start":865.53,"end":866.97,"text":"不合理的工作状态"},{"start":866.97,"end":870.42,"text":"不痛苦的这个这个无聊的这个忍受过程"},{"start":870.42,"end":873.0,"text":"这个东西就就应当看不起我"},{"start":873.0,"end":873.96,"text":"如果看得起这个东西"},{"start":876.87,"end":877.86,"text":"我看得起这个东西"},{"start":877.86,"end":878.58,"text":"我匍匐于他"},{"start":878.58,"end":879.36,"text":"我跪拜于他"},{"start":881.39,"end":884.03,"text":"这时候我就看不起这种劳动内容"},{"start":884.03,"end":885.26,"text":"这种劳动形式"},{"start":885.26,"end":888.95,"text":"但是我希望这些劳动者可以从当中解放出来"},{"start":888.95,"end":891.56,"text":"可以当从当中超超越出来"},{"start":891.56,"end":893.92,"text":"可以实现它内在的伟大力量"},{"start":899.32,"end":900.4,"text":"明白吗"},{"start":900.4,"end":901.92,"text":"不是说卧槽"},{"start":901.92,"end":904.74,"text":"我怎么觉得就是你们小孩儿你不吃"},{"start":904.74,"end":907.91,"text":"就为了150块钱就给一天干15个小时"},{"start":907.91,"end":908.93,"text":"10 11个小时"},{"start":908.93,"end":909.83,"text":"一天干11个小时"},{"start":909.83,"end":912.5,"text":"除一下平均薪资一个小时多少钱"},{"start":913.04,"end":914.63,"text":"14块钱哎"},{"start":914.63,"end":916.01,"text":"13块几"},{"start":916.01,"end":917.64,"text":"13块几毛钱"},{"start":920.2,"end":921.88,"text":"这个东西太太糟糕了"},{"start":921.88,"end":924.16,"text":"you know it's ridiculous"},{"start":924.16,"end":925.839,"text":"太糟糕了"},{"start":926.88,"end":928.32,"text":"他太糟糕了"},{"start":928.32,"end":930.06,"text":"我没有看不起里面的劳动者"},{"start":930.06,"end":931.53,"text":"我不是看不起里面的人"},{"start":931.53,"end":938.28,"text":"好像是看不起让这种重复无聊痛苦贫乏的劳动过程"},{"start":938.36,"end":944.819,"text":"不停的去压迫压榨人的剩余价值的那些社会制度"},{"start":944.82,"end":946.02,"text":"我看不起这些东西"},{"start":946.02,"end":947.76,"text":"那些那些那些力量的"},{"start":951.02,"end":952.479,"text":"我看不起这些东西"},{"start":959.22,"end":960.36,"text":"中考没有考好成绩"},{"start":960.36,"end":961.74,"text":"只是进了一所普通高中"},{"start":961.74,"end":962.4,"text":"在学校里呆"},{"start":964.99,"end":965.77,"text":"严格了学"},{"start":965.77,"end":967.09,"text":"同学们的学记性不是很高"},{"start":967.09,"end":970.32,"text":"很多人都摆烂上个说话睡觉或者互相讲话"},{"start":970.32,"end":973.71,"text":"每节课都都有同学会做一些老师直接不管"},{"start":973.71,"end":978.369,"text":"哎哟啊那个我也承认我的母亲对我也是评评价是对的"},{"start":978.369,"end":979.989,"text":"不用鞭子抽就不会自己跑"},{"start":979.989,"end":981.909,"text":"初中时英语老师管的很严"},{"start":981.909,"end":983.879,"text":"我就算其他科目拉跨"},{"start":983.879,"end":988.05,"text":"但靠英语和物理起码也进了高中"},{"start":988.05,"end":989.55,"text":"现在我的英语水平一落千丈"},{"start":989.55,"end":990.63,"text":"而我感兴趣的物理"},{"start":990.63,"end":992.55,"text":"虽然成绩依然算优秀"},{"start":992.55,"end":994.2,"text":"但物理老师说我数学太差"},{"start":994.2,"end":995.25,"text":"以后肯定学不好"},{"start":995.25,"end":996.75,"text":"再加上理化两门学科"},{"start":996.75,"end":999.28,"text":"有很多重点高中的学生都会选"},{"start":999.28,"end":1002.04,"text":"所以他为了为了上考上大学啊"},{"start":1002.04,"end":1004.92,"text":"他所以他是在一个普通的一个高中念了"},{"start":1004.92,"end":1009.419,"text":"所以他就矮子里拔高个以后跟重点大学的人比肯定不行"},{"start":1009.419,"end":1010.679,"text":"我确实不是很能吃苦的人"},{"start":1010.679,"end":1012.46,"text":"因为我对历史还挺感兴趣"},{"start":1012.46,"end":1013.72,"text":"就在选课时报的历史"},{"start":1013.72,"end":1016.96,"text":"但现在学校里觉得历史课的一大半内容都是中国古代史"},{"start":1016.96,"end":1018.72,"text":"而我喜欢的是世界史"},{"start":1018.72,"end":1022.29,"text":"现实的历史课的选修内容与我想象的不太一样"},{"start":1022.29,"end":1024.569,"text":"那那你所以说我刚刚说的"},{"start":1024.569,"end":1026.13,"text":"让他去读中国古代历史"},{"start":1026.13,"end":1028.04,"text":"不要看不起中国古代历史"},{"start":1028.04,"end":1032.089,"text":"不要凭你的狗很烂的那些喜好"},{"start":1037.069,"end":1041.18,"text":"你那种低幼的愚蠢的好恶"},{"start":1049.259,"end":1050.36,"text":"我明确的告诉你"},{"start":1050.36,"end":1051.32,"text":"在这个土地上"},{"start":1051.32,"end":1053.36,"text":"你必须理解中国古代历史"},{"start":1053.36,"end":1056.85,"text":"否则你不能理解我们这个土地上发生的种种现实"},{"start":1056.85,"end":1058.86,"text":"你不理解中国古代历史"},{"start":1058.86,"end":1061.889,"text":"不理解你自己身上深重的民族性"},{"start":1061.889,"end":1063.599,"text":"深重的历史的积淀"},{"start":1063.599,"end":1064.679,"text":"历史的影响"},{"start":1064.679,"end":1071.19,"text":"你也不能够摆脱这样的偏见和狭隘去理解世界历史"},{"start":1071.19,"end":1074.52,"text":"你就不能够构造一个整体的世界历史的一个理解"},{"start":1074.52,"end":1076.83,"text":"你对于世界历史的理解就是童话"},{"start":1076.83,"end":1078.27,"text":"就他妈游戏小说"},{"start":1078.27,"end":1082.24,"text":"就那种幼稚低幼的愚蠢的那种理解"},{"start":1082.74,"end":1087.0,"text":"从你最接近的现实当中去理解最接近的现实的历史"},{"start":1087.0,"end":1091.879,"text":"再从这个最接近现实的历史去理解一整个现实的历史"},{"start":1094.16,"end":1096.14,"text":"现实的历史和选修内容想象不一样"},{"start":1096.14,"end":1097.13,"text":"我有时也想过"},{"start":1098.9,"end":1100.159,"text":"不太适合我"},{"start":1100.159,"end":1103.339,"text":"那我在校期间应该多学一些自己感兴趣的知识"},{"start":1103.339,"end":1107.75,"text":"也没有资格语感的兴趣是什么"},{"start":1107.75,"end":1109.28,"text":"什么烂兴趣啊"},{"start":1109.28,"end":1114.44,"text":"他妈看游戏小说这种肮脏的下等而下之的兴趣"},{"start":1114.44,"end":1117.29,"text":"而不是把学科内容当作应试工具来看"},{"start":1117.29,"end":1119.399,"text":"不知道这样可行不可行"},{"start":1119.8,"end":1121.28,"text":"我明确告诉你"},{"start":1121.28,"end":1122.66,"text":"你感兴趣的西"},{"start":1122.66,"end":1123.86,"text":"这我没有参与过工作"},{"start":1123.86,"end":1125.9,"text":"不知道这算不算一种学学生的幻想"},{"start":1125.9,"end":1127.16,"text":"是幻想"},{"start":1127.16,"end":1127.82,"text":"愚蠢的幻想"},{"start":1127.82,"end":1129.14,"text":"如果沉溺于这种幻想"},{"start":1129.14,"end":1130.84,"text":"你一事无成"},{"start":1131.6,"end":1133.04,"text":"记得我之前啊"},{"start":1133.04,"end":1134.06,"text":"我记得刘先生"},{"start":1134.06,"end":1135.22,"text":"你之前出过一期视频"},{"start":1135.22,"end":1137.14,"