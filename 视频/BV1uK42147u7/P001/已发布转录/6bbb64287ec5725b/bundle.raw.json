{"segments":[{"start":0.12,"end":4.31,"text":"呃就讲一下也算一个热点议题吧"},{"start":4.31,"end":8.0,"text":"那我们对于这个热点的话可能太热了"},{"start":8.0,"end":9.59,"text":"我的观点就是无政府主义"},{"start":9.59,"end":12.02,"text":"没有办法给出政治出路啊"},{"start":12.02,"end":16.52,"text":"他最后变成了一个借助媒体"},{"start":16.52,"end":22.249,"text":"舆论倒逼的这么一个东西啊"},{"start":22.249,"end":28.02,"text":"我这个人我只能说有点浪费好吧"},{"start":28.36,"end":34.08,"text":"因为他毕竟是这个美军空军的一个情报人员啊"},{"start":34.08,"end":36.42,"text":"一个安全工程师"},{"start":36.76,"end":40.76,"text":"事实上我觉得他能做的事情是啊"},{"start":40.76,"end":42.2,"text":"远远多于这种事情"},{"start":43.34,"end":50.78,"text":"我觉得如果他能够呃通过某种能进门的方式把"},{"start":51.68,"end":53.56,"text":"啊因为我是国际主义者嘛"},{"start":54.64,"end":57.34,"text":"当然我不是那种无政府主义"},{"start":57.34,"end":61.98,"text":"或者说是托洛茨基主义的那种纯粹浪漫的"},{"start":61.98,"end":65.48,"text":"不需要任何就是游牧化的啊"},{"start":65.48,"end":68.57,"text":"不需要任何成建制的力量啊"},{"start":68.57,"end":71.84,"text":"就想妄想去妄图去借助"},{"start":71.84,"end":74.07,"text":"资本主义的一些新形态啊"},{"start":74.07,"end":75.27,"text":"舆论资本主义"},{"start":75.27,"end":77.01,"text":"媒介资本主义啊"},{"start":77.01,"end":79.74,"text":"或者说指数资本主义啊"},{"start":79.74,"end":84.46,"text":"通过什么节选虚头巴脑的东西要解决力量对比"},{"start":84.46,"end":87.78,"text":"这个我们是不相信的啊"},{"start":87.78,"end":89.07,"text":"我们作为国际主义者"},{"start":89.07,"end":93.41,"text":"始终是要以有一个需要一个"},{"start":93.41,"end":95.99,"text":"而且是能够和啊"},{"start":97.25,"end":102.209,"text":"这个跨国资本家的母巢的大型国家"},{"start":102.209,"end":104.309,"text":"能够对垒的国家"},{"start":104.309,"end":106.84,"text":"作为他的策源基地的"},{"start":107.12,"end":109.18,"text":"我们是务实的国际主义者"},{"start":110.26,"end":112.54,"text":"那么这个人的他当然做的事情"},{"start":112.54,"end":115.11,"text":"是秉承了一个国际主义精神"},{"start":115.33,"end":118.26,"text":"但是呢我们很明确的看到"},{"start":118.26,"end":122.14,"text":"就他所交往的这个无政府主义圈子呢"},{"start":122.14,"end":124.15,"text":"并没有给他政治解决"},{"start":124.15,"end":128.18,"text":"和这个呃有利行动的途径和方案"},{"start":128.18,"end":130.82,"text":"当然你们会认为这个行动就已经足够有的"},{"start":130.82,"end":132.29,"text":"在我看来不够有力啊"},{"start":132.29,"end":134.55,"text":"在我看来不够有力"},{"start":135.31,"end":142.31,"text":"比如说他应当就是说嗯嗯再泄露"},{"start":142.31,"end":144.6,"text":"就是说再做一次啊"},{"start":144.6,"end":147.27,"text":"大规模的这种他的丑闻性的"},{"start":147.27,"end":148.71,"text":"屠杀性的"},{"start":148.71,"end":152.7,"text":"真的让他受不了的这些情报的一个泄露"},{"start":153.64,"end":155.85,"text":"那可能就会祸及他家人"},{"start":155.85,"end":160.349,"text":"还有可能他的父母就会呃就会嗝屁或怎么样的"},{"start":160.349,"end":165.059,"text":"那么所以说我的建议就是说对于这样的能够"},{"start":165.059,"end":166.82,"text":"对于这个"},{"start":169.14,"end":171.62,"text":"帝国主义老巢进行反叛的"},{"start":171.62,"end":173.74,"text":"这样的议事"},{"start":173.74,"end":176.44,"text":"应当是对他进行一个啊"},{"start":176.44,"end":179.38,"text":"能够提供强而有力的保护措施"},{"start":179.38,"end":183.01,"text":"的一种策反和接应"},{"start":184.15,"end":187.75,"text":"我呼吁我呼吁我们也要想办法去"},{"start":188.09,"end":193.0,"text":"当然这些人呢容易被就是完全游牧化的"},{"start":193.0,"end":194.8,"text":"无力的啊"},{"start":194.8,"end":198.22,"text":"这种极端自由主义的变种的无政府主义啊"},{"start":198.22,"end":201.28,"text":"或者托洛斯基主义这些意识形态俘获"},{"start":201.28,"end":203.67,"text":"那么这样的社群是无力的"},{"start":203.67,"end":204.81,"text":"我再强调一遍"},{"start":204.81,"end":207.05,"text":"这样的社群是无力的"},{"start":207.05,"end":209.81,"text":"他没有办法组织一个国家办"},{"start":209.81,"end":211.91,"text":"没有办法去建构一支军队"},{"start":211.91,"end":214.34,"text":"没有办法去真正的去危机的"},{"start":214.34,"end":217.92,"text":"真正的去这个啊"},{"start":217.92,"end":221.8,"text":"阻止帝国主义势力做出这些"},{"start":221.8,"end":223.54,"text":"咳咳不义之举"},{"start":225.1,"end":227.02,"text":"光凭媒体舆论"},{"start":227.02,"end":232.52,"text":"光凭这种视讯性的丑闻而力量并不足够啊"},{"start":232.52,"end":235.31,"text":"实际上没有足够的力量"},{"start":236.33,"end":239.78,"text":"当然我们并不是说他做的呃不多"},{"start":239.78,"end":241.19,"text":"这怪不了他啊"},{"start":241.19,"end":243.53,"text":"要怪的话是他所处的时代"},{"start":243.53,"end":245.27,"text":"并没有给他提供相应的社群"},{"start":245.27,"end":246.29,"text":"相应的渠道"},{"start":246.29,"end":247.69,"text":"所以我呼吁"},{"start":247.69,"end":255.829,"text":"那我建议可以为这样的这个敌国的啊"},{"start":255.829,"end":257.869,"text":"这种军事部门"},{"start":257.869,"end":258.769,"text":"军事要害部门"},{"start":258.769,"end":260.209,"text":"情报部门啊"},{"start":260.209,"end":262.249,"text":"一线的野战单位的啊"},{"start":262.249,"end":266.65,"text":"这情报部门他们接触到这个帝国主义的残忍的"},{"start":266.65,"end":268.909,"text":"丑陋的真相啊"},{"start":268.909,"end":271.189,"text":"为了维持帝国主义统治的"},{"start":271.189,"end":274.489,"text":"为了维持这个全球资产阶级统治秩序的"},{"start":274.489,"end":277.09,"text":"这样丑陋真相的这些成员"},{"start":277.43,"end":279.49,"text":"他们在思想上"},{"start":279.49,"end":279.91,"text":"精神上"},{"start":279.91,"end":282.97,"text":"观念上都是可以争取的啊"},{"start":282.97,"end":285.61,"text":"是可以动摇的"},{"start":285.61,"end":290.32,"text":"是可以让他反正到我们的啊"},{"start":290.32,"end":293.6,"text":"人类解放事业的阵营当中来的"},{"start":294.12,"end":300.5,"text":"那么需要给他们家人啊寻找相应的庇护和帮助"},{"start":300.81,"end":303.65,"text":"他没有办法做第二个"},{"start":303.65,"end":306.17,"text":"这个做成第二个人进门的话"},{"start":306.17,"end":306.89,"text":"原因可能就是"},{"start":306.89,"end":310.98,"text":"因为他的家人还没有办法得到一个保护"},{"start":313.26,"end":316.57,"text":"啊然后还有一点就是说他所在的社群"},{"start":316.57,"end":318.13,"text":"无政府主义者的社群"},{"start":318.13,"end":319.66,"text":"这种极端自由主义的社群"},{"start":319.66,"end":325.95,"text":"归根结底还是资产阶级资本主义的那种啊"},{"start":325.95,"end":332.699,"text":"或者说还是以市场为主体的一种资讯"},{"start":332.699,"end":333.959,"text":"同号团体啊"},{"start":333.959,"end":338.65,"text":"或者说某种比如说娱乐娱乐cosplay同好团体"},{"start":338.93,"end":343.33,"text":"没有一个强而有力的社群去支撑他啊"},{"start":343.33,"end":347.664,"text":"那我们的建议是在这个"},{"start":348.88,"end":353.2,"text":"交互网络里面能够为他提供强而有力的支点"},{"start":353.2,"end":355.54,"text":"强而有力的意识形态支点啊"},{"start":355.54,"end":359.78,"text":"强而有力的这个线下的"},{"start":360.42,"end":361.52,"text":"支撑点"},{"start":361.52,"end":367.48,"text":"这样的支撑点才能够为他提供真正的行动啊"},{"start":367.48,"end":373.159,"text":"才能够为他提供真正的真的能够更深入的"},{"start":373.159,"end":374.239,"text":"更直接的"},{"start":374.239,"end":381.49,"text":"更赤裸裸的击中帝国主义丑陋面目啊"},{"start":381.49,"end":384.16,"text":"四川他的这个某些脏器"},{"start":384.16,"end":387.14,"text":"甚至心脏的这样的机会"},{"start":390.21,"end":394.16,"text":"也希望就是说要进一步努力了"},{"start":394.16,"end":397.76,"text":"进一步努力做好这一形态输出的工作"},{"start":397.76,"end":399.385,"text":"做好这么一个"},{"start":402.13,"end":403.65,"text":"其实他是敌特了"},{"start":403.65,"end":408.79,"text":"你知道他是一个特种的安全工作人员啊"},{"start":408.79,"end":411.1,"text":"他所在的社群网络包围他"},{"start":411.1,"end":412.54,"text":"政治正确包围他"},{"start":412.54,"end":414.31,"text":"他就会无路可走"},{"start":414.31,"end":415.539,"text":"只能这样走"},{"start":415.539,"end":418.12,"text":"这个是在我们看来是非常可惜的"},{"start":418.12,"end":421.06,"text":"我个人不愿意把它形容成"},{"start":421.06,"end":424.17,"text":"这是一个壮举或者英雄之举啊"},{"start":424.51,"end":425.85,"text":"啊我个人认为"},{"start":425.85,"end":429.21,"text":"这个实际上还是他的一些理念和主义"},{"start":429.21,"end":432.69,"text":"并没有贯彻到底啊"},{"start":432.69,"end":434.79,"text":"要不要贯彻到底"},{"start":438.82,"end":442.74,"text":"因为他的行动还是有被污名化的可能性啊"},{"start":442.74,"end":445.11,"text":"这么一个激烈的极端的行动"},{"start":445.11,"end":447.18,"text":"是有被污名化的可能性"},{"start":447.18,"end":450.12,"text":"而且是一种绝望的表达啊"},{"start":450.12,"end":451.8,"text":"是一个找不到行动路线"},{"start":451.8,"end":453.48,"text":"路线的一个受限的一个表达"},{"start":454.56,"end":455.76,"text":"是一个可惜的"},{"start":455.76,"end":460.93,"text":"令人惋惜的一种一种对他的敌人的报复方式"},{"start":461.95,"end":466.6,"text":"那么我们认为这样的抗争是不足够的"},{"start":466.6,"end":470.81,"text":"或者说这样的抗争是应当得到进一步的发展"},{"start":470.81,"end":472.67,"text":"它应当具有更成熟的形态"},{"start":472.67,"end":474.35,"text":"它应当具有就是更理性"},{"start":474.35,"end":475.58,"text":"更神圣的策略"},{"start":475.58,"end":479.03,"text":"它应该具有一个更有力的支点啊"},{"start":479.03,"end":481.5,"text":"更强大的一个支撑"},{"start":481.96,"end":484.68,"text":"那么我们要去努力提供这样的支点"},{"start":484.68,"end":486.05,"text":"提供这样的支撑"},{"start":486.05,"end":487.55,"text":"意识形态的输出"},{"start":487.55,"end":488.69,"text":"甚至革命的输出"},{"start":488.69,"end":492.959,"text":"应当提到国际主义者的行程当中啊"},{"start":492.959,"end":494.429,"text":"计划当中去了"},{"start":494.429,"end":497.609,"text":"我们作为务实的国际主义者"},{"start":497.609,"end":502.26,"text":"应当去为这些"},{"start":502.72,"end":507.12,"text":"就我们在敌营当中的漂泊无依的国际主义战士"},{"start":507.12,"end":509.64,"text":"应该是提供支点提供帮助"},{"start":510.9,"end":514.2,"text":"不仅仅是隔岸观火"},{"start":515.82,"end":519.948,"text":"我们不能仅仅隔岸观火啊"},{"start":519.948,"end":524.269,"text":"我们对它其中就是真正有理想有信念的成员"},{"start":524.269,"end":525.439,"text":"应当策反"},{"start":525.439,"end":530.21,"text":"应当提供家人的安全保障啊"},{"start":530.21,"end":532.73,"text":"应当给予啊"},{"start":532.73,"end":539.49,"text":"这个一整个社群共同体的信赖和关爱和认同"},{"start":540.07,"end":545.58,"text":"应当让他们的理想主义变成温和而有力的现实"},{"start":545.58,"end":550.68,"text":"在世界的悲剧发生的地方"},{"start":550.68,"end":553.83,"text":"转变成一种拯救性的解放性的力量"},{"start":553.83,"end":557.35,"text":"而不是说他们本身成为一种悲剧"},{"start":557.35,"end":561.25,"text":"这样的悲剧甚至到目前是已经是无可挽回了"},{"start":561.25,"end":563.18,"text":"无可拯救了"},{"start":563.52,"end":567.62,"text":"我们希望他们成为一个拯救者"},{"start":567.62,"end":570.73,"text":"The fire of palestine"},{"start":570.73,"end":571.75,"text":"拯救者"},{"start":571.75,"end":573.61,"text":"Liberator of palestine"},{"start":573.61,"end":580.489,"text":"而不是去呼吁那呼吁那个帝国主义刽子守门呃"},{"start":580.489,"end":581.749,"text":"拯救巴勒斯坦"},{"start":581.749,"end":584.329,"text":"他不应当是用他的死亡去呼吁别人"},{"start":584.329,"end":584.929,"text":"拯救巴勒斯坦"},{"start":584.929,"end":588.91,"text":"他应当自己去行动"},{"start":588.91,"end":590.41,"text":"自己成为行动者"},{"start":590.41,"end":592.74,"text":"自己成为解放者"},{"start":593.14,"end":596.22,"text":"所以他临终的那句口号"},{"start":596.22,"end":598.77,"text":"我觉得是令人甚为惋惜的"},{"start":598.77,"end":602.27,"text":"所以我不愿意称其为一位英雄啊"},{"start":602.27,"end":604.67,"text":"我不愿成为称其为一位英雄"},{"start":604.67,"end":605.96,"text":"因为我们我们说"},{"start":605.96,"end":613.97,"text":"我为他的这个这个所离世的不幸感到惋惜"},{"start":613.97,"end":615.14,"text":"在我们看来"},{"start":615.14,"end":618.73,"text":"我们对他的评价只能说就说他是勇敢的"},{"start":619.229,"end":620.809,"text":"也是以这种方式"},{"start":620.809,"end":623.329,"text":"其实是赎清了他不他的全部罪责"},{"start":623.329,"end":625.069,"text":"但我我愿意宣宣布"},{"start":625.069,"end":628.18,"text":"就是说在我作为一个务实的国际主义者来看"},{"start":628.18,"end":632.26,"text":"他这种方式确实已经熟悉了他的全部罪责"},{"start":632.26,"end":636.609,"text":"因为他给敌对势力这个反动势力的啊"},{"start":636.609,"end":640.349,"text":"这个一线军队啊"},{"start":640.349,"end":643.019,"text":"还有他的情报部门做这样一种啊"},{"start":643.019,"end":646.42,"text":"屠杀这个第三世界民众啊"},{"start":646.42,"end":646.96,"text":"啊"},{"start":646.96,"end":650.05,"text":"为帝国主义统治了这个严密的"},{"start":650.05,"end":651.43,"text":"这么一种反动行径"},{"start":651.43,"end":652.93,"text":"他确实也是参与者"},{"start":652.93,"end":654.07,"text":"他也是做的"},{"start":654.07,"end":657.43,"text":"但他的这些行动已经是完全对"},{"start":657.43,"end":658.75,"text":"我觉得也是输对了"},{"start":658.75,"end":661.66,"text":"但是说有没有更进一步"},{"start":662.42,"end":664.15,"text":"那么其实不取决于它"},{"start":664.15,"end":667.72,"text":"取决于还是取决于整个这个是它的受压迫的"},{"start":667.72,"end":668.56,"text":"他本国的"},{"start":668.56,"end":672.299,"text":"还说全球的一些互联网上的一些民众啊"},{"start":672.299,"end":675.41,"text":"它是也是有积极正面的影响的"},{"start":675.41,"end":681.22,"text":"但是呢他并没有并没有真正的把握现实"},{"start":681.22,"end":686.33,"text":"真正发挥它全部的能力和它所能设想的啊"},{"start":686.33,"end":690.14,"text":"真正的有利的长远的一些解决方案"},{"start":690.14,"end":693.739,"text":"并没有发现并没有创造出来啊"},{"start":696.139,"end":697.72,"text":"所以"},{"start":698.9,"end":699.82,"text":"所以是吧"},{"start":699.82,"end":701.14,"text":"大家赶紧去行动吧"},{"start":701.14,"end":702.49,"text":"我们来想办法吧"},{"start":702.49,"end":704.11,"text":"那我们来想办法"},{"start":704.11,"end":705.58,"text":"那么这样的行动的话"},{"start":705.58,"end":706.45,"text":"我们是务实的"},{"start":706.45,"end":708.67,"text":"我们绝不隔岸观火啊"},{"start":708.67,"end":709.57,"text":"我们是务实的"},{"start":709.57,"end":712.999,"text":"我们是我们是要尽一切努力"},{"start":712.999,"end":714.859,"text":"那好吧"},{"start":714.859,"end":715.8,"text":"那就讲到这里"}],"source":"subtitle"}
