    {
      "ordinal": 103,
      "start_ms": 295290,
      "end_ms": 296740,
      "text": "就相当于说"
    },
    {
      "ordinal": 104,
      "start_ms": 298840,
      "end_ms": 302840,
      "text": "我争取我打你可以得到你的同意"
    },
    {
      "ordinal": 105,
      "start_ms": 303639,
      "end_ms": 304979,
      "text": "我就打你就行了"
    },
    {
      "ordinal": 106,
      "start_ms": 304979,
      "end_ms": 305840,
      "text": "你明白吗"
    },
    {
      "ordinal": 107,
      "start_ms": 305840,
      "end_ms": 310520,
      "text": "我小三拳就是说我就是说相当于说我要我要"
    },
    {
      "ordinal": 108,
      "start_ms": 310520,
      "end_ms": 311660,
      "text": "我要我要我要反抗"
    },
    {
      "ordinal": 109,
      "start_ms": 311660,
      "end_ms": 312620,
      "text": "我要争取你同意"
    },
    {
      "ordinal": 110,
      "start_ms": 312620,
      "end_ms": 313480,
      "text": "我反抗"
    },
    {
      "ordinal": 111,
      "start_ms": 314300,
      "end_ms": 315280,
      "text": "你明白吧"
    },
    {
      "ordinal": 112,
      "start_ms": 315280,
      "end_ms": 316240,
      "text": "小三拳"
    },
    {
      "ordinal": 113,
      "start_ms": 316240,
      "end_ms": 317620,
      "text": "如果你争取小三拳"
    },
    {
      "ordinal": 114,
      "start_ms": 317620,
      "end_ms": 320230,
      "text": "就相当于说你反抗你反抗什么"
    },
    {
      "ordinal": 115,
      "start_ms": 320230,
      "end_ms": 322300,
      "text": "你反抗就是说你要别人同意"
    },
    {
      "ordinal": 116,
      "start_ms": 322300,
      "end_ms": 323200,
      "text": "你反抗"
    },
    {
      "ordinal": 117,
      "start_ms": 323420,
      "end_ms": 324680,
      "text": "你已经是反抗"
    },
    {
      "ordinal": 118,
      "start_ms": 324680,
      "end_ms": 326780,
      "text": "你为什么要别人同意你反抗呢"
    },
    {
      "ordinal": 119,
      "start_ms": 326780,
      "end_ms": 328060,
      "text": "明白吧"
    },
    {
      "ordinal": 120,
      "start_ms": 328840,
      "end_ms": 330610,
      "text": "所以说我们要争取"
    },
    {
      "ordinal": 121,
      "start_ms": 330610,
      "end_ms": 332620,
      "text": "我们要反对小三拳"
    },
    {
      "ordinal": 122,
      "start_ms": 332620,
      "end_ms": 335390,
      "text": "小三拳是三种拳的大哥"
    },
    {
      "ordinal": 123,
      "start_ms": 335390,
      "end_ms": 339710,
      "text": "你有没有把这个association和the right of association"
    },
    {
      "ordinal": 124,
      "start_ms": 339710,
      "end_ms": 342550,
      "text": "两个东西能够能够分开来理解"
    },
    {
      "ordinal": 125,
      "start_ms": 344770,
      "end_ms": 347210,
      "text": "就说我看到这里"
    },
    {
      "ordinal": 126,
      "start_ms": 347210,
      "end_ms": 351110,
      "text": "我就判定这个文章的作者的智力水平"
    },
    {
      "ordinal": 127,
      "start_ms": 351110,
      "end_ms": 352280,
      "text": "不是特别高"
