    },
    {
      "ordinal": 11,
      "start_ms": 34940,
      "end_ms": 36200,
      "text": "因此要反对小三权"
    },
    {
      "ordinal": 12,
      "start_ms": 36200,
      "end_ms": 38260,
      "text": "反对一切自发斗争"
    },
    {
      "ordinal": 13,
      "start_ms": 38260,
