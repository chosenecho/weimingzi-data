    {
      "ordinal": 89,
      "start_ms": 256819,
      "end_ms": 258879,
      "text": "定义到制度框架当中去"
    },
    {
      "ordinal": 90,
      "start_ms": 258879,
      "end_ms": 260860,
      "text": "注册到制度框架当中去"
    },
    {
