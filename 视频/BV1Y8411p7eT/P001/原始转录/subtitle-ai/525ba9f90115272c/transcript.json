    {
      "ordinal": 128,
      "start_ms": 352280,
      "end_ms": 355110,
      "text": "所以我这个文章我就不看下去了"
    },
    {
      "ordinal": 129,
      "start_ms": 355110,
      "end_ms": 360210,
      "text": "不代表说我我我真的看不起这些人"
    },
    {
      "ordinal": 130,
      "start_ms": 360210,
      "end_ms": 363469,
      "text": "或者说就是说我智力水平低"
