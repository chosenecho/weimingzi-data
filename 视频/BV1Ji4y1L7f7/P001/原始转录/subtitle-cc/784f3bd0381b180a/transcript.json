{
  "bvid": "BV1Ji4y1L7f7",
  "page": 1,
  "source": "subtitle-cc",
  "language": "zh-CN",
  "model": null,
  "content_sha256": "784f3bd0381b180a2210a7235d6c75d1385914759ae9908fa81ff48571d7d4c7",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 2160,
      "end_ms": 3360,
      "text": "我们来今天讲一个"
    },
    {
      "ordinal": 1,
      "start_ms": 3360,
      "end_ms": 4800,
      "text": "比较经典的辩题"
    },
    {
      "ordinal": 2,
      "start_ms": 4960,
      "end_ms": 6720,
      "text": "也是用辩证法来解读"
    },
    {
      "ordinal": 3,
      "start_ms": 6880,
      "end_ms": 8920,
      "text": "正题就是惠施"
    },
    {
      "ordinal": 4,
      "start_ms": 9360,
      "end_ms": 11000,
      "text": "听到庄子说“鱼好快乐”"
    },
    {
      "ordinal": 5,
      "start_ms": 11040,
      "end_ms": 12000,
      "text": "他就问"
    },
    {
      "ordinal": 6,
      "start_ms": 12280,
      "end_ms": 13720,
      "text": "“子非鱼，安知鱼”"
    },
    {
      "ordinal": 7,
      "start_ms": 13720,
      "end_ms": 14800,
      "text": "你不是鱼"
    },
    {
      "ordinal": 8,
      "start_ms": 14840,
      "end_ms": 16239,
      "text": "你怎么知道鱼的快乐？"
    },
    {
      "ordinal": 9,
      "start_ms": 17760,
      "end_ms": 19600,
      "text": "庄子条件反射自我保护式的"
    },
    {
      "ordinal": 10,
      "start_ms": 19600,
      "end_ms": 21160,
      "text": "就反题"
    },
    {
      "ordinal": 11,
      "start_ms": 21240,
      "end_ms": 23320,
      "text": "反驳了一下说“子非我，"
    },
    {
      "ordinal": 12,
      "start_ms": 23360,
      "end_ms": 25320,
      "text": "焉知我不知鱼之乐？”你不是我"
    },
    {
      "ordinal": 13,
      "start_ms": 25320,
      "end_ms": 26720,
      "text": "你怎么知道我不知道呢"
    },
    {
      "ordinal": 14,
      "start_ms": 27160,
      "end_ms": 28560,
      "text": "惠施就很聪明了"
    },
    {
      "ordinal": 15,
      "start_ms": 28560,
      "end_ms": 29880,
      "text": "通过庸俗的辩证法"
    },
    {
      "ordinal": 16,
      "start_ms": 29880,
      "end_ms": 30720,
      "text": "搞了个合题"
    },
    {
      "ordinal": 17,
      "start_ms": 30760,
      "end_ms": 32000,
      "text": "就是把两个东西拼到一块"
    },
    {
      "ordinal": 18,
      "start_ms": 33440,
      "end_ms": 35080,
      "text": "说什么：“我固非子"
    },
    {
      "ordinal": 19,
      "start_ms": 35280,
      "end_ms": 36320,
      "text": "我不是你"
    },
    {
      "ordinal": 20,
      "start_ms": 36320,
      "end_ms": 37000,
      "text": "我肯定不知道"
    },
    {
      "ordinal": 21,
      "start_ms": 37000,
      "end_ms": 37600,
      "text": "你怎么想的"
    },
    {
      "ordinal": 22,
      "start_ms": 37600,
      "end_ms": 38360,
      "text": "你也不是鱼"
    },
    {
      "ordinal": 23,
      "start_ms": 38360,
      "end_ms": 39720,
      "text": "所以你也不知道鱼怎么想的"
    },
    {
      "ordinal": 24,
      "start_ms": 39720,
      "end_ms": 41200,
      "text": "这两个东西加到一块"
    },
    {
      "ordinal": 25,
      "start_ms": 41200,
      "end_ms": 42320,
      "text": "“全矣！”"
    },
    {
      "ordinal": 26,
      "start_ms": 42360,
      "end_ms": 44560,
      "text": "整体主义的虚假的辩证法：“全矣！”"
    },
    {
      "ordinal": 27,
      "start_ms": 44600,
      "end_ms": 46680,
      "text": "这两个加在一块就整全了"
    },
    {
      "ordinal": 28,
      "start_ms": 47240,
      "end_ms": 47920,
      "text": "实际上"
    },
    {
      "ordinal": 29,
      "start_ms": 48680,
      "end_ms": 50360,
      "text": "这种庸俗的辩证法"
    },
    {
      "ordinal": 30,
      "start_ms": 50720,
      "end_ms": 53640,
      "text": "它就是把两个答案拼到一块去"
    },
    {
      "ordinal": 31,
      "start_ms": 53680,
      "end_ms": 55120,
      "text": "说这两种情况都包含"
    },
    {
      "ordinal": 32,
      "start_ms": 55120,
      "end_ms": 55720,
      "text": "所以就行了"
    },
    {
      "ordinal": 33,
      "start_ms": 55720,
      "end_ms": 58200,
      "text": "那么就会导致一种主观主义"
    },
    {
      "ordinal": 34,
      "start_ms": 58480,
      "end_ms": 59320,
      "text": "背后就是说"
    },
    {
      "ordinal": 35,
      "start_ms": 60000,
      "end_ms": 63840,
      "text": "我不是你，你也不是鱼"
    },
    {
      "ordinal": 36,
      "start_ms": 63840,
      "end_ms": 65200,
      "text": "所以你都不能知道"
    },
    {
      "ordinal": 37,
      "start_ms": 65239,
      "end_ms": 66080,
      "text": "另外一个对象"
    },
    {
      "ordinal": 38,
      "start_ms": 66080,
      "end_ms": 68160,
      "text": "它内在的感觉"
    },
    {
      "ordinal": 39,
      "start_ms": 68160,
      "end_ms": 69320,
      "text": "就是所谓的快乐"
    },
    {
      "ordinal": 40,
      "start_ms": 69600,
      "end_ms": 71200,
      "text": "这就导致一种"
    },
    {
      "ordinal": 41,
      "start_ms": 71240,
      "end_ms": 72640,
      "text": "快乐就变成一个"
    },
    {
      "ordinal": 42,
      "start_ms": 72640,
      "end_ms": 73440,
      "text": "你必须"
    },
    {
      "ordinal": 43,
      "start_ms": 74840,
      "end_ms": 76440,
      "text": "你只能通过你的第一人称"
    },
    {
      "ordinal": 44,
      "start_ms": 76480,
      "end_ms": 78560,
      "text": "通过内心才能够"
    },
    {
      "ordinal": 45,
      "start_ms": 78840,
      "end_ms": 80520,
      "text": "知觉、察觉到的一个东西"
    },
    {
      "ordinal": 46,
      "start_ms": 80840,
      "end_ms": 83240,
      "text": "那么庄子是怎么来解决这个问题的？"
    },
    {
      "ordinal": 47,
      "start_ms": 83360,
      "end_ms": 84560,
      "text": "他把重音"
    },
    {
      "ordinal": 48,
      "start_ms": 85040,
      "end_ms": 86120,
      "text": "真正的辩证法"
    },
    {
      "ordinal": 49,
      "start_ms": 86120,
      "end_ms": 88080,
      "text": "它是把重音转移"
    },
    {
      "ordinal": 50,
      "start_ms": 88440,
      "end_ms": 90120,
      "text": "转移到【安】字上面"
    },
    {
      "ordinal": 51,
      "start_ms": 90120,
      "end_ms": 91200,
      "text": "【哪里】知道"
    },
    {
      "ordinal": 52,
      "start_ms": 92040,
      "end_ms": 94040,
      "text": "子非鱼【安】之鱼之乐"
    },
    {
      "ordinal": 53,
      "start_ms": 94040,
      "end_ms": 96040,
      "text": "你问的是【安】知鱼之乐"
    },
    {
      "ordinal": 54,
      "start_ms": 96040,
      "end_ms": 98160,
      "text": "你是从【哪里】知道鱼的快乐"
    },
    {
      "ordinal": 55,
      "start_ms": 98400,
      "end_ms": 99400,
      "text": "你的意思就是说"
    },
    {
      "ordinal": 56,
      "start_ms": 99400,
      "end_ms": 100480,
      "text": "你已经承认"
    },
    {
      "ordinal": 57,
      "start_ms": 100480,
      "end_ms": 101560,
      "text": "我知道鱼的快乐"
    },
    {
      "ordinal": 58,
      "start_ms": 101560,
      "end_ms": 102880,
      "text": "但是你只不过是不知道"
    },
    {
      "ordinal": 59,
      "start_ms": 102880,
      "end_ms": 104480,
      "text": "它是从哪里被知道的"
    },
    {
      "ordinal": 60,
      "start_ms": 105600,
      "end_ms": 107000,
      "text": "这个其实就动摇了"
    },
    {
      "ordinal": 61,
      "start_ms": 107000,
      "end_ms": 107840,
      "text": "惠施一开始"
    },
    {
      "ordinal": 62,
      "start_ms": 107840,
      "end_ms": 108680,
      "text": "立论的基础"
    },
    {
      "ordinal": 63,
      "start_ms": 108680,
      "end_ms": 110360,
      "text": "惠施立论的基础就是说"
    },
    {
      "ordinal": 64,
      "start_ms": 110360,
      "end_ms": 110640,
      "text": "知觉"
    },
    {
      "ordinal": 65,
      "start_ms": 110640,
      "end_ms": 112360,
      "text": "这个行为只能通过内心"
    },
    {
      "ordinal": 66,
      "start_ms": 112560,
      "end_ms": 114040,
      "text": "只能通过第一人称"
    },
    {
      "ordinal": 67,
      "start_ms": 114200,
      "end_ms": 116680,
      "text": "只能通过非常狭隘的自我意识"
    },
    {
      "ordinal": 68,
      "start_ms": 116680,
      "end_ms": 118640,
      "text": "内部才能够发生"
    },
    {
      "ordinal": 69,
      "start_ms": 118640,
      "end_ms": 120680,
      "text": "特别是对于快乐的知觉"
    },
    {
      "ordinal": 70,
      "start_ms": 120720,
      "end_ms": 122040,
      "text": "但是在庄子看来"
    },
    {
      "ordinal": 71,
      "start_ms": 122360,
      "end_ms": 123800,
      "text": "这个场所是"
    },
    {
      "ordinal": 72,
      "start_ms": 123840,
      "end_ms": 126520,
      "text": "不是限制在第一人称内在的"
    },
    {
      "ordinal": 73,
      "start_ms": 126560,
      "end_ms": 128360,
      "text": "不是限制在你的意识内部的"
    },
    {
      "ordinal": 74,
      "start_ms": 128520,
      "end_ms": 131280,
      "text": "所以他说“我知之濠上也”"
    },
    {
      "ordinal": 75,
      "start_ms": 132600,
      "end_ms": 133880,
      "text": "你问我哪里知道的"
    },
    {
      "ordinal": 76,
      "start_ms": 133880,
      "end_ms": 135440,
      "text": "我是从这座桥上面知道"
    },
    {
      "ordinal": 77,
      "start_ms": 135440,
      "end_ms": 137480,
      "text": "从濠水上面这座桥上面知道的"
    },
    {
      "ordinal": 78,
      "start_ms": 137880,
      "end_ms": 139480,
      "text": "所以在庄子看来"
    },
    {
      "ordinal": 79,
      "start_ms": 139480,
      "end_ms": 142440,
      "text": "快乐这种“内在”的体验"
    },
    {
      "ordinal": 80,
      "start_ms": 142480,
      "end_ms": 143400,
      "text": "它不是内在的"
    },
    {
      "ordinal": 81,
      "start_ms": 143440,
      "end_ms": 145320,
      "text": "第一人称所独有的一种体验"
    },
    {
      "ordinal": 82,
      "start_ms": 145360,
      "end_ms": 146600,
      "text": "不是说你一定要成为"
    },
    {
      "ordinal": 83,
      "start_ms": 147160,
      "end_ms": 148600,
      "text": "快乐的心灵本身"
    },
    {
      "ordinal": 84,
      "start_ms": 148640,
      "end_ms": 151840,
      "text": "你占据它的第一人称的视角"
    },
    {
      "ordinal": 85,
      "start_ms": 151880,
      "end_ms": 153040,
      "text": "你才能体验到快乐"
    },
    {
      "ordinal": 86,
      "start_ms": 153040,
      "end_ms": 153560,
      "text": "不是这样"
    },
    {
      "ordinal": 87,
      "start_ms": 153560,
      "end_ms": 154720,
      "text": "你才能认识到快乐"
    },
    {
      "ordinal": 88,
      "start_ms": 154800,
      "end_ms": 155680,
      "text": "在他看来"
    },
    {
      "ordinal": 89,
      "start_ms": 155720,
      "end_ms": 157320,
      "text": "比如说濠水、鱼"
    },
    {
      "ordinal": 90,
      "start_ms": 157320,
      "end_ms": 160080,
      "text": "你、我、我的内心"
    },
    {
      "ordinal": 91,
      "start_ms": 160080,
      "end_ms": 163560,
      "text": "你的内心、鱼、还有濠水"
    },
    {
      "ordinal": 92,
      "start_ms": 163600,
      "end_ms": 164280,
      "text": "濠水"
    },
    {
      "ordinal": 93,
      "start_ms": 165000,
      "end_ms": 166120,
      "text": "甚至它是一个"
    },
    {
      "ordinal": 94,
      "start_ms": 166480,
      "end_ms": 167800,
      "text": "非生命的东西"
    },
    {
      "ordinal": 95,
      "start_ms": 167800,
      "end_ms": 168840,
      "text": "鱼是动物"
    },
    {
      "ordinal": 96,
      "start_ms": 170000,
      "end_ms": 171240,
      "text": "子是他人"
    },
    {
      "ordinal": 97,
      "start_ms": 172120,
      "end_ms": 172800,
      "text": "别人"
    },
    {
      "ordinal": 98,
      "start_ms": 173560,
      "end_ms": 174440,
      "text": "我的内心"
    },
    {
      "ordinal": 99,
      "start_ms": 174440,
      "end_ms": 175480,
      "text": "在庄子看来"
    },
    {
      "ordinal": 100,
      "start_ms": 175520,
      "end_ms": 177120,
      "text": "这些东西是平等的"
    },
    {
      "ordinal": 101,
      "start_ms": 177120,
      "end_ms": 178120,
      "text": "是平等的"
    },
    {
      "ordinal": 102,
      "start_ms": 178720,
      "end_ms": 179640,
      "text": "所有这些东西"
    },
    {
      "ordinal": 103,
      "start_ms": 179640,
      "end_ms": 181360,
      "text": "都可以成为所谓的“乐”"
    },
    {
      "ordinal": 104,
      "start_ms": 181360,
      "end_ms": 182720,
      "text": "它发生的一个场域"
    },
    {
      "ordinal": 105,
      "start_ms": 182720,
      "end_ms": 184280,
      "text": "它被知觉到的一个场域"
    },
    {
      "ordinal": 106,
      "start_ms": 184520,
      "end_ms": 185720,
      "text": "所以他回答说"
    },
    {
      "ordinal": 107,
      "start_ms": 185720,
      "end_ms": 187400,
      "text": "我知之濠上也"
    },
    {
      "ordinal": 108,
      "start_ms": 188080,
      "end_ms": 188760,
      "text": "这个回答"
    },
    {
      "ordinal": 109,
      "start_ms": 189120,
      "end_ms": 190080,
      "text": "比那些庸俗的"
    },
    {
      "ordinal": 110,
      "start_ms": 190120,
      "end_ms": 191680,
      "text": "“我是看到鱼活蹦乱跳"
    },
    {
      "ordinal": 111,
      "start_ms": 191720,
      "end_ms": 192960,
      "text": "所以我知道它快乐”"
    },
    {
      "ordinal": 112,
      "start_ms": 193000,
      "end_ms": 194160,
      "text": "要高明很多"
    },
    {
      "ordinal": 113,
      "start_ms": 194200,
      "end_ms": 196320,
      "text": "因为他把矩阵给拉长了"
    },
    {
      "ordinal": 114,
      "start_ms": 196520,
      "end_ms": 199120,
      "text": "它并不是因为鱼和我有共同点"
    },
    {
      "ordinal": 115,
      "start_ms": 199120,
      "end_ms": 199720,
      "text": "我们都是动物"
    },
    {
      "ordinal": 116,
      "start_ms": 199720,
      "end_ms": 200880,
      "text": "所以我知道，不是的"
    },
    {
      "ordinal": 117,
      "start_ms": 200920,
      "end_ms": 202120,
      "text": "他是直接说了"
    },
    {
      "ordinal": 118,
      "start_ms": 202240,
      "end_ms": 203120,
      "text": "知道快乐"
    },
    {
      "ordinal": 119,
      "start_ms": 203120,
      "end_ms": 205280,
      "text": "这是不限制于任何事物的"
    },
    {
      "ordinal": 120,
      "start_ms": 205920,
      "end_ms": 206960,
      "text": "有生命、无生命"
    },
    {
      "ordinal": 121,
      "start_ms": 206960,
      "end_ms": 209320,
      "text": "都是可以是快乐发生的一个场域"
    }
  ],
