    {
      "ordinal": 216,
      "start_ms": 622800,
      "end_ms": 625470,
      "text": "我们要做这方面工作去努力的"
    },
    {
      "ordinal": 217,
      "start_ms": 627430,
      "end_ms": 629270,
      "text": "我们是有这样的义务的"
    },
    {
      "ordinal": 218,
      "start_ms": 629270,
      "end_ms": 630270,
      "text": "我们也有这样的"
    },
    {
      "ordinal": 219,
      "start_ms": 630270,
      "end_ms": 632350,
      "text": "也有这样的权利啊"
    },
    {
      "ordinal": 220,
      "start_ms": 632560,
      "end_ms": 634840,
      "text": "所以这个"
    },
    {
      "ordinal": 221,
      "start_ms": 637500,
      "end_ms": 642020,
      "text": "整体的这个四个方面的工作理想论啊"
