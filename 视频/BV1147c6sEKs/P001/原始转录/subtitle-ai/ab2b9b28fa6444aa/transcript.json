    },
    {
      "ordinal": 146,
      "start_ms": 445080,
      "end_ms": 446580,
      "text": "各地都有堂口啊"
    },
    {
      "ordinal": 147,
      "start_ms": 446580,
      "end_ms": 450539,
      "text": "都有这个可以就是合租的一个点啊"
    },
    {
      "ordinal": 148,
      "start_ms": 450539,
      "end_ms": 451659,
      "text": "也都有是比较便宜"
    },
    {
      "ordinal": 149,
      "start_ms": 451659,
      "end_ms": 452779,
      "text": "能吃饭的地方"
    },
    {
      "ordinal": 150,
      "start_ms": 452779,
      "end_ms": 453979,
      "text": "他就有这个"
    },
    {
      "ordinal": 151,
      "start_ms": 453979,
      "end_ms": 455079,
      "text": "还有一个是支教"
    },
    {
      "ordinal": 152,
      "start_ms": 455079,
      "end_ms": 455819,
      "text": "支教活动"
    },
    {
      "ordinal": 153,
      "start_ms": 455819,
      "end_ms": 458030,
      "text": "这都是用来出差"
    },
    {
      "ordinal": 154,
      "start_ms": 463090,
      "end_ms": 466150,
      "text": "志愿服务队啊"
    },
    {
      "ordinal": 155,
      "start_ms": 470680,
      "end_ms": 473820,
      "text": "啊包括在这个直直行生活服务里面啊"
    },
    {
      "ordinal": 156,
      "start_ms": 473820,
      "end_ms": 476160,
      "text": "直接生活服务里面"
    },
    {
      "ordinal": 157,
      "start_ms": 477460,
      "end_ms": 480660,
      "text": "然后在自言自语嘛"
    },
    {
      "ordinal": 158,
      "start_ms": 480660,
      "end_ms": 481820,
      "text": "我在录视频啊"
    },
    {
      "ordinal": 159,
      "start_ms": 481820,
      "end_ms": 483620,
      "text": "我这待会要上传啊"
    },
    {
      "ordinal": 160,
      "start_ms": 483620,
      "end_ms": 487000,
      "text": "就是介绍我做我做的事情啊"
    },
    {
      "ordinal": 161,
      "start_ms": 488340,
      "end_ms": 489600,
      "text": "我搞不懂啊"
    },
    {
      "ordinal": 162,
      "start_ms": 489600,
      "end_ms": 490800,
      "text": "我不能说嘛"
    },
    {
      "ordinal": 163,
      "start_ms": 490800,
      "end_ms": 492980,
      "text": "我我我我们自己在做的事情"
    },
    {
      "ordinal": 164,
      "start_ms": 492980,
      "end_ms": 493580,
      "text": "我不能讲嘛"
    },
    {
      "ordinal": 165,
      "start_ms": 493580,
      "end_ms": 495280,
      "text": "最后一个是这个艮卦啊"
    },
    {
      "ordinal": 166,
      "start_ms": 495280,
      "end_ms": 497580,
      "text": "艮住了艮卦"
    },
    {
      "ordinal": 167,
      "start_ms": 497580,
      "end_ms": 499320,
      "text": "我不知道他到底念第几声啊"
