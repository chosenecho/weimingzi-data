    },
    {
      "ordinal": 199,
      "start_ms": 584220,
      "end_ms": 586210,
      "text": "不同的面相啊"
    },
    {
      "ordinal": 200,
      "start_ms": 586210,
      "end_ms": 587930,
      "text": "然后就是说大家不同的人"
