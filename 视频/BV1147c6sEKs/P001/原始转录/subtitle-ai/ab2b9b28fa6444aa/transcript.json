    {
      "ordinal": 204,
      "start_ms": 596580,
      "end_ms": 599220,
      "text": "你这个敌是不是指当局还是指什么"
    },
    {
      "ordinal": 205,
      "start_ms": 600380,
      "end_ms": 603110,
      "text": "我是说谁背叛了阶级实质"
    },
    {
      "ordinal": 206,
      "start_ms": 603110,
      "end_ms": 606150,
      "text": "或者谁的阶级实质不是人民群众"
    },
    {
      "ordinal": 207,
      "start_ms": 606150,
      "end_ms": 607970,
      "text": "谁背叛了人民群众根本利益"
    },
    {
      "ordinal": 208,
      "start_ms": 607970,
      "end_ms": 610180,
      "text": "那谁就是敌人啊"
    },
    {
      "ordinal": 209,
      "start_ms": 610180,
      "end_ms": 612140,
      "text": "所以这个东西我不知道谁是敌人"
    },
    {
      "ordinal": 210,
      "start_ms": 612140,
      "end_ms": 613060,
      "text": "不确定的啊"
    },
    {
      "ordinal": 211,
      "start_ms": 613060,
      "end_ms": 614500,
      "text": "我并没有明知啊"
