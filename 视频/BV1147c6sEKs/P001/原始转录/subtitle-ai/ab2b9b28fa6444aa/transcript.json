    {
      "ordinal": 201,
      "start_ms": 587930,
      "end_ms": 592260,
      "text": "就可能就是说啊最最感兴趣的绿一色"
    },
    {
      "ordinal": 202,
      "start_ms": 592260,
      "end_ms": 594460,
