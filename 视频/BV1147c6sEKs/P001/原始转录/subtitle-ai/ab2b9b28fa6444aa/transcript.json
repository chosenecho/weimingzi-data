    },
    {
      "ordinal": 144,
      "start_ms": 437200,
      "end_ms": 440960,
      "text": "一个主要是这个直接生活服务"
    },
    {
      "ordinal": 145,
      "start_ms": 441480,
      "end_ms": 445080,
