{"segments":[{"start":0.6,"end":1.92,"text":"游戏结束了"},{"start":1.92,"end":5.13,"text":"化石先生或者叫杨和平先生"},{"start":5.13,"end":6.51,"text":"游戏结束了"},{"start":6.51,"end":7.71,"text":"game over"},{"start":7.71,"end":8.9,"text":"化石先生"},{"start":9.499,"end":10.779,"text":"这位化石先生"},{"start":10.779,"end":14.079,"text":"2017年在激烈网上发表一篇文章"},{"start":14.079,"end":16.119,"text":"叫10月革命百年后的回响"},{"start":16.119,"end":18.52,"text":"里面说什么啊"},{"start":20.24,"end":22.84,"text":"那么非常巧合的是"},{"start":22.84,"end":28.29,"text":"在啊2017年11月11日的时候啊"},{"start":28.29,"end":31.02,"text":"这个激烈网和毛主席旗帜网"},{"start":31.02,"end":36.56,"text":"召开了纪念10月革命100年的这个这个研讨会"},{"start":36.56,"end":39.04,"text":"名字也叫10月革命百年后的回响"},{"start":39.3,"end":43.56,"text":"这个研讨会里面记录了杨和平老师的发言"},{"start":43.56,"end":46.12,"text":"的主要内容啊"},{"start":47.44,"end":51.86,"text":"它主要内容里面就是说指出啊什么"},{"start":53.56,"end":55.26,"text":"我们俩两个对照着看吧"},{"start":55.26,"end":55.56,"text":"好吧"},{"start":55.56,"end":58.66,"text":"我们把这两个对照着看啊"},{"start":61.66,"end":63.63,"text":"啊什么啊"},{"start":63.63,"end":66.3,"text":"他里面说列列宁指出啊"},{"start":66.3,"end":68.88,"text":"军队警察中国家是阶级不可啊"},{"start":68.88,"end":70.72,"text":"这边啊"},{"start":74.08,"end":77.9,"text":"他应该是他这里面说的是实施了主要"},{"start":77.9,"end":80.78,"text":"这里面主要内容是资产阶级各个派别"},{"start":80.78,"end":85.38,"text":"有的着眼于这个这个资产阶级的宏观理由"},{"start":85.38,"end":86.91,"text":"只用于自然与微观利益啊"},{"start":86.91,"end":88.32,"text":"会出台不同的措施"},{"start":88.32,"end":90.32,"text":"然后这由于10月革命"},{"start":90.32,"end":92.36,"text":"激发了各国工人阶级的觉悟"},{"start":92.36,"end":95.6,"text":"逼迫那些卓越于资资产阶级宏宏观利那派"},{"start":95.6,"end":96.88,"text":"维护自然地制度"},{"start":96.88,"end":98.2,"text":"瓦解工人阶级斗争"},{"start":98.2,"end":99.46,"text":"采取了一些改良的措施"},{"start":99.46,"end":101.35,"text":"实施了一些资产阶级民主措施"},{"start":101.35,"end":102.85,"text":"但是对于私有制而言"},{"start":102.85,"end":105.97,"text":"社会改良和自然基总总是第二位的"},{"start":105.97,"end":108.61,"text":"它上面就是说就是说实革命之后"},{"start":108.61,"end":109.979,"text":"自然经济改良了"},{"start":109.979,"end":112.859,"text":"但是这改良是第二位的啊"},{"start":114.059,"end":115.679,"text":"我看这篇文章里面"},{"start":122.52,"end":124.58,"text":"然后说你来看嘛"},{"start":124.58,"end":127.22,"text":"这些就喷什么三权分立啊"},{"start":127.22,"end":131.62,"text":"是最利于自然一调节协调自然一什么什么什么"},{"start":133.939,"end":135.639,"text":"怎么缩小一点"},{"start":135.639,"end":136.52,"text":"缩小一点"},{"start":143.58,"end":146.6,"text":"就是说10月革命以后啊"},{"start":146.6,"end":147.68,"text":"自然界一部分意识到"},{"start":147.68,"end":149.84,"text":"本阶级宏观利益和微观利益的对立"},{"start":149.84,"end":152.06,"text":"尤其是30年代大萧条之后啊"},{"start":152.06,"end":154.61,"text":"一部分一部分自然就意识到宏观利益"},{"start":154.61,"end":155.99,"text":"这边也是的啊"},{"start":155.99,"end":157.97,"text":"有的着眼于自然界宏观利益"},{"start":157.97,"end":159.78,"text":"有的着眼于微观利益啊"},{"start":160.499,"end":162.559,"text":"意识到宏观历的那些啊"},{"start":162.559,"end":164.899,"text":"提出了一系列符合资本主义宏观利措施"},{"start":164.899,"end":166.309,"text":"成了什么什么啊"},{"start":166.309,"end":170.1,"text":"这种改良食的资本主义剥削具有可持续性啊"},{"start":170.359,"end":171.859,"text":"宏观要卓越"},{"start":171.859,"end":175.039,"text":"宏观利益的给给一些好的措施啊"},{"start":175.039,"end":176.959,"text":"就改良了啊"},{"start":176.959,"end":178.759,"text":"短视的呢就是这"},{"start":178.759,"end":181.819,"text":"其实这篇这篇这一段话就是对杨和平的"},{"start":181.819,"end":185.549,"text":"这篇就是对化石先生这篇文章的一个啊"},{"start":185.549,"end":188.189,"text":"化石先生这篇文章的一个那个描述啊"},{"start":188.189,"end":191.339,"text":"这边就指的那些是什宏观利益的啊"},{"start":191.339,"end":194.13,"text":"宏观利微观利益什么什么哎呀"},{"start":194.13,"end":197.31,"text":"比如为了资产阶级自身在后面就罗列了啊"},{"start":197.31,"end":199.35,"text":"罗列了这里面的一些改良的自然界"},{"start":199.35,"end":201.16,"text":"改良的一些手段手法"},{"start":204.26,"end":207.94,"text":"然后离开资本主义宏观利益和微观利益的对立"},{"start":207.94,"end":209.08,"text":"这分框架啊"},{"start":209.08,"end":210.88,"text":"什么什么什么什么"},{"start":210.88,"end":212.14,"text":"反正啊"},{"start":212.14,"end":213.1,"text":"但是在"},{"start":215.42,"end":216.86,"text":"我们来看啊"},{"start":216.86,"end":219.02,"text":"就是说但是相对私有制而言"},{"start":219.02,"end":222.62,"text":"社会改良和这个自然界民主总是第二位的"},{"start":232.899,"end":236.189,"text":"他这个这句话是对上面那句话一个一个描述啊"},{"start":236.189,"end":237.12,"text":"但是"},{"start":239.959,"end":242.799,"text":"在这里工人阶级参与改良斗争不是目的"},{"start":242.799,"end":243.819,"text":"而是手段啊"},{"start":243.819,"end":245.6,"text":"改良总是第二位的啊"},{"start":246.019,"end":249.679,"text":"不不不不是社会改良和相对于私有之言"},{"start":249.679,"end":250.999,"text":"他这个私有制在上面"},{"start":250.999,"end":253.34,"text":"这上面就是说你必须接受私有制"},{"start":253.7,"end":255.92,"text":"相反的工人阶级必须认同私有制"},{"start":255.92,"end":257.839,"text":"必须放弃对资本主义制度的挑战"},{"start":257.839,"end":259.279,"text":"才能享受到改良"},{"start":259.279,"end":261.44,"text":"才能享受到民主啊"},{"start":261.44,"end":263.24,"text":"资产阶级民主总是第二位的"},{"start":263.24,"end":264.14,"text":"相对于私有制"},{"start":264.14,"end":265.64,"text":"改良和民主总是第二位的"},{"start":265.64,"end":267.04,"text":"那就对应上面这句话"},{"start":267.04,"end":269.08,"text":"相反的工人阶级必须认同私有制"},{"start":269.08,"end":271.0,"text":"必须放弃对私有制度的挑战"},{"start":271.0,"end":274.18,"text":"才能享受到资本主义下的民主啊"},{"start":274.18,"end":276.94,"text":"并且劳动人民对私有制政同的程度越高"},{"start":276.94,"end":278.08,"text":"对资本主义威胁越少"},{"start":278.08,"end":281.2,"text":"就能享受到的资产阶明度就越越越多"},{"start":281.2,"end":283.769,"text":"这句话对应的就是啊这段话啊"},{"start":283.769,"end":285.839,"text":"就这段话相对于私有制而言"},{"start":285.839,"end":288.419,"text":"总是授予了自然移民组成第二位的"},{"start":288.419,"end":290.8,"text":"然后在资本主义社会中"},{"start":290.8,"end":293.16,"text":"资产阶级的军队啊"},{"start":293.38,"end":295.99,"text":"据警察法庭各有各的分工"},{"start":295.99,"end":297.58,"text":"这个也是在上面的啊"},{"start":297.58,"end":299.03,"text":"在资本制度下"},{"start":299.03,"end":300.83,"text":"国家的暴力机器"},{"start":300.83,"end":301.67,"text":"军队法"},{"start":301.67,"end":303.2,"text":"警察和法庭各有分工"},{"start":303.2,"end":304.55,"text":"你看这个化石先生"},{"start":304.55,"end":307.799,"text":"为了让他不被识破"},{"start":307.799,"end":308.639,"text":"他就是杨和平"},{"start":308.639,"end":310.289,"text":"他把他内容倒过来写"},{"start":310.289,"end":311.189,"text":"懂了吗"},{"start":311.189,"end":314.4,"text":"他演讲的时候的内容是从上往下的"},{"start":314.5,"end":316.66,"text":"但是他发这篇文章的时候"},{"start":316.66,"end":318.94,"text":"他把这个内容倒过来写啊"},{"start":318.94,"end":320.08,"text":"顺序打乱一下"},{"start":320.08,"end":321.16,"text":"好像别人看不出来"},{"start":321.16,"end":322.12,"text":"他妈都是一样的"},{"start":322.12,"end":323.83,"text":"在各有各分工"},{"start":323.83,"end":326.62,"text":"人家记录着在资本主义各有分"},{"start":326.62,"end":327.67,"text":"各有各的分工"},{"start":327.67,"end":329.29,"text":"我告诉你还更夸张的"},{"start":329.29,"end":332.65,"text":"他他是把一半文章上半部分内容倒过来写"},{"start":332.65,"end":334.21,"text":"你看百年之后的今天"},{"start":334.21,"end":335.11,"text":"列宁主义过时了吗"},{"start":335.11,"end":336.25,"text":"10月革命道路过时了吗"},{"start":336.25,"end":338.52,"text":"近十连世界性的资本主义危机"},{"start":338.52,"end":339.42,"text":"什么什么什么"},{"start":339.42,"end":342.159,"text":"这两个问题是人家记录下来的"},{"start":342.159,"end":343.599,"text":"这个发言的一个简稿"},{"start":343.599,"end":345.579,"text":"这个问题在他这边也问的啊"},{"start":345.579,"end":346.84,"text":"在这里也问了"},{"start":346.979,"end":349.079,"text":"在化石先生那百年之后"},{"start":349.079,"end":350.699,"text":"金天命令主义过时了吗"},{"start":350.699,"end":352.799,"text":"10月革命道路过时了吗"},{"start":352.799,"end":354.979,"text":"啊啊啊"},{"start":354.979,"end":356.089,"text":"他这里也问了"},{"start":356.089,"end":357.109,"text":"也问了"},{"start":357.109,"end":359.599,"text":"明白吧啊尤其是二战之后"},{"start":359.599,"end":364.55,"text":"也就苏联建立就是什么什么是不是近10年的"},{"start":364.55,"end":366.32,"text":"当然历史不是简单的回复"},{"start":366.32,"end":369.8,"text":"而是螺旋式上升的什么当代资本主义全球化"},{"start":369.8,"end":373.78,"text":"客观上把各国的无产地更加紧密联系在一块啊"},{"start":381.5,"end":382.42,"text":"这个"},{"start":384.199,"end":386.259,"text":"他也是概括下面概括"},{"start":386.259,"end":388.36,"text":"下面的话更紧密地联合在一块"},{"start":390.579,"end":392.279,"text":"啊历史不是简单的重复"},{"start":392.279,"end":393.659,"text":"而是螺旋式上升的"},{"start":393.659,"end":394.139,"text":"看到没有"},{"start":394.139,"end":395.099,"text":"这句话是原话"},{"start":395.099,"end":396.119,"text":"这里也是历史"},{"start":396.119,"end":397.94,"text":"不是简单而螺旋上升的"},{"start":402.6,"end":404.3,"text":"啊同时资本主义啊"},{"start":404.3,"end":406.94,"text":"产业链的全球化客观想法统一了起来啊"},{"start":406.94,"end":409.22,"text":"在这边写的是更紧密的联系在一起"},{"start":409.22,"end":409.58,"text":"来"},{"start":409.58,"end":410.38,"text":"一个意思啊"},{"start":410.38,"end":411.73,"text":"啊若干年之后"},{"start":411.73,"end":413.74,"text":"新一轮帝国主义争霸的炮声"},{"start":413.74,"end":416.02,"text":"必将再次成为再次革命的号角"},{"start":416.02,"end":418.72,"text":"因此正当全球资产阶级欢呼历史终结之时"},{"start":418.72,"end":421.06,"text":"其走向灭亡的最后行人却已成"},{"start":423.52,"end":428.4,"text":"啊就是说目前的形势什么啊"},{"start":428.4,"end":430.68,"text":"因此啊走向灭亡的最后行程"},{"start":430.68,"end":434.9,"text":"却一开始就说我这个视频先告诉你这个化石"},{"start":435.06,"end":436.71,"text":"这个化石啊"},{"start":436.71,"end":442.399,"text":"这个化石这位化石叫做化石的这个啊"},{"start":442.399,"end":444.26,"text":"你在基地网也能搜到这篇文章"},{"start":445.38,"end":448.55,"text":"在激流网上也能搜搜到一篇文章啊"},{"start":448.55,"end":450.82,"text":"搜到化石的这篇文章"},{"start":452.22,"end":453.78,"text":"他就是杨和平"},{"start":457.24,"end":458.52,"text":"杨和平本人"},{"start":458.52,"end":461.58,"text":"他就是杨和平发这篇文章这个化石啊"},{"start":461.58,"end":463.42,"text":"他还有另外一篇雄作"},{"start":465.579,"end":467.699,"text":"啊这个化石又有一篇雄作"},{"start":467.699,"end":469.199,"text":"他的那篇文章在激励"},{"start":469.199,"end":473.98,"text":"往上就是10月革命百年后的回响啊"},{"start":473.98,"end":476.05,"text":"这个化石另有一篇雄作"},{"start":476.05,"end":477.25,"text":"另一篇雄文"},{"start":477.25,"end":480.8,"text":"我告诉你那篇雄文里面会泄露他的全部底细啊"}],"source":"subtitle"}
