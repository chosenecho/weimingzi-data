  "content_sha256": "03b14e7172195aa5663e48b390991619adfd917ae16dd07196e810350301c79d",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 1040,
      "end_ms": 3320,
      "text": "我们桐城公益餐又出新品了"
    },
    {
      "ordinal": 1,
      "start_ms": 3320,
      "end_ms": 7980,
      "text": "是这个222个套餐啊"
    },
    {
      "ordinal": 2,
      "start_ms": 7980,
      "end_ms": 15220,
      "text": "两个套餐一个是这个牛排饭啊"
    },
    {
      "ordinal": 3,
      "start_ms": 15220,
      "end_ms": 16059,
      "text": "一个是牛排饭"
    },
    {
      "ordinal": 4,
      "start_ms": 16059,
      "end_ms": 19560,
      "text": "或者说就是牛排炒面啊"
    },
    {
      "ordinal": 5,
      "start_ms": 19560,
      "end_ms": 21180,
      "text": "还有一个就是鸡腿饭啊"
    },
    {
      "ordinal": 6,
      "start_ms": 21180,
      "end_ms": 26220,
      "text": "或者鸡腿炒面那个炒饭都是黑胡椒味的呃"
    },
    {
      "ordinal": 7,
      "start_ms": 26220,
      "end_ms": 31800,
      "text": "有三种主食啊啊然后价格呢都是比较便宜啊"
    },
    {
      "ordinal": 8,
      "start_ms": 31800,
      "end_ms": 34920,
      "text": "这个牛排饭的话价格是在19块五"
    },
    {
      "ordinal": 9,
      "start_ms": 34920,
      "end_ms": 36320,
      "text": "加炒饭的话"
    },
    {
      "ordinal": 10,
      "start_ms": 36720,
      "end_ms": 39570,
      "text": "我们都只赚一个加工费啊"
    },
    {
      "ordinal": 11,
      "start_ms": 39570,
      "end_ms": 41700,
      "text": "这个前面算的都是食材的成本"
    },
    {
      "ordinal": 12,
      "start_ms": 41700,
      "end_ms": 43830,
      "text": "后面只赚一个加工费六元"
    },
    {
      "ordinal": 13,
      "start_ms": 43830,
      "end_ms": 45270,
      "text": "这个只赚加工费"
    },
    {
      "ordinal": 14,
      "start_ms": 45270,
      "end_ms": 48500,
      "text": "而且由于我是我们是做公益的嘛"
    },
    {
      "ordinal": 15,
      "start_ms": 48500,
      "end_ms": 50180,
      "text": "所以这些东西呢就算了"
    },
    {
      "ordinal": 16,
      "start_ms": 50180,
      "end_ms": 51740,
      "text": "你看这个加工费这个六块钱"
    },
    {
      "ordinal": 17,
      "start_ms": 51740,
      "end_ms": 55120,
      "text": "这个五块三毛钱七毛钱差在哪里"
    },
    {
      "ordinal": 18,
      "start_ms": 55120,
      "end_ms": 59680,
      "text": "差在他的时间加工时间都给你算清楚的啊"
    },
    {
      "ordinal": 19,
      "start_ms": 60080,
      "end_ms": 61850,
      "text": "这个三种主食"
    },
    {
      "ordinal": 20,
      "start_ms": 61850,
      "end_ms": 64700,
      "text": "然后第一个是炒面啊"
    },
    {
      "ordinal": 21,
      "start_ms": 64700,
      "end_ms": 66020,
      "text": "工时0.1"
    },
    {
      "ordinal": 22,
      "start_ms": 66020,
      "end_ms": 69820,
      "text": "平均平均零点一个小时六分钟"
    },
    {
      "ordinal": 23,
      "start_ms": 70840,
      "end_ms": 74320,
      "text": "白米饭工时三分钟啊"
    },
    {
      "ordinal": 24,
      "start_ms": 74320,
      "end_ms": 76540,
      "text": "这个这个都是毛乎乎的啊"
    },
    {
      "ordinal": 25,
      "start_ms": 76540,
      "end_ms": 79360,
      "text": "然后那个热量也都算出来了"
    },
    {
      "ordinal": 26,
      "start_ms": 79360,
      "end_ms": 83500,
      "text": "还有炒饭有两种荤素搭配啊"
    },
    {
      "ordinal": 27,
      "start_ms": 83500,
      "end_ms": 84640,
      "text": "两种荤素搭配"
    },
    {
      "ordinal": 28,
      "start_ms": 84640,
      "end_ms": 86560,
      "text": "一个是牛排饭啊"
    },
    {
      "ordinal": 29,
      "start_ms": 86560,
      "end_ms": 89080,
      "text": "是有一块牛排"
    },
    {
      "ordinal": 30,
      "start_ms": 89080,
      "end_ms": 90340,
      "text": "但是给你切好的"
    },
    {
      "ordinal": 31,
      "start_ms": 90340,
      "end_ms": 91570,
      "text": "先给你切好的"
    },
    {
      "ordinal": 32,
      "start_ms": 91570,
      "end_ms": 95920,
      "text": "然后是平均加工时间0.25"
    },
    {
      "ordinal": 33,
      "start_ms": 95920,
      "end_ms": 96880,
      "text": "这个是0.2"
    },
    {
      "ordinal": 34,
      "start_ms": 96880,
      "end_ms": 99679,
      "text": "所以他的那个工时费差了七毛钱啊"
    },
    {
      "ordinal": 35,
      "start_ms": 102800,
      "end_ms": 103900,
      "text": "还有蔬菜啊"
    },
    {
      "ordinal": 36,
      "start_ms": 103900,
      "end_ms": 104920,
      "text": "蔬菜都写在这边"
    },
    {
      "ordinal": 37,
      "start_ms": 104920,
      "end_ms": 106510,
      "text": "蔬菜有玉米"
    },
    {
      "ordinal": 38,
      "start_ms": 106510,
      "end_ms": 110650,
      "text": "什么莴笋啊"
    },
    {
      "ordinal": 39,
      "start_ms": 110650,
      "end_ms": 112990,
      "text": "是青豆洋葱"
    },
    {
      "ordinal": 40,
      "start_ms": 112990,
      "end_ms": 113800,
      "text": "西兰花"
    },
    {
      "ordinal": 41,
      "start_ms": 113800,
      "end_ms": 116380,
      "text": "香菇胡萝卜啊"
    },
    {
      "ordinal": 42,
      "start_ms": 116380,
      "end_ms": 118740,
      "text": "还有这个笋啊"
    },
    {
      "ordinal": 43,
      "start_ms": 118740,
      "end_ms": 120000,
      "text": "这就是莴笋啊"
    },
    {
      "ordinal": 44,
      "start_ms": 120000,
      "end_ms": 124090,
      "text": "然后那个配料是有黑胡椒嗯"
    },
    {
      "ordinal": 45,
      "start_ms": 124090,
      "end_ms": 129320,
      "text": "什么黄油味精啊"
    },
    {
      "ordinal": 46,
      "start_ms": 130139,
      "end_ms": 131060,
      "text": "盐啊"
    },
    {
      "ordinal": 47,
      "start_ms": 131060,
      "end_ms": 131780,
      "text": "他都写在上面"
    },
    {
      "ordinal": 48,
      "start_ms": 131780,
      "end_ms": 135020,
      "text": "然后这个鸡腿饭呢是一个大鸡腿"
    },
    {
      "ordinal": 49,
      "start_ms": 135020,
      "end_ms": 138480,
      "text": "然后这个这个切下来配料也是差不多啊"
    },
    {
      "ordinal": 50,
      "start_ms": 138480,
      "end_ms": 139950,
      "text": "什么玉米莴笋"
    },
    {
      "ordinal": 51,
      "start_ms": 139950,
      "end_ms": 142440,
      "text": "青豆洋葱西兰花啊"
    },
    {
      "ordinal": 52,
      "start_ms": 142440,
      "end_ms": 145340,
      "text": "但是这里面还有老抽料酒啊"
    },
    {
      "ordinal": 53,
      "start_ms": 146999,
      "end_ms": 147940,
      "text": "然后"
    },
    {
      "ordinal": 54,
      "start_ms": 149860,
      "end_ms": 153060,
      "text": "要订餐的话可以扫这个二维码配送"
    },
    {
      "ordinal": 55,
      "start_ms": 153060,
      "end_ms": 156300,
      "text": "说明的话是呃应该是一个星期一送吧"
    },
    {
      "ordinal": 56,
      "start_ms": 156300,
      "end_ms": 159360,
      "text": "或者说一个星期两送一次"
    },
    {
      "ordinal": 57,
      "start_ms": 159360,
      "end_ms": 161820,
      "text": "要订餐是两份起订"
    },
    {
      "ordinal": 58,
      "start_ms": 162140,
      "end_ms": 164900,
      "text": "配送费要另算啊"
    },
    {
      "ordinal": 59,
      "start_ms": 164900,
      "end_ms": 166550,
      "text": "配送费要另算啊"
    },
    {
      "ordinal": 60,
      "start_ms": 166550,
      "end_ms": 172660,
      "text": "然后这个扫这个二维码就可以加到我们那个啊"
    },
    {
      "ordinal": 61,
      "start_ms": 172660,
      "end_ms": 174160,
      "text": "电电的微信"
    },
    {
      "ordinal": 62,
      "start_ms": 174160,
      "end_ms": 175840,
      "text": "然后他给你们拉到群里面"
    },
    {
      "ordinal": 63,
      "start_ms": 175840,
      "end_ms": 177580,
      "text": "但是只有苏州地区啊"
    },
    {
      "ordinal": 64,
      "start_ms": 177580,
      "end_ms": 178570,
      "text": "只有苏州地区"
    },
    {
      "ordinal": 65,
      "start_ms": 178570,
      "end_ms": 179800,
      "text": "最好你近一点"
    },
    {
      "ordinal": 66,
      "start_ms": 179800,
      "end_ms": 182530,
      "text": "苏州苏州市区"
    },
    {
      "ordinal": 67,
      "start_ms": 182530,
      "end_ms": 187230,
      "text": "苏州的那个区线就不要了"
    },
    {
      "ordinal": 68,
      "start_ms": 187230,
      "end_ms": 188640,
      "text": "因为有的线就太远了"
    },
    {
      "ordinal": 69,
      "start_ms": 188640,
      "end_ms": 189120,
      "text": "你知道吗"
    },
    {
      "ordinal": 70,
      "start_ms": 189120,
      "end_ms": 193420,
      "text": "什么啊什么我顶多给你送到相城区对吧"
    },
    {
      "ordinal": 71,
      "start_ms": 193420,
      "end_ms": 196060,
      "text": "你园区新区这种"
    },
    {
      "ordinal": 72,
      "start_ms": 196060,
      "end_ms": 197700,
      "text": "你如果是在什么"
    },
    {
      "ordinal": 73,
      "start_ms": 197739,
      "end_ms": 199419,
      "text": "但如果你订的多的话"
    },
    {
      "ordinal": 74,
      "start_ms": 199419,
      "end_ms": 201549,
      "text": "我们可以给你送外卖啊"
    },
    {
      "ordinal": 75,
      "start_ms": 201549,
      "end_ms": 203859,
      "text": "实在啊不是送送快递啊"
    },
    {
      "ordinal": 76,
      "start_ms": 203859,
      "end_ms": 205380,
      "text": "实在你订的多的话"
    },
    {
      "ordinal": 77,
      "start_ms": 206800,
      "end_ms": 209880,
      "text": "因为但是我只能送冷冻剑啊"
    },
    {
      "ordinal": 78,
      "start_ms": 211420,
      "end_ms": 216960,
      "text": "然后配送费都是单独计算的"
    },
    {
      "ordinal": 79,
      "start_ms": 216960,
      "end_ms": 218400,
      "text": "六块钱到15元"
    },
    {
      "ordinal": 80,
      "start_ms": 218400,
      "end_ms": 221820,
      "text": "配送费都是我们我们员工自己去送的啊"
    },
    {
      "ordinal": 81,
      "start_ms": 221820,
      "end_ms": 224700,
      "text": "自己去送的啊"
    },
    {
      "ordinal": 82,
      "start_ms": 224739,
      "end_ms": 228549,
      "text": "然后配送费是全部都是给配送员的"
    },
    {
      "ordinal": 83,
      "start_ms": 228549,
      "end_ms": 229599,
      "text": "就跑一趟"
    },
    {
      "ordinal": 84,
      "start_ms": 229599,
      "end_ms": 231339,
      "text": "全就是他的劳动收入"
    },
    {
      "ordinal": 85,
      "start_ms": 231339,
      "end_ms": 232539,
      "text": "你知道吗啊"
    },
    {
      "ordinal": 86,
      "start_ms": 232539,
      "end_ms": 235439,
      "text": "我就说我这我这样说"
    },
    {
      "ordinal": 87,
      "start_ms": 235439,
      "end_ms": 238259,
      "text": "就是说在这个所有的这些经营活动当中"
    },
    {
      "ordinal": 88,
      "start_ms": 238259,
      "end_ms": 239339,
      "text": "我作为资本家"
    },
    {
      "ordinal": 89,
      "start_ms": 239339,
      "end_ms": 240959,
      "text": "你非要说我是这个店的店主"
    },
    {
      "ordinal": 90,
      "start_ms": 240959,
      "end_ms": 243000,
      "text": "我是不得一毛钱的"
    },
    {
      "ordinal": 91,
      "start_ms": 243200,
      "end_ms": 246740,
      "text": "觉得劳动者全德就是我们的店员"
    },
    {
      "ordinal": 92,
      "start_ms": 246740,
      "end_ms": 250730,
      "text": "甚至那个电现在是让他们自主经营"
    },
    {
      "ordinal": 93,
      "start_ms": 250730,
      "end_ms": 252410,
      "text": "房租没有让他们覆盖"
    },
    {
      "ordinal": 94,
      "start_ms": 252410,
      "end_ms": 256050,
      "text": "然后这个他们赚多少都是他们的啊"
    },
    {
      "ordinal": 95,
      "start_ms": 256050,
      "end_ms": 256980,
      "text": "都是他们的"
    },
    {
      "ordinal": 96,
      "start_ms": 256980,
      "end_ms": 258930,
      "text": "都是这个我们的店员的"
    },
    {
      "ordinal": 97,
      "start_ms": 258930,
      "end_ms": 261820,
      "text": "全部是就是没没错"
    },
    {
      "ordinal": 98,
      "start_ms": 262180,
      "end_ms": 265540,
      "text": "然后你说啊我买的这些食材里面有剩余价值"
    },
    {
      "ordinal": 99,
      "start_ms": 265540,
      "end_ms": 266920,
      "text": "我靠那我没话说了"
    },
    {
      "ordinal": 100,
      "start_ms": 266920,
      "end_ms": 268300,
      "text": "我妈我真的没话说了"
    },
    {
      "ordinal": 101,
      "start_ms": 268300,
      "end_ms": 269800,
      "text": "好吧嗯"
    },
    {
      "ordinal": 102,
      "start_ms": 271720,
      "end_ms": 274500,
      "text": "这个是上一次7月1号就配送了"
    },
    {
      "ordinal": 103,
      "start_ms": 275220,
      "end_ms": 279440,
      "text": "那个我们我来直接给你们尝尝一尝"
    },
    {
      "ordinal": 104,
      "start_ms": 279440,
      "end_ms": 279860,
      "text": "尝一尝"
    },
    {
      "ordinal": 105,
      "start_ms": 279860,
      "end_ms": 282020,
      "text": "今天我刚刚热了一份这个牛排"
    },
    {
      "ordinal": 106,
      "start_ms": 282890,
      "end_ms": 283800,
      "text": "这个"
    },
    {
      "ordinal": 107,
      "start_ms": 285579,
      "end_ms": 286679,
      "text": "光线问题啊"
    },
    {
      "ordinal": 108,
      "start_ms": 286679,
      "end_ms": 287819,
      "text": "没有给你打高光啊"
    },
    {
      "ordinal": 109,
      "start_ms": 287819,
      "end_ms": 288779,
      "text": "然后摆盘问题"
    },
    {
      "ordinal": 110,
      "start_ms": 288779,
      "end_ms": 289619,
      "text": "我不会摆盘"
    },
    {
      "ordinal": 111,
      "start_ms": 289619,
      "end_ms": 291209,
      "text": "我反正我自己热了一下"
    },
    {
      "ordinal": 112,
      "start_ms": 291209,
      "end_ms": 294720,
      "text": "然后他还有一个这个这个酱啊"
    },
    {
      "ordinal": 113,
      "start_ms": 294720,
      "end_ms": 295740,
      "text": "我稍微加一点"
    },
    {
      "ordinal": 114,
      "start_ms": 298740,
      "end_ms": 301580,
      "text": "对这个是这个价"
    },
    {
      "ordinal": 115,
      "start_ms": 301580,
      "end_ms": 304480,
      "text": "应该是加了黄油的什么的什么"
    },
    {
      "ordinal": 116,
      "start_ms": 304900,
      "end_ms": 306220,
      "text": "我靠稍微加一点"
    },
    {
      "ordinal": 117,
      "start_ms": 306220,
      "end_ms": 307100,
      "text": "全加了"
    },
    {
      "ordinal": 118,
      "start_ms": 311660,
      "end_ms": 312610,
      "text": "黑胡椒酱"
    },
    {
      "ordinal": 119,
      "start_ms": 312610,
      "end_ms": 313360,
      "text": "黑胡椒酱"
    },
    {
      "ordinal": 120,
      "start_ms": 314800,
      "end_ms": 315800,
      "text": "黑胡椒酱"
    },
    {
      "ordinal": 121,
      "start_ms": 316660,
      "end_ms": 320190,
      "text": "然后他的炒饭我们这个师傅的"
    },
    {
      "ordinal": 122,
      "start_ms": 320190,
      "end_ms": 321660,
      "text": "他虽然看上去不好看"
    },
    {
      "ordinal": 123,
      "start_ms": 321660,
      "end_ms": 324159,
      "text": "但是我刚刚在加热之前"
    },
    {
      "ordinal": 124,
      "start_ms": 324159,
      "end_ms": 325239,
      "text": "我抿了一点"
    },
    {
      "ordinal": 125,
      "start_ms": 325239,
      "end_ms": 326019,
      "text": "我拿了一点"
    },
    {
      "ordinal": 126,
      "start_ms": 326019,
      "end_ms": 326619,
      "text": "尝了一尝"
    },
    {
      "ordinal": 127,
      "start_ms": 326619,
      "end_ms": 328780,
      "text": "就是他炒饭好像炒特别好吃"
    },
    {
      "ordinal": 128,
      "start_ms": 330100,
      "end_ms": 331680,
      "text": "我是不吃碳水的人"
    },
    {
      "ordinal": 129,
      "start_ms": 331680,
      "end_ms": 334050,
      "text": "那我这个炒饭好像比较好吃啊"
    },
    {
      "ordinal": 130,
      "start_ms": 334050,
      "end_ms": 335280,
      "text": "我尝一尝"
    },
    {
      "ordinal": 131,
      "start_ms": 339660,
      "end_ms": 341540,
      "text": "来吃吃下这个香菇"
    },
    {
      "ordinal": 132,
      "start_ms": 341540,
      "end_ms": 344670,
      "text": "就是蔬菜都是新鲜的蔬菜"
    },
    {
      "ordinal": 133,
      "start_ms": 344670,
      "end_ms": 346560,
      "text": "虽然我们用真空包装啊"
    },
    {
      "ordinal": 134,
      "start_ms": 346560,
      "end_ms": 347740,
      "text": "这是没办法的"
    },
    {
      "ordinal": 135,
      "start_ms": 349060,
      "end_ms": 352080,
      "text": "就为了把这个包装在一个包装袋里面"
    },
    {
      "ordinal": 136,
      "start_ms": 352080,
      "end_ms": 355500,
      "text": "然后真空包装的熟的蔬菜它不能变形"
    },
    {
      "ordinal": 137,
      "start_ms": 355500,
      "end_ms": 357020,
      "text": "所以我们选的都是西兰花"
    },
    {
      "ordinal": 138,
      "start_ms": 357360,
      "end_ms": 358860,
      "text": "这里面还有两种西兰花"
    },
    {
      "ordinal": 139,
      "start_ms": 358860,
      "end_ms": 359460,
      "text": "一个白的"
    },
    {
      "ordinal": 140,
      "start_ms": 359460,
      "end_ms": 362179,
      "text": "一个有花椰菜"
    },
    {
      "ordinal": 141,
      "start_ms": 362179,
      "end_ms": 363259,
      "text": "一个白的花椰菜"
    },
    {
      "ordinal": 142,
      "start_ms": 363259,
      "end_ms": 365160,
      "text": "还有一个是绿的西兰花"
    },
    {
      "ordinal": 143,
      "start_ms": 365539,
      "end_ms": 367860,
      "text": "它都不不容易变形的啊"
    },
    {
      "ordinal": 144,
      "start_ms": 373920,
      "end_ms": 375640,
      "text": "嗯这蔬菜味道不错"
    },
    {
      "ordinal": 145,
      "start_ms": 376860,
      "end_ms": 380460,
      "text": "那蔬菜蘸一下那个酱汁啊"
    },
    {
      "ordinal": 146,
      "start_ms": 381620,
      "end_ms": 382900,
      "text": "就是鲜甜适中"
    },
    {
      "ordinal": 147,
      "start_ms": 382900,
      "end_ms": 384100,
      "text": "这种蔬菜不是那种"
    },
    {
      "ordinal": 148,
      "start_ms": 385360,
      "end_ms": 386380,
      "text": "就是它有味道"
    },
    {
      "ordinal": 149,
      "start_ms": 386380,
      "end_ms": 386860,
      "text": "你知道吗"
    },
    {
      "ordinal": 150,
      "start_ms": 386860,
      "end_ms": 387820,
      "text": "它是有味道"
    },
    {
      "ordinal": 151,
      "start_ms": 395840,
      "end_ms": 399360,
      "text": "哦哦这个这炒饭确实蛮好吃的"
    },
    {
      "ordinal": 152,
      "start_ms": 401699,
      "end_ms": 403700,
      "text": "他这炒饭确实好吃"
    },
    {
      "ordinal": 153,
      "start_ms": 407620,
      "end_ms": 409200,
      "text": "我怎么跟你们形容呢"
    },
    {
      "ordinal": 154,
      "start_ms": 411480,
      "end_ms": 413760,
      "text": "他的炒饭炒出了川菜的味道"
    },
    {
      "ordinal": 155,
      "start_ms": 415480,
      "end_ms": 418920,
      "text": "又有点那个就他这个炒饭确实好吃"
    },
    {
      "ordinal": 156,
      "start_ms": 418920,
      "end_ms": 420500,
      "text": "我没有其他话可说"
    },
    {
      "ordinal": 157,
      "start_ms": 426280,
      "end_ms": 427380,
      "text": "有点黑胡椒"
    },
    {
      "ordinal": 158,
      "start_ms": 427380,
      "end_ms": 428460,
      "text": "有点西餐味道"
    },
    {
      "ordinal": 159,
      "start_ms": 430500,
      "end_ms": 431940,
      "text": "就这个这个炒饭"
    },
    {
      "ordinal": 160,
      "start_ms": 432320,
      "end_ms": 433880,
      "text": "你别看那么一小坨"
    },
    {
      "ordinal": 161,
      "start_ms": 433880,
      "end_ms": 437420,
      "text": "我感觉就是吃一口下去要扎吧"
    },
    {
      "ordinal": 162,
      "start_ms": 437420,
      "end_ms": 438380,
      "text": "好久啊"
    },
    {
      "ordinal": 163,
      "start_ms": 451460,
      "end_ms": 454360,
      "text": "啊这个牛肉他用的是牛腱子肉啊"
    },
    {
      "ordinal": 164,
      "start_ms": 454360,
      "end_ms": 456960,
      "text": "他用的是牛腱腱子肉"
    },
    {
      "ordinal": 165,
      "start_ms": 458560,
      "end_ms": 464789,
      "text": "然后这个牛肉呢他们是给它煎到一分熟九"
    },
    {
      "ordinal": 166,
      "start_ms": 464789,
      "end_ms": 467380,
      "text": "然后但是你微波炉转一下"
    },
    {
      "ordinal": 167,
      "start_ms": 467380,
      "end_ms": 468520,
      "text": "它就全熟了"
    },
    {
      "ordinal": 168,
      "start_ms": 468520,
      "end_ms": 470440,
      "text": "我可能微波炉转的时间太久了"
    },
    {
      "ordinal": 169,
      "start_ms": 470440,
      "end_ms": 471940,
      "text": "微波炉转的时间太久了"
    },
    {
      "ordinal": 170,
      "start_ms": 471940,
      "end_ms": 474230,
      "text": "所以一点点饭我转了三分钟"
    },
    {
      "ordinal": 171,
      "start_ms": 474230,
      "end_ms": 476030,
      "text": "可能转两分钟就好了"
    },
    {
      "ordinal": 172,
      "start_ms": 476030,
      "end_ms": 477800,
      "text": "所以他就全都熟了"
    },
    {
      "ordinal": 173,
      "start_ms": 477800,
      "end_ms": 478760,
      "text": "全熟"
    },
    {
      "ordinal": 174,
      "start_ms": 499120,
      "end_ms": 501690,
      "text": "不是这个牛肉虽然被我弄柴了啊"
    },
    {
      "ordinal": 175,
      "start_ms": 501690,
      "end_ms": 505200,
      "text": "虽然被我就完全就是说微波炉给他转柴了"
    },
    {
      "ordinal": 176,
      "start_ms": 505200,
      "end_ms": 508180,
      "text": "但是他如果说不赚这么柴"
    },
    {
      "ordinal": 177,
      "start_ms": 508180,
      "end_ms": 509500,
      "text": "应该味道是不错的啊"
    },
    {
      "ordinal": 178,
      "start_ms": 510580,
      "end_ms": 513740,
      "text": "然后他那个"
    },
    {
      "ordinal": 179,
      "start_ms": 515380,
      "end_ms": 518010,
      "text": "肌腱呀也不是特别的"
    },
    {
      "ordinal": 180,
      "start_ms": 518010,
      "end_ms": 519059,
      "text": "就应该是蛮嫩的"
    },
    {
      "ordinal": 181,
      "start_ms": 519059,
      "end_ms": 519960,
      "text": "你知道吗"
    },
    {
      "ordinal": 182,
      "start_ms": 519960,
      "end_ms": 521400,
      "text": "还有个鸡腱"
    },
    {
      "ordinal": 183,
      "start_ms": 522419,
      "end_ms": 524420,
      "text": "而且他不是拼接牛肉啊"
    },
    {
      "ordinal": 184,
      "start_ms": 526960,
      "end_ms": 529020,
      "text": "吃得出来他不是拼接牛肉啊"
    },
    {
      "ordinal": 185,
      "start_ms": 529020,
      "end_ms": 529939,
      "text": "他是我们"
    },
    {
      "ordinal": 186,
      "start_ms": 531120,
      "end_ms": 533840,
      "text": "当然我不是由于成本考虑啊"
    },
    {
      "ordinal": 187,
      "start_ms": 534980,
      "end_ms": 536199,
      "text": "我用的是冻货"
    },
    {
      "ordinal": 188,
      "start_ms": 539340,
      "end_ms": 541190,
      "text": "成本考卷啊"
    },
    {
      "ordinal": 189,
      "start_ms": 541190,
      "end_ms": 541959,
      "text": "那个"
    },
    {
      "ordinal": 190,
      "start_ms": 544920,
      "end_ms": 546950,
      "text": "我们店里面卖的牛肉面"
    },
    {
      "ordinal": 191,
      "start_ms": 546950,
      "end_ms": 548680,
      "text": "牛肉也是用的送货"
    },
    {
      "ordinal": 192,
      "start_ms": 549060,
      "end_ms": 552420,
      "text": "但是好像是店里面牛肉面的那个牛肉"
    },
    {
      "ordinal": 193,
      "start_ms": 552420,
      "end_ms": 554700,
      "text": "用的是进口的冻货"
    },
    {
      "ordinal": 194,
      "start_ms": 554700,
      "end_ms": 560280,
      "text": "华莱在成本和口味之间达到一个折中啊"
    },
    {
      "ordinal": 195,
      "start_ms": 564020,
      "end_ms": 565120,
      "text": "就对我这种人"
    },
    {
      "ordinal": 196,
      "start_ms": 565120,
      "end_ms": 566680,
      "text": "我他妈的我吃什么"
    },
    {
      "ordinal": 197,
      "start_ms": 566680,
      "end_ms": 568900,
      "text": "四块钱拼多多那种牛排的"
    },
    {
      "ordinal": 198,
      "start_ms": 568900,
      "end_ms": 571280,
      "text": "那那个全都是卡拉胶拼出来的"
    },
    {
      "ordinal": 199,
      "start_ms": 571280,
      "end_ms": 574500,
      "text": "这个肉对我来说已经大大超出我的预料了"
    },
    {
      "ordinal": 200,
      "start_ms": 580120,
      "end_ms": 582720,
      "text": "就他的那个肌腱是很好咬断的"
    },
    {
      "ordinal": 201,
      "start_ms": 584340,
      "end_ms": 585540,
      "text": "很容易咬断"
    },
    {
      "ordinal": 202,
      "start_ms": 595940,
      "end_ms": 597079,
      "text": "whatever"
    },
    {
      "ordinal": 203,
      "start_ms": 606320,
      "end_ms": 608350,
      "text": "主要他是还这个炒饭比较好吃"
    },
    {
      "ordinal": 204,
      "start_ms": 608350,
      "end_ms": 610240,
      "text": "那个你们喜欢吃炒面的"
    },
    {
      "ordinal": 205,
      "start_ms": 610240,
      "end_ms": 611540,
      "text": "也可以定炒面啊"
    },
    {
      "ordinal": 206,
      "start_ms": 639680,
      "end_ms": 644140,
      "text": "不过我还是我还是推荐你订炒饭"
    },
    {
      "ordinal": 207,
      "start_ms": 644140,
      "end_ms": 645459,
      "text": "这个炒饭确实蛮好吃的"
    },
    {
      "ordinal": 208,
      "start_ms": 650520,
      "end_ms": 651980,
      "text": "和白米饭就差了多少钱啊"
    },
    {
      "ordinal": 209,
      "start_ms": 651980,
      "end_ms": 652839,
      "text": "我看一下"
    },
    {
      "ordinal": 210,
      "start_ms": 657140,
      "end_ms": 659690,
      "text": "百米还差了一块六毛钱啊"
    },
    {
      "ordinal": 211,
      "start_ms": 659690,
      "end_ms": 661000,
      "text": "我靠"
    },
    {
      "ordinal": 212,
      "start_ms": 668680,
      "end_ms": 670840,
      "text": "我们做成这么一个一份的话"
    },
    {
      "ordinal": 213,
      "start_ms": 670840,
      "end_ms": 676290,
      "text": "就是为了要那个它吃起来更方便啊"
    },
    {
      "ordinal": 214,
      "start_ms": 676290,
      "end_ms": 678990,
      "text": "只要有微波炉给他转一下啊"
    },
    {
      "ordinal": 215,
      "start_ms": 678990,
      "end_ms": 683380,
      "text": "你这个他说你是你是体力无产阶级"
    },
    {
      "ordinal": 216,
      "start_ms": 684720,
      "end_ms": 687500,
      "text": "你出租屋里面弄个弄个微波炉啊"
    },
    {
      "ordinal": 217,
      "start_ms": 687500,
      "end_ms": 689280,
      "text": "当然这个价格"
    },
    {
      "ordinal": 218,
      "start_ms": 692160,
      "end_ms": 693380,
      "text": "不是叫你天天吃"
    },
    {
      "ordinal": 219,
      "start_ms": 693380,
      "end_ms": 695579,
      "text": "对不对"
    },
    {
      "ordinal": 220,
      "start_ms": 704460,
      "end_ms": 705900,
      "text": "剩最后一块肉"
    },
    {
      "ordinal": 221,
      "start_ms": 713680,
      "end_ms": 717760,
      "text": "他刚煎出来的确实是这个样子的嗯"
    },
    {
      "ordinal": 222,
      "start_ms": 722800,
      "end_ms": 726820,
      "text": "他刚煎出来应该是没有煎几成熟"
    },
    {
      "ordinal": 223,
      "start_ms": 726820,
      "end_ms": 729000,
      "text": "中间这个红色的是他的那个"
    },
    {
      "ordinal": 224,
      "start_ms": 730880,
      "end_ms": 732240,
      "text": "血红蛋白"
    },
    {
      "ordinal": 225,
      "start_ms": 734400,
      "end_ms": 736080,
      "text": "不是它红色的oliver"
    },
    {
      "ordinal": 226,
      "start_ms": 736080,
      "end_ms": 736620,
      "text": "应该是他"
    },
    {
      "ordinal": 227,
      "start_ms": 736620,
      "end_ms": 740500,
      "text": "反正是里面的铁元素氧化显现出来的"
    },
    {
      "ordinal": 228,
      "start_ms": 740740,
      "end_ms": 743200,
      "text": "就刚煎出来最多最多"
    },
    {
      "ordinal": 229,
      "start_ms": 743200,
      "end_ms": 744920,
      "text": "这个牛排只煎到三分熟"
    },
    {
      "ordinal": 230,
      "start_ms": 747580,
      "end_ms": 752230,
      "text": "但是给你装袋的话就没办法"
    },
    {
      "ordinal": 231,
      "start_ms": 752230,
      "end_ms": 753760,
      "text": "装袋的话就没办法"
    },
    {
      "ordinal": 232,
      "start_ms": 753760,
      "end_ms": 754600,
      "text": "因为你再加热"
    },
    {
      "ordinal": 233,
      "start_ms": 754600,
      "end_ms": 758520,
      "text": "它肯定就相当于就相当于把它煎熟了"
    },
    {
      "ordinal": 234,
      "start_ms": 759180,
      "end_ms": 763300,
      "text": "肌红蛋白是肌红蛋白啊"
    },
    {
      "ordinal": 235,
      "start_ms": 763300,
      "end_ms": 765610,
      "text": "他也是一个没办法的啊"
    },
    {
      "ordinal": 236,
      "start_ms": 765610,
      "end_ms": 766680,
      "text": "没办法"
    },
    {
      "ordinal": 237,
      "start_ms": 768340,
      "end_ms": 772290,
      "text": "然后我们这个还是有点小辣的啊"
    },
    {
      "ordinal": 238,
      "start_ms": 772290,
      "end_ms": 773700,
      "text": "黑胡椒再怎么样"
    },
    {
      "ordinal": 239,
      "start_ms": 773700,
      "end_ms": 774680,
      "text": "他也是个胶"
    },
    {
      "ordinal": 240,
      "start_ms": 780620,
      "end_ms": 782200,
      "text": "这炒饭比较好吃"
    },
    {
      "ordinal": 241,
      "start_ms": 782200,
      "end_ms": 784040,
      "text": "他的炒饭比较好吃"
    },
    {
      "ordinal": 242,
      "start_ms": 786540,
      "end_ms": 788360,
      "text": "然后如果你买到的话"
    },
    {
      "ordinal": 243,
      "start_ms": 788360,
      "end_ms": 794200,
      "text": "我建议你先把他这个炒饭可以就单独拿出来吃"
    },
    {
      "ordinal": 244,
      "start_ms": 794200,
      "end_ms": 795640,
      "text": "因为它是分开来包装的"
    },
    {
      "ordinal": 245,
      "start_ms": 795640,
      "end_ms": 796660,
      "text": "牛排和炒饭"
    },
    {
      "ordinal": 246,
      "start_ms": 796660,
      "end_ms": 798300,
      "text": "炒饭是分开包装的"
    },
    {
      "ordinal": 247,
      "start_ms": 799860,
      "end_ms": 800540,
      "text": "为什么呢"
    },
    {
      "ordinal": 248,
      "start_ms": 800540,
      "end_ms": 802550,
      "text": "因为这个炒饭放久了的话"
    },
    {
      "ordinal": 249,
      "start_ms": 802550,
      "end_ms": 808620,
      "text": "它会和他那个这个米米粒啊就会被泡烂啊"
    },
    {
      "ordinal": 250,
      "start_ms": 808620,
      "end_ms": 809040,
      "text": "泡烂"
    },
    {
      "ordinal": 251,
      "start_ms": 809040,
      "end_ms": 811740,
      "text": "我这个是昨天的啊"
    },
    {
      "ordinal": 252,
      "start_ms": 811740,
      "end_ms": 814020,
      "text": "昨天的稍微有一点点烂"
    },
    {
      "ordinal": 253,
      "start_ms": 814020,
      "end_ms": 815400,
      "text": "稍微这个米有一点点烂"
    },
    {
      "ordinal": 254,
      "start_ms": 815400,
      "end_ms": 816760,
      "text": "但是味道是很好的"
    },
    {
      "ordinal": 255,
      "start_ms": 819380,
      "end_ms": 824020,
      "text": "然后你要吃的时候自己再煮煮饭吃啊"
    },
    {
      "ordinal": 256,
      "start_ms": 824020,
      "end_ms": 825020,
      "text": "搭配它"
    },
    {
      "ordinal": 257,
      "start_ms": 828080,
      "end_ms": 830890,
      "text": "或者说你可以试一下炒面啊"
    },
    {
      "ordinal": 258,
      "start_ms": 830890,
      "end_ms": 831580,
      "text": "我跟他说"
    },
    {
      "ordinal": 259,
      "start_ms": 831580,
      "end_ms": 832540,
      "text": "给我一份炒饭"
    },
    {
      "ordinal": 260,
      "start_ms": 832540,
      "end_ms": 833080,
      "text": "一份炒面"
    },
    {
      "ordinal": 261,
      "start_ms": 833080,
      "end_ms": 834380,
      "text": "他给我两份炒饭"
    },
    {
      "ordinal": 262,
      "start_ms": 834980,
      "end_ms": 835939,
      "text": "whatever"
    },
    {
      "ordinal": 263,
      "start_ms": 837340,
      "end_ms": 837780,
      "text": "对"
    },
    {
      "ordinal": 264,
      "start_ms": 837780,
      "end_ms": 838950,
      "text": "这个是纯手工做的"
    },
