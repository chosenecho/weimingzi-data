{
  "bvid": "BV17t4y1A7dW",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "4e62f249afbded4ee83ac034b74a5c6bdca4a3c6c0cec8204a73f019fcf63214",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 1000,
      "end_ms": 5440,
      "text": "哲学的实质其实就是激进资产阶级造反学"
    },
    {
      "ordinal": 1,
      "start_ms": 5440,
      "end_ms": 8890,
      "text": "他和这个封建贵族"
    },
    {
      "ordinal": 2,
      "start_ms": 8890,
      "end_ms": 13140,
      "text": "和这个宗教僧侣的神学体系"
    },
    {
      "ordinal": 3,
      "start_ms": 13140,
      "end_ms": 15600,
      "text": "他抢夺不了现实世界的定义权"
    },
    {
      "ordinal": 4,
      "start_ms": 15600,
      "end_ms": 17200,
      "text": "所以他迂回"
    },
    {
      "ordinal": 5,
      "start_ms": 17200,
      "end_ms": 18220,
      "text": "他绕过去"
    },
    {
      "ordinal": 6,
      "start_ms": 18220,
      "end_ms": 20680,
      "text": "直接说描述我从这个宇宙本源"
    },
    {
      "ordinal": 7,
      "start_ms": 20680,
      "end_ms": 23830,
      "text": "或者说整个不仅宇宙本源本何为本源"
    },
    {
      "ordinal": 8,
      "start_ms": 23830,
      "end_ms": 24730,
      "text": "和我宇宙"
    },
    {
      "ordinal": 9,
      "start_ms": 24730,
      "end_ms": 25480,
      "text": "什么叫时间"
    },
    {
      "ordinal": 10,
      "start_ms": 25480,
      "end_ms": 26470,
      "text": "什么叫空间"
    },
    {
      "ordinal": 11,
      "start_ms": 26470,
      "end_ms": 28090,
      "text": "包括为什么时间"
    },
    {
      "ordinal": 12,
      "start_ms": 28090,
      "end_ms": 31590,
      "text": "空间一定有一个主体来中介体验它"
    },
    {
      "ordinal": 13,
      "start_ms": 31590,
      "end_ms": 33060,
      "text": "它有没有至高主宰"
    },
    {
      "ordinal": 14,
      "start_ms": 33060,
      "end_ms": 34290,
      "text": "有没有第一主体"
    },
    {
      "ordinal": 15,
      "start_ms": 34290,
      "end_ms": 36699,
      "text": "绝对者在中介和体验它"
    },
    {
      "ordinal": 16,
      "start_ms": 36760,
      "end_ms": 38650,
      "text": "那么为什么会有死亡"
    },
    {
      "ordinal": 17,
      "start_ms": 38650,
      "end_ms": 40900,
      "text": "生存意识的断裂"
    },
    {
      "ordinal": 18,
      "start_ms": 40900,
      "end_ms": 43780,
      "text": "连续时间的时间内对性"
    },
    {
      "ordinal": 19,
      "start_ms": 43780,
      "end_ms": 44440,
      "text": "外在性"
    },
    {
      "ordinal": 20,
      "start_ms": 44440,
      "end_ms": 47260,
      "text": "还有包括个体的性化"
    },
    {
      "ordinal": 21,
      "start_ms": 47260,
      "end_ms": 50270,
      "text": "为什么会有会有一种会有一"
    },
    {
      "ordinal": 22,
      "start_ms": 50270,
      "end_ms": 53930,
      "text": "种性化的爱欲模式等等等等等等等等"
    },
    {
      "ordinal": 23,
      "start_ms": 53930,
      "end_ms": 56000,
      "text": "为什么会有回忆知识"
    },
    {
      "ordinal": 24,
      "start_ms": 56000,
      "end_ms": 58340,
      "text": "为什么会有这种痛苦"
    },
    {
      "ordinal": 25,
      "start_ms": 58340,
      "end_ms": 59779,
      "text": "为什么会有"
    },
    {
      "ordinal": 26,
      "start_ms": 61540,
      "end_ms": 63600,
      "text": "就是身体化"
    },
    {
      "ordinal": 27,
      "start_ms": 63600,
      "end_ms": 66720,
      "text": "主体间性等等等等等等等等等等"
    },
    {
      "ordinal": 28,
      "start_ms": 66720,
      "end_ms": 69330,
      "text": "哲学是绕一个大圈子啊"
    },
    {
      "ordinal": 29,
      "start_ms": 69330,
      "end_ms": 72100,
      "text": "激进的就是近代"
    },
    {
      "ordinal": 30,
      "start_ms": 74220,
      "end_ms": 75500,
      "text": "小朋友现在出去了"
    },
    {
      "ordinal": 31,
      "start_ms": 75500,
      "end_ms": 76670,
      "text": "我在做事情"
    },
    {
      "ordinal": 32,
      "start_ms": 76670,
      "end_ms": 81240,
      "text": "激进的一个近代的资产阶级的革命"
    },
    {
      "ordinal": 33,
      "start_ms": 84580,
      "end_ms": 87420,
      "text": "他就是通过哲学来迂回"
    },
    {
      "ordinal": 34,
      "start_ms": 87420,
      "end_ms": 91440,
      "text": "所以我说哲学的实质是是在野性"
    },
    {
      "ordinal": 35,
      "start_ms": 93000,
      "end_ms": 95870,
      "text": "他将自己伪造为"
    },
    {
      "ordinal": 36,
      "start_ms": 95870,
      "end_ms": 100270,
      "text": "或者说他就认为呃我资产阶级上台的时候"
    },
    {
      "ordinal": 37,
      "start_ms": 100270,
      "end_ms": 101830,
      "text": "我之后进行的统治"
    },
    {
      "ordinal": 38,
      "start_ms": 101830,
      "end_ms": 104140,
      "text": "就不是一个神权的直接统治了"
    },
    {
      "ordinal": 39,
      "start_ms": 104140,
      "end_ms": 105730,
      "text": "我永远我是统治者"
    },
    {
      "ordinal": 40,
      "start_ms": 105730,
      "end_ms": 108510,
      "text": "我永远是不直接把握政权的"
    },
    {
      "ordinal": 41,
      "start_ms": 108510,
      "end_ms": 110940,
      "text": "我是通过民意代表或者通过国家机器"
    },
    {
      "ordinal": 42,
      "start_ms": 110940,
      "end_ms": 112890,
      "text": "我作为作为他背后大老板"
    },
    {
      "ordinal": 43,
      "start_ms": 112890,
      "end_ms": 114190,
      "text": "我永远是在野的"
    },
    {
      "ordinal": 44,
      "start_ms": 114190,
      "end_ms": 115090,
      "text": "我就算统治"
    },
    {
      "ordinal": 45,
      "start_ms": 115090,
      "end_ms": 115750,
      "text": "我也是在野的"
    },
    {
      "ordinal": 46,
      "start_ms": 115750,
      "end_ms": 118259,
      "text": "所以我说哲学的实质是在野性"
    },
    {
      "ordinal": 47,
      "start_ms": 118980,
      "end_ms": 121400,
      "text": "资产阶级统治的实质是哲学"
    },
    {
      "ordinal": 48,
      "start_ms": 121400,
      "end_ms": 121880,
      "text": "统治"
    },
    {
      "ordinal": 49,
      "start_ms": 121880,
      "end_ms": 123200,
      "text": "是在野的统治"
    },
    {
      "ordinal": 50,
      "start_ms": 124060,
      "end_ms": 125280,
      "text": "在野的统治"
    },
    {
      "ordinal": 51,
      "start_ms": 125280,
      "end_ms": 126450,
      "text": "他就是个辩证法"
    },
    {
      "ordinal": 52,
      "start_ms": 126450,
      "end_ms": 127500,
      "text": "他是个辩证法"
    },
    {
      "ordinal": 53,
      "start_ms": 127500,
      "end_ms": 128400,
      "text": "懂了吧"
    },
    {
      "ordinal": 54,
      "start_ms": 131540,
      "end_ms": 132820,
      "text": "所以在这个意义上讲"
    },
    {
      "ordinal": 55,
      "start_ms": 132820,
      "end_ms": 135780,
      "text": "哲学它是一个大迂回大迂回"
    },
    {
      "ordinal": 56,
      "start_ms": 135780,
      "end_ms": 138600,
      "text": "但是呢由于它资产阶级的统治"
    },
    {
      "ordinal": 57,
      "start_ms": 138600,
      "end_ms": 141420,
      "text": "是以这种在野性作为他的统治"
    },
    {
      "ordinal": 58,
      "start_ms": 142059,
      "end_ms": 145979,
      "text": "它是统治本身的自我的一个阳气"
    },
    {
      "ordinal": 59,
      "start_ms": 145979,
      "end_ms": 147520,
      "text": "或者一个内在辩证"
    },
    {
      "ordinal": 60,
      "start_ms": 147520,
      "end_ms": 149200,
      "text": "所以我们作为社会主义者"
    },
    {
      "ordinal": 61,
      "start_ms": 149200,
      "end_ms": 150640,
      "text": "我们作为共产主义者"
    },
    {
      "ordinal": 62,
      "start_ms": 150640,
      "end_ms": 152980,
      "text": "我们要推翻资产阶级统治"
    },
    {
      "ordinal": 63,
      "start_ms": 152980,
      "end_ms": 155680,
      "text": "我们并不能够直接对统治下手"
    },
    {
      "ordinal": 64,
      "start_ms": 155680,
      "end_ms": 158350,
      "text": "我们要对他的在野状态下手"
    },
    {
      "ordinal": 65,
      "start_ms": 158350,
      "end_ms": 162940,
      "text": "他的在野状态的至高的这个自信反思"
    },
    {
      "ordinal": 66,
      "start_ms": 162940,
      "end_ms": 164959,
      "text": "就是通过哲学来实现的"
    },
    {
      "ordinal": 67,
      "start_ms": 164959,
      "end_ms": 166999,
      "text": "或者说资产阶级的统治"
    },
    {
      "ordinal": 68,
      "start_ms": 166999,
      "end_ms": 168799,
      "text": "或者说资产阶级的在野状态"
    },
    {
      "ordinal": 69,
      "start_ms": 168799,
      "end_ms": 171739,
      "text": "和他统治之间的一个过渡是如何实现的"
    },
    {
      "ordinal": 70,
      "start_ms": 171739,
      "end_ms": 173570,
      "text": "是通过哲学来终结的"
    },
    {
      "ordinal": 71,
      "start_ms": 173570,
      "end_ms": 173870,
      "text": "是"
    },
    {
      "ordinal": 72,
      "start_ms": 173870,
      "end_ms": 176960,
      "text": "用哲学而且是非常精致的"
    },
    {
      "ordinal": 73,
      "start_ms": 176960,
      "end_ms": 181859,
      "text": "这个法国后结构主义的哲学明白吗"
    },
    {
      "ordinal": 74,
      "start_ms": 181859,
      "end_ms": 184769,
      "text": "就是就是辩证法现象学啊"
    },
    {
      "ordinal": 75,
      "start_ms": 184769,
      "end_ms": 190150,
      "text": "绝对观念论都被吸收和和和和批判的一个"
    },
    {
      "ordinal": 76,
      "start_ms": 190150,
      "end_ms": 191770,
      "text": "法国后结构主义哲学"
    },
    {
      "ordinal": 77,
      "start_ms": 191770,
      "end_ms": 195100,
      "text": "包括海德格尔的生存论"
    },
    {
      "ordinal": 78,
      "start_ms": 195220,
      "end_ms": 199560,
      "text": "还有就是维吉克斯坦的语言哲学"
    },
    {
      "ordinal": 79,
      "start_ms": 199640,
      "end_ms": 200480,
      "text": "通通"
    },
    {
      "ordinal": 80,
      "start_ms": 200480,
      "end_ms": 201530,
      "text": "我觉得都"
    },
    {
      "ordinal": 81,
      "start_ms": 201530,
      "end_ms": 203720,
      "text": "它的最新版本"
    },
    {
      "ordinal": 82,
      "start_ms": 203720,
      "end_ms": 205850,
      "text": "应当是在法国后结构主义当中的"
    },
    {
      "ordinal": 83,
      "start_ms": 205850,
      "end_ms": 207840,
      "text": "然后法国后结构主义"
    },
    {
      "ordinal": 84,
      "start_ms": 207840,
      "end_ms": 210390,
      "text": "以及法国的这个民族性"
    },
    {
      "ordinal": 85,
      "start_ms": 210390,
      "end_ms": 213060,
      "text": "以及欧盟的这个跨民族性"
    },
    {
      "ordinal": 86,
      "start_ms": 213060,
      "end_ms": 218230,
      "text": "它是以及法国的这种半霸权性"
    },
    {
      "ordinal": 87,
      "start_ms": 218230,
      "end_ms": 221680,
      "text": "法国的文化和精神上的这种霸权性"
    },
    {
      "ordinal": 88,
      "start_ms": 221680,
      "end_ms": 225600,
      "text": "以及他在地缘政治和这个军事政治上的"
    },
    {
      "ordinal": 89,
      "start_ms": 225600,
      "end_ms": 228390,
      "text": "失败的仆从性"
    },
    {
      "ordinal": 90,
      "start_ms": 228390,
      "end_ms": 229620,
      "text": "这个东西都"
    },
    {
      "ordinal": 91,
      "start_ms": 229620,
      "end_ms": 231450,
      "text": "是我们近代的"
    },
    {
      "ordinal": 92,
      "start_ms": 231450,
      "end_ms": 235739,
      "text": "就是就是思想这样应该去考虑的"
    },
    {
      "ordinal": 93,
      "start_ms": 235739,
      "end_ms": 239829,
      "text": "美国我觉得反而不是特别需要去去在意的"
    },
    {
      "ordinal": 94,
      "start_ms": 239829,
      "end_ms": 241629,
      "text": "我们现在比较关注的是"
    },
    {
      "ordinal": 95,
      "start_ms": 241629,
      "end_ms": 243819,
      "text": "欧盟的自我拯救问题"
    },
    {
      "ordinal": 96,
      "start_ms": 243819,
      "end_ms": 246480,
      "text": "欧盟呢还法国的自我拯救问题"
    },
    {
      "ordinal": 97,
      "start_ms": 247219,
      "end_ms": 248919,
      "text": "在哲哲学上来讲的话"
    },
    {
      "ordinal": 98,
      "start_ms": 248919,
      "end_ms": 250359,
      "text": "分析哲学已经不值一提了"
    },
    {
      "ordinal": 99,
      "start_ms": 250359,
      "end_ms": 253299,
      "text": "因为他不直接涉及人类的命运和军政"
    },
    {
      "ordinal": 100,
      "start_ms": 253299,
      "end_ms": 254110,
      "text": "现实了"
    },
    {
      "ordinal": 101,
      "start_ms": 254110,
      "end_ms": 256600,
      "text": "议员政治现实都都不介入了"
    },
    {
      "ordinal": 102,
      "start_ms": 256600,
      "end_ms": 260899,
      "text": "更不要谈这资本主义和这个全球阶级斗争"
    },
    {
      "ordinal": 103,
      "start_ms": 260899,
      "end_ms": 262099,
      "text": "的这些态势问题"
    },
    {
      "ordinal": 104,
      "start_ms": 262099,
      "end_ms": 264860,
      "text": "但是法国人一直在关注那个"
    },
    {
      "ordinal": 105,
      "start_ms": 266560,
      "end_ms": 268140,
      "text": "我要说的就是说"
    },
    {
      "ordinal": 106,
      "start_ms": 268140,
      "end_ms": 272280,
      "text": "所以我们就算要反对资产阶级的统治"
    },
    {
      "ordinal": 107,
      "start_ms": 272280,
      "end_ms": 275210,
      "text": "反对资产阶级伪装为在野的统治"
    },
    {
      "ordinal": 108,
      "start_ms": 275210,
      "end_ms": 278300,
      "text": "反对哲学对于人类的统治"
    },
    {
      "ordinal": 109,
      "start_ms": 278300,
      "end_ms": 280640,
      "text": "我们也要从哲学本身来入手"
    },
    {
      "ordinal": 110,
      "start_ms": 280640,
      "end_ms": 283790,
      "text": "所以我说的哲学是资产阶级的造反学"
    },
    {
      "ordinal": 111,
      "start_ms": 283790,
      "end_ms": 284960,
      "text": "他是迂回的"
    },
    {
      "ordinal": 112,
      "start_ms": 284960,
      "end_ms": 287010,
      "text": "他为了为了推翻"
    },
    {
      "ordinal": 113,
      "start_ms": 287010,
      "end_ms": 289670,
      "text": "或者说他就是在辩证法上"
    },
    {
      "ordinal": 114,
      "start_ms": 289670,
      "end_ms": 292130,
      "text": "它代替了之前直接的神权统治"
    },
    {
      "ordinal": 115,
      "start_ms": 292130,
      "end_ms": 293630,
      "text": "但是我们需要直接的神权统治"
    },
    {
      "ordinal": 116,
      "start_ms": 293630,
      "end_ms": 294650,
      "text": "他永远也不是直接"
    },
    {
      "ordinal": 117,
      "start_ms": 294650,
      "end_ms": 296280,
      "text": "他永远也是间接的"
    },
    {
      "ordinal": 118,
      "start_ms": 296280,
      "end_ms": 300480,
      "text": "直觉得就是说之前的统治神权时代"
    },
    {
      "ordinal": 119,
      "start_ms": 300480,
      "end_ms": 304440,
      "text": "统治是代天牧民或者带神牧民"
    },
    {
      "ordinal": 120,
      "start_ms": 305199,
      "end_ms": 307079,
      "text": "他是个间接的直接性"
    },
    {
      "ordinal": 121,
      "start_ms": 307079,
      "end_ms": 310060,
      "text": "然后我们现在统治是一个在野的"
    },
    {
      "ordinal": 122,
      "start_ms": 310680,
      "end_ms": 312020,
      "text": "在野的统治性"
    },
    {
      "ordinal": 123,
      "start_ms": 312020,
      "end_ms": 312380,
      "text": "在野"
    },
    {
      "ordinal": 124,
      "start_ms": 312380,
      "end_ms": 313230,
      "text": "的介入性"
    },
    {
      "ordinal": 125,
      "start_ms": 313230,
      "end_ms": 314790,
      "text": "或者说在野的"
    },
    {
      "ordinal": 126,
      "start_ms": 314790,
      "end_ms": 316740,
      "text": "或者说一种直接的代表性质"
    },
    {
      "ordinal": 127,
      "start_ms": 316740,
      "end_ms": 317910,
      "text": "直接的间接性"
    },
    {
      "ordinal": 128,
      "start_ms": 317910,
      "end_ms": 318870,
      "text": "直接代表性"
    },
    {
      "ordinal": 129,
      "start_ms": 318870,
      "end_ms": 320740,
      "text": "但这是他的明代机制啊"
    },
    {
      "ordinal": 130,
      "start_ms": 320740,
      "end_ms": 321490,
      "text": "代一致嘛"
    },
    {
      "ordinal": 131,
      "start_ms": 321490,
      "end_ms": 323300,
      "text": "它是一个直接的代表性"
    },
    {
      "ordinal": 132,
      "start_ms": 326219,
      "end_ms": 328019,
      "text": "我们应当从这个角度"
    },
    {
      "ordinal": 133,
      "start_ms": 328019,
      "end_ms": 329459,
      "text": "从这种法哲学"
    },
    {
      "ordinal": 134,
      "start_ms": 329459,
      "end_ms": 330119,
      "text": "宪法学"
    },
    {
      "ordinal": 135,
      "start_ms": 330119,
      "end_ms": 330779,
      "text": "宪法哲学"
    },
    {
      "ordinal": 136,
      "start_ms": 330779,
      "end_ms": 331919,
      "text": "或者说这种政治哲学"
    },
    {
      "ordinal": 137,
      "start_ms": 331919,
      "end_ms": 334530,
      "text": "这些角度去把握这些问题"
    },
    {
      "ordinal": 138,
      "start_ms": 334530,
      "end_ms": 336270,
      "text": "所以你们理工科知识分子"
    },
    {
      "ordinal": 139,
      "start_ms": 336270,
      "end_ms": 337800,
      "text": "好像你们对人类的命运"
    },
    {
      "ordinal": 140,
      "start_ms": 337800,
      "end_ms": 339450,
      "text": "仅仅是把人类当成畜生"
    },
    {
      "ordinal": 141,
      "start_ms": 339450,
      "end_ms": 341000,
      "text": "或者说当成他妈的"
    },
    {
      "ordinal": 142,
      "start_ms": 342300,
      "end_ms": 345330,
      "text": "就是电子元器件那样去看待"
    },
    {
      "ordinal": 143,
      "start_ms": 345330,
      "end_ms": 347520,
      "text": "而不是把人类当成历史的主体"
    },
    {
      "ordinal": 144,
      "start_ms": 347520,
      "end_ms": 352690,
      "text": "或者说是就是每个个体都具有其余绝对性"
    },
    {
      "ordinal": 145,
      "start_ms": 352690,
      "end_ms": 356640,
      "text": "这样去来来来来思考人类命运"
    },
    {
      "ordinal": 146,
      "start_ms": 357060,
      "end_ms": 359040,
      "text": "我觉得你们对人是不尊重的"
    },
    {
      "ordinal": 147,
      "start_ms": 359040,
      "end_ms": 360330,
      "text": "是很鄙视人呢"
    },
    {
      "ordinal": 148,
      "start_ms": 360330,
      "end_ms": 363020,
      "text": "或者说你对你自己是很不尊重的"
    },
    {
      "ordinal": 149,
      "start_ms": 363280,
      "end_ms": 369169,
      "text": "就是完全没有在真正的现实的烈度和"
    },
    {
      "ordinal": 150,
      "start_ms": 369169,
      "end_ms": 373740,
      "text": "这个紧迫性和这个组织起来"
    },
    {
      "ordinal": 151,
      "start_ms": 373740,
      "end_ms": 377579,
      "text": "动员起来的那种呃"
    },
    {
      "ordinal": 152,
      "start_ms": 377579,
      "end_ms": 380279,
      "text": "自我激励的这种使命状态当中"
    },
    {
      "ordinal": 153,
      "start_ms": 380279,
      "end_ms": 381629,
      "text": "去思考这些问题"
    },
    {
      "ordinal": 154,
      "start_ms": 381629,
      "end_ms": 382859,
      "text": "你们是很无力的"
    },
    {
      "ordinal": 155,
      "start_ms": 382859,
      "end_ms": 384500,
      "text": "很很肺腑的一群人"
    },
    {
      "ordinal": 156,
      "start_ms": 384860,
      "end_ms": 387020,
      "text": "所以我我已经把话说清楚了"
    },
    {
      "ordinal": 157,
      "start_ms": 387020,
      "end_ms": 389339,
      "text": "就是哲学是曾经啊"
    },
    {
      "ordinal": 158,
      "start_ms": 389339,
      "end_ms": 392489,
      "text": "曾经他是激进的资产阶级的这个造反学"
    },
    {
      "ordinal": 159,
      "start_ms": 392489,
      "end_ms": 393749,
      "text": "后来他赢了"
    },
    {
      "ordinal": 160,
      "start_ms": 393749,
      "end_ms": 397460,
      "text": "所以哲学其实是他的激进资产阶级"
    },
    {
      "ordinal": 161,
      "start_ms": 397460,
      "end_ms": 398660,
      "text": "后来腐化堕落了"
    },
    {
      "ordinal": 162,
      "start_ms": 398660,
      "end_ms": 401000,
      "text": "变成这个反动的资产阶级"
    },
    {
      "ordinal": 163,
      "start_ms": 401000,
      "end_ms": 404530,
      "text": "对于整个现实的统治的一个伪装术"
    },
    {
      "ordinal": 164,
      "start_ms": 404530,
      "end_ms": 406870,
      "text": "或者说是他的再野性和统治"
    },
    {
      "ordinal": 165,
      "start_ms": 406870,
      "end_ms": 409030,
      "text": "之间的一个中介智信中介"
    },
    {
      "ordinal": 166,
      "start_ms": 409030,
      "end_ms": 410470,
      "text": "那么在现在这个时代"
    },
    {
      "ordinal": 167,
      "start_ms": 410470,
      "end_ms": 414190,
      "text": "作为共产主义和社会主义革命的工具"
    },
    {
      "ordinal": 168,
      "start_ms": 414190,
      "end_ms": 415450,
      "text": "哲学马克思主义"
    },
    {
      "ordinal": 169,
      "start_ms": 415450,
      "end_ms": 418170,
      "text": "哲学作为一种彻底的整个的"
    },
    {
      "ordinal": 170,
      "start_ms": 418170,
      "end_ms": 419850,
      "text": "反对资产阶级的哲学"
    },
    {
      "ordinal": 171,
      "start_ms": 419850,
      "end_ms": 421530,
      "text": "反对资产阶级作为"
    },
    {
      "ordinal": 172,
      "start_ms": 421530,
      "end_ms": 425240,
      "text": "在野和统治中介的那种哲学"
    },
    {
      "ordinal": 173,
      "start_ms": 426700,
      "end_ms": 429700,
      "text": "马克思主义哲学就是要击破这些"
    },
    {
      "ordinal": 174,
      "start_ms": 430039,
      "end_ms": 431839,
      "text": "标榜第一生活方式"
    },
    {
      "ordinal": 175,
      "start_ms": 431839,
      "end_ms": 434299,
      "text": "标榜最完美的自信中介方式"
    },
    {
      "ordinal": 176,
      "start_ms": 434299,
      "end_ms": 438720,
      "text": "标榜啊最整齐的一个呃逻辑学谱系"
    },
    {
      "ordinal": 177,
      "start_ms": 438720,
      "end_ms": 440400,
      "text": "这个逻辑学是黑格尔意义上逻辑"
    },
    {
      "ordinal": 178,
      "start_ms": 440400,
      "end_ms": 441360,
      "text": "逻辑学谱系"
    },
    {
      "ordinal": 179,
      "start_ms": 441360,
      "end_ms": 443340,
      "text": "这个谱系迁延到人类的社会"
    },
    {
      "ordinal": 180,
      "start_ms": 443340,
      "end_ms": 446010,
      "text": "生活和历史发展的所有环节"
    },
    {
      "ordinal": 181,
      "start_ms": 446010,
      "end_ms": 447870,
      "text": "他所预言的所有环节"
    },
    {
      "ordinal": 182,
      "start_ms": 447870,
      "end_ms": 450480,
      "text": "马克思主义哲学就是用来击破这些东西"
    },
    {
      "ordinal": 183,
      "start_ms": 450480,
      "end_ms": 453479,
      "text": "击破这些黑格尔式的"
    },
    {
      "ordinal": 184,
      "start_ms": 453479,
      "end_ms": 455219,
      "text": "或者说后黑格尔式的"
    },
    {
      "ordinal": 185,
      "start_ms": 455219,
      "end_ms": 456359,
      "text": "就是生存论"
    },
    {
      "ordinal": 186,
      "start_ms": 456359,
      "end_ms": 457559,
      "text": "后结构主义式的"
    },
    {
      "ordinal": 187,
      "start_ms": 457559,
      "end_ms": 461720,
      "text": "这些黑格尔是准黑格尔或"
    },
    {
      "ordinal": 188,
      "start_ms": 461720,
      "end_ms": 462530,
      "text": "者说"
    },
    {
      "ordinal": 189,
      "start_ms": 462530,
      "end_ms": 467450,
      "text": "或者说过于黑格尔式的这些谱系和环节"
    },
    {
      "ordinal": 190,
      "start_ms": 467450,
      "end_ms": 470600,
      "text": "这谱系学我觉得我觉得我觉得是这样的"
    },
    {
      "ordinal": 191,
      "start_ms": 470600,
      "end_ms": 471680,
      "text": "我觉得是这样的"
    },
    {
      "ordinal": 192,
      "start_ms": 471680,
      "end_ms": 474440,
      "text": "马思主哲学是一种反谱系学"
    },
    {
      "ordinal": 193,
      "start_ms": 474640,
      "end_ms": 481120,
      "text": "马克思主义是一种呃是对于哲学的哲学"
    },
    {
      "ordinal": 194,
      "start_ms": 481120,
      "end_ms": 482350,
      "text": "会意识形态化"
    },
    {
      "ordinal": 195,
      "start_ms": 482350,
      "end_ms": 485200,
      "text": "马克思主义哲学是一种去意识形态化的"
    },
    {
      "ordinal": 196,
      "start_ms": 485200,
      "end_ms": 486880,
      "text": "一种一种一种哲学"
    },
    {
      "ordinal": 197,
      "start_ms": 486880,
      "end_ms": 489289,
      "text": "所以马克思主义哲学是一个导向"
    },
    {
      "ordinal": 198,
      "start_ms": 489289,
      "end_ms": 494430,
      "text": "更进一步的政治经济学和革命军事"
    },
    {
      "ordinal": 199,
      "start_ms": 494430,
      "end_ms": 497670,
      "text": "嗯嗯呃"
    },
    {
      "ordinal": 200,
      "start_ms": 497670,
      "end_ms": 499900,
      "text": "理论的革命"
    },
    {
      "ordinal": 201,
      "start_ms": 499900,
      "end_ms": 503860,
      "text": "理论和军事理论的的一个预备性的科学"
    },
    {
      "ordinal": 202,
      "start_ms": 503860,
      "end_ms": 505810,
      "text": "哲学在这里的功能是预备性的"
    },
    {
      "ordinal": 203,
      "start_ms": 505810,
      "end_ms": 507340,
      "text": "这是我始终是一个观点"
    },
    {
      "ordinal": 204,
      "start_ms": 507340,
      "end_ms": 509230,
      "text": "马克思主义的哲学是预备性的"
    },
    {
      "ordinal": 205,
      "start_ms": 509230,
      "end_ms": 511300,
      "text": "但是你必须在掌"
    },
    {
      "ordinal": 206,
      "start_ms": 511300,
      "end_ms": 513000,
      "text": "握马克思与哲学之后"
    },
    {
      "ordinal": 207,
      "start_ms": 513480,
      "end_ms": 516990,
      "text": "也可以就就要吸收它的最先进的发展"
    },
    {
      "ordinal": 208,
      "start_ms": 516990,
      "end_ms": 520200,
      "text": "就比如说是后结构主义的这种意识"
    },
    {
      "ordinal": 209,
      "start_ms": 520200,
      "end_ms": 521890,
      "text": "在批判学啊"
    },
    {
      "ordinal": 210,
      "start_ms": 521890,
      "end_ms": 524500,
      "text": "以及阶级意识的分析分析学"
    },
    {
      "ordinal": 211,
      "start_ms": 524500,
      "end_ms": 528830,
      "text": "其实就是说对于拉康或者奇斯克这样的呃"
    },
    {
      "ordinal": 212,
      "start_ms": 528830,
      "end_ms": 529970,
      "text": "精神分析师啊"
    },
    {
      "ordinal": 213,
      "start_ms": 529970,
      "end_ms": 531080,
      "text": "精神分析学家"
    },
    {
      "ordinal": 214,
      "start_ms": 531080,
      "end_ms": 532730,
      "text": "他不算精神分析师"
    },
    {
      "ordinal": 215,
      "start_ms": 532730,
      "end_ms": 536700,
      "text": "他的从呃意识形态批判"
    },
    {
      "ordinal": 216,
      "start_ms": 536700,
      "end_ms": 539580,
      "text": "更进一步的阶级意识的直接批判当中"
    },
    {
      "ordinal": 217,
      "start_ms": 539580,
      "end_ms": 543810,
      "text": "要要吸取他们的这种分析批判的能力"
    },
    {
      "ordinal": 218,
      "start_ms": 543810,
      "end_ms": 547550,
      "text": "在这个意义上讲去获得一种新的"
    },
    {
      "ordinal": 219,
      "start_ms": 547550,
      "end_ms": 549080,
      "text": "我们这个时代的马克思主义的"
    },
    {
      "ordinal": 220,
      "start_ms": 549080,
      "end_ms": 551180,
      "text": "一种对阶级意识啊"
    },
    {
      "ordinal": 221,
      "start_ms": 551180,
      "end_ms": 553979,
      "text": "但更不用说意识形态的一种啊"
    },
    {
      "ordinal": 222,
      "start_ms": 554360,
      "end_ms": 555920,
      "text": "一种击破力"
    },
    {
      "ordinal": 223,
      "start_ms": 555920,
      "end_ms": 556610,
      "text": "批判力"
    },
    {
      "ordinal": 224,
      "start_ms": 556610,
      "end_ms": 557060,
      "text": "对"
    },
    {
      "ordinal": 225,
      "start_ms": 557060,
      "end_ms": 559040,
      "text": "包括也是还有"
    },
    {
      "ordinal": 226,
      "start_ms": 559040,
      "end_ms": 560360,
      "text": "一种发声力量"
    },
    {
      "ordinal": 227,
      "start_ms": 560360,
      "end_ms": 562490,
      "text": "你可以凝聚发生"
    },
    {
      "ordinal": 228,
      "start_ms": 562490,
      "end_ms": 567120,
      "text": "或者说引导新的阶级史的产生"
    },
    {
      "ordinal": 229,
      "start_ms": 568420,
      "end_ms": 569790,
      "text": "所以在这个意义上讲"
    },
    {
      "ordinal": 230,
      "start_ms": 569790,
      "end_ms": 571620,
      "text": "这个马克思哲学啊"
    },
    {
      "ordinal": 231,
      "start_ms": 571620,
      "end_ms": 574990,
      "text": "他在我们这个时代的一些新进的一些"
    },
    {
      "ordinal": 232,
      "start_ms": 574990,
      "end_ms": 577630,
      "text": "一些一些发展的一些运用"
    },
    {
      "ordinal": 233,
      "start_ms": 577630,
      "end_ms": 578920,
      "text": "我们要用好它"
    },
    {
      "ordinal": 234,
      "start_ms": 578920,
      "end_ms": 583490,
      "text": "并且为进一步的政治经济学和这个革命呃"
    },
    {
      "ordinal": 235,
      "start_ms": 583490,
      "end_ms": 587260,
      "text": "和军事斗争做好准备"
    },
    {
      "ordinal": 236,
      "start_ms": 587580,
      "end_ms": 588510,
      "text": "嗯对吧"
    },
    {
      "ordinal": 237,
      "start_ms": 588510,
      "end_ms": 589620,
      "text": "那么这些工作呢"
    },
    {
      "ordinal": 238,
      "start_ms": 589620,
      "end_ms": 594370,
      "text": "都不是一个一个已成为学术资产阶级"
    },
    {
      "ordinal": 239,
      "start_ms": 594370,
      "end_ms": 596560,
      "text": "或者说成为一个编制资产阶级"
    },
    {
      "ordinal": 240,
      "start_ms": 596560,
      "end_ms": 598780,
      "text": "或者成为一个文化资产阶级"
    },
    {
      "ordinal": 241,
      "start_ms": 598780,
      "end_ms": 601360,
      "text": "我成为反正成各式各样的一种小资产阶级"
    },
    {
      "ordinal": 242,
      "start_ms": 601360,
      "end_ms": 602980,
      "text": "的这种理工科学生"
    },
    {
      "ordinal": 243,
      "start_ms": 602980,
      "end_ms": 605830,
      "text": "理工科学者或者理工科的小知识分子"
    },
    {
      "ordinal": 244,
      "start_ms": 605830,
      "end_ms": 606640,
      "text": "他所可以"
    },
    {
      "ordinal": 245,
      "start_ms": 606640,
      "end_ms": 610940,
      "text": "领会的就是就是惠顾不知春秋"
    },
    {
      "ordinal": 246,
      "start_ms": 610940,
      "end_ms": 611510,
      "text": "你知道吗"
    },
    {
      "ordinal": 247,
      "start_ms": 611510,
      "end_ms": 614160,
      "text": "就是不足与夏虫与冰啊"
    },
    {
      "ordinal": 248,
      "start_ms": 614160,
      "end_ms": 616380,
      "text": "那么对这些个体呢"
    },
    {
      "ordinal": 249,
      "start_ms": 616380,
      "end_ms": 618860,
      "text": "我们的统一意见是"
    },
    {
      "ordinal": 250,
      "start_ms": 618860,
      "end_ms": 622610,
      "text": "把他们当成历史当中的脆弱的环节"
    },
    {
      "ordinal": 251,
      "start_ms": 622610,
      "end_ms": 627719,
      "text": "和偶尔偶然的偶然的这个中介来看待"
    },
    {
      "ordinal": 252,
      "start_ms": 627760,
      "end_ms": 629140,
      "text": "在这个意上下"
    },
    {
      "ordinal": 253,
      "start_ms": 629140,
      "end_ms": 631840,
      "text": "他们的存在没有必然性"
    },
    {
      "ordinal": 254,
      "start_ms": 631840,
      "end_ms": 633430,
      "text": "他们的反对"
    },
    {
      "ordinal": 255,
      "start_ms": 633430,
      "end_ms": 637300,
      "text": "以及他们的对于历史运动方向的反动"
    },
    {
      "ordinal": 256,
      "start_ms": 637520,
      "end_ms": 640910,
      "text": "都是嗯柔弱的"
    },
    {
      "ordinal": 257,
      "start_ms": 640910,
      "end_ms": 643080,
      "text": "都是滑稽可笑的"
    },
    {
      "ordinal": 258,
      "start_ms": 643080,
      "end_ms": 644820,
      "text": "我们大致是持这种观点"
    },
    {
      "ordinal": 259,
      "start_ms": 644820,
      "end_ms": 645600,
      "text": "我不在乎"
    },
    {
      "ordinal": 260,
      "start_ms": 645600,
      "end_ms": 647190,
      "text": "we don't care much about it"
    },
    {
      "ordinal": 261,
      "start_ms": 647190,
      "end_ms": 649860,
      "text": "但并不意味着我们抛弃科学和技术"
    },
    {
      "ordinal": 262,
      "start_ms": 649860,
      "end_ms": 652090,
      "text": "它的他的力量不是"
    },
    {
      "ordinal": 263,
      "start_ms": 652090,
      "end_ms": 654160,
      "text": "我们要转向政治和军事的"
    },
    {
      "ordinal": 264,
      "start_ms": 654160,
      "end_ms": 655510,
      "text": "这个现实的斗争啊"
    },
    {
      "ordinal": 265,
      "start_ms": 655510,
      "end_ms": 659860,
      "text": "所以说嗯后面这些环节也是非常"
    },
    {
      "ordinal": 266,
      "start_ms": 659860,
      "end_ms": 664019,
      "text": "的就是说你肯定要利用到这些科学工具"
    },
    {
      "ordinal": 267,
      "start_ms": 664019,
      "end_ms": 665249,
      "text": "技术工具"
    },
    {
      "ordinal": 268,
      "start_ms": 665249,
      "end_ms": 669840,
      "text": "但是不代表you by the story behind"
    },
    {
      "ordinal": 269,
      "start_ms": 669840,
      "end_ms": 673760,
      "text": "你不代表你要去接受他背后的科学"
    },
    {
      "ordinal": 270,
      "start_ms": 673760,
      "end_ms": 674720,
      "text": "实在论的故事"
    },
    {
      "ordinal": 271,
      "start_ms": 674720,
      "end_ms": 676940,
      "text": "他背后的一些什么机械性的"
    },
    {
      "ordinal": 272,
      "start_ms": 676940,
      "end_ms": 678320,
      "text": "唯物主义的一些故事"
    },
    {
      "ordinal": 273,
      "start_ms": 678320,
      "end_ms": 682180,
      "text": "或者他背后的建构论或操作主义呃"
    },
    {
      "ordinal": 274,
      "start_ms": 682180,
      "end_ms": 684340,
      "text": "或者说行为主义的这些这些故事"
    },
    {
      "ordinal": 275,
      "start_ms": 684340,
      "end_ms": 686170,
      "text": "这些意识形态统统不买账"
    },
    {
      "ordinal": 276,
      "start_ms": 686170,
      "end_ms": 690459,
      "text": "统统都我们我们有我们自己的本体论来"
    },
    {
      "ordinal": 277,
      "start_ms": 690640,
      "end_ms": 692380,
      "text": "就是你去看我那期视频"
    },
    {
      "ordinal": 278,
      "start_ms": 692380,
      "end_ms": 693850,
      "text": "叫做叫成为历史的一部分"
    },
    {
      "ordinal": 279,
      "start_ms": 693850,
      "end_ms": 698260,
      "text": "里面有讲到如何去把握到本体论架构"
    },
    {
      "ordinal": 280,
      "start_ms": 698260,
      "end_ms": 701410,
      "text": "它的啊暂时的稳定性嗯"
    },
    {
      "ordinal": 281,
      "start_ms": 701410,
      "end_ms": 703380,
      "text": "它有相对的一个稳定性"
    },
    {
      "ordinal": 282,
      "start_ms": 703380,
      "end_ms": 706080,
      "text": "以及事件和常态运营状态之间"
    },
    {
      "ordinal": 283,
      "start_ms": 706080,
      "end_ms": 707580,
      "text": "的辩证关系"
    },
    {
      "ordinal": 284,
      "start_ms": 707580,
      "end_ms": 709500,
      "text": "我们可以通过我们自己的辩证法"
    },
    {
      "ordinal": 285,
      "start_ms": 709500,
      "end_ms": 712920,
      "text": "通过我们自己的本体论哈"
    },
    {
      "ordinal": 286,
      "start_ms": 712920,
      "end_ms": 716520,
      "text": "或者历史哲学来来理解这个世界"
    },
    {
      "ordinal": 287,
      "start_ms": 716520,
      "end_ms": 718740,
      "text": "并且在能够合法的运用"
    },
    {
      "ordinal": 288,
      "start_ms": 719500,
      "end_ms": 722580,
      "text": "合法运用这些科学技术工具"
    },
    {
      "ordinal": 289,
      "start_ms": 722580,
      "end_ms": 725430,
      "text": "但对这这部分而懦弱的"
    },
    {
      "ordinal": 290,
      "start_ms": 725430,
      "end_ms": 728010,
      "text": "渺小的无知的这些理工科知识分子呢"
    },
    {
      "ordinal": 291,
      "start_ms": 728010,
      "end_ms": 729990,
      "text": "我们完全是把它当成是工具"
    },
    {
      "ordinal": 292,
      "start_ms": 729990,
      "end_ms": 733180,
      "text": "或者说当成是一些温和的陌路人来对待"
    },
    {
      "ordinal": 293,
      "start_ms": 733180,
      "end_ms": 734350,
      "text": "温和的陌路人"
    },
    {
      "ordinal": 294,
      "start_ms": 734350,
      "end_ms": 736859,
      "text": "他们是无知无用的温和陌路人"
    },
    {
      "ordinal": 295,
      "start_ms": 737140,
      "end_ms": 738340,
      "text": "他这无知无用"
    },
    {
      "ordinal": 296,
      "start_ms": 738340,
      "end_ms": 740319,
      "text": "不是说他对于这个"
    },
    {
      "ordinal": 297,
      "start_ms": 741980,
      "end_ms": 747180,
      "text": "就是就是具体的工程呢后勤啊无知无用"
    },
    {
      "ordinal": 298,
      "start_ms": 747180,
      "end_ms": 750150,
      "text": "他们他们他们对在这部分很有用"
    },
    {
      "ordinal": 299,
      "start_ms": 750150,
      "end_ms": 753060,
      "text": "其子嘛要说它对于真正的历史运行"
    },
    {
      "ordinal": 300,
      "start_ms": 753060,
      "end_ms": 756600,
      "text": "对于真正的这个嗯事件发起"
    },
    {
      "ordinal": 301,
      "start_ms": 756600,
      "end_ms": 757680,
      "text": "他是无知无用的"
    },
    {
      "ordinal": 302,
      "start_ms": 757680,
      "end_ms": 758040,
      "text": "嗯"
    },
    {
      "ordinal": 303,
      "start_ms": 758040,
      "end_ms": 759720,
      "text": "我们原则上不信任他们"
    },
    {
      "ordinal": 304,
      "start_ms": 759720,
      "end_ms": 761470,
      "text": "原则上也不啊"
    },
    {
      "ordinal": 305,
      "start_ms": 761470,
      "end_ms": 762970,
      "text": "把他们看成同路人"
    },
    {
      "ordinal": 306,
      "start_ms": 762970,
      "end_ms": 765880,
      "text": "仅仅是把他们当作工具来利用"
    },
    {
      "ordinal": 307,
      "start_ms": 765880,
      "end_ms": 767839,
      "text": "就这么的这么一个关系"
    },
    {
      "ordinal": 308,
      "start_ms": 768120,
      "end_ms": 770640,
      "text": "这个是要因为他们始终抱有幻想"
    },
    {
      "ordinal": 309,
      "start_ms": 770640,
      "end_ms": 772800,
      "text": "是抱着他们的那一小撮知识"
    },
    {
      "ordinal": 310,
      "start_ms": 772800,
      "end_ms": 775530,
      "text": "可以被资产阶级社会啊"
    },
    {
      "ordinal": 311,
      "start_ms": 775530,
      "end_ms": 778140,
      "text": "这个就是贿赂啊"
    },
    {
      "ordinal": 312,
      "start_ms": 778140,
      "end_ms": 778440,
      "text": "啊"
    },
    {
      "ordinal": 313,
      "start_ms": 778440,
      "end_ms": 780210,
      "text": "我说买去他们的人格"
    },
    {
      "ordinal": 314,
      "start_ms": 780210,
      "end_ms": 782460,
      "text": "和他们的这个理想的纯洁性"
    },
    {
      "ordinal": 315,
      "start_ms": 782460,
      "end_ms": 785870,
      "text": "他们随时随地准备背叛这个共产主义理想"
    },
    {
      "ordinal": 316,
      "start_ms": 785870,
      "end_ms": 786350,
      "text": "他们有小"
    },
    {
      "ordinal": 317,
      "start_ms": 786350,
      "end_ms": 787760,
      "text": "资产些投机性啊"
    },
    {
      "ordinal": 318,
      "start_ms": 787760,
      "end_ms": 788930,
      "text": "所以他们是动摇的"
    },
    {
      "ordinal": 319,
      "start_ms": 788930,
      "end_ms": 791000,
      "text": "摇摆的不可靠的啊"
    },
    {
      "ordinal": 320,
      "start_ms": 791000,
      "end_ms": 793250,
      "text": "完全把它们当工具来用就可以了"
    },
    {
      "ordinal": 321,
      "start_ms": 793250,
      "end_ms": 794360,
      "text": "那就讲到这边"
    }
