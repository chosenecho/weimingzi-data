{
  "bvid": "BV1q4nszeEXH",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "fdd6fe3a2cb74c337454731f0b2b8e4eda398967e4329c71575156f95378bff6",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 300,
      "end_ms": 620,
      "text": "呃"
    },
    {
      "ordinal": 1,
      "start_ms": 4340,
      "end_ms": 6300,
      "text": "抵近观察"
    },
    {
      "ordinal": 2,
      "start_ms": 8880,
      "end_ms": 11040,
      "text": "啊这个字越写越丑"
    },
    {
      "ordinal": 3,
      "start_ms": 11040,
      "end_ms": 12580,
      "text": "因为刚刚拍了个视频"
    },
    {
      "ordinal": 4,
      "start_ms": 12580,
      "end_ms": 17340,
      "text": "就是说对我们抵近观察额"
    },
    {
      "ordinal": 5,
      "start_ms": 21260,
      "end_ms": 22700,
      "text": "一定会露马脚"
    },
    {
      "ordinal": 6,
      "start_ms": 22700,
      "end_ms": 23780,
      "text": "就是说漏什么马脚"
    },
    {
      "ordinal": 7,
      "start_ms": 23780,
      "end_ms": 32590,
      "text": "就是我们是啊忠贞终身有利啊"
    },
    {
      "ordinal": 8,
      "start_ms": 32590,
      "end_ms": 36260,
      "text": "然后是这个团结的"
    },
    {
      "ordinal": 9,
      "start_ms": 38620,
      "end_ms": 40460,
      "text": "马脚嘛啊"
    },
    {
      "ordinal": 10,
      "start_ms": 42620,
      "end_ms": 45010,
      "text": "得得得抵近观察"
    },
    {
      "ordinal": 11,
      "start_ms": 45010,
      "end_ms": 46330,
      "text": "因为一定会发生这点"
    },
    {
      "ordinal": 12,
      "start_ms": 46330,
      "end_ms": 49599,
      "text": "我们其实挺害怕他妈有识之士来抵近观察的"
    },
    {
      "ordinal": 13,
      "start_ms": 49599,
      "end_ms": 51039,
      "text": "挺怕的那种"
    },
    {
      "ordinal": 14,
      "start_ms": 51039,
      "end_ms": 52199,
      "text": "我们说穿了"
    },
    {
      "ordinal": 15,
      "start_ms": 52199,
      "end_ms": 58390,
      "text": "我们是挺怕这个有识之士抵近观察的"
    },
    {
      "ordinal": 16,
      "start_ms": 60380,
      "end_ms": 64780,
      "text": "但是因为我是一个识时务的"
    },
    {
      "ordinal": 17,
      "start_ms": 65349,
      "end_ms": 68110,
      "text": "识时务者为俊杰嘛"
    },
    {
      "ordinal": 18,
      "start_ms": 68720,
      "end_ms": 70500,
      "text": "反正我只是想做俊杰嘛"
    },
    {
      "ordinal": 19,
      "start_ms": 70500,
      "end_ms": 73980,
      "text": "啊我是个识时务的俊杰啊"
    },
    {
      "ordinal": 20,
      "start_ms": 73980,
      "end_ms": 75580,
      "text": "所以"
    },
    {
      "ordinal": 21,
      "start_ms": 78280,
      "end_ms": 80120,
      "text": "就我挺怕"
    },
    {
      "ordinal": 22,
      "start_ms": 80120,
      "end_ms": 81440,
      "text": "但是我又不用怕啊"
    },
    {
      "ordinal": 23,
      "start_ms": 81440,
      "end_ms": 82960,
      "text": "又不是特别用怕"
    },
    {
      "ordinal": 24,
      "start_ms": 82960,
      "end_ms": 85240,
      "text": "不用怕"
    },
    {
      "ordinal": 25,
      "start_ms": 96240,
      "end_ms": 101720,
      "text": "过程中其实就是说来的人我们不介意"
    },
    {
      "ordinal": 26,
      "start_ms": 101720,
      "end_ms": 104620,
      "text": "不介意我们我们不欢迎"
    },
    {
      "ordinal": 27,
      "start_ms": 104620,
      "end_ms": 107900,
      "text": "不欢迎什么别有用心的人"
    },
    {
      "ordinal": 28,
      "start_ms": 110220,
      "end_ms": 111260,
      "text": "别有用心的"
    },
    {
      "ordinal": 29,
      "start_ms": 111260,
      "end_ms": 113280,
      "text": "尤其不欢迎啊"
    },
    {
      "ordinal": 30,
      "start_ms": 113280,
      "end_ms": 116930,
      "text": "尤其不欢迎过来蹭位气啊"
    },
    {
      "ordinal": 31,
      "start_ms": 117370,
      "end_ms": 118450,
      "text": "蹭卫企"
    },
    {
      "ordinal": 32,
      "start_ms": 121130,
      "end_ms": 123130,
      "text": "造宣称呢"
    },
    {
      "ordinal": 33,
      "start_ms": 124669,
      "end_ms": 126869,
      "text": "我只跟你聊了几句天而已"
    },
    {
      "ordinal": 34,
      "start_ms": 126869,
      "end_ms": 129949,
      "text": "回去好像是得到了不得了的任命授权了"
    },
    {
      "ordinal": 35,
      "start_ms": 129949,
      "end_ms": 133270,
      "text": "我操蹭位去造这个宣称的这些人呢"
    },
    {
      "ordinal": 36,
      "start_ms": 133270,
      "end_ms": 137369,
      "text": "就是说干这种事一定是要处置的啊"
    },
    {
      "ordinal": 37,
      "start_ms": 137369,
      "end_ms": 139629,
      "text": "一定这个你等着被处置吧"
    },
    {
      "ordinal": 38,
      "start_ms": 139629,
      "end_ms": 141229,
      "text": "一定会处置"
    },
    {
      "ordinal": 39,
      "start_ms": 142410,
      "end_ms": 143010,
      "text": "妈呀"
    },
    {
      "ordinal": 40,
      "start_ms": 143010,
      "end_ms": 144730,
      "text": "你在搞笑吗"
    },
    {
      "ordinal": 41,
      "start_ms": 144730,
      "end_ms": 145330,
      "text": "啊"
    },
    {
      "ordinal": 42,
      "start_ms": 145330,
      "end_ms": 146530,
      "text": "有好多这种人"
    },
    {
      "ordinal": 43,
      "start_ms": 146530,
      "end_ms": 147650,
      "text": "他会蹭位置"
    },
    {
      "ordinal": 44,
      "start_ms": 147650,
      "end_ms": 151990,
      "text": "人造宣称下去之后瞎逼指挥啊"
    },
    {
      "ordinal": 45,
      "start_ms": 151990,
      "end_ms": 153955,
      "text": "瞎逼去这样"
    },
    {
      "ordinal": 46,
      "start_ms": 158520,
      "end_ms": 159760,
      "text": "怎么一定会处置啊"
    },
    {
      "ordinal": 47,
      "start_ms": 159760,
      "end_ms": 161560,
      "text": "一定会处置"
    },
    {
      "ordinal": 48,
      "start_ms": 161560,
      "end_ms": 162460,
      "text": "别有用心"
    },
    {
      "ordinal": 49,
      "start_ms": 162460,
      "end_ms": 164240,
      "text": "还有另外一种别有用心是什么"
    },
    {
      "ordinal": 50,
      "start_ms": 164240,
      "end_ms": 166680,
      "text": "这是一一类别有用心的"
    },
    {
      "ordinal": 51,
      "start_ms": 166680,
      "end_ms": 169710,
      "text": "另第二类别有用心的是呃"
    },
    {
      "ordinal": 52,
      "start_ms": 169710,
      "end_ms": 172690,
      "text": "过来他是不是蹭位吃的"
    },
    {
      "ordinal": 53,
      "start_ms": 172690,
      "end_ms": 174330,
      "text": "他是过来占便宜的"
    },
    {
      "ordinal": 54,
      "start_ms": 174330,
      "end_ms": 175650,
      "text": "占便宜"
    },
    {
      "ordinal": 55,
      "start_ms": 177140,
      "end_ms": 178420,
      "text": "啊占便宜"
    },
    {
      "ordinal": 56,
      "start_ms": 178420,
      "end_ms": 180900,
      "text": "还有一个是什么装高尚啊"
    },
    {
      "ordinal": 57,
      "start_ms": 182400,
      "end_ms": 184400,
      "text": "他占这个便宜"
    },
    {
      "ordinal": 58,
      "start_ms": 184400,
      "end_ms": 185360,
      "text": "占这个便宜"
    },
    {
      "ordinal": 59,
      "start_ms": 186360,
      "end_ms": 188430,
      "text": "因为很生活很廉价"
    },
    {
      "ordinal": 60,
      "start_ms": 188430,
      "end_ms": 190390,
      "text": "我怎样的要装高尚装"
    },
    {
      "ordinal": 61,
      "start_ms": 190390,
      "end_ms": 191270,
      "text": "为什么装高尚"
    },
    {
      "ordinal": 62,
      "start_ms": 191270,
      "end_ms": 193930,
      "text": "因为在这边其实是很不对等的啊"
    },
    {
      "ordinal": 63,
      "start_ms": 193930,
      "end_ms": 197210,
      "text": "他只要做一些就是成本代价很低的"
    },
    {
      "ordinal": 64,
      "start_ms": 197210,
      "end_ms": 205230,
      "text": "成本代价极低的所谓的志愿服务啊"
    },
    {
      "ordinal": 65,
      "start_ms": 205830,
      "end_ms": 207750,
      "text": "成本代价很低哦"
    },
    {
      "ordinal": 66,
      "start_ms": 207750,
      "end_ms": 211390,
      "text": "所以这就是糊弄鬼的表表态的"
    },
    {
      "ordinal": 67,
      "start_ms": 211390,
      "end_ms": 213070,
      "text": "假模假样表态的这些东西"
    },
    {
      "ordinal": 68,
      "start_ms": 213070,
      "end_ms": 214935,
      "text": "他就可以一直占便宜"
    },
    {
      "ordinal": 69,
      "start_ms": 215070,
      "end_ms": 216670,
      "text": "有几个这种货了"
    },
    {
      "ordinal": 70,
      "start_ms": 218270,
      "end_ms": 221980,
      "text": "我有机会有机会把他把他清了啊"
    },
    {
      "ordinal": 71,
      "start_ms": 221980,
      "end_ms": 223600,
      "text": "这个是"
    },
    {
      "ordinal": 72,
      "start_ms": 225460,
      "end_ms": 226620,
      "text": "我不只是先发"
    },
    {
      "ordinal": 73,
      "start_ms": 226620,
      "end_ms": 227940,
      "text": "直接现在发个短信啊"
    },
    {
      "ordinal": 74,
      "start_ms": 227940,
      "end_ms": 230740,
      "text": "就是测算一下"
    },
    {
      "ordinal": 75,
      "start_ms": 234220,
      "end_ms": 237260,
      "text": "所谓志愿活动"
    },
    {
      "ordinal": 76,
      "start_ms": 238300,
      "end_ms": 240060,
      "text": "不同种类"
    },
    {
      "ordinal": 77,
      "start_ms": 241480,
      "end_ms": 246760,
      "text": "之间的强度和时长差异"
    },
    {
      "ordinal": 78,
      "start_ms": 250660,
      "end_ms": 251660,
      "text": "一些人"
    },
    {
      "ordinal": 79,
      "start_ms": 254860,
      "end_ms": 260389,
      "text": "其实利用这里面的客观差别"
    },
    {
      "ordinal": 80,
      "start_ms": 261509,
      "end_ms": 267000,
      "text": "显得自己很积极奉献"
    },
    {
      "ordinal": 81,
      "start_ms": 269160,
      "end_ms": 272520,
      "text": "然后占便宜摆明了占便宜啊"
    },
    {
      "ordinal": 82,
      "start_ms": 272520,
      "end_ms": 275900,
      "text": "摆明了占便宜的"
    },
    {
      "ordinal": 83,
      "start_ms": 276580,
      "end_ms": 287110,
      "text": "要主动撤销他们的大便车资格"
    },
    {
      "ordinal": 84,
      "start_ms": 291520,
      "end_ms": 293880,
      "text": "弄个十几个出来"
    },
    {
      "ordinal": 85,
      "start_ms": 295080,
      "end_ms": 298740,
      "text": "啊咳咳咳"
    },
    {
      "ordinal": 86,
      "start_ms": 301620,
      "end_ms": 303900,
      "text": "酌情不续签啊"
    },
    {
      "ordinal": 87,
      "start_ms": 305740,
      "end_ms": 308980,
      "text": "就这这货这些装高尚"
    },
    {
      "ordinal": 88,
      "start_ms": 308980,
      "end_ms": 310660,
      "text": "他有个特点"
    },
    {
      "ordinal": 89,
      "start_ms": 310660,
      "end_ms": 313070,
      "text": "一旦抓住你的马脚把柄"
    },
    {
      "ordinal": 90,
      "start_ms": 313070,
      "end_ms": 314710,
      "text": "说你马脚"
    },
    {
      "ordinal": 91,
      "start_ms": 314710,
      "end_ms": 316270,
      "text": "马克思主义者讲政治"
    },
    {
      "ordinal": 92,
      "start_ms": 316270,
      "end_ms": 316950,
      "text": "经济学的"
    },
    {
      "ordinal": 93,
      "start_ms": 316950,
      "end_ms": 318030,
      "text": "不讲你妈什么道德"
    },
    {
      "ordinal": 94,
      "start_ms": 318030,
      "end_ms": 318920,
      "text": "人道主义的"
    },
    {
      "ordinal": 95,
      "start_ms": 318920,
      "end_ms": 320400,
      "text": "他抓住人麻将了啊"
    },
    {
      "ordinal": 96,
      "start_ms": 320400,
      "end_ms": 321160,
      "text": "你这个不人道"
    },
    {
      "ordinal": 97,
      "start_ms": 321160,
      "end_ms": 321860,
      "text": "这个不道德"
    },
    {
      "ordinal": 98,
      "start_ms": 321860,
      "end_ms": 322520,
      "text": "这个不够"
    },
    {
      "ordinal": 99,
      "start_ms": 322520,
      "end_ms": 324280,
      "text": "是市民阶级高尚道德"
    },
    {
      "ordinal": 100,
      "start_ms": 324280,
      "end_ms": 325440,
      "text": "是这样"
    },
    {
      "ordinal": 101,
      "start_ms": 325440,
      "end_ms": 328799,
      "text": "他就要反咬一口啊"
    },
    {
      "ordinal": 102,
      "start_ms": 328799,
      "end_ms": 330599,
      "text": "这种货都是这样的"
    },
    {
      "ordinal": 103,
      "start_ms": 330599,
      "end_ms": 331879,
      "text": "他其实用小字"
    },
    {
      "ordinal": 104,
      "start_ms": 331879,
      "end_ms": 333459,
      "text": "你道德啊"
    },
    {
      "ordinal": 105,
      "start_ms": 333459,
      "end_ms": 336879,
      "text": "无私奉献来做他妈的价值制高点"
    },
    {
      "ordinal": 106,
      "start_ms": 336879,
      "end_ms": 338600,
      "text": "道德制高点来"
    },
    {
      "ordinal": 107,
      "start_ms": 338600,
      "end_ms": 341680,
      "text": "心里面觉得他在占便宜来给自己做辩护"
    },
    {
      "ordinal": 108,
      "start_ms": 341680,
      "end_ms": 342760,
      "text": "我比你们更道德"
    },
    {
      "ordinal": 109,
      "start_ms": 342760,
      "end_ms": 344120,
      "text": "所以又可以占更多便宜"
    },
    {
      "ordinal": 110,
      "start_ms": 345240,
      "end_ms": 349940,
      "text": "这货哦他只讲那种浅显的啊"
    },
    {
      "ordinal": 111,
      "start_ms": 349940,
      "end_ms": 353180,
      "text": "那种功利道德主义"
    },
    {
      "ordinal": 112,
      "start_ms": 353180,
      "end_ms": 355330,
      "text": "功利主义上的互助"
    },
    {
      "ordinal": 113,
      "start_ms": 355610,
      "end_ms": 358070,
      "text": "而不讲那种更彻底的啊"
    },
    {
      "ordinal": 114,
      "start_ms": 358070,
      "end_ms": 359230,
      "text": "更坚定的"
    },
    {
      "ordinal": 115,
      "start_ms": 359230,
      "end_ms": 363490,
      "text": "更体系化的深刻的互保啊"
    },
    {
      "ordinal": 116,
      "start_ms": 363490,
      "end_ms": 368400,
      "text": "这些货好几个老子名字都能点出来"
    },
    {
      "ordinal": 117,
      "start_ms": 368680,
      "end_ms": 371120,
      "text": "那也是不会留他们过过年的啊"
    },
    {
      "ordinal": 118,
      "start_ms": 372440,
      "end_ms": 373480,
      "text": "甚至留他们过节"
    },
    {
      "ordinal": 119,
      "start_ms": 373480,
      "end_ms": 374040,
      "text": "我在想"
    },
    {
      "ordinal": 120,
      "start_ms": 374040,
      "end_ms": 375240,
      "text": "那不想留他们过节"
    },
    {
      "ordinal": 121,
      "start_ms": 375240,
      "end_ms": 376880,
      "text": "这是第二种"
    },
    {
      "ordinal": 122,
      "start_ms": 379340,
      "end_ms": 381060,
      "text": "那么第三种呢是"
    },
    {
      "ordinal": 123,
      "start_ms": 383860,
      "end_ms": 386860,
      "text": "啊不欢迎过来嗯"
    },
    {
      "ordinal": 124,
      "start_ms": 386860,
      "end_ms": 390860,
      "text": "就是说见到真家货了"
    },
    {
      "ordinal": 125,
      "start_ms": 390860,
      "end_ms": 393309,
      "text": "他怎样啊"
    },
    {
      "ordinal": 126,
      "start_ms": 393309,
      "end_ms": 395429,
      "text": "他是在这里是什么"
    },
    {
      "ordinal": 127,
      "start_ms": 396570,
      "end_ms": 398210,
      "text": "他是显渺小了"
    },
    {
      "ordinal": 128,
      "start_ms": 398210,
      "end_ms": 401230,
      "text": "很很明显这些货过来显渺小"
    },
    {
      "ordinal": 129,
      "start_ms": 401230,
      "end_ms": 402370,
      "text": "然后呢怎么样"
    },
    {
      "ordinal": 130,
      "start_ms": 403410,
      "end_ms": 404970,
      "text": "其实是怎样"
    },
    {
      "ordinal": 131,
      "start_ms": 404970,
      "end_ms": 407080,
      "text": "其实是"
    },
    {
      "ordinal": 132,
      "start_ms": 408280,
      "end_ms": 410640,
      "text": "啊想要救他的野心啊"
    },
    {
      "ordinal": 133,
      "start_ms": 410640,
      "end_ms": 412220,
      "text": "救野心"
    },
    {
      "ordinal": 134,
      "start_ms": 412500,
      "end_ms": 415680,
      "text": "我们也不欢迎这种货跑过来"
    },
    {
      "ordinal": 135,
      "start_ms": 415680,
      "end_ms": 418120,
      "text": "把他那些激进的把戏"
    },
    {
      "ordinal": 136,
      "start_ms": 418120,
      "end_ms": 421830,
      "text": "或者说那些小朋友那个东西摆上来之后"
    },
    {
      "ordinal": 137,
      "start_ms": 421830,
      "end_ms": 422770,
      "text": "和我们"
    },
    {
      "ordinal": 138,
      "start_ms": 422770,
      "end_ms": 424830,
      "text": "我就是要我们拿一个大的"
    },
    {
      "ordinal": 139,
      "start_ms": 424830,
      "end_ms": 426010,
      "text": "拿一些大的啊"
    },
    {
      "ordinal": 140,
      "start_ms": 426010,
      "end_ms": 429429,
      "text": "但是比比他大不了特别大的特别多的"
    },
    {
      "ordinal": 141,
      "start_ms": 429429,
      "end_ms": 430749,
      "text": "这些人的野心"
    },
    {
      "ordinal": 142,
      "start_ms": 430749,
      "end_ms": 433309,
      "text": "其实说在他的现实的碰壁当中"
    },
    {
      "ordinal": 143,
      "start_ms": 433309,
      "end_ms": 435260,
      "text": "已经是濒死状态了"
    },
    {
      "ordinal": 144,
      "start_ms": 435260,
      "end_ms": 440210,
      "text": "这些货已经有他的濒死的野心了啊"
    },
    {
      "ordinal": 145,
      "start_ms": 440210,
      "end_ms": 446210,
      "text": "他的野心就是他的现实行动遭遇的挫折也好"
    },
    {
      "ordinal": 146,
      "start_ms": 446210,
      "end_ms": 447930,
      "text": "或者说他完全走走错了路"
    },
    {
      "ordinal": 147,
      "start_ms": 447930,
      "end_ms": 448550,
      "text": "走歪了路"
    },
    {
      "ordinal": 148,
      "start_ms": 448550,
      "end_ms": 452170,
      "text": "得到的反馈已经在在要让他的野心死掉了"
    },
    {
      "ordinal": 149,
      "start_ms": 452170,
      "end_ms": 454130,
      "text": "他是过来给他野心续命"
    },
    {
      "ordinal": 150,
      "start_ms": 454130,
      "end_ms": 455930,
      "text": "他就是不是过来蹭胃气的"
    },
    {
      "ordinal": 151,
      "start_ms": 455930,
      "end_ms": 457850,
      "text": "他是过来干嘛"
    },
    {
      "ordinal": 152,
      "start_ms": 459440,
      "end_ms": 462280,
      "text": "他是过来沾杀气的"
    },
    {
      "ordinal": 153,
      "start_ms": 462280,
      "end_ms": 466040,
      "text": "他是过来要要要要要"
    },
    {
      "ordinal": 154,
      "start_ms": 468320,
      "end_ms": 471520,
      "text": "这也是卫气的一部分了"
    },
    {
      "ordinal": 155,
      "start_ms": 471520,
      "end_ms": 476510,
      "text": "卫气卫气当中这边占的是卫气当中的贵气啊"
    },
    {
      "ordinal": 156,
      "start_ms": 476510,
      "end_ms": 480970,
      "text": "他要过来蹭蹭的胃气是蹭一些杀气啊"
    },
    {
      "ordinal": 157,
      "start_ms": 480970,
      "end_ms": 482390,
      "text": "种杀鸡必肉"
    },
    {
      "ordinal": 158,
      "start_ms": 482390,
      "end_ms": 485760,
      "text": "我靠那种什么豪情万丈啊"
    },
    {
      "ordinal": 159,
      "start_ms": 485760,
      "end_ms": 490020,
      "text": "这东西他过来借借这东西的来救他的野心"
    },
    {
      "ordinal": 160,
      "start_ms": 490300,
      "end_ms": 491060,
      "text": "然后呢"
    },
    {
      "ordinal": 161,
      "start_ms": 491060,
      "end_ms": 494100,
      "text": "他显得自己渺小渺小"
    },
    {
      "ordinal": 162,
      "start_ms": 494100,
      "end_ms": 495470,
      "text": "但是他又怎么样"
    },
    {
      "ordinal": 163,
      "start_ms": 495470,
      "end_ms": 497550,
      "text": "他要你这边去游戏"
    },
    {
      "ordinal": 164,
      "start_ms": 497550,
      "end_ms": 499170,
      "text": "不就是他妈我本人嘛"
    },
    {
      "ordinal": 165,
      "start_ms": 499170,
      "end_ms": 502190,
      "text": "他要我就给他连他妈的消消乐"
    },
    {
      "ordinal": 166,
      "start_ms": 502190,
      "end_ms": 505520,
      "text": "我靠帮他去自动寻路啊"
    },
    {
      "ordinal": 167,
      "start_ms": 505520,
      "end_ms": 507570,
      "text": "帮他就自动巡进"
    },
    {
      "ordinal": 168,
      "start_ms": 507570,
      "end_ms": 509550,
      "text": "告诉他下一步怎么做"
    },
    {
      "ordinal": 169,
      "start_ms": 509550,
      "end_ms": 513460,
      "text": "这些货也别来啊"
    },
    {
      "ordinal": 170,
      "start_ms": 513460,
      "end_ms": 514480,
      "text": "自动巡进来"
    },
    {
      "ordinal": 171,
      "start_ms": 514480,
      "end_ms": 517320,
      "text": "他就啊自说自话就走了"
    },
    {
      "ordinal": 172,
      "start_ms": 518419,
      "end_ms": 519039,
      "text": "懂吧"
    },
    {
      "ordinal": 173,
      "start_ms": 519039,
      "end_ms": 521979,
      "text": "你叫他他不他不会接受你指导的"
    },
    {
      "ordinal": 174,
      "start_ms": 521979,
      "end_ms": 523698,
      "text": "他就是要让他那个玩不下去"
    },
    {
      "ordinal": 175,
      "start_ms": 523698,
      "end_ms": 525130,
      "text": "游戏继续玩下去"
    },
    {
      "ordinal": 176,
      "start_ms": 525130,
      "end_ms": 526530,
      "text": "也就是他不听话的"
    },
    {
      "ordinal": 177,
      "start_ms": 526530,
      "end_ms": 528130,
      "text": "不听人话的跟他讲来讲去"
    },
    {
      "ordinal": 178,
      "start_ms": 528130,
      "end_ms": 529130,
      "text": "一切好说歹说"
    },
    {
      "ordinal": 179,
      "start_ms": 529130,
      "end_ms": 530370,
      "text": "这些话他妈的不听的"
    },
    {
      "ordinal": 180,
      "start_ms": 530370,
      "end_ms": 531170,
      "text": "说这走不通的"
    },
    {
      "ordinal": 181,
      "start_ms": 531170,
      "end_ms": 532540,
      "text": "你往下面走"
    },
    {
      "ordinal": 182,
      "start_ms": 532820,
      "end_ms": 533740,
      "text": "方向错了"
    },
    {
      "ordinal": 183,
      "start_ms": 533740,
      "end_ms": 537040,
      "text": "越走越越走越错"
    },
    {
      "ordinal": 184,
      "start_ms": 537040,
      "end_ms": 540880,
      "text": "越走越反不听话的"
    },
    {
      "ordinal": 185,
      "start_ms": 541860,
      "end_ms": 543940,
      "text": "这个这些人呐我们也遇到不少"
    },
    {
      "ordinal": 186,
      "start_ms": 545180,
      "end_ms": 548060,
      "text": "其实内在的是很"
    },
    {
      "ordinal": 187,
      "start_ms": 549340,
      "end_ms": 550880,
      "text": "其实是什么啊"
    },
    {
      "ordinal": 188,
      "start_ms": 550880,
      "end_ms": 554420,
      "text": "其实这帮货知道在这个"
    },
    {
      "ordinal": 189,
      "start_ms": 556520,
      "end_ms": 561500,
      "text": "再次就是这是安全安全领地"
    },
    {
      "ordinal": 190,
      "start_ms": 563270,
      "end_ms": 567790,
      "text": "他在我们的那个大包围大范围之内"
    },
    {
      "ordinal": 191,
      "start_ms": 567790,
      "end_ms": 573090,
      "text": "然后去他他就是把我们划定出来的这个大范围"
    },
    {
      "ordinal": 192,
      "start_ms": 573090,
      "end_ms": 574670,
      "text": "当成是个安全领地"
    },
    {
      "ordinal": 193,
      "start_ms": 574670,
      "end_ms": 577630,
      "text": "然后他就会瞎逼在这个安全领地面瞎逼玩"
    },
    {
      "ordinal": 194,
      "start_ms": 577630,
      "end_ms": 581590,
      "text": "因为他过来粘的这个杀气大大的"
    },
    {
      "ordinal": 195,
      "start_ms": 581590,
      "end_ms": 583070,
      "text": "远远的超出他的想象"
    },
    {
      "ordinal": 196,
      "start_ms": 584270,
      "end_ms": 587990,
      "text": "所以他就觉得哎我现在这么渺小"
    },
    {
      "ordinal": 197,
      "start_ms": 587990,
      "end_ms": 588510,
      "text": "这么"
    },
    {
      "ordinal": 198,
      "start_ms": 588510,
      "end_ms": 589130,
      "text": "这么幼稚"
    },
    {
      "ordinal": 199,
      "start_ms": 589130,
      "end_ms": 590150,
      "text": "他就可以瞎逼玩"
    },
    {
      "ordinal": 200,
      "start_ms": 590150,
      "end_ms": 592830,
      "text": "只要当他不不要玩到"
    },
    {
      "ordinal": 201,
      "start_ms": 592830,
      "end_ms": 595110,
      "text": "在我们身上所感受到那种震撼"
    },
    {
      "ordinal": 202,
      "start_ms": 595110,
      "end_ms": 600509,
      "text": "那种那种那种高处不胜寒的那个尺度"
    },
    {
      "ordinal": 203,
      "start_ms": 600509,
      "end_ms": 605069,
      "text": "他就始终觉得自己这样瞎逼玩是安全的哦"
    },
    {
      "ordinal": 204,
      "start_ms": 605069,
      "end_ms": 607409,
      "text": "安全而又刺激"
    },
    {
      "ordinal": 205,
      "start_ms": 609420,
      "end_ms": 612120,
      "text": "这帮逼就追求安全而又刺激"
    },
    {
      "ordinal": 206,
      "start_ms": 612120,
      "end_ms": 614620,
      "text": "然后第二种追求的是什么"
    },
    {
      "ordinal": 207,
      "start_ms": 614620,
      "end_ms": 617380,
      "text": "高尚而又自私"
    },
    {
      "ordinal": 208,
      "start_ms": 617700,
      "end_ms": 620590,
      "text": "第一种追求的是什么"
    },
    {
      "ordinal": 209,
      "start_ms": 620990,
      "end_ms": 625600,
      "text": "什么叫做忠诚啊"
    },
    {
      "ordinal": 210,
      "start_ms": 627120,
      "end_ms": 629180,
      "text": "而又是自立啊"
    },
    {
      "ordinal": 211,
      "start_ms": 629180,
      "end_ms": 634380,
      "text": "忠诚而又这个啊叛逆啊"
    },
    {
      "ordinal": 212,
      "start_ms": 635680,
      "end_ms": 637800,
      "text": "多吊忠诚而又叛逆啊"
    },
    {
      "ordinal": 213,
      "start_ms": 637800,
      "end_ms": 638720,
      "text": "尼玛都这种货"
    },
    {
      "ordinal": 214,
      "start_ms": 639380,
      "end_ms": 641180,
      "text": "那么第四种"
    },
    {
      "ordinal": 215,
      "start_ms": 641180,
      "end_ms": 642180,
      "text": "第四种"
    },
    {
      "ordinal": 216,
      "start_ms": 642180,
      "end_ms": 643320,
      "text": "别有用心的"
    },
    {
      "ordinal": 217,
      "start_ms": 643320,
      "end_ms": 644920,
      "text": "你也不要来啊"
    },
    {
      "ordinal": 218,
      "start_ms": 644920,
      "end_ms": 652200,
      "text": "第四种别有用心的就是哎呀喂啧"
    },
    {
      "ordinal": 219,
      "start_ms": 657460,
      "end_ms": 659540,
      "text": "呃给我想一想啊"
    },
    {
      "ordinal": 220,
      "start_ms": 659540,
      "end_ms": 662660,
      "text": "给我想一想啊"
    },
    {
      "ordinal": 221,
      "start_ms": 670240,
      "end_ms": 672220,
      "text": "他也是要过小日子啊"
    },
    {
      "ordinal": 222,
      "start_ms": 672220,
      "end_ms": 674780,
      "text": "迪斯诺也是要过小日子啊"
    },
    {
      "ordinal": 223,
      "start_ms": 674780,
      "end_ms": 676120,
      "text": "他是"
    },
    {
      "ordinal": 224,
      "start_ms": 677780,
      "end_ms": 680260,
      "text": "求一个求救济啊"
    },
    {
      "ordinal": 225,
      "start_ms": 680260,
      "end_ms": 681740,
      "text": "求救济"
    },
    {
      "ordinal": 226,
      "start_ms": 683020,
      "end_ms": 688690,
      "text": "但是呢他是等别人等别人的回心转意啊"
    },
    {
      "ordinal": 227,
      "start_ms": 688690,
      "end_ms": 691560,
      "text": "等转机这帮货"
    },
    {
      "ordinal": 228,
      "start_ms": 691560,
      "end_ms": 695500,
      "text": "你是求救济等等别人的转机的这种人"
    },
    {
      "ordinal": 229,
      "start_ms": 695500,
      "end_ms": 705270,
      "text": "特别是当然这个东西啊啊你懂的啊"
    },
    {
      "ordinal": 230,
      "start_ms": 706350,
      "end_ms": 706990,
      "text": "你明白吧"
    },
    {
      "ordinal": 231,
      "start_ms": 708070,
      "end_ms": 710405,
      "text": "你懂的啊"
    },
    {
      "ordinal": 232,
      "start_ms": 711050,
      "end_ms": 712770,
      "text": "过来求去救济之后"
    },
    {
      "ordinal": 233,
      "start_ms": 712770,
      "end_ms": 714730,
      "text": "富二代男朋友呼唤两声"
    },
    {
      "ordinal": 234,
      "start_ms": 714730,
      "end_ms": 715570,
      "text": "他妈这就跑了"
    },
    {
      "ordinal": 235,
      "start_ms": 715570,
      "end_ms": 718010,
      "text": "这种逼货你懂吗啊"
    },
    {
      "ordinal": 236,
      "start_ms": 718010,
      "end_ms": 720030,
      "text": "他就是来过渡一下的啊"
    },
    {
      "ordinal": 237,
      "start_ms": 720030,
      "end_ms": 721410,
      "text": "求求这个救济之后呢"
    },
    {
      "ordinal": 238,
      "start_ms": 721410,
      "end_ms": 724550,
      "text": "他对又对人家不死心啊"
    },
    {
      "ordinal": 239,
      "start_ms": 724550,
      "end_ms": 729470,
      "text": "这个什么小女友小男友小女友小男友要重新哦"
    },
    {
      "ordinal": 240,
      "start_ms": 729470,
      "end_ms": 729970,
      "text": "宝宝乖"
    },
    {
      "ordinal": 241,
      "start_ms": 729970,
      "end_ms": 731190,
      "text": "他妈逼又跑回去了"
    },
    {
      "ordinal": 242,
      "start_ms": 731190,
      "end_ms": 732620,
      "text": "这种货啊"
    },
    {
      "ordinal": 243,
      "start_ms": 732620,
      "end_ms": 733860,
      "text": "他等待一个转机"
    },
    {
      "ordinal": 244,
      "start_ms": 733860,
      "end_ms": 736740,
      "text": "等待那些呃就是"
    },
    {
      "ordinal": 245,
      "start_ms": 738850,
      "end_ms": 741130,
      "text": "奉献不太够的那些人又又重"
    },
    {
      "ordinal": 246,
      "start_ms": 741130,
      "end_ms": 743740,
      "text": "又开始对她好了"
    },
    {
      "ordinal": 247,
      "start_ms": 744020,
      "end_ms": 749900,
      "text": "就是说他实际上把这里当成是一个拉锯的啊"
    },
    {
      "ordinal": 248,
      "start_ms": 749900,
      "end_ms": 757280,
      "text": "拉锯的一个点和他的那种日子日子的盼头啊"
    },
    {
      "ordinal": 249,
      "start_ms": 757280,
      "end_ms": 758980,
      "text": "拉锯的这种货"
    },
    {
      "ordinal": 250,
      "start_ms": 758980,
      "end_ms": 760200,
      "text": "别来"
    },
    {
      "ordinal": 251,
      "start_ms": 760200,
      "end_ms": 760980,
      "text": "有多远"
    },
    {
      "ordinal": 252,
      "start_ms": 760980,
      "end_ms": 762540,
      "text": "给老子滚多远"
    },
    {
      "ordinal": 253,
      "start_ms": 764540,
      "end_ms": 771230,
      "text": "这种货呢他就是也就是说他来工作"
    },
    {
      "ordinal": 254,
      "start_ms": 771230,
      "end_ms": 774790,
      "text": "工作心不定啊"
    },
    {
      "ordinal": 255,
      "start_ms": 774790,
      "end_ms": 775710,
      "text": "心不定"
    },
    {
      "ordinal": 256,
      "start_ms": 775710,
      "end_ms": 781580,
      "text": "然后呢不算这个不算这个利益的不赖"
    },
    {
      "ordinal": 257,
      "start_ms": 781580,
      "end_ms": 783860,
      "text": "计算力和这个时机紧迫的"
    },
    {
      "ordinal": 258,
      "start_ms": 783860,
      "end_ms": 788010,
      "text": "时机紧迫实际的这这帮货上他工作"
    },
    {
      "ordinal": 259,
      "start_ms": 788010,
      "end_ms": 790630,
      "text": "这帮逼这帮畜神就是无法上压力的"
    },
    {
      "ordinal": 260,
      "start_ms": 790630,
      "end_ms": 792650,
      "text": "无法上压力"
    },
    {
      "ordinal": 261,
      "start_ms": 794130,
      "end_ms": 798030,
      "text": "他不以你这里的受到的压力和局面为主轴啊"
    },
    {
      "ordinal": 262,
      "start_ms": 798030,
      "end_ms": 802150,
      "text": "不以这里这里的这个局面作为主轴"
    },
    {
      "ordinal": 263,
      "start_ms": 802510,
      "end_ms": 804750,
      "text": "不会主动去思考"
    },
    {
      "ordinal": 264,
      "start_ms": 804750,
      "end_ms": 808180,
      "text": "不主动去思考啊"
    },
    {
      "ordinal": 265,
      "start_ms": 808180,
      "end_ms": 815980,
      "text": "啊代入切身的去思考这里的集体的近况啊"
    },
    {
      "ordinal": 266,
      "start_ms": 815980,
      "end_ms": 816780,
      "text": "你困境"
    },
    {
      "ordinal": 267,
      "start_ms": 816780,
      "end_ms": 817660,
      "text": "那要摆脱困境"
    },
    {
      "ordinal": 268,
      "start_ms": 817660,
      "end_ms": 818460,
      "text": "想办法"
    },
    {
      "ordinal": 269,
      "start_ms": 818460,
      "end_ms": 821600,
      "text": "你是啊这个有利的境况"
    },
    {
      "ordinal": 270,
      "start_ms": 821600,
      "end_ms": 823420,
      "text": "那又怎么样"
    },
    {
      "ordinal": 271,
      "start_ms": 824080,
      "end_ms": 826440,
      "text": "那要抓住机会呀"
    },
    {
      "ordinal": 272,
      "start_ms": 827440,
      "end_ms": 829250,
      "text": "要快速发展呀"
    },
    {
      "ordinal": 273,
      "start_ms": 829250,
      "end_ms": 830550,
      "text": "啊要布局好"
    },
    {
      "ordinal": 274,
      "start_ms": 830550,
      "end_ms": 831630,
      "text": "调整好结构"
    },
    {
      "ordinal": 275,
      "start_ms": 831630,
      "end_ms": 833950,
      "text": "调整好这个分工关系"
    },
    {
      "ordinal": 276,
      "start_ms": 833950,
      "end_ms": 836770,
      "text": "还布局好发展的预期"
    },
    {
      "ordinal": 277,
      "start_ms": 836770,
      "end_ms": 838840,
      "text": "要把点位抢占好"
    },
    {
      "ordinal": 278,
      "start_ms": 838840,
      "end_ms": 840440,
      "text": "他不会这样考虑的嘛"
    },
    {
      "ordinal": 279,
      "start_ms": 840440,
      "end_ms": 841500,
      "text": "他不急的"
    },
    {
      "ordinal": 280,
      "start_ms": 841500,
      "end_ms": 843880,
      "text": "因为他急的是他的转机"
    },
    {
      "ordinal": 281,
      "start_ms": 843880,
      "end_ms": 845120,
      "text": "他妈小女友小男友"
    },
    {
      "ordinal": 282,
      "start_ms": 845120,
      "end_ms": 847089,
      "text": "你知道黄毛妈了"
    },
    {
      "ordinal": 283,
      "start_ms": 847089,
      "end_ms": 848209,
      "text": "或者说有钱的"
    },
    {
      "ordinal": 284,
      "start_ms": 848209,
      "end_ms": 851369,
      "text": "whatever他等的是这些逼玩意儿"
    },
    {
      "ordinal": 285,
      "start_ms": 851369,
      "end_ms": 852409,
      "text": "他对于你这里"
    },
    {
      "ordinal": 286,
      "start_ms": 852409,
      "end_ms": 858960,
      "text": "他处在一个啊有有就有没有就有占便宜的"
    },
    {
      "ordinal": 287,
      "start_ms": 858960,
      "end_ms": 861560,
      "text": "他他就他这个占便宜还是不是那种"
    },
    {
      "ordinal": 288,
      "start_ms": 861560,
      "end_ms": 862820,
      "text": "就是说直接占便宜"
    },
    {
      "ordinal": 289,
      "start_ms": 862820,
      "end_ms": 864470,
      "text": "他看似也在工作"
    },
    {
      "ordinal": 290,
      "start_ms": 864470,
      "end_ms": 866310,
      "text": "看似也在参与"
    },
    {
      "ordinal": 291,
      "start_ms": 866310,
      "end_ms": 869830,
      "text": "其实他爸的菜在占占的是一个"
    },
    {
      "ordinal": 292,
      "start_ms": 869830,
      "end_ms": 872390,
      "text": "填补他的空虚的便宜啊"
    },
    {
      "ordinal": 293,
      "start_ms": 872390,
      "end_ms": 874410,
      "text": "暂时填补了这个空虚"
    },
    {
      "ordinal": 294,
      "start_ms": 874410,
      "end_ms": 878260,
      "text": "让他啊他占的便宜与其实更多是物质便宜"
    },
    {
      "ordinal": 295,
      "start_ms": 878260,
      "end_ms": 881860,
      "text": "不是说是填补了他的这个心理上的空虚啊"
    },
    {
      "ordinal": 296,
      "start_ms": 881860,
      "end_ms": 886140,
      "text": "啊让他就是好整以暇的去啊"
    },
    {
      "ordinal": 297,
      "start_ms": 886140,
      "end_ms": 888920,
      "text": "这获得某种情感上"
    },
    {
      "ordinal": 298,
      "start_ms": 888920,
      "end_ms": 892980,
      "text": "情感上好整以暇啊"
    },
    {
      "ordinal": 299,
      "start_ms": 892980,
      "end_ms": 894140,
      "text": "好整以暇"
    },
    {
      "ordinal": 300,
      "start_ms": 894140,
      "end_ms": 897459,
      "text": "然后能够就是说坦然坦然面"
    },
    {
      "ordinal": 301,
      "start_ms": 897459,
      "end_ms": 898919,
      "text": "坦然去等待啊"
    },
    {
      "ordinal": 302,
      "start_ms": 898919,
      "end_ms": 900579,
      "text": "守株待兔那种感觉"
    },
    {
      "ordinal": 303,
      "start_ms": 900579,
      "end_ms": 904609,
      "text": "坦然去等待这个转机的到来"
    },
    {
      "ordinal": 304,
      "start_ms": 905449,
      "end_ms": 910689,
      "text": "这种货他的工作特点也不讲了嘛啊"
    },
    {
      "ordinal": 305,
      "start_ms": 910689,
      "end_ms": 916430,
      "text": "工作特点就是说不没有那种非常主动积极的"
    },
    {
      "ordinal": 306,
      "start_ms": 916430,
      "end_ms": 924360,
      "text": "就是说彻底的完整的投入的那样一种啊"
    },
    {
      "ordinal": 307,
      "start_ms": 925240,
      "end_ms": 926440,
      "text": "沉浸性"
    },
    {
      "ordinal": 308,
      "start_ms": 928120,
      "end_ms": 929680,
      "text": "动不动要跑"
    },
    {
      "ordinal": 309,
      "start_ms": 930860,
      "end_ms": 935810,
      "text": "干着干着自说自话叫叫叫换换试井盖啊"
    },
    {
      "ordinal": 310,
      "start_ms": 935810,
      "end_ms": 937890,
      "text": "那么这四种四种货呢"
    },
    {
      "ordinal": 311,
      "start_ms": 937890,
      "end_ms": 941150,
      "text": "就是我们叫的别有用心的啊"
    },
    {
      "ordinal": 312,
      "start_ms": 941150,
      "end_ms": 943470,
      "text": "别有用心的四种人"
    },
    {
      "ordinal": 313,
      "start_ms": 943470,
      "end_ms": 946010,
      "text": "就不要他妈一直抵近观察了"
    },
    {
      "ordinal": 314,
      "start_ms": 946010,
      "end_ms": 948700,
      "text": "就干底劲的干什么"
    },
    {
      "ordinal": 315,
      "start_ms": 949260,
      "end_ms": 951820,
      "text": "除了这四种货之外"
    },
    {
      "ordinal": 316,
      "start_ms": 952079,
      "end_ms": 953899,
      "text": "我们欢迎一切"
    },
    {
      "ordinal": 317,
      "start_ms": 953899,
      "end_ms": 955219,
      "text": "就是说啊"
    },
    {
      "ordinal": 318,
      "start_ms": 955219,
      "end_ms": 963420,
      "text": "你只要表明是认同支持我们这个理念的啊"
    },
    {
      "ordinal": 319,
      "start_ms": 963420,
      "end_ms": 966580,
      "text": "我发现你们来抵近观察"
    },
    {
      "ordinal": 320,
      "start_ms": 968020,
      "end_ms": 969160,
      "text": "已经观察"
    },
    {
      "ordinal": 321,
      "start_ms": 969160,
      "end_ms": 972000,
      "text": "然后我们不怕露马脚"
    },
    {
      "ordinal": 322,
      "start_ms": 972000,
      "end_ms": 974420,
      "text": "因为我们是坚贞的啊"
    },
    {
      "ordinal": 323,
      "start_ms": 974420,
      "end_ms": 977879,
      "text": "马克思列宁主义者不怕露马脚"
    },
    {
      "ordinal": 324,
      "start_ms": 977879,
      "end_ms": 979859,
      "text": "这个老马脚就要露给你们看"
    },
    {
      "ordinal": 325,
      "start_ms": 979859,
      "end_ms": 980659,
      "text": "我们的这个理念"
    },
    {
      "ordinal": 326,
      "start_ms": 984009,
      "end_ms": 987509,
      "text": "生存的整体的近况啊"
    },
    {
      "ordinal": 327,
      "start_ms": 987509,
      "end_ms": 989760,
      "text": "呈现给你们看下"
    },
    {
      "ordinal": 328,
      "start_ms": 992579,
      "end_ms": 993259,
      "text": "好吧"
    },
    {
      "ordinal": 329,
      "start_ms": 993259,
      "end_ms": 994859,
      "text": "就是说这个节假日的话"
    },
    {
      "ordinal": 330,
      "start_ms": 994859,
      "end_ms": 996819,
      "text": "也是欢迎你们过来体验啊"
    },
    {
      "ordinal": 331,
      "start_ms": 996819,
      "end_ms": 997979,
      "text": "欢迎你们过来体验"
    },
    {
      "ordinal": 332,
      "start_ms": 997979,
      "end_ms": 1001570,
      "text": "你们来关注我们的那个俱乐部账号啊"
    },
    {
      "ordinal": 333,
      "start_ms": 1001570,
      "end_ms": 1004790,
      "text": "会有一些这个体验营的活动啊"
    },
    {
      "ordinal": 334,
      "start_ms": 1004790,
      "end_ms": 1007780,
      "text": "一些项目套餐啊"
    },
    {
      "ordinal": 335,
      "start_ms": 1007780,
      "end_ms": 1011600,
      "text": "游学之旅啊啊游学之旅"
    },
    {
      "ordinal": 336,
      "start_ms": 1014280,
      "end_ms": 1017720,
      "text": "就是过来旅游嘛啊过来旅游"
    },
    {
      "ordinal": 337,
      "start_ms": 1019090,
      "end_ms": 1022510,
      "text": "然后是能够体验一下这个俱乐部的一些"
    },
    {
      "ordinal": 338,
      "start_ms": 1022510,
      "end_ms": 1023670,
      "text": "特色项目啊"
    },
    {
      "ordinal": 339,
      "start_ms": 1023670,
      "end_ms": 1025500,
      "text": "特色项目啊"
    },
    {
      "ordinal": 340,
      "start_ms": 1025500,
      "end_ms": 1026960,
      "text": "那就非常安全的"
    },
    {
      "ordinal": 341,
      "start_ms": 1026960,
      "end_ms": 1029180,
      "text": "合法的特色项目"
    },
    {
      "ordinal": 342,
      "start_ms": 1031800,
      "end_ms": 1036000,
      "text": "好吧我就讲到这里啊"
    },
    {
      "ordinal": 343,
      "start_ms": 1037029,
      "end_ms": 1040789,
      "text": "欢迎有识之士过来来了解我们啊"
    },
    {
      "ordinal": 344,
      "start_ms": 1040789,
      "end_ms": 1045940,
      "text": "来这个有机会来参与我们的一些啊活动啊"
    }
