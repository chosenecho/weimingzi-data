{
  "bvid": "BV1YEtNzXE7e",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "51ec5d34901fe5a3dc3eb84d6a7488500f9e31c02f9f308b7dad028b5769e504",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 1340,
      "end_ms": 8330,
      "text": "嗯我们要处理好这个平民性和非平民性的关系"
    },
    {
      "ordinal": 1,
      "start_ms": 8810,
      "end_ms": 11230,
      "text": "那么对我们个人来讲的话"
    },
    {
      "ordinal": 2,
      "start_ms": 11230,
      "end_ms": 12610,
      "text": "就是"
    },
    {
      "ordinal": 3,
      "start_ms": 14060,
      "end_ms": 17060,
      "text": "平面性是相当重要的"
    },
    {
      "ordinal": 4,
      "start_ms": 17929,
      "end_ms": 19129,
      "text": "因为没有平民性"
    },
    {
      "ordinal": 5,
      "start_ms": 19129,
      "end_ms": 21729,
      "text": "你就失去了呃"
    },
    {
      "ordinal": 6,
      "start_ms": 21729,
      "end_ms": 27870,
      "text": "你的首先失去了你的力量的来源啊"
    },
    {
      "ordinal": 7,
      "start_ms": 27870,
      "end_ms": 30310,
      "text": "纯粹的职业性或者非平民性"
    },
    {
      "ordinal": 8,
      "start_ms": 31390,
      "end_ms": 33530,
      "text": "他的资源是非常有限的"
    },
    {
      "ordinal": 9,
      "start_ms": 33530,
      "end_ms": 37810,
      "text": "因为职业选手的规模也是很小的"
    },
    {
      "ordinal": 10,
      "start_ms": 37810,
      "end_ms": 39270,
      "text": "另外一方面呢"
    },
    {
      "ordinal": 11,
      "start_ms": 39270,
      "end_ms": 42290,
      "text": "如果你完全摒弃平民性的话"
    },
    {
      "ordinal": 12,
      "start_ms": 42290,
      "end_ms": 44970,
      "text": "不把自己当成一个平民的话"
    },
    {
      "ordinal": 13,
      "start_ms": 47540,
      "end_ms": 49660,
      "text": "你是没有办法呃"
    },
    {
      "ordinal": 14,
      "start_ms": 49660,
      "end_ms": 52140,
      "text": "理解到就是"
    },
    {
      "ordinal": 15,
      "start_ms": 55660,
      "end_ms": 59860,
      "text": "革命最终是要做一种生活方式的转变"
    },
    {
      "ordinal": 16,
      "start_ms": 59860,
      "end_ms": 61460,
      "text": "那么生活方式转变"
    },
    {
      "ordinal": 17,
      "start_ms": 61460,
      "end_ms": 64260,
      "text": "与其说是职业革命家的生活方式的转变"
    },
    {
      "ordinal": 18,
      "start_ms": 64260,
      "end_ms": 65300,
      "text": "更重要的"
    },
    {
      "ordinal": 19,
      "start_ms": 65300,
      "end_ms": 70260,
      "text": "不如说更啊是这个平民的生活方式转变"
    },
    {
      "ordinal": 20,
      "start_ms": 70260,
      "end_ms": 72440,
      "text": "你光是一小撮人转变的生活方式"
    },
    {
      "ordinal": 21,
      "start_ms": 72440,
      "end_ms": 73880,
      "text": "那算什么成功呢"
    },
    {
      "ordinal": 22,
      "start_ms": 73880,
      "end_ms": 74560,
      "text": "对不对"
    },
    {
      "ordinal": 23,
      "start_ms": 74560,
      "end_ms": 78200,
      "text": "你要是要带动一整个人类的社群共同体"
    },
    {
      "ordinal": 24,
      "start_ms": 78200,
      "end_ms": 81489,
      "text": "来生成新的平民性"
    },
    {
      "ordinal": 25,
      "start_ms": 81489,
      "end_ms": 83229,
      "text": "所以平民性很重要"
    },
    {
      "ordinal": 26,
      "start_ms": 83229,
      "end_ms": 85660,
      "text": "所以在这个意义上讲啊"
    },
    {
      "ordinal": 27,
      "start_ms": 85660,
      "end_ms": 89560,
      "text": "在一个目力可及的一个历史时期当中"
    },
    {
      "ordinal": 28,
      "start_ms": 89560,
      "end_ms": 93840,
      "text": "生产力啊不太可能有特别巨大的一个飞跃"
    },
    {
      "ordinal": 29,
      "start_ms": 93840,
      "end_ms": 95600,
      "text": "生产关系可以加以调整"
    },
    {
      "ordinal": 30,
      "start_ms": 95600,
      "end_ms": 98150,
      "text": "那么在这种情况下呃"
    },
    {
      "ordinal": 31,
      "start_ms": 98150,
      "end_ms": 99450,
      "text": "在情感上"
    },
    {
      "ordinal": 32,
      "start_ms": 99450,
      "end_ms": 103910,
      "text": "在这个呃亲密关系上面"
    },
    {
      "ordinal": 33,
      "start_ms": 103910,
      "end_ms": 110500,
      "text": "还包括在一些这个个人的生活的寄托上"
    },
    {
      "ordinal": 34,
      "start_ms": 110500,
      "end_ms": 113160,
      "text": "保有比较大的平民性"
    },
    {
      "ordinal": 35,
      "start_ms": 113160,
      "end_ms": 115500,
      "text": "这不是什么问题啊"
    },
    {
      "ordinal": 36,
      "start_ms": 115500,
      "end_ms": 118100,
      "text": "但是平民心不代不代表保守性"
    },
    {
      "ordinal": 37,
      "start_ms": 118100,
      "end_ms": 118620,
      "text": "明白吗"
    },
    {
      "ordinal": 38,
      "start_ms": 118620,
      "end_ms": 125040,
      "text": "平民一一样可以就是说做好准备迎接变化啊"
    },
    {
      "ordinal": 39,
      "start_ms": 125040,
      "end_ms": 126320,
      "text": "一样可以激进"
    },
    {
      "ordinal": 40,
      "start_ms": 126320,
      "end_ms": 127340,
      "text": "这是一方面"
    },
    {
      "ordinal": 41,
      "start_ms": 127340,
      "end_ms": 130520,
      "text": "另外一方面我们要看到平民性的对立面"
    },
    {
      "ordinal": 42,
      "start_ms": 130520,
      "end_ms": 133540,
      "text": "非平民性他其实没有那么简单的"
    },
    {
      "ordinal": 43,
      "start_ms": 133540,
      "end_ms": 136180,
      "text": "它分我们认为可以分三种"
    },
    {
      "ordinal": 44,
      "start_ms": 136180,
      "end_ms": 138640,
      "text": "一是咳非平民性"
    },
    {
      "ordinal": 45,
      "start_ms": 138640,
      "end_ms": 140960,
      "text": "一官僚性啊"
    },
    {
      "ordinal": 46,
      "start_ms": 140960,
      "end_ms": 141940,
      "text": "官方性"
    },
    {
      "ordinal": 47,
      "start_ms": 141940,
      "end_ms": 145250,
      "text": "二黑帮性"
    },
    {
      "ordinal": 48,
      "start_ms": 145250,
      "end_ms": 146710,
      "text": "或者说某种前现代"
    },
    {
      "ordinal": 49,
      "start_ms": 146710,
      "end_ms": 154480,
      "text": "或者说这个嗯就是那种底层暴力形成的嗯"
    },
    {
      "ordinal": 50,
      "start_ms": 154480,
      "end_ms": 157780,
      "text": "喊打喊杀的生活啊"
    },
    {
      "ordinal": 51,
      "start_ms": 157780,
      "end_ms": 159220,
      "text": "那么官僚系呢"
    },
    {
      "ordinal": 52,
      "start_ms": 159220,
      "end_ms": 161980,
      "text": "他是把他的暴力呢"
    },
    {
      "ordinal": 53,
      "start_ms": 161980,
      "end_ms": 167050,
      "text": "在常态下是分包给了他的黑帮性"
    },
    {
      "ordinal": 54,
      "start_ms": 167050,
      "end_ms": 169070,
      "text": "那么第三个呢"
    },
    {
      "ordinal": 55,
      "start_ms": 169070,
      "end_ms": 173280,
      "text": "非平民性对应的还有一个点是什么"
    },
    {
      "ordinal": 56,
      "start_ms": 173600,
      "end_ms": 177500,
      "text": "其实我不想再引入这个学院性和这个宗教性"
    },
    {
      "ordinal": 57,
      "start_ms": 177500,
      "end_ms": 179120,
      "text": "因为学术话语和宗教话语"
    },
    {
      "ordinal": 58,
      "start_ms": 179120,
      "end_ms": 182060,
      "text": "也是平民性的一个补充啊"
    },
    {
      "ordinal": 59,
      "start_ms": 182060,
      "end_ms": 185060,
      "text": "或者说是会介入平民性本身"
    },
    {
      "ordinal": 60,
      "start_ms": 185060,
      "end_ms": 187649,
      "text": "去塑造平民性的自我想象的"
    },
    {
      "ordinal": 61,
      "start_ms": 187649,
      "end_ms": 190309,
      "text": "那我们说的平民性的还有一个对立面"
    },
    {
      "ordinal": 62,
      "start_ms": 190309,
      "end_ms": 193380,
      "text": "第三个对立面的应当就是革命性咳"
    },
    {
      "ordinal": 63,
      "start_ms": 193380,
      "end_ms": 197510,
      "text": "所谓职业革命家的职业革命性咳咳"
    },
    {
      "ordinal": 64,
      "start_ms": 198350,
      "end_ms": 203270,
      "text": "所以很多否定性激进否定性"
    },
    {
      "ordinal": 65,
      "start_ms": 203270,
      "end_ms": 205910,
      "text": "他扬弃了平民性"
    },
    {
      "ordinal": 66,
      "start_ms": 206500,
      "end_ms": 210220,
      "text": "要清醒地意识到啊"
    },
    {
      "ordinal": 67,
      "start_ms": 210220,
      "end_ms": 212380,
      "text": "他阳气的有两个错误的方向"
    },
    {
      "ordinal": 68,
      "start_ms": 212380,
      "end_ms": 213940,
      "text": "一是阳气成了官僚性"
    },
    {
      "ordinal": 69,
      "start_ms": 213940,
      "end_ms": 215340,
      "text": "二是阳气成了黑帮性"
    },
    {
      "ordinal": 70,
      "start_ms": 215340,
      "end_ms": 218850,
      "text": "这两个东西呢都反过来是倾轧了"
    },
    {
      "ordinal": 71,
      "start_ms": 218850,
      "end_ms": 222300,
      "text": "或者说在蔑视鄙视着平民性"
    },
    {
      "ordinal": 72,
      "start_ms": 222300,
      "end_ms": 224460,
      "text": "只有当他洋气自身"
    },
    {
      "ordinal": 73,
      "start_ms": 224460,
      "end_ms": 228160,
      "text": "而成为了职业革命家的革命性的时候"
    },
    {
      "ordinal": 74,
      "start_ms": 228160,
      "end_ms": 231140,
      "text": "他不会瞧不起平民性"
    },
    {
      "ordinal": 75,
      "start_ms": 231140,
      "end_ms": 233840,
      "text": "他反而要去借鉴吸收"
    },
    {
      "ordinal": 76,
      "start_ms": 233840,
      "end_ms": 239450,
      "text": "反而要接受平民性当中的同样的绝对的啊"
    },
    {
      "ordinal": 77,
      "start_ms": 239450,
      "end_ms": 244560,
      "text": "以及它的总体性的对于革命性的洗礼"
    },
    {
      "ordinal": 78,
      "start_ms": 244920,
      "end_ms": 247360,
      "text": "与其说是平民生活接受革命的洗礼"
    },
    {
      "ordinal": 79,
      "start_ms": 247360,
      "end_ms": 250580,
      "text": "不如说我们在从平民生活当中"
    },
    {
      "ordinal": 80,
      "start_ms": 250580,
      "end_ms": 254810,
      "text": "平民性当中阳气诞生出一种革命性的时候"
    },
    {
      "ordinal": 81,
      "start_ms": 254810,
      "end_ms": 259339,
      "text": "革命性本身要反过来接受平民的绝对性"
    },
    {
      "ordinal": 82,
      "start_ms": 259339,
      "end_ms": 260738,
      "text": "平民的根本价值"
    },
    {
      "ordinal": 83,
      "start_ms": 260738,
      "end_ms": 262439,
      "text": "对于革命性的审视"
    },
    {
      "ordinal": 84,
      "start_ms": 262439,
      "end_ms": 265439,
      "text": "对于他的试金"
    },
    {
      "ordinal": 85,
      "start_ms": 268400,
      "end_ms": 269900,
      "text": "啊所以在这个意义上讲"
    },
    {
      "ordinal": 86,
      "start_ms": 269900,
      "end_ms": 272220,
      "text": "职业革命家啊"
    },
    {
      "ordinal": 87,
      "start_ms": 272220,
      "end_ms": 274120,
      "text": "他对于平民性的阳气"
    },
    {
      "ordinal": 88,
      "start_ms": 274120,
      "end_ms": 276080,
      "text": "不是一般意义上的鄙视"
    },
    {
      "ordinal": 89,
      "start_ms": 276080,
      "end_ms": 283440,
      "text": "超越超脱反过来可以控制蹂躏利用并非如此"
    },
    {
      "ordinal": 90,
      "start_ms": 283440,
      "end_ms": 288949,
      "text": "而是一种非常嗯深刻的关系"
    },
    {
      "ordinal": 91,
      "start_ms": 290340,
      "end_ms": 293120,
      "text": "啊这种深刻的关系啊"
    },
    {
      "ordinal": 92,
      "start_ms": 293120,
      "end_ms": 298650,
      "text": "就是他绝对不是说啊"
    },
    {
      "ordinal": 93,
      "start_ms": 298650,
      "end_ms": 301730,
      "text": "他肯定是就体现为群众路线这四个字"
    },
    {
      "ordinal": 94,
      "start_ms": 301730,
      "end_ms": 304210,
      "text": "但是这种群众路线绝对不能被误解成"
    },
    {
      "ordinal": 95,
      "start_ms": 304210,
      "end_ms": 305890,
      "text": "把干部和群众两分"
    },
    {
      "ordinal": 96,
      "start_ms": 305890,
      "end_ms": 308250,
      "text": "把革命者和群众对立起来"
    },
    {
      "ordinal": 97,
      "start_ms": 308250,
      "end_ms": 311570,
      "text": "群众路线是真正的精髓"
    },
    {
      "ordinal": 98,
      "start_ms": 311570,
      "end_ms": 315460,
      "text": "是要意识到革命家是从群众当中长出来的"
    },
    {
      "ordinal": 99,
      "start_ms": 315700,
      "end_ms": 319300,
      "text": "并且革命团体是要长出新的群众的生存样态"
    },
    {
      "ordinal": 100,
      "start_ms": 319300,
      "end_ms": 321700,
      "text": "的生存形式的新的群众性"
    },
    {
      "ordinal": 101,
      "start_ms": 321700,
      "end_ms": 324460,
      "text": "平民性和群众性"
    },
    {
      "ordinal": 102,
      "start_ms": 325570,
      "end_ms": 326770,
      "text": "因为平民性"
    },
    {
      "ordinal": 103,
      "start_ms": 326770,
      "end_ms": 327530,
      "text": "咱们说平民性"
    },
    {
      "ordinal": 104,
      "start_ms": 327530,
      "end_ms": 330270,
      "text": "他对立面是非平民职业选手"
    },
    {
      "ordinal": 105,
      "start_ms": 330270,
      "end_ms": 331450,
      "text": "群众性的话"
    },
    {
      "ordinal": 106,
      "start_ms": 331450,
      "end_ms": 334770,
      "text": "但是群众性的概念是要包囊括了"
    },
    {
      "ordinal": 107,
      "start_ms": 334770,
      "end_ms": 340870,
      "text": "他比这个革命家的职业革命性要高要更大"
    },
    {
      "ordinal": 108,
      "start_ms": 348220,
      "end_ms": 351960,
      "text": "那么我们进一步要来想的就是说呃"
    },
    {
      "ordinal": 109,
      "start_ms": 351960,
      "end_ms": 355060,
      "text": "这个官僚性和这个黑帮性"
    },
    {
      "ordinal": 110,
      "start_ms": 356680,
      "end_ms": 358520,
      "text": "One coin two sides"
    },
    {
      "ordinal": 111,
      "start_ms": 358520,
      "end_ms": 359960,
      "text": "我们英语说这一句"
    },
    {
      "ordinal": 112,
      "start_ms": 359960,
      "end_ms": 362360,
      "text": "那么就不展开来说了啊"
    },
    {
      "ordinal": 113,
      "start_ms": 362360,
      "end_ms": 365130,
      "text": "还有一个比较重要的是这个呃"
    },
    {
      "ordinal": 114,
      "start_ms": 365130,
      "end_ms": 366990,
      "text": "职业革命家的职业革命性"
    },
    {
      "ordinal": 115,
      "start_ms": 366990,
      "end_ms": 368750,
      "text": "他的职业性啊"
    },
    {
      "ordinal": 116,
      "start_ms": 368750,
      "end_ms": 370850,
      "text": "这个是我天天跟他们讲的"
    },
    {
      "ordinal": 117,
      "start_ms": 370850,
      "end_ms": 373549,
      "text": "来你们你们你们听不到啊"
    },
    {
      "ordinal": 118,
      "start_ms": 373549,
      "end_ms": 377469,
      "text": "他的这个职业性呢就是有一点非常重要的"
    },
    {
      "ordinal": 119,
      "start_ms": 377469,
      "end_ms": 383030,
      "text": "是对于这个世俗价值的超越性"
    },
    {
      "ordinal": 120,
      "start_ms": 383780,
      "end_ms": 386380,
      "text": "看似可以洋气这些世俗价值"
    },
    {
      "ordinal": 121,
      "start_ms": 386380,
      "end_ms": 391140,
      "text": "但是实际上呢这个超越性呢是啊"
    },
    {
      "ordinal": 122,
      "start_ms": 391140,
      "end_ms": 394200,
      "text": "平民性当中世俗价值之间的"
    },
    {
      "ordinal": 123,
      "start_ms": 394200,
      "end_ms": 396400,
      "text": "没有每种世俗性的价值"
    },
    {
      "ordinal": 124,
      "start_ms": 396400,
      "end_ms": 399040,
      "text": "我说世俗中的超越性的价值啊"
    },
    {
      "ordinal": 125,
      "start_ms": 399040,
      "end_ms": 400160,
      "text": "不是世俗性的价值"
    },
    {
      "ordinal": 126,
      "start_ms": 400160,
      "end_ms": 402390,
      "text": "不是那个什么好吃好玩好喝"
    },
    {
      "ordinal": 127,
      "start_ms": 402390,
      "end_ms": 405170,
      "text": "不是这不是这种世俗性的吃世俗中的"
    },
    {
      "ordinal": 128,
      "start_ms": 405170,
      "end_ms": 408320,
      "text": "平民当中的普通人当中的超越的价值"
    },
    {
      "ordinal": 129,
      "start_ms": 408320,
      "end_ms": 410580,
      "text": "就是爱情的忠诚啊"
    },
    {
      "ordinal": 130,
      "start_ms": 410580,
      "end_ms": 413960,
      "text": "还有就是比如说这种教育的这个追求真善美啊"
    },
    {
      "ordinal": 131,
      "start_ms": 413960,
      "end_ms": 416640,
      "text": "啊哇列表这种东西他是绝对的价值"
    },
    {
      "ordinal": 132,
      "start_ms": 416640,
      "end_ms": 418100,
      "text": "他就有某种绝对性啊"
    },
    {
      "ordinal": 133,
      "start_ms": 418100,
      "end_ms": 420620,
      "text": "或者说这样士为知己者死的"
    },
    {
      "ordinal": 134,
      "start_ms": 420620,
      "end_ms": 424440,
      "text": "超越死亡的那种忠诚信赖信义啊"
    },
    {
      "ordinal": 135,
      "start_ms": 424440,
      "end_ms": 427720,
      "text": "这些绝对性之间相互之间有内在矛盾和冲突"
    },
    {
      "ordinal": 136,
      "start_ms": 428920,
      "end_ms": 430600,
      "text": "他们的矛盾和冲突"
    },
    {
      "ordinal": 137,
      "start_ms": 430600,
      "end_ms": 434480,
      "text": "被历史的这个散散散乱"
    },
    {
      "ordinal": 138,
      "start_ms": 434480,
      "end_ms": 440060,
      "text": "和这个某种局部的单向度所遮蔽的"
    },
    {
      "ordinal": 139,
      "start_ms": 441230,
      "end_ms": 444990,
      "text": "但是他们内在的这些价值之间是有这个清"
    },
    {
      "ordinal": 140,
      "start_ms": 444990,
      "end_ms": 448170,
      "text": "彼此的倾轧和彼此的遮蔽啊"
    },
    {
      "ordinal": 141,
      "start_ms": 448170,
      "end_ms": 451680,
      "text": "互相的这个纠葛的"
    },
    {
      "ordinal": 142,
      "start_ms": 453600,
      "end_ms": 454620,
      "text": "这个纠葛"
    },
    {
      "ordinal": 143,
      "start_ms": 454620,
      "end_ms": 459560,
      "text": "他是更深层的这个现实生产关系和交往范式中"
    },
    {
      "ordinal": 144,
      "start_ms": 459560,
      "end_ms": 462120,
      "text": "的内在矛盾所生产出来的"
    },
    {
      "ordinal": 145,
      "start_ms": 462590,
      "end_ms": 465250,
      "text": "我们要讲的是职业革命家的职业性"
    },
    {
      "ordinal": 146,
      "start_ms": 465250,
      "end_ms": 468520,
      "text": "还包括对于这些啊"
    },
    {
      "ordinal": 147,
      "start_ms": 468520,
      "end_ms": 471460,
      "text": "平民生活中的绝对价值的相互冲突"
    },
    {
      "ordinal": 148,
      "start_ms": 471460,
      "end_ms": 475270,
      "text": "他在寻找一种新的调和的"
    },
    {
      "ordinal": 149,
      "start_ms": 475270,
      "end_ms": 478470,
      "text": "或者推动矛盾进一步发展的方案"
    },
    {
      "ordinal": 150,
      "start_ms": 479549,
      "end_ms": 483429,
      "text": "但是这种尝试不能够被简单地理解成"
    },
    {
      "ordinal": 151,
      "start_ms": 483429,
      "end_ms": 484649,
      "text": "职业革命家团体"
    },
    {
      "ordinal": 152,
      "start_ms": 484649,
      "end_ms": 485889,
      "text": "他的纪律"
    },
    {
      "ordinal": 153,
      "start_ms": 488940,
      "end_ms": 493200,
      "text": "这些活动就可以完全无视人伦道德"
    },
    {
      "ordinal": 154,
      "start_ms": 493200,
      "end_ms": 495880,
      "text": "华德华就是完全就是手段主义啊"
    },
    {
      "ordinal": 155,
      "start_ms": 495880,
      "end_ms": 497340,
      "text": "不择手段"
    },
    {
      "ordinal": 156,
      "start_ms": 498269,
      "end_ms": 500949,
      "text": "他但但也不是简单的理解成"
    },
    {
      "ordinal": 157,
      "start_ms": 500949,
      "end_ms": 502549,
      "text": "就是说啊革命家的这个东西"
    },
    {
      "ordinal": 158,
      "start_ms": 502549,
      "end_ms": 504389,
      "text": "你要生成新的世俗价值"
    },
    {
      "ordinal": 159,
      "start_ms": 504389,
      "end_ms": 506020,
      "text": "他不是这个意义上的"
    },
    {
      "ordinal": 160,
      "start_ms": 506020,
      "end_ms": 507860,
      "text": "我们说的更凄惨一点"
    },
    {
      "ordinal": 161,
      "start_ms": 510020,
      "end_ms": 512159,
      "text": "文历史当中啊"
    },
    {
      "ordinal": 162,
      "start_ms": 514839,
      "end_ms": 516419,
      "text": "悲剧是不可避免的"
    },
    {
      "ordinal": 163,
      "start_ms": 516419,
      "end_ms": 518519,
      "text": "在很多情况下"
    },
    {
      "ordinal": 164,
      "start_ms": 519870,
      "end_ms": 522590,
      "text": "超越现役就是革命"
    },
    {
      "ordinal": 165,
      "start_ms": 522590,
      "end_ms": 524910,
      "text": "作为一种临时手段"
    },
    {
      "ordinal": 166,
      "start_ms": 525170,
      "end_ms": 527370,
      "text": "他对于现实价值的超越性"
    },
    {
      "ordinal": 167,
      "start_ms": 528370,
      "end_ms": 532530,
      "text": "也代表他其实做出了决绝的牺牲"
    },
    {
      "ordinal": 168,
      "start_ms": 532530,
      "end_ms": 537350,
      "text": "但它不是全然美好的东西"
    },
    {
      "ordinal": 169,
      "start_ms": 545040,
      "end_ms": 546800,
      "text": "就你就可以理解成那是"
    },
    {
      "ordinal": 170,
      "start_ms": 546800,
      "end_ms": 550040,
      "text": "那那比如说爱情的绝对性和亲情的绝对性"
    },
    {
      "ordinal": 171,
      "start_ms": 550040,
      "end_ms": 551600,
      "text": "搁那吵架"
    },
    {
      "ordinal": 172,
      "start_ms": 555420,
      "end_ms": 558620,
      "text": "那革命的介入就是把把强行拆散"
    },
    {
      "ordinal": 173,
      "start_ms": 558620,
      "end_ms": 560430,
      "text": "甚至把一方给杀了"
    },
    {
      "ordinal": 174,
      "start_ms": 560670,
      "end_ms": 562870,
      "text": "他也是最恶悲哀的"
    },
    {
      "ordinal": 175,
      "start_ms": 562870,
      "end_ms": 564370,
      "text": "然后另外一方疯掉了"
    },
    {
      "ordinal": 176,
      "start_ms": 564370,
      "end_ms": 565290,
      "text": "跑远了"
    },
    {
      "ordinal": 177,
      "start_ms": 565290,
      "end_ms": 569880,
      "text": "他有的时候我说的不能够完全工具"
    },
    {
      "ordinal": 178,
      "start_ms": 569880,
      "end_ms": 574920,
      "text": "把一切这个世俗的至高的绝对性能的追求"
    },
    {
      "ordinal": 179,
      "start_ms": 574920,
      "end_ms": 576560,
      "text": "绝对性的追求都当成工具"
    },
    {
      "ordinal": 180,
      "start_ms": 576560,
      "end_ms": 578400,
      "text": "另外一方面"
    },
    {
      "ordinal": 181,
      "start_ms": 579160,
      "end_ms": 582819,
      "text": "他的悲剧性的宿命就在于它只能作为工具存在"
    },
    {
      "ordinal": 182,
      "start_ms": 582819,
      "end_ms": 587839,
      "text": "而且是把自身的达成作为一个历史使命"
    },
    {
      "ordinal": 183,
      "start_ms": 587839,
      "end_ms": 589599,
      "text": "伪装成是目的"
    },
    {
      "ordinal": 184,
      "start_ms": 589599,
      "end_ms": 593460,
      "text": "而实现了他的工具性的存在"
    },
    {
      "ordinal": 185,
      "start_ms": 594160,
      "end_ms": 595700,
      "text": "这种攻击性的存在"
    },
    {
      "ordinal": 186,
      "start_ms": 595700,
      "end_ms": 600720,
      "text": "以一种悲剧的甚至罪恶肮脏的方式"
    },
    {
      "ordinal": 187,
      "start_ms": 600720,
      "end_ms": 606280,
      "text": "把盘踞在旧的利额经济基础上面的"
    },
    {
      "ordinal": 188,
      "start_ms": 606280,
      "end_ms": 608440,
      "text": "这些绝对性的图腾"
    },
    {
      "ordinal": 189,
      "start_ms": 608440,
      "end_ms": 613200,
      "text": "崇拜的上层建筑给啊搞得混乱或者搞垮"
    },
    {
      "ordinal": 190,
      "start_ms": 613200,
      "end_ms": 614080,
      "text": "肃清了"
    },
    {
      "ordinal": 191,
      "start_ms": 614080,
      "end_ms": 615820,
      "text": "那么在新的经济基础当中"
    },
    {
      "ordinal": 192,
      "start_ms": 615820,
      "end_ms": 619220,
      "text": "可以长出新的价值范式"
    },
    {
      "ordinal": 193,
      "start_ms": 619220,
      "end_ms": 621700,
      "text": "新的最高标准啊"
    },
    {
      "ordinal": 194,
      "start_ms": 621700,
      "end_ms": 627230,
      "text": "他所以他就有这样一种嗯悲剧性的色彩"
    },
    {
      "ordinal": 195,
      "start_ms": 632160,
      "end_ms": 632680,
      "text": "好吧"
    },
    {
      "ordinal": 196,
      "start_ms": 634040,
      "end_ms": 635080,
      "text": "那么在这一上讲"
    },
    {
      "ordinal": 197,
      "start_ms": 635080,
      "end_ms": 640100,
      "text": "我们说嗯就革命的这种啊"
    },
    {
      "ordinal": 198,
      "start_ms": 640100,
      "end_ms": 642319,
      "text": "非平民性"
    },
    {
      "ordinal": 199,
      "start_ms": 642639,
      "end_ms": 647799,
      "text": "它兼具机关的或者是官僚的这样的形式性"
    },
    {
      "ordinal": 200,
      "start_ms": 650370,
      "end_ms": 658970,
      "text": "也也兼具这个黑帮化的这种暴烈性和悲剧性"
    },
    {
      "ordinal": 201,
      "start_ms": 663540,
      "end_ms": 670030,
      "text": "所以我们非要把这个额这个革命简"
    },
    {
      "ordinal": 202,
      "start_ms": 670030,
      "end_ms": 673930,
      "text": "或者说作为非平民性的革命性"
    },
    {
      "ordinal": 203,
      "start_ms": 678920,
      "end_ms": 682200,
      "text": "For modest for moist"
    },
    {
      "ordinal": 204,
      "start_ms": 682200,
      "end_ms": 684000,
      "text": "A for moaic"
    },
    {
      "ordinal": 205,
      "start_ms": 685800,
      "end_ms": 687200,
      "text": "悲剧"
    },
    {
      "ordinal": 206,
      "start_ms": 688740,
      "end_ms": 691060,
      "text": "我靠英语都记不得了"
    },
    {
      "ordinal": 207,
      "start_ms": 691060,
      "end_ms": 692140,
      "text": "我现在脑子秀逗了"
    },
    {
      "ordinal": 208,
      "start_ms": 693540,
      "end_ms": 695180,
      "text": "tragedy啊"
    },
    {
      "ordinal": 209,
      "start_ms": 695180,
      "end_ms": 696780,
      "text": "好吧"
    },
    {
      "ordinal": 210,
      "start_ms": 699680,
      "end_ms": 706210,
      "text": "所以这个可以深化你们对于从平民性去了解"
    },
    {
      "ordinal": 211,
      "start_ms": 706210,
      "end_ms": 707730,
      "text": "那么形式性的悲剧性"
    },
    {
      "ordinal": 212,
      "start_ms": 707730,
      "end_ms": 710470,
      "text": "那意味着它的内容可以不是悲剧"
    },
    {
      "ordinal": 213,
      "start_ms": 710470,
      "end_ms": 712310,
      "text": "一在从内容上"
    },
    {
      "ordinal": 214,
      "start_ms": 712310,
      "end_ms": 714960,
      "text": "他可以就是说呃"
    },
    {
      "ordinal": 215,
      "start_ms": 714960,
      "end_ms": 719149,
      "text": "囊括包含承接历史当中的平民性"
    },
    {
      "ordinal": 216,
      "start_ms": 719149,
      "end_ms": 721669,
      "text": "或者说承载他的幸福"
    },
    {
      "ordinal": 217,
      "start_ms": 721669,
      "end_ms": 724640,
      "text": "但从形式上它一定是悲剧"
    },
    {
      "ordinal": 218,
      "start_ms": 724640,
      "end_ms": 726760,
      "text": "而这种悲剧意味着取消"
    },
    {
      "ordinal": 219,
      "start_ms": 726760,
      "end_ms": 729390,
      "text": "意味着冲撞"
    },
    {
      "ordinal": 220,
      "start_ms": 729390,
      "end_ms": 734020,
      "text": "或者意味着摧毁他为新的价值"
    },
    {
      "ordinal": 221,
      "start_ms": 734020,
      "end_ms": 736800,
      "text": "生成他的历史的新的范式"
    },
    {
      "ordinal": 222,
      "start_ms": 736800,
      "end_ms": 738960,
      "text": "在扫清障碍"
    },
    {
      "ordinal": 223,
      "start_ms": 741760,
      "end_ms": 743960,
      "text": "所以大清洗在字面意义上讲"
    },
    {
      "ordinal": 224,
      "start_ms": 743960,
      "end_ms": 747240,
      "text": "它不是对于具体人口的大清洗"
    },
    {
      "ordinal": 225,
      "start_ms": 747240,
      "end_ms": 750420,
      "text": "或者说内奸叛徒的大清洗"
    },
    {
      "ordinal": 226,
      "start_ms": 751900,
      "end_ms": 756620,
      "text": "他是对于原有价值基础的大清洗清理"
    },
    {
      "ordinal": 227,
      "start_ms": 759180,
      "end_ms": 762180,
      "text": "所以他是大写的字母带来的"
    },
    {
      "ordinal": 228,
      "start_ms": 762180,
      "end_ms": 765060,
      "text": "我们今天不是给斯大林主义主义做辩护"
    },
    {
      "ordinal": 229,
      "start_ms": 765060,
      "end_ms": 767290,
      "text": "我们只是说啊"
    },
    {
      "ordinal": 230,
      "start_ms": 767290,
      "end_ms": 770590,
      "text": "让你们丰富对于平民性和非平民性的辩"
    },
    {
      "ordinal": 231,
      "start_ms": 770590,
      "end_ms": 773869,
      "text": "证关系的把握好吧"
    },
    {
      "ordinal": 232,
      "start_ms": 773869,
      "end_ms": 775309,
      "text": "那就讲到这里啊"
    },
    {
      "ordinal": 233,
      "start_ms": 775309,
      "end_ms": 781160,
      "text": "我们要始终去坚定的去"
    },
    {
      "ordinal": 234,
      "start_ms": 784160,
      "end_ms": 786100,
      "text": "然后要辩证的去把握"
    },
    {
      "ordinal": 235,
      "start_ms": 786100,
      "end_ms": 788349,
      "text": "坚定的去运用理性"
    },
    {
      "ordinal": 236,
      "start_ms": 788349,
      "end_ms": 790469,
      "text": "运用我们的基本的辩证唯物主义"
    },
    {
      "ordinal": 237,
      "start_ms": 790469,
      "end_ms": 790749,
      "text": "历史"
    },
    {
      "ordinal": 238,
      "start_ms": 790749,
      "end_ms": 797514,
      "text": "唯物主义的基本的信仰啊和辩证法的方法"
    },
    {
      "ordinal": 239,
      "start_ms": 806620,
      "end_ms": 809780,
      "text": "去中介平民性向非平民性的过渡"
    },
    {
      "ordinal": 240,
      "start_ms": 809780,
      "end_ms": 812940,
      "text": "尤其向职业革命家的职业性的过渡"
    },
    {
      "ordinal": 241,
      "start_ms": 813629,
      "end_ms": 816630,
      "text": "嗯好吧"
    },
    {
      "ordinal": 242,
      "start_ms": 816630,
      "end_ms": 819610,
      "text": "其他的更多的那那些东西没办法跟你们讲啊"
    },
    {
      "ordinal": 243,
      "start_ms": 819610,
      "end_ms": 823570,
      "text": "没办法在公开平台上向你们再说说明白"
    },
    {
      "ordinal": 244,
      "start_ms": 823570,
      "end_ms": 825280,
      "text": "这不是个遗憾"
    },
    {
      "ordinal": 245,
      "start_ms": 825280,
      "end_ms": 827540,
      "text": "让我活下来永远不是个遗憾"
    },
    {
      "ordinal": 246,
      "start_ms": 827540,
      "end_ms": 831130,
      "text": "让我发挥更大的历史价值啊"
    },
    {
      "ordinal": 247,
      "start_ms": 831130,
      "end_ms": 835410,
      "text": "让更多的行动去催生更多的历史机会"
    },
    {
      "ordinal": 248,
      "start_ms": 835410,
      "end_ms": 838479,
      "text": "历史机遇挑战的空间啊"
    },
    {
      "ordinal": 249,
      "start_ms": 838479,
      "end_ms": 839939,
      "text": "承接挑战的空间"
    },
    {
      "ordinal": 250,
      "start_ms": 839939,
      "end_ms": 843479,
      "text": "这非但不是你们的不幸"
    },
    {
      "ordinal": 251,
      "start_ms": 843720,
      "end_ms": 846160,
      "text": "这是你们所有人的幸运"
    },
    {
      "ordinal": 252,
      "start_ms": 846160,
      "end_ms": 846720,
      "text": "好吧"
    },
    {
      "ordinal": 253,
      "start_ms": 846720,
      "end_ms": 848040,
      "text": "就讲到这里啊"
    }
  ],
