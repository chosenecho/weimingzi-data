{"segments":[{"start":1.34,"end":8.33,"text":"嗯我们要处理好这个平民性和非平民性的关系"},{"start":8.81,"end":11.23,"text":"那么对我们个人来讲的话"},{"start":11.23,"end":12.61,"text":"就是"},{"start":14.06,"end":17.06,"text":"平面性是相当重要的"},{"start":17.929,"end":19.129,"text":"因为没有平民性"},{"start":19.129,"end":21.729,"text":"你就失去了呃"},{"start":21.729,"end":27.87,"text":"你的首先失去了你的力量的来源啊"},{"start":27.87,"end":30.31,"text":"纯粹的职业性或者非平民性"},{"start":31.39,"end":33.53,"text":"他的资源是非常有限的"},{"start":33.53,"end":37.81,"text":"因为职业选手的规模也是很小的"},{"start":37.81,"end":39.27,"text":"另外一方面呢"},{"start":39.27,"end":42.29,"text":"如果你完全摒弃平民性的话"},{"start":42.29,"end":44.97,"text":"不把自己当成一个平民的话"},{"start":47.54,"end":49.66,"text":"你是没有办法呃"},{"start":49.66,"end":52.14,"text":"理解到就是"},{"start":55.66,"end":59.86,"text":"革命最终是要做一种生活方式的转变"},{"start":59.86,"end":61.46,"text":"那么生活方式转变"},{"start":61.46,"end":64.26,"text":"与其说是职业革命家的生活方式的转变"},{"start":64.26,"end":65.3,"text":"更重要的"},{"start":65.3,"end":70.26,"text":"不如说更啊是这个平民的生活方式转变"},{"start":70.26,"end":72.44,"text":"你光是一小撮人转变的生活方式"},{"start":72.44,"end":73.88,"text":"那算什么成功呢"},{"start":73.88,"end":74.56,"text":"对不对"},{"start":74.56,"end":78.2,"text":"你要是要带动一整个人类的社群共同体"},{"start":78.2,"end":81.489,"text":"来生成新的平民性"},{"start":81.489,"end":83.229,"text":"所以平民性很重要"},{"start":83.229,"end":85.66,"text":"所以在这个意义上讲啊"},{"start":85.66,"end":89.56,"text":"在一个目力可及的一个历史时期当中"},{"start":89.56,"end":93.84,"text":"生产力啊不太可能有特别巨大的一个飞跃"},{"start":93.84,"end":95.6,"text":"生产关系可以加以调整"},{"start":95.6,"end":98.15,"text":"那么在这种情况下呃"},{"start":98.15,"end":99.45,"text":"在情感上"},{"start":99.45,"end":103.91,"text":"在这个呃亲密关系上面"},{"start":103.91,"end":110.5,"text":"还包括在一些这个个人的生活的寄托上"},{"start":110.5,"end":113.16,"text":"保有比较大的平民性"},{"start":113.16,"end":115.5,"text":"这不是什么问题啊"},{"start":115.5,"end":118.1,"text":"但是平民心不代不代表保守性"},{"start":118.1,"end":118.62,"text":"明白吗"},{"start":118.62,"end":125.04,"text":"平民一一样可以就是说做好准备迎接变化啊"},{"start":125.04,"end":126.32,"text":"一样可以激进"},{"start":126.32,"end":127.34,"text":"这是一方面"},{"start":127.34,"end":130.52,"text":"另外一方面我们要看到平民性的对立面"},{"start":130.52,"end":133.54,"text":"非平民性他其实没有那么简单的"},{"start":133.54,"end":136.18,"text":"它分我们认为可以分三种"},{"start":136.18,"end":138.64,"text":"一是咳非平民性"},{"start":138.64,"end":140.96,"text":"一官僚性啊"},{"start":140.96,"end":141.94,"text":"官方性"},{"start":141.94,"end":145.25,"text":"二黑帮性"},{"start":145.25,"end":146.71,"text":"或者说某种前现代"},{"start":146.71,"end":154.48,"text":"或者说这个嗯就是那种底层暴力形成的嗯"},{"start":154.48,"end":157.78,"text":"喊打喊杀的生活啊"},{"start":157.78,"end":159.22,"text":"那么官僚系呢"},{"start":159.22,"end":161.98,"text":"他是把他的暴力呢"},{"start":161.98,"end":167.05,"text":"在常态下是分包给了他的黑帮性"},{"start":167.05,"end":169.07,"text":"那么第三个呢"},{"start":169.07,"end":173.28,"text":"非平民性对应的还有一个点是什么"},{"start":173.6,"end":177.5,"text":"其实我不想再引入这个学院性和这个宗教性"},{"start":177.5,"end":179.12,"text":"因为学术话语和宗教话语"},{"start":179.12,"end":182.06,"text":"也是平民性的一个补充啊"},{"start":182.06,"end":185.06,"text":"或者说是会介入平民性本身"},{"start":185.06,"end":187.649,"text":"去塑造平民性的自我想象的"},{"start":187.649,"end":190.309,"text":"那我们说的平民性的还有一个对立面"},{"start":190.309,"end":193.38,"text":"第三个对立面的应当就是革命性咳"},{"start":193.38,"end":197.51,"text":"所谓职业革命家的职业革命性咳咳"},{"start":198.35,"end":203.27,"text":"所以很多否定性激进否定性"},{"start":203.27,"end":205.91,"text":"他扬弃了平民性"},{"start":206.5,"end":210.22,"text":"要清醒地意识到啊"},{"start":210.22,"end":212.38,"text":"他阳气的有两个错误的方向"},{"start":212.38,"end":213.94,"text":"一是阳气成了官僚性"},{"start":213.94,"end":215.34,"text":"二是阳气成了黑帮性"},{"start":215.34,"end":218.85,"text":"这两个东西呢都反过来是倾轧了"},{"start":218.85,"end":222.3,"text":"或者说在蔑视鄙视着平民性"},{"start":222.3,"end":224.46,"text":"只有当他洋气自身"},{"start":224.46,"end":228.16,"text":"而成为了职业革命家的革命性的时候"},{"start":228.16,"end":231.14,"text":"他不会瞧不起平民性"},{"start":231.14,"end":233.84,"text":"他反而要去借鉴吸收"},{"start":233.84,"end":239.45,"text":"反而要接受平民性当中的同样的绝对的啊"},{"start":239.45,"end":244.56,"text":"以及它的总体性的对于革命性的洗礼"},{"start":244.92,"end":247.36,"text":"与其说是平民生活接受革命的洗礼"},{"start":247.36,"end":250.58,"text":"不如说我们在从平民生活当中"},{"start":250.58,"end":254.81,"text":"平民性当中阳气诞生出一种革命性的时候"},{"start":254.81,"end":259.339,"text":"革命性本身要反过来接受平民的绝对性"},{"start":259.339,"end":260.738,"text":"平民的根本价值"},{"start":260.738,"end":262.439,"text":"对于革命性的审视"},{"start":262.439,"end":265.439,"text":"对于他的试金"},{"start":268.4,"end":269.9,"text":"啊所以在这个意义上讲"},{"start":269.9,"end":272.22,"text":"职业革命家啊"},{"start":272.22,"end":274.12,"text":"他对于平民性的阳气"},{"start":274.12,"end":276.08,"text":"不是一般意义上的鄙视"},{"start":276.08,"end":283.44,"text":"超越超脱反过来可以控制蹂躏利用并非如此"},{"start":283.44,"end":288.949,"text":"而是一种非常嗯深刻的关系"},{"start":290.34,"end":293.12,"text":"啊这种深刻的关系啊"},{"start":293.12,"end":298.65,"text":"就是他绝对不是说啊"},{"start":298.65,"end":301.73,"text":"他肯定是就体现为群众路线这四个字"},{"start":301.73,"end":304.21,"text":"但是这种群众路线绝对不能被误解成"},{"start":304.21,"end":305.89,"text":"把干部和群众两分"},{"start":305.89,"end":308.25,"text":"把革命者和群众对立起来"},{"start":308.25,"end":311.57,"text":"群众路线是真正的精髓"},{"start":311.57,"end":315.46,"text":"是要意识到革命家是从群众当中长出来的"},{"start":315.7,"end":319.3,"text":"并且革命团体是要长出新的群众的生存样态"},{"start":319.3,"end":321.7,"text":"的生存形式的新的群众性"},{"start":321.7,"end":324.46,"text":"平民性和群众性"},{"start":325.57,"end":326.77,"text":"因为平民性"},{"start":326.77,"end":327.53,"text":"咱们说平民性"},{"start":327.53,"end":330.27,"text":"他对立面是非平民职业选手"},{"start":330.27,"end":331.45,"text":"群众性的话"},{"start":331.45,"end":334.77,"text":"但是群众性的概念是要包囊括了"},{"start":334.77,"end":340.87,"text":"他比这个革命家的职业革命性要高要更大"},{"start":348.22,"end":351.96,"text":"那么我们进一步要来想的就是说呃"},{"start":351.96,"end":355.06,"text":"这个官僚性和这个黑帮性"},{"start":356.68,"end":358.52,"text":"One coin two sides"},{"start":358.52,"end":359.96,"text":"我们英语说这一句"},{"start":359.96,"end":362.36,"text":"那么就不展开来说了啊"},{"start":362.36,"end":365.13,"text":"还有一个比较重要的是这个呃"},{"start":365.13,"end":366.99,"text":"职业革命家的职业革命性"},{"start":366.99,"end":368.75,"text":"他的职业性啊"},{"start":368.75,"end":370.85,"text":"这个是我天天跟他们讲的"},{"start":370.85,"end":373.549,"text":"来你们你们你们听不到啊"},{"start":373.549,"end":377.469,"text":"他的这个职业性呢就是有一点非常重要的"},{"start":377.469,"end":383.03,"text":"是对于这个世俗价值的超越性"},{"start":383.78,"end":386.38,"text":"看似可以洋气这些世俗价值"},{"start":386.38,"end":391.14,"text":"但是实际上呢这个超越性呢是啊"},{"start":391.14,"end":394.2,"text":"平民性当中世俗价值之间的"},{"start":394.2,"end":396.4,"text":"没有每种世俗性的价值"},{"start":396.4,"end":399.04,"text":"我说世俗中的超越性的价值啊"},{"start":399.04,"end":400.16,"text":"不是世俗性的价值"},{"start":400.16,"end":402.39,"text":"不是那个什么好吃好玩好喝"},{"start":402.39,"end":405.17,"text":"不是这不是这种世俗性的吃世俗中的"},{"start":405.17,"end":408.32,"text":"平民当中的普通人当中的超越的价值"},{"start":408.32,"end":410.58,"text":"就是爱情的忠诚啊"},{"start":410.58,"end":413.96,"text":"还有就是比如说这种教育的这个追求真善美啊"},{"start":413.96,"end":416.64,"text":"啊哇列表这种东西他是绝对的价值"},{"start":416.64,"end":418.1,"text":"他就有某种绝对性啊"},{"start":418.1,"end":420.62,"text":"或者说这样士为知己者死的"},{"start":420.62,"end":424.44,"text":"超越死亡的那种忠诚信赖信义啊"},{"start":424.44,"end":427.72,"text":"这些绝对性之间相互之间有内在矛盾和冲突"},{"start":428.92,"end":430.6,"text":"他们的矛盾和冲突"},{"start":430.6,"end":434.48,"text":"被历史的这个散散散乱"},{"start":434.48,"end":440.06,"text":"和这个某种局部的单向度所遮蔽的"},{"start":441.23,"end":444.99,"text":"但是他们内在的这些价值之间是有这个清"},{"start":444.99,"end":448.17,"text":"彼此的倾轧和彼此的遮蔽啊"},{"start":448.17,"end":451.68,"text":"互相的这个纠葛的"},{"start":453.6,"end":454.62,"text":"这个纠葛"},{"start":454.62,"end":459.56,"text":"他是更深层的这个现实生产关系和交往范式中"},{"start":459.56,"end":462.12,"text":"的内在矛盾所生产出来的"},{"start":462.59,"end":465.25,"text":"我们要讲的是职业革命家的职业性"},{"start":465.25,"end":468.52,"text":"还包括对于这些啊"},{"start":468.52,"end":471.46,"text":"平民生活中的绝对价值的相互冲突"},{"start":471.46,"end":475.27,"text":"他在寻找一种新的调和的"},{"start":475.27,"end":478.47,"text":"或者推动矛盾进一步发展的方案"},{"start":479.549,"end":483.429,"text":"但是这种尝试不能够被简单地理解成"},{"start":483.429,"end":484.649,"text":"职业革命家团体"},{"start":484.649,"end":485.889,"text":"他的纪律"},{"start":488.94,"end":493.2,"text":"这些活动就可以完全无视人伦道德"},{"start":493.2,"end":495.88,"text":"华德华就是完全就是手段主义啊"},{"start":495.88,"end":497.34,"text":"不择手段"},{"start":498.269,"end":500.949,"text":"他但但也不是简单的理解成"},{"start":500.949,"end":502.549,"text":"就是说啊革命家的这个东西"},{"start":502.549,"end":504.389,"text":"你要生成新的世俗价值"},{"start":504.389,"end":506.02,"text":"他不是这个意义上的"},{"start":506.02,"end":507.86,"text":"我们说的更凄惨一点"},{"start":510.02,"end":512.159,"text":"文历史当中啊"},{"start":514.839,"end":516.419,"text":"悲剧是不可避免的"},{"start":516.419,"end":518.519,"text":"在很多情况下"},{"start":519.87,"end":522.59,"text":"超越现役就是革命"},{"start":522.59,"end":524.91,"text":"作为一种临时手段"},{"start":525.17,"end":527.37,"text":"他对于现实价值的超越性"},{"start":528.37,"end":532.53,"text":"也代表他其实做出了决绝的牺牲"},{"start":532.53,"end":537.35,"text":"但它不是全然美好的东西"},{"start":545.04,"end":546.8,"text":"就你就可以理解成那是"},{"start":546.8,"end":550.04,"text":"那那比如说爱情的绝对性和亲情的绝对性"},{"start":550.04,"end":551.6,"text":"搁那吵架"},{"start":555.42,"end":558.62,"text":"那革命的介入就是把把强行拆散"},{"start":558.62,"end":560.43,"text":"甚至把一方给杀了"},{"start":560.67,"end":562.87,"text":"他也是最恶悲哀的"},{"start":562.87,"end":564.37,"text":"然后另外一方疯掉了"},{"start":564.37,"end":565.29,"text":"跑远了"},{"start":565.29,"end":569.88,"text":"他有的时候我说的不能够完全工具"},{"start":569.88,"end":574.92,"text":"把一切这个世俗的至高的绝对性能的追求"},{"start":574.92,"end":576.56,"text":"绝对性的追求都当成工具"},{"start":576.56,"end":578.4,"text":"另外一方面"},{"start":579.16,"end":582.819,"text":"他的悲剧性的宿命就在于它只能作为工具存在"},{"start":582.819,"end":587.839,"text":"而且是把自身的达成作为一个历史使命"},{"start":587.839,"end":589.599,"text":"伪装成是目的"},{"start":589.599,"end":593.46,"text":"而实现了他的工具性的存在"},{"start":594.16,"end":595.7,"text":"这种攻击性的存在"},{"start":595.7,"end":600.72,"text":"以一种悲剧的甚至罪恶肮脏的方式"},{"start":600.72,"end":606.28,"text":"把盘踞在旧的利额经济基础上面的"},{"start":606.28,"end":608.44,"text":"这些绝对性的图腾"},{"start":608.44,"end":613.2,"text":"崇拜的上层建筑给啊搞得混乱或者搞垮"},{"start":613.2,"end":614.08,"text":"肃清了"},{"start":614.08,"end":615.82,"text":"那么在新的经济基础当中"},{"start":615.82,"end":619.22,"text":"可以长出新的价值范式"},{"start":619.22,"end":621.7,"text":"新的最高标准啊"},{"start":621.7,"end":627.23,"text":"他所以他就有这样一种嗯悲剧性的色彩"},{"start":632.16,"end":632.68,"text":"好吧"},{"start":634.04,"end":635.08,"text":"那么在这一上讲"},{"start":635.08,"end":640.1,"text":"我们说嗯就革命的这种啊"},{"start":640.1,"end":642.319,"text":"非平民性"},{"start":642.639,"end":647.799,"text":"它兼具机关的或者是官僚的这样的形式性"},{"start":650.37,"end":658.97,"text":"也也兼具这个黑帮化的这种暴烈性和悲剧性"},{"start":663.54,"end":670.03,"text":"所以我们非要把这个额这个革命简"},{"start":670.03,"end":673.93,"text":"或者说作为非平民性的革命性"},{"start":678.92,"end":682.2,"text":"For modest for moist"},{"start":682.2,"end":684.0,"text":"A for moaic"},{"start":685.8,"end":687.2,"text":"悲剧"},{"start":688.74,"end":691.06,"text":"我靠英语都记不得了"},{"start":691.06,"end":692.14,"text":"我现在脑子秀逗了"},{"start":693.54,"end":695.18,"text":"tragedy啊"},{"start":695.18,"end":696.78,"text":"好吧"},{"start":699.68,"end":706.21,"text":"所以这个可以深化你们对于从平民性去了解"},{"start":706.21,"end":707.73,"text":"那么形式性的悲剧性"},{"start":707.73,"end":710.47,"text":"那意味着它的内容可以不是悲剧"},{"start":710.47,"end":712.31,"text":"一在从内容上"},{"start":712.31,"end":714.96,"text":"他可以就是说呃"},{"start":714.96,"end":719.149,"text":"囊括包含承接历史当中的平民性"},{"start":719.149,"end":721.669,"text":"或者说承载他的幸福"},{"start":721.669,"end":724.64,"text":"但从形式上它一定是悲剧"},{"start":724.64,"end":726.76,"text":"而这种悲剧意味着取消"},{"start":726.76,"end":729.39,"text":"意味着冲撞"},{"start":729.39,"end":734.02,"text":"或者意味着摧毁他为新的价值"},{"start":734.02,"end":736.8,"text":"生成他的历史的新的范式"},{"start":736.8,"end":738.96,"text":"在扫清障碍"},{"start":741.76,"end":743.96,"text":"所以大清洗在字面意义上讲"},{"start":743.96,"end":747.24,"text":"它不是对于具体人口的大清洗"},{"start":747.24,"end":750.42,"text":"或者说内奸叛徒的大清洗"},{"start":751.9,"end":756.62,"text":"他是对于原有价值基础的大清洗清理"},{"start":759.18,"end":762.18,"text":"所以他是大写的字母带来的"},{"start":762.18,"end":765.06,"text":"我们今天不是给斯大林主义主义做辩护"},{"start":765.06,"end":767.29,"text":"我们只是说啊"},{"start":767.29,"end":770.59,"text":"让你们丰富对于平民性和非平民性的辩"},{"start":770.59,"end":773.869,"text":"证关系的把握好吧"},{"start":773.869,"end":775.309,"text":"那就讲到这里啊"},{"start":775.309,"end":781.16,"text":"我们要始终去坚定的去"},{"start":784.16,"end":786.1,"text":"然后要辩证的去把握"},{"start":786.1,"end":788.349,"text":"坚定的去运用理性"},{"start":788.349,"end":790.469,"text":"运用我们的基本的辩证唯物主义"},{"start":790.469,"end":790.749,"text":"历史"},{"start":790.749,"end":797.514,"text":"唯物主义的基本的信仰啊和辩证法的方法"},{"start":806.62,"end":809.78,"text":"去中介平民性向非平民性的过渡"},{"start":809.78,"end":812.94,"text":"尤其向职业革命家的职业性的过渡"},{"start":813.629,"end":816.63,"text":"嗯好吧"},{"start":816.63,"end":819.61,"text":"其他的更多的那那些东西没办法跟你们讲啊"},{"start":819.61,"end":823.57,"text":"没办法在公开平台上向你们再说说明白"},{"start":823.57,"end":825.28,"text":"这不是个遗憾"},{"start":825.28,"end":827.54,"text":"让我活下来永远不是个遗憾"},{"start":827.54,"end":831.13,"text":"让我发挥更大的历史价值啊"},{"start":831.13,"end":835.41,"text":"让更多的行动去催生更多的历史机会"},{"start":835.41,"end":838.479,"text":"历史机遇挑战的空间啊"},{"start":838.479,"end":839.939,"text":"承接挑战的空间"},{"start":839.939,"end":843.479,"text":"这非但不是你们的不幸"},{"start":843.72,"end":846.16,"text":"这是你们所有人的幸运"},{"start":846.16,"end":846.72,"text":"好吧"},{"start":846.72,"end":848.04,"text":"就讲到这里啊"}],"source":"subtitle"}
