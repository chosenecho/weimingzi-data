t":1812.129,"end":1814.12,"text":"但是我们有钱"},{"start":1814.52,"end":1815.54,"text":"但没人手"},{"start":1815.54,"end":1815.92,"text":"对不对"},{"start":1815.92,"end":1817.58,"text":"有人守在外面去招聘"},{"start":1817.58,"end":1818.56,"text":"我们也可以招聘"},{"start":1818.56,"end":1821.72,"text":"但是不一定他坚持我们的理念"},{"start":1823.2,"end":1825.56,"text":"然后还有一点就是我们会被举报"},{"start":1825.68,"end":1827.68,"text":"我们会被恶意举报"},{"start":1827.68,"end":1829.2,"text":"会被恶意财政"},{"start":1829.2,"end":1831.51,"text":"恶意举报扭曲污蔑"},{"start":1831.51,"end":1836.31,"text":"所以我们的发展是不不同于一般的社会团体"},{"start":1836.31,"end":1838.87,"text":"一般的企业的呐"},{"start":1838.87,"end":1840.8,"text":"反正结论是我们会发展"},{"start":1840.8,"end":1844.53,"text":"我的心情也会时好时坏啊"},{"start":1844.53,"end":1847.13,"text":"我会对于这些敌对的行为"},{"start":1847.13,"end":1850.69,"text":"敌对的群体个人采取什么样的措施"},{"start":1850.69,"end":1853.33,"text":"其实很多情况下就是我一个人说了算"},{"start":1854.93,"end":1857.33,"text":"但是我也会和大家讨论"},{"start":1857.72,"end":1863.52,"text":"我也会非常审慎地非常仔细的去想办法"},{"start":1863.52,"end":1865.28,"text":"如何去反制"},{"start":1865.78,"end":1867.62,"text":"我们不可能永远坐以待毙的"},{"start":1867.62,"end":1867.98,"text":"对不对"},{"start":1869.02,"end":1871.179,"text":"我没有报大学生金币"},{"start":1871.179,"end":1873.019,"text":"大学生在我线下俱乐部"},{"start":1873.019,"end":1875.499,"text":"你妈270块吃多少顿饭"},{"start":1875.71,"end":1878.15,"text":"你如果算换算成市场价格"},{"start":1878.15,"end":1880.91,"text":"我觉得他一个月在我这吃的东西的钱"},{"start":1880.91,"end":1882.31,"text":"远远超出1000块钱"},{"start":1883.39,"end":1886.26,"text":"六个菜几乎都是荤菜"},{"start":1887.74,"end":1890.26,"text":"有的时候五个菜四菜一汤"},{"start":1890.81,"end":1892.93,"text":"他说这来晚晚上吃晚饭的"},{"start":1892.93,"end":1894.51,"text":"每天他妈三四十号人"},{"start":1894.51,"end":1895.85,"text":"不是他大学生"},{"start":1895.85,"end":1897.13,"text":"他收入低嘛"},{"start":1897.13,"end":1898.57,"text":"没钱钱比较少"},{"start":1898.57,"end":1900.075,"text":"他占便宜很正常"},{"start":1900.13,"end":1902.05,"text":"非常正常啊"},{"start":1902.05,"end":1905.14,"text":"你再说有的时候靠自觉的"},{"start":1905.14,"end":1905.92,"text":"但不靠自觉"},