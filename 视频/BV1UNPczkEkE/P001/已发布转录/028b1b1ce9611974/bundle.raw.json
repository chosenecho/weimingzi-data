{"segments":[{"start":0.0,"end":3.5,"text":"讲一讲我们的这个在农村啊"},{"start":3.5,"end":6.91,"text":"就是说啊主要城市反哺农村啊"},{"start":6.91,"end":10.38,"text":"城乡协同发展啊"},{"start":10.38,"end":13.24,"text":"这乡村振兴的这个我们的工作思路啊"},{"start":13.24,"end":15.0,"text":"我们工作思路是这样的"},{"start":15.0,"end":16.5,"text":"就是要做一个承诺"},{"start":16.5,"end":25.61,"text":"就是呃粮油的专门生产的农田"},{"start":26.05,"end":31.97,"text":"在比例上至少50%以上"},{"start":32.29,"end":32.81,"text":"好吧"},{"start":32.81,"end":34.25,"text":"先给一个这个承诺啊"},{"start":34.25,"end":37.09,"text":"就是像我们在我的置顶动态里面说的"},{"start":37.09,"end":38.42,"text":"培训部师生的"},{"start":38.42,"end":42.54,"text":"也就是说劳动者啊他的比例要40%以上"},{"start":42.54,"end":45.93,"text":"那我对于这个农村这边的呃"},{"start":45.93,"end":49.51,"text":"我们在农村当中的这个出境啊"},{"start":49.51,"end":52.71,"text":"就是投身这个乡村振兴工作"},{"start":52.71,"end":54.84,"text":"就是说就拿地"},{"start":54.84,"end":59.19,"text":"拿这个就是租用这个农村土地农田"},{"start":59.19,"end":60.75,"text":"那么有一个基本原则"},{"start":60.75,"end":68.229,"text":"就是用来这个种植粮油的油菜"},{"start":68.229,"end":71.949,"text":"和这个比如水稻啊或者小麦啊"},{"start":71.949,"end":74.4,"text":"嗯他的比例"},{"start":74.4,"end":77.7,"text":"他这个土地面积的比例要大于50%"},{"start":77.7,"end":79.56,"text":"好在这个基础之上"},{"start":79.56,"end":82.36,"text":"我们来讲啊这个事情怎么做"},{"start":82.44,"end":87.73,"text":"就是我们会在一些呃这个土地的"},{"start":87.73,"end":92.27,"text":"就是租用价格比较便宜的省份的那种"},{"start":92.27,"end":94.835,"text":"五六线小城市啊"},{"start":95.4,"end":98.44,"text":"啊他就是或者就乡村了"},{"start":98.44,"end":99.28,"text":"这就是乡村了"},{"start":99.28,"end":101.35,"text":"里面去租一些"},{"start":103.77,"end":104.47,"text":"农田"},{"start":104.47,"end":106.65,"text":"那么尽量是租高品质农田"},{"start":106.65,"end":112.1,"text":"那么现在这些农田的这个租用价格"},{"start":112.1,"end":113.6,"text":"非常非常便宜啊"},{"start":113.6,"end":117.7,"text":"就是说一年如果你不经由二到手的话"},{"start":117.7,"end":120.26,"text":"其实是他对外的价格"},{"start":120.26,"end":124.13,"text":"收到农户手里的价格是200元一亩一年"},{"start":125.33,"end":129.33,"text":"然后你进个二到手中介一下那个300块"},{"start":129.33,"end":130.8,"text":"300多一点"},{"start":131.08,"end":132.44,"text":"那么这样的土地呢"},{"start":132.44,"end":136.72,"text":"就是说我们以100亩为单位去拿"},{"start":136.72,"end":138.08,"text":"在同一个点"},{"start":138.76,"end":139.28,"text":"100亩"},{"start":139.28,"end":139.64,"text":"100亩"},{"start":139.64,"end":140.52,"text":"这样去拿"},{"start":140.52,"end":144.01,"text":"然后他是一年哦"},{"start":144.01,"end":148.63,"text":"一年的这个花销在这个3万多"},{"start":148.63,"end":151.09,"text":"然后再加上农药种子化肥"},{"start":151.09,"end":152.37,"text":"还有就是这个"},{"start":152.37,"end":154.21,"text":"而且我尽量拿高品质的土地"},{"start":154.21,"end":157.44,"text":"就是它连片的较为平坦的"},{"start":157.72,"end":162.44,"text":"然后是他的一年的投入"},{"start":162.44,"end":168.23,"text":"在11万12万这个样子啊"},{"start":168.23,"end":169.63,"text":"11万12万这个样子"},{"start":169.63,"end":173.05,"text":"如果是纯粹种这个粮油的话"},{"start":173.05,"end":178.29,"text":"他的这个产出在20万左右吧"},{"start":178.48,"end":181.52,"text":"啊或者说反正就是几万块钱那个一盈余啊"},{"start":181.52,"end":183.42,"text":"那么"},{"start":184.9,"end":187.22,"text":"粮油如果他产的主要是粮油"},{"start":187.22,"end":190.46,"text":"这部分呢就地销售掉啊"},{"start":190.46,"end":191.94,"text":"可以就地销售掉"},{"start":191.94,"end":192.7,"text":"他是真的"},{"start":192.7,"end":193.86,"text":"我们不是说囤地的啊"},{"start":193.86,"end":197.22,"text":"我们不是囤囤积居囤积居奇的那种"},{"start":197.22,"end":198.42,"text":"不不囤地"},{"start":198.42,"end":200.67,"text":"而是确实这些土地租用的是"},{"start":200.67,"end":202.11,"text":"那么它有什么作用呢"},{"start":202.11,"end":207.36,"text":"什么功能呢啊有几方面的功能啊"},{"start":207.36,"end":211.979,"text":"几方面的功能就是一是生活服务的"},{"start":211.979,"end":214.839,"text":"生活服务部的这些就是就近的"},{"start":214.839,"end":217.89,"text":"生活服务部里面的这些顾客会员"},{"start":217.89,"end":219.73,"text":"它可以就近啊"},{"start":219.73,"end":221.13,"text":"在就近的原则之下"},{"start":221.13,"end":225.459,"text":"可以有部分的农产品是我们自己生产的"},{"start":225.819,"end":228.77,"text":"然后呢需要有人去种"},{"start":228.77,"end":229.23,"text":"对不对"},{"start":229.23,"end":230.25,"text":"需要有人种"},{"start":230.25,"end":233.32,"text":"他可以是有点体验生活性质的"},{"start":233.32,"end":235.18,"text":"基本上是一个月去一次"},{"start":235.18,"end":236.9,"text":"他整个这个波动周期里面"},{"start":236.9,"end":239.07,"text":"他去个四五次啊"},{"start":239.07,"end":240.35,"text":"这个就就行了"},{"start":240.35,"end":241.53,"text":"体验生活性质"},{"start":241.53,"end":245.92,"text":"但如果说是专职的去呃耕种的"},{"start":245.92,"end":247.1,"text":"所谓的耕种啊"},{"start":247.1,"end":250.8,"text":"实际上就是说去操控无人机低空经济"},{"start":250.8,"end":253.76,"text":"去把农药喷一遍啊"},{"start":253.76,"end":255.38,"text":"化肥喷一遍"},{"start":255.38,"end":256.339,"text":"这个样子"},{"start":256.339,"end":258.279,"text":"化肥撒一遍"},{"start":259.54,"end":264.56,"text":"然后把他那个灌溉去灌一下啊"},{"start":268.22,"end":270.84,"text":"比如说为生活服务部的人"},{"start":270.84,"end":275.66,"text":"提供了一个去接触这个农业生产呃"},{"start":275.66,"end":277.1,"text":"实践的机会"},{"start":277.1,"end":280.56,"text":"同时它还有一定的这个食品产出"},{"start":280.56,"end":283.36,"text":"直接可以就近消化"},{"start":283.83,"end":288.67,"text":"还有一点是要围绕这些百亩以上的这些农田"},{"start":288.67,"end":293.34,"text":"在农村去开设啊"},{"start":293.34,"end":295.72,"text":"我们叫做保障性的食堂"},{"start":295.72,"end":297.51,"text":"城市反哺农村"},{"start":297.51,"end":301.09,"text":"这个东西呢就是说他的农产品的富余"},{"start":301.09,"end":304.81,"text":"他一定的现金经济收入是要在本地"},{"start":304.81,"end":309.95,"text":"就是说首先我们基本原则他是要回本"},{"start":309.95,"end":310.37,"text":"对不对"},{"start":310.37,"end":311.75,"text":"但是盈利那部分拿出来"},{"start":311.75,"end":312.91,"text":"怎样盈利"},{"start":312.91,"end":316.62,"text":"那部分拿出来就是让本地的老农民老人"},{"start":316.62,"end":320.67,"text":"特别是没有保障的老人啊"},{"start":320.67,"end":322.71,"text":"有东西吃啊"},{"start":322.71,"end":329.34,"text":"就是你可以再花个什么一年几一两千"},{"start":329.34,"end":331.12,"text":"甚至就几百块钱租一个店"},{"start":331.12,"end":334.539,"text":"租一个在村里面租一个小食堂"},{"start":334.539,"end":335.259,"text":"然后呢"},{"start":335.259,"end":338.4,"text":"这个是一开始需要有人去规范一下"},{"start":338.4,"end":339.26,"text":"他的操作流程"},{"start":339.26,"end":340.6,"text":"带一带到后面"},{"start":340.6,"end":341.96,"text":"实际上是就农村的比较"},{"start":341.96,"end":343.34,"text":"就是一大爷大妈"},{"start":343.34,"end":346.32,"text":"她自己在那边每天起锅做饭"},{"start":346.32,"end":351.39,"text":"然后把那些就是啊生活上缺乏保障的老人啊"},{"start":351.39,"end":357.249,"text":"就会把他们的一日三餐给他给他保障了啊"},{"start":357.249,"end":360.129,"text":"这米面粮油自产的肉呢"},{"start":360.129,"end":364.569,"text":"是这个盈利部分的这个现金去村里面去打的啊"},{"start":364.569,"end":370.36,"text":"然后这样可以实现一个就地的兜底"},{"start":370.6,"end":374.6,"text":"然后呢这个形成了一个这么一个这么一个机制"},{"start":374.6,"end":375.26,"text":"之后"},{"start":375.26,"end":377.8,"text":"我们定期的会去"},{"start":377.8,"end":380.45,"text":"比如说呃"},{"start":380.97,"end":387.75,"text":"可以就是可以设点去做做那种留守儿童的晚托"},{"start":387.75,"end":389.81,"text":"留守儿童的晚托"},{"start":389.81,"end":392.85,"text":"正儿八经的给他们上点课也好"},{"start":392.85,"end":395.69,"text":"或者说就是给他们就是长点见识"},{"start":395.69,"end":398.29,"text":"不要一天到晚玩玩玩手机"},{"start":398.29,"end":400.31,"text":"玩王者荣耀看抖音"},{"start":400.31,"end":407.48,"text":"然后另外一方面呢是他们可以去观察调研"},{"start":407.48,"end":411.109,"text":"中国农村基层的一个明白吧"},{"start":411.109,"end":413.109,"text":"我们要防止他资本主义异化呀"},{"start":413.109,"end":415.769,"text":"还有很多农业公司在这个过程当中"},{"start":415.769,"end":416.889,"text":"是我们的竞争对手"},{"start":416.889,"end":419.39,"text":"或者说是我们蚕食对象啊"},{"start":419.39,"end":419.95,"text":"天敌啊"},{"start":419.95,"end":421.29,"text":"是这种性质的"},{"start":421.29,"end":425.419,"text":"他们拿了地是不管老百姓死活的啊"},{"start":425.419,"end":426.399,"text":"这个工作的话"},{"start":426.399,"end":430.27,"text":"我们今年已经呃过几天第一笔款子到位"},{"start":430.27,"end":433.98,"text":"然后我们要去这个这个四川某市"},{"start":433.98,"end":436.54,"text":"要拿100亩地先做试点"},{"start":436.54,"end":439.48,"text":"然后这个人呢我已经配齐了"},{"start":439.76,"end":441.04,"text":"两地的人都配齐了"},{"start":441.04,"end":443.22,"text":"我这边派三个人"},{"start":443.78,"end":446.84,"text":"然后那边成都俱乐部里面啊"},{"start":446.84,"end":447.9,"text":"现在不叫俱乐部了"},{"start":447.9,"end":451.659,"text":"生活服务部啊啊他或者他培训部的"},{"start":451.659,"end":454.179,"text":"成都那边会定期的出去出成员"},{"start":454.179,"end":460.02,"text":"到这个呃这个农田那边去来部署落实这件事情"},{"start":461.06,"end":462.84,"text":"死命的定要做成啊"},{"start":462.84,"end":464.4,"text":"这个是我们已经达成决议了"},{"start":464.4,"end":465.28,"text":"这是死命令"},{"start":465.28,"end":466.58,"text":"今年一定要做成"},{"start":466.58,"end":469.37,"text":"然后是那边是种两季"},{"start":469.37,"end":472.83,"text":"然后把食堂的这个还有最好有个晚托班"},{"start":472.83,"end":475.71,"text":"食堂晚托班再加两季的收成"},{"start":475.71,"end":477.01,"text":"搞定了之后"},{"start":477.01,"end":478.33,"text":"在徐州这边"},{"start":478.33,"end":480.95,"text":"或者说他往往西边一点去河南"},{"start":480.95,"end":483.93,"text":"或者说反正就不一定是江苏本省的"},{"start":483.93,"end":486.98,"text":"或者在一个要做第二个试点"},{"start":486.98,"end":488.34,"text":"也是100亩地"},{"start":488.34,"end":490.42,"text":"或者说如果说比较有经验的话"},{"start":490.42,"end":491.1,"text":"在徐州的话"},{"start":491.1,"end":492.54,"text":"再或者在河南的话"},{"start":492.54,"end":495.86,"text":"拿200亩地把这个做出来"},{"start":496.99,"end":497.91,"text":"这是死命令"},{"start":499.63,"end":501.11,"text":"这个我们所有的经费努力"},{"start":501.11,"end":503.09,"text":"都在往这个方向去靠拢"},{"start":503.33,"end":505.89,"text":"然后为此呢我们会猜测啊"},{"start":505.89,"end":508.25,"text":"一部分这个是什么啊"},{"start":508.25,"end":509.15,"text":"不必要的"},{"start":509.15,"end":512.64,"text":"或者说啊明白吧"},{"start":512.64,"end":514.799,"text":"我们我们要把力量集中到这件事"},{"start":514.799,"end":516.799,"text":"这些事情上面去做"},{"start":517.5,"end":520.458,"text":"然后到了夏天的话呃"},{"start":520.458,"end":523.438,"text":"依然会有这个郑和支教的项目"},{"start":523.438,"end":524.999,"text":"正和陈胜的支教项目啊"},{"start":524.999,"end":525.859,"text":"还是会有"},{"start":525.859,"end":530.77,"text":"但是我们会优先就是去呃安排接纳"},{"start":530.77,"end":534.44,"text":"这个就是下乡做贡献"},{"start":534.44,"end":536.2,"text":"不仅仅就是说去教书了"},{"start":536.2,"end":536.92,"text":"还有其他方式"},{"start":536.92,"end":538.97,"text":"你还可以去种田啊"},{"start":538.97,"end":541.53,"text":"你也可以去那边去办食堂啊"},{"start":541.53,"end":544.37,"text":"你也可以去带小孩"},{"start":545.72,"end":551.14,"text":"啊然后我们会注意去搞好和这个村里面的这个"},{"start":553.82,"end":555.26,"text":"车尾的关系啊"},{"start":555.26,"end":556.93,"text":"反正就是这个"},{"start":556.93,"end":560.43,"text":"主要是你可以说我们是个农业投资公司"},{"start":560.43,"end":562.36,"text":"但是我们的目的不是盈利性的"},{"start":562.36,"end":564.88,"text":"就是微保本甚至微亏这件事情"},{"start":564.88,"end":565.6,"text":"微亏我都要做"},{"start":565.6,"end":568.64,"text":"或者说亏损是可接受的"},{"start":568.64,"end":570.77,"text":"我都会去去做这件事情"},{"start":570.77,"end":574.73,"text":"我并不指望说通过盈利把我投下去的钱赚回来"},{"start":575.73,"end":577.95,"text":"我不指望啊"},{"start":577.95,"end":579.51,"text":"一次投6万6万6万6万"},{"start":579.51,"end":581.15,"text":"这样去投投投60万"},{"start":581.15,"end":581.87,"text":"投600万"},{"start":581.87,"end":584.75,"text":"我不会想着把这600万收回来"},{"start":585.13,"end":588.53,"text":"因为这个东西就是所有人的退路"},{"start":589.17,"end":590.17,"text":"这是所有人推"},{"start":590.17,"end":592.85,"text":"这不仅仅是那些这个农村穷苦人的"},{"start":592.85,"end":594.55,"text":"就是穷苦老人的保障"},{"start":594.55,"end":598.58,"text":"他也是城市里面生活服务部啊"},{"start":598.58,"end":603.02,"text":"这很多这个穷兄弟是他们的退路啊"},{"start":603.02,"end":604.22,"text":"所以我们会"},{"start":604.22,"end":609.33,"text":"我们会把这个事情当成是今年这个很重要的啊"},{"start":612.47,"end":614.9,"text":"要去推啊"},{"start":614.9,"end":615.92,"text":"相比之下"},{"start":615.92,"end":619.1,"text":"其实呢这个这是我们自己的事情"},{"start":619.1,"end":620.66,"text":"这代表了我们的理想信念"},{"start":620.66,"end":622.02,"text":"代表了我们寻找的退路"},{"start":622.02,"end":623.3,"text":"还有我们主要的发展空间"},{"start":623.3,"end":626.55,"text":"甚至说我们的一个斗争的前线啊"},{"start":626.55,"end":628.87,"text":"因为你在农村里面确实有很多"},{"start":628.87,"end":629.25,"text":"这种"},{"start":629.25,"end":631.87,"text":"完全就只讲资本主义逻辑的"},{"start":631.87,"end":634.35,"text":"那些农业公司在里面的啊"},{"start":634.35,"end":637.599,"text":"还有一点就是啊我"},{"start":639.639,"end":643.48,"text":"不会说去炒作某种什么生态农业议题啊"},{"start":643.48,"end":646.71,"text":"什么非转基因什么这些东西的不上符号税"},{"start":646.71,"end":649.31,"text":"我会就是说我们按照比例来说"},{"start":649.31,"end":651.19,"text":"50%以上是粮油作物"},{"start":651.19,"end":653.75,"text":"那么可以50%以下是一些经济作物"},{"start":653.75,"end":656.14,"text":"但是这些经济作物我不会炒作"},{"start":656.14,"end":657.36,"text":"他有什么不得了的"},{"start":657.36,"end":659.68,"text":"什么什么要什么什么什么那种那种价值"},{"start":659.68,"end":661.72,"text":"我们不会这样玩啊"},{"start":661.72,"end":663.94,"text":"我们拒绝这样去搞啊"},{"start":663.94,"end":666.46,"text":"不可以种种些药材啊啊"},{"start":666.46,"end":668.4,"text":"或者说什么什么就是不给他上"},{"start":668.4,"end":674.66,"text":"就是要吸取吸取某些的那个吸明白吗"},{"start":674.66,"end":675.82,"text":"吸取某些教训啊"},{"start":675.82,"end":677.74,"text":"某些某些某些某些团体"},{"start":677.74,"end":680.94,"text":"他那个就是靠符号税把这个东西"},{"start":680.94,"end":683.34,"text":"这不是长久之计啊"},{"start":686.7,"end":687.22,"text":"好吧"},{"start":688.26,"end":693.57,"text":"这个是呃我们的一个农业方向的探索"},{"start":693.57,"end":695.37,"text":"农村工作的一个探索方向"},{"start":695.37,"end":698.23,"text":"然后是我们是以市场主体"},{"start":698.23,"end":699.49,"text":"民间主体"},{"start":699.49,"end":702.6,"text":"但是是我们是逆啊"},{"start":702.6,"end":704.3,"text":"逆资本主义逻辑而动"},{"start":705.38,"end":709.12,"text":"然后我们最愿意看见的是这样的尝试啊"},{"start":709.12,"end":709.96,"text":"能够得到效仿"},{"start":709.96,"end":715.3,"text":"或者说怎样的能够让农村的穷苦老人啊"},{"start":715.3,"end":716.56,"text":"吃到饭啊"},{"start":716.56,"end":717.86,"text":"吃到肉啊"},{"start":719.26,"end":722.2,"text":"粮油副食品都比较富足的一个状态"},{"start":722.2,"end":724.24,"text":"就是不花很多钱"},{"start":724.24,"end":725.96,"text":"只要做好组织"},{"start":725.96,"end":727.54,"text":"做好一个资源的协调"},{"start":727.54,"end":728.52,"text":"他就是能做的"},{"start":728.52,"end":729.48,"text":"但是能做到的"},{"start":729.48,"end":733.32,"text":"然后我们欢迎就是说是有识之士和我合作"},{"start":733.32,"end":737.25,"text":"然后我们自己也会去投真金白银去做这些事情"},{"start":737.45,"end":738.47,"text":"钱倒过来留"},{"start":739.23,"end":740.73,"text":"有了钱倒过来的钱"},{"start":740.73,"end":745.33,"text":"钱倒过来留才能这个饭顺当着来吃好吧"},{"start":745.33,"end":746.4,"text":"那就讲到这边"}],"source":"subtitle"}
