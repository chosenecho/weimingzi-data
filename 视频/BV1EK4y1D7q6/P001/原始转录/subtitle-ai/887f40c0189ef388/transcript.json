      "text": "You can survive"
    },
    {
      "ordinal": 259,
      "start_ms": 675060,
      "end_ms": 676350,
      "text": "不仅可以survive"
    },
    {
      "ordinal": 260,
      "start_ms": 676350,
      "end_ms": 677190,
      "text": "You can"
    },
    {
      "ordinal": 261,
      "start_ms": 677190,
      "end_ms": 678690,
      "text": "你可以immigrant"
    },
    {
      "ordinal": 262,
      "start_ms": 678690,
      "end_ms": 681500,
      "text": "而且不仅仅可以immigrant"
    },
    {
      "ordinal": 263,
      "start_ms": 681500,
      "end_ms": 684630,
      "text": "你还可以什么colonize"
    },
