{
  "bvid": "BV1Xa411W7vU",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "e82f0687254956602981fecbf5b9a390bdc13e95894980ed128885255144fae8",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 120,
      "end_ms": 1920,
      "text": "我们讲了一个简单的道理"
    },
    {
      "ordinal": 1,
      "start_ms": 1920,
      "end_ms": 3239,
      "text": "就是只要"
    },
    {
      "ordinal": 2,
      "start_ms": 5060,
      "end_ms": 6400,
      "text": "有饭吃"
    },
    {
      "ordinal": 3,
      "start_ms": 8620,
      "end_ms": 10180,
      "text": "有地方住"
    },
    {
      "ordinal": 4,
      "start_ms": 13140,
      "end_ms": 17780,
      "text": "就不要在"
    },
    {
      "ordinal": 5,
      "start_ms": 20020,
      "end_ms": 21640,
      "text": "劳动者的"
    },
    {
      "ordinal": 6,
      "start_ms": 24039,
      "end_ms": 27500,
      "text": "尊严上妥协"
    },
    {
      "ordinal": 7,
      "start_ms": 31379,
      "end_ms": 32119,
      "text": "有饭吃"
    },
    {
      "ordinal": 8,
      "start_ms": 32119,
      "end_ms": 33079,
      "text": "有地方住啊"
    },
    {
      "ordinal": 9,
      "start_ms": 33079,
      "end_ms": 35029,
      "text": "就是说你的基本生存权"
    },
    {
      "ordinal": 10,
      "start_ms": 35029,
      "end_ms": 36319,
      "text": "只要不危急"
    },
    {
      "ordinal": 11,
      "start_ms": 36319,
      "end_ms": 38080,
      "text": "只要不危急"
    },
    {
      "ordinal": 12,
      "start_ms": 40680,
      "end_ms": 42540,
      "text": "基本生存权"
    },
    {
      "ordinal": 13,
      "start_ms": 44300,
      "end_ms": 48850,
      "text": "你就不要在劳动者的尊严上妥协"
    },
    {
      "ordinal": 14,
      "start_ms": 48850,
      "end_ms": 53200,
      "text": "你的上级或者所谓的这个周一是等级制"
    },
    {
      "ordinal": 15,
      "start_ms": 53200,
      "end_ms": 54520,
      "text": "所谓的领导"
    },
    {
      "ordinal": 16,
      "start_ms": 54520,
      "end_ms": 56860,
      "text": "但凡有一点点"
    },
    {
      "ordinal": 17,
      "start_ms": 58920,
      "end_ms": 60350,
      "text": "侮辱你的尊严"
    },
    {
      "ordinal": 18,
      "start_ms": 60350,
      "end_ms": 61850,
      "text": "践踏你的尊严"
    },
    {
      "ordinal": 19,
      "start_ms": 61850,
      "end_ms": 66980,
      "text": "用不公平不平等的方式对待你"
    },
    {
      "ordinal": 20,
      "start_ms": 67060,
      "end_ms": 68500,
      "text": "我做公益不平等"
    },
    {
      "ordinal": 21,
      "start_ms": 68500,
      "end_ms": 71680,
      "text": "就是他没有做到按劳分配同工同酬"
    },
    {
      "ordinal": 22,
      "start_ms": 71680,
      "end_ms": 76940,
      "text": "或者说你觉得这个不按照分配不同工同酬的这个差距"
    },
    {
      "ordinal": 23,
      "start_ms": 77960,
      "end_ms": 81259,
      "text": "这个差距啊令人绝望"
    },
    {
      "ordinal": 24,
      "start_ms": 82420,
      "end_ms": 84880,
      "text": "嗯让你感觉到你是个包身工"
    },
    {
      "ordinal": 25,
      "start_ms": 86280,
      "end_ms": 89250,
      "text": "那就是践踏了你的事实的劳动者的尊严"
    },
    {
      "ordinal": 26,
      "start_ms": 89250,
      "end_ms": 90900,
      "text": "在这种情况下"
    },
    {
      "ordinal": 27,
      "start_ms": 90900,
      "end_ms": 92840,
      "text": "不叫妥协"
    },
    {
      "ordinal": 28,
      "start_ms": 93220,
      "end_ms": 94720,
      "text": "不要妥协"
    },
    {
      "ordinal": 29,
      "start_ms": 94720,
      "end_ms": 95920,
      "text": "要奋斗"
    },
    {
      "ordinal": 30,
      "start_ms": 95920,
      "end_ms": 97690,
      "text": "要奋起斗争"
    },
    {
      "ordinal": 31,
      "start_ms": 97690,
      "end_ms": 100520,
      "text": "奋斗奋斗就是奋起斗争"
    },
    {
      "ordinal": 32,
      "start_ms": 104780,
      "end_ms": 105940,
      "text": "只要你有饭吃"
    },
    {
      "ordinal": 33,
      "start_ms": 105940,
      "end_ms": 107060,
      "text": "有地方住"
    },
    {
      "ordinal": 34,
      "start_ms": 108520,
      "end_ms": 109680,
      "text": "回老家也好"
    },
    {
      "ordinal": 35,
      "start_ms": 111480,
      "end_ms": 112720,
      "text": "啃老也好"
    },
    {
      "ordinal": 36,
      "start_ms": 113900,
      "end_ms": 119600,
      "text": "但是说如果说你的家庭情况比较危险"
    },
    {
      "ordinal": 37,
      "start_ms": 121300,
      "end_ms": 126210,
      "text": "你的家庭情况比较困难很困难"
    },
    {
      "ordinal": 38,
      "start_ms": 126210,
      "end_ms": 127530,
      "text": "家庭情况非常困难"
    },
    {
      "ordinal": 39,
      "start_ms": 127530,
      "end_ms": 129340,
      "text": "很困难的这种情况"
    },
    {
      "ordinal": 40,
      "start_ms": 131520,
      "end_ms": 135260,
      "text": "所以说不危及你个人的吃饭住宿"
    },
    {
      "ordinal": 41,
      "start_ms": 135260,
      "end_ms": 137100,
      "text": "但是危及你父母"
    },
    {
      "ordinal": 42,
      "start_ms": 137619,
      "end_ms": 140549,
      "text": "危及你的至亲的这种情况"
    },
    {
      "ordinal": 43,
      "start_ms": 140549,
      "end_ms": 141989,
      "text": "你可以妥协"
    },
    {
      "ordinal": 44,
      "start_ms": 141989,
      "end_ms": 143579,
      "text": "但是你是个妥协"
    },
    {
      "ordinal": 45,
      "start_ms": 143579,
      "end_ms": 146160,
      "text": "当你的局面缓和之后"
    },
    {
      "ordinal": 46,
      "start_ms": 148779,
      "end_ms": 149969,
      "text": "就要调整"
    },
    {
      "ordinal": 47,
      "start_ms": 149969,
      "end_ms": 151960,
      "text": "缓和之后就要调整"
    },
    {
      "ordinal": 48,
      "start_ms": 152480,
      "end_ms": 157060,
      "text": "就要把之前让出去的要拿回来"
    },
    {
      "ordinal": 49,
      "start_ms": 158920,
      "end_ms": 161850,
      "text": "当然这个付出成本和代价可能会更大"
    },
    {
      "ordinal": 50,
      "start_ms": 161850,
      "end_ms": 163590,
      "text": "因为你第一次失手了"
    },
    {
      "ordinal": 51,
      "start_ms": 163590,
      "end_ms": 165180,
      "text": "第二次要把它拿回来"
    },
    {
      "ordinal": 52,
      "start_ms": 165180,
      "end_ms": 166520,
      "text": "成本代价更大"
    },
    {
      "ordinal": 53,
      "start_ms": 172140,
      "end_ms": 175040,
      "text": "要懂得上纲上线"
    },
    {
      "ordinal": 54,
      "start_ms": 184640,
      "end_ms": 187060,
      "text": "你把这个旗号占到最顶点"
    },
    {
      "ordinal": 55,
      "start_ms": 188740,
      "end_ms": 190290,
      "text": "只要你有饭吃"
    },
    {
      "ordinal": 56,
      "start_ms": 190290,
      "end_ms": 191580,
      "text": "我说只要你有饭吃"
    },
    {
      "ordinal": 57,
      "start_ms": 191580,
      "end_ms": 192480,
      "text": "有地方住"
    },
    {
      "ordinal": 58,
      "start_ms": 192480,
      "end_ms": 195420,
      "text": "或者可以维持个维持几个月"
    },
    {
      "ordinal": 59,
      "start_ms": 195420,
      "end_ms": 197610,
      "text": "有饭吃啊"
    },
    {
      "ordinal": 60,
      "start_ms": 197610,
      "end_ms": 198780,
      "text": "有地方住"
    },
    {
      "ordinal": 61,
      "start_ms": 198780,
      "end_ms": 200720,
      "text": "你不要拿什么"
    },
    {
      "ordinal": 62,
      "start_ms": 203179,
      "end_ms": 203899,
      "text": "你这样说"
    },
    {
      "ordinal": 63,
      "start_ms": 203899,
      "end_ms": 205339,
      "text": "如果要有房贷啊"
    },
    {
      "ordinal": 64,
      "start_ms": 205339,
      "end_ms": 206659,
      "text": "我要还房贷啊"
    },
    {
      "ordinal": 65,
      "start_ms": 206659,
      "end_ms": 208160,
      "text": "我要妥协呀"
    },
    {
      "ordinal": 66,
      "start_ms": 209360,
      "end_ms": 211100,
      "text": "你房子不能卖掉吗"
    },
    {
      "ordinal": 67,
      "start_ms": 212880,
      "end_ms": 216320,
      "text": "你房贷买的话要五六千块钱"
    },
    {
      "ordinal": 68,
      "start_ms": 216320,
      "end_ms": 218180,
      "text": "六七千块钱一个月才维持住"
    },
    {
      "ordinal": 69,
      "start_ms": 218180,
      "end_ms": 223220,
      "text": "那你这个就是有点说你已经卖掉了自己劳动尊严了"
    },
    {
      "ordinal": 70,
      "start_ms": 225410,
      "end_ms": 227120,
      "text": "要被一直践踏着"
    },
    {
      "ordinal": 71,
      "start_ms": 228559,
      "end_ms": 230289,
      "text": "那这个是你自己选的"
    },
    {
      "ordinal": 72,
      "start_ms": 230289,
      "end_ms": 232899,
      "text": "那我所以这个视频就不是拍给你看的"
    },
    {
      "ordinal": 73,
      "start_ms": 232899,
      "end_ms": 234740,
      "text": "你就可以滚出去了"
    },
    {
      "ordinal": 74,
      "start_ms": 234959,
      "end_ms": 241119,
      "text": "那么我们说的就是说还有一些社会博弈的冗余的原生形态啊"
    },
    {
      "ordinal": 75,
      "start_ms": 241119,
      "end_ms": 243260,
      "text": "道路还没有完全被确定的"
    },
    {
      "ordinal": 76,
      "start_ms": 245980,
      "end_ms": 248250,
      "text": "那你为什么要租2000块钱的单间"
    },
    {
      "ordinal": 77,
      "start_ms": 248250,
      "end_ms": 249060,
      "text": "租1000的"
    },
    {
      "ordinal": 78,
      "start_ms": 249060,
      "end_ms": 250260,
      "text": "你为什么要租1000呢"
    },
    {
      "ordinal": 79,
      "start_ms": 250260,
      "end_ms": 252720,
      "text": "租500的合租一个"
    },
    {
      "ordinal": 80,
      "start_ms": 255459,
      "end_ms": 258119,
      "text": "你对自己没人要狠一点"
    },
    {
      "ordinal": 81,
      "start_ms": 258119,
      "end_ms": 262359,
      "text": "你在工作单位劳动的过程当中"
    },
    {
      "ordinal": 82,
      "start_ms": 262359,
      "end_ms": 263919,
      "text": "你受到的这种委屈"
    },
    {
      "ordinal": 83,
      "start_ms": 263919,
      "end_ms": 266920,
      "text": "受到这种屈辱就可以少一点"
    },
    {
      "ordinal": 84,
      "start_ms": 267600,
      "end_ms": 271520,
      "text": "当然你要有更多的有自己更多的关于你这个东西"
    },
    {
      "ordinal": 85,
      "start_ms": 271520,
      "end_ms": 274600,
      "text": "要靠你的活动力"
    },
    {
      "ordinal": 86,
      "start_ms": 274600,
      "end_ms": 278020,
      "text": "你自己的活动能力和工友啊"
    },
    {
      "ordinal": 87,
      "start_ms": 278020,
      "end_ms": 281340,
      "text": "和这个同伴达成一致"
    },
    {
      "ordinal": 88,
      "start_ms": 281340,
      "end_ms": 284260,
      "text": "还有一个是你自己的技术能力"
    },
    {
      "ordinal": 89,
      "start_ms": 285240,
      "end_ms": 286520,
      "text": "技术能力"
    },
    {
      "ordinal": 90,
      "start_ms": 286520,
      "end_ms": 290960,
      "text": "你在这个岗位上的不可替代性议价权"
    },
    {
      "ordinal": 91,
      "start_ms": 290960,
      "end_ms": 294420,
      "text": "这两点都都是决定你的议价权"
    },
    {
      "ordinal": 92,
      "start_ms": 297620,
      "end_ms": 300220,
      "text": "一价钱同时也是维持尊严的权威"
    },
    {
      "ordinal": 93,
      "start_ms": 300220,
      "end_ms": 301400,
      "text": "维尊权"
    },
    {
      "ordinal": 94,
      "start_ms": 302880,
      "end_ms": 304160,
      "text": "你的脸皮子"
    },
    {
      "ordinal": 95,
      "start_ms": 304160,
      "end_ms": 306080,
      "text": "你的尊严要维持溢价权"
    },
    {
      "ordinal": 96,
      "start_ms": 306080,
      "end_ms": 307460,
      "text": "所以我们在这强调一遍"
    },
    {
      "ordinal": 97,
      "start_ms": 307460,
      "end_ms": 310519,
      "text": "就是说当你有一定的议价权利"
    },
    {
      "ordinal": 98,
      "start_ms": 310519,
      "end_ms": 311659,
      "text": "维持尊严的权利的时候"
    },
    {
      "ordinal": 99,
      "start_ms": 311659,
      "end_ms": 317750,
      "text": "然后你的生存和住宿三五个月你能够维持"
    },
    {
      "ordinal": 100,
      "start_ms": 317750,
      "end_ms": 320000,
      "text": "不会受到危机的时候"
    },
    {
      "ordinal": 101,
      "start_ms": 320000,
      "end_ms": 321780,
      "text": "要大胆的"
    },
    {
      "ordinal": 102,
      "start_ms": 323340,
      "end_ms": 327480,
      "text": "坚决的维护"
    },
    {
      "ordinal": 103,
      "start_ms": 329160,
      "end_ms": 330980,
      "text": "劳动者的尊严"
    },
    {
      "ordinal": 104,
      "start_ms": 337040,
      "end_ms": 338380,
      "text": "知命令"
    },
    {
      "ordinal": 105,
      "start_ms": 338960,
      "end_ms": 340240,
      "text": "这不叫命令"
    },
    {
      "ordinal": 106,
      "start_ms": 340240,
      "end_ms": 341860,
      "text": "就必须要这样做"
    },
    {
      "ordinal": 107,
      "start_ms": 341860,
      "end_ms": 343210,
      "text": "不这样做的话"
    },
    {
      "ordinal": 108,
      "start_ms": 343210,
      "end_ms": 344800,
      "text": "局势会越来越糟糕"
    },
    {
      "ordinal": 109,
      "start_ms": 344800,
      "end_ms": 350120,
      "text": "不这样做就是叫助长助长一个腐败"
    },
    {
      "ordinal": 110,
      "start_ms": 351579,
      "end_ms": 353699,
      "text": "助战某种文化腐败"
    },
    {
      "ordinal": 111,
      "start_ms": 353699,
      "end_ms": 357760,
      "text": "某种道德堕落"
    },
    {
      "ordinal": 112,
      "start_ms": 358940,
      "end_ms": 365100,
      "text": "助长共同体的根本精神"
    },
    {
      "ordinal": 113,
      "start_ms": 367759,
      "end_ms": 369240,
      "text": "的颓丧"
    },
    {
      "ordinal": 114,
      "start_ms": 370840,
      "end_ms": 372840,
      "text": "颓败腿我都不会写了"
    },
    {
      "ordinal": 115,
      "start_ms": 374520,
      "end_ms": 375480,
      "text": "对呀"
    },
    {
      "ordinal": 116,
      "start_ms": 378000,
      "end_ms": 380000,
      "text": "我靠腿"
    },
    {
      "ordinal": 117,
      "start_ms": 381680,
      "end_ms": 382640,
      "text": "我不管了"
    },
    {
      "ordinal": 118,
      "start_ms": 382640,
      "end_ms": 384620,
      "text": "腿上并着头"
    },
    {
      "ordinal": 119,
      "start_ms": 386840,
      "end_ms": 389140,
      "text": "我昨天弄清楚这个锤子怎么洗啊"
    },
    {
      "ordinal": 120,
      "start_ms": 389140,
      "end_ms": 390320,
      "text": "颓废的颓"
    },
    {
      "ordinal": 121,
      "start_ms": 392460,
      "end_ms": 394080,
      "text": "哦是叶子旁"
    },
    {
      "ordinal": 122,
      "start_ms": 394080,
      "end_ms": 394620,
      "text": "叶子旁"
    },
    {
      "ordinal": 123,
      "start_ms": 394620,
      "end_ms": 397820,
      "text": "叶子旁的腿上"
    },
    {
      "ordinal": 124,
      "start_ms": 403220,
      "end_ms": 406560,
      "text": "可以说如果你放任这种事情发生的话"
    },
    {
      "ordinal": 125,
      "start_ms": 406840,
      "end_ms": 408820,
      "text": "放任你的尊严被践踏的话"
    },
    {
      "ordinal": 126,
      "start_ms": 408820,
      "end_ms": 410460,
      "text": "你是个帮凶哦"
    },
    {
      "ordinal": 127,
      "start_ms": 411540,
      "end_ms": 413900,
      "text": "不仅你自己的尊严被践踏了"
    },
    {
      "ordinal": 128,
      "start_ms": 413900,
      "end_ms": 417240,
      "text": "普遍的劳动者的所有人的尊严都被践踏了"
    },
    {
      "ordinal": 129,
      "start_ms": 417340,
      "end_ms": 421420,
      "text": "那个布尔乔亚那个老板或者那个暴发户"
    },
    {
      "ordinal": 130,
      "start_ms": 421420,
      "end_ms": 422560,
      "text": "他得逞了"
    },
    {
      "ordinal": 131,
      "start_ms": 422560,
      "end_ms": 423460,
      "text": "在这个意义上讲"
    },
    {
      "ordinal": 132,
      "start_ms": 423460,
      "end_ms": 424700,
      "text": "你是帮凶"
    },
    {
      "ordinal": 133,
      "start_ms": 425060,
      "end_ms": 426940,
      "text": "你是一个纵容犯"
    },
    {
      "ordinal": 134,
      "start_ms": 429120,
      "end_ms": 431960,
      "text": "你虽然它的可耻是占99%"
    },
    {
      "ordinal": 135,
      "start_ms": 431960,
      "end_ms": 434060,
      "text": "但是你占了1%的可耻"
    },
    {
      "ordinal": 136,
      "start_ms": 434060,
      "end_ms": 435290,
      "text": "你的软弱"
    },
    {
      "ordinal": 137,
      "start_ms": 435290,
      "end_ms": 439380,
      "text": "你的侥幸心理唤醒"
    },
    {
      "ordinal": 138,
      "start_ms": 440400,
      "end_ms": 442310,
      "text": "因为我情人节忍受一下"
    },
    {
      "ordinal": 139,
      "start_ms": 442310,
      "end_ms": 443870,
      "text": "他不会把我怎么样"
    },
    {
      "ordinal": 140,
      "start_ms": 443870,
      "end_ms": 445680,
      "text": "无非就是被他骂两句"
    },
    {
      "ordinal": 141,
      "start_ms": 445940,
      "end_ms": 447280,
      "text": "那你这种"
    },
    {
      "ordinal": 142,
      "start_ms": 449540,
      "end_ms": 452500,
      "text": "千里之堤溃于溃于溃于蚁穴"
    },
    {
      "ordinal": 143,
      "start_ms": 452500,
      "end_ms": 454480,
      "text": "当你不能做到这一点的时候"
    },
    {
      "ordinal": 144,
      "start_ms": 454480,
      "end_ms": 458030,
      "text": "不能做到即刻去维持维护你的尊严的时候"
    },
    {
      "ordinal": 145,
      "start_ms": 458030,
      "end_ms": 459380,
      "text": "你是个叛徒"
    },
    {
      "ordinal": 146,
      "start_ms": 461340,
      "end_ms": 462900,
      "text": "啊你是个可悲的"
    },
    {
      "ordinal": 147,
      "start_ms": 462900,
      "end_ms": 464340,
      "text": "你是一个失败者"
    },
    {
      "ordinal": 148,
      "start_ms": 464340,
      "end_ms": 465380,
      "text": "投降的"
    },
    {
      "ordinal": 149,
      "start_ms": 468780,
      "end_ms": 470240,
      "text": "这一点我们要说清楚"
    },
    {
      "ordinal": 150,
      "start_ms": 470240,
      "end_ms": 471860,
      "text": "而且现在零零后啊"
    },
    {
      "ordinal": 151,
      "start_ms": 471860,
      "end_ms": 474320,
      "text": "他附魔好多都是"
    },
    {
      "ordinal": 152,
      "start_ms": 476460,
      "end_ms": 477920,
      "text": "你有工作没工作"
    },
    {
      "ordinal": 153,
      "start_ms": 477920,
      "end_ms": 479780,
      "text": "你反正你就算有工作"
    },
    {
      "ordinal": 154,
      "start_ms": 479780,
      "end_ms": 480890,
      "text": "你挣不到几个钱"
    },
    {
      "ordinal": 155,
      "start_ms": 480890,
      "end_ms": 482450,
      "text": "你回家你总有饭吃"
    },
    {
      "ordinal": 156,
      "start_ms": 482450,
      "end_ms": 483440,
      "text": "所以在这种情况下"
    },
    {
      "ordinal": 157,
      "start_ms": 483440,
      "end_ms": 487010,
      "text": "你更需要你们这一代人要团结起来"
    },
    {
      "ordinal": 158,
      "start_ms": 487010,
      "end_ms": 490520,
      "text": "要懂得维护自己的尊严"
    },
    {
      "ordinal": 159,
      "start_ms": 490520,
      "end_ms": 491480,
      "text": "合法权益"
    },
    {
      "ordinal": 160,
      "start_ms": 491480,
      "end_ms": 492800,
      "text": "当然也包括在尊严里面"
    },
    {
      "ordinal": 161,
      "start_ms": 492800,
      "end_ms": 498559,
      "text": "有的时候对合法权益的践踏也是不仅仅是践踏你的尊严"
    },
    {
      "ordinal": 162,
      "start_ms": 498559,
      "end_ms": 501199,
      "text": "还践踏整个国家法律的尊严"
    },
    {
      "ordinal": 163,
      "start_ms": 501199,
      "end_ms": 504460,
      "text": "共同体意志最高表达形式的尊严"
    },
    {
      "ordinal": 164,
      "start_ms": 505420,
      "end_ms": 507920,
      "text": "主要表达形式不一定是最高的"
    },
    {
      "ordinal": 165,
      "start_ms": 508740,
      "end_ms": 515510,
      "text": "最高的话是一些文学层面放画放出来的一些什么计划战略这种东西"
    },
    {
      "ordinal": 166,
      "start_ms": 515510,
      "end_ms": 516860,
      "text": "那我们就讲到这边"
    },
    {
      "ordinal": 167,
      "start_ms": 516860,
      "end_ms": 521318,
      "text": "我希望我就是如果你是懦夫"
    },
    {
      "ordinal": 168,
      "start_ms": 521440,
      "end_ms": 524320,
      "text": "你就不要听了就离开啊"
    },
    {
      "ordinal": 169,
      "start_ms": 524320,
      "end_ms": 527320,
      "text": "懦夫或者说弱旅啊就离开"
    },
    {
      "ordinal": 170,
      "start_ms": 527320,
      "end_ms": 529960,
      "text": "just get way up here"
    },
    {
      "ordinal": 171,
      "start_ms": 529960,
      "end_ms": 531819,
      "text": "我这里不收留"
    },
    {
      "ordinal": 172,
      "start_ms": 533320,
      "end_ms": 534900,
      "text": "from here"
    },
    {
      "ordinal": 173,
      "start_ms": 536040,
      "end_ms": 537560,
      "text": "你你就离开我"
    },
    {
      "ordinal": 174,
      "start_ms": 537560,
      "end_ms": 538880,
      "text": "留在我这里干什么"
    },
    {
      "ordinal": 175,
      "start_ms": 538880,
      "end_ms": 539780,
      "text": "留在我这里"
    },
    {
      "ordinal": 176,
      "start_ms": 539780,
      "end_ms": 541040,
      "text": "承受无尽的鄙视"
    },
    {
      "ordinal": 177,
      "start_ms": 541040,
      "end_ms": 547719,
      "text": "承受你自己无尽的莫名其妙肮脏怪奇怪的一种东西啊"
    },
    {
      "ordinal": 178,
      "start_ms": 551540,
      "end_ms": 554860,
      "text": "因为我现在在忍受这个智齿的痛苦"
    },
    {
      "ordinal": 179,
      "start_ms": 554860,
      "end_ms": 563350,
      "text": "拔掉的有一个是和那个上颌都黏黏拔下来"
    },
    {
      "ordinal": 180,
      "start_ms": 563350,
      "end_ms": 565030,
      "text": "他炎症比较严重"
    },
    {
      "ordinal": 181,
      "start_ms": 565030,
      "end_ms": 567199,
      "text": "所以稍显痛苦一点"
    },
    {
      "ordinal": 182,
      "start_ms": 568100,
      "end_ms": 571300,
      "text": "但并不意味着就是说因为我为什么看到这个"
    },
    {
      "ordinal": 183,
      "start_ms": 571300,
      "end_ms": 573040,
      "text": "我感觉特别特别恶心呢"
    },
    {
      "ordinal": 184,
      "start_ms": 573040,
      "end_ms": 576439,
      "text": "因为今天出了那个九块钱每小时"
    },
    {
      "ordinal": 185,
      "start_ms": 576560,
      "end_ms": 584000,
      "text": "然后说不承认这个九块钱每小时的不干的行李箱脱了就给我走"
    },
    {
      "ordinal": 186,
      "start_ms": 584000,
      "end_ms": 586599,
      "text": "这空公然违法"
    },
    {
      "ordinal": 187,
      "start_ms": 587200,
      "end_ms": 588840,
      "text": "公然违法"
    },
    {
      "ordinal": 188,
      "start_ms": 588840,
      "end_ms": 593459,
      "text": "你就算广西最低工资标准1500块"
    },
    {
      "ordinal": 189,
      "start_ms": 595620,
      "end_ms": 596760,
      "text": "你算吧"
    },
    {
      "ordinal": 190,
      "start_ms": 598320,
      "end_ms": 600690,
      "text": "合法加班是36个小时"
    },
    {
      "ordinal": 191,
      "start_ms": 600690,
      "end_ms": 601859,
      "text": "加上"
    },
    {
      "ordinal": 192,
      "start_ms": 605820,
      "end_ms": 608260,
      "text": "一个月工作时长"
    },
    {
      "ordinal": 193,
      "start_ms": 610860,
      "end_ms": 615300,
      "text": "27点多少是21.75"
    },
    {
      "ordinal": 194,
      "start_ms": 615300,
      "end_ms": 617400,
      "text": "21.75乘以八"
    },
    {
      "ordinal": 195,
      "start_ms": 618460,
      "end_ms": 619660,
      "text": "这加起来等于多少"
    },
    {
      "ordinal": 196,
      "start_ms": 623680,
      "end_ms": 624520,
      "text": "算一点"
    },
    {
      "ordinal": 197,
      "start_ms": 625340,
      "end_ms": 627060,
      "text": "你可以算一下"
    },
    {
      "ordinal": 198,
      "start_ms": 627800,
      "end_ms": 631600,
      "text": "1.75x8=8"
    },
    {
      "ordinal": 199,
      "start_ms": 631600,
      "end_ms": 635380,
      "text": "加上0.75乘以八"
    },
    {
      "ordinal": 200,
      "start_ms": 637660,
      "end_ms": 644140,
      "text": "1.5368+64啊"
    },
    {
      "ordinal": 201,
      "start_ms": 644140,
      "end_ms": 647020,
      "text": "那就是14+160"
    },
    {
      "ordinal": 202,
      "start_ms": 647020,
      "end_ms": 650079,
      "text": "174+36"
    },
    {
      "ordinal": 203,
      "start_ms": 651580,
      "end_ms": 653540,
      "text": "那等于就是说"
    },
    {
      "ordinal": 204,
      "start_ms": 656620,
      "end_ms": 661979,
      "text": "210~210个小时乘以九"
    },
    {
      "ordinal": 205,
      "start_ms": 662540,
      "end_ms": 665680,
      "text": "哎我在想广西最低工资标准是多少"
    },
    {
      "ordinal": 206,
      "start_ms": 682140,
      "end_ms": 683720,
      "text": "1810块啊"
    },
    {
      "ordinal": 207,
      "start_ms": 683720,
      "end_ms": 685370,
      "text": "1810元"
    },
    {
      "ordinal": 208,
      "start_ms": 685370,
      "end_ms": 687200,
      "text": "210x9"
    },
    {
      "ordinal": 209,
      "start_ms": 687200,
      "end_ms": 688479,
      "text": "卧槽"
    },
    {
      "ordinal": 210,
      "start_ms": 690060,
      "end_ms": 691700,
      "text": "1890元"
    },
    {
      "ordinal": 211,
      "start_ms": 693440,
      "end_ms": 694719,
      "text": "就这个活"
    },
    {
      "ordinal": 212,
      "start_ms": 695400,
      "end_ms": 697470,
      "text": "加班拉满了"
    },
    {
      "ordinal": 213,
      "start_ms": 697470,
      "end_ms": 699240,
      "text": "拉满了"
    },
    {
      "ordinal": 214,
      "start_ms": 700080,
      "end_ms": 702620,
      "text": "把这个加班时间给拉满了"
    },
    {
      "ordinal": 215,
      "start_ms": 702620,
      "end_ms": 704480,
      "text": "1890块钱"
    },
    {
      "ordinal": 216,
      "start_ms": 704480,
      "end_ms": 708199,
      "text": "比最低工资标准高80元"
    },
    {
      "ordinal": 217,
      "start_ms": 713020,
      "end_ms": 715480,
      "text": "这还是合法的合法的"
    },
    {
      "ordinal": 218,
      "start_ms": 715480,
      "end_ms": 717400,
      "text": "在目前来说还是合法"
    },
    {
      "ordinal": 219,
      "start_ms": 717400,
      "end_ms": 719280,
      "text": "那么我们要说的"
    },
    {
      "ordinal": 220,
      "start_ms": 719920,
      "end_ms": 723140,
      "text": "那你广西的社保起身基数是多少"
    },
    {
      "ordinal": 221,
      "start_ms": 733700,
      "end_ms": 735500,
      "text": "哎呀我点进去一看"
    },
    {
      "ordinal": 222,
      "start_ms": 735500,
      "end_ms": 739580,
      "text": "他最低工资标准还有个小时的小时的最低工资标准"
    },
    {
      "ordinal": 223,
      "start_ms": 739580,
      "end_ms": 741240,
      "text": "17块五毛钱"
    },
    {
      "ordinal": 224,
      "start_ms": 743840,
      "end_ms": 745490,
      "text": "咱没话说"
    },
    {
      "ordinal": 225,
      "start_ms": 745490,
      "end_ms": 748560,
      "text": "他那个17块五毛钱应该是什么"
    },
    {
      "ordinal": 226,
      "start_ms": 752200,
      "end_ms": 756199,
      "text": "非全日制非全日制"
    },
    {
      "ordinal": 227,
      "start_ms": 758060,
      "end_ms": 760300,
      "text": "非全日的工资17块五"
    },
    {
      "ordinal": 228,
      "start_ms": 760300,
      "end_ms": 763359,
      "text": "就是那个相当于花time job"
    },
    {
      "ordinal": 229,
      "start_ms": 764400,
      "end_ms": 767850,
      "text": "那你九块钱每小时得是全日制的"
    },
    {
      "ordinal": 230,
      "start_ms": 767850,
      "end_ms": 770219,
      "text": "全日制的得是什么"
    },
    {
      "ordinal": 231,
      "start_ms": 773920,
      "end_ms": 775600,
      "text": "得签劳动合同啊"
    },
    {
      "ordinal": 232,
      "start_ms": 775600,
      "end_ms": 778040,
      "text": "这个劳动关系嗯"
    },
    {
      "ordinal": 233,
      "start_ms": 778040,
      "end_ms": 780950,
      "text": "1890元的工资要给他交"
    },
    {
      "ordinal": 234,
      "start_ms": 780950,
      "end_ms": 786859,
      "text": "基数是三四千的社保"
    },
    {
      "ordinal": 235,
      "start_ms": 788180,
      "end_ms": 791180,
      "text": "这个社保可能要加价给1000块钱"
    },
    {
      "ordinal": 236,
      "start_ms": 791180,
      "end_ms": 792140,
      "text": "1000块钱"
    },
    {
      "ordinal": 237,
      "start_ms": 794120,
      "end_ms": 797900,
      "text": "企业帮你交的社保归根结底还不是从劳动者的工资里面"
    },
    {
      "ordinal": 238,
      "start_ms": 802560,
      "end_ms": 804480,
      "text": "所以我跟你讲这种东西"
    },
    {
      "ordinal": 239,
      "start_ms": 804480,
      "end_ms": 806839,
      "text": "目前他演变成这么一个状况"
    },
    {
      "ordinal": 240,
      "start_ms": 808480,
      "end_ms": 812770,
      "text": "你不能仅仅说就是磨牙吮血的太残暴"
    },
    {
      "ordinal": 241,
      "start_ms": 812770,
      "end_ms": 815540,
      "text": "还是你们有没有点骨气"
    },
    {
      "ordinal": 242,
      "start_ms": 817300,
      "end_ms": 818500,
      "text": "不能太懦弱"
    },
    {
      "ordinal": 243,
      "start_ms": 820120,
      "end_ms": 821620,
      "text": "不懦弱"
    },
    {
      "ordinal": 244,
      "start_ms": 822780,
      "end_ms": 826240,
      "text": "让一步就要让千万步"
    },
    {
      "ordinal": 245,
      "start_ms": 829800,
      "end_ms": 833240,
      "text": "这话别人说不知道说了多少遍了"
    },
    {
      "ordinal": 246,
      "start_ms": 833560,
      "end_ms": 834940,
      "text": "学哲学"
    },
    {
      "ordinal": 247,
      "start_ms": 834940,
      "end_ms": 840840,
      "text": "哲学普遍性必然性是一旦达到这个理性的判断"
    },
    {
      "ordinal": 248,
      "start_ms": 842040,
      "end_ms": 843859,
      "text": "死也不放松的"
    },
    {
      "ordinal": 249,
      "start_ms": 846760,
      "end_ms": 848490,
      "text": "你如果弱弱弱小"
    },
    {
      "ordinal": 250,
      "start_ms": 848490,
      "end_ms": 852439,
      "text": "还成天在那边呼喊口号装逼"
    },
    {
      "ordinal": 251,
      "start_ms": 852860,
      "end_ms": 854900,
      "text": "请你在行动上落实"
    },
    {
      "ordinal": 252,
      "start_ms": 854900,
      "end_ms": 857040,
      "text": "我就要求在行动上落实"
    },
    {
      "ordinal": 253,
      "start_ms": 859140,
      "end_ms": 861400,
      "text": "然后另外一个那些学生"
    },
    {
      "ordinal": 254,
      "start_ms": 864600,
      "end_ms": 866640,
      "text": "学生如果你是个学生"
    },
    {
      "ordinal": 255,
      "start_ms": 867720,
      "end_ms": 869460,
      "text": "这事情跟你毛关系"
    },
    {
      "ordinal": 256,
      "start_ms": 869460,
      "end_ms": 871079,
      "text": "一丁点关系都没有"
    },
    {
      "ordinal": 257,
      "start_ms": 873200,
      "end_ms": 875020,
      "text": "你就要感到自卑"
    },
    {
      "ordinal": 258,
      "start_ms": 875800,
      "end_ms": 878440,
      "text": "你自己现在做过无数个"
    },
    {
      "ordinal": 259,
      "start_ms": 878440,
      "end_ms": 879940,
      "text": "就是说我这样说"
    },
    {
      "ordinal": 260,
      "start_ms": 879940,
      "end_ms": 882940,
      "text": "期待就业应当像期待高考一样"
    },
    {
      "ordinal": 261,
      "start_ms": 882940,
      "end_ms": 887800,
      "text": "要像期待高考高考分数一样"
    },
    {
      "ordinal": 262,
      "start_ms": 889940,
      "end_ms": 891540,
      "text": "准备就业"
    },
    {
      "ordinal": 263,
      "start_ms": 893700,
      "end_ms": 896540,
      "text": "很多人为高考做好做好准备"
    },
    {
      "ordinal": 264,
      "start_ms": 897600,
      "end_ms": 898740,
      "text": "要考上好学校"
    },
    {
      "ordinal": 265,
      "start_ms": 898740,
      "end_ms": 899520,
      "text": "做人上人"
    },
    {
      "ordinal": 266,
      "start_ms": 899520,
      "end_ms": 900660,
      "text": "搞个就业文凭"
    },
    {
      "ordinal": 267,
      "start_ms": 900660,
      "end_ms": 902640,
      "text": "那你为就业做什么准备呢"
    },
    {
      "ordinal": 268,
      "start_ms": 902640,
      "end_ms": 904830,
      "text": "所以我们要做哲学上的准备"
    },
