    {
      "ordinal": 45,
      "start_ms": 129359,
      "end_ms": 131179,
      "text": "一点现实的产业都没有"
    },
    {
      "ordinal": 46,
      "start_ms": 131179,
      "end_ms": 137020,
      "text": "一点现实的和劳动群众现实打交道的"
    },
    {
      "ordinal": 47,
      "start_ms": 137020,
      "end_ms": 140020,
      "text": "现实的打交道的"
    },
    {
      "ordinal": 48,
      "start_ms": 140020,
      "end_ms": 141560,
      "text": "你有你自己的"
    },
    {
      "ordinal": 49,
      "start_ms": 142019,
      "end_ms": 144599,
      "text": "你也有自己的一个产业"
    },
    {
      "ordinal": 50,
      "start_ms": 148260,
      "end_ms": 150300,
      "text": "你光是什么分析调查啊"
