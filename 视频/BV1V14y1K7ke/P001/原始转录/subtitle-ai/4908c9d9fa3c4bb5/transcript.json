  "segments": [
    {
      "ordinal": 0,
      "start_ms": 460,
      "end_ms": 4600,
      "text": "你说这个杨和平啊又开始出来阴阳怪气了"
    },
    {
      "ordinal": 1,
      "start_ms": 4600,
      "end_ms": 6760,
      "text": "他说什么"
    },
    {
      "ordinal": 2,
      "start_ms": 7960,
      "end_ms": 10360,
      "text": "他是拿美国举例子啊"
    },
    {
      "ordinal": 3,
      "start_ms": 10360,
      "end_ms": 14940,
      "text": "说美国那个什么工人积极分子啊"
    },
    {
      "ordinal": 4,
      "start_ms": 14940,
      "end_ms": 17340,
      "text": "他得偷偷的私下串联"
    },
    {
      "ordinal": 5,
      "start_ms": 17720,
      "end_ms": 19020,
      "text": "然后呢"
    },
    {
      "ordinal": 6,
      "start_ms": 19520,
      "end_ms": 21170,
      "text": "像公贼呢"
    },
    {
      "ordinal": 7,
      "start_ms": 21170,
      "end_ms": 22220,
      "text": "这是公贼"
    },
    {
      "ordinal": 8,
      "start_ms": 22220,
      "end_ms": 23210,
      "text": "就是厌恶我了"
    },
    {
      "ordinal": 9,
      "start_ms": 28900,
      "end_ms": 31080,
      "text": "他的意思就是说我指责他"
    },
    {
      "ordinal": 10,
      "start_ms": 35500,
      "end_ms": 37260,
      "text": "我我我们举个例子啊"
    },
    {
      "ordinal": 11,
      "start_ms": 37260,
      "end_ms": 40040,
      "text": "就是说这个东西我真的是没话说的"
    },
    {
      "ordinal": 12,
      "start_ms": 40440,
      "end_ms": 42360,
      "text": "我真是没话说的"
    },
    {
      "ordinal": 13,
      "start_ms": 44420,
      "end_ms": 49720,
      "text": "你住在你住在工厂主的家里面"
    },
    {
      "ordinal": 14,
      "start_ms": 51340,
      "end_ms": 55430,
      "text": "叫你做做任何事情"
    },
    {
      "ordinal": 15,
      "start_ms": 55430,
      "end_ms": 60419,
      "text": "你在一楼二楼或者在地下室做的事情"
    },
    {
      "ordinal": 16,
      "start_ms": 60640,
      "end_ms": 62260,
      "text": "工厂主在一楼二楼"
    },
    {
      "ordinal": 17,
      "start_ms": 62260,
      "end_ms": 64360,
      "text": "在楼上听得一清二楚"
    },
    {
      "ordinal": 18,
      "start_ms": 64360,
      "end_ms": 65420,
      "text": "干干净净"
    },
    {
      "ordinal": 19,
      "start_ms": 72700,
      "end_ms": 77780,
      "text": "其次你还是工厂主的小孩儿的老师"
    },
    {
      "ordinal": 20,
      "start_ms": 80160,
      "end_ms": 81500,
      "text": "你住人家家里面"
    },
    {
      "ordinal": 21,
      "start_ms": 81500,
      "end_ms": 82920,
      "text": "给人家小孩当老师"
    },
    {
      "ordinal": 22,
      "start_ms": 84780,
      "end_ms": 86660,
      "text": "我天然的就不可能信任你"
    },
    {
      "ordinal": 23,
      "start_ms": 86660,
      "end_ms": 87080,
      "text": "对不对"
    },
    {
      "ordinal": 24,
      "start_ms": 89300,
      "end_ms": 92480,
      "text": "是不是真的真的好意思呢"
    },
    {
      "ordinal": 25,
      "start_ms": 92480,
      "end_ms": 93680,
      "text": "我我实事求是讲"
    },
    {
      "ordinal": 26,
      "start_ms": 93680,
      "end_ms": 94820,
      "text": "我实事求是讲"
    },
    {
      "ordinal": 27,
      "start_ms": 95960,
      "end_ms": 97530,
      "text": "我有点受不了了"
    },
    {
      "ordinal": 28,
      "start_ms": 97530,
      "end_ms": 100570,
      "text": "说什么我给说我是公贼"
    },
    {
      "ordinal": 29,
      "start_ms": 102010,
      "end_ms": 103150,
      "text": "所以我就是工贼"
    },
    {
      "ordinal": 30,
      "start_ms": 103150,
      "end_ms": 105910,
      "text": "他们私下里是有地下的什么秘密活动的"
    },
    {
      "ordinal": 31,
      "start_ms": 105910,
      "end_ms": 107290,
      "text": "了不起的秘密活动的"
    },
    {
      "ordinal": 32,
      "start_ms": 107290,
      "end_ms": 109280,
      "text": "高级的解放性的秘密活动的"
    },
    {
      "ordinal": 33,
      "start_ms": 109280,
      "end_ms": 111260,
      "text": "你那些高级解放性的秘密活动"
    },
    {
      "ordinal": 34,
      "start_ms": 111260,
      "end_ms": 111860,
      "text": "我说了"
    },
    {
      "ordinal": 35,
      "start_ms": 111860,
      "end_ms": 113720,
      "text": "你们就是宝藏二元论"
    },
    {
      "ordinal": 36,
      "start_ms": 115940,
      "end_ms": 117259,
      "text": "造的时候瞎造"
    },
    {
      "ordinal": 37,
      "start_ms": 117280,
      "end_ms": 118880,
      "text": "要别人送死"
    },
    {
      "ordinal": 38,
      "start_ms": 119300,
      "end_ms": 120800,
      "text": "要不送死的瞎子"
    },
    {
      "ordinal": 39,
      "start_ms": 120800,
      "end_ms": 122180,
      "text": "嘴巴上饱了要死死"
    },
    {
      "ordinal": 40,
      "start_ms": 122180,
      "end_ms": 123620,
      "text": "脑部思想不解放"
    },
    {
      "ordinal": 41,
      "start_ms": 123620,
      "end_ms": 124580,
      "text": "讲原教旨"
    },
    {
      "ordinal": 42,
      "start_ms": 124580,
      "end_ms": 125120,
      "text": "叨逼叨"
    },
    {
      "ordinal": 43,
      "start_ms": 125120,
      "end_ms": 126200,
      "text": "讲原教旨"
    },
    {
      "ordinal": 44,
      "start_ms": 126200,
      "end_ms": 128720,
      "text": "一点现实的经验都没有"
