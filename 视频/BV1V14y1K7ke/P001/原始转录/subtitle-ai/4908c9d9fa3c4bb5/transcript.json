    {
      "ordinal": 51,
      "start_ms": 150300,
      "end_ms": 152460,
      "text": "我靠下去陪人家喝喝酒"
    },
    {
      "ordinal": 52,
      "start_ms": 152460,
      "end_ms": 153180,
      "text": "吹吹牛逼"
    },
    {
      "ordinal": 53,
      "start_ms": 153180,
      "end_ms": 154420,
      "text": "这东西算什么"
    },
    {
      "ordinal": 54,
      "start_ms": 155140,
      "end_ms": 156240,
      "text": "真的是搞笑"
    },
    {
      "ordinal": 55,
      "start_ms": 156240,
      "end_ms": 158160,
      "text": "我真的是受不了的"
    },
    {
      "ordinal": 56,
      "start_ms": 158359,
      "end_ms": 159919,
      "text": "我我最后我再说"
    },
    {
      "ordinal": 57,
      "start_ms": 159919,
      "end_ms": 163939,
      "text": "你住在你住在你住在工厂主家里面"
    },
    {
      "ordinal": 58,
      "start_ms": 163939,
      "end_ms": 166420,
      "text": "给工厂主子女做老师"
    },
    {
      "ordinal": 59,
      "start_ms": 166760,
      "end_ms": 169640,
      "text": "住在他家给他做老师"
    },
    {
      "ordinal": 60,
      "start_ms": 169640,
      "end_ms": 173980,
      "text": "你这只而且更不用说了"
    },
    {
      "ordinal": 61,
      "start_ms": 173980,
      "end_ms": 178480,
      "text": "你们当年写求情信写的那个什么样子"
    },
    {
      "ordinal": 62,
      "start_ms": 181240,
      "end_ms": 182580,
      "text": "真的好意思"
    },
    {
      "ordinal": 63,
      "start_ms": 182580,
      "end_ms": 184240,
      "text": "还说别人是公贼"
    },
    {
      "ordinal": 64,
      "start_ms": 184519,
      "end_ms": 185839,
      "text": "真的太搞笑了"
    },
    {
      "ordinal": 65,
      "start_ms": 185839,
      "end_ms": 187339,
      "text": "我觉得这真的太搞笑了"
    },
    {
      "ordinal": 66,
      "start_ms": 187339,
      "end_ms": 189259,
      "text": "太可笑了太可笑了"
    },
    {
      "ordinal": 67,
      "start_ms": 189259,
      "end_ms": 190039,
      "text": "可笑至极"
    },
    {
      "ordinal": 68,
      "start_ms": 190039,
      "end_ms": 190760,
      "text": "对不对"
    },
    {
      "ordinal": 69,
      "start_ms": 198160,
      "end_ms": 201340,
      "text": "积极分子不会住在工厂主的家里面"
    },
    {
