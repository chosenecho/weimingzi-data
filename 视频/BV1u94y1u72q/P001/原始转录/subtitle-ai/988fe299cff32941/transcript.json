  "content_sha256": "988fe299cff3294198f5e7ededa1822761b59e0ae82d10ee3c65ca6d043ead9b",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 0,
      "end_ms": 3180,
      "text": "这个随便聊聊这个新的一年我的直播安排啊"
    },
    {
      "ordinal": 1,
      "start_ms": 3180,
      "end_ms": 7460,
      "text": "我准备就是说在上午工作日的上午呢"
    },
    {
      "ordinal": 2,
      "start_ms": 7460,
      "end_ms": 10160,
      "text": "是用来回应信件啊"
    },
    {
      "ordinal": 3,
      "start_ms": 10160,
      "end_ms": 12920,
      "text": "我堆积了很多信件啊"
    },
    {
      "ordinal": 4,
      "start_ms": 12920,
      "end_ms": 19439,
      "text": "因为呃上个半年呢这个事情比较紧急"
    },
    {
      "ordinal": 5,
      "start_ms": 19439,
      "end_ms": 21659,
      "text": "各方面的沟通要做啊"
    },
    {
      "ordinal": 6,
      "start_ms": 21659,
      "end_ms": 23939,
      "text": "包括我们自己的俱乐部要落地"
    },
    {
      "ordinal": 7,
      "start_ms": 23939,
      "end_ms": 27620,
      "text": "然后各个方式的经营模式啊"
    },
    {
      "ordinal": 8,
      "start_ms": 27620,
      "end_ms": 29480,
      "text": "户外活动的方式啊"
    },
    {
      "ordinal": 9,
      "start_ms": 29480,
      "end_ms": 30800,
      "text": "都要去摸索"
    },
    {
      "ordinal": 10,
      "start_ms": 30800,
      "end_ms": 33670,
      "text": "所以很多信件其实我留到现在啊"
    },
    {
      "ordinal": 11,
      "start_ms": 33670,
      "end_ms": 35350,
      "text": "但是我答应过的"
    },
    {
      "ordinal": 12,
      "start_ms": 35350,
      "end_ms": 37180,
      "text": "我还是要补上"
    },
    {
      "ordinal": 13,
      "start_ms": 37180,
      "end_ms": 41370,
      "text": "我会在工作日的这个上半天"
    },
    {
      "ordinal": 14,
      "start_ms": 41370,
      "end_ms": 46320,
      "text": "如果我没有这个一些要去"
    },
    {
      "ordinal": 15,
      "start_ms": 46320,
      "end_ms": 51339,
      "text": "就是我没有有事的话啊"
    },
    {
      "ordinal": 16,
      "start_ms": 51339,
      "end_ms": 52299,
      "text": "要出去谈事情的话"
    },
    {
      "ordinal": 17,
      "start_ms": 52299,
      "end_ms": 54819,
      "text": "我说在工作日的上半天呢"
    },
    {
      "ordinal": 18,
      "start_ms": 54819,
      "end_ms": 56780,
      "text": "我来拆读信件"
    },
    {
      "ordinal": 19,
      "start_ms": 56780,
      "end_ms": 58190,
      "text": "在这下半天呢"
    },
    {
      "ordinal": 20,
      "start_ms": 58190,
      "end_ms": 59870,
      "text": "我可能要去户外"
    },
    {
      "ordinal": 21,
      "start_ms": 59870,
      "end_ms": 64400,
      "text": "可能是这个骑车或者开车去"
    },
    {
      "ordinal": 22,
      "start_ms": 64400,
      "end_ms": 68320,
      "text": "把这个周边的一些这个苏州地界"
    },
    {
      "ordinal": 23,
      "start_ms": 68320,
      "end_ms": 69820,
      "text": "给你们摸摸清楚啊"
    },
    {
      "ordinal": 24,
      "start_ms": 69820,
      "end_ms": 72160,
      "text": "或者介绍各种居民设施"
    },
    {
      "ordinal": 25,
      "start_ms": 72160,
      "end_ms": 73060,
      "text": "城市设施"
    },
    {
      "ordinal": 26,
      "start_ms": 74320,
      "end_ms": 79180,
      "text": "我在想要不要会叫你去看看某些什么夜总会"
    },
    {
      "ordinal": 27,
      "start_ms": 79180,
      "end_ms": 83190,
      "text": "下午旁边的女人街上的情况"
    },
    {
      "ordinal": 28,
      "start_ms": 83190,
      "end_ms": 85110,
      "text": "什么美甲店什么的"
    },
    {
      "ordinal": 29,
      "start_ms": 85110,
      "end_ms": 86730,
      "text": "不一定有可能太无聊"
    },
    {
      "ordinal": 30,
      "start_ms": 86730,
      "end_ms": 89070,
      "text": "或者说一些"
    },
    {
      "ordinal": 31,
      "start_ms": 90280,
      "end_ms": 92640,
      "text": "啊我以前的学校啊"
    },
    {
      "ordinal": 32,
      "start_ms": 92640,
      "end_ms": 93720,
      "text": "跑那边看看啊"
    },
    {
      "ordinal": 33,
      "start_ms": 93720,
      "end_ms": 95190,
      "text": "包括太湖边上"
    },
    {
      "ordinal": 34,
      "start_ms": 95190,
      "end_ms": 100030,
      "text": "然后呢晚上的话一般是不直播的"
    },
    {
      "ordinal": 35,
      "start_ms": 100030,
      "end_ms": 101260,
      "text": "一般的我要休息"
    },
    {
      "ordinal": 36,
      "start_ms": 101260,
      "end_ms": 103810,
      "text": "我要处理一些事务"
    },
    {
      "ordinal": 37,
      "start_ms": 104680,
      "end_ms": 109410,
      "text": "出一些专门事务经营管理团队协调的一些事情"
    },
    {
      "ordinal": 38,
      "start_ms": 109410,
      "end_ms": 111270,
      "text": "然后到周末的话呢"
    },
    {
      "ordinal": 39,
      "start_ms": 111270,
      "end_ms": 115120,
      "text": "嗯星期六呢是啊"
    },
    {
      "ordinal": 40,
      "start_ms": 115120,
      "end_ms": 116080,
      "text": "要休息"
    },
    {
      "ordinal": 41,
      "start_ms": 116080,
      "end_ms": 120060,
      "text": "星期天的话是下午是去踢球"
    },
    {
      "ordinal": 42,
      "start_ms": 120060,
      "end_ms": 122760,
      "text": "那我找了搞了一套设备啊"
    },
    {
      "ordinal": 43,
      "start_ms": 122760,
      "end_ms": 125550,
      "text": "想要去做到的是第一人称踢球"
    },
    {
      "ordinal": 44,
      "start_ms": 125550,
      "end_ms": 127480,
      "text": "这个在国内啊"
    },
    {
      "ordinal": 45,
      "start_ms": 127480,
      "end_ms": 131380,
      "text": "这个这个真人户外直播里面"
    },
    {
      "ordinal": 46,
      "start_ms": 131380,
      "end_ms": 132960,
      "text": "第一人称踢球的时"
    },
    {
      "ordinal": 47,
      "start_ms": 132960,
      "end_ms": 134580,
      "text": "其实做的不是特别多"
    },
    {
      "ordinal": 48,
      "start_ms": 134580,
      "end_ms": 135480,
      "text": "我想探索一下"
    },
    {
      "ordinal": 49,
      "start_ms": 135480,
      "end_ms": 138870,
      "text": "不是说我自己就以后就转型成一个踢球博主"
    },
    {
      "ordinal": 50,
      "start_ms": 138870,
      "end_ms": 140040,
      "text": "我球技也就这样"
    },
    {
      "ordinal": 51,
      "start_ms": 140040,
      "end_ms": 141140,
      "text": "对不对啊"
    },
    {
      "ordinal": 52,
      "start_ms": 141140,
      "end_ms": 142340,
      "text": "我想要探索一下"
    },
    {
      "ordinal": 53,
      "start_ms": 142340,
      "end_ms": 143660,
      "text": "如果这个探索成功的话"
    },
    {
      "ordinal": 54,
      "start_ms": 143660,
      "end_ms": 146380,
      "text": "我可以让团队里面的人去做"
    },
    {
      "ordinal": 55,
      "start_ms": 146380,
      "end_ms": 146740,
      "text": "对不对"
    },
    {
      "ordinal": 56,
      "start_ms": 146740,
      "end_ms": 151310,
      "text": "或者说我这或者说让whatever"
    },
    {
      "ordinal": 57,
      "start_ms": 151310,
      "end_ms": 154550,
      "text": "我们可以去训练培养这样的人来做"
    },
    {
      "ordinal": 58,
      "start_ms": 154550,
      "end_ms": 155510,
      "text": "这也是一个"
    },
    {
      "ordinal": 59,
      "start_ms": 155510,
      "end_ms": 161360,
      "text": "就相当于是本来前5年直播看游戏是一个风口"
    },
    {
      "ordinal": 60,
      "start_ms": 161360,
      "end_ms": 162020,
      "text": "对不对"
    },
    {
      "ordinal": 61,
      "start_ms": 162020,
      "end_ms": 164090,
      "text": "那么这个游戏是电子游戏"
    },
    {
      "ordinal": 62,
      "start_ms": 164090,
      "end_ms": 166330,
      "text": "那能不能在最近几年"
    },
    {
      "ordinal": 63,
      "start_ms": 166330,
      "end_ms": 170170,
      "text": "尤其是这个action3action4防抖和它的续航"
    },
    {
      "ordinal": 64,
      "start_ms": 170170,
      "end_ms": 171610,
      "text": "我没有收钱做广告啊"
    },
    {
      "ordinal": 65,
      "start_ms": 171610,
      "end_ms": 173530,
      "text": "这是我的大疆"
    },
    {
      "ordinal": 66,
      "start_ms": 173530,
      "end_ms": 174250,
      "text": "虽然是国货"
    },
    {
      "ordinal": 67,
      "start_ms": 174250,
      "end_ms": 175870,
      "text": "但是我没有收他钱做广告"
    },
    {
      "ordinal": 68,
      "start_ms": 175870,
      "end_ms": 177400,
      "text": "但是也看不上我"
    },
    {
      "ordinal": 69,
      "start_ms": 177400,
      "end_ms": 181110,
      "text": "我从来不接商单的"
    },
    {
      "ordinal": 70,
      "start_ms": 181110,
      "end_ms": 184020,
      "text": "它的防抖也是它的续航啊"
    },
    {
      "ordinal": 71,
      "start_ms": 184020,
      "end_ms": 184980,
      "text": "能不能到达一个"
    },
    {
      "ordinal": 72,
      "start_ms": 184980,
      "end_ms": 189450,
      "text": "可以说支撑这个足球直播的一个水准啊"
    },
    {
      "ordinal": 73,
      "start_ms": 189450,
      "end_ms": 192370,
      "text": "全程的足球直播的水准"
    },
    {
      "ordinal": 74,
      "start_ms": 192770,
      "end_ms": 195340,
      "text": "我星期六星期天的话啊"
    },
    {
      "ordinal": 75,
      "start_ms": 195340,
      "end_ms": 197230,
      "text": "他的下午会是这个"
    },
    {
      "ordinal": 76,
      "start_ms": 197230,
      "end_ms": 198430,
      "text": "然后星期天晚上的话"
    },
    {
      "ordinal": 77,
      "start_ms": 198430,
      "end_ms": 200720,
      "text": "我会去俱乐部看一下"
    },
    {
      "ordinal": 78,
      "start_ms": 200720,
      "end_ms": 205760,
      "text": "然后这个给他们提供点建议"
    },
    {
      "ordinal": 79,
      "start_ms": 206040,
      "end_ms": 208580,
      "text": "这个工作日又回到工作日的话"
    },
    {
      "ordinal": 80,
      "start_ms": 208580,
      "end_ms": 211260,
      "text": "我会中间会抽个嗯"
    },
    {
      "ordinal": 81,
      "start_ms": 211260,
      "end_ms": 214200,
      "text": "一两个下午去俱乐部看一下他的情况"
    },
    {
      "ordinal": 82,
      "start_ms": 214200,
      "end_ms": 217350,
      "text": "这个是我未来呃打算的"
    },
    {
      "ordinal": 83,
      "start_ms": 217350,
      "end_ms": 222540,
      "text": "可能是会在半年之内按照这个路调来走啊"
    },
    {
      "ordinal": 84,
      "start_ms": 222540,
      "end_ms": 226040,
      "text": "然后说呃会不会拍其他视频"
    },
    {
      "ordinal": 85,
      "start_ms": 226040,
      "end_ms": 226880,
      "text": "当然会拍啊"
    },
    {
      "ordinal": 86,
      "start_ms": 226880,
      "end_ms": 229520,
      "text": "会用那个晚上不直播的时间来拍"
    },
    {
      "ordinal": 87,
      "start_ms": 229520,
      "end_ms": 233120,
      "text": "而且我工作日不是说每个星期五天"
    },
    {
      "ordinal": 88,
      "start_ms": 233120,
      "end_ms": 235700,
      "text": "工作日都排满的"
    },
    {
      "ordinal": 89,
      "start_ms": 235700,
      "end_ms": 238220,
      "text": "可能中间我会留一天来休息啊"
    },
    {
      "ordinal": 90,
      "start_ms": 238220,
      "end_ms": 239810,
      "text": "休息好吧"
    },
    {
      "ordinal": 91,
      "start_ms": 239810,
      "end_ms": 243350,
      "text": "而且很多信件是不能够公开回复的"
    },
    {
      "ordinal": 92,
      "start_ms": 243350,
      "end_ms": 245810,
      "text": "所以我还是要花时间出来啊"
    },
    {
      "ordinal": 93,
      "start_ms": 245810,
      "end_ms": 247820,
      "text": "这个是不直播的状态下"
    },
    {
      "ordinal": 94,
      "start_ms": 247820,
      "end_ms": 251800,
      "text": "来回复相应的一些信件啊"
    },
    {
      "ordinal": 95,
      "start_ms": 251800,
      "end_ms": 256120,
      "text": "有很多人就他只是一个过去的事情的"
    },
    {
      "ordinal": 96,
      "start_ms": 256120,
      "end_ms": 257320,
      "text": "尘埃落定啊"
    },
    {
      "ordinal": 97,
      "start_ms": 257320,
      "end_ms": 259940,
      "text": "做事情总归是有前有后的"
    },
    {
      "ordinal": 98,
      "start_ms": 259940,
      "end_ms": 261620,
      "text": "而且我现在目前的状况是"
    },
    {
      "ordinal": 99,
      "start_ms": 261620,
      "end_ms": 263840,
      "text": "我感觉是比较良好的一个状况"
    },
    {
      "ordinal": 100,
      "start_ms": 263840,
      "end_ms": 266780,
      "text": "我们团队的运营也是逐步逐步"
    },
    {
      "ordinal": 101,
      "start_ms": 266780,
      "end_ms": 269950,
      "text": "上到正向轨道的一个状况"
    },
    {
      "ordinal": 102,
      "start_ms": 271130,
      "end_ms": 272260,
      "text": "与人为善"
    },
    {
      "ordinal": 103,
      "start_ms": 272260,
      "end_ms": 274750,
      "text": "我们不想找任何人麻烦"
    },
    {
      "ordinal": 104,
      "start_ms": 274970,
      "end_ms": 276790,
      "text": "只要你不违法犯罪啊"
    },
    {
      "ordinal": 105,
      "start_ms": 276790,
      "end_ms": 279790,
      "text": "然后呢监管监督我们的主体的"
    },
    {
      "ordinal": 106,
      "start_ms": 279790,
      "end_ms": 283000,
      "text": "我们也是配合合作啊"
    },
    {
      "ordinal": 107,
      "start_ms": 283000,
      "end_ms": 287140,
      "text": "我们不想被杀良冒功啊"
    },
    {
      "ordinal": 108,
      "start_ms": 287140,
      "end_ms": 291760,
      "text": "当然说你要怎么样宣传或者怎么样怎么样的啊"
    },
    {
      "ordinal": 109,
      "start_ms": 291760,
      "end_ms": 293080,
      "text": "和当时说的不一样"
    },
    {
      "ordinal": 110,
      "start_ms": 293080,
      "end_ms": 295530,
      "text": "和当时谈下来的不一样"
    },
    {
      "ordinal": 111,
      "start_ms": 295530,
      "end_ms": 297990,
      "text": "这个不是我们能决定的"
    },
    {
      "ordinal": 112,
      "start_ms": 297990,
      "end_ms": 299400,
      "text": "我也不在乎"
    },
    {
      "ordinal": 113,
      "start_ms": 299400,
      "end_ms": 300840,
      "text": "我也不在乎"
    },
    {
      "ordinal": 114,
      "start_ms": 300840,
      "end_ms": 303900,
      "text": "我始终认为我们存在的价值"
    },
    {
      "ordinal": 115,
      "start_ms": 303900,
      "end_ms": 307620,
      "text": "不是说啊脱下来一件衣裳"
    },
    {
      "ordinal": 116,
      "start_ms": 307620,
      "end_ms": 309960,
      "text": "让你那边去鞭打这个衣裳的"
    },
    {
      "ordinal": 117,
      "start_ms": 309960,
      "end_ms": 311640,
      "text": "这个像什么伍子胥钢"
    },
    {
      "ordinal": 118,
      "start_ms": 311640,
      "end_ms": 315870,
      "text": "鞭打那个什么楚王的这个尸体"
    },
    {
      "ordinal": 119,
      "start_ms": 316950,
      "end_ms": 319780,
      "text": "那个尸体好像还是里面有肉的"
    },
    {
      "ordinal": 120,
      "start_ms": 319780,
      "end_ms": 322300,
      "text": "曹操把什么头发割下来"
    },
    {
      "ordinal": 121,
      "start_ms": 322300,
      "end_ms": 323560,
      "text": "什么这种东西"
    },
    {
      "ordinal": 122,
      "start_ms": 323560,
      "end_ms": 326940,
      "text": "我觉得都是蛮可笑的东西啊"
    },
    {
      "ordinal": 123,
      "start_ms": 326940,
      "end_ms": 331050,
      "text": "我退下的蛇皮有什么好打的呢"
    },
    {
      "ordinal": 124,
      "start_ms": 331050,
      "end_ms": 333030,
      "text": "只是个蛇皮而已"
    },
    {
      "ordinal": 125,
      "start_ms": 333030,
      "end_ms": 337560,
      "text": "这个蛇我也没说我自己就是个蛇啊"
    },
    {
      "ordinal": 126,
      "start_ms": 337560,
      "end_ms": 339600,
      "text": "蛇也变成龙或者什么意思"
    },
    {
      "ordinal": 127,
      "start_ms": 339600,
      "end_ms": 343740,
      "text": "就是说知错能改善莫大焉"
    },
    {
      "ordinal": 128,
      "start_ms": 343740,
      "end_ms": 346490,
      "text": "又不是说把人一棍子打死"
    },
    {
      "ordinal": 129,
      "start_ms": 346490,
      "end_ms": 350350,
      "text": "这些人就永远这一辈子只能滑入另一侧的"
    },
    {
      "ordinal": 130,
      "start_ms": 350350,
      "end_ms": 351730,
      "text": "那这个结下梁子"
    },
    {
      "ordinal": 131,
      "start_ms": 351730,
      "end_ms": 352810,
      "text": "那是无比的仇恨"
    },
    {
      "ordinal": 132,
      "start_ms": 352810,
      "end_ms": 353170,
      "text": "对不对"
    },
    {
      "ordinal": 133,
      "start_ms": 353170,
      "end_ms": 354040,
      "text": "不可能的"
    },
    {
      "ordinal": 134,
      "start_ms": 354040,
      "end_ms": 355780,
      "text": "做事情不是这样做的"
    },
    {
      "ordinal": 135,
      "start_ms": 355780,
      "end_ms": 357670,
      "text": "我们都是有头有脑的人"
    },
    {
      "ordinal": 136,
      "start_ms": 361760,
      "end_ms": 364180,
      "text": "怎么说怎么说怎么说"
    },
    {
      "ordinal": 137,
      "start_ms": 364180,
      "end_ms": 365740,
      "text": "就是我现在过得还不错啊"
    },
    {
      "ordinal": 138,
      "start_ms": 365740,
      "end_ms": 369580,
      "text": "这个是这个"
    },
    {
      "ordinal": 139,
      "start_ms": 370640,
      "end_ms": 373690,
      "text": "承蒙承蒙"
    },
    {
      "ordinal": 140,
      "start_ms": 373690,
      "end_ms": 379760,
      "text": "各个方向上的这个这个我就应该叫兄弟呢"
    },
    {
      "ordinal": 141,
      "start_ms": 379760,
      "end_ms": 381260,
      "text": "还是叫什么同志"
    },
    {
      "ordinal": 142,
      "start_ms": 381260,
      "end_ms": 382730,
      "text": "还叫什么朋友"
    },
    {
      "ordinal": 143,
      "start_ms": 382730,
      "end_ms": 383420,
      "text": "看得起"
    },
    {
      "ordinal": 144,
      "start_ms": 383420,
      "end_ms": 386600,
      "text": "或者说还给点面子嗯"
    },
    {
      "ordinal": 145,
      "start_ms": 386600,
      "end_ms": 388860,
      "text": "我还活着嗯"
    },
    {
      "ordinal": 146,
      "start_ms": 388860,
      "end_ms": 390360,
      "text": "然后有些小蚊子"
    },
    {
      "ordinal": 147,
      "start_ms": 390360,
      "end_ms": 392100,
      "text": "小苍蝇在哪里叽叽喳喳叫"
    },
    {
      "ordinal": 148,
      "start_ms": 392100,
      "end_ms": 393330,
      "text": "那就让他们叫去吧"
    },
    {
      "ordinal": 149,
      "start_ms": 393330,
      "end_ms": 394890,
      "text": "我觉得意义不大"
    },
    {
      "ordinal": 150,
      "start_ms": 394890,
      "end_ms": 396090,
      "text": "问题也不大"
    },
    {
      "ordinal": 151,
      "start_ms": 396090,
      "end_ms": 400320,
      "text": "他们自己做的事情比较诡异"
    },
    {
      "ordinal": 152,
      "start_ms": 400320,
      "end_ms": 405480,
      "text": "就有某个是真的是自己是蹲了牢房了才出来的"
    },
    {
      "ordinal": 153,
      "start_ms": 405480,
      "end_ms": 409400,
      "text": "他你以为你演的那些东西"
    },
    {
      "ordinal": 154,
      "start_ms": 409860,
      "end_ms": 416380,
      "text": "大哥我我我可是没有吃过刑事手段的"
    },
    {
      "ordinal": 155,
      "start_ms": 416840,
      "end_ms": 418960,
      "text": "我没有吃过刑事手段的"
    },
    {
      "ordinal": 156,
      "start_ms": 418960,
      "end_ms": 421450,
      "text": "某些人是蹲牢房出来的"
    },
    {
      "ordinal": 157,
      "start_ms": 421450,
      "end_ms": 425020,
      "text": "那名字都不敢在公开网络上曝光的"
    },
    {
      "ordinal": 158,
      "start_ms": 425020,
      "end_ms": 427600,
      "text": "有些人还在那边嘲笑我"
    },
    {
      "ordinal": 159,
      "start_ms": 427600,
      "end_ms": 429430,
      "text": "说不会跑流程"
    },
    {
      "ordinal": 160,
      "start_ms": 429430,
      "end_ms": 431890,
      "text": "不懂得去和官方打交道"
    },
    {
      "ordinal": 161,
      "start_ms": 432970,
      "end_ms": 436480,
      "text": "这个有点过头了有点过头了"
    },
    {
      "ordinal": 162,
      "start_ms": 437780,
      "end_ms": 441320,
      "text": "某些励志想要做什么啊"
    },
    {
      "ordinal": 163,
      "start_ms": 441320,
      "end_ms": 442220,
      "text": "苏东启的人"
    },
    {
      "ordinal": 164,
      "start_ms": 443600,
      "end_ms": 445340,
      "text": "你自己都他妈坐牢了"
    },
    {
      "ordinal": 165,
      "start_ms": 445340,
      "end_ms": 450850,
      "text": "我靠你还在这里找搞笑"
    },
    {
      "ordinal": 166,
      "start_ms": 450850,
      "end_ms": 454010,
      "text": "真的你无名小卒一个"
    },
    {
      "ordinal": 167,
      "start_ms": 454350,
      "end_ms": 457700,
      "text": "除了我这种专门盯着你们的人之外"
    },
    {
      "ordinal": 168,
      "start_ms": 457700,
      "end_ms": 459710,
      "text": "谁会在乎你们发生什么"
    },
    {
      "ordinal": 169,
      "start_ms": 459710,
      "end_ms": 461140,
      "text": "遭遇了什么"
    },
    {
      "ordinal": 170,
      "start_ms": 461140,
      "end_ms": 465060,
      "text": "不要引得我盯你们盯太紧"
    },
    {
      "ordinal": 171,
      "start_ms": 465400,
      "end_ms": 467100,
      "text": "有的时候我说了"
    },
    {
      "ordinal": 172,
      "start_ms": 467100,
      "end_ms": 468300,
      "text": "我是个仁慈的人"
    },
    {
      "ordinal": 173,
      "start_ms": 468300,
      "end_ms": 469740,
      "text": "我的脾气好好的"
    },
    {
      "ordinal": 174,
      "start_ms": 470820,
      "end_ms": 471780,
      "text": "我是个仁慈的人"
    },
    {
      "ordinal": 175,
      "start_ms": 471780,
      "end_ms": 474190,
      "text": "我的脾气很好的啊"
    },
    {
      "ordinal": 176,
      "start_ms": 474190,
      "end_ms": 476980,
      "text": "有的东西在那边他做一个晴雨表有用"
    },
    {
      "ordinal": 177,
      "start_ms": 476980,
      "end_ms": 481000,
      "text": "有的东西在那边他有个什么什么有相应的作用"
    },
    {
      "ordinal": 178,
      "start_ms": 481220,
      "end_ms": 482980,
      "text": "你配合我演戏"
    },
    {
      "ordinal": 179,
      "start_ms": 482980,
      "end_ms": 484559,
      "text": "可以"
    },
    {
      "ordinal": 180,
      "start_ms": 485079,
      "end_ms": 487019,
      "text": "你把我当成一个什么"
    },
    {
      "ordinal": 181,
      "start_ms": 488339,
      "end_ms": 491999,
      "text": "你自己遭遇的不如意的出气筒"
    },
    {
      "ordinal": 182,
      "start_ms": 492620,
      "end_ms": 494500,
      "text": "我不知道你线下是谁"
    },
    {
      "ordinal": 183,
      "start_ms": 494500,
      "end_ms": 495370,
      "text": "还好呢"
    },
    {
      "ordinal": 184,
      "start_ms": 495370,
      "end_ms": 497980,
      "text": "有的人已经蹲过班房的"
    },
    {
      "ordinal": 185,
      "start_ms": 497980,
      "end_ms": 501880,
      "text": "已经这个这个名册名字在册的人"
    },
    {
      "ordinal": 186,
      "start_ms": 502120,
      "end_ms": 504370,
      "text": "你也要拿我当出气筒"
    },
    {
      "ordinal": 187,
      "start_ms": 504370,
      "end_ms": 507280,
      "text": "我觉得你应当三思而后行"
    },
    {
      "ordinal": 188,
      "start_ms": 507280,
      "end_ms": 509450,
      "text": "想多一点"
    },
    {
      "ordinal": 189,
      "start_ms": 509970,
      "end_ms": 510800,
      "text": "想多一点"
    },
    {
      "ordinal": 190,
      "start_ms": 510800,
      "end_ms": 512720,
      "text": "当然我说的我是个仁慈的人"
    },
    {
      "ordinal": 191,
      "start_ms": 512720,
      "end_ms": 514919,
      "text": "是大度的人"
    },
    {
      "ordinal": 192,
      "start_ms": 515200,
      "end_ms": 516960,
      "text": "我是个仁慈而大度的人"
    },
    {
      "ordinal": 193,
      "start_ms": 516960,
      "end_ms": 517500,
      "text": "好吧"
    },
    {
      "ordinal": 194,
      "start_ms": 517500,
      "end_ms": 520700,
      "text": "不要走你们某些前辈的老路"
    },
    {
      "ordinal": 195,
      "start_ms": 521220,
      "end_ms": 522460,
      "text": "就讲到这里"
    }
