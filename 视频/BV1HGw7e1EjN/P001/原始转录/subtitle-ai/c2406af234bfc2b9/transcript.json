    {
      "ordinal": 191,
      "start_ms": 778990,
      "end_ms": 783970,
      "text": "那么它有很多这个人口是在全世界对外输出"
    },
    {
      "ordinal": 192,
      "start_ms": 783970,
      "end_ms": 787230,
      "text": "去进行跨国劳务的"
    },
    {
      "ordinal": 193,
      "start_ms": 788070,
      "end_ms": 789670,
      "text": "因为他的人口是很多的呀"
    },
    {
      "ordinal": 194,
      "start_ms": 789670,
      "end_ms": 791150,
      "text": "他有好几亿人啊"
    },
    {
      "ordinal": 195,
      "start_ms": 791150,
      "end_ms": 794170,
      "text": "那么总体来讲嗯"
    },
    {
      "ordinal": 196,
      "start_ms": 797370,
      "end_ms": 800170,
      "text": "但是目前来讲的话"
    },
    {
      "ordinal": 197,
      "start_ms": 801500,
      "end_ms": 807340,
      "text": "啊目前来讲这个还是任重而道远的啊"
    },
    {
      "ordinal": 198,
      "start_ms": 807340,
      "end_ms": 809180,
      "text": "任重而道远的"
    },
    {
      "ordinal": 199,
      "start_ms": 809180,
      "end_ms": 811780,
      "text": "这是非常可惜的啊"
    },
    {
      "ordinal": 200,
      "start_ms": 811780,
      "end_ms": 812960,
      "text": "非常可惜的"
    },
    {
      "ordinal": 201,
      "start_ms": 812960,
      "end_ms": 817610,
      "text": "当年的这个全世界第三大啊"
