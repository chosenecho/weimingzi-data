    {
      "ordinal": 148,
      "start_ms": 642440,
      "end_ms": 646130,
      "text": "当时对待这个哎呀"
    },
    {
      "ordinal": 149,
      "start_ms": 646130,
      "end_ms": 647730,
      "text": "这个都讲太多了"
