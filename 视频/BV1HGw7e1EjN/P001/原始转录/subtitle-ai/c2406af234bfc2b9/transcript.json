    {
      "ordinal": 150,
      "start_ms": 647730,
      "end_ms": 649330,
      "text": "不想讲了啊"
    },
    {
      "ordinal": 151,
      "start_ms": 649330,
      "end_ms": 653550,
      "text": "始终要意识到就是西方敌人啊"
    },
    {
      "ordinal": 152,
      "start_ms": 653550,
      "end_ms": 656850,
      "text": "他所煽起的白色恐怖啊"
