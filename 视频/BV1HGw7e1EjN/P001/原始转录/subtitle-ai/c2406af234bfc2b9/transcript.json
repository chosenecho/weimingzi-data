    {
      "ordinal": 153,
      "start_ms": 656850,
      "end_ms": 658910,
      "text": "它实际上是不择手段的"
    },
    {
      "ordinal": 154,
      "start_ms": 658910,
      "end_ms": 662270,
      "text": "他对于一个政治实体当中的所有人口"
