    {
      "ordinal": 85,
      "start_ms": 229549,
      "end_ms": 231529,
      "text": "有目的的去去推行"
    },
    {
      "ordinal": 86,
      "start_ms": 231529,
      "end_ms": 234469,
      "text": "甚至是我们的法律是会引导道德的"
    },
    {
      "ordinal": 87,
      "start_ms": 234469,
      "end_ms": 235669,
      "text": "我们的法律具有引导性"
    },
    {
      "ordinal": 88,
      "start_ms": 235669,
      "end_ms": 237010,
      "text": "有教育性的"
    },
    {
      "ordinal": 89,
      "start_ms": 237010,
      "end_ms": 239290,
      "text": "是有人民性的"
    },
    {
      "ordinal": 90,
      "start_ms": 239290,
      "end_ms": 241370,
      "text": "归根结底是具有人民性的"
    },
    {
      "ordinal": 91,
      "start_ms": 241370,
      "end_ms": 243470,
      "text": "是反映人民的意志的"
    },
    {
      "ordinal": 92,
      "start_ms": 243470,
      "end_ms": 244550,
      "text": "人民通过法律"
    },
    {
      "ordinal": 93,
      "start_ms": 244550,
      "end_ms": 247190,
      "text": "比如说我们的这个label law"
    },
    {
      "ordinal": 94,
      "start_ms": 247190,
      "end_ms": 248100,
      "text": "label"
    },
    {
      "ordinal": 95,
      "start_ms": 248140,
      "end_ms": 252370,
      "text": "关于关于这个这个这个这个relationship的这些"
    },
    {
      "ordinal": 96,
      "start_ms": 252370,
      "end_ms": 256360,
      "text": "它是直接的代表一种导向"
    },
    {
      "ordinal": 97,
      "start_ms": 256360,
      "end_ms": 258339,
      "text": "来有价值导向在里面的"
    },
    {
      "ordinal": 98,
      "start_ms": 258339,
      "end_ms": 259959,
      "text": "不仅仅有价值导向"
    },
    {
      "ordinal": 99,
      "start_ms": 259959,
      "end_ms": 263660,
      "text": "就是通过通过立法本身"
    },
    {
      "ordinal": 100,
      "start_ms": 263660,
      "end_ms": 268170,
      "text": "就是创制了一种限制性的伦理性的价值的"
    },
    {
      "ordinal": 101,
      "start_ms": 268170,
      "end_ms": 269910,
      "text": "我们设置的不是道德性的价值"
