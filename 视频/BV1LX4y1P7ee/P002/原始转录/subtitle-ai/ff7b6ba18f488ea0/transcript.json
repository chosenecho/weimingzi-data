    {
      "ordinal": 80,
      "start_ms": 222099,
      "end_ms": 225949,
      "text": "我们的法律是更超出于什么最低限度的道德"
    },
    {
      "ordinal": 81,
      "start_ms": 225949,
      "end_ms": 226729,
      "text": "这种说辞"
