    {
      "ordinal": 102,
      "start_ms": 269910,
      "end_ms": 271470,
      "text": "我们设置的是伦理性的价值"
    },
    {
      "ordinal": 103,
      "start_ms": 271470,
      "end_ms": 275870,
      "text": "这些伦理性的价值以法律作为他的实在的一个"
    },
    {
      "ordinal": 104,
      "start_ms": 275870,
      "end_ms": 277070,
      "text": "一个一个展现"
    },
    {
      "ordinal": 105,
      "start_ms": 277070,
      "end_ms": 279120,
      "text": "它是凛然不可侵犯的"
    },
    {
      "ordinal": 106,
      "start_ms": 279120,
      "end_ms": 281460,
      "text": "这是不可怀疑不可侵犯的"
    },
    {
      "ordinal": 107,
      "start_ms": 281460,
      "end_ms": 282570,
      "text": "在这个意义上讲"
    },
    {
      "ordinal": 108,
      "start_ms": 282570,
      "end_ms": 284790,
      "text": "法律是超出道德"
    },
    {
      "ordinal": 109,
      "start_ms": 284790,
      "end_ms": 286110,
      "text": "法律是引导道德"
    },
    {
      "ordinal": 110,
      "start_ms": 286110,
      "end_ms": 286950,
      "text": "塑造道德"
    },
    {
      "ordinal": 111,
      "start_ms": 286950,
      "end_ms": 288120,
      "text": "创造道德"
    },
    {
      "ordinal": 112,
      "start_ms": 288260,
      "end_ms": 291980,
      "text": "法律是甚至是在很多维度上"
    },
    {
      "ordinal": 113,
      "start_ms": 291980,
      "end_ms": 296320,
      "text": "很多重要的关键的维度上是告诉你何为道德的"
    },
    {
      "ordinal": 114,
      "start_ms": 297880,
      "end_ms": 298680,
      "text": "我举个例子"
    },
    {
      "ordinal": 115,
      "start_ms": 298680,
      "end_ms": 300500,
      "text": "比如童婚这些陋俗"
    },
    {
      "ordinal": 116,
      "start_ms": 300900,
      "end_ms": 303780,
      "text": "比如说甚至有些地方的那种呃"
    },
    {
      "ordinal": 117,
      "start_ms": 303780,
      "end_ms": 306440,
      "text": "一种临时性的一种夫妻关系"
    },
    {
      "ordinal": 118,
      "start_ms": 306920,
      "end_ms": 310720,
      "text": "在生产力不发达的年代"
    },
    {
      "ordinal": 119,
      "start_ms": 310720,
      "end_ms": 311980,
      "text": "在一些落后地区"
    },
    {
      "ordinal": 120,
      "start_ms": 311980,
      "end_ms": 313720,
      "text": "它还有它的残余"
    },
    {
      "ordinal": 121,
      "start_ms": 314260,
      "end_ms": 318040,
      "text": "是通过法律来引导来规制的"
    },
    {
      "ordinal": 122,
      "start_ms": 318040,
      "end_ms": 319960,
      "text": "是通过法律来告诉他们"
    },
    {
      "ordinal": 123,
      "start_ms": 319960,
      "end_ms": 322620,
      "text": "you should take this for granted"
    },
    {
      "ordinal": 124,
      "start_ms": 322620,
      "end_ms": 324860,
      "text": "你要把这些东西看成是天经地义的"
    },
    {
      "ordinal": 125,
      "start_ms": 325699,
      "end_ms": 328169,
      "text": "你光靠道德是很无力的"
