{"segments":[{"start":0.78,"end":3.6,"text":"不是说什么等待时机论"},{"start":3.6,"end":5.04,"text":"我靠大哥"},{"start":5.04,"end":5.94,"text":"你没有力量"},{"start":5.94,"end":8.64,"text":"怎么创造时机啊"},{"start":8.64,"end":11.19,"text":"不断重复这个过程"},{"start":11.19,"end":12.42,"text":"为什么变重复"},{"start":12.42,"end":13.86,"text":"这个过程本来就是这样"},{"start":13.86,"end":17.92,"text":"这个过程也是在发展在进步啊"},{"start":19.14,"end":22.82,"text":"就格林那他妈天天忽悠一群他妈外卖骑手"},{"start":22.82,"end":23.54,"text":"他妈上街"},{"start":23.54,"end":26.75,"text":"这个就就就就就这这个就叫做"},{"start":26.75,"end":28.67,"text":"这就叫这也是重复过程"},{"start":28.67,"end":30.08,"text":"而且是在浪费力量"},{"start":30.08,"end":32.369,"text":"哈哈不断重复这个过程"},{"start":32.369,"end":33.45,"text":"浪费力量"},{"start":33.45,"end":35.64,"text":"浪费时机论"},{"start":35.92,"end":37.86,"text":"让那些浪费时间的人说"},{"start":37.86,"end":39.21,"text":"我在等待时机"},{"start":39.21,"end":41.04,"text":"我滴妈我真的服了"},{"start":41.04,"end":43.2,"text":"你朝饭碗里拉屎的人说"},{"start":43.2,"end":44.04,"text":"我在吃屎"},{"start":44.04,"end":45.16,"text":"我靠"},{"start":49.26,"end":50.75,"text":"确实是这样的啊"},{"start":50.75,"end":54.14,"text":"你就让我想到杨和平的马仔"},{"start":54.14,"end":55.34,"text":"那群那群马仔"},{"start":55.34,"end":57.57,"text":"让我想到一群马仔"},{"start":58.46,"end":61.06,"text":"天天给他开会开会批"},{"start":61.06,"end":64.48,"text":"还有国内的什么这个派那个派那个派那个派"},{"start":64.48,"end":65.349,"text":"天天开会"},{"start":65.349,"end":67.72,"text":"早上开会就是为了下午开会"},{"start":68.29,"end":70.92,"text":"昨天开会就是为了今天开会"},{"start":70.92,"end":73.8,"text":"什么吊东西"},{"start":76.46,"end":79.63,"text":"杨某人的马仔又让我想到这个了"},{"start":79.63,"end":81.28,"text":"你确定你不是杨某人的马仔"},{"start":81.28,"end":84.52,"text":"我来看一下他关注列表里面有没有杨某人"},{"start":85.1,"end":87.28,"text":"MCC啊"},{"start":98.0,"end":98.98,"text":"还真没有"},{"start":98.98,"end":99.79,"text":"我靠"},{"start":99.79,"end":103.0,"text":"根正苗红的不得了"},{"start":103.0,"end":104.98,"text":"他不是原教旨主义者"}],"source":"subtitle"}
