{"segments":[{"start":0.18,"end":3.61,"text":"对于最近各地的这个公益活动啊"},{"start":3.61,"end":5.17,"text":"元宵节也有人要搞活动"},{"start":5.17,"end":7.99,"text":"春节元宵节一直往后不停的"},{"start":7.99,"end":9.59,"text":"有人要搞公益活动"},{"start":9.59,"end":11.39,"text":"有一点原则性的意见"},{"start":13.07,"end":17.98,"text":"建议你们考虑一下啊"},{"start":17.98,"end":24.939,"text":"这些意见呢包括成员成员不能够有单"},{"start":24.939,"end":26.769,"text":"单纯的志愿者团队啊"},{"start":26.769,"end":29.199,"text":"单纯的志愿者团队啊"},{"start":29.199,"end":30.32,"text":"在这里面呢"},{"start":32.34,"end":35.739,"text":"要做到账目公示"},{"start":36.94,"end":39.72,"text":"原则上要对所有成员公示"},{"start":40.0,"end":42.58,"text":"以及要对全社会公示"},{"start":42.58,"end":45.01,"text":"你做公益活动的账目"},{"start":45.01,"end":49.099,"text":"有必要对全社会对所有成员公示"},{"start":50.34,"end":58.38,"text":"其次不接受团体的以及个人的大规模的资金资"},{"start":58.38,"end":58.919,"text":"助"},{"start":60.14,"end":61.54,"text":"公益活动"},{"start":61.54,"end":65.209,"text":"不接受那些什么副歌啊"},{"start":65.209,"end":66.5,"text":"一下子给个几万块"},{"start":66.5,"end":67.94,"text":"不接受这些人的资助"},{"start":67.94,"end":70.58,"text":"如果说缺钱"},{"start":70.58,"end":75.29,"text":"那以草创成员啊"},{"start":75.29,"end":82.48,"text":"原则上一个平等的公开的方式来筹集经费"},{"start":83.26,"end":86.7,"text":"没有说后来加入了谁给个几万块钱"},{"start":86.7,"end":88.64,"text":"一下子啊"},{"start":88.64,"end":90.08,"text":"他就成为什么什么骨干"},{"start":90.08,"end":90.74,"text":"什么什么的"},{"start":90.74,"end":100.179,"text":"我觉得要恪守一个劳动者出资者身份的统一"},{"start":102.0,"end":103.88,"text":"明白吗啊"},{"start":103.88,"end":106.8,"text":"还有一点就是说这个活动"},{"start":108.82,"end":111.06,"text":"尽量不要参加"},{"start":112.72,"end":116.259,"text":"脱产学生本身发起的活动"},{"start":116.44,"end":119.83,"text":"脱产学生的投机性非常深重"},{"start":119.83,"end":123.7,"text":"脱产学生没有独立的经济能力"},{"start":124.36,"end":128.77,"text":"任何组织你的活动要开展下去"},{"start":128.77,"end":133.68,"text":"一定要把脱产学生从核心的指导者"},{"start":133.68,"end":134.82,"text":"在这个位置上挤掉"},{"start":136.44,"end":140.04,"text":"原则上不要服从脱产学生"},{"start":140.04,"end":143.16,"text":"投机性的脱产学生的指导"},{"start":145.399,"end":146.319,"text":"明白吗"},{"start":146.319,"end":149.139,"text":"如果这个活动啊要往校外蔓延的话"},{"start":149.139,"end":150.729,"text":"要扩大其规模的话"},{"start":150.729,"end":153.38,"text":"他的舵手绝对不是拓展学生"},{"start":155.499,"end":157.739,"text":"脱产学生投机性太重了"},{"start":157.739,"end":165.3,"text":"我们目前了解一个情况就是有一个小组啊"},{"start":165.3,"end":168.879,"text":"目前了解的情况他已经说是啊"},{"start":168.879,"end":170.889,"text":"我们说的要提防三类人"},{"start":170.889,"end":173.919,"text":"其中一类就是原教旨的啊"},{"start":178.519,"end":180.94,"text":"啊激流网呢或者说一些金圈"},{"start":181.32,"end":186.2,"text":"一些政治投机客身份为一些底色的"},{"start":187.16,"end":190.78,"text":"我们再强调一遍公益活动"},{"start":190.78,"end":195.74,"text":"公益公益活动不是一个政治投机活动啊"},{"start":195.74,"end":199.179,"text":"如果你发现团队里面的核心人物"},{"start":199.179,"end":201.999,"text":"或者说比较有大的影响力的人物"},{"start":201.999,"end":203.619,"text":"是一个原教旨"},{"start":205.119,"end":206.739,"text":"激进的造派"},{"start":206.739,"end":207.789,"text":"或者怎么样的"},{"start":207.789,"end":215.2,"text":"以激烈的啊地下秘密手段要积攒暴力的啊"},{"start":215.2,"end":217.0,"text":"退出这个团体啊"},{"start":217.0,"end":218.82,"text":"那就请退出这个团体"},{"start":220.3,"end":225.36,"text":"因为他并不想植根于人民群众"},{"start":225.36,"end":230.589,"text":"并不想在社会的集体当中生根发芽"},{"start":230.589,"end":233.98,"text":"他们是密谋小组啊"},{"start":233.98,"end":235.36,"text":"它的结构非常明确"},{"start":235.36,"end":237.16,"text":"有一个密谋的核心"},{"start":237.16,"end":239.339,"text":"这个密谋的核心里面的人物"},{"start":241.919,"end":244.919,"text":"它里面的凭身份关系啊"},{"start":244.919,"end":248.34,"text":"凭他背后有谁谁谁哪个什么啊"},{"start":250.17,"end":254.549,"text":"要么就这种人就有政治呃"},{"start":254.549,"end":255.659,"text":"秘密身份的"},{"start":255.659,"end":256.259,"text":"所谓的"},{"start":256.259,"end":258.6,"text":"还有一种就是掏钱的副歌"},{"start":258.88,"end":261.22,"text":"这两类人结合成一个壳"},{"start":261.22,"end":263.6,"text":"结合成一个内核的这种小组"},{"start":264.54,"end":268.91,"text":"我呼吁所有的公益公益志愿者脱离这样的小组"},{"start":268.91,"end":273.4,"text":"不要和他们进行任何的合作啊"},{"start":273.4,"end":274.6,"text":"你是一个学生"},{"start":274.6,"end":280.72,"text":"或者说你是一个啊社会上的一个工作"},{"start":280.72,"end":281.86,"text":"有工作的人"},{"start":281.86,"end":282.82,"text":"成年人"},{"start":282.82,"end":286.33,"text":"如果你发现你的小组里面的核内核竟然是"},{"start":288.82,"end":294.58,"text":"这群这群原教旨主义的原教旨主义者"},{"start":300.18,"end":300.6,"text":"在我看来"},{"start":306.38,"end":312.4,"text":"啊他们我说的我们要获得场所和民意场所名义"},{"start":312.4,"end":314.84,"text":"这里面的钱都是自己挣的"},{"start":314.979,"end":317.319,"text":"都是志愿者团队自己挣的"},{"start":318.759,"end":321.42,"text":"都是公益小组啊"},{"start":321.64,"end":326.609,"text":"他每一个参与的人通过自己的劳动"},{"start":326.609,"end":330.02,"text":"自己在自己劳动当中积攒下来的剩余"},{"start":337.84,"end":342.52,"text":"他自己名义场地一下子就解决了"},{"start":342.52,"end":344.26,"text":"怎么一下子都解决了"},{"start":344.64,"end":347.58,"text":"因为它它本来就有个壳"},{"start":347.58,"end":351.299,"text":"那个壳儿本来就是这些什么激流网"},{"start":352.739,"end":356.68,"text":"那些激进投机网站里面已有的一些壳"},{"start":357.54,"end":360.26,"text":"如果你是在这样的公益小组当中"},{"start":360.26,"end":361.64,"text":"发现有这样的情况"},{"start":361.64,"end":363.18,"text":"即刻退出"},{"start":363.819,"end":365.219,"text":"即刻退出"},{"start":365.219,"end":367.319,"text":"这些人是我除名了啊"},{"start":367.319,"end":370.34,"text":"这些人是三类三类"},{"start":372.44,"end":374.0,"text":"破坏分子当中的一类"},{"start":374.0,"end":375.44,"text":"他现在顶着我的名义"},{"start":375.44,"end":376.61,"text":"在顶着"},{"start":376.61,"end":377.42,"text":"不是我的名义"},{"start":377.42,"end":378.68,"text":"顶着公益公益的"},{"start":378.68,"end":381.92,"text":"我所提倡发起的这项运动的名义"},{"start":381.92,"end":383.14,"text":"在做这样的事情"},{"start":383.36,"end":384.68,"text":"我觉得他们是"},{"start":387.02,"end":388.58,"text":"啊他是觉得什么"},{"start":389.08,"end":396.26,"text":"觉得穿着袜子就可以去这个去那个踩刀山了"},{"start":396.26,"end":396.8,"text":"一样的"},{"start":396.8,"end":397.88,"text":"这只是一双袜子"},{"start":397.88,"end":399.14,"text":"是用来保暖的"},{"start":399.14,"end":402.54,"text":"他们竟然用我这双袜子穿着袜子要去踩刀山"},{"start":404.84,"end":408.67,"text":"啊我觉得这些人是太丧心病狂了"},{"start":408.67,"end":410.11,"text":"刀山他们当然不敢踩"},{"start":410.11,"end":413.06,"text":"但是呢我认为他们打着公益的名头"},{"start":413.06,"end":415.01,"text":"去进行一些非法集资"},{"start":415.01,"end":418.999,"text":"去进行一些挑唆别人去上街"},{"start":418.999,"end":422.179,"text":"挑唆别人去做激进的事情啊"},{"start":422.179,"end":426.12,"text":"甚至说在他们那些秘密场所里面去做一些"},{"start":427.98,"end":431.21,"text":"啊也对于人加以人身控制"},{"start":431.21,"end":432.95,"text":"洗脑的这种工作"},{"start":432.95,"end":435.95,"text":"然后背后再富集资本的搞一些传销啊"},{"start":435.95,"end":436.43,"text":"类似的"},{"start":438.53,"end":439.91,"text":"我不知道他们会做出什么事情呢"},{"start":439.91,"end":441.62,"text":"这帮原教旨主义者"},{"start":441.719,"end":443.64,"text":"他们脑子里面"},{"start":444.56,"end":448.12,"text":"那只要他说他以一个什么至高的政治名义"},{"start":448.12,"end":449.14,"text":"把人聚起来"},{"start":449.14,"end":450.85,"text":"再忽悠别人弄点钱"},{"start":450.85,"end":453.44,"text":"把场所秘密控制起来"},{"start":453.44,"end":457.1,"text":"进去的人都很容易受到他们的人身侵害的"},{"start":457.36,"end":460.39,"text":"非常容易受到他们的人身侵侵害啊"},{"start":460.39,"end":461.66,"text":"明白吗"},{"start":462.48,"end":463.55,"text":"我在强调一遍"},{"start":463.55,"end":465.95,"text":"不要对他们抱有任何的幻想"},{"start":465.95,"end":467.66,"text":"即刻脱离这样的团体"},{"start":467.66,"end":469.18,"text":"尤其是学生"},{"start":469.2,"end":470.659,"text":"尤其是学生"},{"start":470.659,"end":473.599,"text":"你可能这样的小组里面的头领也是学生"},{"start":473.599,"end":477.109,"text":"但是他背后的那些人都是职业的左棍政棍"},{"start":477.109,"end":478.819,"text":"职业的激进的原教旨"},{"start":478.819,"end":483.42,"text":"棍棍就是一些棍意识形态棍子"},{"start":483.7,"end":486.88,"text":"对这种人你不要看到他站在台面上"},{"start":486.88,"end":487.72,"text":"可能就是个学生"},{"start":487.72,"end":488.56,"text":"好像是个无害的"},{"start":491.16,"end":492.26,"text":"我再强调一遍"},{"start":492.26,"end":495.51,"text":"其他的不知道这些人唉"},{"start":495.51,"end":498.0,"text":"就是你要知道这些人是很丑恶的"},{"start":498.0,"end":498.78,"text":"你明白吧"},{"start":498.78,"end":502.6,"text":"他们会和很多势力合作请客吃饭"},{"start":502.6,"end":504.76,"text":"他们请客吃饭就是把人摇过来"},{"start":504.76,"end":508.53,"text":"是把同样可能闻到了血腥味儿的那种人"},{"start":508.53,"end":509.43,"text":"摇过去吃饭"},{"start":509.43,"end":511.65,"text":"吃饭了之后就都是上名单了"},{"start":511.65,"end":512.61,"text":"一网打尽的"},{"start":512.61,"end":517.37,"text":"他们这种人有的是品鉴很低劣的啊"},{"start":517.37,"end":518.96,"text":"他们把政治"},{"start":518.96,"end":521.78,"text":"他们把这样的活动看成是捞钱的机会"},{"start":521.78,"end":523.058,"text":"看成是这个"},{"start":524.78,"end":526.36,"text":"看着是这个啊"},{"start":526.36,"end":528.4,"text":"就是说忽悠副歌过去"},{"start":528.4,"end":531.16,"text":"跟他搞秘密结社的一个机会啊"},{"start":531.16,"end":535.359,"text":"他对于工艺工艺的这个理念从根本上是违背的"},{"start":536.98,"end":538.86,"text":"宫本上是违背的"},{"start":538.86,"end":539.76,"text":"明白吗"},{"start":539.76,"end":542.56,"text":"因为我们至少你这个钱你得是自己转过来的"},{"start":545.22,"end":551.1,"text":"至少活动过程当中你能够获得的支持"},{"start":551.1,"end":552.51,"text":"他花到哪里去"},{"start":552.51,"end":554.12,"text":"要向所有人公示"},{"start":554.56,"end":558.49,"text":"你凭什么有钱可以获得民意和场所"},{"start":558.49,"end":559.96,"text":"怎么注册这个名义"},{"start":559.96,"end":560.5,"text":"怎么获得"},{"start":560.5,"end":561.22,"text":"这个场所"},{"start":561.22,"end":563.859,"text":"都是要有你独立的经济活动"},{"start":564.26,"end":566.38,"text":"独立的团队建设"},{"start":567.98,"end":572.38,"text":"啊这个这个公益小组团体本身是一个内部"},{"start":575.78,"end":576.92,"text":"重要的经营信息"},{"start":576.92,"end":579.8,"text":"重要的它的主要的活动方式"},{"start":579.8,"end":582.06,"text":"都是要向外对外公布的"},{"start":582.38,"end":584.75,"text":"不是搞秘密小组的"},{"start":584.75,"end":586.37,"text":"不是搞秘密小组的"},{"start":589.76,"end":591.71,"text":"原教旨主义者啊"},{"start":591.71,"end":593.6,"text":"他顶着我的名头做这种事情"},{"start":593.6,"end":597.66,"text":"我觉得搬起石头只能砸自己的脚嘛"},{"start":597.66,"end":598.56,"text":"那就是坐牢"},{"start":598.56,"end":600.42,"text":"这些家伙自己去坐牢吧"},{"start":600.42,"end":603.73,"text":"我希望其他的这个年轻人可以擦亮眼睛啊"},{"start":603.73,"end":604.48,"text":"擦亮眼睛"},{"start":604.48,"end":608.42,"text":"我更希望大家能够参与哪种人组织起来的"},{"start":608.42,"end":609.74,"text":"这个公益小组呢"},{"start":609.74,"end":611.4,"text":"勤工俭学的学生"},{"start":611.4,"end":614.88,"text":"这个学生不是完全的这个脱产学生"},{"start":614.88,"end":617.1,"text":"这个学生是同时在劳动"},{"start":617.1,"end":619.839,"text":"就是或者以及就是劳动者"},{"start":620.16,"end":621.72,"text":"就是劳动者"},{"start":621.72,"end":625.65,"text":"原则上我说我括号里面都要加一个labor的"},{"start":625.65,"end":630.0,"text":"原则上公益小组的成员至少一半"},{"start":631.38,"end":633.06,"text":"至少一半得是劳动者"},{"start":633.06,"end":638.2,"text":"或得是得是不能是脱产"},{"start":638.2,"end":639.67,"text":"学生占主要的"},{"start":639.67,"end":641.02,"text":"脱产学生占主要的"},{"start":641.02,"end":643.04,"text":"到学校里面成立社团去"},{"start":643.04,"end":644.48,"text":"你拓展学生占主要"},{"start":644.48,"end":645.62,"text":"你就玩不了这游戏"},{"start":645.62,"end":647.03,"text":"你得出去怎么样"},{"start":647.03,"end":649.42,"text":"你得出去打"},{"start":649.42,"end":649.66,"text":"工"},{"start":649.66,"end":651.01,"text":"人要去劳动"},{"start":651.01,"end":653.52,"text":"在劳动过程中富集资源"},{"start":654.26,"end":655.96,"text":"我看到一个最糟糕的形态"},{"start":657.58,"end":659.32,"text":"完全脱产的流氓"},{"start":662.32,"end":665.28,"text":"啊我是我现在了解到的情报"},{"start":665.28,"end":668.14,"text":"只有武汉那边出现了这么一个东西"},{"start":668.3,"end":671.18,"text":"你看这个这个情绪在演演化下去的"},{"start":674.36,"end":681.67,"text":"政治投机流氓学生大一大二就是不不愿意劳动"},{"start":681.67,"end":683.42,"text":"就愿意政治投机"},{"start":684.28,"end":685.38,"text":"注意忽悠"},{"start":685.38,"end":687.42,"text":"副歌是给你钱搞秘密场所"},{"start":687.42,"end":688.47,"text":"秘密名义"},{"start":692.66,"end":695.21,"text":"他的涨往后面涨"},{"start":695.21,"end":696.89,"text":"然后天天念原教旨金"},{"start":696.89,"end":700.67,"text":"他适合劳动群众是彻底的脱离的"},{"start":700.67,"end":701.3,"text":"这种人"},{"start":705.91,"end":711.12,"text":"我在原则上呼吁所有人和这些人"},{"start":713.58,"end":715.86,"text":"决裂再强一点"},{"start":715.86,"end":717.68,"text":"呼吁所有人和这些人决裂"},{"start":717.82,"end":720.82,"text":"我原则上我不愿意他们说他们做的事情是公益"},{"start":720.82,"end":724.27,"text":"他们做这件事事情对工人群众啊"},{"start":724.27,"end":728.96,"text":"对劳劳劳动群众就长远利益没有任何意义"},{"start":728.96,"end":730.16,"text":"没有任何意义"},{"start":730.16,"end":731.36,"text":"擦亮眼睛看一看"},{"start":734.36,"end":735.29,"text":"大一大二的"},{"start":735.29,"end":736.79,"text":"但他背后有那种人"},{"start":736.79,"end":739.85,"text":"或者说他自己就是一个脱产学生"},{"start":739.85,"end":742.55,"text":"但是他自己就在那种激进的啊"},{"start":745.31,"end":746.93,"text":"用暴力方式反建制"},{"start":746.93,"e