  "segments": [
    {
      "ordinal": 0,
      "start_ms": 2260,
      "end_ms": 3179,
      "text": "哦哦"
    },
    {
      "ordinal": 1,
      "start_ms": 9300,
      "end_ms": 10100,
      "text": "嗯"
    },
    {
      "ordinal": 2,
      "start_ms": 27120,
      "end_ms": 29240,
      "text": "心思惹人笑"
    },
    {
      "ordinal": 3,
      "start_ms": 29240,
      "end_ms": 32558,
      "text": "绝非所谓佳人"
    },
    {
      "ordinal": 4,
      "start_ms": 33860,
      "end_ms": 39360,
      "text": "却何必问早零落在风尘"
    },
    {
      "ordinal": 5,
      "start_ms": 40060,
      "end_ms": 42330,
      "text": "听一句话"
    },
    {
      "ordinal": 6,
      "start_ms": 42330,
      "end_ms": 45339,
      "text": "亭合理不是恨"
    },
    {
      "ordinal": 7,
      "start_ms": 45500,
      "end_ms": 48140,
      "text": "莫须化作火"
    },
    {
      "ordinal": 8,
      "start_ms": 48140,
      "end_ms": 48560,
      "text": "人"
    },
    {
      "ordinal": 9,
      "start_ms": 48560,
      "end_ms": 52120,
      "text": "负了良辰"
    },
    {
      "ordinal": 10,
      "start_ms": 54120,
      "end_ms": 55760,
      "text": "心思惹人笑"
    },
    {
      "ordinal": 11,
      "start_ms": 56780,
      "end_ms": 59559,
      "text": "吾爱所谓温存"
    },
    {
      "ordinal": 12,
      "start_ms": 60920,
      "end_ms": 66220,
      "text": "却何必问早已失的伤痕"
    },
    {
      "ordinal": 13,
      "start_ms": 67060,
      "end_ms": 70560,
      "text": "今一朝乘风归去"
    },
    {
      "ordinal": 14,
      "start_ms": 70560,
      "end_ms": 72080,
      "text": "不是恨"
    },
    {
      "ordinal": 15,
      "start_ms": 72440,
      "end_ms": 78140,
      "text": "默许那多情人空对汉族"
    },
    {
      "ordinal": 16,
      "start_ms": 80700,
      "end_ms": 84940,
      "text": "一笑心越痛"
    },
    {
      "ordinal": 17,
      "start_ms": 85400,
      "end_ms": 89890,
      "text": "风影千载成空"
    },
    {
      "ordinal": 18,
      "start_ms": 89890,
      "end_ms": 92500,
      "text": "何如"
    },
    {
      "ordinal": 19,
      "start_ms": 94120,
      "end_ms": 101070,
      "text": "唱歌一曲沧浪一曲"
    },
    {
      "ordinal": 20,
      "start_ms": 101070,
      "end_ms": 105520,
      "text": "我心无奈从容"
    },
    {
      "ordinal": 21,
      "start_ms": 110980,
      "end_ms": 112800,
      "text": "江东微北"
    },
    {
      "ordinal": 22,
      "start_ms": 112800,
      "end_ms": 115420,
      "text": "汉族与水同"
    },
    {
      "ordinal": 23,
      "start_ms": 118100,
      "end_ms": 119600,
      "text": "春去秋来"
    },
    {
      "ordinal": 24,
      "start_ms": 119600,
      "end_ms": 122520,
      "text": "莲花清露娜"
    },
    {
      "ordinal": 25,
      "start_ms": 123700,
      "end_ms": 126030,
      "text": "听一句话"
    },
    {
      "ordinal": 26,
      "start_ms": 126030,
      "end_ms": 129750,
      "text": "亭河里抚慰谁人"
    },
    {
      "ordinal": 27,
      "start_ms": 129750,
      "end_ms": 130860,
      "text": "心"
    },
    {
      "ordinal": 28,
      "start_ms": 131260,
      "end_ms": 132930,
      "text": "在人间"
    },
    {
      "ordinal": 29,
      "start_ms": 132930,
      "end_ms": 136000,
      "text": "风波难平"
    },
    {
      "ordinal": 30,
      "start_ms": 147260,
      "end_ms": 148180,
      "text": "嗯"
    },
    {
      "ordinal": 31,
      "start_ms": 182640,
      "end_ms": 184730,
      "text": "心思惹人笑"
    },
    {
      "ordinal": 32,
      "start_ms": 184730,
      "end_ms": 187580,
      "text": "不爱所谓温存"
    },
    {
      "ordinal": 33,
      "start_ms": 189680,
      "end_ms": 196480,
      "text": "却何必问早已逝的伤痕轻"
    },
    {
      "ordinal": 34,
      "start_ms": 196660,
      "end_ms": 199060,
      "text": "一朝乘风归去"
    },
    {
      "ordinal": 35,
      "start_ms": 199060,
      "end_ms": 200840,
      "text": "不许恨"
    },
    {
      "ordinal": 36,
      "start_ms": 200920,
      "end_ms": 204100,
      "text": "我是那朵情人"
    },
    {
      "ordinal": 37,
      "start_ms": 204100,
      "end_ms": 206780,
      "text": "空对汉字"
    },
    {
      "ordinal": 38,
      "start_ms": 209160,
      "end_ms": 215020,
      "text": "一笑心越痛饮"
    },
    {
      "ordinal": 39,
      "start_ms": 215860,
      "end_ms": 220620,
      "text": "千载诚恐何如"
    },
    {
      "ordinal": 40,
      "start_ms": 222679,
      "end_ms": 228589,
      "text": "唱歌一曲苍浪"
    },
    {
      "ordinal": 41,
      "start_ms": 228589,
      "end_ms": 230779,
      "text": "一曲拨我心"
    },
    {
      "ordinal": 42,
      "start_ms": 230779,
      "end_ms": 234100,
      "text": "无奈从容"
    },
    {
      "ordinal": 43,
      "start_ms": 239439,
      "end_ms": 241289,
      "text": "江东渭北"
    },
    {
      "ordinal": 44,
      "start_ms": 241289,
      "end_ms": 243880,
      "text": "汉族与水头"
    },
    {
      "ordinal": 45,
      "start_ms": 246279,
      "end_ms": 248099,
      "text": "春去秋来"
    },
    {
      "ordinal": 46,
      "start_ms": 248099,
      "end_ms": 251519,
      "text": "莲花清露浓"
    },
    {
      "ordinal": 47,
      "start_ms": 252140,
      "end_ms": 254440,
      "text": "听一句话"
    },
    {
      "ordinal": 48,
      "start_ms": 254440,
      "end_ms": 259240,
      "text": "亭和你抚慰谁任性"
    },
    {
      "ordinal": 49,
      "start_ms": 259720,
      "end_ms": 261390,
      "text": "在人间"
    },
    {
      "ordinal": 50,
      "start_ms": 261390,
      "end_ms": 264020,
      "text": "风波难平"
    },
    {
      "ordinal": 51,
      "start_ms": 266500,
      "end_ms": 269720,
      "text": "无奈千载成功"
    },
    {
      "ordinal": 52,
      "start_ms": 273280,
      "end_ms": 275900,
      "text": "来去都从容"
    },
    {
      "ordinal": 53,
      "start_ms": 276620,
      "end_ms": 280540,
      "text": "一曲花亭河里浮"
    },
    {
      "ordinal": 54,
      "start_ms": 280540,
      "end_ms": 284990,
      "text": "为谁远行在人间"
    },
    {
      "ordinal": 55,
      "start_ms": 284990,
      "end_ms": 288180,
      "text": "风波平"
    },
    {
      "ordinal": 56,
      "start_ms": 293980,
      "end_ms": 302200,
      "text": "唱歌一曲苍茫一去无痕无痕"
    },
    {
      "ordinal": 57,
      "start_ms": 313840,
      "end_ms": 315060,
      "text": "唱到后面没力气了"
    },
    {
      "ordinal": 58,
      "start_ms": 315060,
      "end_ms": 315900,
      "text": "然后破音了"
    },
    {
      "ordinal": 59,
      "start_ms": 315900,
      "end_ms": 316620,
      "text": "人家不要管啊"
    },
    {
      "ordinal": 60,
      "start_ms": 316620,
      "end_ms": 318920,
      "text": "这歌本来就是让女孩子唱的"
    },
    {
      "ordinal": 61,
      "start_ms": 319099,
      "end_ms": 320359,
      "text": "那叫情基啊"
    },
    {
      "ordinal": 62,
      "start_ms": 320359,
      "end_ms": 326120,
      "text": "就是以这个弹琴的歌姬的那个第一第一人称口吻来写的哈"
    }
  ],
  "text": "哦哦\n嗯\n心思惹人笑\n绝非所谓佳人\n却何必问早零落在风尘\n听一句话\n亭合理不是恨\n莫须化作火\n人\n负了良辰\n心思惹人笑\n吾爱所谓温存\n却何必问早已失的伤痕\n今一朝乘风归去\n不是恨\n默许那多情人空对汉族\n一笑心越痛\n风影千载成空\n何如\n唱歌一曲沧浪一曲\n我心无奈从容\n江东微北\n汉族与水同\n春去秋来\n莲花清露娜\n听一句话\n亭河里抚慰谁人\n心\n在人间\n风波难平\n嗯\n心思惹人笑\n不爱所谓温存\n却何必问早已逝的伤痕轻\n一朝乘风归去\n不许恨\n我是那朵情人\n空对汉字\n一笑心越痛饮\n千载诚恐何如\n唱歌一曲苍浪\n一曲拨我心\n无奈从容\n江东渭北\n汉族与水头\n春去秋来\n莲花清露浓\n听一句话\n亭和你抚慰谁任性\n在人间\n风波难平\n无奈千载成功\n来去都从容\n一曲花亭河里浮\n为谁远行在人间\n风波平\n唱歌一曲苍茫一去无痕无痕\n唱到后面没力气了\n然后破音了\n人家不要管啊\n这歌本来就是让女孩子唱的\n那叫情基啊\n就是以这个弹琴的歌姬的那个第一第一人称口吻来写的哈",
