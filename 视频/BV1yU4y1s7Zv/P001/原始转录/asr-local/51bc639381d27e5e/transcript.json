  "segments": [
    {
      "ordinal": 0,
      "start_ms": 27360,
      "end_ms": 33600,
      "text": "心似惹人笑，绝非所谓佳人。"
    },
    {
      "ordinal": 1,
      "start_ms": 34080,
      "end_ms": 39440,
      "text": "却又何必问，早零落在风尘。"
    },
    {
      "ordinal": 2,
      "start_ms": 40240,
      "end_ms": 44640,
      "text": "听一曲花亭何地不须恨，"
    },
    {
      "ordinal": 3,
      "start_ms": 45840,
      "end_ms": 52320,
      "text": "莫学那做古人负了良辰。"
    },
    {
      "ordinal": 4,
      "start_ms": 54400,
      "end_ms": 59040,
      "text": "心似惹人笑，不爱所谓温存。"
    },
    {
      "ordinal": 5,
      "start_ms": 61120,
      "end_ms": 66320,
      "text": "却又何必问，早遗失了伤痕。"
    },
    {
      "ordinal": 6,
      "start_ms": 67280,
      "end_ms": 71680,
      "text": "今一朝乘风归去不须恨，"
    },
    {
      "ordinal": 7,
      "start_ms": 72800,
      "end_ms": 77600,
      "text": "莫学那多情人空对寒樽。"
    },
    {
      "ordinal": 8,
      "start_ms": 80960,
      "end_ms": 92240,
      "text": "一笑新月同影，千载成空何如？"
    },
    {
      "ordinal": 9,
      "start_ms": 94320,
      "end_ms": 106080,
      "text": "长歌一曲藏，浪一曲我心无奈从容。"
    },
    {
      "ordinal": 10,
      "start_ms": 111200,
      "end_ms": 115840,
      "text": "江东为北寒樽与谁同？"
    },
    {
      "ordinal": 11,
      "start_ms": 118000,
      "end_ms": 123040,
      "text": "春去秋来菱花镜露浓。"
    },
    {
      "ordinal": 12,
      "start_ms": 123920,
      "end_ms": 130000,
      "text": "听一曲花亭何地不为谁人心，"
    },
    {
      "ordinal": 13,
      "start_ms": 131520,
      "end_ms": 135280,
      "text": "在人间风波难平。"
    },
    {
      "ordinal": 14,
      "start_ms": 182836,
      "end_ms": 187396,
      "text": "心思惹人笑，不爱所谓温存，"
    },
    {
      "ordinal": 15,
      "start_ms": 189636,
      "end_ms": 194916,
      "text": "却又何必问，早已失了伤痕。"
    },
    {
      "ordinal": 16,
      "start_ms": 195716,
      "end_ms": 200116,
      "text": "今一朝乘风归去不须恨，"
    },
    {
      "ordinal": 17,
      "start_ms": 201316,
      "end_ms": 206036,
      "text": "莫学那多情远空对寒樽。"
    },
    {
      "ordinal": 18,
      "start_ms": 209396,
      "end_ms": 220676,
      "text": "一笑心月同影，千载成空何如？"
    },
    {
      "ordinal": 19,
      "start_ms": 222916,
      "end_ms": 236436,
      "text": "长歌一曲沧浪一曲，我心无奈从容。"
    },
    {
      "ordinal": 20,
      "start_ms": 239636,
      "end_ms": 244756,
      "text": "江东挥北寒樽与谁同？"
    },
    {
      "ordinal": 21,
      "start_ms": 246516,
      "end_ms": 251636,
      "text": "春去秋来林花清露浓。"
    },
    {
      "ordinal": 22,
      "start_ms": 252356,
      "end_ms": 258436,
      "text": "听一曲画听何里，抚慰谁人心？"
    },
    {
      "ordinal": 23,
      "start_ms": 259956,
      "end_ms": 263556,
      "text": "在人间风波难平，"
    },
    {
      "ordinal": 24,
      "start_ms": 266756,
      "end_ms": 275796,
      "text": "无奈千载成空，来去都从容。"
    },
    {
      "ordinal": 25,
      "start_ms": 276996,
      "end_ms": 282646,
      "text": "一曲画听何里，抚慰谁人心？"
    },
    {
      "ordinal": 26,
      "start_ms": 283416,
      "end_ms": 293426,
      "text": "在人间风波难平。"
    },
    {
      "ordinal": 27,
      "start_ms": 294196,
      "end_ms": 304276,
      "text": "长歌一曲沧浪一曲无痕无痕。"
    },
    {
      "ordinal": 28,
      "start_ms": 314116,
      "end_ms": 324436,
      "text": "哎，唱到后面没力气了，然后破音了，人家不要管啊，这歌本来就是让女孩子唱的，啊叫琴姬啊，就是以这个弹琴的歌姬的那个第一第一"
    },
    {
      "ordinal": 29,
      "start_ms": 324436,
      "end_ms": 325956,
      "text": "人称口吻来来写的哈。"
    }
