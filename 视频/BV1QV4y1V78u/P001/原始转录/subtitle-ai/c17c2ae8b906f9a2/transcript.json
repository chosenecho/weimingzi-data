{
  "bvid": "BV1QV4y1V78u",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "c17c2ae8b906f9a2cdd6e8003930235965fa5407acae90716dcd7f26d602f5b2",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 640,
      "end_ms": 2100,
      "text": "回应一个信件啊"
    },
    {
      "ordinal": 1,
      "start_ms": 2100,
      "end_ms": 5030,
      "text": "这个可公开咋都行啊"
    },
    {
      "ordinal": 2,
      "start_ms": 5030,
      "end_ms": 5960,
      "text": "守卫名字你好"
    },
    {
      "ordinal": 3,
      "start_ms": 5960,
      "end_ms": 7000,
      "text": "我是一个大势女"
    },
    {
      "ordinal": 4,
      "start_ms": 7000,
      "end_ms": 7840,
      "text": "对我来说"
    },
    {
      "ordinal": 5,
      "start_ms": 7840,
      "end_ms": 9580,
      "text": "做到完全坦白是地狱难度的"
    },
    {
      "ordinal": 6,
      "start_ms": 9580,
      "end_ms": 11380,
      "text": "我对自己的真实很感兴趣"
    },
    {
      "ordinal": 7,
      "start_ms": 11380,
      "end_ms": 13300,
      "text": "所以超级喜欢自我剖析"
    },
    {
      "ordinal": 8,
      "start_ms": 13300,
      "end_ms": 17289,
      "text": "我的理想是完全无度的坦白"
    },
    {
      "ordinal": 9,
      "start_ms": 17289,
      "end_ms": 19179,
      "text": "但想到去陈述具体事件"
    },
    {
      "ordinal": 10,
      "start_ms": 19179,
      "end_ms": 20289,
      "text": "想象到未明子做"
    },
    {
      "ordinal": 11,
      "start_ms": 20289,
      "end_ms": 21999,
      "text": "对此实事求是的揭露"
    },
    {
      "ordinal": 12,
      "start_ms": 21999,
      "end_ms": 23180,
      "text": "我加引号"
    },
    {
      "ordinal": 13,
      "start_ms": 23180,
      "end_ms": 26780,
      "text": "引号只是强调我是相信为名字对我的判断和揭露的"
    },
    {
      "ordinal": 14,
      "start_ms": 26780,
      "end_ms": 27800,
      "text": "我就很难去坦白"
    },
    {
      "ordinal": 15,
      "start_ms": 27800,
      "end_ms": 30820,
      "text": "我认为我目前的价值观就是以我为调度的"
    },
    {
      "ordinal": 16,
      "start_ms": 31080,
      "end_ms": 33240,
      "text": "就是不会以外界来确定价值"
    },
    {
      "ordinal": 17,
      "start_ms": 33240,
      "end_ms": 35760,
      "text": "我追求我认为有意义的是可以接受的"
    },
    {
      "ordinal": 18,
      "start_ms": 35760,
      "end_ms": 38190,
      "text": "是资产胜利确实很爽"
    },
    {
      "ordinal": 19,
      "start_ms": 38190,
      "end_ms": 39099,
      "text": "自信"
    },
    {
      "ordinal": 20,
      "start_ms": 40700,
      "end_ms": 42820,
      "text": "白给我我肯定要不是自选"
    },
    {
      "ordinal": 21,
      "start_ms": 42820,
      "end_ms": 43240,
      "text": "看错了"
    },
    {
      "ordinal": 22,
      "start_ms": 43240,
      "end_ms": 43600,
      "text": "白给我"
    },
    {
      "ordinal": 23,
      "start_ms": 43600,
      "end_ms": 44140,
      "text": "我肯定要"
    },
    {
      "ordinal": 24,
      "start_ms": 44140,
      "end_ms": 45790,
      "text": "但自主追求他"
    },
    {
      "ordinal": 25,
      "start_ms": 45790,
      "end_ms": 46510,
      "text": "我是不会的"
    },
    {
      "ordinal": 26,
      "start_ms": 46510,
      "end_ms": 47530,
      "text": "未来可能会变"
    },
    {
      "ordinal": 27,
      "start_ms": 47530,
      "end_ms": 49810,
      "text": "我最厌恶的是别人对我的存在的察觉"
    },
    {
      "ordinal": 28,
      "start_ms": 49810,
      "end_ms": 52070,
      "text": "然后以他们的某种目的对我输出"
    },
    {
      "ordinal": 29,
      "start_ms": 52070,
      "end_ms": 53210,
      "text": "与其造成影响"
    },
    {
      "ordinal": 30,
      "start_ms": 53210,
      "end_ms": 55130,
      "text": "我喜欢陈述探讨"
    },
    {
      "ordinal": 31,
      "start_ms": 55130,
      "end_ms": 56519,
      "text": "然后自己思考"
    },
    {
      "ordinal": 32,
      "start_ms": 57280,
      "end_ms": 60000,
      "text": "他这个思考的诗写得像个男字啊"
    },
    {
      "ordinal": 33,
      "start_ms": 60180,
      "end_ms": 63000,
      "text": "男权主义思考心灵观啊"
    },
    {
      "ordinal": 34,
      "start_ms": 63000,
      "end_ms": 65340,
      "text": "但我但不喜欢附带偏执的交流"
    },
    {
      "ordinal": 35,
      "start_ms": 65340,
      "end_ms": 66780,
      "text": "别人对我的这种影响"
    },
    {
      "ordinal": 36,
      "start_ms": 66780,
      "end_ms": 68520,
      "text": "我可以做出"
    },
    {
      "ordinal": 37,
      "start_ms": 72340,
      "end_ms": 76080,
      "text": "他写的是我可以做出负极大代价"
    },
    {
      "ordinal": 38,
      "start_ms": 76080,
      "end_ms": 77100,
      "text": "就是我可以付出"
    },
    {
      "ordinal": 39,
      "start_ms": 77100,
      "end_ms": 77640,
      "text": "他写成了"
    },
    {
      "ordinal": 40,
      "start_ms": 77640,
      "end_ms": 80040,
      "text": "我可以做出负极大的这种笔误"
    },
    {
      "ordinal": 41,
      "start_ms": 80040,
      "end_ms": 83890,
      "text": "都是有这无意识啊"
    },
    {
      "ordinal": 42,
      "start_ms": 83890,
      "end_ms": 86820,
      "text": "我可以付出极大代价脱离他们的事"
    },
    {
      "ordinal": 43,
      "start_ms": 87800,
      "end_ms": 88240,
      "text": "哦"
    },
    {
      "ordinal": 44,
      "start_ms": 88240,
      "end_ms": 88780,
      "text": "是这样啊"
    },
    {
      "ordinal": 45,
      "start_ms": 88780,
      "end_ms": 90220,
      "text": "是我我都无意识了"
    },
    {
      "ordinal": 46,
      "start_ms": 90220,
      "end_ms": 94060,
      "text": "我可以做出负极大代价脱离他们的事"
    },
    {
      "ordinal": 47,
      "start_ms": 94060,
      "end_ms": 96970,
      "text": "哎呦反正是我读懂了"
    },
    {
      "ordinal": 48,
      "start_ms": 96970,
      "end_ms": 98080,
      "text": "我失语了"
    },
    {
      "ordinal": 49,
      "start_ms": 98080,
      "end_ms": 100720,
      "text": "失读症了别人别人对我的这种影响"
    },
    {
      "ordinal": 50,
      "start_ms": 100720,
      "end_ms": 104060,
      "text": "他他也就他可以付很大的代价来脱离他们"
    },
    {
      "ordinal": 51,
      "start_ms": 104060,
      "end_ms": 105260,
      "text": "就是放弃"
    },
    {
      "ordinal": 52,
      "start_ms": 105260,
      "end_ms": 107399,
      "text": "我认为有意义的是来脱离他们"
    },
    {
      "ordinal": 53,
      "start_ms": 107480,
      "end_ms": 109100,
      "text": "我虽然自我剖析"
    },
    {
      "ordinal": 54,
      "start_ms": 109100,
      "end_ms": 111620,
      "text": "但并不客观清晰地认识自己"
    },
    {
      "ordinal": 55,
      "start_ms": 111620,
      "end_ms": 112940,
      "text": "也存在对自己的想象"
    },
    {
      "ordinal": 56,
      "start_ms": 112940,
      "end_ms": 116150,
      "text": "所以我觉得我的室友我接受他们的价值观"
    },
    {
      "ordinal": 57,
      "start_ms": 116150,
      "end_ms": 116450,
      "text": "总"
    },
    {
      "ordinal": 58,
      "start_ms": 116450,
      "end_ms": 118070,
      "text": "是把别人和自己掺在一起"
    },
    {
      "ordinal": 59,
      "start_ms": 118070,
      "end_ms": 119930,
      "text": "因为我知道比较是相对的"
    },
    {
      "ordinal": 60,
      "start_ms": 119930,
      "end_ms": 120890,
      "text": "所以意义不大"
    },
    {
      "ordinal": 61,
      "start_ms": 120890,
      "end_ms": 122270,
      "text": "就是不希望和别人比"
    },
    {
      "ordinal": 62,
      "start_ms": 122270,
      "end_ms": 125480,
      "text": "但是他们就不能安心追求他们心里的价值"
    },
    {
      "ordinal": 63,
      "start_ms": 126660,
      "end_ms": 128479,
      "text": "偏要把别人拉进去比较"
    },
    {
      "ordinal": 64,
      "start_ms": 128479,
      "end_ms": 131120,
      "text": "然后反映在他们的心情上"
    },
    {
      "ordinal": 65,
      "start_ms": 131120,
      "end_ms": 131720,
      "text": "反应的硬"
    },
    {
      "ordinal": 66,
      "start_ms": 131720,
      "end_ms": 132320,
      "text": "写错了"
    },
    {
      "ordinal": 67,
      "start_ms": 132320,
      "end_ms": 134890,
      "text": "写成他写出的应对应"
    },
    {
      "ordinal": 68,
      "start_ms": 134890,
      "end_ms": 138130,
      "text": "我察觉到感受到就会影响我的情绪"
    },
    {
      "ordinal": 69,
      "start_ms": 138130,
      "end_ms": 140100,
      "text": "感到感觉很恶心"
    },
    {
      "ordinal": 70,
      "start_ms": 140320,
      "end_ms": 143410,
      "text": "就感觉他自己在和别人比就很恶心了"
    },
    {
      "ordinal": 71,
      "start_ms": 143410,
      "end_ms": 146200,
      "text": "就是生活的所有角落都可能随时被他们凝视"
    },
    {
      "ordinal": 72,
      "start_ms": 146200,
      "end_ms": 150000,
      "text": "然后我察觉到他不喜欢被别人拿来拿来比啊"
    },
    {
      "ordinal": 73,
      "start_ms": 150000,
      "end_ms": 155220,
      "text": "在这之前我超级佛系并不会对别人产生厌恶的感觉"
    },
    {
      "ordinal": 74,
      "start_ms": 155220,
      "end_ms": 156840,
      "text": "就觉得一切都有原因"
    },
    {
      "ordinal": 75,
      "start_ms": 156840,
      "end_ms": 156960,
      "text": "可"
    },
    {
      "ordinal": 76,
      "start_ms": 156960,
      "end_ms": 157680,
      "text": "以接受"
    },
    {
      "ordinal": 77,
      "start_ms": 157680,
      "end_ms": 160200,
      "text": "所以对大多数是我心情是没有感觉的"
    },
    {
      "ordinal": 78,
      "start_ms": 160200,
      "end_ms": 162500,
      "text": "但是现在我变得非常容易讨厌"
    },
    {
      "ordinal": 79,
      "start_ms": 163399,
      "end_ms": 165219,
      "text": "觉得世界上的正常人极少"
    },
    {
      "ordinal": 80,
      "start_ms": 165219,
      "end_ms": 167439,
      "text": "总之我渴望不加掩饰的了解我自己"
    },
    {
      "ordinal": 81,
      "start_ms": 167439,
      "end_ms": 168699,
      "text": "然后活着去追求"
    },
    {
      "ordinal": 82,
      "start_ms": 168699,
      "end_ms": 171370,
      "text": "但是我现在的世界认识体系很混乱"
    },
    {
      "ordinal": 83,
      "start_ms": 171370,
      "end_ms": 173240,
      "text": "我想法也转变很快"
    },
    {
      "ordinal": 84,
      "start_ms": 173800,
      "end_ms": 174900,
      "text": "有点虚无主义"
    },
    {
      "ordinal": 85,
      "start_ms": 174900,
      "end_ms": 178260,
      "text": "但是我有切实讨厌的是有喜欢的是不管看不看性"
    },
    {
      "ordinal": 86,
      "start_ms": 178260,
      "end_ms": 179160,
      "text": "感谢未明子"
    },
    {
      "ordinal": 87,
      "start_ms": 179160,
      "end_ms": 179460,
      "text": "对的"
    },
    {
      "ordinal": 88,
      "start_ms": 179460,
      "end_ms": 182120,
      "text": "我没有承认任何道德的价值"
    },
    {
      "ordinal": 89,
      "start_ms": 182359,
      "end_ms": 183379,
      "text": "什么东西啊"
    },
    {
      "ordinal": 90,
      "start_ms": 183379,
      "end_ms": 184820,
      "text": "可公开咋都行"
    },
    {
      "ordinal": 91,
      "start_ms": 185200,
      "end_ms": 187960,
      "text": "他说我觉得我并没有明确的价值方向"
    },
    {
      "ordinal": 92,
      "start_ms": 187960,
      "end_ms": 189880,
      "text": "但需要知道自我外界的事"
    },
    {
      "ordinal": 93,
      "start_ms": 189880,
      "end_ms": 191680,
      "text": "只有我喜欢的感兴趣的事"
    },
    {
      "ordinal": 94,
      "start_ms": 195790,
      "end_ms": 197599,
      "text": "是这个我啊"
    },
    {
      "ordinal": 95,
      "start_ms": 197599,
      "end_ms": 198499,
      "text": "他只是一个符号"
    },
    {
      "ordinal": 96,
      "start_ms": 198499,
      "end_ms": 200359,
      "text": "它的符号他从符号学上讲"
    },
    {
      "ordinal": 97,
      "start_ms": 200359,
      "end_ms": 203160,
      "text": "它的它有硬的符号性功能"
    },
    {
      "ordinal": 98,
      "start_ms": 203459,
      "end_ms": 206130,
      "text": "就是自我自我想象图示"
    },
    {
      "ordinal": 99,
      "start_ms": 206130,
      "end_ms": 208080,
      "text": "自我想象图是是被生产的"
    },
    {
      "ordinal": 100,
      "start_ms": 213540,
      "end_ms": 215760,
      "text": "你不喜欢被别人拿来类比"
    },
    {
      "ordinal": 101,
      "start_ms": 215760,
      "end_ms": 221809,
      "text": "其实你就是说你这都是这些都是发生在想象界"
    },
    {
      "ordinal": 102,
      "start_ms": 221809,
      "end_ms": 224239,
      "text": "all these happens in the imaginary"
    },
    {
      "ordinal": 103,
      "start_ms": 224239,
      "end_ms": 225900,
      "text": "都发生在想象的位面"
    },
    {
      "ordinal": 104,
      "start_ms": 226519,
      "end_ms": 229159,
      "text": "你现在的思考可以说不是思考"
    },
    {
      "ordinal": 105,
      "start_ms": 229159,
      "end_ms": 229759,
      "text": "是想象"
    },
    {
      "ordinal": 106,
      "start_ms": 229759,
      "end_ms": 230580,
      "text": "imagine"
    },
    {
      "ordinal": 107,
      "start_ms": 232420,
      "end_ms": 233520,
      "text": "就是"
    },
    {
      "ordinal": 108,
      "start_ms": 236200,
      "end_ms": 238680,
      "text": "女性真实的自己很感兴趣"
    },
    {
      "ordinal": 109,
      "start_ms": 238680,
      "end_ms": 239560,
      "text": "就是说"
    },
    {
      "ordinal": 110,
      "start_ms": 243040,
      "end_ms": 247200,
      "text": "take it blankly啊"
    },
    {
      "ordinal": 111,
      "start_ms": 247200,
      "end_ms": 250510,
      "text": "我我就说是个幌子"
    },
    {
      "ordinal": 112,
      "start_ms": 250510,
      "end_ms": 252140,
      "text": "自我是个幌子"
    },
    {
      "ordinal": 113,
      "start_ms": 252179,
      "end_ms": 253979,
      "text": "是一直可以撤回的"
    },
    {
      "ordinal": 114,
      "start_ms": 253979,
      "end_ms": 254879,
      "text": "拿来用的幌子"
    },
    {
      "ordinal": 115,
      "start_ms": 254879,
      "end_ms": 255899,
      "text": "但是他是个幌子"
    },
    {
      "ordinal": 116,
      "start_ms": 255899,
      "end_ms": 257909,
      "text": "内在性内在"
    },
    {
      "ordinal": 117,
      "start_ms": 257909,
      "end_ms": 263839,
      "text": "你总是说哎我内在感觉到我这是一种自由主义"
    },
    {
      "ordinal": 118,
      "start_ms": 263839,
      "end_ms": 265879,
      "text": "这是一种自我主义的自由主义"
    },
    {
      "ordinal": 119,
      "start_ms": 265879,
      "end_ms": 267139,
      "text": "一字头的我"
    },
    {
      "ordinal": 120,
      "start_ms": 267139,
      "end_ms": 268999,
      "text": "我在主义主义里面给他定位过了"
    },
    {
      "ordinal": 121,
      "start_ms": 268999,
      "end_ms": 273660,
      "text": "你可以去看一下一杠四杠几"
    },
    {
      "ordinal": 122,
      "start_ms": 273660,
      "end_ms": 274830,
      "text": "三杠三还是什么"
    },
    {
      "ordinal": 123,
      "start_ms": 274830,
      "end_ms": 275820,
      "text": "我记不得了啊"
    },
    {
      "ordinal": 124,
      "start_ms": 277800,
      "end_ms": 284710,
      "text": "就是说外界的事只有我喜欢的感兴趣的事才在我才在乎这里"
    },
    {
      "ordinal": 125,
      "start_ms": 284710,
      "end_ms": 287900,
      "text": "其实就是那你的你的你的喜欢"
    },
    {
      "ordinal": 126,
      "start_ms": 287900,
      "end_ms": 290820,
      "text": "你的兴趣就已经和你是不一样的了"
    },
    {
      "ordinal": 127,
      "start_ms": 290820,
      "end_ms": 293070,
      "text": "你的喜欢和你的兴趣是被生产"
    },
    {
      "ordinal": 128,
      "start_ms": 293070,
      "end_ms": 294840,
      "text": "是被是被创造出来的"
    },
    {
      "ordinal": 129,
      "start_ms": 294840,
      "end_ms": 296880,
      "text": "是被诱导出来诱发出来的"
    },
    {
      "ordinal": 130,
      "start_ms": 296880,
      "end_ms": 297840,
      "text": "不信信不相信"
    },
    {
      "ordinal": 131,
      "start_ms": 297840,
      "end_ms": 299140,
      "text": "你去拼多多上"
    },
    {
      "ordinal": 132,
      "start_ms": 299320,
      "end_ms": 304740,
      "text": "或者你去天猫搜什么女性戒指"
    },
    {
      "ordinal": 133,
      "start_ms": 308060,
      "end_ms": 309440,
      "text": "你会越看越喜欢"
    },
    {
      "ordinal": 134,
      "start_ms": 309440,
      "end_ms": 310220,
