{
  "bvid": "BV1DV411N7uH",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "17ea2dc7328b04d41de9ee6892273fa73f6fc7745a5a882e2aef6ef3e5cfa8bc",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 460,
      "end_ms": 5160,
      "text": "某个有报假警前科的团体"
    },
    {
      "ordinal": 1,
      "start_ms": 5780,
      "end_ms": 10640,
      "text": "想要把我和我的团队置于死地"
    },
    {
      "ordinal": 2,
      "start_ms": 17339,
      "end_ms": 21830,
      "text": "陈叠成打的材料啊"
    },
    {
      "ordinal": 3,
      "start_ms": 21830,
      "end_ms": 23780,
      "text": "他只要当人联系上的"
    },
    {
      "ordinal": 4,
      "start_ms": 23780,
      "end_ms": 25280,
      "text": "他都记了材料"
    },
    {
      "ordinal": 5,
      "start_ms": 25360,
      "end_ms": 28960,
      "text": "有的是直接联系到对口的基本材料"
    },
    {
      "ordinal": 6,
      "start_ms": 28960,
      "end_ms": 32400,
      "text": "有的是联系到不对口的啊"
    },
    {
      "ordinal": 7,
      "start_ms": 32400,
      "end_ms": 33600,
      "text": "什么啊"
    },
    {
      "ordinal": 8,
      "start_ms": 33600,
      "end_ms": 37400,
      "text": "NGO管理办公处记了材料"
    },
    {
      "ordinal": 9,
      "start_ms": 38540,
      "end_ms": 41350,
      "text": "这些人丧心病狂"
    },
    {
      "ordinal": 10,
      "start_ms": 41350,
      "end_ms": 44830,
      "text": "滥用国家的啊"
    },
    {
      "ordinal": 11,
      "start_ms": 44830,
      "end_ms": 49200,
      "text": "执法资源啊"
    },
    {
      "ordinal": 12,
      "start_ms": 49200,
      "end_ms": 50800,
      "text": "救济渠道"
    },
    {
      "ordinal": 13,
      "start_ms": 51220,
      "end_ms": 52840,
      "text": "非法报复"
    },
    {
      "ordinal": 14,
      "start_ms": 52840,
      "end_ms": 54080,
      "text": "打击报复"
    },
    {
      "ordinal": 15,
      "start_ms": 54500,
      "end_ms": 56690,
      "text": "你们这些人有本事要举报"
    },
    {
      "ordinal": 16,
      "start_ms": 56690,
      "end_ms": 57920,
      "text": "实名举报"
    },
    {
      "ordinal": 17,
      "start_ms": 57920,
      "end_ms": 63170,
      "text": "你有任何材料实名公开藏在暗处算什么"
    },
    {
      "ordinal": 18,
      "start_ms": 63170,
      "end_ms": 67590,
      "text": "当然他们也还实名了"
    },
    {
      "ordinal": 19,
      "start_ms": 67590,
      "end_ms": 72220,
      "text": "实名给我发什么告什么什么的"
    },
    {
      "ordinal": 20,
      "start_ms": 72220,
      "end_ms": 73240,
      "text": "一封信"
    },
    {
      "ordinal": 21,
      "start_ms": 73240,
      "end_ms": 75490,
      "text": "只不过说把评论区都关掉"
    },
    {
      "ordinal": 22,
      "start_ms": 75490,
      "end_ms": 77660,
      "text": "在那封信里面啊"
    },
    {
      "ordinal": 23,
      "start_ms": 77660,
      "end_ms": 82460,
      "text": "由于他们已经是全范围的发了这种啊"
    },
    {
      "ordinal": 24,
      "start_ms": 82460,
      "end_ms": 85810,
      "text": "发了这样一种诽谤的这些信息材料"
    },
    {
      "ordinal": 25,
      "start_ms": 85810,
      "end_ms": 89410,
      "text": "所以他就准备在这个B站"
    },
    {
      "ordinal": 26,
      "start_ms": 89410,
      "end_ms": 92320,
      "text": "发这么一个公开的视频啊"
    },
    {
      "ordinal": 27,
      "start_ms": 92320,
      "end_ms": 93679,
      "text": "等着看好戏"
    },
    {
      "ordinal": 28,
      "start_ms": 93860,
      "end_ms": 96590,
      "text": "好像就撒了广撒网"
    },
    {
      "ordinal": 29,
      "start_ms": 96590,
      "end_ms": 99200,
      "text": "终于见了响一个见了响了"
    },
    {
      "ordinal": 30,
      "start_ms": 99200,
      "end_ms": 101300,
      "text": "他觉得他的策略起效了"
    },
    {
      "ordinal": 31,
      "start_ms": 101300,
      "end_ms": 103830,
      "text": "赶紧过来宣称"
    },
    {
      "ordinal": 32,
      "start_ms": 103830,
      "end_ms": 107570,
      "text": "就像那个恐怖组织啊啊搞了好多好多个事件"
    },
    {
      "ordinal": 33,
      "start_ms": 107570,
      "end_ms": 109550,
      "text": "那边一个事件终于起效了"
    },
    {
      "ordinal": 34,
      "start_ms": 109550,
      "end_ms": 111020,
      "text": "他就赶紧发个视频"
    },
    {
      "ordinal": 35,
      "start_ms": 111020,
      "end_ms": 112250,
      "text": "对这件事情负责"
    },
    {
      "ordinal": 36,
      "start_ms": 112250,
      "end_ms": 116180,
      "text": "生怕别人不知道是他在搞鬼啊"
    },
    {
      "ordinal": 37,
      "start_ms": 116180,
      "end_ms": 119380,
      "text": "那视频现在有什么三点几万观看了"
    },
    {
      "ordinal": 38,
      "start_ms": 120740,
      "end_ms": 123010,
      "text": "你看这种做的事"
    },
    {
      "ordinal": 39,
      "start_ms": 123010,
      "end_ms": 127180,
      "text": "听到响了还不敢直接的正儿八经的承认"
    },
    {
      "ordinal": 40,
      "start_ms": 127180,
      "end_ms": 128320,
      "text": "那是你做的"
    },
    {
      "ordinal": 41,
      "start_ms": 130979,
      "end_ms": 135100,
      "text": "你说我怎么知道的那声音啊"
    },
    {
      "ordinal": 42,
      "start_ms": 136179,
      "end_ms": 137039,
      "text": "哦天呐"
    },
    {
      "ordinal": 43,
      "start_ms": 137039,
      "end_ms": 141189,
      "text": "在那个啊那个举报的"
    },
    {
      "ordinal": 44,
      "start_ms": 141189,
      "end_ms": 145120,
      "text": "我们以前接到的举报电话里面的那个人的声音"
    },
    {
      "ordinal": 45,
      "start_ms": 147280,
      "end_ms": 150340,
      "text": "举报电话的最后那个几位数"
    },
    {
      "ordinal": 46,
      "start_ms": 153480,
      "end_ms": 156880,
      "text": "啊还有那个"
    },
    {
      "ordinal": 47,
      "start_ms": 160320,
      "end_ms": 164540,
      "text": "啊我们这个看到了举报材料啊"
    },
    {
      "ordinal": 48,
      "start_ms": 164540,
      "end_ms": 167990,
      "text": "那举报材料上面的那个一堆一堆的"
    },
    {
      "ordinal": 49,
      "start_ms": 167990,
      "end_ms": 169660,
      "text": "那我就要说了"
    },
    {
      "ordinal": 50,
      "start_ms": 172719,
      "end_ms": 174449,
      "text": "你们搬起石头"
    },
    {
      "ordinal": 51,
      "start_ms": 174449,
      "end_ms": 177820,
      "text": "最终只能砸你们自己的脚"
    },
    {
      "ordinal": 52,
      "start_ms": 178000,
      "end_ms": 180130,
      "text": "好弄个视频"
    },
    {
      "ordinal": 53,
      "start_ms": 180130,
      "end_ms": 182300,
      "text": "洋洋洒洒几千字"
    },
    {
      "ordinal": 54,
      "start_ms": 183080,
      "end_ms": 186010,
      "text": "血口喷人啊"
    },
    {
      "ordinal": 55,
      "start_ms": 186010,
      "end_ms": 188209,
      "text": "无中生有啊"
    },
    {
      "ordinal": 56,
      "start_ms": 188209,
      "end_ms": 190639,
      "text": "到处编造假消息"
    },
    {
      "ordinal": 57,
      "start_ms": 192619,
      "end_ms": 196079,
      "text": "说我在搞什么政治结社啊"
    },
    {
      "ordinal": 58,
      "start_ms": 196079,
      "end_ms": 198779,
      "text": "在搞什么一层一层的是什么密谋"
    },
    {
      "ordinal": 59,
      "start_ms": 198779,
      "end_ms": 200399,
      "text": "让学生怎么怎么样"
    },
    {
      "ordinal": 60,
      "start_ms": 200399,
      "end_ms": 202079,
      "text": "你们到处这样去诽谤"
    },
    {
      "ordinal": 61,
      "start_ms": 202079,
      "end_ms": 205060,
      "text": "这样去诬告全国省份"
    },
    {
      "ordinal": 62,
      "start_ms": 205060,
      "end_ms": 209049,
      "text": "各个省份的总队中队大队啊"
    },
    {
      "ordinal": 63,
      "start_ms": 209049,
      "end_ms": 211449,
      "text": "能投资料的都投了资料"
    },
    {
      "ordinal": 64,
      "start_ms": 211449,
      "end_ms": 215400,
      "text": "你们做这些事情就欺一个什么啊"
    },
    {
      "ordinal": 65,
      "start_ms": 215400,
      "end_ms": 217440,
      "text": "欺一个监管层面的信息"
    },
    {
      "ordinal": 66,
      "start_ms": 217440,
      "end_ms": 220200,
      "text": "各个省份这些信息没有沟通啊"
    },
    {
      "ordinal": 67,
      "start_ms": 220200,
      "end_ms": 221360,
      "text": "没有一个交流"
    },
    {
      "ordinal": 68,
      "start_ms": 221360,
      "end_ms": 224120,
      "text": "最终没办法锁定到你们这些人头上"
    },
    {
      "ordinal": 69,
      "start_ms": 225619,
      "end_ms": 227559,
      "text": "你们是要付出代价的"
    },
    {
      "ordinal": 70,
      "start_ms": 227559,
      "end_ms": 229740,
      "text": "付出相应的法律代价"
    },
    {
      "ordinal": 71,
      "start_ms": 230100,
      "end_ms": 232140,
      "text": "付出道德谴责的代价"
    },
    {
      "ordinal": 72,
      "start_ms": 232140,
      "end_ms": 237220,
      "text": "付出在公共舆论平台上被世人唾弃的代价"
    },
    {
      "ordinal": 73,
      "start_ms": 237860,
      "end_ms": 241780,
      "text": "你们的存在是中文互联网啊"
    },
    {
      "ordinal": 74,
      "start_ms": 241780,
      "end_ms": 249130,
      "text": "目前这个现象当中是最恶心糟糕的一种存在啊"
    },
    {
      "ordinal": 75,
      "start_ms": 249130,
      "end_ms": 251020,
      "text": "评论区都不敢开了"
    },
    {
      "ordinal": 76,
      "start_ms": 251119,
      "end_ms": 254089,
      "text": "评论区开了就被弹幕都不敢开了"
    },
    {
      "ordinal": 77,
      "start_ms": 254089,
      "end_ms": 257779,
      "text": "评论区弹幕一开开下来就被所有人骂的"
    },
    {
      "ordinal": 78,
      "start_ms": 257779,
      "end_ms": 260120,
      "text": "就是骂回去了"
    },
    {
      "ordinal": 79,
      "start_ms": 260120,
      "end_ms": 261920,
      "text": "就被骂声给淹死了"
    },
    {
      "ordinal": 80,
      "start_ms": 262380,
      "end_ms": 267000,
      "text": "我真的很难想象这个世界上有一种存在方式"
    },
    {
      "ordinal": 81,
      "start_ms": 267000,
      "end_ms": 270740,
      "text": "有一种人是这样活着的啊"
    },
    {
      "ordinal": 82,
      "start_ms": 272100,
      "end_ms": 273770,
      "text": "太可笑了"
    },
    {
      "ordinal": 83,
      "start_ms": 273770,
      "end_ms": 276200,
      "text": "太可悲了啊"
    },
    {
      "ordinal": 84,
      "start_ms": 276200,
      "end_ms": 277660,
      "text": "太可笑太可悲了"
    },
    {
      "ordinal": 85,
      "start_ms": 280000,
      "end_ms": 284040,
      "text": "啊相比之下我觉得就激流网的啊"
    },
    {
      "ordinal": 86,
      "start_ms": 284040,
      "end_ms": 286810,
      "text": "这些人啊相比之下啊"
    },
    {
      "ordinal": 87,
      "start_ms": 286810,
      "end_ms": 289430,
      "text": "可以算是有道德的多了"
    },
    {
      "ordinal": 88,
      "start_ms": 289430,
      "end_ms": 294260,
      "text": "那可能是因为他们他们他们也很容易被举报啊"
    },
    {
      "ordinal": 89,
      "start_ms": 294260,
      "end_ms": 296620,
      "text": "跟我一样容易被举报啊"
    },
    {
      "ordinal": 90,
      "start_ms": 296620,
      "end_ms": 299180,
      "text": "被匿名的诽谤诬陷"
    },
    {
      "ordinal": 91,
      "start_ms": 301040,
      "end_ms": 303600,
      "text": "啊所以匿名的诽谤和诬陷"
    },
    {
      "ordinal": 92,
      "start_ms": 303960,
      "end_ms": 307830,
      "text": "所以激流网是没有什么头面人物敢冲在前面的"
    },
    {
      "ordinal": 93,
      "start_ms": 307830,
      "end_ms": 309120,
      "text": "他们有有个老人"
    },
    {
      "ordinal": 94,
      "start_ms": 309120,
      "end_ms": 311460,
      "text": "但这个老人呢从来不说清楚"
    },
    {
      "ordinal": 95,
      "start_ms": 311460,
      "end_ms": 314740,
      "text": "他们和激流网是一个什么直接的关系"
    },
    {
      "ordinal": 96,
      "start_ms": 316759,
      "end_ms": 321360,
      "text": "他们新生代的没有人可以站出来了啊"
    },
    {
      "ordinal": 97,
      "start_ms": 321360,
      "end_ms": 322500,
      "text": "也挺可怜的"
    },
    {
      "ordinal": 98,
      "start_ms": 322500,
      "end_ms": 323160,
      "text": "实事求是讲"
    },
    {
      "ordinal": 99,
      "start_ms": 325020,
      "end_ms": 326860,
      "text": "搞点啥外卖骑手的事儿"
    },
    {
      "ordinal": 100,
      "start_ms": 328800,
      "end_ms": 330440,
      "text": "我印象中好像是什么"
    },
    {
      "ordinal": 101,
      "start_ms": 333380,
      "end_ms": 335200,
      "text": "也是一些小年轻啊"
    },
    {
      "ordinal": 102,
      "start_ms": 337199,
      "end_ms": 338299,
      "text": "你叫什么名字的"
    },
    {
      "ordinal": 103,
      "start_ms": 338299,
      "end_ms": 342620,
      "text": "我记不得的那个人和他的那个是女朋友吗"
    },
    {
      "ordinal": 104,
      "start_ms": 343900,
      "end_ms": 345700,
      "text": "哎可怜兮兮的"
    },
    {
      "ordinal": 105,
      "start_ms": 349319,
      "end_ms": 350689,
      "text": "可怜兮兮的"
    },
    {
      "ordinal": 106,
      "start_ms": 350689,
      "end_ms": 352849,
      "text": "可怜兮兮嗯"
    },
    {
      "ordinal": 107,
      "start_ms": 352849,
      "end_ms": 353539,
      "text": "激流网"
    },
    {
      "ordinal": 108,
      "start_ms": 353539,
      "end_ms": 356100,
      "text": "他那个地下的背后"
    },
    {
      "ordinal": 109,
      "start_ms": 356100,
      "end_ms": 358200,
      "text": "那些人其实可怜兮兮的"
    },
    {
      "ordinal": 110,
      "start_ms": 358200,
      "end_ms": 359440,
      "text": "挺可怜兮兮的"
    },
    {
      "ordinal": 111,
      "start_ms": 361620,
      "end_ms": 364160,
      "text": "那我要说的就是说呃"
    },
    {
      "ordinal": 112,
      "start_ms": 364160,
      "end_ms": 366230,
      "text": "如果有违法犯罪的事实"
    },
    {
      "ordinal": 113,
      "start_ms": 366230,
      "end_ms": 371080,
      "text": "我希望法律啊不要饶过任何一个"
    },
    {
      "ordinal": 114,
      "start_ms": 371099,
      "end_ms": 372869,
      "text": "但如果没有的话"
    },
    {
      "ordinal": 115,
      "start_ms": 372869,
      "end_ms": 379670,
      "text": "其他人以任何方式无限诽谤捏造事实啊"
    },
    {
      "ordinal": 116,
      "start_ms": 379670,
      "end_ms": 381500,
      "text": "指着让别人坐牢啊"
    },
    {
      "ordinal": 117,
      "start_ms": 381500,
      "end_ms": 382520,
      "text": "指着让别人"
    },
    {
      "ordinal": 118,
      "start_ms": 382520,
      "end_ms": 386940,
      "text": "这个是啊身败名裂去的这种人"
    },
    {
      "ordinal": 119,
      "start_ms": 386940,
      "end_ms": 393160,
      "text": "总有一天有法律由历史的公正啊去制裁他"
    },
    {
      "ordinal": 120,
      "start_ms": 394079,
      "end_ms": 397609,
      "text": "你不要以为你们的存在可以这样嘻嘻哈哈的"
    },
    {
      "ordinal": 121,
      "start_ms": 397609,
      "end_ms": 399529,
      "text": "你不要以为你们做的这些事情"
    },
    {
      "ordinal": 122,
      "start_ms": 399529,
      "end_ms": 401740,
      "text": "可以一点责任都不承担"
    },
    {
      "ordinal": 123,
      "start_ms": 402460,
      "end_ms": 408940,
      "text": "那法律整个世界的这个公益啊"
    },
    {
      "ordinal": 124,
      "start_ms": 409460,
      "end_ms": 412140,
      "text": "都会制裁你们的所作所为"
    },
    {
      "ordinal": 125,
      "start_ms": 412819,
      "end_ms": 415929,
      "text": "也是人早就知道你们是谁了啊"
    },
    {
      "ordinal": 126,
      "start_ms": 415929,
      "end_ms": 418040,
      "text": "不要以为我们不知道你是谁"
    },
    {
      "ordinal": 127,
      "start_ms": 418099,
      "end_ms": 420289,
      "text": "不仅仅我知道你是谁"
    },
    {
      "ordinal": 128,
      "start_ms": 420289,
      "end_ms": 422320,
      "text": "不仅仅我的团队知道你是谁"
    },
    {
      "ordinal": 129,
      "start_ms": 423360,
      "end_ms": 426230,
      "text": "一切被你的什么关闭评论间"
    },
    {
      "ordinal": 130,
      "start_ms": 426230,
      "end_ms": 427340,
      "text": "关闭弹幕"
    },
    {
      "ordinal": 131,
      "start_ms": 427340,
      "end_ms": 428360,
      "text": "挡在门外"
    },
    {
      "ordinal": 132,
      "start_ms": 428360,
      "end_ms": 431470,
      "text": "不能够知道你这个是要过来收割"
    },
    {
      "ordinal": 133,
      "start_ms": 431470,
      "end_ms": 434480,
      "text": "像恐怖分子恐恐怖事件发生之后"
    },
    {
      "ordinal": 134,
      "start_ms": 434780,
      "end_ms": 438980,
      "text": "要假模假样的为事件负责一样的收割"
    },
    {
      "ordinal": 135,
      "start_ms": 438980,
      "end_ms": 440120,
      "text": "发一个什么公告"
    },
    {
      "ordinal": 136,
      "start_ms": 440120,
      "end_ms": 440750,
      "text": "一封信"
    },
    {
      "ordinal": 137,
      "start_ms": 440750,
      "end_ms": 443860,
      "text": "收割鬼都知道你是谁"
    },
    {
      "ordinal": 138,
      "start_ms": 446020,
      "end_ms": 448220,
      "text": "你自己不敢承认你是谁"
    },
    {
      "ordinal": 139,
      "start_ms": 448680,
      "end_ms": 449760,
      "text": "你要举报"
    },
    {
      "ordinal": 140,
      "start_ms": 449760,
      "end_ms": 451980,
      "text": "你有本事公开实名举报"
    },
    {
      "ordinal": 141,
      "start_ms": 451980,
      "end_ms": 454200,
      "text": "我可以帮你转发"
    },
    {
      "ordinal": 142,
      "start_ms": 457120,
      "end_ms": 462310,
      "text": "弱者鼠辈啊"
    },
    {
      "ordinal": 143,
      "start_ms": 462310,
      "end_ms": 464980,
      "text": "这样的一种存在太可笑了"
    },
    {
      "ordinal": 144,
      "start_ms": 464980,
      "end_ms": 468620,
      "text": "这样一种存在太可耻了啊"
    },
    {
      "ordinal": 145,
      "start_ms": 468620,
      "end_ms": 470210,
      "text": "是在官员眼里"
    },
    {
      "ordinal": 146,
      "start_ms": 470210,
      "end_ms": 471710,
      "text": "在老百姓眼里"
    },
    {
      "ordinal": 147,
      "start_ms": 471710,
      "end_ms": 474920,
      "text": "我做的事情就是什么造反就是什么啊"
    },
    {
      "ordinal": 148,
      "start_ms": 474920,
      "end_ms": 478590,
      "text": "就是什么违法犯罪证据在哪里"
    },
    {
      "ordinal": 149,
      "start_ms": 478590,
      "end_ms": 482540,
      "text": "你你们这些人递交的这种举报材料里面"
    },
    {
      "ordinal": 150,
      "start_ms": 484820,
      "end_ms": 490180,
      "text": "说我指导什么线下地下秘密的什么反抗活动"
    },
    {
      "ordinal": 151,
      "start_ms": 490260,
      "end_ms": 492240,
      "text": "秘密的颠覆"
    },
    {
      "ordinal": 152,
      "start_ms": 492240,
      "end_ms": 493800,
      "text": "颠覆性的那种活动"
    },
    {
      "ordinal": 153,
      "start_ms": 493800,
      "end_ms": 495480,
      "text": "你们的证据在哪里"
    },
    {
      "ordinal": 154,
      "start_ms": 496819,
      "end_ms": 498280,
      "text": "捏造事实"
    },
    {
      "ordinal": 155,
      "start_ms": 501000,
      "end_ms": 503600,
      "text": "诬陷迫害啊"
    },
    {
      "ordinal": 156,
      "start_ms": 503600,
      "end_ms": 506240,
      "text": "想要却欺瞒啊"
    },
    {
      "ordinal": 157,
      "start_ms": 510460,
      "end_ms": 512760,
      "text": "召唤铁拳来捶死我"
    },
    {
      "ordinal": 158,
      "start_ms": 514700,
      "end_ms": 516190,
      "text": "太可悲了"
    },
    {
      "ordinal": 159,
      "start_ms": 516190,
      "end_ms": 518350,
      "text": "我就不说是谁"
    },
    {
      "ordinal": 160,
      "start_ms": 518350,
      "end_ms": 520240,
      "text": "你的名字我就不说出来"
    },
    {
      "ordinal": 161,
      "start_ms": 520240,
      "end_ms": 521620,
      "text": "天下人都知道"
    },
    {
      "ordinal": 162,
      "start_ms": 521620,
      "end_ms": 522520,
      "text": "我干嘛说出来"
    },
    {
      "ordinal": 163,
      "start_ms": 522520,
      "end_ms": 523859,
      "text": "你的名字是什么"
    },
    {
      "ordinal": 164,
      "start_ms": 524020,
      "end_ms": 526079,
      "text": "天下人都知道"
    },
    {
      "ordinal": 165,
      "start_ms": 526400,
      "end_ms": 528740,
      "text": "没有一个人不知道你是谁"
    },
    {
      "ordinal": 166,
      "start_ms": 528740,
      "end_ms": 530640,
      "text": "你们是哪几个人"
    },
    {
      "ordinal": 167,
      "start_ms": 534960,
      "end_ms": 536420,
      "text": "还要来那招吗"
    },
    {
      "ordinal": 168,
      "start_ms": 536420,
      "end_ms": 539180,
      "text": "还要逼着我把你名字说出来吗"
    },
    {
      "ordinal": 169,
      "start_ms": 539180,
      "end_ms": 540780,
      "text": "我钱多吗"
    },
    {
      "ordinal": 170,
      "start_ms": 542920,
      "end_ms": 544590,
      "text": "我金钱多吗"
    },
    {
      "ordinal": 171,
      "start_ms": 544590,
      "end_ms": 545700,
      "text": "我钱又不多"
    },
    {
      "ordinal": 172,
      "start_ms": 545700,
      "end_ms": 546960,
      "text": "我钱很少的"
    },
    {
      "ordinal": 173,
      "start_ms": 546960,
      "end_ms": 548380,
      "text": "我穷得不得了"
    },
    {
      "ordinal": 174,
      "start_ms": 551820,
      "end_ms": 553880,
      "text": "我不会把你名字说出来的"
    },
    {
      "ordinal": 175,
      "start_ms": 553880,
      "end_ms": 555560,
      "text": "我没有说任何人"
    },
    {
      "ordinal": 176,
      "start_ms": 555560,
      "end_ms": 556540,
      "text": "某个人"
    },
    {
      "ordinal": 177,
      "start_ms": 557300,
      "end_ms": 559540,
      "text": "我现在口袋一分钱都没有"
    },
    {
      "ordinal": 178,
      "start_ms": 559540,
      "end_ms": 560770,
      "text": "穷得要死"
    },
    {
      "ordinal": 179,
      "start_ms": 560770,
      "end_ms": 562199,
      "text": "穷得响叮当"
    },
    {
      "ordinal": 180,
      "start_ms": 563840,
      "end_ms": 566830,
      "text": "啊那我早就知道了"
    },
    {
      "ordinal": 181,
      "start_ms": 566830,
      "end_ms": 569860,
      "text": "我走上我这条路啊"
    },
    {
      "ordinal": 182,
      "start_ms": 569860,
      "end_ms": 571150,
      "text": "钱多钱少"
    },
    {
      "ordinal": 183,
      "start_ms": 571150,
      "end_ms": 573220,
      "text": "金钱多少"
    },
    {
      "ordinal": 184,
      "start_ms": 573220,
      "end_ms": 579020,
      "text": "这件事情就已经和我啊已经没有任何关系了啊"
    },
    {
      "ordinal": 185,
      "start_ms": 579020,
      "end_ms": 580400,
      "text": "已经没有任何关系了"
    },
    {
      "ordinal": 186,
      "start_ms": 580400,
      "end_ms": 583700,
      "text": "但是清清白白啊"
    },
    {
      "ordinal": 187,
      "start_ms": 583700,
      "end_ms": 585839,
      "text": "在这个世道中啊"
    },
    {
      "ordinal": 188,
      "start_ms": 585900,
      "end_ms": 588060,
      "text": "不被老百姓啊"
    },
    {
      "ordinal": 189,
      "start_ms": 588060,
      "end_ms": 589500,
      "text": "这个冤枉啊"
    },
    {
      "ordinal": 190,
      "start_ms": 589500,
      "end_ms": 592219,
      "text": "不被老百姓啊看错"
    },
    {
      "ordinal": 191,
      "start_ms": 592400,
      "end_ms": 594350,
      "text": "这是我要追求的"
    },
    {
      "ordinal": 192,
      "start_ms": 594350,
      "end_ms": 595700,
      "text": "世人始终要知道"
    },
    {
      "ordinal": 193,
      "start_ms": 595700,
      "end_ms": 599000,
      "text": "我不是一个通过违法犯罪的手段啊"
    },
    {
      "ordinal": 194,
      "start_ms": 599000,
      "end_ms": 600459,
      "text": "去做事情的人呢"
    },
    {
      "ordinal": 195,
      "start_ms": 601640,
      "end_ms": 604960,
      "text": "我们始终站的是一个大多数的啊"
    },
    {
      "ordinal": 196,
      "start_ms": 604960,
      "end_ms": 608080,
      "text": "一个人民群众所维护拥护的"
    },
    {
      "ordinal": 197,
      "start_ms": 608080,
      "end_ms": 613479,
      "text": "一个制度的正义性和一个方法的啊"
    },
    {
      "ordinal": 198,
      "start_ms": 615300,
      "end_ms": 621540,
      "text": "这个和平性安宁性合法和公开性"
    },
    {
      "ordinal": 199,
      "start_ms": 622740,
      "end_ms": 625260,
      "text": "你们玩这套把戏啊"
    },
    {
      "ordinal": 200,
      "start_ms": 625260,
      "end_ms": 628120,
      "text": "想要逼人上梁山"
    },
    {
      "ordinal": 201,
      "start_ms": 629140,
      "end_ms": 631060,
      "text": "想要栽赃陷害"
    },
    {
      "ordinal": 202,
      "start_ms": 631680,
      "end_ms": 633590,
      "text": "你们玩这套把戏"
    },
    {
      "ordinal": 203,
      "start_ms": 633590,
      "end_ms": 636020,
      "text": "想要把把人啊"
    },
    {
      "ordinal": 204,
      "start_ms": 636020,
      "end_ms": 640920,
      "text": "想要把我以及很多有志青年都逼到"
    },
    {
      "ordinal": 205,
      "start_ms": 640920,
      "end_ms": 644190,
      "text": "不得不反你们意欲何为"
    },
    {
      "ordinal": 206,
      "start_ms": 644190,
      "end_ms": 646459,
      "text": "想把我弄得直接去坐牢哦"
    },
    {
      "ordinal": 207,
      "start_ms": 646660,
      "end_ms": 651100,
      "text": "好像八那么多年轻人啊"
    },
    {
      "ordinal": 208,
      "start_ms": 651100,
      "end_ms": 655470,
      "text": "自发的啊献爱心啊"
    },
    {
      "ordinal": 209,
      "start_ms": 655470,
      "end_ms": 656970,
      "text": "学雷锋的好事"
    },
    {
      "ordinal": 210,
      "start_ms": 656970,
      "end_ms": 661319,
      "text": "诬陷城市地下密谋的激进叛乱"
    },
    {
      "ordinal": 211,
      "start_ms": 662360,
      "end_ms": 664560,
      "text": "你们的良心到哪里去了"
    },
    {
      "ordinal": 212,
      "start_ms": 665280,
      "end_ms": 667310,
      "text": "好你们的良心到哪里去了"
    },
    {
      "ordinal": 213,
      "start_ms": 667310,
      "end_ms": 668240,
      "text": "这不说良心啊"
    },
    {
      "ordinal": 214,
      "start_ms": 668240,
      "end_ms": 670439,
      "text": "你们做人的基本的底线"
    },
    {
      "ordinal": 215,
      "start_ms": 671100,
      "end_ms": 675100,
      "text": "基本的尊严到哪里去了哈"
    },
    {
      "ordinal": 216,
      "start_ms": 675100,
      "end_ms": 678100,
      "text": "你们关闭关闭个什么评论区"
    },
    {
      "ordinal": 217,
      "start_ms": 678100,
      "end_ms": 679120,
      "text": "关了个什么弹幕"
    },
    {
      "ordinal": 218,
      "start_ms": 679120,
      "end_ms": 681680,
      "text": "就能堵住天下人悠悠众口"
    },
    {
      "ordinal": 219,
      "start_ms": 683960,
      "end_ms": 685840,
      "text": "谁不知道是你们干的"
    },
    {
      "ordinal": 220,
      "start_ms": 687220,
      "end_ms": 688420,
      "text": "谁不知道"
    },
    {
      "ordinal": 221,
      "start_ms": 693360,
      "end_ms": 695660,
      "text": "可恶可笑至极"
    },
    {
      "ordinal": 222,
      "start_ms": 697380,
      "end_ms": 698990,
      "text": "看我们有保密协定"
    },
    {
      "ordinal": 223,
      "start_ms": 698990,
      "end_ms": 701960,
      "text": "我们不能够透露相关信息"
    },
    {
      "ordinal": 224,
      "start_ms": 701960,
      "end_ms": 702980,
      "text": "说是谁干的"
    },
    {
      "ordinal": 225,
      "start_ms": 702980,
      "end_ms": 703940,
      "text": "说是明确的"
    },
    {
      "ordinal": 226,
      "start_ms": 703940,
      "end_ms": 705140,
      "text": "是谁干啊"
    },
    {
      "ordinal": 227,
      "start_ms": 705140,
      "end_ms": 707540,
      "text": "我们有这个保密保密协议"
    },
    {
      "ordinal": 228,
      "start_ms": 711100,
      "end_ms": 713280,
      "text": "但是就算我不说"
    },
    {
      "ordinal": 229,
      "start_ms": 713280,
      "end_ms": 715380,
      "text": "天下人都知道是谁干的"
    },
    {
      "ordinal": 230,
      "start_ms": 715380,
      "end_ms": 717339,
      "text": "天下人都知道"
    },
    {
      "ordinal": 231,
      "start_ms": 722120,
      "end_ms": 724680,
      "text": "可笑可笑至极"
