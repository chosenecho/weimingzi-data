  "content_sha256": "ac20714d8c68d79d59d8df8a61c66838f8683d4319c1662643e8aeef0ddcc4b0",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 4280,
      "end_ms": 5840,
      "text": "或者说你要发展你的欲望"
    },
    {
      "ordinal": 1,
      "start_ms": 5840,
      "end_ms": 9480,
      "text": "在你的欲望当中重新尝到你的这个欲望的滋味"
    },
    {
      "ordinal": 2,
      "start_ms": 10180,
      "end_ms": 11310,
      "text": "欲望的滋味"
    },
    {
      "ordinal": 3,
      "start_ms": 11310,
      "end_ms": 14800,
      "text": "重新尝到那种魔怔的陷进去的滋味"
    },
    {
      "ordinal": 4,
      "start_ms": 16379,
      "end_ms": 19790,
      "text": "然后你要或者当你有爱情的时候"
    },
    {
      "ordinal": 5,
      "start_ms": 22840,
      "end_ms": 23920,
      "text": "支配你的爱情"
    },
    {
      "ordinal": 6,
      "start_ms": 25360,
      "end_ms": 26860,
      "text": "是对于那个人的兴趣"
    },
    {
      "ordinal": 7,
      "start_ms": 26860,
      "end_ms": 28810,
      "text": "对于他的好奇啊"
    },
    {
      "ordinal": 8,
      "start_ms": 28810,
      "end_ms": 30310,
      "text": "或者说对他的仰慕啊"
    },
    {
      "ordinal": 9,
      "start_ms": 30310,
      "end_ms": 33390,
      "text": "或者说对于他的那种认同认可"
    },
    {
      "ordinal": 10,
      "start_ms": 33390,
      "end_ms": 34830,
      "text": "觉得这个人很有趣"
    },
    {
      "ordinal": 11,
      "start_ms": 34830,
      "end_ms": 35850,
      "text": "好有意思"
    },
    {
      "ordinal": 12,
      "start_ms": 35850,
      "end_ms": 37950,
      "text": "我希望支配你的爱情是这个东西"
    },
    {
      "ordinal": 13,
      "start_ms": 37950,
      "end_ms": 39450,
      "text": "而不是而不是下面这个东西"
    },
    {
      "ordinal": 14,
      "start_ms": 39450,
      "end_ms": 40470,
      "text": "当然这个东西可以有"
    },
    {
      "ordinal": 15,
      "start_ms": 40470,
      "end_ms": 41919,
      "text": "但是他是副产品"
    },
    {
      "ordinal": 16,
      "start_ms": 42280,
      "end_ms": 43960,
      "text": "它的副产品明白吗"
    },
    {
      "ordinal": 17,
      "start_ms": 45580,
      "end_ms": 46500,
      "text": "you understand"
    },
    {
      "ordinal": 18,
      "start_ms": 46920,
      "end_ms": 47970,
      "text": "同样的"
    },
    {
      "ordinal": 19,
      "start_ms": 47970,
      "end_ms": 48660,
      "text": "同样的"
    },
    {
      "ordinal": 20,
      "start_ms": 48660,
      "end_ms": 50700,
      "text": "你如果有友情也是一样的"
    },
    {
      "ordinal": 21,
      "start_ms": 50700,
      "end_ms": 55779,
      "text": "希望不是你们都认同你们是那种男权享乐者"
    },
    {
      "ordinal": 22,
      "start_ms": 55780,
      "end_ms": 58390,
      "text": "都自视是男权主义的享乐者"
    },
    {
      "ordinal": 23,
      "start_ms": 58390,
      "end_ms": 61180,
      "text": "然后你们就有那种共同去啊"
    },
    {
      "ordinal": 24,
      "start_ms": 61180,
      "end_ms": 62710,
      "text": "三大铁人称三大铁"
    },
    {
      "ordinal": 25,
      "start_ms": 63820,
      "end_ms": 65230,
      "text": "然后有所谓的这种友情"
    },
    {
      "ordinal": 26,
      "start_ms": 65230,
      "end_ms": 66790,
      "text": "我希望你们友情不是这种东西"
    },
    {
      "ordinal": 27,
      "start_ms": 66790,
      "end_ms": 69229,
      "text": "我希望的友情也是建立于兴趣"
    },
    {
      "ordinal": 28,
      "start_ms": 69229,
      "end_ms": 70940,
      "text": "你们有同样的兴趣"
    },
    {
      "ordinal": 29,
      "start_ms": 71480,
      "end_ms": 72260,
      "text": "明白吗"
    },
    {
      "ordinal": 30,
      "start_ms": 72260,
      "end_ms": 73220,
      "text": "你们有同样的兴趣"
    },
    {
      "ordinal": 31,
      "start_ms": 73220,
      "end_ms": 77570,
      "text": "或者说你们都都受到同样一种欲望的折磨"
    },
    {
      "ordinal": 32,
      "start_ms": 77570,
      "end_ms": 81740,
      "text": "也受到这种兴趣当中的某种欲望的一个激励"
    },
    {
      "ordinal": 33,
      "start_ms": 82020,
      "end_ms": 83700,
      "text": "受到这样一种欲望的激励"
    },
    {
      "ordinal": 34,
      "start_ms": 83700,
      "end_ms": 85360,
      "text": "我希望你们有这样的欲望"
    },
    {
      "ordinal": 35,
      "start_ms": 93770,
      "end_ms": 95510,
      "text": "一天到晚在那边取笑女的"
    },
    {
      "ordinal": 36,
      "start_ms": 98030,
      "end_ms": 100840,
      "text": "或者说只能是这样的一群货色"
    },
    {
      "ordinal": 37,
      "start_ms": 101240,
      "end_ms": 102740,
      "text": "远离他们"
    },
    {
      "ordinal": 38,
      "start_ms": 104620,
      "end_ms": 106740,
      "text": "然后你自己要有一个兴趣"
    },
    {
      "ordinal": 39,
      "start_ms": 106740,
      "end_ms": 107340,
      "text": "要有一个兴趣"
    },
    {
      "ordinal": 40,
      "start_ms": 107340,
      "end_ms": 109380,
      "text": "这个兴趣哲学政治"
    },
    {
      "ordinal": 41,
      "start_ms": 109380,
      "end_ms": 110100,
      "text": "经济学"
    },
    {
      "ordinal": 42,
      "start_ms": 110100,
      "end_ms": 112200,
      "text": "军事历史"
    },
    {
      "ordinal": 43,
      "start_ms": 112200,
      "end_ms": 113100,
      "text": "whatever"
    },
    {
      "ordinal": 44,
      "start_ms": 113100,
      "end_ms": 115190,
      "text": "它能够引发你的欲望"
    },
    {
      "ordinal": 45,
      "start_ms": 115190,
      "end_ms": 118490,
      "text": "这个欲望一定要也要导向现实"
    },
    {
      "ordinal": 46,
      "start_ms": 118490,
      "end_ms": 119510,
      "text": "由于它是个欲望"
    },
    {
      "ordinal": 47,
      "start_ms": 119510,
      "end_ms": 124520,
      "text": "所以他一定会只要看到你的那些抽离的这些兴趣当中"
    },
    {
      "ordinal": 48,
      "start_ms": 124520,
      "end_ms": 127700,
      "text": "你的抽离到从现实生活抽离的这个兴趣"
    },
    {
      "ordinal": 49,
      "start_ms": 127700,
      "end_ms": 130729,
      "text": "归根结底它是要指向一个现实"
    },
    {
      "ordinal": 50,
      "start_ms": 130729,
      "end_ms": 133790,
      "text": "这个现实就是你要突破突破啊"
    },
    {
      "ordinal": 51,
      "start_ms": 133790,
      "end_ms": 134630,
      "text": "种种枷锁"
    },
    {
      "ordinal": 52,
      "start_ms": 134630,
      "end_ms": 135470,
      "text": "现实的突破"
    },
    {
      "ordinal": 53,
      "start_ms": 135470,
      "end_ms": 136340,
      "text": "种种枷锁"
    },
    {
      "ordinal": 54,
      "start_ms": 136340,
      "end_ms": 139649,
      "text": "现实突破前的枷锁啊"
    },
    {
      "ordinal": 55,
      "start_ms": 139649,
      "end_ms": 141329,
      "text": "你的权利的枷锁"
    },
    {
      "ordinal": 56,
      "start_ms": 141329,
      "end_ms": 142859,
      "text": "家庭身份啊"
    },
    {
      "ordinal": 57,
      "start_ms": 142859,
      "end_ms": 145559,
      "text": "家庭这种父母对你的控制啊"
    },
    {
      "ordinal": 58,
      "start_ms": 146939,
      "end_ms": 148640,
      "text": "这些枷锁你能突破它"
    },
    {
      "ordinal": 59,
      "start_ms": 149119,
      "end_ms": 155479,
      "text": "把你在你那种兴趣当中的那种那种欲望能够引到现实当中的一部分"
    },
    {
      "ordinal": 60,
      "start_ms": 155479,
      "end_ms": 159920,
      "text": "学历史觉得什么什么什么"
    },
    {
      "ordinal": 61,
      "start_ms": 161800,
      "end_ms": 166890,
      "text": "我觉得那种什么王猛这种人就都都在品评他"
    },
    {
      "ordinal": 62,
      "start_ms": 166890,
      "end_ms": 169580,
      "text": "但是你在现实当中就像那个渤海小吏"
    },
    {
      "ordinal": 63,
      "start_ms": 169619,
      "end_ms": 172559,
      "text": "那把他写的文章里面品评这个英雄"
    },
    {
      "ordinal": 64,
      "start_ms": 172559,
      "end_ms": 175469,
      "text": "点评那个那个那个名臣大将"
    },
    {
      "ordinal": 65,
      "start_ms": 175469,
      "end_ms": 179430,
      "text": "现实当中就是一个奔走小吏而已"
    },
    {
      "ordinal": 66,
      "start_ms": 179430,
      "end_ms": 180540,
      "text": "令人不齿"
    },
    {
      "ordinal": 67,
      "start_ms": 180540,
      "end_ms": 181420,
      "text": "你知道吧"
    },
    {
      "ordinal": 68,
      "start_ms": 181579,
      "end_ms": 183919,
      "text": "就你不要你你的那个历史"
    },
    {
      "ordinal": 69,
      "start_ms": 183919,
      "end_ms": 187730,
      "text": "你对于某个抽抽象位面的那个兴趣啊"
    },
    {
      "ordinal": 70,
      "start_ms": 187730,
      "end_ms": 190250,
      "text": "你要把它作为欲望坚持到底"
    },
    {
      "ordinal": 71,
      "start_ms": 190250,
      "end_ms": 193350,
      "text": "坚持到底就意味着在现实当中要突破枷锁"
    },
    {
      "ordinal": 72,
      "start_ms": 193350,
      "end_ms": 194400,
      "text": "突破枷锁"
    },
    {
      "ordinal": 73,
      "start_ms": 194400,
      "end_ms": 195930,
      "text": "就比如说你有历史兴趣"
    },
    {
      "ordinal": 74,
      "start_ms": 195930,
      "end_ms": 199200,
      "text": "那你就永远你就你就做个在野的"
    },
    {
      "ordinal": 75,
      "start_ms": 199220,
      "end_ms": 201740,
      "text": "就偏不为偏"
    },
    {
      "ordinal": 76,
      "start_ms": 201740,
      "end_ms": 203160,
      "text": "不为五斗米折腰"
    },
    {
      "ordinal": 77,
      "start_ms": 204100,
      "end_ms": 205560,
      "text": "又不是做到啊"
    },
    {
      "ordinal": 78,
      "start_ms": 205560,
      "end_ms": 206160,
      "text": "就这么简单"
    },
    {
      "ordinal": 79,
      "start_ms": 206160,
      "end_ms": 207090,
      "text": "就这个东西呢"
    },
    {
      "ordinal": 80,
      "start_ms": 207090,
      "end_ms": 207690,
      "text": "你要"
    },
    {
      "ordinal": 81,
      "start_ms": 207690,
      "end_ms": 209580,
      "text": "就是一旦它成为欲望"
    },
    {
      "ordinal": 82,
      "start_ms": 209580,
      "end_ms": 211650,
      "text": "他就会倒影像行动"
    },
    {
      "ordinal": 83,
      "start_ms": 211650,
      "end_ms": 213140,
      "text": "他就会影响行动"
    },
    {
      "ordinal": 84,
      "start_ms": 213999,
      "end_ms": 216299,
      "text": "他成为真正的一个循环起来的欲望"
    },
    {
      "ordinal": 85,
      "start_ms": 216299,
      "end_ms": 217620,
      "text": "才会影响行动"
    },
    {
      "ordinal": 86,
      "start_ms": 218300,
      "end_ms": 222310,
      "text": "它会让你有一个视角去看到真正的现实啊"
    },
    {
      "ordinal": 87,
      "start_ms": 222310,
      "end_ms": 225970,
      "text": "所以我觉得这些这个像博爱小丽这种什么"
    },
    {
      "ordinal": 88,
      "start_ms": 225970,
      "end_ms": 228580,
      "text": "他有一种所谓的历史性兴趣"
    },
    {
      "ordinal": 89,
      "start_ms": 228580,
      "end_ms": 231220,
      "text": "他其实他并没有历史的欲望"
    },
    {
      "ordinal": 90,
      "start_ms": 231619,
      "end_ms": 234760,
      "text": "这些人缺乏历史的欲望啊"
    },
    {
      "ordinal": 91,
      "start_ms": 234760,
      "end_ms": 237280,
      "text": "他缺乏把自己的生命历史化的欲望"
    },
    {
      "ordinal": 92,
      "start_ms": 237280,
      "end_ms": 239140,
      "text": "他只是在旁观历史"
    },
    {
      "ordinal": 93,
      "start_ms": 239140,
      "end_ms": 241000,
      "text": "所以他真的并不爱历史"
    },
    {
      "ordinal": 94,
      "start_ms": 241000,
      "end_ms": 242460,
      "text": "他也不爱他的生命"
    },
    {
      "ordinal": 95,
      "start_ms": 243520,
      "end_ms": 245520,
      "text": "我觉得这家伙只是爱钱而已"
    },
    {
      "ordinal": 96,
      "start_ms": 245520,
      "end_ms": 247200,
      "text": "或者想要有点出名啊"
    },
    {
      "ordinal": 97,
      "start_ms": 247200,
      "end_ms": 249260,
      "text": "或者说他生存焦虑啊"
    },
    {
      "ordinal": 98,
      "start_ms": 249260,
      "end_ms": 251210,
      "text": "它并没有一个历史化的欲望"
    },
    {
      "ordinal": 99,
      "start_ms": 251210,
      "end_ms": 251420,
      "text": "这"
    },
    {
      "ordinal": 100,
      "start_ms": 251420,
      "end_ms": 252800,
      "text": "个欲望是很稀缺的"
    },
    {
      "ordinal": 101,
      "start_ms": 252800,
      "end_ms": 254580,
      "text": "这个欲望是非常稀缺的"
    },
    {
      "ordinal": 102,
      "start_ms": 255339,
      "end_ms": 257039,
      "text": "一方面这个欲望是稀缺"
    },
    {
      "ordinal": 103,
      "start_ms": 257039,
      "end_ms": 262220,
      "text": "另外一方面就是说把能够把这个欲望加以克制"
    },
    {
      "ordinal": 104,
      "start_ms": 262700,
      "end_ms": 268060,
      "text": "服从于更伟大的理想的这种克制是更稀缺的"
    },
    {
      "ordinal": 105,
      "start_ms": 268180,
      "end_ms": 272200,
      "text": "能够克制自己要将生命历史化的那个欲望"
    },
    {
      "ordinal": 106,
      "start_ms": 272200,
      "end_ms": 275560,
      "text": "然后而去追求某个现实的理想"
    },
    {
      "ordinal": 107,
      "start_ms": 275560,
      "end_ms": 277220,
      "text": "现实的共同体的理想"
    },
    {
      "ordinal": 108,
      "start_ms": 277740,
      "end_ms": 280430,
      "text": "这个是更稀缺更稀缺"
    },
    {
      "ordinal": 109,
      "start_ms": 280430,
      "end_ms": 283860,
      "text": "那么有这个东西就是二流人物"
    },
    {
      "ordinal": 110,
      "start_ms": 285540,
      "end_ms": 287150,
      "text": "有下面这个东西"
    },
    {
      "ordinal": 111,
      "start_ms": 287150,
      "end_ms": 289340,
      "text": "就是你就是一流人物"
    },
    {
      "ordinal": 112,
      "start_ms": 291579,
      "end_ms": 294120,
      "text": "没有这个东西就是三流人物"
    },
    {
      "ordinal": 113,
      "start_ms": 294360,
      "end_ms": 295260,
      "text": "没有这个东西"
    },
    {
      "ordinal": 114,
      "start_ms": 295260,
      "end_ms": 296340,
      "text": "就三流人物"
    },
    {
      "ordinal": 115,
      "start_ms": 296340,
      "end_ms": 297420,
      "text": "如果我们要讲的话"
    },
    {
      "ordinal": 116,
      "start_ms": 297420,
      "end_ms": 298669,
      "text": "基本上是这样"
    },
    {
      "ordinal": 117,
      "start_ms": 298669,
      "end_ms": 300409,
      "text": "就是就是一流人物"
    },
    {
      "ordinal": 118,
      "start_ms": 300409,
      "end_ms": 300889,
      "text": "二流人物"
    },
    {
      "ordinal": 119,
      "start_ms": 300889,
      "end_ms": 301369,
      "text": "三流人物"
    },
    {
      "ordinal": 120,
      "start_ms": 301369,
      "end_ms": 310340,
      "text": "我我基本上是围绕着他面对历史的那个欲望的姿态来来做划分的"
    },
    {
      "ordinal": 121,
      "start_ms": 310580,
      "end_ms": 312020,
      "text": "你们那根本没有这个欲望"
    },
    {
      "ordinal": 122,
      "start_ms": 316340,
      "end_ms": 317820,
      "text": "完了弄点小名气而已"
    },
    {
      "ordinal": 123,
      "start_ms": 317820,
      "end_ms": 319050,
      "text": "他有这个欲望"
    },
    {
      "ordinal": 124,
      "start_ms": 319050,
      "end_ms": 320340,
      "text": "这个欲望很强烈"
    },
    {
      "ordinal": 125,
      "start_ms": 320340,
      "end_ms": 321570,
      "text": "并且不停的去做"
    },
    {
      "ordinal": 126,
      "start_ms": 321570,
      "end_ms": 322920,
      "text": "那他是个二流人物"
    },
    {
      "ordinal": 127,
      "start_ms": 322920,
      "end_ms": 323820,
      "text": "他有这个欲望"
    },
    {
      "ordinal": 128,
      "start_ms": 323820,
      "end_ms": 325300,
      "text": "他还克制这个欲望"
    },
    {
      "ordinal": 129,
      "start_ms": 325580,
      "end_ms": 327200,
      "text": "他还克制这个欲望"
    },
    {
      "ordinal": 130,
      "start_ms": 327200,
      "end_ms": 329480,
      "text": "那他是一流人物啊"
    },
    {
      "ordinal": 131,
      "start_ms": 329480,
      "end_ms": 330080,
      "text": "一流人物"
