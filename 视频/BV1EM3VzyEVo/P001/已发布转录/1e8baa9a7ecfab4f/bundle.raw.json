,"text":"他们有交交易的价值"},{"start":291.1,"end":293.48,"text":"但是玩脱了他"},{"start":293.48,"end":295.56,"text":"他没有交易价值"},{"start":295.56,"end":296.48,"text":"他换不了那些东西"},{"start":296.48,"end":300.81,"text":"或者说他换出来这些交易价值是有价无市啊"},{"start":300.81,"end":303.51,"text":"他也换不了他的生存利益"},{"start":304.719,"end":306.839,"text":"所以他就算有教育端"},{"start":306.839,"end":307.959,"text":"它没有市场端"},{"start":307.959,"end":308.939,"text":"没有交易端"},{"start":308.939,"end":312.069,"text":"他的纪律是不彻底的"},{"start":312.069,"end":313.989,"text":"它不能循环起来的"},{"start":315.229,"end":316.549,"text":"这个是比较典型的"},{"start":316.549,"end":319.06,"text":"就是说噔噔噔噔噔噔"},{"start":319.06,"end":320.54,"text":"这是个知识分子群体"},{"start":320.54,"end":323.1,"text":"是个教育教育关系扭结起来的群体"},{"start":323.1,"end":325.18,"text":"还有这个嗯"},{"start":326.96,"end":328.44,"text":"什么什么什么主权"},{"start":328.44,"end":330.68,"text":"还有包括这个球呃"},{"start":330.68,"end":333.66,"text":"这个仇士系的这帮啊"},{"start":333.66,"end":337.92,"text":"这这主要他们成员都是中高级知识分子"},{"start":338.65,"end":340.61,"text":"和一些就学生"},{"start":342.25,"end":347.65,"text":"大学学生就是我们要清醒地意识到"},{"start":347.65,"end":352.08,"text":"反抗需要在形式上模仿统治"},{"start":352.08,"end":358.55,"text":"统治是通过自由和认同自由和服从啊"},{"start":358.55,"end":366.17,"text":"或者说自由和这个啊人格persona就是个面具"},{"start":366.17,"end":368.49,"text":"伪装啊"},{"start":368.49,"end":371.47,"text":"活动空间和伪装交易空间"},{"start":371.47,"end":376.43,"text":"交易机会和伪装和特定的伪装来促成的"},{"start":376.43,"end":381.41,"text":"对他的服从统治是经由市场和学校来促成"},{"start":381.41,"end":383.36,"text":"促成服服从的"},{"start":383.36,"end":387.44,"text":"那你知道不能比你的敌人差"},{"start":388.2,"end":390.2,"text":"你也必须要有交易规则"},{"start":390.2,"end":390.88,"text":"交易空间"},{"start":391.88,"end":396.37,"text":"你也必须要有你的教育啊"},{"start":396.37,"end":399.21,"text":"你必须要有你的学校"},{"start":400.37,"end":404.79,"text":"必须要有你的这种身份认同面子"},{"start":404.79,"end":407.85,"text":"personal翻译成面子比较好"},{"start":408.99,"end":409.55,"text":"所以"},{"start":411.95,"end":413.89,"text":"这是破局的某种影响是关键"},{"start":413.89,"end":415.71,"text":"但是"},{"start":416.59,"end":423.34,"text":"其实就是当时那孙权在那工人大学啥的啊"},{"start":423.34,"end":424.66,"text":"没有起到这个作用"},{"start":424.66,"end":428.79,"text":"他这个东西是没有办法实现交易的"},{"start":428.79,"end":430.59,"text":"没办法循环起来啊"},{"start":430.59,"end":432.49,"text":"没有那个功能的"},{"start":432.49,"end":434.73,"text":"但他他就所在那个时代的话"},{"start":434.73,"end":437.82,"text":"其实也没有这个交易市场的存在"},{"start":439.8,"end":440.96,"text":"反正我就讲这么多"},{"start":443.4,"end":446.0,"text":"我觉得我讲的已经够多了"},{"start":447.46,"end":449.26,"text":"我也困倦"},{"start":450.23,"end":451.71,"text":"但是休息完了之后"},{"start":451.71,"end":454.91,"text":"我还是得去重新恢复起来"},{"start":454.91,"end":456.69,"text":"振作振作起来啊"},{"start":456.69,"end":458.71,"text":"去思考这些东西"},{"start":459.31,"end":459.83,"text":"好吧"},{"start":460.83,"end":463.1,"text":"这个"},{"start":465.48,"end":466.4,"text":"意识形态"},{"start":467.56,"end":470.909,"text":"但是意识形态也很重要啊"},{"start":470.909,"end":472.169,"text":"意识形态也很重要"},{"start":472.169,"end":475.929,"text":"意识形态是短平快的东西啊"},{"start":475.929,"end":478.32,"text":"意识形态是呃"},{"start":478.32,"end":480.25,"text":"稍微有点"},{"start":480.25,"end":482.65,"text":"我本来认为纪律是硬的东西"},{"start":482.65,"end":484.05,"text":"意识形态是软的东西"},{"start":484.05,"end":486.05,"text":"现在我感觉是反过来的"},{"start":486.05,"end":488.5,"text":"意识形态是锋锐的东西"},{"start":488.5,"end":489.98,"text":"是要站队的"},{"start":489.98,"end":494.02,"text":"而纪律呢啊普遍来讲都有纪律"},{"start":494.02,"end":496.82,"text":"现在现在还存在这种战队"},{"start":496.82,"end":497.54,"text":"不是战队"},{"start":497.54,"end":498.54,"text":"现在存在的战队"},{"start":498.54,"end":501.7,"text":"是有纪律和无纪纪律者之中的一个选择"},{"start":501.7,"end":502.64,"text":"但这不是战队"},{"start":502.64,"end":503.88,"text":"聪明人都会选择有纪律"},{"start":503.88,"end":506.47,"text":"无纪律就或者是懦夫啊"},{"start":506.47,"end":507.19,"text":"这不是选择"},{"start":507.19,"end":508.68,"text":"是逃避选择"},{"start":508.68,"end":511.58,"text":"无纪律的那部分人并不是在选择"},{"start":511.58,"end":512.659,"text":"而是在逃避"},{"start":512.659,"end":513.88,"text":"并不是在站队"},{"start":513.88,"end":515.88,"text":"而是在叛离"},{"start":517.2,"end":519.52,"text":"所以都谈不上是战队问题"},{"start":519.52,"end":522.12,"text":"而意识形态则是锋锐的"},{"start":523.52,"end":525.63,"text":"是致命的"},{"start":526.29,"end":529.79,"text":"是有实质的冲突性的"},{"start":529.79,"end":530.89,"text":"平等的"},{"start":530.89,"end":533.99,"text":"同等的纪律水准的啊"},{"start":533.99,"end":534.95,"text":"互相排斥"},{"start":534.95,"end":538.37,"text":"团体的竞争关系"},{"start":541.05,"end":542.17,"text":"有你没我"},{"start":542.17,"end":544.45,"text":"所以意识形态是非常残酷的"},{"start":544.45,"end":547.54,"text":"其实我误判了"},{"start":547.54,"end":549.48,"text":"我在一段时间内"},{"start":549.48,"end":554.89,"text":"可能在差不多六个月左右的时间里面"},{"start":554.89,"end":558.87,"text":"把这两者那个关系搞混了"},{"start":558.87,"end":561.44,"text":"哪个硬哪个软没有弄特别清楚"},{"start":561.44,"end":564.12,"text":"但是所以我们讲的就是说"},{"start":564.12,"end":567.02,"text":"那你对于不是纪律性团体的"},{"start":567.02,"end":568.18,"text":"他的意识形态问题"},{"start":568.18,"end":570.15,"text":"那是那是胡闹"},{"start":570.51,"end":571.23,"text":"那是胡闹"},{"start":571.23,"end":573.27,"text":"所以我的基本分类他还是正确的"},{"start":573.27,"end":576.589,"text":"我把团体分为意识形态团体和纪律团体"},{"start":576.589,"end":578.009,"text":"软的和硬的"},{"start":578.009,"end":579.989,"text":"那么这些意识形态团体"},{"start":579.989,"end":584.65,"text":"他实际上不具有一个有纪律支撑的意识形态"},{"start":584.65,"end":586.49,"text":"不具有实质的意识形态"},{"start":586.49,"end":588.61,"text":"他的意识形态是假意识形态"},{"start":588.61,"end":593.33,"text":"弱小是不成机器的意识形态啊"},{"start":593.33,"end":598.32,"text":"他他其实说的就把其实是"},{"start":599.64,"end":600.88,"text":"他意识代征召"},{"start":600.88,"end":605.87,"text":"没有把人就是真正的就是神圣化啊"},{"start":605.87,"end":608.24,"text":"他没做到这一点"},{"start":609.74,"end":612.34,"text":"就是他们还是虚的"},{"start":612.34,"end":614.54,"text":"还是假的玩的"},{"start":615.75,"end":619.67,"text":"嗯所以就是我们会对于这些群体"},{"start":619.67,"end":622.28,"text":"重新做一个分类和考量"},{"start":622.28,"end":626.839,"text":"然后分类的标准大体不会有太大差别"},{"start":626.839,"end":631.039,"text":"但是我要赤夺掉他们的意识形态的锋锐性"},{"start":631.039,"end":633.13,"text":"他们的意识形态没有锋锐性"},{"start":633.13,"end":635.01,"text":"他的意识形态是无根之木"},{"start":635.01,"end":635.77,"text":"无源之水"},{"start":635.77,"end":637.57,"text":"然后所以在这一上讲"},{"start":637.57,"end":638.97,"text":"单游那种意识形态的话"},{"start":638.97,"end":641.75,"text":"是没有办法生产出纪律来的"},{"start":641.75,"end":642.87,"text":"或者反过来讲"},{"start":642.87,"end":646.27,"text":"就只有纪律可以生产意识形态"},{"start":646.27,"end":648.33,"text":"意识形态无法生产纪律"},{"start":648.33,"end":652.11,"text":"而由纪律作为基本来生产出来的"},{"start":652.11,"end":655.069,"text":"意识形态是非常坚硬的东西"},{"start":655.069,"end":657.229,"text":"是非常非常坚硬的东西"},{"start":658.709,"end":660.469,"text":"是你死我活的东西"},{"start":660.469,"end":662.82,"text":"什么啊"},{"start":662.82,"end":665.34,"text":"是生死攸关的东西"},{"start":666.36,"end":667.9,"text":"好吧"},{"start":667.9,"end":673.4,"text":"那这里我们这些今天的这两个视频还是主导的"},{"start":673.4,"end":675.05,"text":"是讨论纪律问题"},{"start":675.05,"end":676.49,"text":"讨论意识形态啊"},{"start":676.49,"end":677.79,"text":"讨论意识问题"},{"start":677.79,"end":680.72,"text":"没有讨论权利问题啊"},{"start":680.72,"end":684.71,"text":"这这一讲讲在在这个基本的理论框架"},{"start":684.71,"end":686.05,"text":"在意识形态和纪律的"},{"start":686.05,"end":689.07,"text":"在生活纪律和组织纪律的这个理论框架之下呢"},{"start":690.19,"end":690.54,"text":"啊"},{"start":694.0,"end":699.86,"text":"权力的不对称的两侧是平等的"},{"start":699.86,"end":702.68,"text":"但这个东西里面他有这个铁印的逻辑"},{"start":702.68,"end":705.17,"text":"束缚着权利啊"},{"start":705.17,"end":708.43,"text":"或者说权力的拥有者只是工具"},{"start":708.43,"end":712.28,"text":"只是这整个运动过程的工具嗯"},{"start":712.28,"end":713.78,"text":"我们要清晰地意识到这一点"},{"start":713.78,"end":721.94,"text":"所以不不摆脱关于权力的迷狂和妄想"},{"start":721.94,"end":726.04,"text":"是没有办法进一步进展到看到呃"},{"start":726.04,"end":728.249,"text":"历史进展的团队"},{"start":728.249,"end":731.79,"text":"发展中间的核心关键要素的"},{"start":731.99,"end":735.17,"text":"要不停不停地克服压制"},{"start":735.17,"end":736.47,"text":"消解阳气"},{"start":736.47,"end":738.38,"text":"自己的权力欲"},{"start":738.38,"end":744.54,"text":"以及是意识到权力本身的奴役压迫性啊"},{"start":744.54,"end":749.18,"text":"拥有权力的人实际上是最大的奴隶啊"},{"start":749.18,"end":749.9,"text":"我是奴隶"},{"start":749.9,"end":752.66,"text":"投资不代表我是奴隶的主人"},{"start":