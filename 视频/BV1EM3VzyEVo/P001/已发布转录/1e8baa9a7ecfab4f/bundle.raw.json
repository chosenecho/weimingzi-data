{"segments":[{"start":0.0,"end":7.109,"text":"我非正式的讲一些其实非常具有什价值的"},{"start":7.109,"end":9.969,"text":"但这个东西只有我同行可以听啊"},{"start":9.969,"end":13.65,"text":"就是嗯在这个时代"},{"start":13.65,"end":19.29,"text":"意识形态已经没有办法支撑剥夺性的权利了"},{"start":19.29,"end":21.65,"text":"剥夺性的惩罚性的权利"},{"start":21.65,"end":24.29,"text":"所以你既然意识形态没有"},{"start":24.29,"end":27.51,"text":"或者说乌托邦嗯"},{"start":27.51,"end":30.05,"text":"OLIVER这种"},{"start":31.96,"end":35.64,"text":"把主体议政化地去征召质询的"},{"start":35.64,"end":37.71,"text":"这种意识形态机器"},{"start":37.71,"end":41.55,"text":"他没有办法在这个享乐时代"},{"start":41.55,"end":42.55,"text":"享乐时代啊"},{"start":42.55,"end":46.31,"text":"享乐主义时代支撑一种剥夺性的"},{"start":46.31,"end":48.69,"text":"否定性的啊"},{"start":48.69,"end":50.77,"text":"恐吓性的权利"},{"start":50.77,"end":53.16,"text":"这个威能是支撑不了的"},{"start":53.16,"end":54.18,"text":"这个时代啊"},{"start":54.18,"end":57.22,"text":"就是那就是儿子不认父亲嘛"},{"start":57.22,"end":57.88,"text":"简单来讲"},{"start":57.88,"end":61.49,"text":"这样就是子女不认这个这种"},{"start":64.849,"end":67.5,"text":"父权式的威能"},{"start":68.88,"end":75.75,"text":"所以没有办法再去通过意识形态来生产纪律"},{"start":75.75,"end":80.74,"text":"那么纪律是通过通过什么方式生产出来的"},{"start":83.04,"end":85.36,"text":"即使是通过"},{"start":91.92,"end":93.42,"text":"两个东西"},{"start":93.42,"end":95.44,"text":"现代人类的纪律"},{"start":96.44,"end":99.33,"text":"我指的是是呃"},{"start":99.33,"end":102.76,"text":"经过了那个意识形态时代的"},{"start":102.76,"end":105.66,"text":"这个二十二十世纪的后半叶的纪律"},{"start":105.66,"end":107.02,"text":"它的发生学"},{"start":107.02,"end":111.2,"text":"是通过现代国家的两个两大社会性建制"},{"start":111.2,"end":116.15,"text":"市场和学校来生产的"},{"start":119.4,"end":124.68,"text":"市场保证的自由学校塑造的人格"},{"start":132.14,"end":133.9,"text":"塑造了活动的轨道"},{"start":135.02,"end":137.68,"text":"在这些轨道网络当中嗯"},{"start":137.68,"end":141.53,"text":"仍按照特定的纪律啊"},{"start":141.53,"end":144.98,"text":"相对自由的在这轨道中滑动啊"},{"start":144.98,"end":145.88,"text":"做交易"},{"start":145.88,"end":149.34,"text":"那是现代人类的一个主要模式"},{"start":149.34,"end":151.46,"text":"主要生存模式"},{"start":153.64,"end":157.61,"text":"所以要生产纪律就要生产