  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "79da54484ee5de30933702b0e6e7a8928424cbd19500614b801bf6c16d4208b0",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 380,
      "end_ms": 4040,
      "text": "我们有明确可靠的消息源啊"
    },
    {
      "ordinal": 1,
      "start_ms": 4040,
      "end_ms": 8700,
      "text": "向我们透露某人的国籍啊"
    },
    {
      "ordinal": 2,
      "start_ms": 8700,
      "end_ms": 12500,
      "text": "首先某人的护照是持有的是中国护照"
    },
    {
      "ordinal": 3,
      "start_ms": 12500,
      "end_ms": 15030,
      "text": "其次按照国际法的规定"
    },
    {
      "ordinal": 4,
      "start_ms": 15030,
      "end_ms": 16280,
      "text": "你必须入籍"
    },
    {
      "ordinal": 5,
      "start_ms": 16280,
      "end_ms": 19560,
      "text": "你才能领申请领取中国护照"
    },
    {
      "ordinal": 6,
      "start_ms": 19560,
      "end_ms": 20800,
      "text": "所以他的国籍"
    },
    {
      "ordinal": 7,
      "start_ms": 20800,
      "end_ms": 22680,
      "text": "而且中国不承认双重国籍"
    },
    {
      "ordinal": 8,
      "start_ms": 22680,
      "end_ms": 25280,
      "text": "所以他的国籍一定是中国国籍"
    },
    {
      "ordinal": 9,
      "start_ms": 26940,
      "end_ms": 30340,
      "text": "第二点某人的啊"
    },
    {
      "ordinal": 10,
      "start_ms": 30340,
      "end_ms": 32980,
      "text": "就按照我们的消息源的原话"
    },
    {
      "ordinal": 11,
      "start_ms": 32980,
      "end_ms": 36180,
      "text": "某人可以100%确定这个某人"
    },
    {
      "ordinal": 12,
      "start_ms": 36180,
      "end_ms": 38980,
      "text": "他是为我国政府做事情的"
    },
    {
      "ordinal": 13,
      "start_ms": 38980,
      "end_ms": 40580,
      "text": "效忠于我国政府的"
    },
    {
      "ordinal": 14,
      "start_ms": 42980,
      "end_ms": 45340,
      "text": "可以100%的确定"
    },
    {
      "ordinal": 15,
      "start_ms": 51120,
      "end_ms": 53900,
      "text": "好那你要知道这个消息源啊"
    },
    {
      "ordinal": 16,
      "start_ms": 53900,
      "end_ms": 55840,
      "text": "好你可以知道这个消息源"
    },
    {
      "ordinal": 17,
      "start_ms": 55840,
      "end_ms": 60510,
      "text": "但是有前提一我们告诉你吧"
    },
    {
      "ordinal": 18,
      "start_ms": 60510,
      "end_ms": 62610,
      "text": "我可可可以有限的告诉你"
    },
    {
      "ordinal": 19,
      "start_ms": 62610,
      "end_ms": 66160,
      "text": "我们的消息源是在东南亚活动"
    },
    {
      "ordinal": 20,
      "start_ms": 66160,
      "end_ms": 70780,
      "text": "但是它是嗯到处飞嘛"
    },
    {
      "ordinal": 21,
      "start_ms": 71510,
      "end_ms": 72630,
      "text": "是回欧洲的"
    },
    {
      "ordinal": 22,
      "start_ms": 73750,
      "end_ms": 77590,
      "text": "只要你是一个能够去东南亚活动"
    },
    {
      "ordinal": 23,
      "start_ms": 77590,
      "end_ms": 80330,
      "text": "并且去欧洲的"
    },
    {
      "ordinal": 24,
      "start_ms": 80330,
      "end_ms": 84630,
      "text": "或者说你可以去欧洲的一个活动人士"
    },
    {
      "ordinal": 25,
      "start_ms": 85310,
      "end_ms": 87030,
      "text": "我可以把这个消息源告诉你"
    },
    {
      "ordinal": 26,
      "start_ms": 88910,
      "end_ms": 90510,
      "text": "就是这个门槛"
    },
    {
      "ordinal": 27,
      "start_ms": 92480,
      "end_ms": 95560,
      "text": "其他的孩子知道这个这个消息源没有任何用处"
    },
    {
      "ordinal": 28,
      "start_ms": 95560,
      "end_ms": 97280,
      "text": "没有任何意义"
    },
    {
      "ordinal": 29,
      "start_ms": 98160,
      "end_ms": 99800,
      "text": "我们可以确定啊"
    },
    {
      "ordinal": 30,
      "start_ms": 99800,
      "end_ms": 100520,
      "text": "我们可以确定"
    },
    {
      "ordinal": 31,
      "start_ms": 101800,
      "end_ms": 104810,
      "text": "所以我们就是相当于回应一下"
    },
    {
      "ordinal": 32,
      "start_ms": 104810,
      "end_ms": 109510,
      "text": "最近对我本人的一个侮辱污蔑啊"
    },
    {
      "ordinal": 33,
      "start_ms": 109510,
      "end_ms": 111810,
      "text": "一个造谣"
    },
    {
      "ordinal": 34,
      "start_ms": 113220,
      "end_ms": 117440,
      "text": "当你们指控我欲做某某资产阶级集团"
    },
    {
      "ordinal": 35,
      "start_ms": 117440,
      "end_ms": 118980,
      "text": "什么什么集团"
    },
    {
      "ordinal": 36,
      "start_ms": 118980,
      "end_ms": 122550,
      "text": "某某在你们眼中的什么什么啊"
    },
    {
      "ordinal": 37,
      "start_ms": 122550,
      "end_ms": 126610,
      "text": "邪恶势力在你们眼中的伐走狗的时候"
    },
    {
      "ordinal": 38,
      "start_ms": 127420,
      "end_ms": 130259,
      "text": "你指控我是欲做法子狗而不得啊"
    },
    {
      "ordinal": 39,
      "start_ms": 131460,
      "end_ms": 133140,
      "text": "那首先"
    },
    {
      "ordinal": 40,
      "start_ms": 142060,
      "end_ms": 145709,
      "text": "首先去骂那些已经是乏走狗的人"
    },
    {
      "ordinal": 41,
      "start_ms": 145709,
      "end_ms": 148749,
      "text": "我并没有说某人就一定是伐走狗啊"
    },
    {
      "ordinal": 42,
      "start_ms": 148749,
      "end_ms": 150429,
      "text": "如果某人他效忠的团体"
    },
    {
      "ordinal": 43,
      "start_ms": 150429,
      "end_ms": 152350,
      "text": "是具有历史的先进性的话"
    },
    {
      "ordinal": 44,
      "start_ms": 152350,
      "end_ms": 156190,
      "text": "他不一定一定会被称之为是法斗狗"
    },
    {
      "ordinal": 45,
      "start_ms": 160420,
      "end_ms": 162240,
      "text": "啊是不是法走狗"
    },
    {
      "ordinal": 46,
      "start_ms": 162240,
      "end_ms": 164140,
      "text": "你们自己去鉴别啊"
    },
    {
      "ordinal": 47,
      "start_ms": 164140,
      "end_ms": 167220,
      "text": "你们自己去这个辨别鉴定"
    },
    {
      "ordinal": 48,
      "start_ms": 168220,
      "end_ms": 169440,
      "text": "你们自己去问"
    },
    {
      "ordinal": 49,
      "start_ms": 172520,
      "end_ms": 173840,
      "text": "好吧"
    },
    {
      "ordinal": 50,
      "start_ms": 174880,
      "end_ms": 176800,
      "text": "那我有的时候我就在想"
    },
    {
      "ordinal": 51,
      "start_ms": 178080,
      "end_ms": 179720,
      "text": "这个东西到底是个什么啊"
    },
    {
      "ordinal": 52,
      "start_ms": 179720,
      "end_ms": 184000,
      "text": "就是说欲做什么什么而不得"
    },
    {
      "ordinal": 53,
      "start_ms": 184000,
      "end_ms": 186520,
      "text": "这个是你投射在我身上的"
    },
    {
      "ordinal": 54,
      "start_ms": 186520,
      "end_ms": 190350,
      "text": "是你们这个团体投射在我身上的"
    },
    {
      "ordinal": 55,
      "start_ms": 190350,
      "end_ms": 193890,
      "text": "是不是你你们已经是吃了这口饭"
    },
    {
      "ordinal": 56,
      "start_ms": 193890,
      "end_ms": 195590,
      "text": "然后害怕我抢你们的饭"
    },
    {
      "ordinal": 57,
      "start_ms": 196990,
      "end_ms": 198950,
      "text": "那我只能说"
    },
    {
      "ordinal": 58,
      "start_ms": 199790,
      "end_ms": 201470,
      "text": "这叫做"
    },
    {
      "ordinal": 59,
      "start_ms": 205480,
      "end_ms": 206920,
      "text": "不知腐鼠成滋味"
    },
    {
      "ordinal": 60,
      "start_ms": 208240,
      "end_ms": 209320,
      "text": "我不要吃这口饭"
    },
    {
      "ordinal": 61,
      "start_ms": 209320,
      "end_ms": 211800,
      "text": "我不要吃你们吃的这口饭"
    },
    {
      "ordinal": 62,
      "start_ms": 214320,
      "end_ms": 216600,
      "text": "啊你们欲做什么什么而不得"
    },
    {
      "ordinal": 63,
      "start_ms": 216600,
      "end_ms": 218960,
      "text": "这种指控往我头上甩"
    },
    {
      "ordinal": 64,
      "start_ms": 218960,
      "end_ms": 221380,
      "text": "就是害怕我抢了你的饭呗"
    },
    {
      "ordinal": 65,
      "start_ms": 221380,
      "end_ms": 223290,
      "text": "那你吃呗"
    },
    {
      "ordinal": 66,
      "start_ms": 223490,
      "end_ms": 227810,
      "text": "那我两个明确的信息告诉你们了"
    },
    {
      "ordinal": 67,
      "start_ms": 227810,
      "end_ms": 229730,
      "text": "希望你们以后所有的讨论"
    },
    {
      "ordinal": 68,
      "start_ms": 229730,
      "end_ms": 232160,
      "text": "都以这个信息作为前提"
    },
    {
      "ordinal": 69,
      "start_ms": 232440,
      "end_ms": 235240,
      "text": "然后希望你们有自己的能力去确认"
    },
    {
      "ordinal": 70,
      "start_ms": 235240,
      "end_ms": 237090,
      "text": "确定这样的信息"
    },
    {
      "ordinal": 71,
      "start_ms": 237170,
      "end_ms": 239290,
      "text": "否则我是看不起你们的"
    },
    {
      "ordinal": 72,
      "start_ms": 239290,
      "end_ms": 240910,
      "text": "我已经明确告诉你了"
    },
    {
      "ordinal": 73,
      "start_ms": 240910,
      "end_ms": 242210,
      "text": "信息源是来自于"
    },
    {
      "ordinal": 74,
      "start_ms": 242210,
      "end_ms": 245450,
      "text": "在东南亚活动的某位欧洲活动家"
    },
    {
      "ordinal": 75,
      "start_ms": 250280,
      "end_ms": 252260,
      "text": "你们只要在东南亚去问一问"
    },
    {
      "ordinal": 76,
      "start_ms": 252260,
      "end_ms": 253900,
      "text": "或者去欧洲问一问"
    },
    {
      "ordinal": 77,
      "start_ms": 253900,
      "end_ms": 255920,
      "text": "你们就能得到答案"
    },
    {
      "ordinal": 78,
      "start_ms": 261399,
      "end_ms": 264019,
      "text": "啊好吧"
    },
    {
      "ordinal": 79,
      "start_ms": 264019,
      "end_ms": 265680,
      "text": "就讲到这里啊"
    }
  ],
  "text": "我们有明确可靠的消息源啊\n向我们透露某人的国籍啊\n首先某人的护照是持有的是中国护照\n其次按照国际法的规定\n你必须入籍\n你才能领申请领取中国护照\n所以他的国籍\n而且中国不承认双重国籍\n所以他的国籍一定是中国国籍\n第二点某人的啊\n就按照我们的消息源的原话\n某人可以100%确定这个某人\n他是为我国政府做事情的\n效忠于我国政府的\n可以100%的确定\n好那你要知道这个消息源啊\n好你可以知道这个消息源\n但是有前提一我们告诉你吧\n我可可可以有限的告诉你\n我们的消息源是在东南亚活动\n但是它是嗯到处飞嘛\n是回欧洲的\n只要你是一个能够去东南亚活动\n并且去欧洲的\n或者说你可以去欧洲的一个活动人士\n我可以把这个消息源告诉你\n就是这个门槛\n其他的孩子知道这个这个消息源没有任何用处\n没有任何意义\n我们可以确定啊\n我们可以确定\n所以我们就是相当于回应一下\n最近对我本人的一个侮辱污蔑啊\n一个造谣\n当你们指控我欲做某某资产阶级集团\n什么什么集团\n某某在你们眼中的什么什么啊\n邪恶势力在你们眼中的伐走狗的时候\n你指控我是欲做法子狗而不得啊\n那首先\n首先去骂那些已经是乏走狗的人\n我并没有说某人就一定是伐走狗啊\n如果某人他效忠的团体\n是具有历史的先进性的话\n他不一定一定会被称之为是法斗狗\n啊是不是法走狗\n你们自己去鉴别啊\n你们自己去这个辨别鉴定\n你们自己去问\n好吧\n那我有的时候我就在想\n这个东西到底是个什么啊\n就是说欲做什么什么而不得\n这个是你投射在我身上的\n是你们这个团体投射在我身上的\n是不是你你们已经是吃了这口饭\n然后害怕我抢你们的饭\n那我只能说\n这叫做\n不知腐鼠成滋味\n我不要吃这口饭\n我不要吃你们吃的这口饭\n啊你们欲做什么什么而不得\n这种指控往我头上甩\n就是害怕我抢了你的饭呗\n那你吃呗\n那我两个明确的信息告诉你们了\n希望你们以后所有的讨论\n都以这个信息作为前提\n然后希望你们有自己的能力去确认\n确定这样的信息\n否则我是看不起你们的\n我已经明确告诉你了\n信息源是来自于\n在东南亚活动的某位欧洲活动家\n你们只要在东南亚去问一问\n或者去欧洲问一问\n你们就能得到答案\n啊好吧\n就讲到这里啊",
  "timing_issue": null
}
