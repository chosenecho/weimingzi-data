{
  "model": "qwen-audio-3.1-asr-flash",
  "audio_sha256": "374e418b85bc241ec33396a7c3adb1d8440c406ea0335347a2586d37eca9c5d8",
  "chunk_seconds": 240,
  "speaker_diarization_enabled": true,
  "sample_rate": 16000,
  "version": 1,
  "source": "asr-cloud",
  "duration_seconds": 1468.8835,
  "segments": [
    {
      "start": 6.08,
      "end": 11.2,
      "text": "时光无言 却在大地上镌刻下行进的足迹",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 11.28,
      "end": 20.0,
      "text": "回望2025年 对于我们而言是从互助生存迈向共同发展的关键转折点",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 19.422,
      "end": 20.0,
      "text": "折点",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 20.24,
      "end": 26.96,
      "text": "在这一年里 我们经历了从单一服务向多元化产业的跨越",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 27.04,
      "end": 32.96,
      "text": "完成了从自发性互助向规范化运营的转型",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 33.04,
      "end": 36.08,
      "text": "面对市场波动与种种挑战",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 35.803,
      "end": 36.08,
      "text": "战",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 36.16,
      "end": 48.32,
      "text": "各部门以务实的态度在解决具体问题中实现了自我造血与集体赋能以下是各部门负责人的详细报告",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 48.88,
      "end": 52.24,
      "text": "大家好 我是叶俊博 执行俱乐部餐饮店店长",
      "speaker_id": 1,
      "chunk_offset_seconds": 0
    },
    {
      "start": 52.072,
      "end": 58.16,
      "text": "长执行俱乐部的发展是一场从生存到发展从单一到多元的持续演进",
      "speaker_id": 1,
      "chunk_offset_seconds": 0
    },
    {
      "start": 58.32,
      "end": 61.68,
      "text": "今年我们完成了数次空间功能的迭代",
      "speaker_id": 1,
      "chunk_offset_seconds": 0
    },
    {
      "start": 61.47,
      "end": 61.68,
      "text": "代",
      "speaker_id": 1,
      "chunk_offset_seconds": 0
    },
    {
      "start": 61.84,
      "end": 72.88,
      "text": "2楼由娱乐健身区先后转型为AI教学区 自习区如今融合唱歌和娱乐的复合区域不断丰富会员的精神生活",
      "speaker_id": 1,
      "chunk_offset_seconds": 0
    },
    {
      "start": 73.04,
      "end": 94.96,
      "text": "俱乐部已逐步成长为一个完整的集体生活的空间我们提供兜底餐饮 餐标从9块七微调至9块九并于入冬后提升至如今的11块 以保证会员营养此外 生日会 游戏与各类活动推动着俱乐部从交友互助向共同发展升阶",
      "speaker_id": 1,
      "chunk_offset_seconds": 0
    },
    {
      "start": 95.12,
      "end": 99.701,
      "text": "在住宿方面 店内宿舍从十个增至22",
      "speaker_id": 1,
      "chunk_offset_seconds": 0
    },
    {
      "start": 99.97,
      "end": 104.32,
      "text": "个这份信任是会员将生活托付于此的印证",
      "speaker_id": 1,
      "chunk_offset_seconds": 0
    },
    {
      "start": 104.48,
      "end": 109.28,
      "text": "志愿服务是我们不可或缺的一环服务从店内延伸至社区",
      "speaker_id": 1,
      "chunk_offset_seconds": 0
    },
    {
      "start": 109.36,
      "end": 118.48,
      "text": "店内覆盖洗碗 切配 清洁等基础运维店外则通过执行小屋开展看护 兴趣课堂等实际行动",
      "speaker_id": 1,
      "chunk_offset_seconds": 0
    },
    {
      "start": 117.843,
      "end": 127.2,
      "text": "际行动如今 志愿服务正从强调志愿本身转向更务实 更落实的社区支持晚托服务仅仅是起点",
      "speaker_id": 1,
      "chunk_offset_seconds": 0
    },
    {
      "start": 126.968,
      "end": 132.48,
      "text": "点未来还将推出惠民电工等项目 切实解决劳动者日常难题",
      "speaker_id": 1,
      "chunk_offset_seconds": 0
    },
    {
      "start": 132.64,
      "end": 165.36,
      "text": "今年八月 实习烘焙坊正式创立从装修到投产 挑战重重13千瓦烤箱导致频繁跳闸我们迅速完成了电路的升级 接入独立电源改造全楼配电系统 加装保护装置 确保用电的安全墙面不平则弃用背景纸 改用乳胶漆重刷灯光也经过调试 避免过曝投产以来 烘焙坊已推出铁盒切片饼干蛋糕盒子 蛋挞等多款产品并为俱乐部二周年制作纪念蛋糕",
      "speaker_id": 1,
      "chunk_offset_seconds": 0
    },
    {
      "start": 165.44,
      "end": 170.96,
      "text": "其中 我们烘焙坊蜂蜜小面包免费提供给劳动者 执行小屋和工地",
      "speaker_id": 1,
      "chunk_offset_seconds": 0
    },
    {
      "start": 171.04,
      "end": 173.28,
      "text": "新品研发也在持续进行中",
      "speaker_id": 1,
      "chunk_offset_seconds": 0
    },
    {
      "start": 173.6,
      "end": 176.88,
      "text": "展望明年 我们将在平稳运营的基础上",
      "speaker_id": 1,
      "chunk_offset_seconds": 0
    },
    {
      "start": 176.301,
      "end": 188.96,
      "text": "基础上继续深化餐饮店 烘焙坊 执行小屋与志愿服务队的建设切实助力底层劳动者改善生活 提升技能一步一个脚印 践行知青的初心与承诺",
      "speaker_id": 1,
      "chunk_offset_seconds": 0
    },
    {
      "start": 189.44,
      "end": 191.44,
      "text": "大家好 我是张桂林",
      "speaker_id": 2,
      "chunk_offset_seconds": 0
    },
    {
      "start": 191.52,
      "end": 196.72,
      "text": "来到知青小屋四个月 目前担任小屋的负责老师",
      "speaker_id": 2,
      "chunk_offset_seconds": 0
    },
    {
      "start": 197.2,
      "end": 205.84,
      "text": "知青小屋从零开始始终致力于为劳动者子女营造一片温暖 积极的成长空间",
      "speaker_id": 2,
      "chunk_offset_seconds": 0
    },
    {
      "start": 206.08,
      "end": 211.36,
      "text": "如今 我们已建立起较为完善的日常运营体系",
      "speaker_id": 2,
      "chunk_offset_seconds": 0
    },
    {
      "start": 211.52,
      "end": 216.08,
      "text": "共接收二十余名孩子 每日到访十多人",
      "speaker_id": 2,
      "chunk_offset_seconds": 0
    },
    {
      "start": 216.24,
      "end": 224.24,
      "text": "本学期 我们开展了夏令营 秋游 招新及墙绘等多项活动",
      "speaker_id": 2,
      "chunk_offset_seconds": 0
    },
    {
      "start": 224.4,
      "end": 236.16,
      "text": "并对空间做了优化比如将书架从后方移至两侧让布局更合理 更贴合孩子们学习与活动的需要",
      "speaker_id": 2,
      "chunk_offset_seconds": 0
    },
    {
      "start": 236.24,
      "end": 240.0,
      "text": "孩子们的午餐在俱乐部的支持下持续。",
      "speaker_id": 2,
      "chunk_offset_seconds": 0
    },
    {
      "start": 240.0,
      "end": 246.4,
      "text": "供应至今已送出数千份保证大家能吃上营养饭菜",
      "speaker_id": 0,
      "chunk_offset_seconds": 240
    },
    {
      "start": 246.56,
      "end": 250.8,
      "text": "日常中志愿者不仅负责看护与授课",
      "speaker_id": 0,
      "chunk_offset_seconds": 240
    },
    {
      "start": 250.88,
      "end": 253.92,
      "text": "还承担小屋维修维护工作",
      "speaker_id": 0,
      "chunk_offset_seconds": 240
    },
    {
      "start": 254.24,
      "end": 258.08,
      "text": "正是在众多志愿者们的共同守护下",
      "speaker_id": 0,
      "chunk_offset_seconds": 240
    },
    {
      "start": 258.16,
      "end": 260.8,
      "text": "小屋才得以不断成长",
      "speaker_id": 0,
      "chunk_offset_seconds": 240
    },
    {
      "start": 260.88,
      "end": 263.84,
      "text": "成为孩子们放学后的港湾",
      "speaker_id": 0,
      "chunk_offset_seconds": 240
    },
    {
      "start": 264.24,
      "end": 268.48,
      "text": "我由衷感谢每一位默默付出的志愿者",
      "speaker_id": 0,
      "chunk_offset_seconds": 240
    },
    {
      "start": 268.56,
      "end": 272.56,
      "text": "是你们让这个小屋不仅有光有饭",
      "speaker_id": 0,
      "chunk_offset_seconds": 240
    },
    {
      "start": 272.64,
      "end": 274.72,
      "text": "更有爱和希望大家",
      "speaker_id": 0,
      "chunk_offset_seconds": 240
    },
    {
      "start": 275.657,
      "end": 294.48,
      "text": "好我是王玉风无车队负责人自风无车队成立至今我已在此工作两年全面负责车队的运营协调团队建设与人员调配等工作两年来车队从零起步在司机培养运力配置和业务拓展方面取得了扎实进展在人员培养方面",
      "speaker_id": 1,
      "chunk_offset_seconds": 240
    },
    {
      "start": 294.4,
      "end": 317.84000000000003,
      "text": "我们已经成功培养约十位司机涵盖B照与C照类型他们不仅能够独立上岗部分已具备出色的市场竞争力这已得益于我们逐渐建立起的系统化培训机制与高密度时间安排在资产建设方面车队已经配备两辆B照车以及4米2货车运力日趋完善2025年我们在整体业务量上与",
      "speaker_id": 1,
      "chunk_offset_seconds": 240
    },
    {
      "start": 318.073,
      "end": 320.64,
      "text": "销售额上实现了显著增长",
      "speaker_id": 1,
      "chunk_offset_seconds": 240
    },
    {
      "start": 320.406,
      "end": 331.6,
      "text": "长但发展的过程并非一帆风顺突出的问题是人员配置滞后与车辆配置导致一段时间出现司机短缺车辆闲置业务承接能力受限",
      "speaker_id": 1,
      "chunk_offset_seconds": 240
    },
    {
      "start": 331.84000000000003,
      "end": 336.96,
      "text": "经过一年的时间摸索我们逐渐形成了一条清晰的司机成长路径",
      "speaker_id": 1,
      "chunk_offset_seconds": 240
    },
    {
      "start": 337.12,
      "end": 340.32,
      "text": "从4米2逐步升级至9米6货车",
      "speaker_id": 1,
      "chunk_offset_seconds": 240
    },
    {
      "start": 340.48,
      "end": 342.48,
      "text": "目前正按照计划推进",
      "speaker_id": 1,
      "chunk_offset_seconds": 240
    },
    {
      "start": 342.88,
      "end": 349.52,
      "text": "展望2026年我们的重点是将培训体系进一步标准化制度化弥补此前的规范性上的不足",
      "speaker_id": 1,
      "chunk_offset_seconds": 240
    },
    {
      "start": 349.6,
      "end": 365.12,
      "text": "我们计划扩大B照车的培养规模同时拓展业务渠道提升司机技能双轮驱动对应当下货运市场下行运营价走低的行业挑战我们希望通过稳定优质的培训项目为更多有志青年提供可发展的路径",
      "speaker_id": 1,
      "chunk_offset_seconds": 240
    },
    {
      "start": 365.28,
      "end": 372.0,
      "text": "风无车队期待更多伙伴加入共同驶向更广阔的未来欢迎大家积极报名B照车培训项目",
      "speaker_id": 1,
      "chunk_offset_seconds": 240
    },
    {
      "start": 372.32,
      "end": 379.03999999999996,
      "text": "大家好我是张百济维修部的前身是工坊一路走来我们经历了多次转型与调整",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 379.2,
      "end": 387.44,
      "text": "项目初始阶段我们聚焦于3D打印工具制作及设计开发随后逐步转向文创产品的生产",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 387.52,
      "end": 391.6,
      "text": "主要包括奖牌奖章小型纪念品等",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 391.76,
      "end": 394.56,
      "text": "目前仍保留部分3D打印技术",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 394.64,
      "end": 398.8,
      "text": "其中显卡外壳便是由我们自主设计并打印完成的",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 399.12,
      "end": 403.84000000000003,
      "text": "今年春节后我们正式进入电脑整机销售领域",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 404.0,
      "end": 408.15999999999997,
      "text": "这一尝试源于对于AI技术的关注与判断",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 408.32,
      "end": 415.76,
      "text": "我们希望推广适合本地使用的AI的整机设备同时启动AI学习助手的研发",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 416.0,
      "end": 419.36,
      "text": "初期从MI五零改装机入手",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 419.44,
      "end": 430.4,
      "text": "逐步推出V100等产品业务核心从显卡推广起步因单售显卡市场反响一般我们转而整合配置开展整机销售",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 430.64,
      "end": 435.28,
      "text": "从四月到九月我们处于整机销售的探索阶段",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 435.36,
      "end": 438.8,
      "text": "八至9月份机修团队并入工坊",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 438.88,
      "end": 443.12,
      "text": "新址正式启用我们也由工坊升级为维修部",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 443.2,
      "end": 448.48,
      "text": "在八月与九月期间工坊积极响应郑和陈生支教项目",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 448.64,
      "end": 452.32,
      "text": "为下乡支教工作提供技术与设备支持",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 452.4,
      "end": 459.28,
      "text": "我们向支教地区及一线支教教师配备了MI五零整机及若干办公设备",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 459.36,
      "end": 462.72,
      "text": "以满足教学与管理工作的电子需求",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 462.8,
      "end": 472.8,
      "text": "同时工坊还与当地支教教师展开了紧密合作共同修复了多所支教学校的设备助力提升学校的设施条件",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 472.88,
      "end": 479.573,
      "text": "然而八月至年底受到内存及整机配件价格上涨影响整机销售",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 479.14599999999996,
      "end": 480.0,
      "text": "销售有所。",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 480.0,
      "end": 487.04,
      "text": "所下滑 尽管如此 AI学习助手的研发却稳步推进产品进入持续更新与优化阶段",
      "speaker_id": 0,
      "chunk_offset_seconds": 480
    },
    {
      "start": 487.2,
      "end": 495.76,
      "text": "关于AI学习助手 我想特别强调面对年初AI技术的爆发式增长我们认为有责任推动及普及",
      "speaker_id": 0,
      "chunk_offset_seconds": 480
    },
    {
      "start": 495.84,
      "end": 497.76,
      "text": "即便不购买我们的整机",
      "speaker_id": 0,
      "chunk_offset_seconds": 480
    },
    {
      "start": 497.84,
      "end": 503.28,
      "text": "AI学习助手依然完全开源免费通过API即可体验",
      "speaker_id": 0,
      "chunk_offset_seconds": 480
    },
    {
      "start": 503.36,
      "end": 507.84,
      "text": "它是一款面向广大用户 提高学习效率的实用工具",
      "speaker_id": 0,
      "chunk_offset_seconds": 480
    },
    {
      "start": 508.0,
      "end": 509.04,
      "text": "面向未来",
      "speaker_id": 0,
      "chunk_offset_seconds": 480
    },
    {
      "start": 509.2,
      "end": 528.88,
      "text": "我们将转型至电子维修教学领域进一步拓展显卡笔记本的维修培训我们将建立更完善的学员管理与教学体系全力配合执星俱乐部推动培训项目发展把技术变成真正可用可学可持续的能力资源",
      "speaker_id": 0,
      "chunk_offset_seconds": 480
    },
    {
      "start": 529.28,
      "end": 533.2,
      "text": "大家好 我是执星俱乐部培训部电工培训的负责人汪明轩",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 533.36,
      "end": 537.92,
      "text": "培训部的设立源于我们对技能培训的系统化规范化的迫切需求",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 538.0,
      "end": 544.8,
      "text": "从最初零散的项目试点 到如今的体系化运营我们走过了一条从探索走向专业的路径",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 544.88,
      "end": 547.44,
      "text": "今年我们共开展了三期电工培训",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 547.52,
      "end": 556.8,
      "text": "每期三名学员 累计共九人目前已有九人成功就业 成为合格的装配电工培训整体进展顺利 但过程中也暴露出一些问题",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 556.88,
      "end": 565.6800000000001,
      "text": "许多学员普遍缺乏基础理论知识我们在教学过程中不仅强化实操训练也有意识加强理论教学持续打磨课程体系",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 565.6,
      "end": 573.84,
      "text": "这一实践让我们深刻意识到技能培训不能急功近利只有夯实基础才能真正实现能力提升与可持续就业",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 574.08,
      "end": 578.3199999999999,
      "text": "面向明年 我们计划引入浅层级的PLC教学",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 578.48,
      "end": 580.24,
      "text": "逐步拓展课程内容",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 580.4,
      "end": 587.2,
      "text": "提升学员的技术水平与就业竞争力我们的目标是培养出更多具备实战能力的装配电工",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 587.36,
      "end": 595.6,
      "text": "帮助求职者实现稳定就业也期待通过这一过程不断推动执星俱乐部人才培养体系向更高水准迈进",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 596.24,
      "end": 598.0,
      "text": "大家好 我是姚宇杰",
      "speaker_id": 2,
      "chunk_offset_seconds": 480
    },
    {
      "start": 598.3199999999999,
      "end": 601.6800000000001,
      "text": "执星俱乐部培训部汽修培训负责人",
      "speaker_id": 2,
      "chunk_offset_seconds": 480
    },
    {
      "start": 601.92,
      "end": 605.2,
      "text": "此前我在广州从事汽修培训工作",
      "speaker_id": 2,
      "chunk_offset_seconds": 480
    },
    {
      "start": 605.36,
      "end": 610.4,
      "text": "目前已调至苏州主要负责学员学习情况的跟进",
      "speaker_id": 2,
      "chunk_offset_seconds": 480
    },
    {
      "start": 610.64,
      "end": 615.44,
      "text": "技能评估以及推进培训体系的规范化建设",
      "speaker_id": 2,
      "chunk_offset_seconds": 480
    },
    {
      "start": 615.76,
      "end": 620.0,
      "text": "随着培训部逐步建立原本零散的汽修教学项目",
      "speaker_id": 2,
      "chunk_offset_seconds": 480
    },
    {
      "start": 620.08,
      "end": 624.3199999999999,
      "text": "也逐步发展为一套较为完善的培养体系",
      "speaker_id": 2,
      "chunk_offset_seconds": 480
    },
    {
      "start": 624.48,
      "end": 629.2,
      "text": "目前我们共有11名学员其中三到四位表现为优秀",
      "speaker_id": 2,
      "chunk_offset_seconds": 480
    },
    {
      "start": 629.36,
      "end": 632.96,
      "text": "预计一到两个月内可成长为中级技工",
      "speaker_id": 2,
      "chunk_offset_seconds": 480
    },
    {
      "start": 633.04,
      "end": 637.84,
      "text": "根据观察一批学员的完整培训周期为四到五个月",
      "speaker_id": 2,
      "chunk_offset_seconds": 480
    },
    {
      "start": 638.0,
      "end": 641.2,
      "text": "目前首批学员已进入培训尾声",
      "speaker_id": 2,
      "chunk_offset_seconds": 480
    },
    {
      "start": 641.36,
      "end": 646.56,
      "text": "除二人尚未就业外其他人均已进入实习或正式岗位",
      "speaker_id": 2,
      "chunk_offset_seconds": 480
    },
    {
      "start": 646.96,
      "end": 651.44,
      "text": "在课程发展方面我们正在完善教学体系",
      "speaker_id": 2,
      "chunk_offset_seconds": 480
    },
    {
      "start": 651.52,
      "end": 656.3199999999999,
      "text": "并着手建设教师梯队目前已尝试将学习能力强",
      "speaker_id": 2,
      "chunk_offset_seconds": 480
    },
    {
      "start": 656.48,
      "end": 660.08,
      "text": "实操扎实的学员培养为助教",
      "speaker_id": 2,
      "chunk_offset_seconds": 480
    },
    {
      "start": 660.4,
      "end": 663.92,
      "text": "让他们参与授课 不仅加深自身理解",
      "speaker_id": 2,
      "chunk_offset_seconds": 480
    },
    {
      "start": 664.08,
      "end": 666.24,
      "text": "也为未来储备师资力量",
      "speaker_id": 2,
      "chunk_offset_seconds": 480
    },
    {
      "start": 666.64,
      "end": 670.96,
      "text": "今天已有几位学员上台试讲 实操效果良好",
      "speaker_id": 2,
      "chunk_offset_seconds": 480
    },
    {
      "start": 671.2,
      "end": 679.52,
      "text": "新的一年 我们将继续推动这种能学能教的培养体系构建教学相长 循环成长的良性机制",
      "speaker_id": 2,
      "chunk_offset_seconds": 480
    },
    {
      "start": 679.6,
      "end": 686.72,
      "text": "我们将通过课程体系的不断迭代和教学模式的优化帮助青年掌握汽修技能",
      "speaker_id": 2,
      "chunk_offset_seconds": 480
    },
    {
      "start": 686.88,
      "end": 691.76,
      "text": "实现稳定就业走出一条清晰可持续的发展道路",
      "speaker_id": 2,
      "chunk_offset_seconds": 480
    },
    {
      "start": 692.56,
      "end": 698.64,
      "text": "大家好 我是方文 品牌部负责人现主要负责品牌部整体的策划工作",
      "speaker_id": 3,
      "chunk_offset_seconds": 480
    },
    {
      "start": 698.88,
      "end": 702.0,
      "text": "品牌部的发展经历了从无到有的过程",
      "speaker_id": 3,
      "chunk_offset_seconds": 480
    },
    {
      "start": 702.08,
      "end": 706.4,
      "text": "从最初以太假说项目出发逐步建立起直播间",
      "speaker_id": 3,
      "chunk_offset_seconds": 480
    },
    {
      "start": 706.56,
      "end": 709.76,
      "text": "从单一商品拓展到多元选品体系",
      "speaker_id": 3,
      "chunk_offset_seconds": 480
    },
    {
      "start": 709.84,
      "end": 716.72,
      "text": "从品牌定位 产品规划到店铺运营 直播内容我们一路探索 不断完善",
      "speaker_id": 3,
      "chunk_offset_seconds": 480
    },
    {
      "start": 716.8,
      "end": 720.0,
      "text": "我的工作主要聚焦于选品方向把控。",
      "speaker_id": 3,
      "chunk_offset_seconds": 480
    },
    {
      "start": 720.0,
      "end": 723.36,
      "text": "项目协同推进及日常运营管理",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 722.584,
      "end": 723.36,
      "text": "营管理",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 723.68,
      "end": 732.16,
      "text": "在产品规划方面 我们采取分类精细化策略在食品上 我们持续挖掘兼具美味与健康的产品",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 732.32,
      "end": 741.6,
      "text": "例如以广受好评的鸡胸肉和巧克力在服装方面 我们增加了穿搭建议将以太假说已有服装进行组合搭配",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 741.68,
      "end": 747.04,
      "text": "把效果呈现在详情页中让大家对实际穿着有更直观的印象",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 747.6,
      "end": 751.28,
      "text": "正和农产品于今年四月底正式运营",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 751.36,
      "end": 765.68,
      "text": "最初仅由一到两名职员担任全店运营工作从销售水果起步我们在实践中不断拓展产品线逐步建立起较为完整的体系正和助农与正和成生是我们的主要项目在",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 765.961,
      "end": 785.92,
      "text": "助农方面 我们深入销售受阻生活困难的一线产地以优先支持急需出路的农户为原则销售多种优质农产品目前已点亮重庆赣州等地区未来还将覆盖徐州皖南等更多农村产地助力农户稳定创收摆脱困境",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 786.0,
      "end": 798.88,
      "text": "我们摒弃先盈利后捐款的割裂模式将绝大部分收益直接让渡给农民让他们真正老有所得让每一笔消费 内生性的为农人经济造血为乡村教育输血",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 799.04,
      "end": 812.16,
      "text": "正和成生支教项目也同步进行已开展三期每期约十名教师深入偏远地区带去知识陪伴与希望这是我们连接城乡教育差距的另一重要路径",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 812.3199999999999,
      "end": 833.28,
      "text": "我们也在不断拓展以太假说的原创视觉表达用产品记录我们的日常与理念比如正和的蜂蜜腊肠橙子已设计出专属视觉卡片鼠标垫也呈现出品牌特色未来我们将在服饰中融入更多专属符号让设计真正穿在身上成为价值认同的外在表达",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 833.44,
      "end": 836.96,
      "text": "在宣传策略上 我们正借助其他部门的力量",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 837.04,
      "end": 846.16,
      "text": "启动系统化的横向测评制作专业真实科学的产品测评内容展示产品如何在生活中产生改变",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 846.4,
      "end": 853.28,
      "text": "我们不只是销售产品更希望它能真正改变使用者的生活回应大家的信任与期待",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 853.44,
      "end": 865.84,
      "text": "我们的团队很年轻 经验虽不丰富但每个人都认真负责主动解决问题在这里没有只顾自己漠不关心的人也没有摸鱼的心态大家志同道合一起把事情推进",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 866.0,
      "end": 868.48,
      "text": "让现实因我们的行动而发生改变",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 868.56,
      "end": 875.6800000000001,
      "text": "工作中每个人都在成长理想的状态是无论策划还是执行大家都能胜任并默契配合",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 875.84,
      "end": 877.44,
      "text": "我对整体的期望是一种",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 877.808,
      "end": 884.64,
      "text": "充满创造力和实践精神的工作与生活方式在现实中落地生长并持续滋养更多人",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 885.12,
      "end": 932.64,
      "text": "大家好 我是韩青青我们这一年的视觉记录工作 始终围绕着一个核心命题呈现劳动者真实的生活状态切实的需求改善以及集体生活所能凝聚的一切可能商业广告与产品宣传 看似是功能性的素材制作实则承载着我们对好产品的理解产品应当改善使用者的生活而非仅仅满足消费欲望我们用镜头记录修车坊 从毛坯到落成的每个细节游学项目从构想到出发的筹备过程让观者看见 这一切是如何在众人的协力劳动中从无到有的建立起来人物访谈系列 记录了十余位成员的故事与日常无论是我们访谈栏目中的深度对话还是对单日生活的完整呈现每个受访者都以自身的历史和经验用生命的力量回应着时代的挑战",
      "speaker_id": 1,
      "chunk_offset_seconds": 720
    },
    {
      "start": 932.88,
      "end": 940.24,
      "text": "这些面孔与声音 构成了团队的底色短视频与直播运营 则将视角投向更日常的生活切片",
      "speaker_id": 1,
      "chunk_offset_seconds": 720
    },
    {
      "start": 940.3199999999999,
      "end": 960.0,
      "text": "从俱乐部入会指南 到公益活动现场从会员调查到宿舍搬家记录这些短视频构成了集体生活的样态这些碎片化的影像汇聚起来勾勒出一幅劳动者相互支持 共同生活的图景支教与助农项目的记录 是这一年最具深度的影像工作支教项目的镜头深入。",
      "speaker_id": 1,
      "chunk_offset_seconds": 720
    },
    {
      "start": 960.0,
      "end": 968.0,
      "text": "入偏远地区用长视频完整呈现支教的准备实施与反思过程记录志愿教师如何坚守教学一线",
      "speaker_id": 0,
      "chunk_offset_seconds": 960
    },
    {
      "start": 968.08,
      "end": 971.04,
      "text": "让他们的付出与坚持被看见被铭记",
      "speaker_id": 0,
      "chunk_offset_seconds": 960
    },
    {
      "start": 971.28,
      "end": 978.96,
      "text": "助农项目的影像则表现农户真实的劳动场景优质的农产品以及他们依靠自己双手创造价值的过程",
      "speaker_id": 0,
      "chunk_offset_seconds": 960
    },
    {
      "start": 979.04,
      "end": 993.52,
      "text": "我们通过宣传影像消解城乡之间的信息壁垒让消费者看见农产品背后的人与故事希望能让劳动者劳有所得并让每一笔交易都成为对农民劳动的直接支持这是一种新型城乡关系的探索",
      "speaker_id": 0,
      "chunk_offset_seconds": 960
    },
    {
      "start": 993.6,
      "end": 998.48,
      "text": "活动记录与长视频系列则以更系统的方式呈现我们的整体实践",
      "speaker_id": 0,
      "chunk_offset_seconds": 960
    },
    {
      "start": 998.72,
      "end": 1000.4,
      "text": "生存发展解放",
      "speaker_id": 0,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1000.32,
      "end": 1002.24,
      "text": "系列通过长视频形式",
      "speaker_id": 0,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1002.16,
      "end": 1015.2,
      "text": "完整梳理了各个项目从构想到落地的全过程从俱乐部门店运营到车队培训从电工访谈到年度回顾这是我们如何行动如何在现实中一步步推进改变的系统呈现",
      "speaker_id": 0,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1015.68,
      "end": 1019.28,
      "text": "大家好我是小红负责直播与社群活动",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1019.2,
      "end": 1023.04,
      "text": "那么直播间呢既是一个注重互动节奏与内容深度",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1022.96,
      "end": 1025.76,
      "text": "为大家提供有内容也有趣的互动平台",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1025.92,
      "end": 1029.12,
      "text": "也是一个可以了解俱乐部生活与理念的窗口",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1029.36,
      "end": 1032.64,
      "text": "这里有文艺电影与俱乐部视频的放松与讲解",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1032.72,
      "end": 1034.32,
      "text": "也有丰富的社群活动",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1034.48,
      "end": 1037.68,
      "text": "当然最重要的是这是一个带货直播间",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1037.76,
      "end": 1044.8,
      "text": "核心内容分为带货与聊天两大板块带货方面不局限于双十一等节点的促销活动",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1044.72,
      "end": 1048.8,
      "text": "而且会深度挖掘助农品牌故事及自有品牌理念",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1048.96,
      "end": 1058.64,
      "text": "通过讲解传递品牌价值观聊天方面呢采用双人搭档模式分享主播与嘉宾的生活经历以及俱乐部成员的成长故事",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1058.88,
      "end": 1060.64,
      "text": "在对话中相互了解",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1060.96,
      "end": 1071.68,
      "text": "此外我们定期汇报俱乐部经营状况连线重要活动现场及时回应观众关心的运营情况以及劳务问题展现共同体发展的完整历程",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1072.08,
      "end": 1074.0,
      "text": "那么直播间有什么特色呢",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1074.08,
      "end": 1081.52,
      "text": "我们设置了网络热点批判及连线支教老师等兼具理论与实践的报道通过对热门话题的深度解读",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1081.44,
      "end": 1088.32,
      "text": "结合创新性的互动形式引导观众思考普通人在情感家庭工作中面临的现实困境",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1088.6399999999999,
      "end": 1091.44,
      "text": "以及通过展示全国多地支教项目",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1091.52,
      "end": 1094.88,
      "text": "介绍艰苦环境下的教学现状与学生工作",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1095.04,
      "end": 1098.6399999999999,
      "text": "同时我们还开设政治经济相关的英文词汇",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1098.56,
      "end": 1100.32,
      "text": "以及历史背景的学习环节",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1100.6399999999999,
      "end": 1102.96,
      "text": "为观众提供理论学习平台",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1103.04,
      "end": 1105.52,
      "text": "确保内容导向的专业性与深度",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1106.0,
      "end": 1110.32,
      "text": "在线下社群活动致力于帮助新老会员快速融合",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1110.4,
      "end": 1124.0,
      "text": "通过分享个人经历打破隔阂展现俱乐部开放青春的不沦陷于自怜的组织面貌我们还办了倡导无产阶级的恋爱价值观模拟恋综反对以资本增值为目的的情感交流",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1123.92,
      "end": 1127.52,
      "text": "倡导非消费性非功利性的真诚互动",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1127.6,
      "end": 1130.0,
      "text": "用劳动创造情感空间",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1130.08,
      "end": 1135.92,
      "text": "通过开放式倾诉与理性分析直面生存发展中的家庭与情感困境",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1136.0,
      "end": 1142.0,
      "text": "倡导平等发言互相督促与鼓励让原子化的个体重新融入无产阶级大家庭",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1142.6399999999999,
      "end": 1148.08,
      "text": "除精神层面建设外社群活动还提供切实的个人成长与互助支持",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1148.32,
      "end": 1154.16,
      "text": "在形象提升方面我们开展化妆拍摄等一站式变美活动",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1154.24,
      "end": 1157.12,
      "text": "帮助成员提高审美能力与自信心",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1157.2,
      "end": 1160.88,
      "text": "在创造美欣赏美的过程中实现自我提升",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1161.3600000000001,
      "end": 1162.72,
      "text": "在就业互助方面",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1162.6399999999999,
      "end": 1167.76,
      "text": "我们搭建电工老师傅带新行业交流等专业指导平台",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1167.84,
      "end": 1171.3600000000001,
      "text": "帮助失业或就业困难群体了解行业现状",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1171.44,
      "end": 1172.8,
      "text": "掌握生存技能",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1173.28,
      "end": 1177.84,
      "text": "此外通过手工制作体育竞技才艺展示等丰富活动",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1177.92,
      "end": 1182.56,
      "text": "落实人与人的真实交往营造热烈团结的俱乐部氛围",
      "speaker_id": 1,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1182.88,
      "end": 1187.76,
      "text": "大家好我是韩凤萍我主要做的是咨询的工作在这几个月里",
      "speaker_id": 2,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1187.68,
      "end": 1192.48,
      "text": "我接待了许多在生活工作学习或情感中遇到困扰的朋友",
      "speaker_id": 2,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1192.56,
      "end": 1197.3600000000001,
      "text": "他们大多因为信任未名子及其团队所代表的真诚与批判性关怀而来",
      "speaker_id": 2,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1197.44,
      "end": 1200.0,
      "text": "我作为团队的一员我所能做的就是尽。",
      "speaker_id": 2,
      "chunk_offset_seconds": 960
    },
    {
      "start": 1200.0,
      "end": 1207.6,
      "text": "我所能，以我有限的人生经验和专业知识去倾听、理解，有时给予建议，有时只是陪伴对话。",
      "speaker_id": 0,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1207.76,
      "end": 1213.28,
      "text": "我始终清楚，这份信任不属于我个人，而是指向团队共同建构的这份事业。",
      "speaker_id": 0,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1213.36,
      "end": 1218.32,
      "text": "一种试图打破冷漠消费逻辑，建立人与人之间真实连接的努力。",
      "speaker_id": 0,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1218.56,
      "end": 1226.64,
      "text": "我们开设咨询服务的初衷，是希望在一个充满疏离与压力的时代中，开辟一处低门槛、可触及的陪伴空间。",
      "speaker_id": 0,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1226.72,
      "end": 1232.8,
      "text": "无论是象征性的0.01元首次咨询，还是远低于市场价格的单次或包月服务，",
      "speaker_id": 0,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1232.88,
      "end": 1236.24,
      "text": "我们都努力在公益与可持续之间寻找平衡。",
      "speaker_id": 0,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1236.32,
      "end": 1243.2,
      "text": "既不让经济困难成为咨询的阻碍，也让我们的团队能够持续运转，支付工作人员基本的劳动回报。",
      "speaker_id": 0,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1243.44,
      "end": 1253.28,
      "text": "在咨询工作中，每一个来访者的讲述，每一次共同的反思，都是在具体情境中试图直面问题、寻求转变的微小尝试。",
      "speaker_id": 0,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1253.44,
      "end": 1264.16,
      "text": "我们不敢说能解决所有的困境，但如果某一次对话能带来一丝宽慰、一点启发，甚至只是一个被认真听见的瞬间，那便是这项工作最重要的意义。",
      "speaker_id": 0,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1264.56,
      "end": 1268.08,
      "text": "感谢每一位曾勇敢开口、愿意信任我们的朋友。",
      "speaker_id": 0,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1268.16,
      "end": 1271.2,
      "text": "你们的每一次倾诉，也让我们更坚定地认识到，",
      "speaker_id": 0,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1271.52,
      "end": 1276.16,
      "text": "思想应当服务于人的真实生活，理论必须扎根于对他者的关怀。",
      "speaker_id": 0,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1276.32,
      "end": 1283.36,
      "text": "未来，我们团队会继续秉持这种价值导向，在力所能及的范围内，持续提供这样的陪伴空间。",
      "speaker_id": 0,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1285.84,
      "end": 1290.72,
      "text": "2025年，是理念的根系向现实深处生长的一年。",
      "speaker_id": 1,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1290.88,
      "end": 1293.68,
      "text": "是从分散探索走向系统建构，",
      "speaker_id": 1,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1293.84,
      "end": 1297.6,
      "text": "从互助生存迈向共同发展的重要转折。",
      "speaker_id": 1,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1297.84,
      "end": 1307.28,
      "text": "我们从单一的服务点，生长为涵盖生活支持、技能培训、社区服务、产品探索与品牌建设的有机生态。",
      "speaker_id": 1,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1307.6,
      "end": 1310.88,
      "text": "这条路上，有空间的改造与功能的迭代，",
      "speaker_id": 1,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1311.04,
      "end": 1313.44,
      "text": "有从零到一的产品诞生，",
      "speaker_id": 1,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1313.52,
      "end": 1315.84,
      "text": "有培训体系的从无到有，",
      "speaker_id": 1,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1315.92,
      "end": 1323.2,
      "text": "也有市场波动带来的压力与调整。每一次变形背后，都是与现实碰撞、校准的过程。",
      "speaker_id": 1,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1324.0,
      "end": 1335.3600000000001,
      "text": "这不是一条坦途。我们共同经历了业务转型的阵痛，市场波动的压力，资源配置的挑战，以及行动时必然遭遇的琐碎与磨合。",
      "speaker_id": 2,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1336.16,
      "end": 1342.56,
      "text": "我们由衷感谢每一位成员的汗水与智慧，感谢志愿者的无私付出与持久守护，",
      "speaker_id": 3,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1342.6399999999999,
      "end": 1348.72,
      "text": "感谢知青俱乐部、餐饮团队、烘焙坊成员，以及所有参加志愿服务的伙伴。",
      "speaker_id": 3,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1348.8,
      "end": 1353.84,
      "text": "感谢分五车队每一位司机师傅、培训学员与业务协调者，",
      "speaker_id": 3,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1353.92,
      "end": 1360.16,
      "text": "感谢维修部、技术研发团队、维修师傅，以及每一位推动产品迭代的伙伴。",
      "speaker_id": 3,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1360.24,
      "end": 1364.0,
      "text": "感谢培训部的所有教师、助教和学员，",
      "speaker_id": 3,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1364.08,
      "end": 1370.48,
      "text": "感谢品牌部、运营团队、合作农户、支教老师，以及每一位信任我们的消费者。",
      "speaker_id": 3,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1370.56,
      "end": 1374.8,
      "text": "感谢知青小屋里守护孩子成长的每一位老师和志愿者。",
      "speaker_id": 3,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1375.04,
      "end": 1393.04,
      "text": "我们的行动始终朝向广阔而深远的意义，不仅是个体技能的提升与生活的改善，更是劳动者尊严重建与集体力量的凝聚。每一份餐食的背后，是对基本生存权的守护。每一次志愿服务背后，是互助共济精神的传承。",
      "speaker_id": 1,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1393.12,
      "end": 1398.6399999999999,
      "text": "每一次培训背后，是让掌握技能的个体成为推动现实发展的坚实力量。",
      "speaker_id": 1,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1398.88,
      "end": 1409.2,
      "text": "而系统性的相互支撑，凝聚起改变现实的持久力量。俱乐部的生活托底，筑牢了后方；烘焙坊的产品，成为了活动的桥梁；",
      "speaker_id": 4,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1409.28,
      "end": 1425.76,
      "text": "车队的运力，支撑着物资与人员的流动；维修部的技术保障着设备的稳定运转；培训部输出的技能人才，奔赴各个岗位；品牌部让我们的故事与创造被更多人看到；而小屋，则安放着我们共同关怀的未来。",
      "speaker_id": 4,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1426.0,
      "end": 1429.2,
      "text": "集体的行进，踏实而稳健。",
      "speaker_id": 5,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1429.3600000000001,
      "end": 1433.44,
      "text": "其中最动人的，永远是人的痕迹。",
      "speaker_id": 5,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1433.76,
      "end": 1435.44,
      "text": "对未来的向往，",
      "speaker_id": 5,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1435.52,
      "end": 1437.3600000000001,
      "text": "对彼此的信赖，",
      "speaker_id": 5,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1437.52,
      "end": 1440.0,
      "text": "对公益的呼唤，化作。",
      "speaker_id": 5,
      "chunk_offset_seconds": 1200
    },
    {
      "start": 1440.0,
      "end": 1442.4,
      "text": "行动中紧握的双手",
      "speaker_id": 0,
      "chunk_offset_seconds": 1440
    },
    {
      "start": 1442.64,
      "end": 1444.96,
      "text": "合影里真诚的笑脸",
      "speaker_id": 0,
      "chunk_offset_seconds": 1440
    },
    {
      "start": 1445.04,
      "end": 1447.68,
      "text": "日常里无声的守护",
      "speaker_id": 0,
      "chunk_offset_seconds": 1440
    },
    {
      "start": 1447.76,
      "end": 1454.24,
      "text": "这些点滴汇聚成我们的故事镌刻成历史的记忆",
      "speaker_id": 0,
      "chunk_offset_seconds": 1440
    },
    {
      "start": 1454.8,
      "end": 1456.88,
      "text": "展望前路 挑战犹存",
      "speaker_id": 1,
      "chunk_offset_seconds": 1440
    },
    {
      "start": 1456.8,
      "end": 1458.4,
      "text": "理想仍待生根",
      "speaker_id": 1,
      "chunk_offset_seconds": 1440
    },
    {
      "start": 1458.48,
      "end": 1461.44,
      "text": "感谢2025年的合力付出与坚守",
      "speaker_id": 1,
      "chunk_offset_seconds": 1440
    },
    {
      "start": 1461.52,
      "end": 1463.84,
      "text": "2026我们继续前行。",
      "speaker_id": 2,
      "chunk_offset_seconds": 1440
    }
  ],
