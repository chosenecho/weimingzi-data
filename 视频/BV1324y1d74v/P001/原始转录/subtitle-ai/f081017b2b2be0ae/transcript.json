      "ordinal": 193,
      "start_ms": 489439,
      "end_ms": 492770,
      "text": "不要否认你的介入性"
    },
    {
      "ordinal": 194,
      "start_ms": 492770,
      "end_ms": 495900,
      "text": "不要幻想你是一种在野状态"
    },
    {
      "ordinal": 195,
      "start_ms": 496240,
      "end_ms": 497980,
      "text": "幻想你是一个在野状态"
    },
    {
      "ordinal": 196,
      "start_ms": 497980,
      "end_ms": 499660,
      "text": "幻想你可以支撑15"
