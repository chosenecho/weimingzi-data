  "segments": [
    {
      "ordinal": 0,
      "start_ms": 0,
      "end_ms": 5810,
      "text": "现在来讲就是呃呃公益小组"
    },
    {
      "ordinal": 1,
      "start_ms": 5810,
      "end_ms": 10550,
      "text": "公益团体啊啊还有另外两种情况"
    },
    {
      "ordinal": 2,
      "start_ms": 10550,
      "end_ms": 14030,
      "text": "上次讲了对两种人"
    },
    {
      "ordinal": 3,
      "start_ms": 14030,
      "end_ms": 16560,
      "text": "一个就是这个"
    },
    {
      "ordinal": 4,
      "start_ms": 19800,
      "end_ms": 22580,
      "text": "狗皮膏药还有一个金汁啊"
    },
    {
      "ordinal": 5,
      "start_ms": 22580,
      "end_ms": 23300,
      "text": "还记得吗"
    },
    {
      "ordinal": 6,
      "start_ms": 24320,
      "end_ms": 28500,
      "text": "狗皮膏药就是这个文化佐的嗯"
    },
    {
      "ordinal": 7,
      "start_ms": 28500,
      "end_ms": 29550,
      "text": "小知识分子啊"
    },
    {
      "ordinal": 8,
      "start_ms": 29550,
      "end_ms": 30360,
      "text": "小白领啊"
    },
    {
      "ordinal": 9,
      "start_ms": 30360,
      "end_ms": 31180,
      "text": "这些人"
    },
    {
      "ordinal": 10,
      "start_ms": 31820,
      "end_ms": 37210,
      "text": "那么金砖呢就指的那种激进的梦游者啊"
    },
    {
      "ordinal": 11,
      "start_ms": 37210,
      "end_ms": 38770,
      "text": "自以为行动的梦游者"
    },
    {
      "ordinal": 12,
      "start_ms": 38770,
      "end_ms": 41790,
      "text": "那我们今天要讲的是第三类人啊"
    },
    {
      "ordinal": 13,
      "start_ms": 41790,
      "end_ms": 45510,
      "text": "怎么对待那些这个公益团体"
    },
    {
      "ordinal": 14,
      "start_ms": 45510,
      "end_ms": 47160,
      "text": "发展到一定程度啊"
    },
    {
      "ordinal": 15,
      "start_ms": 47480,
      "end_ms": 49850,
      "text": "到一定程度啊"
    },
    {
      "ordinal": 16,
      "start_ms": 49850,
      "end_ms": 51380,
      "text": "自然不是强求的"
    },
    {
      "ordinal": 17,
      "start_ms": 51380,
      "end_ms": 52519,
      "text": "不是强求的"
    },
    {
      "ordinal": 18,
      "start_ms": 52840,
      "end_ms": 54430,
      "text": "不是不强求"
    },
    {
      "ordinal": 19,
      "start_ms": 54430,
      "end_ms": 59700,
      "text": "而是自然会有人过来要啊"
    },
    {
      "ordinal": 20,
      "start_ms": 60900,
      "end_ms": 61879,
      "text": "要这个"
    },
    {
      "ordinal": 21,
      "start_ms": 64819,
      "end_ms": 66100,
      "text": "要这个你啊"
    },
    {
      "ordinal": 22,
      "start_ms": 66100,
      "end_ms": 69100,
      "text": "要这个你提手旁就是要招安你了"
    },
    {
      "ordinal": 23,
      "start_ms": 70240,
      "end_ms": 72860,
      "text": "有想要让你去给他"
    },
    {
      "ordinal": 24,
      "start_ms": 73240,
      "end_ms": 75550,
      "text": "自然会有人这个不强求"
    },
    {
      "ordinal": 25,
      "start_ms": 75550,
      "end_ms": 76900,
      "text": "从不强求的"
    },
    {
      "ordinal": 26,
      "start_ms": 76900,
      "end_ms": 77740,
      "text": "这自然的"
    },
    {
      "ordinal": 27,
      "start_ms": 79000,
      "end_ms": 80880,
      "text": "那么有一个原则啊"
    },
    {
      "ordinal": 28,
      "start_ms": 80880,
      "end_ms": 81960,
      "text": "我们要讲的就对"
    },
    {
      "ordinal": 29,
      "start_ms": 81960,
      "end_ms": 86160,
      "text": "这这这类人物他可能有个什么身份啊"
    },
    {
      "ordinal": 30,
      "start_ms": 86160,
      "end_ms": 87600,
      "text": "或者有个什么圈子啊"
    },
    {
      "ordinal": 31,
      "start_ms": 87600,
      "end_ms": 89780,
      "text": "或者有高高在上的那种人跑过来"
    },
    {
      "ordinal": 32,
      "start_ms": 89780,
      "end_ms": 90800,
      "text": "有几个原则"
    },
    {
      "ordinal": 33,
      "start_ms": 90800,
      "end_ms": 97780,
      "text": "一要团体对团体啊"
    },
    {
      "ordinal": 34,
      "start_ms": 98520,
      "end_ms": 101960,
      "text": "这个公益团体公益团体啊"
    },
    {
      "ordinal": 35,
      "start_ms": 102980,
      "end_ms": 107150,
      "text": "也就是说要不私不私人秘密"
    },
    {
      "ordinal": 36,
      "start_ms": 107150,
      "end_ms": 109040,
      "text": "不私人秘密啊"
    },
    {
      "ordinal": 37,
      "start_ms": 109040,
      "end_ms": 110700,
      "text": "不私人秘密"
    },
    {
      "ordinal": 38,
      "start_ms": 112700,
      "end_ms": 113860,
      "text": "英语对话"
    },
    {
      "ordinal": 39,
      "start_ms": 113860,
      "end_ms": 118060,
      "text": "你这个公益团体的核心成员啊"
    },
    {
      "ordinal": 40,
      "start_ms": 118060,
      "end_ms": 120830,
      "text": "核心成员共同啊"
    },
    {
      "ordinal": 41,
      "start_ms": 122300,
      "end_ms": 123620,
      "text": "你有这个决策权的"
    },
    {
      "ordinal": 42,
      "start_ms": 123620,
      "end_ms": 126200,
      "text": "有决策权的核心成员"
    },
    {
      "ordinal": 43,
      "start_ms": 126200,
      "end_ms": 130860,
      "text": "共同对这一个要过来把你收编的那个团体"
    },
    {
      "ordinal": 44,
      "start_ms": 130979,
      "end_ms": 132449,
      "text": "团体对团体"
    },
    {
      "ordinal": 45,
      "start_ms": 132449,
      "end_ms": 133259,
      "text": "这是第一点"
    },
    {
      "ordinal": 46,
      "start_ms": 133259,
      "end_ms": 138240,
      "text": "第二点就是说原则上原则上是拒绝啊"
    },
    {
      "ordinal": 47,
      "start_ms": 140880,
      "end_ms": 142400,
      "text": "原来拒怎么拒绝呢"
    },
    {
      "ordinal": 48,
      "start_ms": 142400,
      "end_ms": 145670,
      "text": "那我们要讲这个怎么拒绝的一个方法"
    },
    {
      "ordinal": 49,
      "start_ms": 145670,
      "end_ms": 153549,
      "text": "就是说原则上拒绝拒绝的方法就是说名义啊"
    },
    {
      "ordinal": 50,
      "start_ms": 153549,
      "end_ms": 155079,
      "text": "名义独立嘛"
    },
    {
      "ordinal": 51,
      "start_ms": 155079,
      "end_ms": 157419,
      "text": "你可以玩玩这个把戏啊"
    },
    {
      "ordinal": 52,
      "start_ms": 157419,
      "end_ms": 160790,
      "text": "首先你就说我的名义未有独立民意"
    },
    {
      "ordinal": 53,
      "start_ms": 160790,
      "end_ms": 163010,
      "text": "未有独立民意"
    },
    {
      "ordinal": 54,
      "start_ms": 163010,
      "end_ms": 163850,
      "text": "我还没有"
    },
    {
      "ordinal": 55,
      "start_ms": 163850,
      "end_ms": 167000,
      "text": "就是说我的这个公益机构还没有注册好"
    },
    {
      "ordinal": 56,
      "start_ms": 167000,
      "end_ms": 169220,
      "text": "所以我先不谈"
    },
    {
      "ordinal": 57,
      "start_ms": 169220,
      "end_ms": 170330,
      "text": "如果没有的话"
    },
    {
      "ordinal": 58,
      "start_ms": 170330,
      "end_ms": 171260,
      "text": "先不谈"
    },
    {
      "ordinal": 59,
      "start_ms": 171640,
      "end_ms": 173620,
      "text": "那么这个民意有了的话"
    },
    {
      "ordinal": 60,
      "start_ms": 173620,
      "end_ms": 175610,
      "text": "有了这个独立民意的话"
    },
    {
      "ordinal": 61,
      "start_ms": 175610,
      "end_ms": 177590,
      "text": "有了独立明的话"
    },
    {
      "ordinal": 62,
      "start_ms": 177590,
      "end_ms": 180530,
      "text": "那就谈的时候就自然就不用谈"
    },
    {
      "ordinal": 63,
      "start_ms": 180530,
      "end_ms": 184099,
      "text": "这个自然就不会被吞并了啊"
    },
    {
      "ordinal": 64,
      "start_ms": 184099,
      "end_ms": 185059,
      "text": "不会被吞并了"
    },
    {
      "ordinal": 65,
      "start_ms": 185059,
      "end_ms": 187100,
      "text": "不会被吞并"
    },
    {
      "ordinal": 66,
      "start_ms": 187380,
      "end_ms": 189240,
      "text": "不会挂靠了"
    },
    {
      "ordinal": 67,
      "start_ms": 189240,
      "end_ms": 189960,
      "text": "懂吗"
    },
    {
      "ordinal": 68,
      "start_ms": 189960,
      "end_ms": 192600,
      "text": "就这一招对吧"
    },
    {
      "ordinal": 69,
      "start_ms": 192940,
      "end_ms": 194560,
      "text": "你可以无限拖"
    },
    {
      "ordinal": 70,
      "start_ms": 194560,
      "end_ms": 195280,
      "text": "你知道吗"
    },
    {
      "ordinal": 71,
      "start_ms": 195280,
      "end_ms": 196030,
      "text": "了解吧"
    },
    {
      "ordinal": 72,
      "start_ms": 196030,
      "end_ms": 197860,
      "text": "原则上是拒绝收编啊"
    },
    {
      "ordinal": 73,
      "start_ms": 197860,
      "end_ms": 199300,
      "text": "拒绝被招安的"
    },
    {
      "ordinal": 74,
      "start_ms": 199300,
      "end_ms": 200620,
      "text": "第三点"
    },
    {
      "ordinal": 75,
      "start_ms": 202459,
      "end_ms": 207640,
      "text": "但是原则上只要立场啊"
    },
    {
      "ordinal": 76,
      "start_ms": 207640,
      "end_ms": 209320,
      "text": "立场相近啊"
    },
    {
      "ordinal": 77,
      "start_ms": 209720,
      "end_ms": 212300,
      "text": "立场相近啊"
    },
    {
      "ordinal": 78,
      "start_ms": 212300,
      "end_ms": 217960,
      "text": "就这个立场相近指的就是说呃路线不同"
    },
    {
      "ordinal": 79,
      "start_ms": 217960,
      "end_ms": 219380,
      "text": "路线可以不同"
    },
    {
      "ordinal": 80,
      "start_ms": 219619,
      "end_ms": 222139,
      "text": "但这个路线路线不同的"
    },
    {
      "ordinal": 81,
      "start_ms": 222139,
      "end_ms": 223879,
      "text": "这个冲突不是一个原则冲突"
    },
    {
      "ordinal": 82,
      "start_ms": 223879,
      "end_ms": 225500,
      "text": "不是原则上的冲突"
    },
    {
      "ordinal": 83,
      "start_ms": 225660,
      "end_ms": 226500,
      "text": "也就是说"
    },
    {
      "ordinal": 84,
      "start_ms": 229710,
      "end_ms": 231300,
      "text": "不是原则上的冲突"
    },
    {
      "ordinal": 85,
      "start_ms": 231920,
      "end_ms": 234520,
      "text": "并非原则上冲突啊"
    },
    {
      "ordinal": 86,
      "start_ms": 234520,
      "end_ms": 238810,
      "text": "他不是那种搞地下密谋的那种啊啊路线不同"
    },
    {
      "ordinal": 87,
      "start_ms": 238810,
      "end_ms": 240800,
      "text": "但是理想相同"
    },
    {
      "ordinal": 88,
      "start_ms": 241160,
      "end_ms": 242690,
      "text": "理想相同"
    },
    {
      "ordinal": 89,
      "start_ms": 242690,
      "end_ms": 244820,
      "text": "也就是说他那个出发点不一样"
    },
    {
      "ordinal": 90,
      "start_ms": 244820,
      "end_ms": 245520,
      "text": "对不对"
    },
    {
      "ordinal": 91,
      "start_ms": 245780,
      "end_ms": 247400,
      "text": "出发点不同"
    },
    {
      "ordinal": 92,
      "start_ms": 247400,
      "end_ms": 249500,
      "text": "理想是相同的"
    },
    {
      "ordinal": 93,
      "start_ms": 249500,
      "end_ms": 253719,
      "text": "理想大家是总的来说是一致的"
    },
    {
      "ordinal": 94,
      "start_ms": 253719,
      "end_ms": 255159,
      "text": "那么这个立场相近"
    },
    {
      "ordinal": 95,
      "start_ms": 255159,
      "end_ms": 256719,
      "text": "在这个前提之下呢"
    },
    {
      "ordinal": 96,
      "start_ms": 256719,
      "end_ms": 262260,
      "text": "可以互通互通一些啊"
    },
    {
      "ordinal": 97,
      "start_ms": 262260,
      "end_ms": 266419,
      "text": "一些我讲了合法的可公开的啊"
    },
    {
      "ordinal": 98,
      "start_ms": 266419,
      "end_ms": 267859,
      "text": "合法的可公开"
    },
    {
      "ordinal": 99,
      "start_ms": 267859,
      "end_ms": 271200,
      "text": "但是你不一定向所有人可公开的情情报"
    },
    {
      "ordinal": 100,
      "start_ms": 272819,
      "end_ms": 274099,
      "text": "比如你在地的"
    },
    {
      "ordinal": 101,
      "start_ms": 274099,
      "end_ms": 276590,
      "text": "他想知道这里情况怎么样啊"
    },
    {
      "ordinal": 102,
      "start_ms": 276590,
      "end_ms": 280400,
      "text": "那有学生大致是个什么样的观点想法啊"
    },
    {
      "ordinal": 103,
      "start_ms": 280400,
      "end_ms": 282110,
      "text": "那边这个环卫工人呢"
    },
    {
      "ordinal": 104,
      "start_ms": 282110,
      "end_ms": 283880,
      "text": "他的这个待遇怎么怎么样"
    },
    {
      "ordinal": 105,
      "start_ms": 283880,
      "end_ms": 286600,
      "text": "合法公开的情报可以互通一些"
    },
    {
      "ordinal": 106,
      "start_ms": 287360,
      "end_ms": 288520,
      "text": "互通有好处啊"
    },
    {
      "ordinal": 107,
      "start_ms": 288520,
      "end_ms": 290050,
      "text": "你给他是在地情报"
    },
    {
      "ordinal": 108,
      "start_ms": 290050,
      "end_ms": 292030,
      "text": "你给他的是在地情报"
    },
    {
      "ordinal": 109,
      "start_ms": 292030,
      "end_ms": 297520,
      "text": "他给你的是一些就是上峰的上面的"
    },
    {
      "ordinal": 110,
      "start_ms": 297520,
      "end_ms": 299800,
      "text": "或者说秘密圈子里面的情报啊"
    },
    {
      "ordinal": 111,
      "start_ms": 299800,
      "end_ms": 302080,
      "text": "但是他是公开合法可公开的"
    },
    {
      "ordinal": 112,
      "start_ms": 302080,
      "end_ms": 304840,
      "text": "但他就愿意给我靠啊"
    },
    {
      "ordinal": 113,
      "start_ms": 304840,
      "end_ms": 305800,
      "text": "立场相近的话"
    },
    {
      "ordinal": 114,
      "start_ms": 305800,
      "end_ms": 306700,
      "text": "可以互动情报"
    },
    {
      "ordinal": 115,
      "start_ms": 306700,
      "end_ms": 312160,
      "text": "另外一方面欢迎要欢迎他介绍人才"
    },
    {
      "ordinal": 116,
      "start_ms": 312160,
      "end_ms": 314350,
      "text": "介绍人才过来啊"
    },
    {
      "ordinal": 117,
      "start_ms": 314350,
      "end_ms": 315820,
      "text": "到你这儿来"
    },
    {
      "ordinal": 118,
      "start_ms": 318319,
      "end_ms": 320319,
      "text": "哎你如果有青年才俊"
    },
    {
      "ordinal": 119,
      "start_ms": 320319,
      "end_ms": 321760,
      "text": "欢迎你来我这"
    },
    {
      "ordinal": 120,
      "start_ms": 322099,
      "end_ms": 324739,
      "text": "欢迎你来我这参加我这个活动"
    },
    {
      "ordinal": 121,
      "start_ms": 324739,
      "end_ms": 327260,
      "text": "但是不是不是指导我"
    },
    {
      "ordinal": 122,
      "start_ms": 327599,
      "end_ms": 329099,
      "text": "你是成为我的成员"
    },
    {
      "ordinal": 123,
      "start_ms": 329099,
      "end_ms": 332100,
      "text": "成为我的一部分啊"
    },
    {
      "ordinal": 124,
      "start_ms": 332100,
      "end_ms": 338980,
      "text": "要也就是这个是保持自己的独立性"
    },
    {
      "ordinal": 125,
      "start_ms": 338980,
      "end_ms": 344040,
      "text": "保持自己的这个啊主人翁地位啊"
    },
    {
      "ordinal": 126,
      "start_ms": 344040,
      "end_ms": 345180,
      "text": "我的玩法不变"
    },
    {
      "ordinal": 127,
      "start_ms": 345180,
      "end_ms": 346560,
      "text": "我的玩法不变啊"
    },
    {
      "ordinal": 128,
      "start_ms": 346560,
      "end_ms": 347520,
      "text": "玩法不变"
    },
    {
      "ordinal": 129,
      "start_ms": 347520,
      "end_ms": 349350,
      "text": "你要一起来玩"
    },
    {
      "ordinal": 130,
      "start_ms": 349350,
      "end_ms": 351100,
      "text": "我欢迎你来玩"
    },
    {
      "ordinal": 131,
      "start_ms": 352040,
      "end_ms": 354820,
      "text": "你要想知道这个玩法怎么玩"
    },
    {
      "ordinal": 132,
      "start_ms": 354820,
      "end_ms": 356080,
      "text": "我可以教你啊"
    },
    {
      "ordinal": 133,
      "start_ms": 356080,
      "end_ms": 365560,
      "text": "啊也可以就是说要积极的鼓励介绍介绍啊"
    },
    {
      "ordinal": 134,
      "start_ms": 365560,
      "end_ms": 368200,
      "text": "啊一个自己的公益路线"
    },
    {
      "ordinal": 135,
      "start_ms": 369280,
      "end_ms": 370380,
      "text": "公益经验"
