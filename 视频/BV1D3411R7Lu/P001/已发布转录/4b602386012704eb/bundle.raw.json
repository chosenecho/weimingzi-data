{"segments":[{"start":1.52,"end":5.64,"text":"我们要讲一个就是公益活动的直接的"},{"start":5.64,"end":8.85,"text":"公益活动的直接的革命意义啊"},{"start":8.85,"end":13.5,"text":"它的直接的直接的一个革命意义在于"},{"start":17.34,"end":20.36,"text":"它是一个直接夺取生产资料的一个活动"},{"start":20.36,"end":22.43,"text":"直接夺取生产资料"},{"start":22.43,"end":24.77,"text":"直接夺取生产资料"},{"start":24.77,"end":26.98,"text":"size the means of production"},{"start":27.099,"end":29.2,"text":"职业夺取生产资料"},{"start":29.439,"end":31.299,"text":"那么这个生产资料是最直接的"},{"start":31.299,"end":33.099,"text":"也是相对非常核心的"},{"start":33.099,"end":34.419,"text":"生产资料是什么"},{"start":35.76,"end":36.86,"text":"劳动者本身"},{"start":36.86,"end":39.44,"text":"工人本身的什么啊"},{"start":40.88,"end":41.779,"text":"体力"},{"start":43.78,"end":44.7,"text":"组织度"},{"start":47.76,"end":48.8,"text":"以及忠诚"},{"start":51.4,"end":52.79,"text":"请客吃饭"},{"start":52.79,"end":58.07,"text":"就是已经是在通过最直接最赤裸的方式夺取"},{"start":58.07,"end":59.03,"text":"为社会主义阵营"},{"start":59.03,"end":61.0,"text":"共产主义阵营夺取工人"},{"start":62.12,"end":64.239,"text":"因为社会因为资本主义生产"},{"start":64.239,"end":67.15,"text":"但是要把把工人异化成为生产资料了"},{"start":67.15,"end":70.03,"text":"你不可能把它作为一个直接的主人翁的"},{"start":70.03,"end":70.99,"text":"已经觉醒了的"},{"start":70.99,"end":72.07,"text":"有阶级意识的"},{"start":72.07,"end":74.66,"text":"有阶级解放性意志的工人"},{"start":74.66,"end":76.95,"text":"那样不可能"},{"start":76.95,"end":80.25,"text":"你首先是把它作为一种生产资料给争夺过来"},{"start":80.25,"end":84.4,"text":"要把它作为他的体力劳动啊"},{"start":84.4,"end":85.42,"text":"组织度和忠诚"},{"start":85.42,"end":89.98,"text":"这些东西本来都是用在为大工业机器"},{"start":89.98,"end":92.67,"text":"大工业生产服务的"},{"start":92.67,"end":94.86,"text":"是大工业生产当中生产资料"},{"start":95.24,"end":98.12,"text":"当然他不是经典意义上那种生产资料呢"},{"start":98.12,"end":102.14,"text":"他就是说劳动力本身一化成了生产资料"},{"start":102.14,"end":104.48,"text":"一化成了生产当中的材料"},{"start":106.42,"end":110.98,"text":"啊他的体力劳动组织度以及他的这个自我认同"},{"start":112.38,"end":113.75,"text":"自我认同"},{"start":113.75,"end":116.12,"text":"他就需要第二部啊"},{"start":116.12,"end":117.2,"text":"需要第二步"},{"start":117.2,"end":122.38,"text":"这个要需要这个劳动者反哺劳动者"},{"start":122.38,"end":123.94,"text":"这个反哺困难群众啊"},{"start":123.94,"end":125.38,"text":"反哺困难群众"},{"start":128.34,"end":133.579,"text":"劳动群众反哺困难群众过程当中啊"},{"start":133.579,"end":134.239,"text":"过程当中"},{"start":134.239,"end":137.06,"text":"劳动者自己获得他自己的啊"},{"start":137.06,"end":139.19,"text":"自我独立的自我认同啊"},{"start":139.19,"end":139.97,"text":"独立的自我认同"},{"start":139.97,"end":142.31,"text":"同时也认同与我们志愿者团队哈"},{"start":142.31,"end":143.36,"text":"志愿团队"},{"start":144.119,"end":147.52,"text":"公益团队啊"},{"start":150.779,"end":154.23,"text":"这个夺取他的体力劳动"},{"start":154.23,"end":155.82,"text":"这个不叫提了"},{"start":155.82,"end":157.2,"text":"这个甚至就不叫夺取了"},{"start":157.2,"end":160.74,"text":"甚至是夺取一个可以一个身体"},{"start":162.24,"end":166.88,"text":"这个身体是作为一个体力再生产的体力再生产"},{"start":166.88,"end":170.21,"text":"体力本身的再生产也就体力恢复的一个工具"},{"start":170.21,"end":172.59,"text":"身体可以使你的体力恢复"},{"start":172.59,"end":173.01,"text":"对不对"},{"start":173.01,"end":175.95,"text":"身体在这上它是个体力恢复的工具"},{"start":175.95,"end":177.09,"text":"我们把它暂时多"},{"start":177.09,"end":178.95,"text":"就你这个消化系统嘴巴了"},{"start":178.95,"end":179.73,"text":"请他吃饭"},{"start":179.73,"end":183.66,"text":"其实让它的消化系统嘴巴啊"},{"start":183.66,"end":184.74,"text":"它的消化系统"},{"start":184.74,"end":186.72,"text":"它的嘴巴把它勾取过来"},{"start":186.72,"end":187.74,"text":"让他吃我们的饭"},{"start":187.74,"end":188.85,"text":"免费吃我们的饭"},{"start":188.85,"end":194.499,"text":"恢复的体力变成我们施加于他的恩惠嘛啊"},{"start":194.499,"end":197.979,"text":"变成我们对他进行施加的一个笼络啊"},{"start":197.979,"end":201.6,"text":"这样把工人笼络团结过来"},{"start":202.499,"end":204.079,"text":"这个词带有贬义"},{"start":204.079,"end":204.499,"text":"whatever"},{"start":204.499,"end":205.279,"text":"我不管了"},{"start":205.279,"end":207.26,"text":"用词带有贬义不算什么"},{"start":207.26,"end":211.28,"text":"那么可以进一步引导他们去反哺困难群众"},{"start":211.28,"end":215.67,"text":"这个时候我们就把它的组织度也从大工业生产"},{"start":215.67,"end":217.35,"text":"被资本异化"},{"start":217.35,"end":220.519,"text":"大工业生产那边啊拯救出来"},{"start":220.519,"end":221.239,"text":"把他的忠诚"},{"sta