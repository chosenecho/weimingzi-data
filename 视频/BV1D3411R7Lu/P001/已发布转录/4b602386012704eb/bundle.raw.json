,{"start":311.18,"end":312.8,"text":"第一步不做不做"},{"start":312.8,"end":314.87,"text":"这第一步你怎么夺取生产资料"},{"start":314.87,"end":317.24,"text":"你凭什么多去凭借无政府主义者"},{"start":317.24,"end":318.18,"text":"平均一点点"},{"start":318.18,"end":320.82,"text":"知识分子密谋的恐怖主义的那种突袭的"},{"start":320.82,"end":322.42,"text":"怎么可能夺取生产资料"},{"start":322.42,"end":326.139,"text":"所以我们这一步叫多取多取者啊"},{"start":326.139,"end":328.059,"text":"这就是公益活动的他的"},{"start":328.059,"end":329.679,"text":"你要非要说它有革命意义"},{"start":329.679,"end":331.269,"text":"这是他革命意义好吧"},{"start":331.269,"end":332.06,"text":"就讲到这里"}],"source":"subtitle"}
