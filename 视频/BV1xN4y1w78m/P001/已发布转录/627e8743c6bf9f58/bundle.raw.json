{"segments":[{"start":0.12,"end":1.38,"text":"回复信件啊"},{"start":1.38,"end":5.31,"text":"说他是隐去敏感隐私"},{"start":5.31,"end":9.01,"text":"个人隐私啊啊可以就可以公开"},{"start":9.01,"end":13.44,"text":"把个人隐私保就是就是屏蔽就可以公开了啊"},{"start":13.819,"end":14.599,"text":"您好"},{"start":14.599,"end":15.619,"text":"我是一名大二学生"},{"start":15.619,"end":16.519,"text":"从去年寒假开始"},{"start":16.519,"end":17.239,"text":"因为某些原因"},{"start":17.239,"end":19.279,"text":"后面会提及和堂姐住在一起"},{"start":19.279,"end":22.99,"text":"写这封信是因为感到无法在同他一起生活"},{"start":22.99,"end":25.73,"text":"以及以后如何面对我的家庭"},{"start":25.73,"end":27.65,"text":"我前几年母亲去世后"},{"start":27.65,"end":28.91,"text":"一直跟着舅舅生活"},{"start":28.91,"end":31.07,"text":"而我的堂姐也就是我舅舅的女儿"},{"start":31.07,"end":35.03,"text":"去年中秋节从婆婆家从婆家逃回来之后"},{"start":35.03,"end":36.56,"text":"因为生活上的原因"},{"start":36.56,"end":38.42,"text":"不得不回到我舅身边"},{"start":38.42,"end":39.74,"text":"暂时和我们一起生活"},{"start":39.74,"end":43.7,"text":"我就对我堂姐的教育可以说是只有棍棒稍微不听话"},{"start":43.7,"end":45.04,"text":"就又打又踢"},{"start":45.2,"end":50.36,"text":"可能是因为这段过去导致他现在做人做事身上比较暴躁"},{"start":50.36,"end":52.58,"text":"在家里面说话就比较顶"},{"start":52.58,"end":54.08,"text":"好像要和你吵架似的"},{"start":54.08,"end":55.58,"text":"但到了外面又软弱起来"},{"start":55.58,"end":56.87,"text":"没有家里这么硬气"},{"start":56.87,"end":58.47,"text":"对人和和气气啊"},{"start":58.47,"end":59.85,"text":"后来我就离婚"},{"start":59.85,"end":60.75,"text":"因为债务原因"},{"start":60.75,"end":62.7,"text":"她跟着我舅妈那边生活"},{"start":62.7,"end":65.259,"text":"过的还是那种受欺负的生活"},{"start":65.26,"end":67.06,"text":"直到现在啊"},{"start":67.06,"end":70.08,"text":"如果回忆起过去的生活"},{"start":70.08,"end":71.97,"text":"他就会咒骂他的母亲"},{"start":71.97,"end":73.259,"text":"咒骂他妈"},{"start":75.72,"end":77.66,"text":"说他怎么还不死"},{"start":77.66,"end":78.35,"text":"这种话"},{"start":78.35,"end":81.78,"text":"巴不得以前说他的那些人赶紧去死"},{"start":81.78,"end":83.04,"text":"13年左右"},{"start":83.04,"end":84.78,"text":"经人介绍和别人结婚"},{"start":84.78,"end":86.52,"text":"当时他们几乎可以说闪婚"},{"start":86.52,"end":87.66,"text":"没认识多久就结婚了"},{"start":87.66,"end":91.71,"text":"据他自己说这么草率是因为对面老实条件比我们好"},{"start":93.87,"end":95.759,"text":"他不想跟他妈一块生活"},{"start":95.9,"end":98.66,"text":"不过他过去之后经常就是和婆家闹矛盾"},{"start":98.66,"end":99.86,"text":"那边说他脾气太差"},{"start":99.86,"end":102.26,"text":"他说那边老是逼她早点生小孩"},{"start":102.26,"end":103.16,"text":"给他压抑"},{"start":103.16,"end":105.54,"text":"后来2015年左右"},{"start":105.54,"end":106.32,"text":"外甥出生"},{"start":106.32,"end":108.59,"text":"他国家突然180度啊"},{"start":108.59,"end":110.51,"text":"态度180度大转变"},{"start":110.51,"end":111.71,"text":"把孙子当成宝一样"},{"start":111.71,"end":113.7,"text":"好像别人会偷了一样"},{"start":113.7,"end":118.67,"text":"印象最深的一件事是孩子出生那年春节想把她和孩子从婆家带回来"},{"start":118.67,"end":120.41,"text":"结果那边死活不肯"},{"start":120.41,"end":121.61,"text":"后来越闹越大"},{"start":121.61,"end":122.36,"text":"甚至报了警"},{"start":122.36,"end":124.91,"text":"春节过后几个月就带着孩子逃了"},{"start":124.91,"end":126.11,"text":"回来没和婆家说"},{"start":126.11,"end":127.46,"text":"18年正式离婚"},{"start":127.46,"end":130.139,"text":"刚回来的时候是住在我阿姨家"},{"start":133.579,"end":134.9,"text":"患上抑郁啊"},{"start":135.82,"end":136.74,"text":"换上抑郁症"},{"start":136.74,"end":138.42,"text":"这算不算个人隐私啊"},{"start":139.18,"end":140.1,"text":"他是个人隐私"},{"start":140.1,"end":142.14,"text":"应该是指的这个作作者本人啊"},{"start":142.14,"end":143.54,"text":"写信的人本人啊"},{"start":146.48,"end":148.18,"text":"好一段时间才调整过来"},{"start":148.18,"end":153.32,"text":"应该是这段时间影响它就很神智啊"},{"start":153.32,"end":155.22,"text":"神经啊就神经质啊"},{"start":155.359,"end":157.579,"text":"稍有不满就在背后咒骂他人"},{"start":157.579,"end":158.179,"text":"举个例子"},{"start":158.179,"end":161.739,"text":"前几天因为我舅呃说他桌子上太乱"},{"start":161.739,"end":162.579,"text":"说了几句"},{"start":162.579,"end":164.799,"text":"就从早上一直咒骂他爸"},{"start":164.799,"end":167.96,"text":"到睡觉睡觉没过几分钟就嘀咕几句"},{"start":167.96,"end":169.16,"text":"且越说越难听"},{"start":169.16,"end":173.219,"text":"离婚诉离婚之后啊"},{"start":173.219,"end":175.709,"text":"这个之后两个字写的像诉讼的数字"},{"start":175.709,"end":177.899,"text":"碍于生活压力又回去婆家"},{"start":177.899,"end":181.04,"text":"这是在我们其他人不知情的情况下"},{"start":181.04,"