  "segments": [
    {
      "ordinal": 0,
      "start_ms": 17040,
      "end_ms": 17640,
      "text": "你"
    },
    {
      "ordinal": 1,
      "start_ms": 22460,
      "end_ms": 27520,
      "text": "人夜半仍然害怕会失落"
    },
    {
      "ordinal": 2,
      "start_ms": 28140,
      "end_ms": 29360,
      "text": "要求助"
    },
    {
      "ordinal": 3,
      "start_ms": 29360,
      "end_ms": 32060,
      "text": "竟是我深爱"
    },
    {
      "ordinal": 4,
      "start_ms": 34560,
      "end_ms": 36170,
      "text": "心情感"
    },
    {
      "ordinal": 5,
      "start_ms": 36170,
      "end_ms": 39019,
      "text": "谁能像我更用心"
    },
    {
      "ordinal": 6,
      "start_ms": 39940,
      "end_ms": 42300,
      "text": "感觉冷或暖"
    },
    {
      "ordinal": 7,
      "start_ms": 42300,
      "end_ms": 45800,
      "text": "但最终也要为梦"
    },
    {
      "ordinal": 8,
      "start_ms": 45940,
      "end_ms": 48300,
      "text": "繁华渐散"
    },
    {
      "ordinal": 9,
      "start_ms": 48300,
      "end_ms": 51279,
      "text": "仍然踏进这街道"
    },
    {
      "ordinal": 10,
      "start_ms": 52420,
      "end_ms": 54450,
      "text": "过往的光景"
    },
    {
      "ordinal": 11,
      "start_ms": 54450,
      "end_ms": 56860,
      "text": "满路旁"
    },
    {
      "ordinal": 12,
      "start_ms": 58160,
      "end_ms": 63440,
      "text": "也许无知留连在这老地方"
    },
    {
      "ordinal": 13,
      "start_ms": 64619,
      "end_ms": 68600,
      "text": "清晨的深处不停望"
    },
    {
      "ordinal": 14,
      "start_ms": 73220,
      "end_ms": 75640,
      "text": "相识至交"
    },
    {
      "ordinal": 15,
      "start_ms": 75640,
      "end_ms": 78800,
      "text": "笑拥当天的我"
    },
    {
      "ordinal": 16,
      "start_ms": 79420,
      "end_ms": 81750,
      "text": "每次随心"
    },
    {
      "ordinal": 17,
      "start_ms": 81750,
      "end_ms": 87950,
      "text": "竟不发觉为何爱过恨过"
    },
    {
      "ordinal": 18,
      "start_ms": 87950,
      "end_ms": 90759,
      "text": "亦笑过骂过"
    },
    {
      "ordinal": 19,
      "start_ms": 91080,
      "end_ms": 95960,
      "text": "但一生相处的不太多"
    },
    {
      "ordinal": 20,
      "start_ms": 97600,
      "end_ms": 103300,
      "text": "回头路远途人夜半更疏落"
    },
    {
      "ordinal": 21,
      "start_ms": 104080,
      "end_ms": 108100,
      "text": "远去的灯影已渐黄"
    },
    {
      "ordinal": 22,
      "start_ms": 109760,
      "end_ms": 113740,
      "text": "求转前身流上望边"
    },
    {
      "ordinal": 23,
      "start_ms": 113740,
      "end_ms": 119320,
      "text": "这地方回头的一刹皆寥"
    },
    {
      "ordinal": 24,
      "start_ms": 146279,
      "end_ms": 152240,
      "text": "繁华之心仍愿踏进这街道"
    },
    {
      "ordinal": 25,
      "start_ms": 152719,
      "end_ms": 156819,
      "text": "过往的光景满路旁"
    },
    {
      "ordinal": 26,
      "start_ms": 158439,
      "end_ms": 166939,
      "text": "也许无知留连在这老地方前尘的深处"
    },
    {
      "ordinal": 27,
      "start_ms": 166939,
      "end_ms": 169399,
      "text": "不停望"
    },
    {
      "ordinal": 28,
      "start_ms": 173559,
      "end_ms": 175439,
      "text": "相识至交"
    },
    {
      "ordinal": 29,
      "start_ms": 176459,
      "end_ms": 178840,
      "text": "笑拥当天的我"
    },
    {
      "ordinal": 30,
      "start_ms": 179679,
      "end_ms": 182159,
      "text": "我去次最深"
    },
    {
      "ordinal": 31,
      "start_ms": 182159,
      "end_ms": 188210,
      "text": "竟不发觉为何爱过恨过"
    },
    {
      "ordinal": 32,
      "start_ms": 188210,
      "end_ms": 190100,
      "text": "亦笑过"
    },
    {
      "ordinal": 33,
      "start_ms": 190100,
      "end_ms": 191080,
      "text": "骂过"
    },
    {
      "ordinal": 34,
      "start_ms": 191359,
      "end_ms": 196080,
      "text": "但一生相处的不太多"
    },
    {
      "ordinal": 35,
      "start_ms": 197899,
      "end_ms": 203300,
      "text": "回头路远途人夜半更疏落"
    },
    {
      "ordinal": 36,
      "start_ms": 204420,
      "end_ms": 207640,
      "text": "远去的灯影已渐黄"
    },
    {
      "ordinal": 37,
      "start_ms": 210140,
      "end_ms": 213460,
      "text": "陪你短情深留神"
    },
    {
      "ordinal": 38,
      "start_ms": 213460,
      "end_ms": 215420,
      "text": "望遍这地方"
    },
    {
      "ordinal": 39,
      "start_ms": 216580,
      "end_ms": 220080,
      "text": "回头的一刹皆寥落"
    },
    {
      "ordinal": 40,
      "start_ms": 222320,
      "end_ms": 224650,
      "text": "戏短情深"
    },
    {
      "ordinal": 41,
      "start_ms": 224650,
      "end_ms": 227600,
      "text": "留神望遍这地方"
    },
    {
      "ordinal": 42,
      "start_ms": 228880,
      "end_ms": 231480,
      "text": "尘缘的光景"
    },
    {
      "ordinal": 43,
      "start_ms": 231999,
      "end_ms": 235660,
      "text": "曾为梦"
    },
    {
      "ordinal": 44,
      "start_ms": 239320,
      "end_ms": 239880,
      "text": "啊"
    }
  ],
  "text": "你\n人夜半仍然害怕会失落\n要求助\n竟是我深爱\n心情感\n谁能像我更用心\n感觉冷或暖\n但最终也要为梦\n繁华渐散\n仍然踏进这街道\n过往的光景\n满路旁\n也许无知留连在这老地方\n清晨的深处不停望\n相识至交\n笑拥当天的我\n每次随心\n竟不发觉为何爱过恨过\n亦笑过骂过\n但一生相处的不太多\n回头路远途人夜半更疏落\n远去的灯影已渐黄\n求转前身流上望边\n这地方回头的一刹皆寥\n繁华之心仍愿踏进这街道\n过往的光景满路旁\n也许无知留连在这老地方前尘的深处\n不停望\n相识至交\n笑拥当天的我\n我去次最深\n竟不发觉为何爱过恨过\n亦笑过\n骂过\n但一生相处的不太多\n回头路远途人夜半更疏落\n远去的灯影已渐黄\n陪你短情深留神\n望遍这地方\n回头的一刹皆寥落\n戏短情深\n留神望遍这地方\n尘缘的光景\n曾为梦\n啊",
