  "content_sha256": "4f81cf39698e7db2ddf96af77dc40e185476a1770efbe08985683a90a6061408",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 32000,
      "end_ms": 34960,
      "text": "尘缘如梦，几番起伏总不平。"
    },
    {
      "ordinal": 1,
      "start_ms": 36240,
      "end_ms": 39520,
      "text": "到如今都成烟云，"
    },
    {
      "ordinal": 2,
      "start_ms": 42400,
      "end_ms": 49440,
      "text": "情也成空，宛如挥手袖底风。"
    },
    {
      "ordinal": 3,
      "start_ms": 49440,
      "end_ms": 54240,
      "text": "悠悠一缕香，飘在深深旧梦中。"
    },
    {
      "ordinal": 4,
      "start_ms": 55760,
      "end_ms": 61440,
      "text": "繁华落尽，一身憔悴在风里。"
    },
    {
      "ordinal": 5,
      "start_ms": 62800,
      "end_ms": 66320,
      "text": "回头是无情也无语，"
    },
    {
      "ordinal": 6,
      "start_ms": 69040,
      "end_ms": 74080,
      "text": "明月小楼，孤独故人诉情衷。"
    },
    {
      "ordinal": 7,
      "start_ms": 76080,
      "end_ms": 79040,
      "text": "人间有我残梦未醒，"
    },
    {
      "ordinal": 8,
      "start_ms": 85600,
      "end_ms": 91440,
      "text": "漫漫长路起伏不能由我。"
    },
    {
      "ordinal": 9,
      "start_ms": 92240,
      "end_ms": 97920,
      "text": "人海漂泊，尝尽人情淡薄。"
    },
    {
      "ordinal": 10,
      "start_ms": 98880,
      "end_ms": 109040,
      "text": "热情热心换冷淡冷漠，任多少深情独向寂寞。"
    },
    {
      "ordinal": 11,
      "start_ms": 111520,
      "end_ms": 118000,
      "text": "怕人春风过，自在花开花又落。"
    },
    {
      "ordinal": 12,
      "start_ms": 119200,
      "end_ms": 122160,
      "text": "不管世间沧桑如何，"
    },
    {
      "ordinal": 13,
      "start_ms": 125520,
      "end_ms": 131280,
      "text": "一城风絮，满腹相思都沉默。"
    },
    {
      "ordinal": 14,
      "start_ms": 131696,
      "end_ms": 135440,
      "text": "只有桂花香寒飘过。"
    },
    {
      "ordinal": 15,
      "start_ms": 166080,
      "end_ms": 174240,
      "text": "不管世间沧桑如何，只有桂花香寒飘过。"
    },
    {
      "ordinal": 16,
      "start_ms": 189382,
      "end_ms": 194342,
      "text": "漫漫长路，起伏不能由我。"
    },
    {
      "ordinal": 17,
      "start_ms": 195142,
      "end_ms": 200982,
      "text": "人海漂泊，尝尽人情淡薄。"
    },
    {
      "ordinal": 18,
      "start_ms": 201782,
      "end_ms": 214502,
      "text": "热情热心换冷淡冷漠，人多少深情独向寂寞。"
    },
    {
      "ordinal": 19,
      "start_ms": 214502,
      "end_ms": 220902,
      "text": "啊，人生漂泊，自在花开花又落。"
    },
    {
      "ordinal": 20,
      "start_ms": 222182,
      "end_ms": 224982,
      "text": "不管世间沧桑如何，"
    },
    {
      "ordinal": 21,
      "start_ms": 228422,
      "end_ms": 234182,
      "text": "一阵风去，满腹相思都沉默。"
    },
    {
      "ordinal": 22,
      "start_ms": 235382,
      "end_ms": 250902,
      "text": "只有桂花香飘过，只有桂花香飘过。"
    }
  ],
  "text": "尘缘如梦，几番起伏总不平。\n到如今都成烟云，\n情也成空，宛如挥手袖底风。\n悠悠一缕香，飘在深深旧梦中。\n繁华落尽，一身憔悴在风里。\n回头是无情也无语，\n明月小楼，孤独故人诉情衷。\n人间有我残梦未醒，\n漫漫长路起伏不能由我。\n人海漂泊，尝尽人情淡薄。\n热情热心换冷淡冷漠，任多少深情独向寂寞。\n怕人春风过，自在花开花又落。\n不管世间沧桑如何，\n一城风絮，满腹相思都沉默。\n只有桂花香寒飘过。\n不管世间沧桑如何，只有桂花香寒飘过。\n漫漫长路，起伏不能由我。\n人海漂泊，尝尽人情淡薄。\n热情热心换冷淡冷漠，人多少深情独向寂寞。\n啊，人生漂泊，自在花开花又落。\n不管世间沧桑如何，\n一阵风去，满腹相思都沉默。\n只有桂花香飘过，只有桂花香飘过。",
