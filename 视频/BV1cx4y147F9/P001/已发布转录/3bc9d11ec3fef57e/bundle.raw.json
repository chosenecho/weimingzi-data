{"segments":[{"start":1.2,"end":2.92,"text":"这个玩意在落后地区多呀"},{"start":2.92,"end":5.12,"text":"当然在落后地区多啊"},{"start":5.12,"end":8.06,"text":"因为那个金钱关系会打"},{"start":8.06,"end":10.42,"text":"会天然的会消融掉这个东西"},{"start":10.42,"end":11.68,"text":"可交易性嘛"},{"start":11.68,"end":14.34,"text":"资本增值就是货币"},{"start":14.34,"end":18.44,"text":"会抢夺这个人格化的神圣神圣载体"},{"start":18.44,"end":23.56,"text":"它上面的神圣性货币是物神"},{"start":23.92,"end":25.42,"text":"货币是物神"},{"start":25.42,"end":27.44,"text":"然后每一个小富人"},{"start":27.44,"end":31.06,"text":"每一个有钱的富人都会分有这个物神的神性"},{"start":31.06,"end":34.4,"text":"那么这个东西呢就让他的神经症得到疏解了"},{"start":34.4,"end":35.56,"text":"缓解了"},{"start":35.56,"end":37.019,"text":"实事求是讲"},{"start":37.019,"end":40.179,"text":"就是让这这对货币崇拜"},{"start":40.179,"end":43.839,"text":"然后呃物的交易得来的这些享乐"},{"start":43.839,"end":46.32,"text":"实际上会让人能够"},{"start":46.32,"end":51.3,"text":"从那个瞄准一个人格化的载体的那种神性崇拜"},{"start":51.3,"end":52.52,"text":"人格神的崇拜"},{"start":52.52,"end":56.059,"text":"当中能够疏解出来对吧"},{"start":56.059,"end":58.819,"text":"就是就是崇拜偶像的化身"},{"start":58.819,"end":61.019,"text":"而不是崇拜偶像本身"},{"start":62.66,"end":64.18,"text":"明白吧"},{"start":67.56,"end":69.66,"text":"稍微就是只要钱流起来"},{"start":69.66,"end":71.74,"text":"就是货币现金流起来"},{"start":71.74,"end":73.8,"text":"这个东西就能够得到制衡"},{"start":75.2,"end":76.51,"text":"得到制衡"},{"start":80.54,"end":82.3,"text":"这个是天然压制这个东西"},{"start":82.3,"end":85.08,"text":"但是从神经神经生理学层面"},{"start":85.08,"end":86.18,"text":"天然压制的东西"},{"start":86.18,"end":88.06,"text":"压制这个东西的"},{"start":98.72,"end":99.88,"text":"经济发达地区"},{"start":99.88,"end":102.16,"text":"当然它会所谓经济发达地区"},{"start":102.16,"end":103.92,"text":"肯定有它的前现代部分嘛"},{"start":103.92,"end":106.6,"text":"现代发达地区村庄里面农产品"},{"start":106.6,"end":110.42,"text":"或者说他那个呃底层的宗族关系"},{"start":110.42,"end":114.65,"text":"它劳动力生产机制里面肯定有人身依附关系啊"},{"start":114.65,"end":116.19,"text":"你不可能说一整个地区"},{"start":116.19,"end":117.21,"text":"完全就是说"},{"start":117.21,"end":121.46,"text":"或者说家族内部也会有这个血亲关系"},{"start":121.46,"end":124.3,"text":"父父性崇拜都有的"},{"start":124.59,"end":127.19,"text":"你不会跟你爸爸完全都讲钱的逻辑吧"},{"start":128.389,"end":130.47,"text":"这是相互纠缠的"},{"start":130.47,"end":131.39,"text":"你中有我"},{"start":131.39,"end":133.11,"text":"我中有你"},{"start":134.12,"end":137.2,"text":"你可大大概可以把这个理解成黑色素啊"},{"start":137.2,"end":138.52,"text":"就是资本主义的逻辑"},{"start":138.52,"end":140.88,"text":"现代性像黑色素一样啊"},{"start":140.88,"end":142.36,"text":"黑色素一样"},{"start":143.849,"end":146.489,"text":"他越能够就是分散在一个区域"},{"start":146.489,"end":148.129,"text":"这个区域就越黑嘛"},{"start":148.129,"end":153.99,"text":"它集中起来在一个就是就是比如说古代呃"},{"start":153.99,"end":154.85,"text":"资本主义逻辑"},{"start":154.85,"end":155.93,"text":"或者说现代的逻辑"},{"start":160.369,"end":162.709,"text":"就是权力交易或者金钱交易"},{"start":162.709,"end":164.97,"text":"或者这种是什么情报交易"},{"start":164.97,"end":168.19,"text":"那么整个这个封邦啊"},{"start":168.19,"end":171.75,"text":"整个这个邦国他这一看就是白色的嘛"},{"start":171.75,"end":174.45,"text":"但因为它黑色素集中在一起就一点点一个"},{"start":174.45,"end":176.25,"text":"你你看看他就是整个白的"},{"start":176.25,"end":178.83,"text":"那整个这个这个国家就是个前现代"},{"start":178.83,"end":179.31,"text":"对不对"},{"start":179.31,"end":181.48,"text":"这个邦国就是一个前现代"},{"start":181.48,"end":182.24,"text":"是不是"},{"start":182.24,"end":183.9,"text":"但是如果说这个逻辑"},{"start":183.9,"end":186.97,"text":"权力斗争逻辑或者说符号交换"},{"start":186.97,"end":188.63,"text":"代币交换的一个逻辑"},{"start":188.63,"end":189.98,"text":"它散开来了"},{"start":189.98,"end":191.78,"text":"他在每一个小城镇里面都有"},{"start":191.78,"end":195.26,"text":"每一个每一个这个小小家族里面都有"},{"start":195.26,"end":196.98,"text":"或者甚至说他在每一个村庄"},{"start":196.98,"end":201.849,"text":"每一个甚至一个家庭是每个人的那个呃"},{"start":201.849,"end":204.989,"text":"和父母打交道的那种基本行为模式当中"},{"start":204.989,"end":206.579,"text":"都有一个交易性的逻辑"},{"start":206.579,"end":208.859,"text":"利用交易的一个逻辑"},{"start":208.859,"end":211.35,"text":"就是微观权力斗争的小逻辑"},{"start":211.35,"end":213.35,"text":"那一看就是黑乎乎的嘛"},{"start":213.35,"end":215.63,"text":"就像黑色素它分散开来的"},{"start":215.63,"end":216.83,"text":"没有聚到一块去"},{"start":216.83,"end":218.99,"text":"那这个这个省份或者这个国家"},{"start":218.