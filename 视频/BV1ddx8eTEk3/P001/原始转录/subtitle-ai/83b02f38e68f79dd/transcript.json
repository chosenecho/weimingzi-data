    },
    {
      "ordinal": 107,
      "start_ms": 224170,
      "end_ms": 225750,
      "text": "然后晚上又是卖饮料"
    },
    {
      "ordinal": 108,
      "start_ms": 225750,
      "end_ms": 229260,
      "text": "就是呃解梦大会就就是坐在那边"
    },
    {
      "ordinal": 109,
      "start_ms": 229260,
      "end_ms": 233250,
      "text": "就是大家吃完了之后聊天漫无目的嘛"
