      "text": "就是可能就是会张振武或者谁往那一坐"
    },
    {
      "ordinal": 111,
      "start_ms": 237060,
      "end_ms": 237660,
      "text": "你过来"
    },
    {
      "ordinal": 112,
      "start_ms": 237660,
      "end_ms": 238340,
      "text": "我来给你解个梦"
    },
    {
      "ordinal": 113,
      "start_ms": 238340,
      "end_ms": 239620,
      "text": "你过来我给你解个梦是吧"
    },
    {
      "ordinal": 114,
      "start_ms": 239620,
