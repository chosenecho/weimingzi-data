    {
      "ordinal": 85,
      "start_ms": 183780,
      "end_ms": 184360,
      "text": "瞎编一个"
    },
    {
      "ordinal": 86,
      "start_ms": 184360,
      "end_ms": 186020,
      "text": "因为他每天要凑三个活动"
    },
    {
      "ordinal": 87,
      "start_ms": 186020,
