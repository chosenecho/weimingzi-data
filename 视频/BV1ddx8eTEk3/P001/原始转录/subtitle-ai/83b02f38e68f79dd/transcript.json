    {
      "ordinal": 99,
      "start_ms": 208930,
      "end_ms": 211840,
      "text": "然后呃卖饮料喝十块钱一杯"
    },
    {
      "ordinal": 100,
      "start_ms": 211840,
      "end_ms": 212800,
      "text": "卖饮料又是卖饮料"
    },
    {
      "ordinal": 101,
      "start_ms": 212800,
      "end_ms": 214400,
      "text": "说穿了这个活动也是卖饮料"
