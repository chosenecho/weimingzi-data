      "text": "一边吃"
    },
    {
      "ordinal": 55,
      "start_ms": 127279,
      "end_ms": 129439,
      "text": "你可以一边就是说学做厨艺啊"
    },
    {
      "ordinal": 56,
      "start_ms": 129439,
      "end_ms": 129979,
      "text": "做菜"
    },
    {
      "ordinal": 57,
      "start_ms": 129979,
      "end_ms": 132179,
      "text": "还有一个是创意摄影啊"
    },
    {
      "ordinal": 58,
      "start_ms": 132179,
      "end_ms": 133910,
      "text": "创意摄影"
    },
    {
      "ordinal": 59,
      "start_ms": 134270,
      "end_ms": 137110,
      "text": "帮一个帮里面男孩子拍"
    },
    {
      "ordinal": 60,
      "start_ms": 137110,
      "end_ms": 140100,
      "text": "拍一整张那个一整套照片啊"
    },
    {
      "ordinal": 61,
      "start_ms": 140100,
      "end_ms": 141380,
      "text": "那个是收费项目"
    },
    {
      "ordinal": 62,
      "start_ms": 141380,
      "end_ms": 142360,
      "text": "这是收费项目"
    },
    {
      "ordinal": 63,
      "start_ms": 142360,
      "end_ms": 143380,
      "text": "这个是收费的"
    },
    {
      "ordinal": 64,
      "start_ms": 143380,
      "end_ms": 144460,
      "text": "这50块钱一个人啊"
    },
    {
      "ordinal": 65,
      "start_ms": 144460,
      "end_ms": 145680,
      "text": "收费的啊"
