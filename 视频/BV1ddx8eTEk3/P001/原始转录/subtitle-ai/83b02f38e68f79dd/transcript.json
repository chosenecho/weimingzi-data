    {
      "ordinal": 80,
      "start_ms": 176239,
      "end_ms": 177619,
      "text": "就是给他们供应饮料"
    },
    {
      "ordinal": 81,
      "start_ms": 177619,
      "end_ms": 179279,
      "text": "让他们坐在上面那聊天"
    },
    {
      "ordinal": 82,
      "start_ms": 179279,
      "end_ms": 180559,
      "text": "他可以买饮料喝"
