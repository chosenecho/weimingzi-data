      "ordinal": 93,
      "start_ms": 198500,
      "end_ms": 199340,
      "text": "我也不知道是哪个地方"
    },
    {
      "ordinal": 94,
      "start_ms": 199340,
      "end_ms": 201420,
      "text": "然后还有一个观影会"
