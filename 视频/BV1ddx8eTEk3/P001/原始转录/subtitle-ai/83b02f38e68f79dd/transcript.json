    },
    {
      "ordinal": 68,
      "start_ms": 152440,
      "end_ms": 154840,
      "text": "然后那个不知道要不要修图啊"
    },
    {
      "ordinal": 69,
      "start_ms": 154840,
      "end_ms": 156160,
      "text": "PS我不知道他要不要修啊"
    },
    {
      "ordinal": 70,
      "start_ms": 156160,
      "end_ms": 157900,
      "text": "还有一个茶话会"
    },
    {
      "ordinal": 71,
      "start_ms": 157900,
      "end_ms": 159080,
