{"segments":[{"start":4.88,"end":9.14,"text":"很多愚昧者落后者啊"},{"start":9.14,"end":11.18,"text":"并且还善于诋毁者"},{"start":12.3,"end":15.379,"text":"然后呢不甚了解的情况之下"},{"start":15.379,"end":18.479,"text":"就加以对我们加以攻击的这些人啊"},{"start":18.479,"end":24.16,"text":"我们采取的主要策略是利用他们嗯"},{"start":24.16,"end":26.42,"text":"善于利用他们"},{"start":26.82,"end":29.52,"text":"反复利用他们"},{"start":33.38,"end":35.08,"text":"为他们提供帮助"},{"start":35.08,"end":39.38,"text":"让他们来呃以为在攻击诋毁我们"},{"start":39.38,"end":40.86,"text":"从而利用他们"},{"start":40.86,"end":44.84,"text":"促进他们的某种存在形态"},{"start":44.84,"end":46.47,"text":"来利用他们"},{"start":46.47,"end":49.33,"text":"利用它们干什么来赋予我们啊"},{"start":49.33,"end":53.88,"text":"来增加我们存在的这个安全性呢"},{"start":53.88,"end":57.54,"text":"以增加我们存在的这个更广泛的"},{"start":57.54,"end":60.34,"text":"更大公众的一个观感"},{"start":60.74,"end":61.94,"text":"那么首要的是"},{"start":61.94,"end":67.2,"text":"我认为我不在意这些人所呃呃一面之词"},{"start":67.2,"end":72.66,"text":"以偏概全的去呃动摇的或者欺骗的那些愚笨的"},{"start":72.66,"end":73.92,"text":"落后的"},{"start":73.92,"end":75.6,"text":"没有觉悟的"},{"start":75.6,"end":77.28,"text":"缺乏能力的"},{"start":77.28,"end":80.02,"text":"然后善于被欺骗的"},{"start":80.02,"end":81.09,"text":"哼哼啊"},{"start":81.09,"end":82.37,"text":"很容易被欺骗的"},{"start":82.37,"end":83.61,"text":"善于去欺骗"},{"start":83.61,"end":86.939,"text":"也善于希希望拥抱一些肤浅的东西"},{"start":86.939,"end":88.599,"text":"来进行自我欺骗的那些人"},{"start":88.599,"end":89.379,"text":"对这些人呢"},{"start":89.379,"end":93.32,"text":"其实我没有任何征兆和动员的意义意图"},{"start":93.32,"end":96.44,"text":"你这些人都是残次品"},{"start":97.44,"end":100.34,"text":"然后都是拖后腿的"},{"start":100.34,"end":101.9,"text":"在这个上讲"},{"start":101.9,"end":110.519,"text":"革命的实用主义要求我们呃坚定冷酷以及狡猾"},{"start":110.519,"end":112.94,"text":"并且呢"},{"start":113.62,"end":116.04,"text":"呼并且善于庆幸啊"},{"start":116.04,"end":118.7,"text":"喜欢使我其实挺庆幸的"},{"start":118.7,"end":120.14,"text":"有这些愚昧的"},{"start":120.14,"end":124.19,"text":"这个落后的和这无知的和本身是善妒的"},{"start":124.19,"end":125.71,"text":"没有行动能力的"},{"start":125.71,"end":128.41,"text":"也没有一个行动意愿的"},{"start":128.41,"end":133.32,"text":"这些人的存在"},{"start":134.08,"end":135.66,"text":"我不知道他们在思考什么"},{"start":135.66,"end":140.4,"text":"我也不确定他们到底在以什么形态生存着"},{"start":140.4,"end":145.5,"text":"他们好像他们好像从来不需要考虑那些东西"},{"start":145.5,"end":146.9,"text":"那我就给我"},{"start":146.9,"end":149.68,"text":"我记得我之前给什么童童润中"},{"start":149.68,"end":151.71,"text":"他有一个什么对话"},{"start":151.71,"end":153.41,"text":"聊天记录里面"},{"start":153.41,"end":155.5,"text":"他就后来就发出来的"},{"start":155.5,"end":160.16,"text":"他们思考似乎从来都不需要去思考"},{"start":160.16,"end":164.72,"text":"现实性的东西以及思考实现的过程"},{"start":164.72,"end":166.78,"text":"他们就要去思考"},{"start":166.78,"end":168.59,"text":"嗯哼哼"},{"start":168.59,"end":170.51,"text":"你们这都都不需要去思考"},{"start":170.51,"end":173.55,"text":"只需要去提出看似正确的"},{"start":173.55,"end":177.25,"text":"刻舟求剑的那些早已经是腐朽的"},{"start":177.25,"end":182.4,"text":"早已经是这个被福尔马林和"},{"start":182.4,"end":186.26,"text":"反正是被这些东西浸泡过的那些玩意啊"},{"start":190.14,"end":191.42,"text":"过时的严重"},{"start":191.42,"end":192.709,"text":"过时了的"},{"start":192.709,"end":197.5,"text":"严重脱离现实的严重就是"},{"start":199.42,"end":201.66,"text":"有些东西我不想说什么啊"},{"start":201.66,"end":203.18,"text":"我不想说什么"},{"start":203.18,"end":210.23,"text":"就是说你们都说我玩实体娃娃对不对"},{"start":210.23,"end":213.03,"text":"而不去什么追求真正的女人"},{"start":213.03,"end":216.1,"text":"那我觉得这些人就在在这个上讲"},{"start":216.1,"end":218.98,"text":"我觉得他们就是把革命这件事情"},{"start":218.98,"end":222.7,"text":"或者说把呃思索革命理论这件事情"},{"start":222.7,"end":224.78,"text":"就和玩实体娃娃"},{"start":224.78,"end":227.3,"text":"或者说是看实体娃娃"},{"start":227.3,"end":233.269,"text":"论坛的那些刺激的这个图片一个性质"},{"start":233.269,"end":237.19,"text":"而不是去追求真正的女人啊"},{"start":237.19,"end":238.59,"text":"而不是追求真正女人"},{"start":238.59,"end":240.55,"text":"如果我们把用这个比喻的话"},{"start":240.55,"end":246.48,"text":"我们就是说呃工团主义的躁动相当于打野啊"},{"start":246.48,"end":248.76,"text":"相当于这个PC啊"},{"start":253.55,"end":258.0,"text":"活动家呢他就是追求长久的呃情感啊"},{"start":258.0,"end":260.8,"text":"忠于他的爱情一样来忠于革命"},{"start":260.8,"end":268.06,"text":"并且是因为他那卡斯特罗就是像卡斯特罗"},{"start":268.06,"end":271.