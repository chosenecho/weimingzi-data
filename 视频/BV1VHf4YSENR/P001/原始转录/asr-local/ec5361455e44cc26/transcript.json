  "content_sha256": "ec5361455e44cc26e2400d3c520ea0c0faf60b88593ef9e7f83c4ea0e7a5e3f7",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 640,
      "end_ms": 10720,
      "text": "我写了一首词啊，填了一首词是呃以前写的一部分，但是魔改了，大改了，然后用余辅给它补足啊。"
    },
    {
      "ordinal": 1,
      "start_ms": 42080,
      "end_ms": 47680,
      "text": "银河所依，随晚云，放浓影。"
    },
    {
      "ordinal": 2,
      "start_ms": 48960,
      "end_ms": 54480,
      "text": "雨云若近，今几乎无人行。"
    },
    {
      "ordinal": 3,
      "start_ms": 55680,
      "end_ms": 61120,
      "text": "天远犹飞，家四海，负万情。"
    },
    {
      "ordinal": 4,
      "start_ms": 62560,
      "end_ms": 68800,
      "text": "光冷如霜，温如妆，面如凝。"
    },
    {
      "ordinal": 5,
      "start_ms": 71040,
      "end_ms": 76320,
      "text": "心无影，亦无情，欲寄苍冥。"
    },
    {
      "ordinal": 6,
      "start_ms": 77600,
      "end_ms": 83200,
      "text": "无天无雨无飞鸿，无可尽。"
    },
    {
      "ordinal": 7,
      "start_ms": 84560,
      "end_ms": 90400,
      "text": "心无情，亦为风月花鸟捉。"
    },
    {
      "ordinal": 8,
      "start_ms": 90880,
      "end_ms": 99680,
      "text": "凌波不可托，求索索，珠落水最多。"
    },
    {
      "ordinal": 9,
      "start_ms": 101840,
      "end_ms": 107920,
      "text": "水浊兮，沧浪可以濯吾足。"
    },
    {
      "ordinal": 10,
      "start_ms": 108480,
      "end_ms": 113120,
      "text": "婉而摩娑，顾一而去。"
    },
    {
      "ordinal": 11,
      "start_ms": 115680,
      "end_ms": 121440,
      "text": "水若清，沧浪可以濯吾缨。"
    },
    {
      "ordinal": 12,
      "start_ms": 122080,
      "end_ms": 127680,
      "text": "世人皆醉，岂可以人独醒？"
    },
    {
      "ordinal": 13,
      "start_ms": 127680,
      "end_ms": 163820,
      "text": "银河所依，随晚云，放浓影。"
    },
    {
      "ordinal": 14,
      "start_ms": 164560,
      "end_ms": 169120,
      "text": "雨云若近，今几乎无人行。"
    },
    {
      "ordinal": 15,
      "start_ms": 170640,
      "end_ms": 175520,
      "text": "天远犹飞，家四海，负万情。"
    },
    {
      "ordinal": 16,
      "start_ms": 178080,
      "end_ms": 181120,
      "text": "光冷如霜，温如妆。"
    },
    {
      "ordinal": 17,
      "start_ms": 181764,
      "end_ms": 187524,
      "text": "面如凝，唯心无"
    },
    {
      "ordinal": 18,
      "start_ms": 189124,
      "end_ms": 191284,
      "text": "影，一壶晴雨寄苍溟。"
    },
    {
      "ordinal": 19,
      "start_ms": 192644,
      "end_ms": 198244,
      "text": "无天无雨无飞鸿，无可尽。"
    },
    {
      "ordinal": 20,
      "start_ms": 199764,
      "end_ms": 205364,
      "text": "心无情，一味风月花鸟浊。"
    },
    {
      "ordinal": 21,
      "start_ms": 205844,
      "end_ms": 216804,
      "text": "林波不可托，秋索索，竹落水最多。"
    },
    {
      "ordinal": 22,
      "start_ms": 216884,
      "end_ms": 222964,
      "text": "水浊兮，沧浪可以濯吾足。"
    },
    {
      "ordinal": 23,
      "start_ms": 223284,
      "end_ms": 228324,
      "text": "蝉蜕浊灰，复有尘埃。"
    },
    {
      "ordinal": 24,
      "start_ms": 230564,
      "end_ms": 236404,
      "text": "水若清，沧浪可以濯吾缨。"
    },
    {
      "ordinal": 25,
      "start_ms": 236964,
      "end_ms": 245444,
      "text": "鹤目鸿飞，寄托晴雨苍溟。"
    },
    {
      "ordinal": 26,
      "start_ms": 247284,
      "end_ms": 255764,
      "text": "沧浪可以濯吾足，婉而默索古意而去。"
    },
    {
      "ordinal": 27,
      "start_ms": 255764,
      "end_ms": 262964,
      "text": "水若清，沧浪可以濯吾缨。"
    },
    {
      "ordinal": 28,
      "start_ms": 264404,
      "end_ms": 270164,
      "text": "举世皆醉，岂可无人独醒？"
    },
    {
      "ordinal": 29,
      "start_ms": 270484,
      "end_ms": 292644,
      "text": "好吧，就这个，把以前写的，我记得应该是有原词的啊，就是上面这些东西，可能是有原来写了一首小词，然后给它扩展成上面这一片。"
    },
    {
      "ordinal": 30,
      "start_ms": 293444,
      "end_ms": 301204,
      "text": "本来这里的是个是星星的星，后来改成了这个内心的星啊，因为外物太多了，了解主观的意象。"
    },
    {
      "ordinal": 31,
      "start_ms": 302004,
      "end_ms": 304964,
      "text": "然后后面这个，啊，把这个"
    },
    {
      "ordinal": 32,
      "start_ms": 306484,
      "end_ms": 322404,
      "text": "渔府里面的古意而去的歌给它啊加到里面去，然后这里还有这个司马迁，这个是扬雄的词啊，啊，还有这些东西啊，反正混杂在一块儿啊，听个响，好吧。"
    }
  ],
  "text": "我写了一首词啊，填了一首词是呃以前写的一部分，但是魔改了，大改了，然后用余辅给它补足啊。\n银河所依，随晚云，放浓影。\n雨云若近，今几乎无人行。\n天远犹飞，家四海，负万情。\n光冷如霜，温如妆，面如凝。\n心无影，亦无情，欲寄苍冥。\n无天无雨无飞鸿，无可尽。\n心无情，亦为风月花鸟捉。\n凌波不可托，求索索，珠落水最多。\n水浊兮，沧浪可以濯吾足。\n婉而摩娑，顾一而去。\n水若清，沧浪可以濯吾缨。\n世人皆醉，岂可以人独醒？\n银河所依，随晚云，放浓影。\n雨云若近，今几乎无人行。\n天远犹飞，家四海，负万情。\n光冷如霜，温如妆。\n面如凝，唯心无\n影，一壶晴雨寄苍溟。\n无天无雨无飞鸿，无可尽。\n心无情，一味风月花鸟浊。\n林波不可托，秋索索，竹落水最多。\n水浊兮，沧浪可以濯吾足。\n蝉蜕浊灰，复有尘埃。\n水若清，沧浪可以濯吾缨。\n鹤目鸿飞，寄托晴雨苍溟。\n沧浪可以濯吾足，婉而默索古意而去。\n水若清，沧浪可以濯吾缨。\n举世皆醉，岂可无人独醒？\n好吧，就这个，把以前写的，我记得应该是有原词的啊，就是上面这些东西，可能是有原来写了一首小词，然后给它扩展成上面这一片。\n本来这里的是个是星星的星，后来改成了这个内心的星啊，因为外物太多了，了解主观的意象。\n然后后面这个，啊，把这个\n渔府里面的古意而去的歌给它啊加到里面去，然后这里还有这个司马迁，这个是扬雄的词啊，啊，还有这些东西啊，反正混杂在一块儿啊，听个响，好吧。",
