{"segments":[{"start":0.68,"end":5.91,"text":"它来自我们最近的某个城市的啊"},{"start":5.91,"end":8.4,"text":"一个大一学生啊"},{"start":8.4,"end":13.23,"text":"高考失利被调剂了4年之后"},{"start":15.12,"end":17.42,"text":"他现在大一"},{"start":19.0,"end":21.96,"text":"他他就说他这个专业不太好"},{"start":21.96,"end":24.56,"text":"他就害怕进场就被裁员啊"},{"start":25.02,"end":27.74,"text":"即便有一份稳定的工作"},{"start":27.74,"end":29.3,"text":"也难在沿海城市"},{"start":29.3,"end":30.91,"text":"东南沿海城市立足啊"},{"start":30.91,"end":31.93,"text":"然后三条路"},{"start":31.93,"end":35.44,"text":"一个是努力目前方向考插班生"},{"start":35.44,"end":38.38,"text":"去另外一个那"},{"start":41.5,"end":45.73,"text":"去另外一个机械制造专业啊"},{"start":45.73,"end":50.35,"text":"或者说去另外一个微电子专业进修啊"},{"start":50.35,"end":52.99,"text":"然后考不上也可以积累经验"},{"start":52.99,"end":54.61,"text":"就考研了"},{"start":54.61,"end":58.25,"text":"争取更多机会哦"},{"start":58.25,"end":59.93,"text":"这个考插班生是什么意思啊"},{"start":59.93,"end":61.16,"text":"我不知道啊"},{"start":61.16,"end":63.17,"text":"不同学校之间可以跨考的吗"},{"start":63.17,"end":70.39,"text":"然后第二个就是转入本校的一个计科专业"},{"start":70.39,"end":72.58,"text":"但是它意味着没办法回老家"},{"start":72.58,"end":74.95,"text":"只能去回去的话只能进体制"},{"start":74.95,"end":76.42,"text":"但是他也不想回去"},{"start":76.42,"end":80.44,"text":"第三条就是说在本校本专业学习"},{"start":80.44,"end":83.2,"text":"他认为读研是必要的"},{"start":83.2,"end":84.25,"text":"不管怎么样"},{"start":84.25,"end":86.74,"text":"为了在这里他都要读研啊"},{"start":86.74,"end":89.089,"text":"为了能在东南沿海嗯"},{"start":89.089,"end":92.789,"text":"他一定要读研或至少掌握一项专业技能"},{"start":92.789,"end":94.319,"text":"他要发挥主体性"},{"start":94.319,"end":96.389,"text":"就不能被过去和未来推着走"},{"start":96.389,"end":99.089,"text":"他隐约感觉到过去和未来"},{"start":99.089,"end":101.19,"text":"像现在收拾的越来越紧了啊"},{"start":101.19,"end":103.41,"text":"同感现在大家都是这样感觉的啊"},{"start":104.49,"end":107.49,"text":"你要在未来走向哪个方向"},{"start":107.49,"end":109.36,"text":"占据哪个位置"},{"start":109.36,"end":117.44,"text":"或者说能够很幸运的人可以可以划出某个路线"},{"start":117.44,"end":122.39,"text":"再伟大的人可以拓宽出一个图景"},{"start":125.06,"end":127.39,"text":"这都是现在就是要决定的"},{"start":127.39,"end":130.69,"text":"每一个当下每个瞬间都在做决定的"},{"start":130.69,"end":133.36,"text":"要是想要做些事情的人"},{"start":133.36,"end":136.2,"text":"都都有同感啊"},{"start":136.2,"end":139.86,"text":"然而这个学业上的困难我有信心克服"},{"start":139.86,"end":142.34,"text":"但生活中却有莫大阻碍"},{"start":142.34,"end":145.46,"text":"小时候逆来顺受的生活和创创伤经历"},{"start":145.46,"end":147.02,"text":"造成了我敏感的性格"},{"start":147.02,"end":149.149,"text":"一件小事就会放大锐化"},{"start":149.149,"end":152.0,"text":"从不擅长为人处事"},{"start":152.0,"end":155.96,"text":"然后高中时他这个善良的善也写错了啊"},{"start":155.96,"end":159.25,"text":"他写了个提手旁加个善良的善"},{"start":159.47,"end":161.47,"text":"他应该写擅权的善"},{"start":161.47,"end":162.1,"text":"对不对"},{"start":162.1,"end":166.58,"text":"所以说他会写错的话"},{"start":166.58,"end":169.54,"text":"也是觉得他他就是他把这种不擅长"},{"start":169.54,"end":170.98,"text":"看成是一种善良啊"},{"start":170.98,"end":172.12,"text":"提手旁加个善"},{"start":172.12,"end":173.98,"text":"他他觉得擅长为人处世"},{"start":173.98,"end":176.07,"text":"就是会操作"},{"start":176.07,"end":178.5,"text":"道得一提啊"},{"start":178.6,"end":179.58,"text":"提手旁嘛"},{"start":179.58,"end":181.56,"text":"操纵善善恶"},{"start":181.56,"end":184.959,"text":"操操纵这个别人对他评价"},{"start":184.959,"end":187.599,"text":"操纵一个道德伦理评价标准"},{"start":187.599,"end":188.499,"text":"他不想操纵他"},{"start":188.499,"end":189.279,"text":"他想做好人"},{"start":189.279,"end":190.029,"text":"做善人"},{"start":190.029,"end":192.14,"text":"他不写那个善权的善"},{"start":192.14,"end":193.52,"text":"善于的善"},{"start":193.52,"end":195.74,"text":"那你的问题就在于你应当知道"},{"start":195.74,"end":198.38,"text":"为人处世就是个技术问题"},{"start":198.38,"end":203.77,"text":"善于提手旁加一个那个檀香山檀的一半"},{"start":203.77,"end":204.46,"text":"对不对"},{"start":204.46,"end":209.235,"text":"檀月点横回日一"},{"start":210.54,"end":211.16,"text":"有意思"},{"start":211.16,"end":212.12,"text":"这是个技术问题"},{"start":212.12,"end":213.44,"text":"练就是了"},{"start":213.44,"end":215.96,"text":"小时候没机会练嘛"},{"start":215.96,"end":219.0,"text":"长大练多练一练嘛"},{"start":219.67,"end":221.42,"text":"讲感情嘛"},{"start":221.42,"end":224.42,"text":"有的时候就是说这不是讲道德的"},{"start":224.42,"end":225.71,"text":"讲人情的"},{"start":225.71,"end":228.14,"text":"然后高中时也就很少数几个朋友来往"},{"start":228.14,"end":230.43,"text":"现实中一直是原子化的状态"},{"start":230.43,"end":232.68,"text":"然后宿舍是按省份分的"},{"start":232.68,"end":234.03,"text":"两个室友分别来自"},{"start":234.03,"end":235.11,"text":"反正都来自西北了"},{"start":235.11,"end":236.96,"text":"还有一个来自西南的"},{"start":236.96,"end":238.34,"text":"都是无产阶级家庭的"},{"start":238.34,"end":239.33,"text":"家庭条件一般"},{"start":239.33,"end":240.74,"text":"地方教育落后"},{"start":240.74,"end":242.82,"text":"他们素养不像高中毕业的"},{"start":242.82,"end":244.74,"text":"从原生家庭走出后"},{"start":244.74,"end":247.13,"text":"对金钱和男权物质进行迷恋"},{"start":247.13,"end":249.53,"text":"生活卫生环境习惯极差啊"},{"start":249.53,"end":251.87,"text":"这几个室友对未来没有丝毫规划"},{"start":251.87,"end":252.83,"text":"没有基本礼貌"},{"start":252.83,"end":253.94,"text":"凭喜好做事"},{"start":253.94,"end":256.7,"text":"天天叫外卖或者楼下自动贩卖机"},{"start":256.7,"end":257.45,"text":"买泡面"},{"start":257.45,"end":258.38,"text":"饭盒的垃圾"},{"start":258.38,"end":259.459,"text":"不往宿舍外拿"},{"start":259.459,"end":261.839,"text":"周末一天打17个小时游戏"},{"start":261.839,"end":262.8,"text":"衣服不怎么洗"},{"start":262.8,"end":264.57,"text":"最关键的是手机上打游戏"},{"start":264.57,"end":265.77,"text":"电脑上刷视频"},{"start":265.77,"end":267.44,"text":"并和别人聊天"},{"start":267.44,"end":268.64,"text":"三件事同一时间进行"},{"start":268.64,"end":269.54,"text":"这也是个本事啊"},{"start":269.54,"end":271.64,"text":"他到时候这些人到流水线上会是好手"},{"start":271.64,"end":275.77,"text":"卧槽哎哈哈哈"},{"start":275.77,"end":278.56,"text":"这个舍友每天下课就回宿舍打游戏"},{"start":278.56,"end":281.01,"text":"声音外放到嗯最大"},{"start":281.01,"end":281.85,"text":"和别人聊天"},{"start":281.85,"end":283.02,"text":"打游戏大吼大叫"},{"start":283.02,"end":286.309,"text":"另两个舍友也联机或进行其他娱乐"},{"start":286.309,"end":290.269,"text":"他然后这个信主呢说我一天很少在宿舍呆"},{"start":290.269,"end":292.489,"text":"晚上十点左右不得不回宿舍"},{"start":292.489,"end":293.96,"text":"周末除上课之外"},{"start":293.96,"end":295.22,"text":"有些时候只能呆在宿舍"},{"start":295.22,"end":296.06,"text":"我跟他们说过"},{"start":296.06,"end":297.98,"text":"每次都只是把声音调小一点点"},{"start":297.98,"end":299.15,"text":"甚至有些不耐烦"},{"start":299.15,"end":301.28,"text":"耳塞耳罩作用比较有限"},{"start":301.28,"end":303.109,"text":"超糟糕的宿舍环境"},{"start":303.109,"end":304.849,"text":"严重影响了我的作息和心态"},{"start":304.849,"end":308.49,"text":"那这些人是失败人口啊"},{"start":308.65,"end":309.66,"text":"不仅如此"},{"start":309.66,"end":311.67,"text":"为了考插班生而争取更多分数"},{"start":311.67,"end":313.65,"text":"需要和其他人组队做课题"},{"start":313.65,"end":316.35,"text":"我舍友自然是没有丝毫积极性别的"},{"start":316.35,"end":318.16,"text":"小组也常去呃"},{"start":318.16,"end":319.3,"text":"出现满员的情况"},{"start":319.3,"end":321.31,"text":"有向辅导员说明的意向"},{"start":321.31,"end":323.86,"text":"但担心辅导员会因为与自身利益无关"},{"start":323.86,"end":324.909,"text":"而敷衍了事"},{"start":324.909,"end":326.649,"text":"最后我的处境更加不堪"},{"start":326.649,"end":328.509,"text":"我想请教怎样看待舍友"},{"start":328.509,"end":329.229,"text":"和他们交流"},{"start":329.229,"end":331.46,"text":"宿舍问题应该怎样处理"},{"start":331.8,"end":334.52,"text":"然后说我还处于单纯的否定中"},{"start":334.52,"end":338.0,"text":"缺乏对产生出我的个体的符号系统的反思"},{"start":338.0,"end":340.4,"text":"自身也无法中介调和很多矛盾"},{"start":340.4,"end":341.0,"text":"心理敏感"},{"start":341.0,"end":342.23,"text":"没有轻度强迫症"},{"start":342.23,"end":344.52,"text":"也不愿意重演高州的悲剧"},{"start":344.52,"end":345.18,"text":"悲剧啊"},{"start":345.18,"end":347.85,"text":"在现实的维度上是否应该降低敏感性"},{"start":347.85,"end":349.38,"text":"怎么降低敏感性啊"},{"start":349.38,"end":351.48,"text":"用那个什么药啊"},{"start":351.58,"end":353.58,"text":"哇那个什么头上抹一抹"},{"start":355.95,"end":357.99,"text":"即便会丧失一些观察力"},{"start":357.99,"end":359.91,"text":"应该怎样接受现实中的矛盾"},{"start":359.91,"end":360.99,"text":"让他们不再锐化"},{"start":360.99,"end":364.06,"text":"应该我应该如何行动"},{"start":366.1,"end":367.62,"text":"然后反比冗长"},{"start":367.62,"end":368.34,"text":"请见谅"},{"start":368.34,"end":369.78,"text":"恳请给一些建议"},{"start":369.78,"end":372.24,"text":"这些室友三个室友"},{"start":372.52,"end":373.74,"text":"两个舍友"},{"start":373.74,"end":374.16,"text":"两个舍友"},{"start":374.16,"end":374.82,"text":"不是三个舍友"},{"start":374.82,"end":376.14,"text":"两个舍友哦不对"},{"st