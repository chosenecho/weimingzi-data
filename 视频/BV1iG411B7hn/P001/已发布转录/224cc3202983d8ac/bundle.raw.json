,{"start":991.66,"end":993.53,"text":"你就失去了其他参数"},{"start":993.53,"end":994.37,"text":"对不对"},{"start":994.37,"end":995.48,"text":"为人处事"},{"start":995.48,"end":998.57,"text":"你有本事先和你这三个舍友先打打好交道"},{"start":998.57,"end":1000.24,"text":"你在职场"},{"start":1000.24,"end":1003.12,"text":"资产阶级资本主义职场里面要获得所谓的成功"},{"start":1003.12,"end":1004.74,"text":"光是你有个硕士文凭"},{"start":1004.74,"end":1007.11,"text":"但是的不会和别人打交道"},{"start":1007.11,"end":1008.94,"text":"也是垃圾一坨"},{"start":1008.94,"end":1012.37,"text":"实事求是讲对啊"},{"start":1012.37,"end":1016.0,"text":"我有很多我没有没有读研的朋友"},{"start":1016.0,"end":1018.49,"text":"寝室友甚至说他们混的比我好啊"},{"start":1018.49,"end":1021.13,"text":"但现在一个月67万块钱工资"},{"start":1021.13,"end":1023.68,"text":"他们也也过着日子"},{"start":1024.5,"end":1027.76,"text":"我是单从小资产阶级"},{"start":1027.76,"end":1031.449,"text":"资产阶级的职场的角度来评价啊"},{"start":1031.449,"end":1032.409,"text":"我没有说其他"},{"start":1032.409,"end":1036.009,"text":"因为你这个戏里面也没有说你要你有那个想法"},{"start":1036.009,"end":1038.049,"text":"要过我们这种社会主义者的生活"},{"start":1038.049,"end":1038.829,"text":"你也没有这样说"},{"start":1038.829,"end":1039.72,"text":"对不对"},{"start":1039.72,"end":1043.94,"text":"刚刚一个想靠他妈什么信性多元主义"},{"start":1043.94,"end":1044.9,"text":"跨性别身份"},{"start":1044.9,"end":1047.42,"text":"要在我面前摆老资格的装逼的那家伙"},{"start":1047.42,"end":1050.07,"text":"还写个什么declaration给我看"},{"start":1050.07,"end":1051.21,"text":"你"},{"start":1051.21,"end":1053.16,"text":"被我海喷一口"},{"start":1053.16,"end":1055.26,"text":"当然你更不要说你不想过那种生活"},{"start":1058.53,"end":1061.08,"text":"你只是想小3年级往上跑"},{"start":1061.08,"end":1062.82,"text":"那我我的建议就说了"},{"start":1062.82,"end":1063.76,"text":"我说穿了"},{"start":1063.76,"end":1066.7,"text":"要获得后面的职业生涯的成功"},{"start":1066.7,"end":1068.71,"text":"和获得应试上的加分"},{"start":1068.71,"end":1071.48,"text":"学历上的加分不是一码事儿"},{"start":1071.48,"end":1072.98,"text":"绝对不是一码事"},{"start":1072.98,"end":1074.84,"text":"你作为一个没有跟脚的人"},{"start":1074.84,"end":1076.26,"text":"想要有跟脚"},{"start":1076.26,"end":1077.67,"text":"这是一个变化"},{"start":1077.67,"end":1079.49,"text":"有跟脚不是说你有了什么"},{"start":1079.49,"end":1081.71,"text":"有了什么硕士的学位"},{"start":1081.71,"end":1082.55,"text":"有了师门"},{"start":1082.55,"end":1083.63,"text":"有的同学关系"},{"start":1083.63,"end":1085.25,"text":"有了哪些企业的入场券"},{"start":1085.25,"end":1086.03,"text":"就是有跟脚的"},{"start":1086.03,"end":1087.67,"text":"不一定是有跟脚"},{"start":1087.67,"end":1088.93,"text":"你可能用一辈子"},{"start":1088.93,"end":1090.31,"text":"你还是个无根的小兵"},{"start":1090.31,"end":1092.07,"text":"小卒子"},{"start":1092.07,"end":1094.44,"text":"要自己要好好算一算啊"},{"start":1094.44,"end":1096.03,"text":"自己要好好算一算"},{"start":1096.03,"end":1097.53,"text":"要去多了解了解"},{"start":1097.53,"end":1100.94,"text":"所以我的建议反倒认为是"},{"start":1101.96,"end":1106.6,"text":"周末去找个实习学以致用"},{"start":1106.6,"end":1108.73,"text":"你学的够多了"},{"start":1108.73,"end":1110.71,"text":"先去找个实习学以致用"},{"start":1110.71,"end":1112.57,"text":"在生产劳动过程当中"},{"start":1112.57,"end":1113.89,"text":"激发你的创造力"},{"start":1113.89,"end":1115.31,"text":"激发你的智力"},{"start":1115.31,"end":1117.38,"text":"击败你进一步探索的欲望"},{"start":1117.38,"end":1119.15,"text":"这些知识应该去拥抱它"},{"start":1119.15,"end":1121.77,"text":"而不是去背负他"},{"start":1122.05,"end":1123.75,"text":"否则你会很痛苦"},{"start":1123.75,"end":1125.31,"text":"就算读研了"},{"start":1125.31,"end":1126.87,"text":"你熬不住跳楼自杀的"},{"start":1126.87,"end":1127.74,"text":"你懂吗"},{"start":1127.74,"end":1129.99,"text":"是不是"},{"start":1131.34,"end":1131.96,"text":"好吧"},{"start":1131.96,"end":1133.28,"text":"那下一个下一个"},{"start":1133.28,"end":1135.14,"text":"所以我建议你周末实在寝室里待不下"},{"start":1135.14,"end":1138.19,"text":"去找工作嗯"},{"start":1138.19,"end":1140.68,"text":"去找一些跟你学的东西还是有关系"},{"start":1140.68,"end":1141.7,"text":"找工作"}],"source":"subtitle"}
