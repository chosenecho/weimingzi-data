{
  "bvid": "BV1c8411E7ac",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "7403c2990aed1dfd28d7112258e468882afb0883b73031c2d79dc62e05f35e6a",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 240,
      "end_ms": 3380,
      "text": "我们讲一个就是说行动的关键"
    },
    {
      "ordinal": 1,
      "start_ms": 7780,
      "end_ms": 9020,
      "text": "我在于"
    },
    {
      "ordinal": 2,
      "start_ms": 12659,
      "end_ms": 14320,
      "text": "帮助工人"
    },
    {
      "ordinal": 3,
      "start_ms": 17199,
      "end_ms": 19799,
      "text": "啊群众关键不在于帮助"
    },
    {
      "ordinal": 4,
      "start_ms": 19799,
      "end_ms": 23839,
      "text": "而在于让工人"
    },
    {
      "ordinal": 5,
      "start_ms": 25939,
      "end_ms": 29260,
      "text": "帮助帮助工人"
    },
    {
      "ordinal": 6,
      "start_ms": 30820,
      "end_ms": 31840,
      "text": "这是行动的关键"
    },
    {
      "ordinal": 7,
      "start_ms": 33400,
      "end_ms": 38420,
      "text": "而且而且他不能只就是说帮助的"
    },
    {
      "ordinal": 8,
      "start_ms": 38420,
      "end_ms": 40960,
      "text": "而且他就在于帮助别人"
    },
    {
      "ordinal": 9,
      "start_ms": 40960,
      "end_ms": 41500,
      "text": "你知道吗"
    },
    {
      "ordinal": 10,
      "start_ms": 41500,
      "end_ms": 42400,
      "text": "要帮助别人"
    },
    {
      "ordinal": 11,
      "start_ms": 42400,
      "end_ms": 44440,
      "text": "这个别人的范围越大"
    },
    {
      "ordinal": 12,
      "start_ms": 46340,
      "end_ms": 47339,
      "text": "越大"
    },
    {
      "ordinal": 13,
      "start_ms": 48940,
      "end_ms": 51210,
      "text": "这个工人才意识到他是主人"
    },
    {
      "ordinal": 14,
      "start_ms": 51210,
      "end_ms": 52820,
      "text": "他自己是主人"
    },
    {
      "ordinal": 15,
      "start_ms": 55820,
      "end_ms": 57040,
      "text": "还行吧"
    },
    {
      "ordinal": 16,
      "start_ms": 57040,
      "end_ms": 61519,
      "text": "就最最低的是帮自己"
    },
    {
      "ordinal": 17,
      "start_ms": 63000,
      "end_ms": 64340,
      "text": "帮自己本人"
    },
    {
      "ordinal": 18,
      "start_ms": 65360,
      "end_ms": 67460,
      "text": "然后其次就是帮家庭"
    },
    {
      "ordinal": 19,
      "start_ms": 69300,
      "end_ms": 70880,
      "text": "再高一点呢"
    },
    {
      "ordinal": 20,
      "start_ms": 70880,
      "end_ms": 74060,
      "text": "帮这个同厂的工友"
    },
    {
      "ordinal": 21,
      "start_ms": 74420,
      "end_ms": 75860,
      "text": "同场的"
    },
    {
      "ordinal": 22,
      "start_ms": 75860,
      "end_ms": 76940,
      "text": "再高一点呢"
    },
    {
      "ordinal": 23,
      "start_ms": 76940,
      "end_ms": 78880,
      "text": "是帮同行的"
    },
    {
      "ordinal": 24,
      "start_ms": 79100,
      "end_ms": 81200,
      "text": "你不要逗得要死"
    },
    {
      "ordinal": 25,
      "start_ms": 81640,
      "end_ms": 86500,
      "text": "再高一点呢啊帮穷苦人"
    },
    {
      "ordinal": 26,
      "start_ms": 88560,
      "end_ms": 89940,
      "text": "再高一点"
    },
    {
      "ordinal": 27,
      "start_ms": 90100,
      "end_ms": 94360,
      "text": "帮全社会去做一些全社会想要去做的事情"
    },
    {
      "ordinal": 28,
      "start_ms": 94360,
      "end_ms": 98220,
      "text": "推动全社会的一个社会形态的发生一个变化"
    },
    {
      "ordinal": 29,
      "start_ms": 99200,
      "end_ms": 103000,
      "text": "社会的根本秩序去成就它"
    },
    {
      "ordinal": 30,
      "start_ms": 103000,
      "end_ms": 103540,
      "text": "实现它"
    },
    {
      "ordinal": 31,
      "start_ms": 103540,
      "end_ms": 104420,
      "text": "维持它"
    },
    {
      "ordinal": 32,
      "start_ms": 108720,
      "end_ms": 113800,
      "text": "那么我要就讲的就是说直接帮到"
    },
    {
      "ordinal": 33,
      "start_ms": 113800,
      "end_ms": 115480,
      "text": "直接帮工人"
    },
    {
      "ordinal": 34,
      "start_ms": 115480,
      "end_ms": 116410,
      "text": "帮1000"
    },
    {
      "ordinal": 35,
      "start_ms": 116410,
      "end_ms": 118140,
      "text": "帮1万这个东西呢"
    },
    {
      "ordinal": 36,
      "start_ms": 118940,
      "end_ms": 120340,
      "text": "无论你怎么帮"
    },
    {
      "ordinal": 37,
      "start_ms": 120340,
      "end_ms": 123420,
      "text": "其实真正的关键的意义不在于此"
    },
    {
      "ordinal": 38,
      "start_ms": 123860,
      "end_ms": 131839,
      "text": "而是最重重要的是要让他知道他可以帮别人啊"
    },
    {
      "ordinal": 39,
      "start_ms": 133039,
      "end_ms": 135600,
      "text": "要让工人变成一个帮助人的人"
    },
    {
      "ordinal": 40,
      "start_ms": 136200,
      "end_ms": 141000,
      "text": "要让工人变变成一个会帮助人的人"
    },
    {
      "ordinal": 41,
      "start_ms": 142119,
      "end_ms": 143819,
      "text": "会管闲事的人"
    },
    {
      "ordinal": 42,
      "start_ms": 143819,
      "end_ms": 145560,
      "text": "愿意去管闲事的人"
    },
    {
      "ordinal": 43,
      "start_ms": 146399,
      "end_ms": 148399,
      "text": "本来把它叫做管闲事"
    },
    {
      "ordinal": 44,
      "start_ms": 148399,
      "end_ms": 150379,
      "text": "那实际上不是管闲事就管一切"
    },
    {
      "ordinal": 45,
      "start_ms": 150379,
      "end_ms": 153680,
      "text": "管闲事的人也就成为主人"
    },
    {
      "ordinal": 46,
      "start_ms": 155480,
      "end_ms": 157870,
      "text": "本来在对他来说是闲事"
    },
    {
      "ordinal": 47,
      "start_ms": 157870,
      "end_ms": 159760,
      "text": "现在就不再是闲事了"
    },
    {
      "ordinal": 48,
      "start_ms": 159760,
      "end_ms": 161520,
      "text": "那么要做到这一点呢"
    },
    {
      "ordinal": 49,
      "start_ms": 162519,
      "end_ms": 165360,
      "text": "就是要激发劳动者的"
    },
    {
      "ordinal": 50,
      "start_ms": 166300,
      "end_ms": 172640,
      "text": "激发劳动者的这个主人翁的观念"
    },
    {
      "ordinal": 51,
      "start_ms": 175240,
      "end_ms": 177760,
      "text": "激发劳动者主人翁观念"
    },
    {
      "ordinal": 52,
      "start_ms": 180580,
      "end_ms": 184110,
      "text": "这个东西这个工作啊"
    },
    {
      "ordinal": 53,
      "start_ms": 184110,
      "end_ms": 188119,
      "text": "我们的路径就是先做公益啊"
    },
    {
      "ordinal": 54,
      "start_ms": 188119,
      "end_ms": 189409,
      "text": "先做公益"
    },
    {
      "ordinal": 55,
      "start_ms": 189409,
      "end_ms": 194479,
      "text": "先来为劳动者提供好处"
    },
    {
      "ordinal": 56,
      "start_ms": 194479,
      "end_ms": 198019,
      "text": "就是你享受这个天经地义的塑造"
    },
    {
      "ordinal": 57,
      "start_ms": 198019,
      "end_ms": 199640,
      "text": "一种天经地义"
    },
    {
      "ordinal": 58,
      "start_ms": 200779,
      "end_ms": 203379,
      "text": "你就可以获得这些好处"
    },
    {
      "ordinal": 59,
      "start_ms": 203379,
      "end_ms": 204560,
      "text": "因为你是主人"
    },
    {
      "ordinal": 60,
      "start_ms": 204980,
      "end_ms": 206720,
      "text": "但是光这样不行"
    },
    {
      "ordinal": 61,
      "start_ms": 206720,
      "end_ms": 209420,
      "text": "光这样我们只是做第一步和帮助工人"
    },
    {
      "ordinal": 62,
      "start_ms": 209420,
      "end_ms": 211160,
      "text": "直接给工人带来好处"
    },
    {
      "ordinal": 63,
      "start_ms": 211220,
      "end_ms": 212300,
      "text": "第二步"
    },
    {
      "ordinal": 64,
      "start_ms": 212300,
      "end_ms": 216080,
      "text": "也就是说要在工艺的基础上做公益"
    },
    {
      "ordinal": 65,
      "start_ms": 216080,
      "end_ms": 218080,
      "text": "就像要做工人"
    },
    {
      "ordinal": 66,
      "start_ms": 218179,
      "end_ms": 220620,
      "text": "让工人做公益"
    },
    {
      "ordinal": 67,
      "start_ms": 222700,
      "end_ms": 224850,
      "text": "要激发工人做公益"
    },
    {
      "ordinal": 68,
      "start_ms": 224850,
      "end_ms": 227260,
      "text": "但是工人没时间让他上工啊"
    },
    {
      "ordinal": 69,
      "start_ms": 227519,
      "end_ms": 230860,
      "text": "他要他要做各式各样的活儿啊"
    },
    {
      "ordinal": 70,
      "start_ms": 231060,
      "end_ms": 232440,
      "text": "我说他被压迫"
    },
    {
      "ordinal": 71,
      "start_ms": 234030,
      "end_ms": 235020,
      "text": "一天干十个小时"
    },
    {
      "ordinal": 72,
      "start_ms": 235020,
      "end_ms": 236310,
      "text": "你还让他做公益"
    },
    {
      "ordinal": 73,
      "start_ms": 236310,
      "end_ms": 239690,
      "text": "所以我们要做一小部分就行"
    },
    {
      "ordinal": 74,
      "start_ms": 239690,
      "end_ms": 242750,
      "text": "不是就是说而且这个东西很敏感"
    },
    {
      "ordinal": 75,
      "start_ms": 242750,
      "end_ms": 243380,
      "text": "懂了吧"
    },
    {
      "ordinal": 76,
      "start_ms": 243380,
      "end_ms": 247099,
      "text": "所以先让有钱做公益的"
    },
    {
      "ordinal": 77,
      "start_ms": 247099,
      "end_ms": 247909,
      "text": "先做公益"
    },
    {
      "ordinal": 78,
      "start_ms": 247909,
      "end_ms": 250640,
      "text": "有闲做公益的工人做公益"
    },
    {
      "ordinal": 79,
      "start_ms": 251499,
      "end_ms": 255440,
      "text": "无限的那些工人做工艺"
    },
    {
      "ordinal": 80,
      "start_ms": 255779,
      "end_ms": 259259,
      "text": "只要我们达到工人本身开始做公益的"
    },
    {
      "ordinal": 81,
      "start_ms": 259259,
      "end_ms": 261279,
      "text": "那不就是他自己团结起来的吗"
    },
    {
      "ordinal": 82,
      "start_ms": 262480,
      "end_ms": 264240,
      "text": "工人本身做公益的"
    },
    {
      "ordinal": 83,
      "start_ms": 264240,
      "end_ms": 267420,
      "text": "这工艺是带有普遍关怀的"
    },
    {
      "ordinal": 84,
      "start_ms": 267420,
      "end_ms": 269610,
      "text": "不是为了私利的"
    },
    {
      "ordinal": 85,
      "start_ms": 269610,
      "end_ms": 272630,
      "text": "不是为了眼下的啊"
    },
    {
      "ordinal": 86,
      "start_ms": 272630,
      "end_ms": 277200,
      "text": "不是为了一家一厂一车间"
    },
    {
      "ordinal": 87,
      "start_ms": 279000,
      "end_ms": 282320,
      "text": "的私立的也要让工人"
    },
    {
      "ordinal": 88,
      "start_ms": 282320,
      "end_ms": 284180,
      "text": "我们要激发工人做公益"
    },
    {
      "ordinal": 89,
      "start_ms": 284180,
      "end_ms": 286450,
      "text": "但是这个东西你妈的范围太小"
    },
    {
      "ordinal": 90,
      "start_ms": 286450,
      "end_ms": 287410,
      "text": "太敏感了"
    },
    {
      "ordinal": 91,
      "start_ms": 287410,
      "end_ms": 291260,
      "text": "那我们先让外围的先让工人做这个工艺"
    },
    {
      "ordinal": 92,
      "start_ms": 291580,
      "end_ms": 292810,
      "text": "可以吧"
    },
    {
      "ordinal": 93,
      "start_ms": 292810,
      "end_ms": 298040,
      "text": "让适合有闲的工人去做大工艺"
    },
    {
      "ordinal": 94,
      "start_ms": 300500,
      "end_ms": 303250,
      "text": "他做这个工艺做习惯了之后"
    },
    {
      "ordinal": 95,
      "start_ms": 303250,
      "end_ms": 304540,
      "text": "他发现我是主人"
    },
    {
      "ordinal": 96,
      "start_ms": 304540,
      "end_ms": 307160,
      "text": "我我是社会当中发光发热的"
    },
    {
      "ordinal": 97,
      "start_ms": 307460,
      "end_ms": 314160,
      "text": "我是那些受苦受难的苦难当中的无依无靠的人"
    },
    {
      "ordinal": 98,
      "start_ms": 314219,
      "end_ms": 316560,
      "text": "最后一个保障屏障"
    },
    {
      "ordinal": 99,
      "start_ms": 316560,
      "end_ms": 318780,
      "text": "或者说或者说如果不去做的话"
    },
    {
      "ordinal": 100,
      "start_ms": 318780,
      "end_ms": 319650,
      "text": "这事就没人"
    },
    {
      "ordinal": 101,
      "start_ms": 319650,
      "end_ms": 321750,
      "text": "他培养他的责任感"
    },
    {
      "ordinal": 102,
      "start_ms": 325169,
      "end_ms": 328859,
      "text": "或者说让他打消一些幻想"
    },
    {
      "ordinal": 103,
      "start_ms": 328859,
      "end_ms": 332440,
      "text": "就是他可以完全不去发挥自己的力量"
    },
    {
      "ordinal": 104,
      "start_ms": 332440,
      "end_ms": 334330,
      "text": "完全不顾那些更惨的人"
    },
    {
      "ordinal": 105,
      "start_ms": 339579,
      "end_ms": 341340,
      "text": "让他直接去"
    },
    {
      "ordinal": 106,
      "start_ms": 341719,
      "end_ms": 344719,
      "text": "我说我们我们讲的雷锋剑"
    },
    {
      "ordinal": 107,
      "start_ms": 344719,
      "end_ms": 348000,
      "text": "学雷锋做雷锋啊"
    },
    {
      "ordinal": 108,
      "start_ms": 348000,
      "end_ms": 349140,
      "text": "学雷锋做雷锋"
    },
    {
      "ordinal": 109,
      "start_ms": 351120,
      "end_ms": 352280,
      "text": "要工人做公益"
    },
    {
      "ordinal": 110,
      "start_ms": 352340,
      "end_ms": 353330,
      "text": "明白吧"
    },
    {
      "ordinal": 111,
      "start_ms": 353330,
      "end_ms": 356030,
      "text": "人家都是授人以渔不如授人以渔"
    },
    {
      "ordinal": 112,
      "start_ms": 356030,
      "end_ms": 357620,
      "text": "在我们这里同样的"
    },
    {
      "ordinal": 113,
      "start_ms": 357620,
      "end_ms": 361050,
      "text": "与其是对工人做公益"
    },
    {
      "ordinal": 114,
      "start_ms": 361050,
      "end_ms": 363090,
      "text": "不如说让工人做公益"
    },
    {
      "ordinal": 115,
      "start_ms": 363090,
      "end_ms": 364410,
      "text": "让工人做公益"
    },
    {
      "ordinal": 116,
      "start_ms": 364410,
      "end_ms": 365490,
      "text": "直接做公益"
    },
    {
      "ordinal": 117,
      "start_ms": 365490,
      "end_ms": 366630,
      "text": "可能我靠太敏感"
    },
    {
      "ordinal": 118,
      "start_ms": 366630,
      "end_ms": 367950,
      "text": "或者他没有那个能力"
    },
    {
      "ordinal": 119,
      "start_ms": 367950,
      "end_ms": 369120,
      "text": "没有那个力量"
    },
    {
      "ordinal": 120,
      "start_ms": 369180,
      "end_ms": 372300,
      "text": "那先让那些外围工人服务业"
    },
    {
      "ordinal": 121,
      "start_ms": 373020,
      "end_ms": 374340,
      "text": "他有能力做公益的"
    },
    {
      "ordinal": 122,
      "start_ms": 374340,
      "end_ms": 375920,
      "text": "先让他们去做这个公益"
    },
    {
      "ordinal": 123,
      "start_ms": 376759,
      "end_ms": 380499,
      "text": "那现在习惯了形成一种文化"
    },
    {
      "ordinal": 124,
      "start_ms": 380499,
      "end_ms": 382080,
      "text": "形成一个潮流了"
    },
    {
      "ordinal": 125,
      "start_ms": 383120,
      "end_ms": 385440,
      "text": "请这个主人翁文化"
    },
    {
      "ordinal": 126,
      "start_ms": 386400,
      "end_ms": 388850,
      "text": "那么带动起来啊"
    },
    {
      "ordinal": 127,
      "start_ms": 388850,
      "end_ms": 390380,
      "text": "形成一个主人翁文化"
    },
    {
      "ordinal": 128,
      "start_ms": 397180,
      "end_ms": 400739,
      "text": "顶天立地的我我说了"
    },
    {
      "ordinal": 129,
      "start_ms": 400739,
      "end_ms": 406640,
      "text": "就是有个很庸俗的一个在我看来一种说法"
    },
    {
      "ordinal": 130,
      "start_ms": 406640,
      "end_ms": 410900,
      "text": "说什么公和人这两个字加到一块去"
    },
    {
      "ordinal": 131,
      "start_ms": 410900,
      "end_ms": 413740,
      "text": "就是一个天字啊"
    },
    {
      "ordinal": 132,
      "start_ms": 413740,
      "end_ms": 416660,
      "text": "就是连到一起就是个天字啊"
    },
    {
      "ordinal": 133,
      "start_ms": 416660,
      "end_ms": 418820,
      "text": "这这话就只说了一半"
    },
    {
      "ordinal": 134,
      "start_ms": 418820,
      "end_ms": 420440,
      "text": "你顶着个天"
    },
    {
      "ordinal": 135,
      "start_ms": 420440,
      "end_ms": 422180,
      "text": "这不啥本事"
    },
    {
      "ordinal": 136,
      "start_ms": 422180,
      "end_ms": 424240,
      "text": "你要立到个地上"
    },
    {
      "ordinal": 137,
      "start_ms": 424539,
      "end_ms": 426399,
      "text": "关键是你不仅顶天"
    },
    {
      "ordinal": 138,
      "start_ms": 426399,
      "end_ms": 427659,
      "text": "还要立地"
    },
    {
      "ordinal": 139,
      "start_ms": 427659,
      "end_ms": 430180,
      "text": "要立到地上去"
    },
    {
      "ordinal": 140,
      "start_ms": 432920,
      "end_ms": 433690,
      "text": "可以吗"
    },
    {
      "ordinal": 141,
      "start_ms": 433690,
      "end_ms": 435400,
      "text": "要变成要加个土字"
    },
    {
      "ordinal": 142,
      "start_ms": 436600,
      "end_ms": 437920,
      "text": "加个土字呀"
    },
    {
      "ordinal": 143,
      "start_ms": 438720,
      "end_ms": 443000,
      "text": "那么说这个工人加个土字看上去像像啥啊"
    },
    {
      "ordinal": 144,
      "start_ms": 443000,
      "end_ms": 444200,
      "text": "像个主人的主字"
    },
    {
      "ordinal": 145,
      "start_ms": 444200,
      "end_ms": 445350,
      "text": "对不对啊"
    },
    {
      "ordinal": 146,
      "start_ms": 445350,
      "end_ms": 446310,
      "text": "主人的主子"
    },
    {
      "ordinal": 147,
      "start_ms": 446310,
      "end_ms": 449020,
      "text": "主人把这个土加到头上去啊"
    },
    {
      "ordinal": 148,
      "start_ms": 449639,
      "end_ms": 451279,
      "text": "有没有他他的一生"
    },
    {
      "ordinal": 149,
      "start_ms": 451279,
      "end_ms": 452569,
      "text": "他是主人翁"
    },
    {
      "ordinal": 150,
      "start_ms": 452569,
      "end_ms": 454639,
      "text": "他是天下的主人"
    },
    {
      "ordinal": 151,
      "start_ms": 454639,
      "end_ms": 455749,
      "text": "那我不是顶"
    },
    {
      "ordinal": 152,
      "start_ms": 455749,
      "end_ms": 456919,
      "text": "我不是要堕天"
    },
    {
      "ordinal": 153,
      "start_ms": 456919,
      "end_ms": 459080,
      "text": "我是要我是要为天下人"
    },
    {
      "ordinal": 154,
      "start_ms": 459880,
      "end_ms": 462360,
      "text": "为土地上大地上的"
    },
    {
      "ordinal": 155,
      "start_ms": 462360,
      "end_ms": 469780,
      "text": "为那些比工人还要不如的还要惨的鳏寡"
    },
    {
      "ordinal": 156,
      "start_ms": 469780,
      "end_ms": 471220,
      "text": "孤独孤儿寡母"
    },
    {
      "ordinal": 157,
      "start_ms": 471220,
      "end_ms": 473140,
      "text": "那弱势群众啊"
    },
    {
      "ordinal": 158,
      "start_ms": 473140,
      "end_ms": 476520,
      "text": "弱势弱势弱势人群"
    },
    {
      "ordinal": 159,
      "start_ms": 477000,
      "end_ms": 478680,
      "text": "那我可以帮到他"
    },
    {
      "ordinal": 160,
      "start_ms": 478680,
      "end_ms": 480060,
      "text": "那我才有代表性吗"
    },
    {
      "ordinal": 161,
      "start_ms": 480060,
      "end_ms": 482280,
      "text": "我他又说我是正儿八经宣称我是主人"
    },
    {
      "ordinal": 162,
      "start_ms": 482280,
      "end_ms": 483320,
      "text": "我是主人公"
    },
    {
      "ordinal": 163,
      "start_ms": 483539,
      "end_ms": 485879,
      "text": "这个东西要需要去激发的"
    },
    {
      "ordinal": 164,
      "start_ms": 485879,
      "end_ms": 487199,
      "text": "这个需要就是说"
    },
    {
      "ordinal": 165,
      "start_ms": 487199,
      "end_ms": 490499,
      "text": "你如果只单单只看他这个工人的权益"
    },
    {
      "ordinal": 166,
      "start_ms": 490499,
      "end_ms": 491600,
      "text": "工人的利益"
    },
    {
      "ordinal": 167,
      "start_ms": 491600,
      "end_ms": 494420,
      "text": "说说这个工人为了他自己的权益"
    },
    {
      "ordinal": 168,
      "start_ms": 494420,
      "end_ms": 495200,
      "text": "为了他的利益"
    },
    {
      "ordinal": 169,
      "start_ms": 495200,
      "end_ms": 496220,
      "text": "可以不择手段"
    },
    {
      "ordinal": 170,
      "start_ms": 496220,
      "end_ms": 497180,
      "text": "无比激进"
    },
    {
      "ordinal": 171,
      "start_ms": 497180,
      "end_ms": 498840,
      "text": "没有说服力的"
    },
    {
      "ordinal": 172,
      "start_ms": 499800,
      "end_ms": 502140,
      "text": "你没有说你没有普遍性啊"
    },
    {
      "ordinal": 173,
      "start_ms": 503220,
      "end_ms": 504320,
      "text": "你没有普遍性"
    },
    {
      "ordinal": 174,
      "start_ms": 504320,
      "end_ms": 505280,
      "text": "没有说服力啊"
    },
    {
      "ordinal": 175,
      "start_ms": 505280,
      "end_ms": 506740,
      "text": "这个私立啊"
    },
    {
      "ordinal": 176,
      "start_ms": 507080,
      "end_ms": 509780,
      "text": "你要证明你这是普遍的利益啊"
    },
    {
      "ordinal": 177,
      "start_ms": 509780,
      "end_ms": 511700,
      "text": "你要让社会共同体"
    },
    {
      "ordinal": 178,
      "start_ms": 511700,
      "end_ms": 513200,
      "text": "让各个层面的"
    },
    {
      "ordinal": 179,
      "start_ms": 513200,
      "end_ms": 514760,
      "text": "让本来和你对着干的"
    },
    {
      "ordinal": 180,
      "start_ms": 514760,
      "end_ms": 518140,
      "text": "本来想要过来啊"
    },
    {
      "ordinal": 181,
      "start_ms": 518140,
      "end_ms": 522409,
      "text": "过来打消你的这些意志的"
    },
    {
      "ordinal": 182,
      "start_ms": 522409,
      "end_ms": 524630,
      "text": "让他们意识到"
    },
    {
      "ordinal": 183,
      "start_ms": 524630,
      "end_ms": 529900,
      "text": "你不是代表社会的这个普遍利益的对立面的"
    },
    {
      "ordinal": 184,
      "start_ms": 531300,
      "end_ms": 532490,
      "text": "我说的"
    },
    {
      "ordinal": 185,
      "start_ms": 532490,
      "end_ms": 535580,
      "text": "所以啊要让工人做公益"
    },
    {
      "ordinal": 186,
      "start_ms": 535580,
      "end_ms": 537680,
      "text": "这个是一个很重要的一个点"
    },
    {
      "ordinal": 187,
      "start_ms": 538620,
      "end_ms": 540800,
      "text": "做工人工艺做的越好"
    },
    {
      "ordinal": 188,
      "start_ms": 540800,
      "end_ms": 542840,
      "text": "工人这个工艺也就做的越好"
    },
    {
      "ordinal": 189,
      "start_ms": 542840,
      "end_ms": 544590,
      "text": "他自己就能团结起来"
    },
    {
      "ordinal": 190,
      "start_ms": 544590,
      "end_ms": 547350,
      "text": "因为他已经形成习惯了一些逻辑的"
    },
    {
      "ordinal": 191,
      "start_ms": 549300,
      "end_ms": 552099,
      "text": "他按照是人民的根本的幸福"
    },
    {
      "ordinal": 192,
      "start_ms": 552400,
      "end_ms": 556750,
      "text": "人们的人民的基本的最最最底线性的保障"
    },
    {
      "ordinal": 193,
      "start_ms": 556750,
      "end_ms": 558160,
      "text": "按这个逻辑再走"
    },
    {
      "ordinal": 194,
      "start_ms": 558160,
      "end_ms": 559839,
      "text": "他这叫主人翁精神"
    },
    {
      "ordinal": 195,
      "start_ms": 560940,
      "end_ms": 561620,
      "text": "懂了吗"
    },
    {
      "ordinal": 196,
      "start_ms": 561620,
      "end_ms": 565780,
      "text": "这叫基层的一个一个真正意义上的一种"
    },
    {
      "ordinal": 197,
      "start_ms": 568720,
      "end_ms": 569620,
      "text": "一个维护"
    },
    {
      "ordinal": 198,
      "start_ms": 570360,
      "end_ms": 572480,
      "text": "所以我们接下来要走的一个工作"
    },
    {
      "ordinal": 199,
      "start_ms": 572480,
      "end_ms": 577000,
      "text": "就是说我们努力的去激发啊"
    },
    {
      "ordinal": 200,
      "start_ms": 579660,
      "end_ms": 582920,
      "text": "激发工人的公益性啊"
    },
    {
      "ordinal": 201,
      "start_ms": 582920,
      "end_ms": 586810,
      "text": "那这个主要是有有这个余力"
    },
    {
      "ordinal": 202,
      "start_ms": 586810,
      "end_ms": 589500,
      "text": "或者他的劳动本身就可以做这个公益"
    },
    {
      "ordinal": 203,
      "start_ms": 589640,
      "end_ms": 592400,
      "text": "那是谁啊啊外卖骑手啊"
    },
    {
      "ordinal": 204,
      "start_ms": 592400,
      "end_ms": 597400,
      "text": "我们会努力去激发外卖骑手的是公益性节"
    },
    {
      "ordinal": 205,
      "start_ms": 597680,
      "end_ms": 600050,
      "text": "这个工艺本身也是一种工艺"
    },
    {
      "ordinal": 206,
      "start_ms": 600050,
      "end_ms": 600620,
      "text": "为什么"
    },
    {
      "ordinal": 207,
      "start_ms": 600620,
      "end_ms": 604959,
      "text": "因为这使得工人具有恢复它的主人翁地位啊"
    },
    {
      "ordinal": 208,
      "start_ms": 606180,
      "end_ms": 607460,
      "text": "啊主人公地位"
    },
    {
      "ordinal": 209,
      "start_ms": 607460,
      "end_ms": 608870,
      "text": "一个街道一个社区"
    },
    {
      "ordinal": 210,
      "start_ms": 608870,
      "end_ms": 612200,
      "text": "它里面的鳏寡孤独残疾啊"
    },
    {
      "ordinal": 211,
      "start_ms": 612200,
      "end_ms": 614630,
      "text": "这个病患啊"
    },
    {
      "ordinal": 212,
      "start_ms": 614630,
      "end_ms": 616550,
      "text": "这这这老人啊"
    },
    {
      "ordinal": 213,
      "start_ms": 616550,
      "end_ms": 620240,
      "text": "这些这些孤儿是啊"
    },
    {
      "ordinal": 214,
      "start_ms": 620240,
      "end_ms": 624260,
      "text": "这个外卖骑手可以帮帮忙去派送食品啊"
    },
    {
      "ordinal": 215,
      "start_ms": 624260,
      "end_ms": 626240,
      "text": "关怀人家的啊"
    },
    {
      "ordinal": 216,
      "start_ms": 626240,
      "end_ms": 630210,
      "text": "这个居住状况啊啊了解吗"
    },
    {
      "ordinal": 217,
      "start_ms": 630210,
      "end_ms": 631819,
      "text": "这种情况之下"
    },
    {
      "ordinal": 218,
      "start_ms": 631819,
      "end_ms": 633439,
      "text": "那我们也是有监督的"
    },
    {
      "ordinal": 219,
      "start_ms": 633439,
      "end_ms": 634009,
      "text": "我们也会"
    },
    {
      "ordinal": 220,
      "start_ms": 634009,
      "end_ms": 637519,
      "text": "我们年后我们就会去成立这个公益机构啊"
    },
    {
      "ordinal": 221,
      "start_ms": 637519,
      "end_ms": 639010,
      "text": "在这个乐器街道"
    },
    {
      "ordinal": 222,
      "start_ms": 639010,
      "end_ms": 640720,
      "text": "我们会去申请成立公益机构"
    },
    {
      "ordinal": 223,
      "start_ms": 640720,
      "end_ms": 642430,
      "text": "公益团体啊"
    },
    {
      "ordinal": 224,
      "start_ms": 642430,
      "end_ms": 643240,
      "text": "外卖骑手"
    },
    {
      "ordinal": 225,
      "start_ms": 643240,
      "end_ms": 646980,
      "text": "他这着重激发工人的公益性"
    },
    {
      "ordinal": 226,
      "start_ms": 646980,
      "end_ms": 648880,
      "text": "它本身就是一个公益活动"
    },
    {
      "ordinal": 227,
      "start_ms": 649140,
      "end_ms": 653130,
      "text": "而让他意识到他的尊严啊"
    },
    {
      "ordinal": 228,
      "start_ms": 659340,
      "end_ms": 661260,
      "text": "他好可以打消他的那种"
    },
    {
      "ordinal": 229,
      "start_ms": 661260,
      "end_ms": 664480,
      "text": "我靠就做人上人的那种啊"
    },
    {
      "ordinal": 230,
      "start_ms": 664480,
      "end_ms": 666790,
      "text": "他就知道人生有另外一种追求"
    },
    {
      "ordinal": 231,
      "start_ms": 666790,
      "end_ms": 668280,
      "text": "有另外一个方向"
    },
    {
      "ordinal": 232,
      "start_ms": 669260,
      "end_ms": 672219,
      "text": "那这样成为高尚的人"
    },
    {
      "ordinal": 233,
      "start_ms": 672340,
      "end_ms": 676240,
      "text": "这样成为一个脱离一些低级趣味的人"
    },
    {
      "ordinal": 234,
      "start_ms": 676240,
      "end_ms": 677860,
      "text": "他团结起来"
    },
    {
      "ordinal": 235,
      "start_ms": 677860,
      "end_ms": 679660,
      "text": "他这里面的伟大人物"
    },
    {
      "ordinal": 236,
      "start_ms": 679660,
      "end_ms": 680590,
      "text": "了不起的人"
    },
    {
      "ordinal": 237,
      "start_ms": 680590,
      "end_ms": 684010,
      "text": "他就能抱团围绕着这个伟大人物了不起的人"
    },
    {
      "ordinal": 238,
      "start_ms": 684010,
      "end_ms": 685420,
      "text": "抱团抱起来"
    },
    {
      "ordinal": 239,
      "start_ms": 686260,
      "end_ms": 687960,
      "text": "谁敢欺负他"
    },
    {
      "ordinal": 240,
      "start_ms": 687960,
      "end_ms": 689610,
      "text": "谁敢打压他"
    },
    {
      "ordinal": 241,
      "start_ms": 689610,
      "end_ms": 692910,
      "text": "那是触了众怒的了解吗"
    },
    {
      "ordinal": 242,
      "start_ms": 692910,
      "end_ms": 697720,
      "text": "你把这个工人让它具有公益性的存在了之后"
    },
    {
      "ordinal": 243,
      "start_ms": 697720,
      "end_ms": 699400,
      "text": "他维护自己的利益"
    },
    {
      "ordinal": 244,
      "start_ms": 699400,
      "end_ms": 701140,
      "text": "他就不单单是维护自己的利益了"
    },
    {
      "ordinal": 245,
      "start_ms": 701140,
      "end_ms": 704459,
      "text": "他就他是维护社会的最底层的"
    },
    {
      "ordinal": 246,
      "start_ms": 704560,
      "end_ms": 707020,
      "text": "普遍利益的了解吗"
    },
    {
      "ordinal": 247,
      "start_ms": 708220,
      "end_ms": 711730,
      "text": "原来三这样他就很安全了"
    },
    {
      "ordinal": 248,
      "start_ms": 711730,
      "end_ms": 713680,
      "text": "他要去维护自己的利益"
    },
    {
      "ordinal": 249,
      "start_ms": 713680,
      "end_ms": 715900,
      "text": "就没有那么好被欺负了"
    },
    {
      "ordinal": 250,
      "start_ms": 715900,
      "end_ms": 717280,
      "text": "没有那么好被被取消"
    },
    {
      "ordinal": 251,
      "start_ms": 717280,
      "end_ms": 720790,
      "text": "其存在了了解吗"
    },
    {
      "ordinal": 252,
      "start_ms": 720790,
      "end_ms": 723079,
      "text": "你以为我只是做公益的"
    },
    {
      "ordinal": 253,
      "start_ms": 723100,
      "end_ms": 724720,
      "text": "我是只能做公益的"
    },
    {
      "ordinal": 254,
      "start_ms": 724720,
      "end_ms": 726280,
      "text": "那是因为我是第一步啊"
    },
    {
      "ordinal": 255,
      "start_ms": 726280,
      "end_ms": 728020,
      "text": "第一步当然你只能做公益啊"
    },
    {
      "ordinal": 256,
      "start_ms": 728020,
      "end_ms": 728620,
      "text": "你不第一部"
    },
    {
      "ordinal": 257,
      "start_ms": 728620,
      "end_ms": 729700,
      "text": "第你第一步就下去"
    },
    {
      "ordinal": 258,
      "start_ms": 729700,
      "end_ms": 730630,
      "text": "叫人家工人"
    },
    {
      "ordinal": 259,
      "start_ms": 730630,
      "end_ms": 735300,
      "text": "叫人家外卖骑手给你无偿免费送单子"
    },
    {
      "ordinal": 260,
      "start_ms": 737680,
      "end_ms": 738920,
      "text": "就做了一封"
    },
    {
      "ordinal": 261,
      "start_ms": 739400,
      "end_ms": 741920,
      "text": "你要你要叫人家做好事"
    },
    {
      "ordinal": 262,
      "start_ms": 741920,
      "end_ms": 743060,
      "text": "学雷锋做好事"
    },
    {
      "ordinal": 263,
      "start_ms": 743060,
      "end_ms": 745199,
      "text": "你自个儿先要学雷锋做好事"
    },
    {
      "ordinal": 264,
      "start_ms": 747740,
      "end_ms": 748900,
      "text": "要榜样嘛"
    },
    {
      "ordinal": 265,
      "start_ms": 748900,
      "end_ms": 749579,
      "text": "对不对"
    },
    {
      "ordinal": 266,
      "start_ms": 758520,
      "end_ms": 760200,
      "text": "那我为什么做水饺啊"
    },
    {
      "ordinal": 267,
      "start_ms": 760200,
      "end_ms": 762400,
      "text": "水饺好批量好复制"
    },
    {
      "ordinal": 268,
      "start_ms": 763260,
      "end_ms": 766280,
      "text": "所以说工艺工艺是最大的工艺"
    },
    {
      "ordinal": 269,
      "start_ms": 766280,
      "end_ms": 769400,
      "text": "这个啊是最大的工艺"
    },
    {
      "ordinal": 270,
      "start_ms": 770580,
      "end_ms": 772700,
      "text": "反过来我们要说了"
    },
    {
      "ordinal": 271,
      "start_ms": 773900,
      "end_ms": 776240,
