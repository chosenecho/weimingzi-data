92,"end":110.28,"text":"集团贵族"},{"start":110.86,"end":112.92,"text":"还有小工商业者合作"},{"start":112.92,"end":113.76,"text":"所以你跟我说"},{"start":113.76,"end":115.08,"text":"这问题太大了不"},{"start":115.08,"end":116.92,"text":"我们不是问题太大了"},{"start":116.92,"end":118.09,"text":"你应该这样说"},{"start":118.09,"end":121.94,"text":"你这么看待曼纳海姆对我的敌意"},{"start":121.94,"end":124.49,"text":"对我们这种人的敌意太大了"},{"start":124.49,"end":126.62,"text":"你看到的不是我的问题"},{"start":126.62,"end":128.49,"text":"你看到的是我的敌意"},{"start":128.49,"end":130.77,"text":"我们不再讨论一个历史的问题"},{"start":130.77,"end":132.93,"text":"我们我们讨论曼纳海姆"},{"start":132.93,"end":135.0,"text":"只是说如果在中国"},{"start":135.82,"end":139.41,"text":"如果国家民族陷于不幸的境地"},{"start":139.41,"end":142.79,"text":"有那么一种类似曼纳海姆的人物出现的时候"},{"start":142.79,"end":145.13,"text":"干类似曼纳海姆的事情的时候"},{"start":145.13,"end":146.839,"text":"比如说他在哪个山区"},{"start":146.839,"end":149.059,"text":"或者他在那个边边陲省份"},{"start":149.059,"end":150.619,"text":"要做类似的事情的时候"},{"start":150.619,"end":152.87,"text":"我们要杀掉他"},{"start":153.27,"end":156.77,"text":"然后这个曼无论曼纳海姆在他那个边陲省份"},{"start":156.77,"end":159.02,"text":"或在那个山区或者那个岛屿上面"},{"start":159.02,"end":164.38,"text":"多受它所在的那一片地方的那个少数民族"},{"start":164.38,"end":169.23,"text":"或者说某个新造出来的新兴民族的啊"},{"start":169.23,"end":170.64,"text":"中上层的支持"},{"start":170.64,"end":172.05,"text":"无论他多受这个支持"},{"start":172.05,"end":174.12,"text":"我们都要杀掉他"},{"start":174.52,"end":176.78,"text":"我们要杀掉这种人"},{"start":177.12,"end":178.43,"text":"我们要干掉这种人"},{"start":178.43,"end":180.56,"text":"并且我们还会说他是个法西斯"},{"start":180.56,"end":182.07,"text":"然后把他干掉"},{"start":182.07,"end":183.87,"text":"我们客观现实的"},{"start":183.87,"end":186.18,"text":"如果历史发生这么一种情形"},{"start":186.18,"end":187.86,"text":"我们会做这样的选择"},{"start":187.86,"end":189.99,"text":"我们会这样去组织动员"},{"start":189.99,"end":191.93,"text":"我们可以组织动员的力量"},{"start":191.93,"end":193.76,"text":"让他成为军事力量"},{"start":193.76,"end":199.28,"text":"然后去和类似曼纳海姆这样的分裂国家的戕害"},{"start":199.28,"end":200.84,"text":"无产阶级的镇压"},{"start":200.84,"end":203.24,"text":"红色力量的