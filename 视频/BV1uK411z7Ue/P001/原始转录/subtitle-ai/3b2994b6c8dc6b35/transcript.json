{
  "bvid": "BV1uK411z7Ue",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "3b2994b6c8dc6b35877bd990b64457f9667f9d88783bed5352babb8b6888eb8c",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 0,
      "end_ms": 1920,
      "text": "第三个说什么是子虚乌有的"
    },
    {
      "ordinal": 1,
      "start_ms": 1920,
      "end_ms": 4380,
      "text": "倒逼说我的经济时间是空想的"
    },
    {
      "ordinal": 2,
      "start_ms": 4380,
      "end_ms": 7220,
      "text": "在政治经济学方面知识几乎为零"
    },
    {
      "ordinal": 3,
      "start_ms": 8579,
      "end_ms": 11119,
      "text": "政治经济学的知识是不是零"
    },
    {
      "ordinal": 4,
      "start_ms": 11119,
      "end_ms": 11839,
      "text": "其实没用的"
    },
    {
      "ordinal": 5,
      "start_ms": 11839,
      "end_ms": 13560,
      "text": "政治经济学的实践"
    },
    {
      "ordinal": 6,
      "start_ms": 14839,
      "end_ms": 15579,
      "text": "一则"
    },
    {
      "ordinal": 7,
      "start_ms": 17079,
      "end_ms": 18759,
      "text": "任何一个工厂不按资本逻辑运营"
    },
    {
      "ordinal": 8,
      "start_ms": 18759,
      "end_ms": 19700,
      "text": "就只有死路一条"
    },
    {
      "ordinal": 9,
      "start_ms": 19700,
      "end_ms": 21260,
      "text": "我要建立一个更人性化的厂"
    },
    {
      "ordinal": 10,
      "start_ms": 21260,
      "end_ms": 22580,
      "text": "我没有说更人性化场"
    },
    {
      "ordinal": 11,
      "start_ms": 24390,
      "end_ms": 25710,
      "text": "也就是一个福利更好"
    },
    {
      "ordinal": 12,
      "start_ms": 25710,
      "end_ms": 26250,
      "text": "工资更高"
    },
    {
      "ordinal": 13,
      "start_ms": 26250,
      "end_ms": 28230,
      "text": "工时工作时间更好"
    },
    {
      "ordinal": 14,
      "start_ms": 28230,
      "end_ms": 29620,
      "text": "更更少的长"
    },
    {
      "ordinal": 15,
      "start_ms": 29700,
      "end_ms": 32520,
      "text": "我现在资本家都可以做到这一点"
    },
    {
      "ordinal": 16,
      "start_ms": 32520,
      "end_ms": 36280,
      "text": "资本家把他的超额利润都都给给工人"
    },
    {
      "ordinal": 17,
      "start_ms": 36280,
      "end_ms": 36580,
      "text": "回"
    },
    {
      "ordinal": 18,
      "start_ms": 36580,
      "end_ms": 38590,
      "text": "还给还给工人就行了"
    },
    {
      "ordinal": 19,
      "start_ms": 38590,
      "end_ms": 40670,
      "text": "假如有另一家场合"
    },
    {
      "ordinal": 20,
      "start_ms": 40670,
      "end_ms": 42410,
      "text": "未明子生产同样的产品"
    },
    {
      "ordinal": 21,
      "start_ms": 42410,
      "end_ms": 43190,
      "text": "为了打败魏明"
    },
    {
      "ordinal": 22,
      "start_ms": 43190,
      "end_ms": 45050,
      "text": "它可以降价销售"
    },
    {
      "ordinal": 23,
      "start_ms": 45050,
      "end_ms": 47210,
      "text": "把工人创造生产价值的一部分让渡给消费者"
    },
    {
      "ordinal": 24,
      "start_ms": 47210,
      "end_ms": 51320,
      "text": "但是未明子不能什么剩余价值一部分让渡给"
    },
    {
      "ordinal": 25,
      "start_ms": 54660,
      "end_ms": 61000,
      "text": "剩余价值的全部都被资本家攫取了"
    },
    {
      "ordinal": 26,
      "start_ms": 61920,
      "end_ms": 64060,
      "text": "就知道什么叫剩余价值啊"
    },
    {
      "ordinal": 27,
      "start_ms": 66080,
      "end_ms": 67540,
      "text": "这让渡给消费者"
    },
    {
      "ordinal": 28,
      "start_ms": 67540,
      "end_ms": 69040,
      "text": "什么叫让渡给消费者啊"
    },
    {
      "ordinal": 29,
      "start_ms": 71080,
      "end_ms": 72140,
      "text": "这搞笑"
    },
    {
      "ordinal": 30,
      "start_ms": 76080,
      "end_ms": 77780,
      "text": "后面我就这个就不管"
    },
    {
      "ordinal": 31,
      "start_ms": 77780,
      "end_ms": 78860,
      "text": "但是未明子不能"
    },
    {
      "ordinal": 32,
      "start_ms": 78860,
      "end_ms": 81260,
      "text": "因为未明子厂里面的工人工资更高"
    },
    {
      "ordinal": 33,
      "start_ms": 81260,
      "end_ms": 82100,
      "text": "福利更好是吧"
    },
    {
      "ordinal": 34,
      "start_ms": 82100,
      "end_ms": 83570,
      "text": "一旦降价就会亏本"
    },
    {
      "ordinal": 35,
      "start_ms": 83570,
      "end_ms": 86210,
      "text": "你的意思就是他会倾向来搞我吧"
    },
    {
      "ordinal": 36,
      "start_ms": 86210,
      "end_ms": 89390,
      "text": "就是说这些其他厂会通过倾销来干我呗"
    },
    {
      "ordinal": 37,
      "start_ms": 89390,
      "end_ms": 90440,
      "text": "是这个意思吧"
    },
    {
      "ordinal": 38,
      "start_ms": 90800,
      "end_ms": 93530,
      "text": "因此在资本体制下"
    },
    {
      "ordinal": 39,
      "start_ms": 93530,
      "end_ms": 96380,
      "text": "幻想创建乌托邦式的工厂来改善工人生活"
    },
    {
      "ordinal": 40,
      "start_ms": 96380,
      "end_ms": 97820,
      "text": "注定沦为幻想"
    },
    {
      "ordinal": 41,
      "start_ms": 97820,
      "end_ms": 99480,
      "text": "注定沦为空想"
    },
    {
      "ordinal": 42,
      "start_ms": 100620,
      "end_ms": 104760,
      "text": "首先当这个厂做出来之后"
    },
    {
      "ordinal": 43,
      "start_ms": 104760,
      "end_ms": 107580,
      "text": "它会是一个非常大的社会舆论动能"
    },
    {
      "ordinal": 44,
      "start_ms": 107580,
      "end_ms": 112000,
      "text": "其次这个体制为什么一定是个资本体制呢"
    },
    {
      "ordinal": 45,
      "start_ms": 118200,
      "end_ms": 120060,
      "text": "土壤当中竟然失败了"
    },
    {
      "ordinal": 46,
      "start_ms": 121300,
      "end_ms": 125400,
      "text": "这才是证明他是资本体制的一个"
    },
    {
      "ordinal": 47,
      "start_ms": 125400,
      "end_ms": 127020,
      "text": "最彻底的一个方式"
    },
    {
      "ordinal": 48,
      "start_ms": 128399,
      "end_ms": 129859,
      "text": "他是不是资本体制"
    },
    {
      "ordinal": 49,
      "start_ms": 129859,
      "end_ms": 136380,
      "text": "在很大程度上需要向广大的人民群众去证明的"
    },
    {
      "ordinal": 50,
      "start_ms": 136959,
      "end_ms": 138129,
      "text": "明白了吧"
    },
    {
      "ordinal": 51,
      "start_ms": 138129,
      "end_ms": 139740,
      "text": "you have to prove it"
    },
    {
      "ordinal": 52,
      "start_ms": 142880,
      "end_ms": 144200,
      "text": "它不是空想的"
    },
    {
      "ordinal": 53,
      "start_ms": 155430,
      "end_ms": 156330,
      "text": "那这样的话"
    },
    {
      "ordinal": 54,
      "start_ms": 169000,
      "end_ms": 171040,
      "text": "你们就以为这个就是我"
    },
    {
      "ordinal": 55,
      "start_ms": 171040,
      "end_ms": 172600,
      "text": "我要改善工人生活什么的"
    },
    {
      "ordinal": 56,
      "start_ms": 172600,
      "end_ms": 177160,
      "text": "不就是达成绝大部分工人群众的共识"
    },
    {
      "ordinal": 57,
      "start_ms": 204310,
      "end_ms": 207200,
      "text": "那自然这个厂就能存活下来"
    },
    {
      "ordinal": 58,
      "start_ms": 207939,
      "end_ms": 208919,
      "text": "那存活下来"
    },
    {
      "ordinal": 59,
      "start_ms": 208919,
      "end_ms": 212309,
      "text": "自然这个存这个第二次社会改造的烈度"
    },
    {
      "ordinal": 60,
      "start_ms": 212309,
      "end_ms": 214000,
      "text": "肯定也是比较大的"
    },
    {
      "ordinal": 61,
      "start_ms": 219050,
      "end_ms": 222000,
      "text": "甚至大到所有一切情况都有可能发生"
    },
    {
      "ordinal": 62,
      "start_ms": 222380,
      "end_ms": 224200,
      "text": "包括c vivo"
    },
    {
      "ordinal": 63,
      "start_ms": 228219,
      "end_ms": 229469,
      "text": "那么有人问"
    },
    {
      "ordinal": 64,
      "start_ms": 229469,
      "end_ms": 231299,
      "text": "那怎么看待某些厂的工人待遇"
    },
    {
      "ordinal": 65,
      "start_ms": 231299,
      "end_ms": 232019,
      "text": "就是好像很简单"
    },
    {
      "ordinal": 66,
      "start_ms": 232019,
      "end_ms": 233339,
      "text": "这场是垄断资本的厂"
    },
    {
      "ordinal": 67,
      "start_ms": 233339,
      "end_ms": 235799,
      "text": "它有足够的垄断力量改善工人的生活"
    },
    {
      "ordinal": 68,
      "start_ms": 235799,
      "end_ms": 238470,
      "text": "但就是这种场啊"
    },
    {
      "ordinal": 69,
      "start_ms": 238470,
      "end_ms": 242040,
      "text": "工人生活的改善也不是慈善家发善心而来"
    },
    {
      "ordinal": 70,
      "start_ms": 242040,
      "end_ms": 243980,
      "text": "而是工人自发的经济斗争"
    },
    {
      "ordinal": 71,
      "start_ms": 244100,
      "end_ms": 245600,
      "text": "他就垄断资本的厂"
    },
    {
      "ordinal": 72,
      "start_ms": 245600,
      "end_ms": 246800,
      "text": "就是国营资本的厂"
    },
    {
      "ordinal": 73,
      "start_ms": 248750,
      "end_ms": 251300,
      "text": "那请问为什么我们不能够使我们的厂"
    },
    {
      "ordinal": 74,
      "start_ms": 251300,
      "end_ms": 252680,
      "text": "变成国营资本呢"
    },
    {
      "ordinal": 75,
      "start_ms": 255240,
      "end_ms": 256760,
      "text": "你就说人家就被收编了"
    },
    {
      "ordinal": 76,
      "start_ms": 256760,
      "end_ms": 258440,
      "text": "被被被被怎么样怎么样呢"
    },
    {
      "ordinal": 77,
      "start_ms": 258440,
      "end_ms": 263799,
      "text": "或者说为什么我不能使我的想变成you understand"
    },
    {
      "ordinal": 78,
      "start_ms": 263799,
      "end_ms": 266499,
      "text": "为什么我不能使我的厂变成国营资本呢"
    },
    {
      "ordinal": 79,
      "start_ms": 266499,
      "end_ms": 270190,
      "text": "你这你知道这句话背后是有你"
    },
    {
      "ordinal": 80,
      "start_ms": 270190,
      "end_ms": 273430,
      "text": "你当然你保守的人就听到这句话的保守性"
    },
    {
      "ordinal": 81,
      "start_ms": 273430,
      "end_ms": 276620,
      "text": "激进的人会听到这句话的极度的激进性"
    },
    {
      "ordinal": 82,
      "start_ms": 281020,
      "end_ms": 283700,
      "text": "问鼎轻重的那种极度的激进性"
    },
    {
      "ordinal": 83,
      "start_ms": 288320,
      "end_ms": 291700,
      "text": "在真正的主人耳朵里面就听到是主人的话"
    },
    {
      "ordinal": 84,
      "start_ms": 292759,
      "end_ms": 296020,
      "text": "为什么我们厂不能成为国营资本呢"
    },
    {
      "ordinal": 85,
      "start_ms": 297560,
      "end_ms": 299500,
      "text": "不能成为国营工厂呢"
    },
    {
      "ordinal": 86,
      "start_ms": 299500,
      "end_ms": 301480,
      "text": "这句话你愿意听他是保守的"
    },
    {
      "ordinal": 87,
      "start_ms": 301480,
      "end_ms": 302140,
      "text": "还愿意听"
    },
    {
      "ordinal": 88,
      "start_ms": 302140,
      "end_ms": 302740,
      "text": "他是激进的"
    },
    {
      "ordinal": 89,
      "start_ms": 302740,
      "end_ms": 305900,
      "text": "取决于你自己是保守的还是激进的朋友"
    },
    {
      "ordinal": 90,
      "start_ms": 307360,
      "end_ms": 308340,
      "text": "甚至我们说"
    },
    {
      "ordinal": 91,
      "start_ms": 308340,
      "end_ms": 310880,
      "text": "为什么我的厂不能变成一种国际主义的呢"
    },
    {
      "ordinal": 92,
      "start_ms": 315740,
      "end_ms": 316600,
      "text": "啊他说"
    },
    {
      "ordinal": 93,
      "start_ms": 316600,
      "end_ms": 318760,
      "text": "但就是这种厂工人的改善"
    },
    {
      "ordinal": 94,
      "start_ms": 318760,
      "end_ms": 320320,
      "text": "也不是慈善家发善心而来"
    },
    {
      "ordinal": 95,
      "start_ms": 320320,
      "end_ms": 322460,
      "text": "而是工人自发的经济斗争斗争出来的"
    },
    {
      "ordinal": 96,
      "start_ms": 322460,
      "end_ms": 323480,
      "text": "我知道这种场"
    },
    {
      "ordinal": 97,
      "start_ms": 323480,
      "end_ms": 326450,
      "text": "如果你这场成为一个啊这个国有的"
    },
    {
      "ordinal": 98,
      "start_ms": 326450,
      "end_ms": 328850,
      "text": "或者说这个全民所有的这样一个厂"
    },
    {
      "ordinal": 99,
      "start_ms": 328850,
      "end_ms": 329810,
      "text": "工人生活的改善"
    },
    {
      "ordinal": 100,
      "start_ms": 329810,
      "end_ms": 331969,
      "text": "不是自发经济斗争斗争出来的"
    },
    {
      "ordinal": 101,
      "start_ms": 331969,
      "end_ms": 334009,
      "text": "而恰恰是自觉斗争斗争出来的"
    },
    {
      "ordinal": 102,
      "start_ms": 335580,
      "end_ms": 337380,
      "text": "代表其长远利益"
    },
    {
      "ordinal": 103,
      "start_ms": 337380,
      "end_ms": 338880,
      "text": "自觉的斗争斗争出来的"
    },
    {
      "ordinal": 104,
      "start_ms": 338880,
      "end_ms": 340080,
      "text": "这话你又说错了"
    },
    {
      "ordinal": 105,
      "start_ms": 340080,
      "end_ms": 340580,
      "text": "咳咳"
    },
    {
      "ordinal": 106,
      "start_ms": 343840,
      "end_ms": 346740,
      "text": "从二则在资本体制下"
    },
    {
      "ordinal": 107,
      "start_ms": 346740,
      "end_ms": 350310,
      "text": "劳动者工资只是劳动力价值的货币体现"
    },
    {
      "ordinal": 108,
      "start_ms": 350310,
      "end_ms": 353630,
      "text": "而当工人享有廉价这个饮食住宿时"
    },
    {
      "ordinal": 109,
      "start_ms": 353630,
      "end_ms": 355850,
      "text": "不过是降低了这群工人劳动力价值而已"
    },
    {
      "ordinal": 110,
      "start_ms": 355850,
      "end_ms": 359390,
      "text": "同时期在阶级力量对比没有明显变化的情况下"
    },
    {
      "ordinal": 111,
      "start_ms": 359390,
      "end_ms": 360530,
      "text": "怎么怎么样怎么样"
    },
    {
      "ordinal": 112,
      "start_ms": 360530,
      "end_ms": 361890,
      "text": "就说这意思"
    },
    {
      "ordinal": 113,
      "start_ms": 361890,
      "end_ms": 366659,
      "text": "就是说我如果公益是社区实践了之后啊"
    },
    {
      "ordinal": 114,
      "start_ms": 366659,
      "end_ms": 368699,
      "text": "导致工资就会下降了"
    },
    {
      "ordinal": 115,
      "start_ms": 368699,
      "end_ms": 371159,
      "text": "就相当于这个便宜就被资本家占走了"
    },
    {
      "ordinal": 116,
      "start_ms": 371159,
      "end_ms": 374480,
      "text": "请问如果我公益社区搞得好"
    },
    {
      "ordinal": 117,
      "start_ms": 374480,
      "end_ms": 374780,
      "text": "大"
    },
    {
      "ordinal": 118,
      "start_ms": 374780,
      "end_ms": 377140,
      "text": "有数万数10万工人在我手上"
    },
    {
      "ordinal": 119,
      "start_ms": 378100,
      "end_ms": 379500,
      "text": "他敢降工资"
    },
    {
      "ordinal": 120,
      "start_ms": 379500,
      "end_ms": 381340,
      "text": "听懂了这句话的意思没有"
    },
    {
      "ordinal": 121,
      "start_ms": 382400,
      "end_ms": 383440,
      "text": "你还在想"
    },
    {
      "ordinal": 122,
      "start_ms": 383440,
      "end_ms": 386260,
      "text": "就是说阶级力量对比没有明显变化"
    },
    {
      "ordinal": 123,
      "start_ms": 386260,
      "end_ms": 388840,
      "text": "如果我的供应社区实现了阶级力量对比"
    },
    {
      "ordinal": 124,
      "start_ms": 388840,
      "end_ms": 390540,
      "text": "就实现了重大的逆转"
    },
    {
      "ordinal": 125,
      "start_ms": 391500,
      "end_ms": 393900,
      "text": "你前期就不不不成立了"
    },
    {
      "ordinal": 126,
      "start_ms": 393900,
      "end_ms": 398040,
      "text": "你说说那这局点对比不不发生变化的情况下"
    },
    {
      "ordinal": 127,
      "start_ms": 398040,
      "end_ms": 399810,
      "text": "我的公益社区能做大吗"
    },
    {
      "ordinal": 128,
      "start_ms": 399810,
      "end_ms": 400890,
      "text": "他也做不到"
    },
    {
      "ordinal": 129,
      "start_ms": 400890,
      "end_ms": 403430,
      "text": "如果gg力量对比发生了变化"
    },
    {
      "ordinal": 130,
      "start_ms": 403430,
      "end_ms": 405020,
      "text": "这个时候很多劳动者"
    },
    {
      "ordinal": 131,
      "start_ms": 405020,
      "end_ms": 408590,
      "text": "他头脑中的自发抗争的意愿在在成长的茁壮"
    },
    {
      "ordinal": 132,
      "start_ms": 408590,
      "end_ms": 410320,
      "text": "那我的公益社区越做越大"
    },
    {
      "ordinal": 133,
      "start_ms": 410320,
      "end_ms": 414100,
      "text": "这个时候阶级力量的对比就已经叫"
    },
    {
      "ordinal": 134,
      "start_ms": 414159,
      "end_ms": 415839,
      "text": "而且通过我的公益社区"
    },
    {
      "ordinal": 135,
      "start_ms": 415839,
      "end_ms": 417249,
      "text": "这些人有了场所"
    },
    {
      "ordinal": 136,
      "start_ms": 417249,
      "end_ms": 419139,
      "text": "有了食物的准备"
    },
    {
      "ordinal": 137,
      "start_ms": 419139,
      "end_ms": 421299,
      "text": "以及有了精神观念上的指导"
    },
    {
      "ordinal": 138,
      "start_ms": 421299,
      "end_ms": 423500,
      "text": "统一的这个意见的发生"
    },
    {
      "ordinal": 139,
      "start_ms": 423700,
      "end_ms": 426610,
      "text": "经济量的对比就实现了重大的逆转"
    },
    {
      "ordinal": 140,
      "start_ms": 426610,
      "end_ms": 428320,
      "text": "你到时候你敢降工资"
    },
    {
      "ordinal": 141,
      "start_ms": 428320,
      "end_ms": 429130,
      "text": "我就请问你"
    },
    {
      "ordinal": 142,
      "start_ms": 429130,
      "end_ms": 432490,
      "text": "当我有数万工人在我的公寓社区里面吃饭的时"
    },
    {
      "ordinal": 143,
      "start_ms": 432490,
      "end_ms": 432790,
      "text": "候"
    },
    {
      "ordinal": 144,
      "start_ms": 432790,
      "end_ms": 434140,
      "text": "他敢降工资"
    },
    {
      "ordinal": 145,
      "start_ms": 434400,
      "end_ms": 435840,
      "text": "听懂了没有"
    },
    {
      "ordinal": 146,
      "start_ms": 437380,
      "end_ms": 438480,
      "text": "说这些道理"
    },
    {
      "ordinal": 147,
      "start_ms": 440340,
      "end_ms": 442020,
      "text": "未明子这个蠢货却一无所知"
    },
    {
      "ordinal": 148,
      "start_ms": 442020,
      "end_ms": 443580,
      "text": "他哪里来的脸"
    },
    {
      "ordinal": 149,
      "start_ms": 445080,
      "end_ms": 449100,
      "text": "首先这些原教旨如果单纯的理论上运用"
    },
    {
      "ordinal": 150,
      "start_ms": 449100,
      "end_ms": 450360,
      "text": "确实是按照你这样的分析"
    },
    {
      "ordinal": 151,
      "start_ms": 450360,
      "end_ms": 451530,
      "text": "确实是这样变化的"
    },
    {
      "ordinal": 152,
      "start_ms": 451530,
      "end_ms": 453330,
      "text": "但是我们不是原教旨主义"
    },
    {
      "ordinal": 153,
      "start_ms": 453330,
      "end_ms": 454860,
      "text": "我们不是书斋先生"
    },
    {
      "ordinal": 154,
      "start_ms": 463440,
      "end_ms": 464900,
      "text": "现在你想一想"
    },
    {
      "ordinal": 155,
      "start_ms": 464900,
      "end_ms": 466310,
      "text": "你为什么要读黑格尔的"
    },
    {
      "ordinal": 156,
      "start_ms": 466310,
      "end_ms": 467480,
      "text": "后面的东西变了"
    },
    {
      "ordinal": 157,
      "start_ms": 467480,
      "end_ms": 469200,
      "text": "前面的东西也变了"
    },
    {
      "ordinal": 158,
      "start_ms": 469240,
      "end_ms": 473020,
      "text": "现实的后面的后继的这些东西状况变了"
    },
    {
      "ordinal": 159,
      "start_ms": 473020,
      "end_ms": 473860,
      "text": "它为什么能变"
    },
    {
      "ordinal": 160,
      "start_ms": 473860,
      "end_ms": 475560,
      "text": "是因为前面东西正在"
    },
    {
      "ordinal": 161,
      "start_ms": 475560,
      "end_ms": 479280,
      "text": "你说是不是阶级力量对比变化不明显"
    },
    {
      "ordinal": 162,
      "start_ms": 479280,
      "end_ms": 481560,
      "text": "确实这个变化平时是不明显的"
    },
    {
      "ordinal": 163,
      "start_ms": 481560,
      "end_ms": 484290,
      "text": "他只能展现为一点点小的意愿"
    },
    {
      "ordinal": 164,
      "start_ms": 484290,
      "end_ms": 487380,
      "text": "小队员本来工人不愿意在我这里吃免费餐呢"
    },
    {
      "ordinal": 165,
      "start_ms": 487380,
      "end_ms": 488850,
      "text": "他觉得你这个免费的有问题"
    },
    {
      "ordinal": 166,
      "start_ms": 488850,
      "end_ms": 490070,
      "text": "后来他愿意吃了"
    },
    {
      "ordinal": 167,
      "start_ms": 490070,
      "end_ms": 492230,
      "text": "并且他后来还还呼朋引伴的"
    },
    {
      "ordinal": 168,
      "start_ms": 492230,
      "end_ms": 493580,
      "text": "大家都过来吃了"
    },
    {
      "ordinal": 169,
      "start_ms": 494460,
      "end_ms": 496040,
      "text": "这是变化不明显"
    },
    {
      "ordinal": 170,
      "start_ms": 496040,
      "end_ms": 497300,
      "text": "但是这不明显当中"
    },
    {
      "ordinal": 171,
      "start_ms": 497300,
      "end_ms": 500460,
      "text": "酝酿着一个巨大的质变的一种机会"
    },
    {
      "ordinal": 172,
      "start_ms": 501759,
      "end_ms": 503759,
      "text": "所以要求你们读黑格呀"
    },
    {
      "ordinal": 173,
      "start_ms": 503759,
      "end_ms": 504419,
      "text": "你不读黑格"
    },
    {
      "ordinal": 174,
      "start_ms": 504419,
      "end_ms": 505499,
      "text": "你头上那个僵死"
    },
    {
      "ordinal": 175,
      "start_ms": 511780,
      "end_ms": 513220,
      "text": "抛开这一切不说"
    },
    {
      "ordinal": 176,
      "start_ms": 513220,
      "end_ms": 515929,
      "text": "即使按照最上一个角度去理解实践呃"
    },
    {
      "ordinal": 177,
      "start_ms": 515929,
      "end_ms": 516590,
      "text": "实践路线"
    },
    {
      "ordinal": 178,
      "start_ms": 516590,
      "end_ms": 518750,
      "text": "他也不过是一个脑袋浆糊的乞丐版"
    },
    {
      "ordinal": 179,
      "start_ms": 518750,
      "end_ms": 519230,
      "text": "慈善家"
    },
    {
      "ordinal": 180,
      "start_ms": 519230,
      "end_ms": 520919,
      "text": "就是乞丐版慈善家"
    },
    {
      "ordinal": 181,
      "start_ms": 521159,
      "end_ms": 523409,
      "text": "哪有一个乞丐慈善家"
    },
    {
      "ordinal": 182,
      "start_ms": 523409,
      "end_ms": 528040,
      "text": "鲁迅鲁迅手上搞一批文弱书生而已"
    },
    {
      "ordinal": 183,
      "start_ms": 528740,
      "end_ms": 532000,
      "text": "武训在手上拿着十几个教书先生"
    },
    {
      "ordinal": 184,
      "start_ms": 532000,
      "end_ms": 534160,
      "text": "一群小孩童子而已"
    },
    {
      "ordinal": 185,
      "start_ms": 534160,
      "end_ms": 535520,
      "text": "能顶个屁用"
    },
    {
      "ordinal": 186,
      "start_ms": 537840,
      "end_ms": 539180,
      "text": "还乞丐版慈善"
    },
    {
      "ordinal": 187,
      "start_ms": 539180,
      "end_ms": 540320,
      "text": "说马云做慈善"
    },
    {
      "ordinal": 188,
      "start_ms": 540320,
      "end_ms": 541100,
      "text": "马云做慈善"
    },
    {
      "ordinal": 189,
      "start_ms": 541100,
      "end_ms": 544020,
      "text": "难道那个慈善是真的是让大家团结起来"
    },
    {
      "ordinal": 190,
      "start_ms": 550220,
      "end_ms": 551960,
      "text": "或者说是某种改良主义的慈善"
    },
    {
      "ordinal": 191,
      "start_ms": 554740,
      "end_ms": 558460,
      "text": "你根本对于我做的事情的现实意义一无所知"
    },
    {
      "ordinal": 192,
      "start_ms": 558460,
      "end_ms": 560920,
      "text": "完全就是好"
    },
    {
      "ordinal": 193,
      "start_ms": 561940,
      "end_ms": 563310,
      "text": "你屁股好歪"
    },
    {
      "ordinal": 194,
      "start_ms": 563310,
      "end_ms": 564080,
      "text": "你知道吗"
    }
