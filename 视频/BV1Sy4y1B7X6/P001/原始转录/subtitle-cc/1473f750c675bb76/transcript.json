{
  "bvid": "BV1Sy4y1B7X6",
  "page": 1,
  "source": "subtitle-cc",
  "language": "zh-CN",
  "model": null,
  "content_sha256": "1473f750c675bb76b6c05b4d3e5157dcd792e4f3c3705981734aaa8d8a3be574",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 2680,
      "end_ms": 4920,
      "text": "我们接下来讲一个"
    },
    {
      "ordinal": 1,
      "start_ms": 4920,
      "end_ms": 7520,
      "text": "古希腊非常有名的论题"
    },
    {
      "ordinal": 2,
      "start_ms": 7520,
      "end_ms": 9920,
      "text": "叫人不可以两次踏入同一条河流"
    },
    {
      "ordinal": 3,
      "start_ms": 10360,
      "end_ms": 11240,
      "text": "它的正题就是"
    },
    {
      "ordinal": 4,
      "start_ms": 11240,
      "end_ms": 13640,
      "text": "人可以两次踏入同一条河流"
    },
    {
      "ordinal": 5,
      "start_ms": 14160,
      "end_ms": 15160,
      "text": "就是说河流"
    },
    {
      "ordinal": 6,
      "start_ms": 15160,
      "end_ms": 17040,
      "text": "它是可以维持它的同一性的"
    },
    {
      "ordinal": 7,
      "start_ms": 17080,
      "end_ms": 18040,
      "text": "我可以1次2次"
    },
    {
      "ordinal": 8,
      "start_ms": 18080,
      "end_ms": 20000,
      "text": "3次4次地踏入进去"
    },
    {
      "ordinal": 9,
      "start_ms": 20040,
      "end_ms": 21560,
      "text": "它是同一条河流"
    },
    {
      "ordinal": 10,
      "start_ms": 21640,
      "end_ms": 22720,
      "text": "反题就是"
    },
    {
      "ordinal": 11,
      "start_ms": 22760,
      "end_ms": 25000,
      "text": "人不可以两次踏入同一条河流"
    },
    {
      "ordinal": 12,
      "start_ms": 25000,
      "end_ms": 26520,
      "text": "当你第二次踏入的时候"
    },
    {
      "ordinal": 13,
      "start_ms": 26520,
      "end_ms": 28120,
      "text": "它已经不是之前的河流了"
    },
    {
      "ordinal": 14,
      "start_ms": 28120,
      "end_ms": 29440,
      "text": "因为河流你就知道的"
    },
    {
      "ordinal": 15,
      "start_ms": 30560,
      "end_ms": 31720,
      "text": "逝者如斯夫"
    },
    {
      "ordinal": 16,
      "start_ms": 31720,
      "end_ms": 32759,
      "text": "它不停地在流变"
    },
    {
      "ordinal": 17,
      "start_ms": 33000,
      "end_ms": 33880,
      "text": "所以它已经不是"
    },
    {
      "ordinal": 18,
      "start_ms": 33880,
      "end_ms": 35560,
      "text": "你之前踏入的那条河流了"
    },
    {
      "ordinal": 19,
      "start_ms": 36080,
      "end_ms": 37520,
      "text": "那么一个庸俗的辩证法"
    },
    {
      "ordinal": 20,
      "start_ms": 37520,
      "end_ms": 39760,
      "text": "会把这两个意思都包含进去"
    },
    {
      "ordinal": 21,
      "start_ms": 40760,
      "end_ms": 43200,
      "text": "它就说叫做“人不可能"
    },
    {
      "ordinal": 22,
      "start_ms": 43240,
      "end_ms": 45520,
      "text": "一次踏入同一条河流”"
    },
    {
      "ordinal": 23,
      "start_ms": 45680,
      "end_ms": 46240,
      "text": "它为什么说"
    },
    {
      "ordinal": 24,
      "start_ms": 46240,
      "end_ms": 47520,
      "text": "把两个意思都包含进去了呢？"
    },
    {
      "ordinal": 25,
      "start_ms": 47680,
      "end_ms": 48720,
      "text": "因为一方面"
    },
    {
      "ordinal": 26,
      "start_ms": 48760,
      "end_ms": 49880,
      "text": "它的意思是"
    },
    {
      "ordinal": 27,
      "start_ms": 49960,
      "end_ms": 51880,
      "text": "人踏入河流的行为"
    },
    {
      "ordinal": 28,
      "start_ms": 51880,
      "end_ms": 53520,
      "text": "本身是间断的"
    },
    {
      "ordinal": 29,
      "start_ms": 53520,
      "end_ms": 55480,
      "text": "你这个行为本身是不能够"
    },
    {
      "ordinal": 30,
      "start_ms": 55520,
      "end_ms": 57080,
      "text": "说是“一次”的行为"
    },
    {
      "ordinal": 31,
      "start_ms": 57200,
      "end_ms": 58680,
      "text": "你每当踏入一个东西的时候"
    },
    {
      "ordinal": 32,
      "start_ms": 58680,
      "end_ms": 59520,
      "text": "就已经是"
    },
    {
      "ordinal": 33,
      "start_ms": 60120,
      "end_ms": 61360,
      "text": "你没办法说你"
    },
    {
      "ordinal": 34,
      "start_ms": 61640,
      "end_ms": 62800,
      "text": "在执行【一个】动作"
    },
    {
      "ordinal": 35,
      "start_ms": 62840,
      "end_ms": 65080,
      "text": "你是在不停地执行不同的动作的"
    },
    {
      "ordinal": 36,
      "start_ms": 65080,
      "end_ms": 67040,
      "text": "所以你只要你是踏入河流"
    },
    {
      "ordinal": 37,
      "start_ms": 67040,
      "end_ms": 68920,
      "text": "你就是在踏入两次以上"
    },
    {
      "ordinal": 38,
      "start_ms": 68920,
      "end_ms": 70280,
      "text": "这就等于说合题"
    },
    {
      "ordinal": 39,
      "start_ms": 70280,
      "end_ms": 71720,
      "text": "就等同于第一个正题"
    },
    {
      "ordinal": 40,
      "start_ms": 71840,
      "end_ms": 72560,
      "text": "在另一方面"
    },
    {
      "ordinal": 41,
      "start_ms": 72720,
      "end_ms": 73040,
      "text": "这个合题"
    },
    {
      "ordinal": 42,
      "start_ms": 73080,
      "end_ms": 73680,
      "text": "也可以说是"
    },
    {
      "ordinal": 43,
      "start_ms": 73720,
      "end_ms": 74760,
      "text": "就等于它的反题"
    },
    {
      "ordinal": 44,
      "start_ms": 74800,
      "end_ms": 75640,
      "text": "也就是说"
    },
    {
      "ordinal": 45,
      "start_ms": 76200,
      "end_ms": 77520,
      "text": "河流是不停地在变的"
    },
    {
      "ordinal": 46,
      "start_ms": 77560,
      "end_ms": 78440,
      "text": "你一踏进去"
    },
    {
      "ordinal": 47,
      "start_ms": 78440,
      "end_ms": 80200,
      "text": "它就不是之前那条河流了"
    },
    {
      "ordinal": 48,
      "start_ms": 80200,
      "end_ms": 81320,
      "text": "它不停地在变"
    },
    {
      "ordinal": 49,
      "start_ms": 83000,
      "end_ms": 83880,
      "text": "你刚踏进去"
    },
    {
      "ordinal": 50,
      "start_ms": 83880,
      "end_ms": 84840,
      "text": "这河流就变了"
    },
    {
      "ordinal": 51,
      "start_ms": 84840,
      "end_ms": 86600,
      "text": "所以你就没有办法说你"
    },
    {
      "ordinal": 52,
      "start_ms": 87840,
      "end_ms": 89480,
      "text": "踏进去的是同一条河流"
    },
    {
      "ordinal": 53,
      "start_ms": 89680,
      "end_ms": 91840,
      "text": "所以合题"
    },
    {
      "ordinal": 54,
      "start_ms": 91880,
      "end_ms": 92320,
      "text": "也就是说"
    },
    {
      "ordinal": 55,
      "start_ms": 92320,
      "end_ms": 94960,
      "text": "人不能一次踏入同一条河流"
    },
    {
      "ordinal": 56,
      "start_ms": 94960,
      "end_ms": 97640,
      "text": "它其实把正题和反题两个意思"
    },
    {
      "ordinal": 57,
      "start_ms": 97640,
      "end_ms": 98560,
      "text": "结合起来了"
    },
    {
      "ordinal": 58,
      "start_ms": 98560,
      "end_ms": 100400,
      "text": "但是它是通过一种"
    },
    {
      "ordinal": 59,
      "start_ms": 100400,
      "end_ms": 101880,
      "text": "如果用哲学里面的术语"
    },
    {
      "ordinal": 60,
      "start_ms": 101880,
      "end_ms": 103120,
      "text": "他就是那种视差"
    },
    {
      "ordinal": 61,
      "start_ms": 103120,
      "end_ms": 104720,
      "text": "就好像、就好像"
    },
    {
      "ordinal": 62,
      "start_ms": 106240,
      "end_ms": 107120,
      "text": "两个人脸"
    },
    {
      "ordinal": 63,
      "start_ms": 107160,
      "end_ms": 109360,
      "text": "组成一个漏斗的那种形式"
    },
    {
      "ordinal": 64,
      "start_ms": 109720,
      "end_ms": 111480,
      "text": "就两个人脸中间夹了一个漏斗"
    },
    {
      "ordinal": 65,
      "start_ms": 111520,
      "end_ms": 113000,
      "text": "你可以看到有人脸存在"
    },
    {
      "ordinal": 66,
      "start_ms": 113000,
      "end_ms": 115080,
      "text": "你也可以看到有漏斗存在"
    },
    {
      "ordinal": 67,
      "start_ms": 115120,
      "end_ms": 116360,
      "text": "采用视差的方式"
    },
    {
      "ordinal": 68,
      "start_ms": 116400,
      "end_ms": 117720,
      "text": "把这正题和反题"
    },
    {
      "ordinal": 69,
      "start_ms": 117720,
      "end_ms": 119480,
      "text": "并到这一个论题里面去了"
    },
    {
      "ordinal": 70,
      "start_ms": 120320,
      "end_ms": 120800,
      "text": "不理解的"
    },
    {
      "ordinal": 71,
      "start_ms": 120840,
      "end_ms": 122440,
      "text": "你可以重新切回去看它"
    },
    {
      "ordinal": 72,
      "start_ms": 122440,
      "end_ms": 123000,
      "text": "为什么"
    },
    {
      "ordinal": 73,
      "start_ms": 123240,
      "end_ms": 124920,
      "text": "它可以把这一个论题"
    },
    {
      "ordinal": 74,
      "start_ms": 125040,
      "end_ms": 127120,
      "text": "一个论题里面包含两种意思"
    },
    {
      "ordinal": 75,
      "start_ms": 127480,
      "end_ms": 129919,
      "text": "那么这是一种虚假的合题"
    },
    {
      "ordinal": 76,
      "start_ms": 129919,
      "end_ms": 131440,
      "text": "因为它实际上是一种整体主义"
    },
    {
      "ordinal": 77,
      "start_ms": 131480,
      "end_ms": 132680,
      "text": "是把两个意思拼起来"
    },
    {
      "ordinal": 78,
      "start_ms": 132720,
      "end_ms": 134440,
      "text": "只不过是用一种比较高明的方式"
    },
    {
      "ordinal": 79,
      "start_ms": 134440,
      "end_ms": 135560,
      "text": "所谓的诡辩论的方式"
    },
    {
      "ordinal": 80,
      "start_ms": 135560,
      "end_ms": 136120,
      "text": "给它拼起来"
    },
    {
      "ordinal": 81,
      "start_ms": 136160,
      "end_ms": 137840,
      "text": "它的结果就是破坏了"
    },
    {
      "ordinal": 82,
      "start_ms": 138080,
      "end_ms": 140240,
      "text": "不仅破坏了人的行为的同一性"
    },
    {
      "ordinal": 83,
      "start_ms": 140240,
      "end_ms": 142520,
      "text": "也破坏了事物本身的同一性"
    },
    {
      "ordinal": 84,
      "start_ms": 142840,
      "end_ms": 143920,
      "text": "这些东西都是断裂的"
    },
    {
      "ordinal": 85,
      "start_ms": 143920,
      "end_ms": 144480,
      "text": "碎裂的"
    },
    {
      "ordinal": 86,
      "start_ms": 144480,
      "end_ms": 146080,
      "text": "不可能说它是同一个"
    },
    {
      "ordinal": 87,
      "start_ms": 146280,
      "end_ms": 147520,
      "text": "那么它的核心是什么"
    },
    {
      "ordinal": 88,
      "start_ms": 147520,
      "end_ms": 149840,
      "text": "它的核心就是转换重音"
    },
    {
      "ordinal": 89,
      "start_ms": 150160,
      "end_ms": 153440,
      "text": "转换不在于【两次】和【同一】"
    },
    {
      "ordinal": 90,
      "start_ms": 153440,
      "end_ms": 156240,
      "text": "就不在于分裂和同一之间的这种"
    },
    {
      "ordinal": 91,
      "start_ms": 156240,
      "end_ms": 156800,
      "text": "矛盾"
    },
    {
      "ordinal": 92,
      "start_ms": 157000,
      "end_ms": 157680,
      "text": "重音的转换"
    },
    {
      "ordinal": 93,
      "start_ms": 157720,
      "end_ms": 159240,
      "text": "我们把它转换到"
    },
    {
      "ordinal": 94,
      "start_ms": 159280,
      "end_ms": 161160,
      "text": "正题里面的前三个字"
    },
    {
      "ordinal": 95,
      "start_ms": 161200,
      "end_ms": 162440,
      "text": "【人可以】"
    },
    {
      "ordinal": 96,
      "start_ms": 163160,
      "end_ms": 164600,
      "text": "一个同一的东西"
    },
    {
      "ordinal": 97,
      "start_ms": 164600,
      "end_ms": 166040,
      "text": "【人可以】两次"
    },
    {
      "ordinal": 98,
      "start_ms": 166040,
      "end_ms": 167160,
      "text": "也就是说"
    },
    {
      "ordinal": 99,
      "start_ms": 167440,
      "end_ms": 170480,
      "text": "【人可以】在一个同一的东西当中"
    },
    {
      "ordinal": 100,
      "start_ms": 170480,
      "end_ms": 173000,
      "text": "去把握差异"
    },
    {
      "ordinal": 101,
      "start_ms": 173000,
      "end_ms": 176680,
      "text": "人也可以在一个"
    },
    {
      "ordinal": 102,
      "start_ms": 176720,
      "end_ms": 177720,
      "text": "两次不一样的东西之间"
    },
    {
      "ordinal": 103,
      "start_ms": 177720,
      "end_ms": 179600,
      "text": "去把握所谓的同一性"
    },
    {
      "ordinal": 104,
      "start_ms": 180240,
      "end_ms": 182120,
      "text": "这是人独有的一种能力"
    },
    {
      "ordinal": 105,
      "start_ms": 182400,
      "end_ms": 183160,
      "text": "普罗泰戈拉说"
    },
    {
      "ordinal": 106,
      "start_ms": 183160,
      "end_ms": 184440,
      "text": "人是万物的尺度"
    },
    {
      "ordinal": 107,
      "start_ms": 184720,
      "end_ms": 186160,
      "text": "所以其实诡辩论"
    },
    {
      "ordinal": 108,
      "start_ms": 186160,
      "end_ms": 187760,
      "text": "想要表明的就是这一点"
    },
    {
      "ordinal": 109,
      "start_ms": 188120,
      "end_ms": 190520,
      "text": "唯有人可以说"
    },
    {
      "ordinal": 110,
      "start_ms": 190560,
      "end_ms": 193560,
      "text": "两次踏入同一条河流，人的行为"
    },
    {
      "ordinal": 111,
      "start_ms": 193560,
      "end_ms": 195480,
      "text": "可以在同一当中生出差异"
    },
    {
      "ordinal": 112,
      "start_ms": 195480,
      "end_ms": 196560,
      "text": "可以在差异当中"
    },
    {
      "ordinal": 113,
      "start_ms": 196560,
      "end_ms": 198000,
      "text": "去把握这种同一"
    },
    {
      "ordinal": 114,
      "start_ms": 198000,
      "end_ms": 199400,
      "text": "只要我们把重音"
    },
    {
      "ordinal": 115,
      "start_ms": 199440,
      "end_ms": 200280,
      "text": "转化到"
    },
    {
      "ordinal": 116,
      "start_ms": 200280,
      "end_ms": 200640,
      "text": "人可以"
    },
    {
      "ordinal": 117,
      "start_ms": 200680,
      "end_ms": 201240,
      "text": "这三个字"
    },
    {
      "ordinal": 118,
      "start_ms": 201280,
      "end_ms": 203240,
      "text": "我们就能够把握到"
    },
    {
      "ordinal": 119,
      "start_ms": 203280,
      "end_ms": 205480,
      "text": "它真正的合题是什么"
    }
  ],
