{"segments":[{"start":0.32,"end":2.63,"text":"呃一段时间以来啊"},{"start":2.63,"end":5.87,"text":"有许多不法分子啊"},{"start":5.87,"end":10.669,"text":"以捏造的虚假指控啊"},{"start":10.669,"end":12.139,"text":"捏造的事实"},{"start":12.139,"end":15.84,"text":"诽谤性的侮辱性的内容啊"},{"start":16.5,"end":19.43,"text":"对我本人啊"},{"start":19.43,"end":27.36,"text":"以及我们团队呢进行无底线啊打击报复"},{"start":28.06,"end":31.47,"text":"他们的目的呢是要置我于死地"},{"start":31.47,"end":32.9,"text":"某些人"},{"start":35.18,"end":39.34,"text":"知乎平台上面公开说过一句话"},{"start":39.34,"end":41.98,"text":"说不把我送到牢里去"},{"start":41.98,"end":43.18,"text":"绝不罢休"},{"start":46.76,"end":47.739,"text":"这个人呢"},{"start":48.1,"end":52.0,"text":"他在他的知乎的一条动态里面"},{"start":52.0,"end":53.74,"text":"是明确这样说的啊"},{"start":53.74,"end":58.42,"text":"他还说要用什么暴力的手段来对付我啊"},{"start":58.42,"end":63.16,"text":"这些证据呢他自己在跟我打官司的时候"},{"start":63.16,"end":67.08,"text":"他自己都承认这些证据的真实性呢是很明确的"},{"start":67.08,"end":68.4,"text":"是要对我进行打击报复的"},{"start":68.4,"end":71.16,"text":"而且很明确的说要把我送进牢里的"},{"start":73.54,"end":78.36,"text":"啊黑纸白字的说要把我送到牢里去啊"},{"start":81.12,"end":82.34,"text":"他自己啊"},{"start":82.34,"end":85.399,"text":"他现在还要对我发起第二次这个诉讼啊"},{"start":87.0,"end":88.88,"text":"那么在发起这个诉讼之前呢"},{"start":88.88,"end":95.24,"text":"我也遭受了很多这样的啊不时的举报啊"},{"start":95.24,"end":97.86,"text":"打击报复啊"},{"start":100.02,"end":105.11,"text":"啊误导啊误导这个公安机关"},{"start":105.11,"end":107.8,"text":"误导安全机关啊"},{"start":107.8,"end":109.12,"text":"要欺骗他们"},{"start":109.12,"end":110.83,"text":"要对我进行啊"},{"start":110.83,"end":115.47,"text":"这个啊要借助这些力量对我进行打击报复"},{"start":115.47,"end":119.44,"text":"那么我幸存下来了"},{"start":119.44,"end":121.48,"text":"我活下来了啊"},{"start":121.48,"end":122.5,"text":"我幸存下来了"},{"start":122.5,"end":123.76,"text":"我活下来了"},{"start":123.76,"end":129.899,"text":"那么我做的事情呢是完全合法的啊"},{"start":129.899,"end":132.449,"text":"完全合法的啊"},{"start":132.449,"end":134.52,"text":"否则我被立案调查了呀"},{"start":134.859,"end":136.98,"text":"我做的事情完全合法"},{"start":138.42,"end":142.88,"text":"但是呢在意识形态上可能稍显敏感啊"},{"start":142.88,"end":151.219,"text":"但是有可能会啊造成相应的一些舆论的风波啊"},{"start":151.219,"end":157.039,"text":"或者说一些啊容易产生嗯人们误解的啊"},{"start":157.039,"end":158.98,"text":"或者让人们感到困惑的"},{"start":160.14,"end":164.98,"text":"还有一些互联网景观层面的一些影响"},{"start":165.16,"end":168.52,"text":"所以我们做了适当的调整啊"},{"start":168.619,"end":174.109,"text":"我们把名义和口号啊进行了一个去敏感化"},{"start":174.109,"end":175.459,"text":"去异形内化"},{"start":175.459,"end":183.619,"text":"我们也对一些啊我们本来思量不周的做法啊"},{"start":183.619,"end":185.14,"text":"比较这个"},{"start":187.7,"end":194.859,"text":"相对比较粗糙的啊啊我们进行了一个反省啊"},{"start":194.859,"end":196.62,"text":"进行了一个调整"},{"start":199.64,"end":200.98,"text":"所以我幸存下来的"},{"start":200.98,"end":201.88,"text":"我活下来了"},{"start":201.88,"end":204.22,"text":"你们这些打击报复啊"},{"start":204.22,"end":207.12,"text":"你们这些什么报假警啊啊"},{"start":208.14,"end":212.38,"text":"就是各方面的捏造诽谤啊"},{"start":212.38,"end":214.3,"text":"你们在那些群里面啊"},{"start":214.3,"end":216.31,"text":"这个是一天到晚24小时"},{"start":216.31,"end":218.5,"text":"感觉都在想各式样的点子啊"},{"start":218.5,"end":219.4,"text":"要把我弄进去"},{"start":219.4,"end":220.5,"text":"要让我坐牢"},{"start":221.52,"end":224.06,"text":"这些图谋是注定失败的"},{"start":224.06,"end":227.829,"text":"我活下来了啊"},{"start":227.829,"end":232.709,"text":"并且我把我掌握到的关于你们的情况啊"},{"start":232.709,"end":234.6,"text":"也做了相应的反应"},{"start":234.899,"end":237.389,"text":"你们可以继续试着啊"},{"start":237.389,"end":239.399,"text":"再继续递交假材料啊"},{"start":239.399,"end":241.56,"text":"在地区继续报假警"},{"start":241.959,"end":247.29,"text":"你们看上黑名单的是你们还是我啊"},{"start":247.29,"end":251.7,"text":"我奉劝你们赶紧停止这样的打击报复的行动"},{"start":251.7,"end":255.27,"text":"赶紧停止这样的捏造事实"},{"start":255.27,"end":257.64,"text":"诽谤的违法犯罪的行动"},{"start":261.98,"end":265.32,"text":"嗯你不停止的话"},{"start":265.32,"end":268.5,"text":"那只能说你你在为这个公安机关啊"},{"start":268.5,"end":271.45,"text":"或者安全机关的办案提供进一步的线索"},{"start":271.45,"end":273.55,"text":"让他们更快的锁定你们是谁啊"},{"start":273.55,"end":275.78,"text":"你们到底为什么要做这样的事情啊"},{"start":276.06,"end":277.98,"text":"啊要对啊"},{"start":277.98,"end":279.27,"text":"因为爱国的"},{"start":282.319,"end":285.019,"t