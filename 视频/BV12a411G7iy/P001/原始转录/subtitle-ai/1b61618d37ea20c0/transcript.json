{
  "bvid": "BV12a411G7iy",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "1b61618d37ea20c0a6de0e02d7b79df19b753a0606175ea7c085bb1bde70f7b3",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 120,
      "end_ms": 5359,
      "text": "我们今天讲一个简单的道理叫做自保不足"
    },
    {
      "ordinal": 1,
      "start_ms": 7040,
      "end_ms": 9640,
      "text": "则进取有余"
    },
    {
      "ordinal": 2,
      "start_ms": 14559,
      "end_ms": 16769,
      "text": "这个对于成语的话用啊"
    },
    {
      "ordinal": 3,
      "start_ms": 16769,
      "end_ms": 21940,
      "text": "甚至其实对应的就是说生于忧患"
    },
    {
      "ordinal": 4,
      "start_ms": 24120,
      "end_ms": 25500,
      "text": "死冤了"
    },
    {
      "ordinal": 5,
      "start_ms": 28300,
      "end_ms": 29670,
      "text": "自保不足"
    },
    {
      "ordinal": 6,
      "start_ms": 29670,
      "end_ms": 33720,
      "text": "其实结合我个人我就叫自保不足啊"
    },
    {
      "ordinal": 7,
      "start_ms": 33720,
      "end_ms": 37010,
      "text": "我总觉得就是说比如说我考编"
    },
    {
      "ordinal": 8,
      "start_ms": 37010,
      "end_ms": 41340,
      "text": "我觉得那个日子我过不过不了"
    },
    {
      "ordinal": 9,
      "start_ms": 41340,
      "end_ms": 42600,
      "text": "就让我去"
    },
    {
      "ordinal": 10,
      "start_ms": 50400,
      "end_ms": 51560,
      "text": "搞文化产业"
    },
    {
      "ordinal": 11,
      "start_ms": 51560,
      "end_ms": 53000,
      "text": "搞大自然一附庸"
    },
    {
      "ordinal": 12,
      "start_ms": 53000,
      "end_ms": 56520,
      "text": "我又觉得我会被异化啊"
    },
    {
      "ordinal": 13,
      "start_ms": 56520,
      "end_ms": 57739,
      "text": "很严重"
    },
    {
      "ordinal": 14,
      "start_ms": 58080,
      "end_ms": 59220,
      "text": "你晕吗"
    },
    {
      "ordinal": 15,
      "start_ms": 59220,
      "end_ms": 61200,
      "text": "就说自保不足"
    },
    {
      "ordinal": 16,
      "start_ms": 61200,
      "end_ms": 63840,
      "text": "当你看到你可走的那些路啊"
    },
    {
      "ordinal": 17,
      "start_ms": 63840,
      "end_ms": 68700,
      "text": "你走下去就是虽然目前还算过得去"
    },
    {
      "ordinal": 18,
      "start_ms": 68700,
      "end_ms": 69600,
      "text": "但是长远来看"
    },
    {
      "ordinal": 19,
      "start_ms": 69600,
      "end_ms": 71100,
      "text": "那种生活不值得过"
    },
    {
      "ordinal": 20,
      "start_ms": 71100,
      "end_ms": 72150,
      "text": "没意思"
    },
    {
      "ordinal": 21,
      "start_ms": 72150,
      "end_ms": 77170,
      "text": "那种生活唯一历史潮流在我在我"
    },
    {
      "ordinal": 22,
      "start_ms": 77170,
      "end_ms": 78780,
      "text": "我不是指这个生活"
    },
    {
      "ordinal": 23,
      "start_ms": 78780,
      "end_ms": 80580,
      "text": "本来不是指你考编去当公务员"
    },
    {
      "ordinal": 24,
      "start_ms": 80580,
      "end_ms": 82140,
      "text": "或者说你去文化产业"
    },
    {
      "ordinal": 25,
      "start_ms": 82140,
      "end_ms": 85020,
      "text": "我是觉得对于我在这些行当里"
    },
    {
      "ordinal": 26,
      "start_ms": 85020,
      "end_ms": 91530,
      "text": "面我觉得唯一例至少为例我本人的一个发展的我我就我就不是个性子"
    },
    {
      "ordinal": 27,
      "start_ms": 91530,
      "end_ms": 92730,
      "text": "要自保不足"
    },
    {
      "ordinal": 28,
      "start_ms": 92730,
      "end_ms": 97720,
      "text": "觉得自己如果去去掉这些别人觉得香饽饽"
    },
    {
      "ordinal": 29,
      "start_ms": 97720,
      "end_ms": 98980,
      "text": "不是觉得很有意义"
    },
    {
      "ordinal": 30,
      "start_ms": 98980,
      "end_ms": 101050,
      "text": "很有很有价值的这些行当"
    },
    {
      "ordinal": 31,
      "start_ms": 101050,
      "end_ms": 102760,
      "text": "但是就觉得我去的话"
    },
    {
      "ordinal": 32,
      "start_ms": 102760,
      "end_ms": 104560,
      "text": "我就我受不了"
    },
    {
      "ordinal": 33,
      "start_ms": 104560,
      "end_ms": 104980,
      "text": "你知道吗"
    },
    {
      "ordinal": 34,
      "start_ms": 104980,
      "end_ms": 106690,
      "text": "我看不惯胡说"
    },
    {
      "ordinal": 35,
      "start_ms": 106690,
      "end_ms": 109000,
      "text": "我就我你打死我"
    },
    {
      "ordinal": 36,
      "start_ms": 109000,
      "end_ms": 110710,
      "text": "你打你打我撒"
    },
    {
      "ordinal": 37,
      "start_ms": 110710,
      "end_ms": 112520,
      "text": "就是你弄死我"
    },
    {
      "ordinal": 38,
      "start_ms": 112520,
      "end_ms": 116180,
      "text": "我都不想像里面那些规则屈服"
    },
    {
      "ordinal": 39,
      "start_ms": 116180,
      "end_ms": 118280,
      "text": "我在里面我完全守不住了"
    },
    {
      "ordinal": 40,
      "start_ms": 118280,
      "end_ms": 122520,
      "text": "我守不住自己叫做自保不足"
    },
    {
      "ordinal": 41,
      "start_ms": 122520,
      "end_ms": 125550,
      "text": "我是在这些行当里面守不住自己"
    },
    {
      "ordinal": 42,
      "start_ms": 125550,
      "end_ms": 127920,
      "text": "那就不得不进取有余"
    },
    {
      "ordinal": 43,
      "start_ms": 127920,
      "end_ms": 129180,
      "text": "要闯出"
    },
    {
      "ordinal": 44,
      "start_ms": 130239,
      "end_ms": 133780,
      "text": "闯出一条路出来啊"
    },
    {
      "ordinal": 45,
      "start_ms": 133780,
      "end_ms": 137020,
      "text": "要很努力地闯出一条自己的道路"
    },
    {
      "ordinal": 46,
      "start_ms": 137020,
      "end_ms": 137500,
      "text": "出来"
    },
    {
      "ordinal": 47,
      "start_ms": 137500,
      "end_ms": 140989,
      "text": "但是关键问题是这种闯出一条路"
    },
    {
      "ordinal": 48,
      "start_ms": 140989,
      "end_ms": 142579,
      "text": "进取有余"
    },
    {
      "ordinal": 49,
      "start_ms": 142579,
      "end_ms": 150880,
      "text": "它会使你处在一种我我甚至可以说一个长期的一个亢奋状态"
    },
    {
      "ordinal": 50,
      "start_ms": 150880,
      "end_ms": 152800,
      "text": "长期的亢奋状态"
    },
    {
      "ordinal": 51,
      "start_ms": 153200,
      "end_ms": 157559,
      "text": "这个长期的亢奋状态就是你的自保不足"
    },
    {
      "ordinal": 52,
      "start_ms": 157559,
      "end_ms": 160769,
      "text": "让你处在一个极度忧患的"
    },
    {
      "ordinal": 53,
      "start_ms": 160769,
      "end_ms": 166950,
      "text": "极度紧张紧迫的一种啊持续行动的一个状态"
    },
    {
      "ordinal": 54,
      "start_ms": 166950,
      "end_ms": 170100,
      "text": "在这种持续行动的状态之下"
    },
    {
      "ordinal": 55,
      "start_ms": 170420,
      "end_ms": 172520,
      "text": "你会面临一个问题"
    },
    {
      "ordinal": 56,
      "start_ms": 172520,
      "end_ms": 174410,
      "text": "就是你的进取有余"
    },
    {
      "ordinal": 57,
      "start_ms": 174410,
      "end_ms": 175910,
      "text": "你的进取啊"
    },
    {
      "ordinal": 58,
      "start_ms": 175910,
      "end_ms": 182220,
      "text": "尤其是这种有余额"
    },
    {
      "ordinal": 59,
      "start_ms": 182220,
      "end_ms": 185080,
      "text": "可以说是诅咒性质"
    },
    {
      "ordinal": 60,
      "start_ms": 185519,
      "end_ms": 187109,
      "text": "诅咒性的"
    },
    {
      "ordinal": 61,
      "start_ms": 187109,
      "end_ms": 191279,
      "text": "你比如说呃我连续以这个星期一天"
    },
    {
      "ordinal": 62,
      "start_ms": 191279,
      "end_ms": 194140,
      "text": "就就是处在一种"
    },
    {
      "ordinal": 63,
      "start_ms": 196820,
      "end_ms": 200579,
      "text": "处在一种你会很有节律"
    },
    {
      "ordinal": 64,
      "start_ms": 200579,
      "end_ms": 206570,
      "text": "但是你的节律呢是完全服从于意志的"
    },
    {
      "ordinal": 65,
      "start_ms": 206570,
      "end_ms": 209160,
      "text": "可以说完全服从于意志的"
    },
    {
      "ordinal": 66,
      "start_ms": 210880,
      "end_ms": 212420,
      "text": "意志本身"
    },
    {
      "ordinal": 67,
      "start_ms": 215600,
      "end_ms": 220860,
      "text": "理论上可以呃协调"
    },
    {
      "ordinal": 68,
      "start_ms": 222700,
      "end_ms": 223620,
      "text": "操控"
    },
    {
      "ordinal": 69,
      "start_ms": 225780,
      "end_ms": 227820,
      "text": "你的绝大部分的"
    },
    {
      "ordinal": 70,
      "start_ms": 230300,
      "end_ms": 232900,
      "text": "行为和这个"
    },
    {
      "ordinal": 71,
      "start_ms": 234940,
      "end_ms": 236640,
      "text": "机体的反应"
    },
    {
      "ordinal": 72,
      "start_ms": 238399,
      "end_ms": 245299,
      "text": "机体的那种就是我机体的显露出来的"
    },
    {
      "ordinal": 73,
      "start_ms": 245299,
      "end_ms": 254400,
      "text": "这个肌肉开始要受到自主意识控制的那种反反馈啊"
    },
    {
      "ordinal": 74,
      "start_ms": 258379,
      "end_ms": 260319,
      "text": "那么这个东西就是有余的"
    },
    {
      "ordinal": 75,
      "start_ms": 260319,
      "end_ms": 261668,
      "text": "他始终是个有余的"
    },
    {
      "ordinal": 76,
      "start_ms": 261668,
      "end_ms": 264069,
      "text": "我们往往把这个东西叫做意志力啊"
    },
    {
      "ordinal": 77,
      "start_ms": 264069,
      "end_ms": 268689,
      "text": "意志力这个意志力本身是围绕着你的目的的"
    },
    {
      "ordinal": 78,
      "start_ms": 268689,
      "end_ms": 270009,
      "text": "围绕你的目的"
    },
    {
      "ordinal": 79,
      "start_ms": 270009,
      "end_ms": 272360,
      "text": "你的目的就是要进取"
    },
    {
      "ordinal": 80,
      "start_ms": 275220,
      "end_ms": 281930,
      "text": "那么这个进取就是要进取一个在自保不足的情况之下"
    },
    {
      "ordinal": 81,
      "start_ms": 281930,
      "end_ms": 284880,
      "text": "你能追求的其实就是互保"
    },
    {
      "ordinal": 82,
      "start_ms": 285620,
      "end_ms": 288730,
      "text": "互保就是共同守卫"
    },
    {
      "ordinal": 83,
      "start_ms": 288730,
      "end_ms": 291820,
      "text": "共同守卫一个"
    },
    {
      "ordinal": 84,
      "start_ms": 294160,
      "end_ms": 299420,
      "text": "制度性的一个价值或者共同守卫一个底线性的价值"
    },
    {
      "ordinal": 85,
      "start_ms": 299800,
      "end_ms": 301240,
      "text": "底线性的价值"
    },
    {
      "ordinal": 86,
      "start_ms": 301240,
      "end_ms": 303220,
      "text": "所以它的力量是深沉的力"
    },
    {
      "ordinal": 87,
      "start_ms": 303220,
      "end_ms": 304380,
      "text": "从地起"
    },
    {
      "ordinal": 88,
      "start_ms": 305740,
      "end_ms": 307320,
      "text": "为什么这力量是生成"
    },
    {
      "ordinal": 89,
      "start_ms": 307320,
      "end_ms": 312220,
      "text": "因为你所守卫的共同守卫的是一个底线性的价值"
    },
    {
      "ordinal": 90,
      "start_ms": 312659,
      "end_ms": 314639,
      "text": "是一个底线性的价值啊"
    },
    {
      "ordinal": 91,
      "start_ms": 314639,
      "end_ms": 316400,
      "text": "这个底线性的价值"
    },
    {
      "ordinal": 92,
      "start_ms": 316640,
      "end_ms": 324970,
      "text": "目前高考就是说在那时他是受到持续的实质性的损害的"
    },
    {
      "ordinal": 93,
      "start_ms": 324970,
      "end_ms": 332120,
      "text": "就有好多好多人他的未来是就是不仅是自保不足"
    },
    {
      "ordinal": 94,
      "start_ms": 332120,
      "end_ms": 333680,
      "text": "而是自保"
    },
    {
      "ordinal": 95,
      "start_ms": 335300,
      "end_ms": 337540,
      "text": "甚为悲观"
    },
    {
      "ordinal": 96,
      "start_ms": 337719,
      "end_ms": 339879,
      "text": "就是死死沟渠"
    },
    {
      "ordinal": 97,
      "start_ms": 339879,
      "end_ms": 344300,
      "text": "或者说死在互有死在陋室当中"
    },
    {
      "ordinal": 98,
      "start_ms": 344300,
      "end_ms": 351660,
      "text": "你看他这底线性价值是可以说是严重的出现危机和损害的"
    },
    {
      "ordinal": 99,
      "start_ms": 351660,
      "end_ms": 353740,
      "text": "那你只要看到这一点"
    },
    {
      "ordinal": 100,
      "start_ms": 353760,
      "end_ms": 360360,
      "text": "看到你的自保不足是来自于底线性价值的严重受损状态"
    },
    {
      "ordinal": 101,
      "start_ms": 361639,
      "end_ms": 364419,
      "text": "那你那你肯定会进去犹豫"
    },
    {
      "ordinal": 102,
      "start_ms": 364419,
      "end_ms": 369370,
      "text": "然后你这个进去就是指向的就是共同守卫这个底线性价值"
    },
    {
      "ordinal": 103,
      "start_ms": 369370,
      "end_ms": 370420,
      "text": "就共同守卫"
    },
    {
      "ordinal": 104,
      "start_ms": 370420,
      "end_ms": 372800,
      "text": "说穿了养老医疗"
    },
    {
      "ordinal": 105,
      "start_ms": 373599,
      "end_ms": 376749,
      "text": "还有一个就是如果我们说人口再生产"
    },
    {
      "ordinal": 106,
      "start_ms": 376749,
      "end_ms": 382460,
      "text": "就是呃晚年生活质量的一个通过血缘纽带的一个保障"
    },
    {
      "ordinal": 107,
      "start_ms": 383120,
      "end_ms": 384220,
      "text": "在这个意义上讲"
    },
    {
      "ordinal": 108,
      "start_ms": 384220,
      "end_ms": 389300,
      "text": "你是所以说我们话用那个高数老师说的"
    },
    {
      "ordinal": 109,
      "start_ms": 389300,
      "end_ms": 390680,
      "text": "你怎么睡得着觉"
    },
    {
      "ordinal": 110,
      "start_ms": 404730,
      "end_ms": 407100,
      "text": "或者说他是一个奋斗逼"
    },
    {
      "ordinal": 111,
      "start_ms": 407100,
      "end_ms": 411040,
      "text": "或者说他是一个有某种精英主义色彩"
    },
    {
      "ordinal": 112,
      "start_ms": 411040,
      "end_ms": 412360,
      "text": "就学历卷上去了"
    },
    {
      "ordinal": 113,
      "start_ms": 414719,
      "end_ms": 418319,
      "text": "但是这句话我觉得同样适用于"
    },
    {
      "ordinal": 114,
      "start_ms": 418319,
      "end_ms": 424100,
      "text": "就是说不仅仅这种啊这种自保不足"
    },
    {
      "ordinal": 115,
      "start_ms": 424100,
      "end_ms": 425000,
      "text": "所以进取有余"
    },
    {
      "ordinal": 116,
      "start_ms": 425000,
      "end_ms": 426380,
      "text": "不仅仅回答了一个问题"
    },
    {
      "ordinal": 117,
      "start_ms": 426380,
      "end_ms": 427400,
      "text": "你怎么睡得着觉"
    },
    {
      "ordinal": 118,
      "start_ms": 427400,
      "end_ms": 430230,
      "text": "就是说你怎么睡得着觉"
    },
    {
      "ordinal": 119,
      "start_ms": 430230,
      "end_ms": 435499,
      "text": "一方面就是它是一种它是一种他这种压迫"
    },
    {
      "ordinal": 120,
      "start_ms": 435499,
      "end_ms": 437299,
      "text": "是一种道道德压迫"
    },
    {
      "ordinal": 121,
      "start_ms": 437299,
      "end_ms": 440059,
      "text": "或者说他是就是共同底线价值受损"
    },
    {
      "ordinal": 122,
      "start_ms": 440059,
      "end_ms": 441919,
      "text": "我自己未来极度堪忧"
    },
    {
      "ordinal": 123,
      "start_ms": 441919,
      "end_ms": 444539,
      "text": "我老子怎么养老"
    },
    {
      "ordinal": 124,
      "start_ms": 444539,
      "end_ms": 445859,
      "text": "或者说我在中年的时候"
    },
    {
      "ordinal": 125,
      "start_ms": 445859,
      "end_ms": 446699,
      "text": "我这个脾气"
    },
    {
      "ordinal": 126,
      "start_ms": 446699,
      "end_ms": 447059,
      "text": "我这个"
    },
    {
      "ordinal": 127,
      "start_ms": 447059,
      "end_ms": 448799,
      "text": "性格我我们不说脾气性格"
    },
    {
      "ordinal": 128,
      "start_ms": 448799,
      "end_ms": 449939,
      "text": "这都是自然阶级观念"
    },
    {
      "ordinal": 129,
      "start_ms": 449939,
      "end_ms": 452090,
      "text": "我这种根本的价值观"
    },
    {
      "ordinal": 130,
      "start_ms": 452090,
      "end_ms": 453950,
      "text": "我根本不想让这些立场"
    },
    {
      "ordinal": 131,
      "start_ms": 453950,
      "end_ms": 458030,
      "text": "你让我这我投出机油头撞杆子"
