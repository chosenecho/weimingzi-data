  "segments": [
    {
      "ordinal": 0,
      "start_ms": 90960,
      "end_ms": 98720,
      "text": "沧海一声笑，滔滔两岸潮。"
    },
    {
      "ordinal": 1,
      "start_ms": 99200,
      "end_ms": 105360,
      "text": "浮沉聚散，知己今朝。"
    },
    {
      "ordinal": 2,
      "start_ms": 105760,
      "end_ms": 111280,
      "text": "苍天笑，纷纷世上潮。"
    },
    {
      "ordinal": 3,
      "start_ms": 113840,
      "end_ms": 121840,
      "text": "谁负谁胜出，天知晓。"
    },
    {
      "ordinal": 4,
      "start_ms": 121840,
      "end_ms": 127040,
      "text": "江山笑，烟雨遥。"
    },
    {
      "ordinal": 5,
      "start_ms": 127040,
      "end_ms": 133680,
      "text": "头棱头枕红尘俗世几多娇。"
    },
    {
      "ordinal": 6,
      "start_ms": 133920,
      "end_ms": 142720,
      "text": "清风笑，竟一夕了。"
    },
    {
      "ordinal": 7,
      "start_ms": 142800,
      "end_ms": 144640,
      "text": "后尘还剩了一今晚照。苍生笑，不再寂寥。"
    },
    {
      "ordinal": 8,
      "start_ms": 179649,
      "end_ms": 185329,
      "text": "豪情仍在，痴痴笑笑。"
    },
    {
      "ordinal": 9,
      "start_ms": 194449,
      "end_ms": 211009,
      "text": "啦啦啦啦啦，啦啦啦啦啦，啦啦啦啦啦啦啦啦，啦啦啦啦啦啦，啦啦啦啦啦啦啦啦，啦啦啦啦啦啦，啦啦"
    }
