  "content_sha256": "8eb159d19fc3f1c71ac6f5aca84d432579304610bd90a6c56756834c93f12775",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 38060,
      "end_ms": 38960,
      "text": "徘徊丛林"
    },
    {
      "ordinal": 1,
      "start_ms": 38960,
      "end_ms": 39860,
      "text": "迎着雨"
    },
    {
      "ordinal": 2,
      "start_ms": 41000,
      "end_ms": 44120,
      "text": "染湿风中的发端"
    },
    {
      "ordinal": 3,
      "start_ms": 44600,
      "end_ms": 45400,
      "text": "低俗"
    },
    {
      "ordinal": 4,
      "start_ms": 45400,
      "end_ms": 47590,
      "text": "细雨里面日困倦"
    },
    {
      "ordinal": 5,
      "start_ms": 47590,
      "end_ms": 48040,
      "text": "静"
    },
    {
      "ordinal": 6,
      "start_ms": 48040,
      "end_ms": 51239,
      "text": "靠慢慢消瘦的清楚"
    },
    {
      "ordinal": 7,
      "start_ms": 51360,
      "end_ms": 53300,
      "text": "悠悠流泉随路转"
    },
    {
      "ordinal": 8,
      "start_ms": 54500,
      "end_ms": 57990,
      "text": "偶于山中转数圈"
    },
    {
      "ordinal": 9,
      "start_ms": 58090,
      "end_ms": 60090,
      "text": "一片远远正黄"
    },
    {
      "ordinal": 10,
      "start_ms": 60090,
      "end_ms": 61710,
      "text": "落叶腾行"
    },
    {
      "ordinal": 11,
      "start_ms": 61710,
      "end_ms": 65010,
      "text": "情歌之中就飘远"
    },
    {
      "ordinal": 12,
      "start_ms": 66960,
      "end_ms": 71720,
      "text": "啊过过去多少次"
    },
    {
      "ordinal": 13,
      "start_ms": 71720,
      "end_ms": 73880,
      "text": "心里"
    },
    {
      "ordinal": 14,
      "start_ms": 74940,
      "end_ms": 80540,
      "text": "今天今天随着云烟静雨"
    },
    {
      "ordinal": 15,
      "start_ms": 81860,
      "end_ms": 83510,
      "text": "听听有雨"
    },
    {
      "ordinal": 16,
      "start_ms": 83510,
      "end_ms": 85880,
      "text": "凝望与思"
    },
    {
      "ordinal": 17,
      "start_ms": 86160,
      "end_ms": 89740,
      "text": "飘在悄悄的风"
    },
    {
      "ordinal": 18,
      "start_ms": 90920,
      "end_ms": 97660,
      "text": "赠我衷心祝福一转"
    },
    {
      "ordinal": 19,
      "start_ms": 118760,
      "end_ms": 120740,
      "text": "徘徊丛林淋着雨"
    },
    {
      "ordinal": 20,
      "start_ms": 120740,
      "end_ms": 125360,
      "text": "你掩饰风中的花蕊"
    },
    {
      "ordinal": 21,
      "start_ms": 125500,
      "end_ms": 128520,
      "text": "低俗细雨流云也困倦"
    },
    {
      "ordinal": 22,
      "start_ms": 128520,
      "end_ms": 131100,
      "text": "静靠慢慢消失的千转"
    },
    {
      "ordinal": 23,
      "start_ms": 132420,
      "end_ms": 133380,
      "text": "悠悠流传"
    },
    {
      "ordinal": 24,
      "start_ms": 133380,
      "end_ms": 134900,
      "text": "随流转"
    },
    {
      "ordinal": 25,
      "start_ms": 135219,
      "end_ms": 136559,
      "text": "流于山中"
    },
    {
      "ordinal": 26,
      "start_ms": 136559,
      "end_ms": 137009,
      "text": "转"
    },
    {
      "ordinal": 27,
      "start_ms": 137009,
      "end_ms": 140999,
      "text": "受远一片远远镜黄"
    },
    {
      "ordinal": 28,
      "start_ms": 140999,
      "end_ms": 142619,
      "text": "落叶淡风"
    },
    {
      "ordinal": 29,
      "start_ms": 142619,
      "end_ms": 145160,
      "text": "清气之中就飘远"
    },
    {
      "ordinal": 30,
      "start_ms": 147880,
      "end_ms": 154500,
      "text": "啊送你送你祝福永不断"
    },
    {
      "ordinal": 31,
      "start_ms": 155820,
      "end_ms": 157640,
      "text": "轻轻地飘"
    },
    {
      "ordinal": 32,
      "start_ms": 157640,
      "end_ms": 161359,
      "text": "寻觅无边路远"
    },
    {
      "ordinal": 33,
      "start_ms": 162739,
      "end_ms": 166740,
      "text": "这那鸟语路上细铁"
    },
    {
      "ordinal": 34,
      "start_ms": 166880,
      "end_ms": 174040,
      "text": "请问明摆脱青花同上冲疏"
    },
    {
      "ordinal": 35,
      "start_ms": 175219,
      "end_ms": 179469,
      "text": "祝福清楚啊"
    },
    {
      "ordinal": 36,
      "start_ms": 179469,
      "end_ms": 184300,
      "text": "送你送你祝福永不断"
    },
    {
      "ordinal": 37,
      "start_ms": 186119,
      "end_ms": 192100,
      "text": "年轻的飘层面无边流远"
    },
    {
      "ordinal": 38,
      "start_ms": 192860,
      "end_ms": 198480,
      "text": "这那鸟语路上细添温暖"
    },
    {
      "ordinal": 39,
      "start_ms": 198760,
      "end_ms": 200320,
      "text": "盯着前方"
    },
    {
      "ordinal": 40,
      "start_ms": 202360,
      "end_ms": 204640,
      "text": "放上冲伤"
    },
    {
      "ordinal": 41,
      "start_ms": 205580,
      "end_ms": 207580,
      "text": "祝福清楚"
    },
    {
      "ordinal": 42,
      "start_ms": 209140,
      "end_ms": 211440,
      "text": "摆脱轻浮"
    },
    {
      "ordinal": 43,
      "start_ms": 212459,
      "end_ms": 218120,
      "text": "放上初心作佛清楚"
    },
    {
      "ordinal": 44,
      "start_ms": 227339,
      "end_ms": 228300,
      "text": "嗯嗯"
    },
    {
      "ordinal": 45,
      "start_ms": 239300,
      "end_ms": 240580,
      "text": "你知道我要做什么"
    },
    {
      "ordinal": 46,
      "start_ms": 240580,
      "end_ms": 241820,
      "text": "我看见一条老狗"
    }
  ],
  "text": "徘徊丛林\n迎着雨\n染湿风中的发端\n低俗\n细雨里面日困倦\n静\n靠慢慢消瘦的清楚\n悠悠流泉随路转\n偶于山中转数圈\n一片远远正黄\n落叶腾行\n情歌之中就飘远\n啊过过去多少次\n心里\n今天今天随着云烟静雨\n听听有雨\n凝望与思\n飘在悄悄的风\n赠我衷心祝福一转\n徘徊丛林淋着雨\n你掩饰风中的花蕊\n低俗细雨流云也困倦\n静靠慢慢消失的千转\n悠悠流传\n随流转\n流于山中\n转\n受远一片远远镜黄\n落叶淡风\n清气之中就飘远\n啊送你送你祝福永不断\n轻轻地飘\n寻觅无边路远\n这那鸟语路上细铁\n请问明摆脱青花同上冲疏\n祝福清楚啊\n送你送你祝福永不断\n年轻的飘层面无边流远\n这那鸟语路上细添温暖\n盯着前方\n放上冲伤\n祝福清楚\n摆脱轻浮\n放上初心作佛清楚\n嗯嗯\n你知道我要做什么\n我看见一条老狗",
  "timing_issue": null
}
