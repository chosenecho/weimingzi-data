  "segments": [
    {
      "ordinal": 0,
      "start_ms": 0,
      "end_ms": 780,
      "text": "好"
    },
    {
      "ordinal": 1,
      "start_ms": 27580,
      "end_ms": 31050,
      "text": "在那些青翠的路上"
    },
    {
      "ordinal": 2,
      "start_ms": 31050,
      "end_ms": 34019,
      "text": "历遍了多少创伤"
    },
    {
      "ordinal": 3,
      "start_ms": 34220,
      "end_ms": 35680,
      "text": "在那时"
    },
    {
      "ordinal": 4,
      "start_ms": 64780,
      "end_ms": 68250,
      "text": "在那些青翠的路上"
    },
    {
      "ordinal": 5,
      "start_ms": 68250,
      "end_ms": 75010,
      "text": "历遍了多少场生在那阵苍老的面上"
    },
    {
      "ordinal": 6,
      "start_ms": 75010,
      "end_ms": 77780,
      "text": "亦记载了风霜"
    },
    {
      "ordinal": 7,
      "start_ms": 78960,
      "end_ms": 79700,
      "text": "秋风"
    },
    {
      "ordinal": 8,
      "start_ms": 79700,
      "end_ms": 87900,
      "text": "秋雨的头也是青春少年时必不得已的话"
    },
    {
      "ordinal": 9,
      "start_ms": 87900,
      "end_ms": 90200,
      "text": "别没说再见"
    },
    {
      "ordinal": 10,
      "start_ms": 91260,
      "end_ms": 93830,
      "text": "回望昨日最黑"
    },
    {
      "ordinal": 11,
      "start_ms": 93830,
      "end_ms": 97220,
      "text": "那满前喜嘘的感慨"
    },
    {
      "ordinal": 12,
      "start_ms": 97220,
      "end_ms": 98600,
      "text": "1年年"
    },
    {
      "ordinal": 13,
      "start_ms": 98680,
      "end_ms": 103660,
      "text": "但日落日出永没变迁"
    },
    {
      "ordinal": 14,
      "start_ms": 104620,
      "end_ms": 108660,
      "text": "这刻在望着父亲笑容时"
    },
    {
      "ordinal": 15,
      "start_ms": 108660,
      "end_ms": 112039,
      "text": "竟不知不觉的茫然"
    },
    {
      "ordinal": 16,
      "start_ms": 112100,
      "end_ms": 113990,
      "text": "忍日落无私"
    },
    {
      "ordinal": 17,
      "start_ms": 113990,
      "end_ms": 116440,
      "text": "心满里暗"
    },
    {
      "ordinal": 18,
      "start_ms": 121180,
      "end_ms": 122580,
      "text": "肌肉没有力量"
    },
    {
      "ordinal": 19,
      "start_ms": 122580,
      "end_ms": 124220,
      "text": "好像放松放松"
    },
    {
      "ordinal": 20,
      "start_ms": 131939,
      "end_ms": 135409,
      "text": "在那些开放的路上"
    },
    {
      "ordinal": 21,
      "start_ms": 135409,
      "end_ms": 138220,
      "text": "也许过多少理想"
    },
    {
      "ordinal": 22,
      "start_ms": 138540,
      "end_ms": 148830,
      "text": "在那张高挂的面上被引证了许多千秋不变的日语"
    },
    {
      "ordinal": 23,
      "start_ms": 148830,
      "end_ms": 151660,
      "text": "在相思里共处"
    },
    {
      "ordinal": 24,
      "start_ms": 152840,
      "end_ms": 155560,
      "text": "故事分割的大地"
    },
    {
      "ordinal": 25,
      "start_ms": 155560,
      "end_ms": 157420,
      "text": "划了解事"
    },
    {
      "ordinal": 26,
      "start_ms": 158320,
      "end_ms": 162340,
      "text": "回望昨日在异乡的感情"
    },
    {
      "ordinal": 27,
      "start_ms": 162440,
      "end_ms": 164300,
      "text": "唏嘘的感慨"
    },
    {
      "ordinal": 28,
      "start_ms": 164300,
      "end_ms": 165680,
      "text": "1年年"
    },
    {
      "ordinal": 29,
      "start_ms": 165680,
      "end_ms": 170080,
      "text": "但日落日出永没变迁"
    },
    {
      "ordinal": 30,
      "start_ms": 171640,
      "end_ms": 175810,
      "text": "这刻在望着父亲笑容时"
    },
    {
      "ordinal": 31,
      "start_ms": 175810,
      "end_ms": 179869,
      "text": "竟不知不觉的无言人"
    },
    {
      "ordinal": 32,
      "start_ms": 179869,
      "end_ms": 183540,
      "text": "日落无私心万里眼"
    },
    {
      "ordinal": 33,
      "start_ms": 200240,
      "end_ms": 206289,
      "text": "回望昨日在遗憾那门前唏嘘的感慨"
    },
    {
      "ordinal": 34,
      "start_ms": 206289,
      "end_ms": 207669,
      "text": "1年年"
    },
    {
      "ordinal": 35,
      "start_ms": 207669,
      "end_ms": 212020,
      "text": "但日落日出永没变迁"
    },
    {
      "ordinal": 36,
      "start_ms": 213700,
      "end_ms": 217780,
      "text": "这刻在望着父亲笑容时"
    },
    {
      "ordinal": 37,
      "start_ms": 217839,
      "end_ms": 221079,
      "text": "竟不知不觉的无言"
    },
    {
      "ordinal": 38,
      "start_ms": 221079,
      "end_ms": 223689,
      "text": "掩日落无私心"
    },
    {
      "ordinal": 39,
      "start_ms": 223689,
      "end_ms": 225520,
      "text": "梦里暗"
    },
    {
      "ordinal": 40,
      "start_ms": 227160,
      "end_ms": 233170,
      "text": "回望昨日在看那满天唏嘘的感慨"
    },
    {
      "ordinal": 41,
      "start_ms": 233170,
      "end_ms": 234550,
      "text": "1年年"
    },
    {
      "ordinal": 42,
      "start_ms": 234550,
      "end_ms": 238820,
      "text": "但日落日出永没变迁"
    },
    {
      "ordinal": 43,
      "start_ms": 239260,
      "end_ms": 244640,
      "text": "哎呀这刻在望着父亲笑容时"
    },
    {
      "ordinal": 44,
      "start_ms": 244700,
      "end_ms": 248030,
      "text": "竟不知不觉的无言"
    },
    {
      "ordinal": 45,
      "start_ms": 248030,
      "end_ms": 252860,
      "text": "让日落暮色新闻里来"
    }
  ],
  "text": "好\n在那些青翠的路上\n历遍了多少创伤\n在那时\n在那些青翠的路上\n历遍了多少场生在那阵苍老的面上\n亦记载了风霜\n秋风\n秋雨的头也是青春少年时必不得已的话\n别没说再见\n回望昨日最黑\n那满前喜嘘的感慨\n1年年\n但日落日出永没变迁\n这刻在望着父亲笑容时\n竟不知不觉的茫然\n忍日落无私\n心满里暗\n肌肉没有力量\n好像放松放松\n在那些开放的路上\n也许过多少理想\n在那张高挂的面上被引证了许多千秋不变的日语\n在相思里共处\n故事分割的大地\n划了解事\n回望昨日在异乡的感情\n唏嘘的感慨\n1年年\n但日落日出永没变迁\n这刻在望着父亲笑容时\n竟不知不觉的无言人\n日落无私心万里眼\n回望昨日在遗憾那门前唏嘘的感慨\n1年年\n但日落日出永没变迁\n这刻在望着父亲笑容时\n竟不知不觉的无言\n掩日落无私心\n梦里暗\n回望昨日在看那满天唏嘘的感慨\n1年年\n但日落日出永没变迁\n哎呀这刻在望着父亲笑容时\n竟不知不觉的无言\n让日落暮色新闻里来",
