  "segments": [
    {
      "ordinal": 0,
      "start_ms": 10720,
      "end_ms": 11240,
      "text": "嗯"
    },
    {
      "ordinal": 1,
      "start_ms": 25840,
      "end_ms": 26800,
      "text": "嗯"
    },
    {
      "ordinal": 2,
      "start_ms": 33700,
      "end_ms": 37260,
      "text": "重庆仍在过去了"
    },
    {
      "ordinal": 3,
      "start_ms": 37260,
      "end_ms": 39900,
      "text": "再不来"
    },
    {
      "ordinal": 4,
      "start_ms": 42740,
      "end_ms": 49279,
      "text": "红红落叶长埋尘土内"
    },
    {
      "ordinal": 5,
      "start_ms": 50640,
      "end_ms": 54380,
      "text": "开始终结总是"
    },
    {
      "ordinal": 6,
      "start_ms": 55500,
      "end_ms": 58520,
      "text": "无边改"
    },
    {
      "ordinal": 7,
      "start_ms": 59660,
      "end_ms": 62320,
      "text": "天边的你飘荡"
    },
    {
      "ordinal": 8,
      "start_ms": 64220,
      "end_ms": 67540,
      "text": "把关怀"
    },
    {
      "ordinal": 9,
      "start_ms": 69820,
      "end_ms": 71460,
      "text": "富豪"
    },
    {
      "ordinal": 10,
      "start_ms": 73220,
      "end_ms": 75660,
      "text": "泛起爱恨"
    },
    {
      "ordinal": 11,
      "start_ms": 78060,
      "end_ms": 80160,
      "text": "在世界"
    },
    {
      "ordinal": 12,
      "start_ms": 82240,
      "end_ms": 84880,
      "text": "南头北门关"
    },
    {
      "ordinal": 13,
      "start_ms": 87960,
      "end_ms": 89240,
      "text": "相亲"
    },
    {
      "ordinal": 14,
      "start_ms": 91460,
      "end_ms": 98220,
      "text": "竟不可这个还我掀开"
    },
    {
      "ordinal": 15,
      "start_ms": 99420,
      "end_ms": 111190,
      "text": "伤心是变化啊啊啊呕呕啊"
    },
    {
      "ordinal": 16,
      "start_ms": 111190,
      "end_ms": 114040,
      "text": "这种意识形态是很拙劣的"
    },
    {
      "ordinal": 17,
      "start_ms": 127220,
      "end_ms": 130600,
      "text": "换一种人生开始英雄"
    },
    {
      "ordinal": 18,
      "start_ms": 133019,
      "end_ms": 135599,
      "text": "彩云七色的云彩有趣"
    },
    {
      "ordinal": 19,
      "start_ms": 135599,
      "end_ms": 137849,
      "text": "七色的翔来采来取你"
    },
    {
      "ordinal": 20,
      "start_ms": 137849,
      "end_ms": 140179,
      "text": "祥云降了"
    },
    {
      "ordinal": 21,
      "start_ms": 140179,
      "end_ms": 141320,
      "text": "像云一样"
    },
    {
      "ordinal": 22,
      "start_ms": 142380,
      "end_ms": 148520,
      "text": "情人别后永远再不来"
    },
    {
      "ordinal": 23,
      "start_ms": 151380,
      "end_ms": 153530,
      "text": "无言独坐"
    },
    {
      "ordinal": 24,
      "start_ms": 153530,
      "end_ms": 157020,
      "text": "放眼尘世外"
    },
    {
      "ordinal": 25,
      "start_ms": 159359,
      "end_ms": 162460,
      "text": "鲜花虽会凋谢"
    },
    {
      "ordinal": 26,
      "start_ms": 163480,
      "end_ms": 165420,
      "text": "发音不准重来啊"
    },
    {
      "ordinal": 27,
      "start_ms": 165420,
      "end_ms": 167340,
      "text": "你们恶心再恶心一点吗"
    },
    {
      "ordinal": 28,
      "start_ms": 167340,
      "end_ms": 170820,
      "text": "先把水位丢失"
    },
    {
      "ordinal": 29,
      "start_ms": 173779,
      "end_ms": 174600,
      "text": "嗯"
    },
    {
      "ordinal": 30,
      "start_ms": 194480,
      "end_ms": 196460,
      "text": "一字头很垃圾的东西"
    },
    {
      "ordinal": 31,
      "start_ms": 196460,
      "end_ms": 199080,
      "text": "也不是本真的爱情很垃圾的东西"
    },
    {
      "ordinal": 32,
      "start_ms": 200100,
      "end_ms": 203600,
      "text": "从前现在过去了"
    },
    {
      "ordinal": 33,
      "start_ms": 203600,
      "end_ms": 206180,
      "text": "再不来"
    },
    {
      "ordinal": 34,
      "start_ms": 209119,
      "end_ms": 215799,
      "text": "红红落叶长埋尘土内"
    },
    {
      "ordinal": 35,
      "start_ms": 217020,
      "end_ms": 218540,
      "text": "开始冲刺"
    },
    {
      "ordinal": 36,
      "start_ms": 218540,
      "end_ms": 219900,
      "text": "总是"
    },
    {
      "ordinal": 37,
      "start_ms": 222100,
      "end_ms": 224140,
      "text": "没变改"
    },
    {
      "ordinal": 38,
      "start_ms": 226079,
      "end_ms": 228900,
      "text": "清兵滴泪飘泊"
    },
    {
      "ordinal": 39,
      "start_ms": 230600,
      "end_ms": 233920,
      "text": "把温暖"
    },
    {
      "ordinal": 40,
      "start_ms": 240339,
      "end_ms": 241619,
      "text": "起爱恨"
    },
    {
      "ordinal": 41,
      "start_ms": 244619,
      "end_ms": 246280,
      "text": "在世间"
    },
    {
      "ordinal": 42,
      "start_ms": 248740,
      "end_ms": 252420,
      "text": "难逃避命运"
    },
    {
      "ordinal": 43,
      "start_ms": 254260,
      "end_ms": 255600,
      "text": "相亲"
    },
    {
      "ordinal": 44,
      "start_ms": 257880,
      "end_ms": 272480,
      "text": "竟不可时间还我应该深深是缘分啊"
    },
    {
      "ordinal": 45,
      "start_ms": 275040,
      "end_ms": 275900,
      "text": "拉麦呀"
    },
    {
      "ordinal": 46,
      "start_ms": 275900,
      "end_ms": 279260,
      "text": "这种高音他妈的加气流声音就变响了"
    },
    {
      "ordinal": 47,
      "start_ms": 279260,
      "end_ms": 280100,
      "text": "肯定拉麦啊"
    },
    {
      "ordinal": 48,
      "start_ms": 280100,
      "end_ms": 283010,
      "text": "否则你要把观众耳朵给震爆吗"
    },
    {
      "ordinal": 49,
      "start_ms": 283010,
      "end_ms": 283920,
      "text": "真是的"
    },
    {
      "ordinal": 50,
      "start_ms": 287260,
      "end_ms": 290640,
      "text": "啊紫霞瞎子倒过来说就是"
    },
    {
      "ordinal": 51,
      "start_ms": 293599,
      "end_ms": 296809,
      "text": "万一中人盛开是英雄"
    },
    {
      "ordinal": 52,
      "start_ms": 296809,
      "end_ms": 299260,
      "text": "七七彩祥云"
    },
    {
      "ordinal": 53,
      "start_ms": 299539,
      "end_ms": 302239,
      "text": "踩着七色的云彩来娶我"
    },
    {
      "ordinal": 54,
      "start_ms": 302239,
      "end_ms": 304480,
      "text": "我猜中情歌"
    },
    {
      "ordinal": 55,
      "start_ms": 305759,
      "end_ms": 306820,
      "text": "可是"
    },
    {
      "ordinal": 56,
      "start_ms": 308779,
      "end_ms": 314770,
      "text": "情人别后永远再不来"
    },
    {
      "ordinal": 57,
      "start_ms": 315170,
      "end_ms": 319960,
      "text": "痛觉无言独坐"
    },
    {
      "ordinal": 58,
      "start_ms": 319960,
      "end_ms": 323600,
      "text": "放眼尘世岸"
    },
    {
      "ordinal": 59,
      "start_ms": 325740,
      "end_ms": 328400,
      "text": "鲜花虽会凋谢"
    },
    {
      "ordinal": 60,
      "start_ms": 330440,
      "end_ms": 332520,
      "text": "但会再开"
    },
    {
      "ordinal": 61,
      "start_ms": 334760,
      "end_ms": 337680,
      "text": "一生所爱隐约"
    },
    {
      "ordinal": 62,
      "start_ms": 339180,
      "end_ms": 341760,
      "text": "再不问我"
    },
    {
      "ordinal": 63,
      "start_ms": 344920,
      "end_ms": 346200,
      "text": "呼吸"
    },
    {
      "ordinal": 64,
      "start_ms": 348480,
      "end_ms": 350980,
      "text": "欢喜爱情"
    },
    {
      "ordinal": 65,
      "start_ms": 352820,
      "end_ms": 355340,
      "text": "在世界"
    },
    {
      "ordinal": 66,
      "start_ms": 357320,
      "end_ms": 361120,
      "text": "难逃避命运"
    },
    {
      "ordinal": 67,
      "start_ms": 363900,
      "end_ms": 364400,
      "text": "亲"
    },
    {
      "ordinal": 68,
      "start_ms": 366560,
      "end_ms": 378920,
      "text": "情不好期间还我应该生生是缘分"
    },
    {
      "ordinal": 69,
      "start_ms": 381920,
      "end_ms": 382460,
      "text": "不许"
    },
    {
      "ordinal": 70,
      "start_ms": 384680,
      "end_ms": 388160,
      "text": "分喜爱恨"
    },
    {
      "ordinal": 71,
      "start_ms": 389019,
      "end_ms": 391560,
      "text": "在世界"
    },
    {
      "ordinal": 72,
      "start_ms": 393519,
      "end_ms": 397379,
      "text": "难逃避命运"
    },
    {
      "ordinal": 73,
      "start_ms": 399259,
      "end_ms": 400599,
      "text": "相亲"
    },
    {
      "ordinal": 74,
      "start_ms": 402819,
      "end_ms": 415320,
      "text": "竟不可之间还我应该生生是缘分"
    },
    {
      "ordinal": 75,
      "start_ms": 417819,
      "end_ms": 420470,
      "text": "曾经有一个这种意识形态"
    },
    {
      "ordinal": 76,
      "start_ms": 420470,
      "end_ms": 422210,
      "text": "这种爱情都是一字头的"
    },
    {
      "ordinal": 77,
      "start_ms": 422210,
      "end_ms": 423920,
      "text": "没有解放性的"
    },
    {
      "ordinal": 78,
      "start_ms": 423920,
      "end_ms": 425150,
      "text": "作茧自缚的"
    },
    {
      "ordinal": 79,
      "start_ms": 425150,
      "end_ms": 426560,
      "text": "而且是非本真的"
    },
    {
      "ordinal": 80,
      "start_ms": 426560,
      "end_ms": 428330,
      "text": "而且隐匿的"
    },
    {
      "ordinal": 81,
      "start_ms": 428330,
      "end_ms": 433100,
      "text": "它的底层的那个立场都是肮脏的"
    },
    {
      "ordinal": 82,
      "start_ms": 433100,
      "end_ms": 434270,
      "text": "可耻的"
    },
    {
      "ordinal": 83,
      "start_ms": 434270,
      "end_ms": 437160,
      "text": "不值得不值得不值得增加"
    },
    {
      "ordinal": 84,
      "start_ms": 437160,
      "end_ms": 439289,
      "text": "这种东西没有价值了"
    },
    {
      "ordinal": 85,
      "start_ms": 439289,
      "end_ms": 442260,
      "text": "我希望你希望是1万"
    }
  ],
  "text": "嗯\n嗯\n重庆仍在过去了\n再不来\n红红落叶长埋尘土内\n开始终结总是\n无边改\n天边的你飘荡\n把关怀\n富豪\n泛起爱恨\n在世界\n南头北门关\n相亲\n竟不可这个还我掀开\n伤心是变化啊啊啊呕呕啊\n这种意识形态是很拙劣的\n换一种人生开始英雄\n彩云七色的云彩有趣\n七色的翔来采来取你\n祥云降了\n像云一样\n情人别后永远再不来\n无言独坐\n放眼尘世外\n鲜花虽会凋谢\n发音不准重来啊\n你们恶心再恶心一点吗\n先把水位丢失\n嗯\n一字头很垃圾的东西\n也不是本真的爱情很垃圾的东西\n从前现在过去了\n再不来\n红红落叶长埋尘土内\n开始冲刺\n总是\n没变改\n清兵滴泪飘泊\n把温暖\n起爱恨\n在世间\n难逃避命运\n相亲\n竟不可时间还我应该深深是缘分啊\n拉麦呀\n这种高音他妈的加气流声音就变响了\n肯定拉麦啊\n否则你要把观众耳朵给震爆吗\n真是的\n啊紫霞瞎子倒过来说就是\n万一中人盛开是英雄\n七七彩祥云\n踩着七色的云彩来娶我\n我猜中情歌\n可是\n情人别后永远再不来\n痛觉无言独坐\n放眼尘世岸\n鲜花虽会凋谢\n但会再开\n一生所爱隐约\n再不问我\n呼吸\n欢喜爱情\n在世界\n难逃避命运\n亲\n情不好期间还我应该生生是缘分\n不许\n分喜爱恨\n在世界\n难逃避命运\n相亲\n竟不可之间还我应该生生是缘分\n曾经有一个这种意识形态\n这种爱情都是一字头的\n没有解放性的\n作茧自缚的\n而且是非本真的\n而且隐匿的\n它的底层的那个立场都是肮脏的\n可耻的\n不值得不值得不值得增加\n这种东西没有价值了\n我希望你希望是1万",
  "timing_issue": null
}
