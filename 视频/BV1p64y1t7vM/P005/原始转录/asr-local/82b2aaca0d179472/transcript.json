    {
      "ordinal": 0,
      "start_ms": 44800,
      "end_ms": 50320,
      "text": "昨日像那东流水，离我远去不可留。"
    },
    {
      "ordinal": 1,
      "start_ms": 50720,
      "end_ms": 53760,
      "text": "今日乱我心，多烦忧。"
    },
    {
      "ordinal": 2,
      "start_ms": 55280,
      "end_ms": 57840,
      "text": "抽刀断水，水更流。"
    },
    {
      "ordinal": 3,
      "start_ms": 57920,
      "end_ms": 60560,
      "text": "举杯浇愁，愁更愁。"
    },
    {
      "ordinal": 4,
      "start_ms": 61200,
      "end_ms": 65360,
      "text": "明朝清风似飘流。"
    },
    {
      "ordinal": 5,
      "start_ms": 68400,
      "end_ms": 73680,
      "text": "有来只有新人笑，有谁听到旧人哭？"
    },
    {
      "ordinal": 6,
      "start_ms": 74240,
      "end_ms": 77360,
      "text": "爱情两个字好辛苦。"
    },
    {
      "ordinal": 7,
      "start_ms": 78720,
      "end_ms": 83440,
      "text": "是要问一个明白，还是要装作糊涂？"
    },
    {
      "ordinal": 8,
      "start_ms": 84640,
      "end_ms": 89360,
      "text": "知多知少难知足。"
    },
    {
      "ordinal": 9,
      "start_ms": 91520,
      "end_ms": 96560,
      "text": "看似个鸳鸯蝴蝶，不应该的年代。"
    },
    {
      "ordinal": 10,
      "start_ms": 97040,
      "end_ms": 102320,
      "text": "可是谁又能摆脱人世间的悲哀？"
    },
    {
      "ordinal": 11,
      "start_ms": 102960,
      "end_ms": 106960,
      "text": "花花世界，鸳鸯蝴蝶，"
    },
    {
      "ordinal": 12,
      "start_ms": 108560,
      "end_ms": 110400,
      "text": "在人间已是癫。"
    },
    {
      "ordinal": 13,
      "start_ms": 111120,
      "end_ms": 112960,
      "text": "何苦要上青天？"
    },
    {
      "ordinal": 14,
      "start_ms": 113760,
      "end_ms": 116240,
      "text": "不如温柔同眠。"
    },
    {
      "ordinal": 15,
