  "content_sha256": "487be9fd66eb90776c94e00ae9116e99e41da6b12cbdba56a1539e1c1e4cdf27",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 1680,
      "end_ms": 3280,
      "text": "梅艳芳的太低了。"
    },
    {
      "ordinal": 1,
      "start_ms": 20000,
      "end_ms": 26000,
      "text": "同是过路，同做个梦，本应是一对。"
    },
    {
      "ordinal": 2,
      "start_ms": 28000,
      "end_ms": 34560,
      "text": "人债少年，梦中不觉，醒后要归去。"
    },
    {
      "ordinal": 3,
      "start_ms": 35600,
      "end_ms": 41760,
      "text": "三餐一宿，也共一双，到底为是谁？"
    },
    {
      "ordinal": 4,
      "start_ms": 43680,
      "end_ms": 49520,
      "text": "但凭梅得到，但凡是过去，总是最登对。"
    },
    {
      "ordinal": 5,
      "start_ms": 51520,
      "end_ms": 59520,
      "text": "台下你望，台下我坐，你想坐的戏。"
    },
    {
      "ordinal": 6,
      "start_ms": 59520,
      "end_ms": 66000,
      "text": "情是故人梦，有的你可曾记得起？"
    },
    {
      "ordinal": 7,
      "start_ms": 67200,
      "end_ms": 72720,
      "text": "欢喜相背，留便心死，说不上传奇。"
    },
    {
      "ordinal": 8,
      "start_ms": 75040,
      "end_ms": 81200,
      "text": "恨太憎，轻轻；屈太憎，我我不是我跟你。"
    },
    {
      "ordinal": 9,
      "start_ms": 82880,
      "end_ms": 89040,
      "text": "昨残渺渺，天已茫茫，将你共我分开。"
    },
    {
      "ordinal": 10,
      "start_ms": 89920,
      "end_ms": 105040,
      "text": "断肠字点点，风雨声零零，似是故人来。何日再聚？何地再聚？说今夜真远。"
    },
    {
      "ordinal": 11,
      "start_ms": 106000,
      "end_ms": 113648,
      "text": "无份有缘，回忆不断，心明确苦短。"
    },
    {
      "ordinal": 12,
      "start_ms": 114352,
      "end_ms": 122560,
      "text": "一种相思，两段苦恋，半生说无缘。"
    },
    {
      "ordinal": 13,
      "start_ms": 122720,
      "end_ms": 140000,
      "text": "再年缘深缘，望明月远远，想像你幽怨。"
    },
    {
      "ordinal": 14,
      "start_ms": 142560,
      "end_ms": 149920,
      "text": "想象你幽忧郁啊，这歌词弄错了，不是想象你幽怨，想象你忧郁。"
    },
    {
      "ordinal": 15,
      "start_ms": 161520,
      "end_ms": 167440,
      "text": "昨残渺渺，天已茫茫，将你共我分开。"
    },
    {
      "ordinal": 16,
      "start_ms": 167776,
      "end_ms": 174640,
      "text": "断肠字点点，风雨声零零，似是故人来。留下你和留下我在世间上。"
    },
    {
      "ordinal": 17,
      "start_ms": 182489,
      "end_ms": 190969,
      "text": "钟楼，离别以前，每支相对，当然那么好。"
    },
    {
      "ordinal": 18,
      "start_ms": 192729,
      "end_ms": 199689,
      "text": "知知知，手握又分手，爱得有幻慕。"
    },
    {
      "ordinal": 19,
      "start_ms": 200409,
      "end_ms": 206729,
      "text": "十年后，双双；万年后，对对，只恨看不透。"
    },
    {
      "ordinal": 20,
      "start_ms": 208329,
      "end_ms": 239449,
      "text": "十年后，双双；万年后，对对，只恨看不透。啊。呃呃。哎，不好意思啊。"
    }
  ],
