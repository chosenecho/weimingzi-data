  "segments": [
    {
      "ordinal": 0,
      "start_ms": 1680,
      "end_ms": 4980,
      "text": "啊对于海德格尔的这个非常经典的这个问题"
    },
    {
      "ordinal": 1,
      "start_ms": 4980,
      "end_ms": 7020,
      "text": "我还要进行一定的补充"
    },
    {
      "ordinal": 2,
      "start_ms": 7020,
      "end_ms": 8520,
      "text": "这补充是非常关键的"
    },
    {
      "ordinal": 3,
      "start_ms": 8520,
      "end_ms": 12490,
      "text": "这因为我我录了一个40几分钟的一个长视频"
    },
    {
      "ordinal": 4,
      "start_ms": 12490,
      "end_ms": 13630,
      "text": "那个长视频里面"
    },
    {
      "ordinal": 5,
