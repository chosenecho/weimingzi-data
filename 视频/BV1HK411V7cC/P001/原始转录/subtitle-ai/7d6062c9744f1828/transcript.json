      "text": "我的意识为"
    },
    {
      "ordinal": 76,
      "start_ms": 173330,
      "end_ms": 174630,
      "text": "包括所谓的时间"
    },
    {
      "ordinal": 77,
      "start_ms": 174630,
      "end_ms": 175950,
      "text": "包括所谓的空间"
    },
    {
      "ordinal": 78,
      "start_ms": 175950,
      "end_ms": 177390,
      "text": "这些东西都在不停的涌现"
    },
    {
      "ordinal": 79,
      "start_ms": 177390,
      "end_ms": 178690,
      "text": "不停地呈现出来"
    },
    {
      "ordinal": 80,
      "start_ms": 178690,
      "end_ms": 181920,
      "text": "他是一个哲学开始思维的一个"
    },
    {
      "ordinal": 81,
      "start_ms": 182679,
