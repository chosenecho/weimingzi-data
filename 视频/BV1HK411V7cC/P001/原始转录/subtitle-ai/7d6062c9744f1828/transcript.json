    {
      "ordinal": 115,
      "start_ms": 259430,
      "end_ms": 262479,
      "text": "而不能作为一个虚无凌驾于一切东西"
    },
    {
      "ordinal": 116,
      "start_ms": 262479,
      "end_ms": 263259,
      "text": "你还想存在"
    },
    {
      "ordinal": 117,
      "start_ms": 263259,
      "end_ms": 264699,
      "text": "还想给出自身是不行的"
    },
    {
      "ordinal": 118,
      "start_ms": 264699,
      "end_ms": 265599,
      "text": "你不能给出自身"
    },
    {
      "ordinal": 119,
      "start_ms": 265599,
      "end_ms": 267339,
      "text": "你必须把这个位置让出来"
    },
    {
      "ordinal": 120,
      "start_ms": 267339,
      "end_ms": 272910,
      "text": "也就是说你可以体会到一种一种不可能性"
    },
    {
      "ordinal": 121,
      "start_ms": 272910,
      "end_ms": 274960,
      "text": "无是不可能存在的"
    },
    {
      "ordinal": 122,
      "start_ms": 275860,
      "end_ms": 277950,
      "text": "你不可能打断你的意识"
    },
    {
      "ordinal": 123,
      "start_ms": 277950,
      "end_ms": 280620,
      "text": "你不可能说停stop"
