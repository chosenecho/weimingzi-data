    },
    {
      "ordinal": 60,
      "start_ms": 126870,
      "end_ms": 130310,
      "text": "它的这个问题的那个主体性的维度"
    },
    {
      "ordinal": 61,
      "start_ms": 130310,
      "end_ms": 136730,
      "text": "构成了哲学开始思考的思考发问的一个心法"
    },
    {
      "ordinal": 62,
      "start_ms": 136730,
      "end_ms": 140100,
      "text": "西方哲学发问的一个心法"
    },
    {
      "ordinal": 63,
      "start_ms": 140100,
      "end_ms": 143790,
      "text": "在我看来就相当于是把你的意识重启"
    },
    {
      "ordinal": 64,
      "start_ms": 143790,
      "end_ms": 145920,
      "text": "它的一个重启按钮"
    },
    {
      "ordinal": 65,
      "start_ms": 146700,
      "end_ms": 148220,
      "text": "因为存在者存在"
    },
    {
      "ordinal": 66,
      "start_ms": 148220,
      "end_ms": 151310,
