    {
      "ordinal": 124,
      "start_ms": 280620,
      "end_ms": 281640,
      "text": "你做不到这一点"
    },
    {
      "ordinal": 125,
      "start_ms": 281640,
      "end_ms": 284959,
      "text": "你不可能说让这一切都消失吧"
    },
    {
      "ordinal": 126,
      "start_ms": 284959,
