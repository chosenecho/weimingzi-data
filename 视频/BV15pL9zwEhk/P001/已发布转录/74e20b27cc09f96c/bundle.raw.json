":1868.42,"text":"啊对不对"},{"start":1868.42,"end":1869.18,"text":"女性的话啊"},{"start":1869.18,"end":1870.1,"text":"温格温驯的啊"},{"start":1870.1,"end":1870.74,"text":"操我操"},{"start":1870.74,"end":1871.74,"text":"给自己再叠个盾的"},{"start":1873.16,"end":1874.8,"text":"反正我们把这个道理讲清楚了"},{"start":1874.8,"end":1877.64,"text":"你们你们不要就是说把这个东西理解的"},{"start":1877.64,"end":1878.4,"text":"好像很简单"},{"start":1878.4,"end":1879.64,"text":"很很很很随意"},{"start":1879.64,"end":1881.76,"text":"很怎么样都是很很沉重的"},{"start":1881.76,"end":1883.24,"text":"很很非常沉重的"},{"start":1883.24,"end":1886.12,"text":"非常就是没什么好说的好吧"},{"start":1886.12,"end":1886.9,"text":"没什么好说的"},{"start":1886.9,"end":1887.94,"text":"就是不足为外人道"},{"start":1887.94,"end":1889.14,"text":"但是我也给你们讲讲"},{"start":1889.14,"end":1890.18,"text":"就是我我这个人"},{"start":1890.18,"end":1893.02,"text":"我喜欢把一些不可能说清楚的东西"},{"start":1893.02,"end":1894.62,"text":"我还是要试图去讲一讲"},{"start":1894.62,"end":1896.52,"text":"说一说"},{"start":1898.7,"end":1900.36,"text":"否则说不教而诛"},{"start":1900.36,"end":1900.8,"text":"对不对"},{"start":1900.8,"end":1901.66,"text":"好吧"}],"source":"subtitle"}
