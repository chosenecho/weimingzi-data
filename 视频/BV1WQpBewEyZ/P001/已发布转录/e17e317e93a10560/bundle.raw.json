{"segments":[{"start":0.12,"end":4.779,"text":"目前在台面上好像他被封杀"},{"start":5.819,"end":10.07,"text":"被什么两个平台都给他封杀"},{"start":10.07,"end":12.89,"text":"限流的这么一个被捧的很高的"},{"start":12.89,"end":14.21,"text":"简单来讲童润中吧"},{"start":14.21,"end":16.77,"text":"同仁宗和谁吃饭了呢"},{"start":22.58,"end":24.94,"text":"和这么一个人吃饭了"},{"start":25.36,"end":26.84,"text":"而且是夫妻两个"},{"start":28.08,"end":30.2,"text":"和这么一对搭档吃饭了"},{"start":31.24,"end":33.6,"text":"这对搭档是什么样的人呢"},{"start":34.45,"end":36.49,"text":"我说两个侧面来跟你们讲吧"},{"start":37.65,"end":41.98,"text":"就是说这对搭档是这么一种人"},{"start":42.38,"end":47.3,"text":"这对搭档当中的其中一个主要是他了"},{"start":47.85,"end":53.739,"text":"是某个网站红色网站的主编"},{"start":54.219,"end":56.259,"text":"新生代主编"},{"start":57.59,"end":60.43,"text":"然后在东部某省做生意"},{"start":60.43,"end":63.93,"text":"但是实质上呢他又是一个什么呃"},{"start":63.93,"end":66.93,"text":"地下左圈的一个头头"},{"start":68.21,"end":71.4,"text":"那么这个人他的神通广大"},{"start":71.4,"end":72.08,"text":"法力无边"},{"start":73.16,"end":74.22,"text":"有两个特点"},{"start":74.22,"end":75.52,"text":"一"},{"start":78.14,"end":80.72,"text":"吉他各个省份的那种上了名单的"},{"start":80.72,"end":82.12,"text":"留了案底的人"},{"start":82.12,"end":86.45,"text":"在QQ微信群里面都不敢实名的人"},{"start":86.45,"end":89.45,"text":"到他那儿去参加一个什么左言"},{"start":89.45,"end":95.89,"text":"其实就是一个金融资产阶级啊的一个小资女的"},{"start":95.89,"end":99.449,"text":"开的一个经济研讨会"},{"start":99.929,"end":104.66,"text":"竟然这些在各省都是呃隐姓埋名"},{"start":104.66,"end":108.4,"text":"东躲西藏的地下分子跑到他那研讨会里面"},{"start":108.4,"end":115.15,"text":"就在QQ群里面就纷纷把自己的实名姓名"},{"start":115.63,"end":119.31,"text":"电话号码籍贯都交上去了"},{"start":119.31,"end":120.23,"text":"而都公开了"},{"start":120.23,"end":121.51,"text":"都在QQ群里面公开了"},{"start":121.51,"end":122.19,"text":"随便谁"},{"start":122.19,"end":123.59,"text":"只是只要是QQ群里面的人"},{"start":123.59,"end":127.15,"text":"就都能看到神通广大一个啊"},{"start":127.15,"end":132.7,"text":"一个原因就一个表现意味着什么"},{"start":133.88,"end":134.98,"text":"你自己想"},{"start":134.98,"end":135.96,"text":"还有第二点"},{"start":135.96,"end":141.02,"text":"就是这个和童润中夫妇吃饭的这两个人呐"},{"start":141.02,"end":147.87,"text":"其中那一个他来过我们江苏省境内"},{"start":148.31,"end":149.57,"text":"或者他没来"},{"start":149.57,"end":152.61,"text":"他的势力想往这里渗透"},{"start":152.97,"end":155.93,"text":"想往这里的这些什么地下激进活动分子"},{"start":155.93,"end":156.76,"text":"这里渗透"},{"start":156.76,"end":160.04,"text":"你看镇江的两个镇江的那不就跑到他那边去"},{"start":160.04,"end":161.36,"text":"参加他那什么研讨会"},{"start":161.36,"end":163.64,"text":"拜他的码头了吗"},{"start":164.55,"end":165.79,"text":"他跑到我们这来"},{"start":166.87,"end":169.7,"text":"我们把他的情况啊"},{"start":169.7,"end":171.46,"text":"想要把这些人搞得激进化"},{"start":171.46,"end":172.02,"text":"怎么样的"},{"start":172.02,"end":175.63,"text":"我们把他情况汇总啊"},{"start":175.63,"end":177.61,"text":"把这个掌握了之后"},{"start":177.61,"end":180.61,"text":"因为我们那时候我是普通老百姓啊"},{"start":180.61,"end":181.88,"text":"我很害怕"},{"start":181.88,"end":187.33,"text":"我很害怕有这么一尊大神大手天降一样的"},{"start":187.33,"end":191.58,"text":"一下子把我们那些只是在啊南京啊"},{"start":191.58,"end":193.2,"text":"南京还被人嘲笑"},{"start":193.2,"end":197.51,"text":"说有小资开奔驰去开宝马去送送饭呢"},{"start":197.51,"end":200.9,"text":"他们只是普通人平民对吧"},{"start":200.9,"end":202.4,"text":"南京那个时候送饭的时候"},{"start":202.4,"end":206.17,"text":"就是他的势力进来了"},{"start":206.17,"end":210.49,"text":"想要把这些人给激进化啊"},{"start":210.49,"end":211.73,"text":"激进化什么激进化"},{"start":216.19,"end":218.39,"text":"我们我在苏州嘛"},{"start":218.39,"end":220.01,"text":"也在江苏省境内嘛"},{"start":220.01,"end":223.95,"text":"估计也是受省里面管辖的"},{"start":224.0,"end":225.66,"text":"我害怕呀"},{"start":225.66,"end":228.92,"text":"那么我了解相关情况之后呢"},{"start":228.92,"end":231.32,"text":"是向反映"},{"start":231.32,"end":235.77,"text":"那我告诉你这么一个神通广大的"},{"start":235.77,"end":238.97,"text":"这位神通广大到什么程度呢"},{"start":243.8,"end":244.96,"text":"我反映的材料"},{"start":244.96,"end":249.44,"text":"第二天还是第三天就出现在他的朋友圈里的"},{"start":250.2,"end":253.0,"text":"出现在他的案头上了"},{"start":256.339,"end":259.5,"text":"所以你们知道他是什么人了吧"},{"start":260.99,"end":264.99,"text":"你们知道他是什么性质的存在了吧"},{"start":274.92,"end":277.68,"text":"他和他的生意伙伴做生意做到哪里去了"},{"start":278.72,"end":280.42,"text":"加德满都"},{"start":280.86,"end":282.46,"text":"他自己做生意做到哪里去了"},{"start":283.46,"end":284.02,"text":"越南"},{"start":284.02,"end":286.8,"text":"我想这两个地方有啥生意可以这样做的"},{"start":286.8,"end":287.76,"text":"后来一想"},{"start":287.76,"end":294.89,"text":"原来这两个国家性质上有某种相似之处"},{"start":300.32,"end":305.289,"text":"所以我在动态里面我只敢点名他们是跨国商人"},{"start":305.969,"end":308.329,"text":"他们实质的身份我可不敢说"},{"start":309.769,"end":312.769,"text":"现在同仁忠夫妇去找他们吃饭了"},{"start":316.08,"end":322.03,"text":"我在这里向所有你们这种民粹分子"},{"start":322.31,"end":324.27,"text":"给你们警训一下"},{"start":330.84,"end":331.24,"text":"唉"},{"start":334.12,"end":335.96,"text":"好自为之"},{"start":336.63,"end":340.65,"text":"包括进了他那个什么左研那个研讨班"},{"start":340.65,"end":343.07,"text":"那个课里面的那几个"},{"start":344.13,"end":345.87,"text":"好自为之"},{"start":345.87,"end":349.61,"text":"你实名信息全都给他们了"},{"start":350.58,"end":352.12,"text":"好自为之"},{"start":352.12,"end":355.279,"text":"但是呢我要讲的就是说那种"},{"start":355.279,"end":356.999,"text":"进他研讨班的那几个"},{"start":356.999,"end":359.419,"text":"他来自江苏省的那几个"},{"start":364.0,"end":368.24,"text":"也是那种想要黑白两道通吃的人"},{"start":368.24,"end":371.86,"text":"也是那种想要脚踏两只船的人"},{"start":371.86,"end":377.31,"text":"也是那种想要设伏攻杀无辜者的人"},{"start":379.99,"end":381.51,"text":"设伏"},{"start":382.66,"end":387.52,"text":"做网捕获攻杀一些无辜者的人"},{"start":387.52,"end":391.33,"text":"他们也是这样的蛇蝎心肠之辈"},{"start":405.28,"end":412.12,"text":"好的现在这尊这尊神已经给你造出来了"},{"start":412.8,"end":414.2,"text":"要不要拜"},{"start":414.2,"end":417.0,"text":"你们自己看着办"},{"start":418.86,"end":420.78,"text":"要不要拜你们自己看着办哦"},{"start":422.26,"end":424.22,"text":"你们自己看着办吧"},{"start":428.88,"end":429.98,"text":"好吧"}],"source":"subtitle"}
