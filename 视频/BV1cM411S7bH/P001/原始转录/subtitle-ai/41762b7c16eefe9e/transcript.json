    {
      "ordinal": 203,
      "start_ms": 491999,
      "end_ms": 493659,
      "text": "书生全是你这种人"
    },
    {
      "ordinal": 204,
      "start_ms": 493659,
      "end_ms": 495339,
      "text": "当然可以出动社会关系"
