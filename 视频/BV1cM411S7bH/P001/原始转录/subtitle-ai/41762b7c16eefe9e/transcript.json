{
  "bvid": "BV1cM411S7bH",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "41762b7c16eefe9e4d938f8fbcb4738e404ef06218db83f7f2ef236ffda16186",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 0,
      "end_ms": 2880,
      "text": "这家伙还说我是小规模慈善活动"
    },
    {
      "ordinal": 1,
      "start_ms": 2880,
      "end_ms": 5640,
      "text": "我的所有时间加起来就是小规模慈善活动"
    },
    {
      "ordinal": 2,
      "start_ms": 5640,
      "end_ms": 7350,
      "text": "比如我直播的食堂"
    },
    {
      "ordinal": 3,
      "start_ms": 7350,
      "end_ms": 12460,
      "text": "首先我的慈善不仅包括小规模慈善"
    },
    {
      "ordinal": 4,
      "start_ms": 12460,
      "end_ms": 14740,
      "text": "我我的实践不仅包括小规模慈善活动"
    },
    {
      "ordinal": 5,
      "start_ms": 14740,
      "end_ms": 16400,
      "text": "还有你看不见的"
    },
    {
      "ordinal": 6,
      "start_ms": 16820,
      "end_ms": 19490,
      "text": "还有你看不见的活动啊"
    },
    {
      "ordinal": 7,
      "start_ms": 19490,
      "end_ms": 21650,
      "text": "当然台面上的实践"
    },
    {
      "ordinal": 8,
      "start_ms": 24500,
      "end_ms": 28900,
      "text": "进行50万基数的理论宣传"
    },
    {
      "ordinal": 9,
      "start_ms": 28960,
      "end_ms": 32140,
      "text": "50万基础的路线斗争的一个介绍"
    },
    {
      "ordinal": 10,
      "start_ms": 32140,
      "end_ms": 33820,
      "text": "在你眼里就不是实践吗"
    },
    {
      "ordinal": 11,
      "start_ms": 33820,
      "end_ms": 37900,
      "text": "我的实践比你大的多的多的多的多的多的多"
    },
    {
      "ordinal": 12,
      "start_ms": 40400,
      "end_ms": 43420,
      "text": "你的实践我不需要你"
    },
    {
      "ordinal": 13,
      "start_ms": 43420,
      "end_ms": 44620,
      "text": "你有很大的时间"
    },
    {
      "ordinal": 14,
      "start_ms": 44620,
      "end_ms": 47160,
      "text": "你只要你有一个时间就行了"
    },
    {
      "ordinal": 15,
      "start_ms": 47980,
      "end_ms": 49320,
      "text": "这位批评者"
    },
    {
      "ordinal": 16,
      "start_ms": 49320,
      "end_ms": 51000,
      "text": "我只有只要你有一个时间"
    },
    {
      "ordinal": 17,
      "start_ms": 51000,
      "end_ms": 52700,
      "text": "你就有批评我的资格"
    },
    {
      "ordinal": 18,
      "start_ms": 52700,
      "end_ms": 55490,
      "text": "你只要找到一位工人和你联署"
    },
    {
      "ordinal": 19,
      "start_ms": 55490,
      "end_ms": 56660,
      "text": "你就可以批评我"
    },
    {
      "ordinal": 20,
      "start_ms": 56660,
      "end_ms": 58220,
      "text": "我给你降低标准"
    },
    {
      "ordinal": 21,
      "start_ms": 58220,
      "end_ms": 60400,
      "text": "只要让他跟你联署一位"
    },
    {
      "ordinal": 22,
      "start_ms": 60400,
      "end_ms": 61360,
      "text": "我们严格一点"
    },
    {
      "ordinal": 23,
      "start_ms": 61360,
      "end_ms": 62080,
      "text": "产业工人"
    },
    {
      "ordinal": 24,
      "start_ms": 62080,
      "end_ms": 62950,
      "text": "产线工人"
    },
    {
      "ordinal": 25,
      "start_ms": 62950,
      "end_ms": 64989,
      "text": "你只要能找到一位产线工人"
    },
    {
      "ordinal": 26,
      "start_ms": 64989,
      "end_ms": 66940,
      "text": "他能够愿意和你联系"
    },
    {
      "ordinal": 27,
      "start_ms": 66940,
      "end_ms": 68920,
      "text": "你就可以公开批评我"
    },
    {
      "ordinal": 28,
      "start_ms": 71020,
      "end_ms": 73080,
      "text": "你说你说我取消你的"
    },
    {
      "ordinal": 29,
      "start_ms": 73080,
      "end_ms": 74730,
      "text": "你只要找到一个就行了"
    },
    {
      "ordinal": 30,
      "start_ms": 74730,
      "end_ms": 76060,
      "text": "我能找到"
    },
    {
      "ordinal": 31,
      "start_ms": 77400,
      "end_ms": 78860,
      "text": "你只要找到一个"
    },
    {
      "ordinal": 32,
      "start_ms": 78860,
      "end_ms": 80840,
      "text": "但是说会让他冒风险"
    },
    {
      "ordinal": 33,
      "start_ms": 80840,
      "end_ms": 82640,
      "text": "你这这好好好"
    },
    {
      "ordinal": 34,
      "start_ms": 82640,
      "end_ms": 84300,
      "text": "那我们换一种方式"
    },
    {
      "ordinal": 35,
      "start_ms": 84360,
      "end_ms": 86160,
      "text": "你只要晒一个账单"
    },
    {
      "ordinal": 36,
      "start_ms": 86160,
      "end_ms": 87450,
      "text": "晒一个账单"
    },
    {
      "ordinal": 37,
      "start_ms": 87450,
      "end_ms": 91560,
      "text": "你租了房子"
    },
    {
      "ordinal": 38,
      "start_ms": 91560,
      "end_ms": 94420,
      "text": "让工人群众在里面住"
    },
    {
      "ordinal": 39,
      "start_ms": 96580,
      "end_ms": 99150,
      "text": "你只要晒这个租房子的账单"
    },
    {
      "ordinal": 40,
      "start_ms": 99150,
      "end_ms": 102300,
      "text": "1万块钱就可以租好几个月"
    },
    {
      "ordinal": 41,
      "start_ms": 102300,
      "end_ms": 103560,
      "text": "你只要花1万块钱"
    },
    {
      "ordinal": 42,
      "start_ms": 103560,
      "end_ms": 106860,
      "text": "你就有资格骂我好吧"
    },
    {
      "ordinal": 43,
      "start_ms": 107940,
      "end_ms": 109440,
      "text": "这个账单我可以晒啊"
    },
    {
      "ordinal": 44,
      "start_ms": 109440,
      "end_ms": 110539,
      "text": "我可以晒"
    },
    {
      "ordinal": 45,
      "start_ms": 110880,
      "end_ms": 113280,
      "text": "我们前几天刚交了9000多块钱"
    },
    {
      "ordinal": 46,
      "start_ms": 116100,
      "end_ms": 117440,
      "text": "我当然可以晒啊"
    },
    {
      "ordinal": 47,
      "start_ms": 122140,
      "end_ms": 124360,
      "text": "你晒一下这个账单就可以了"
    },
    {
      "ordinal": 48,
      "start_ms": 125260,
      "end_ms": 126540,
      "text": "所有时间加起来"
    },
    {
      "ordinal": 49,
      "start_ms": 126540,
      "end_ms": 128340,
      "text": "你你非要实践"
    },
    {
      "ordinal": 50,
      "start_ms": 128340,
      "end_ms": 130680,
      "text": "你得是以我不是说比大小"
    },
    {
      "ordinal": 51,
      "start_ms": 130780,
      "end_ms": 131830,
      "text": "你得有"
    },
    {
      "ordinal": 52,
      "start_ms": 131830,
      "end_ms": 133030,
      "text": "你不能没有"
    },
    {
      "ordinal": 53,
      "start_ms": 133030,
      "end_ms": 134560,
      "text": "你得基本的得有啊"
    },
    {
      "ordinal": 54,
      "start_ms": 134560,
      "end_ms": 135340,
      "text": "你不能没有"
    },
    {
      "ordinal": 55,
      "start_ms": 135340,
      "end_ms": 135640,
      "text": "对不对"
    },
    {
      "ordinal": 56,
      "start_ms": 135640,
      "end_ms": 136660,
      "text": "我没有比大小"
    },
    {
      "ordinal": 57,
      "start_ms": 136660,
      "end_ms": 142620,
      "text": "你得有基本的最最最基本的1万块钱不算多吧"
    },
    {
      "ordinal": 58,
      "start_ms": 142620,
      "end_ms": 145380,
      "text": "朋友1万块钱算多吗"
    },
    {
      "ordinal": 59,
      "start_ms": 145380,
      "end_ms": 147340,
      "text": "哇老子花了几10万呢"
    },
    {
      "ordinal": 60,
      "start_ms": 150380,
      "end_ms": 153340,
      "text": "而且这个对你不是说不是用钱衡量"
    },
    {
      "ordinal": 61,
      "start_ms": 153340,
      "end_ms": 156940,
      "text": "是用这个钱抵达的那个抵达的那个方向"
    },
    {
      "ordinal": 62,
      "start_ms": 156940,
      "end_ms": 158450,
      "text": "来衡量这个钱"
    },
    {
      "ordinal": 63,
      "start_ms": 158450,
      "end_ms": 161380,
      "text": "而且这个钱花在了哪个方向上"
    },
    {
      "ordinal": 64,
      "start_ms": 162179,
      "end_ms": 163879,
      "text": "它的意义是什么"
    },
    {
      "ordinal": 65,
      "start_ms": 163879,
      "end_ms": 165259,
      "text": "他钱花的那个方向"
    },
    {
      "ordinal": 66,
      "start_ms": 165259,
      "end_ms": 166980,
      "text": "它的意义和目的是什么"
    },
    {
      "ordinal": 67,
      "start_ms": 168760,
      "end_ms": 171020,
      "text": "意义和目的是把人聚起来呀"
    },
    {
      "ordinal": 68,
      "start_ms": 172760,
      "end_ms": 174640,
      "text": "说改良不必然是错误的"
    },
    {
      "ordinal": 69,
      "start_ms": 176500,
      "end_ms": 177820,
      "text": "过半是我又搞改良"
    },
    {
      "ordinal": 70,
      "start_ms": 180140,
      "end_ms": 181220,
      "text": "但是那些改良"
    },
    {
      "ordinal": 71,
      "start_ms": 181220,
      "end_ms": 183880,
      "text": "同时整个世界是整个世界链条中的一个环节"
    },
    {
      "ordinal": 72,
      "start_ms": 183980,
      "end_ms": 185060,
      "text": "在为名字里"
    },
    {
      "ordinal": 73,
      "start_ms": 185060,
      "end_ms": 187340,
      "text": "他把改良奉为唯一正确的活动"
    },
    {
      "ordinal": 74,
      "start_ms": 187340,
      "end_ms": 189950,
      "text": "我没有把改良奉为唯一正确的活动啊"
    },
    {
      "ordinal": 75,
      "start_ms": 189950,
      "end_ms": 191080,
      "text": "恰恰相反"
    },
    {
      "ordinal": 76,
      "start_ms": 191100,
      "end_ms": 195960,
      "text": "我是反对各种要把小三全注册到符号系统当中"
    },
    {
      "ordinal": 77,
      "start_ms": 195960,
      "end_ms": 199460,
      "text": "小三拳把这个全字给它去掉"
    },
    {
      "ordinal": 78,
      "start_ms": 199460,
      "end_ms": 202530,
      "text": "那三种行动方式我们不反对的"
    },
    {
      "ordinal": 79,
      "start_ms": 202530,
      "end_ms": 204300,
      "text": "我们反对的是小三拳"
    },
    {
      "ordinal": 80,
      "start_ms": 204300,
      "end_ms": 205710,
      "text": "要把这三种行动方式"
    },
    {
      "ordinal": 81,
      "start_ms": 205710,
      "end_ms": 209600,
      "text": "仅仅是注册到合法性的体系里面就就就行了"
    },
    {
      "ordinal": 82,
      "start_ms": 209600,
      "end_ms": 210540,
      "text": "不是的"
    },
    {
      "ordinal": 83,
      "start_ms": 211939,
      "end_ms": 215169,
      "text": "我的改良当然从属于我的整个事业啊"
    },
    {
      "ordinal": 84,
      "start_ms": 215169,
      "end_ms": 218680,
      "text": "是我整个失业链条当中的一个环节"
    },
    {
      "ordinal": 85,
      "start_ms": 219880,
      "end_ms": 221160,
      "text": "你是我吗"
    },
    {
      "ordinal": 86,
      "start_ms": 222840,
      "end_ms": 225000,
      "text": "你知道我是整个事业的种种链条吗"
    },
    {
      "ordinal": 87,
      "start_ms": 225000,
      "end_ms": 226120,
      "text": "各个环节吗"
    },
    {
      "ordinal": 88,
      "start_ms": 226160,
      "end_ms": 227840,
      "text": "环节变成链条本身"
    },
    {
      "ordinal": 89,
      "start_ms": 227840,
      "end_ms": 229910,
      "text": "局部转化成了全部真理变成谬"
    },
    {
      "ordinal": 90,
      "start_ms": 229910,
      "end_ms": 231560,
      "text": "你知道我的全部底细吗"
    },
    {
      "ordinal": 91,
      "start_ms": 231560,
      "end_ms": 232700,
      "text": "你也不知道诶"
    },
    {
      "ordinal": 92,
      "start_ms": 232739,
      "end_ms": 235229,
      "text": "首先你请你过来"
    },
    {
      "ordinal": 93,
      "start_ms": 235229,
      "end_ms": 236369,
      "text": "我说再说一遍"
    },
    {
      "ordinal": 94,
      "start_ms": 236369,
      "end_ms": 239459,
      "text": "你请你过来考察一下我苏州的实践活动"
    },
    {
      "ordinal": 95,
      "start_ms": 239459,
      "end_ms": 241880,
      "text": "参加一下我苏州的线下活动"
    },
    {
      "ordinal": 96,
      "start_ms": 242779,
      "end_ms": 244929,
      "text": "这一点你首先你要做哦"
    },
    {
      "ordinal": 97,
      "start_ms": 244929,
      "end_ms": 248700,
      "text": "否则你凭什么说我的全部活动就是就是改良啊"
    },
    {
      "ordinal": 98,
      "start_ms": 250520,
      "end_ms": 253990,
      "text": "说当改良从属于整个什么事业时"
    },
    {
      "ordinal": 99,
      "start_ms": 253990,
      "end_ms": 255220,
      "text": "就具有真理性"
    },
    {
      "ordinal": 100,
      "start_ms": 255220,
      "end_ms": 259140,
      "text": "因为改良活动成为接触群众的一个重要方式"
    },
    {
      "ordinal": 101,
      "start_ms": 259159,
      "end_ms": 261738,
      "text": "对啊我不就是这样的吗"
    },
    {
      "ordinal": 102,
      "start_ms": 261738,
      "end_ms": 262309,
      "text": "没错"
    },
    {
      "ordinal": 103,
      "start_ms": 264720,
      "end_ms": 268020,
      "text": "如果把改良的从属地位抬到首位"
    },
    {
      "ordinal": 104,
      "start_ms": 268020,
      "end_ms": 269440,
      "text": "我没有说他是首位啊"
    },
    {
      "ordinal": 105,
      "start_ms": 269719,
      "end_ms": 271339,
      "text": "就从真理变成了谬误"
    },
    {
      "ordinal": 106,
      "start_ms": 271339,
      "end_ms": 274159,
      "text": "因为改良活动在改变个别工人生活的同时"
    },
    {
      "ordinal": 107,
      "start_ms": 274159,
      "end_ms": 276439,
      "text": "却成了麻痹广大工人的精神差"
    },
    {
      "ordinal": 108,
      "start_ms": 276439,
      "end_ms": 278710,
      "text": "所以说我要提醒大三拳啊"
    },
    {
      "ordinal": 109,
      "start_ms": 278710,
      "end_ms": 281050,
      "text": "我没有把他抬到了守卫啊"
    },
    {
      "ordinal": 110,
      "start_ms": 281050,
      "end_ms": 282250,
      "text": "我没有说我办这个场"
    },
    {
      "ordinal": 111,
      "start_ms": 282250,
      "end_ms": 282790,
      "text": "让他过来"
    },
    {
      "ordinal": 112,
      "start_ms": 282790,
      "end_ms": 285070,
      "text": "你请客吃饭只是第一步"
    },
    {
      "ordinal": 113,
      "start_ms": 285070,
      "end_ms": 288500,
      "text": "哎我从来没有说请客吃饭"
    },
    {
      "ordinal": 114,
      "start_ms": 288500,
      "end_ms": 291880,
      "text": "后面就要就是说自己造自己的自起炉灶啊"
    },
    {
      "ordinal": 115,
      "start_ms": 292240,
      "end_ms": 293740,
      "text": "自己起自己炉子"
    },
    {
      "ordinal": 116,
      "start_ms": 299610,
      "end_ms": 302850,
      "text": "因为武训慈善一举路线是一条一丝一毫"
    },
    {
      "ordinal": 117,
      "start_ms": 302850,
      "end_ms": 303510,
      "text": "不能触动线"
    },
    {
      "ordinal": 118,
      "start_ms": 303510,
      "end_ms": 304410,
      "text": "有社会关系的路"
    },
    {
      "ordinal": 119,
      "start_ms": 306480,
      "end_ms": 308500,
      "text": "说我是当代版鲁迅"
    },
    {
      "ordinal": 120,
      "start_ms": 312560,
      "end_ms": 313900,
      "text": "我只能笑一笑了"
    },
    {
      "ordinal": 121,
      "start_ms": 313900,
      "end_ms": 315910,
      "text": "你你都没有来过这里"
    },
    {
      "ordinal": 122,
      "start_ms": 315910,
      "end_ms": 321340,
      "text": "你这个人你先来到我苏州线下通报一下"
    },
    {
      "ordinal": 123,
      "start_ms": 321340,
      "end_ms": 323140,
      "text": "你就是这篇文章的作者"
    },
    {
      "ordinal": 124,
      "start_ms": 323140,
      "end_ms": 325060,
      "text": "i will show you something"
    },
    {
      "ordinal": 125,
      "start_ms": 325060,
      "end_ms": 326700,
      "text": "我让你看看"
    },
    {
      "ordinal": 126,
      "start_ms": 327759,
      "end_ms": 330000,
      "text": "就是说你对你在搞笑"
    },
    {
      "ordinal": 127,
      "start_ms": 331100,
      "end_ms": 332140,
      "text": "我觉得真的是"
    },
    {
      "ordinal": 128,
      "start_ms": 332140,
      "end_ms": 335710,
      "text": "我从来就是说把我的行动路线"
    },
    {
      "ordinal": 129,
      "start_ms": 335710,
      "end_ms": 337420,
      "text": "说成纯粹是改良的人"
    },
    {
      "ordinal": 130,
      "start_ms": 337420,
      "end_ms": 342059,
      "text": "是不是你把我的这个我从来我都说了"
    },
    {
      "ordinal": 131,
      "start_ms": 342059,
      "end_ms": 344219,
      "text": "我那个视频出来的一瞬间"
    },
    {
      "ordinal": 132,
      "start_ms": 344219,
      "end_ms": 345059,
      "text": "我就说了"
    },
    {
      "ordinal": 133,
      "start_ms": 345059,
      "end_ms": 346619,
      "text": "我们让我们请客吃饭"
    },
    {
      "ordinal": 134,
      "start_ms": 346619,
      "end_ms": 347699,
      "text": "但只是一个环节"
    },
    {
      "ordinal": 135,
      "start_ms": 347699,
      "end_ms": 349769,
      "text": "这是我们初步构想的一个环节"
    },
    {
      "ordinal": 136,
      "start_ms": 349769,
      "end_ms": 351310,
      "text": "它是有长远的路径的"
    },
    {
      "ordinal": 137,
      "start_ms": 351310,
      "end_ms": 352990,
      "text": "长短路径走到后面的话"
    },
    {
      "ordinal": 138,
      "start_ms": 352990,
      "end_ms": 357350,
      "text": "那些就是说就是说能够免费长久的"
    },
    {
      "ordinal": 139,
      "start_ms": 357350,
      "end_ms": 359150,
      "text": "制度性的免费的食物"
    },
    {
      "ordinal": 140,
      "start_ms": 359150,
      "end_ms": 361640,
      "text": "免费的住宿要实践这个东西"
    },
    {
      "ordinal": 141,
      "start_ms": 361640,
      "end_ms": 364950,
      "text": "你觉得光改光走改良能走得了吗"
    },
    {
      "ordinal": 142,
      "start_ms": 364950,
      "end_ms": 366600,
      "text": "我们要那个东西"
    },
    {
      "ordinal": 143,
      "start_ms": 366600,
      "end_ms": 369690,
      "text": "就相当于说我们要靶子上面的红星"
    },
    {
      "ordinal": 144,
      "start_ms": 369690,
      "end_ms": 372360,
      "text": "上面有一颗子弹的痕迹"
    },
    {
      "ordinal": 145,
      "start_ms": 372580,
      "end_ms": 375520,
      "text": "你非要说那个子弹痕迹是瞄上去的"
    },
    {
      "ordinal": 146,
      "start_ms": 375520,
      "end_ms": 377400,
      "text": "就污蔑我们没有枪吗"
    },
    {
      "ordinal": 147,
      "start_ms": 378680,
      "end_ms": 382180,
      "text": "我们我们不能够直接说我们要射击"
    },
    {
      "ordinal": 148,
      "start_ms": 382180,
      "end_ms": 383410,
      "text": "但是我们可以说"
    },
    {
      "ordinal": 149,
      "start_ms": 383410,
      "end_ms": 386300,
      "text": "我们要让靶子上面有一颗子弹的痕迹"
    },
    {
      "ordinal": 150,
      "start_ms": 386300,
      "end_ms": 387740,
      "text": "你就是因为我说了"
    },
    {
      "ordinal": 151,
      "start_ms": 387740,
      "end_ms": 389840,
      "text": "我们要让靶子上面有子弹的痕迹"
    },
    {
      "ordinal": 152,
      "start_ms": 389840,
      "end_ms": 390440,
      "text": "我说了"
    },
    {
      "ordinal": 153,
      "start_ms": 390440,
      "end_ms": 396440,
      "text": "我们要让劳动群众的食宿都是免费"
    },
    {
      "ordinal": 154,
      "start_ms": 396440,
      "end_ms": 398180,
      "text": "永久免费"
    },
    {
      "ordinal": 155,
      "start_ms": 398200,
      "end_ms": 400920,
      "text": "你既然就说我这个人是改良"
    },
    {
      "ordinal": 156,
      "start_ms": 400920,
      "end_ms": 402120,
      "text": "我提出这个要求"
    },
    {
      "ordinal": 157,
      "start_ms": 402120,
      "end_ms": 403470,
      "text": "就意味着我不是改良啊"
    },
    {
      "ordinal": 158,
      "start_ms": 403470,
      "end_ms": 405720,
      "text": "就是我肯定是要用激进的手段"
    },
    {
      "ordinal": 159,
      "start_ms": 405720,
      "end_ms": 406800,
      "text": "根本性的手段"
    },
    {
      "ordinal": 160,
      "start_ms": 406800,
      "end_ms": 409060,
      "text": "彻底的手段来来实现这个目的的"
    },
    {
      "ordinal": 161,
      "start_ms": 409080,
      "end_ms": 410160,
      "text": "你在搞笑"
    },
    {
      "ordinal": 162,
      "start_ms": 410160,
      "end_ms": 411260,
      "text": "are you kid me"
    },
    {
      "ordinal": 163,
      "start_ms": 412020,
      "end_ms": 413060,
      "text": "所以我是武训"
    },
    {
      "ordinal": 164,
      "start_ms": 413060,
      "end_ms": 414080,
      "text": "武训有说了"
    },
    {
      "ordinal": 165,
      "start_ms": 414080,
      "end_ms": 417710,
      "text": "要让所有人都有这个士绅的资格吗"
    },
    {
      "ordinal": 166,
      "start_ms": 417710,
      "end_ms": 419060,
      "text": "武训有这样说过吗"
    },
    {
      "ordinal": 167,
      "start_ms": 419060,
      "end_ms": 420540,
      "text": "或者五迅有说过"
    },
    {
      "ordinal": 168,
      "start_ms": 420680,
      "end_ms": 425300,
      "text": "要让所有穷人家的孩子都免费"
    },
    {
      "ordinal": 169,
      "start_ms": 425300,
      "end_ms": 426500,
      "text": "可以有学上吗"
    },
    {
      "ordinal": 170,
      "start_ms": 426500,
      "end_ms": 427460,
      "text": "他有没有这样说"
    },
    {
      "ordinal": 171,
      "start_ms": 427460,
      "end_ms": 430240,
      "text": "有没有推广到一个普遍性武铉"
    },
    {
      "ordinal": 172,
      "start_ms": 430240,
      "end_ms": 431080,
      "text": "如果公开这样说"
    },
    {
      "ordinal": 173,
      "start_ms": 431080,
      "end_ms": 432160,
      "text": "他立刻就没了"
    },
    {
      "ordinal": 174,
      "start_ms": 432160,
      "end_ms": 433039,
      "text": "我在"
    },
    {
      "ordinal": 175,
      "start_ms": 433039,
      "end_ms": 435679,
      "text": "但我就说我们说我们的舆论空间"
    },
    {
      "ordinal": 176,
      "start_ms": 437659,
      "end_ms": 440880,
      "text": "我可以空白这样说明白吗"
    },
    {
      "ordinal": 177,
      "start_ms": 444540,
      "end_ms": 446400,
      "text": "巴不得社会上遍地都是为社会上"
    },
    {
      "ordinal": 178,
      "start_ms": 446400,
      "end_ms": 448680,
      "text": "如果遍地都是为民族发自产阶级吓掉了"
    },
    {
      "ordinal": 179,
      "start_ms": 448680,
      "end_ms": 450240,
      "text": "第二天就睡不着觉了"
    },
    {
      "ordinal": 180,
      "start_ms": 450240,
      "end_ms": 451760,
      "text": "肯定睡不着觉了"
    },
    {
      "ordinal": 181,
      "start_ms": 451760,
      "end_ms": 453080,
      "text": "因为我们要我"
    },
    {
      "ordinal": 182,
      "start_ms": 453080,
      "end_ms": 457000,
      "text": "我的目的就是说希望是社会上遍地都是为名字"
    },
    {
      "ordinal": 183,
      "start_ms": 457740,
      "end_ms": 460040,
      "text": "工业区周围遍地都是这样的"
    },
    {
      "ordinal": 184,
      "start_ms": 460040,
      "end_ms": 461800,
      "text": "这个公益食堂"
    },
    {
      "ordinal": 185,
      "start_ms": 462940,
      "end_ms": 466040,
      "text": "你在那个时候就有阶级力量实质性扭转了"
    },
    {
      "ordinal": 186,
      "start_ms": 466400,
      "end_ms": 467900,
      "text": "他敢降工资"
    },
    {
      "ordinal": 187,
      "start_ms": 467900,
      "end_ms": 469040,
      "text": "敢按你的说法"
    },
    {
      "ordinal": 188,
      "start_ms": 469040,
      "end_ms": 469700,
      "text": "降工资"
    },
    {
      "ordinal": 189,
      "start_ms": 469700,
      "end_ms": 471500,
      "text": "把他公益食堂占的好处"
    },
    {
      "ordinal": 190,
      "start_ms": 471500,
      "end_ms": 473180,
      "text": "然后转到他自己口袋里"
    },
    {
      "ordinal": 191,
      "start_ms": 473180,
      "end_ms": 473600,
      "text": "降工资"
    },
    {
      "ordinal": 192,
      "start_ms": 473600,
      "end_ms": 474400,
      "text": "他敢吗"
    },
    {
      "ordinal": 193,
      "start_ms": 474400,
      "end_ms": 475480,
      "text": "他敢吗"
    },
    {
      "ordinal": 194,
      "start_ms": 475480,
      "end_ms": 476470,
      "text": "他敢吗"
    },
    {
      "ordinal": 195,
      "start_ms": 476470,
      "end_ms": 477940,
      "text": "他搞笑呢是吧"
    },
    {
      "ordinal": 196,
      "start_ms": 477940,
      "end_ms": 481760,
      "text": "真的是这个人真的太搞笑了"
    },
    {
      "ordinal": 197,
      "start_ms": 481760,
      "end_ms": 482540,
      "text": "写这个东西的人"
    },
    {
      "ordinal": 198,
      "start_ms": 482540,
      "end_ms": 486420,
      "text": "真的是说一丝一毫不能触动现有社会关系"
    },
    {
      "ordinal": 199,
      "start_ms": 486659,
      "end_ms": 488399,
      "text": "当然可以触动世界"
    },
    {
      "ordinal": 200,
      "start_ms": 488399,
      "end_ms": 488999,
      "text": "有社会关系"
    },
    {
      "ordinal": 201,
      "start_ms": 488999,
      "end_ms": 491039,
      "text": "武训的学堂里面全是小孩"
    },
    {
      "ordinal": 202,
      "start_ms": 491039,
      "end_ms": 491999,
      "text": "全是教书先生"
