{
  "bvid": "BV1rh411A7vK",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "0466a13e40c5584fdb0588a3ebfe5ae1b6cc9507192dce69e620f8b63f41880e",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 1620,
      "end_ms": 5050,
      "text": "就是对于这个历史调研室"
    },
    {
      "ordinal": 1,
      "start_ms": 5050,
      "end_ms": 8260,
      "text": "他做的一系列关于什么芬兰内战"
    },
    {
      "ordinal": 2,
      "start_ms": 8260,
      "end_ms": 9620,
      "text": "苏芬战争"
    },
    {
      "ordinal": 3,
      "start_ms": 10040,
      "end_ms": 14840,
      "text": "还有什么关于曼纳海姆这一系列的视频啊"
    },
    {
      "ordinal": 4,
      "start_ms": 15160,
      "end_ms": 19680,
      "text": "我认为他对于中国的这个年轻人的"
    },
    {
      "ordinal": 5,
      "start_ms": 20040,
      "end_ms": 22650,
      "text": "政治立场和意识形态的影响"
    },
    {
      "ordinal": 6,
      "start_ms": 22650,
      "end_ms": 27660,
      "text": "造成了相当恶劣的一个作用"
    },
    {
      "ordinal": 7,
      "start_ms": 29940,
      "end_ms": 31520,
      "text": "啊是相当恶劣的"
    },
    {
      "ordinal": 8,
      "start_ms": 33440,
      "end_ms": 36280,
      "text": "我把影响两个字放到前面就说了"
    },
    {
      "ordinal": 9,
      "start_ms": 36280,
      "end_ms": 37780,
      "text": "后面只能说恶劣的作用"
    },
    {
      "ordinal": 10,
      "start_ms": 37780,
      "end_ms": 40600,
      "text": "这对于意识形态和政治立场做"
    },
    {
      "ordinal": 11,
      "start_ms": 40600,
      "end_ms": 42500,
      "text": "造成了恶劣的影响"
    },
    {
      "ordinal": 12,
      "start_ms": 42960,
      "end_ms": 47350,
      "text": "那么这个影响是不言而喻的"
    },
    {
      "ordinal": 13,
      "start_ms": 47350,
      "end_ms": 49330,
      "text": "这个影响是什么"
    },
    {
      "ordinal": 14,
      "start_ms": 49330,
      "end_ms": 51739,
      "text": "我觉得再怎么说"
    },
    {
      "ordinal": 15,
      "start_ms": 51900,
      "end_ms": 55770,
      "text": "这个影响也非常难以啊"
    },
    {
      "ordinal": 16,
      "start_ms": 55770,
      "end_ms": 57279,
      "text": "挽回了"
    },
    {
      "ordinal": 17,
      "start_ms": 57700,
      "end_ms": 60400,
      "text": "那么只能说他打他的"
    },
    {
      "ordinal": 18,
      "start_ms": 60400,
      "end_ms": 61500,
      "text": "我打我的"
    },
    {
      "ordinal": 19,
      "start_ms": 62420,
      "end_ms": 63520,
      "text": "我在这里啊"
    },
    {
      "ordinal": 20,
      "start_ms": 63520,
      "end_ms": 64330,
      "text": "我实名"
    },
    {
      "ordinal": 21,
      "start_ms": 64330,
      "end_ms": 66500,
      "text": "我作为我叫刘思墨啊"
    },
    {
      "ordinal": 22,
      "start_ms": 67000,
      "end_ms": 69820,
      "text": "啊身份证号的话"
    },
    {
      "ordinal": 23,
      "start_ms": 69820,
      "end_ms": 73770,
      "text": "你到我的b站有个动态啊"
    },
    {
      "ordinal": 24,
      "start_ms": 73770,
      "end_ms": 76000,
      "text": "有个动态能找到我身份证号"
    },
    {
      "ordinal": 25,
      "start_ms": 76540,
      "end_ms": 81040,
      "text": "我是江苏省苏州市吴中区的啊"
    },
    {
      "ordinal": 26,
      "start_ms": 81040,
      "end_ms": 82899,
      "text": "一个一个一个公民啊"
    },
    {
      "ordinal": 27,
      "start_ms": 83380,
      "end_ms": 84490,
      "text": "我就说了"
    },
    {
      "ordinal": 28,
      "start_ms": 84490,
      "end_ms": 91759,
      "text": "假如假如我出生在啊那个时期的芬兰"
    },
    {
      "ordinal": 29,
      "start_ms": 91960,
      "end_ms": 94420,
      "text": "假如我出生在那个时期的芬兰"
    },
    {
      "ordinal": 30,
      "start_ms": 94420,
      "end_ms": 99550,
      "text": "我现在我在社会上还有一定的影响力啊"
    },
    {
      "ordinal": 31,
      "start_ms": 99550,
      "end_ms": 104340,
      "text": "全国各地响应我的公益公益理念的这个啊"
    },
    {
      "ordinal": 32,
      "start_ms": 104340,
      "end_ms": 105980,
      "text": "这个群众啊"
    },
    {
      "ordinal": 33,
      "start_ms": 106200,
      "end_ms": 108360,
      "text": "还有那么几百号人"
    },
    {
      "ordinal": 34,
      "start_ms": 108360,
      "end_ms": 113740,
      "text": "假如我回到12 十世纪"
    },
    {
      "ordinal": 35,
      "start_ms": 113740,
      "end_ms": 116700,
      "text": "这个是什么"
    },
    {
      "ordinal": 36,
      "start_ms": 118860,
      "end_ms": 122940,
      "text": "20年代的芬兰是啊"
    },
    {
      "ordinal": 37,
      "start_ms": 122940,
      "end_ms": 123810,
      "text": "1919年"
    },
    {
      "ordinal": 38,
      "start_ms": 123810,
      "end_ms": 125550,
      "text": "192几年的芬兰"
    },
    {
      "ordinal": 39,
      "start_ms": 125550,
      "end_ms": 128020,
      "text": "或者说后面他打内战芬兰"
    },
    {
      "ordinal": 40,
      "start_ms": 130539,
      "end_ms": 133200,
      "text": "不是他是打这个苏芬战争的芬兰"
    },
    {
      "ordinal": 41,
      "start_ms": 134220,
      "end_ms": 135500,
      "text": "我会告诉你"
    },
    {
      "ordinal": 42,
      "start_ms": 138860,
      "end_ms": 140720,
      "text": "我会加入"
    },
    {
      "ordinal": 43,
      "start_ms": 141980,
      "end_ms": 145060,
      "text": "我会加入工人左翼的"
    },
    {
      "ordinal": 44,
      "start_ms": 147430,
      "end_ms": 148240,
      "text": "我加入不了"
    },
    {
      "ordinal": 45,
      "start_ms": 148240,
      "end_ms": 150400,
      "text": "我没那个没那个本事啊"
    },
    {
      "ordinal": 46,
      "start_ms": 150400,
      "end_ms": 153980,
      "text": "那我会参加芬兰的红军"
    },
    {
      "ordinal": 47,
      "start_ms": 154519,
      "end_ms": 156800,
      "text": "我就会参加芬兰的红军"
    },
    {
      "ordinal": 48,
      "start_ms": 160850,
      "end_ms": 164980,
      "text": "哪怕是所谓的社民党执政的啊"
    },
    {
      "ordinal": 49,
      "start_ms": 166360,
      "end_ms": 169830,
      "text": "代议制政府致力于推翻社民党"
    },
    {
      "ordinal": 50,
      "start_ms": 169830,
      "end_ms": 173520,
      "text": "或者说是芬兰右翼执政的代议制政府"
    },
    {
      "ordinal": 51,
      "start_ms": 173520,
      "end_ms": 175980,
      "text": "因为我们作为无产阶级"
    },
    {
      "ordinal": 52,
      "start_ms": 176799,
      "end_ms": 180540,
      "text": "我们从来不相信通过资产阶级代议制"
    },
    {
      "ordinal": 53,
      "start_ms": 180540,
      "end_ms": 183120,
      "text": "可以通过您这个身吧"
    },
    {
      "ordinal": 54,
      "start_ms": 183120,
      "end_ms": 185010,
      "text": "一人一票的那个形式"
    },
    {
      "ordinal": 55,
      "start_ms": 185010,
      "end_ms": 189640,
      "text": "可以维护在当时的历史情境下"
    },
    {
      "ordinal": 56,
      "start_ms": 189640,
      "end_ms": 193080,
      "text": "陷于微贷的无产阶级的绝对的利益"
    },
    {
      "ordinal": 57,
      "start_ms": 194619,
      "end_ms": 197159,
      "text": "代议制的一人一票的这种形式"
    },
    {
      "ordinal": 58,
      "start_ms": 197159,
      "end_ms": 199640,
      "text": "是不能表达利益的"
    },
    {
      "ordinal": 59,
      "start_ms": 201020,
      "end_ms": 202720,
      "text": "维护利益的"
    },
    {
      "ordinal": 60,
      "start_ms": 202720,
      "end_ms": 207520,
      "text": "它的紧迫性以及这样的利益不被维护"
    },
    {
      "ordinal": 61,
      "start_ms": 208519,
      "end_ms": 212109,
      "text": "它的造成损失的不可挽回性的"
    },
    {
      "ordinal": 62,
      "start_ms": 212109,
      "end_ms": 214640,
      "text": "这些数字不应当是平等的"
    },
    {
      "ordinal": 63,
      "start_ms": 215660,
      "end_ms": 218260,
      "text": "那么这苏维埃呢是给予这个工人"
    },
    {
      "ordinal": 64,
      "start_ms": 222630,
      "end_ms": 229680,
      "text": "我觉得在比如说在很多危机到极端的议题上"
    },
    {
      "ordinal": 65,
      "start_ms": 231480,
      "end_ms": 237140,
      "text": "无产阶级生命和生存的基本保障"
    },
    {
      "ordinal": 66,
      "start_ms": 237140,
      "end_ms": 239300,
      "text": "受到严重威胁的无产阶级"
    },
    {
      "ordinal": 67,
      "start_ms": 239300,
      "end_ms": 245480,
      "text": "它在重大的公共议题上的权重应当是五倍"
    },
    {
      "ordinal": 68,
      "start_ms": 245480,
      "end_ms": 246590,
      "text": "我都觉得太少"
    },
    {
      "ordinal": 69,
      "start_ms": 246590,
      "end_ms": 248400,
      "text": "十倍百倍千倍"
    },
    {
      "ordinal": 70,
      "start_ms": 248720,
      "end_ms": 252860,
      "text": "那么资产阶级的待遇制会容忍这样的权重吗"
    },
    {
      "ordinal": 71,
      "start_ms": 252860,
      "end_ms": 253580,
      "text": "不可能"
    },
    {
      "ordinal": 72,
      "start_ms": 253580,
      "end_ms": 255100,
      "text": "对不对啊"
    },
    {
      "ordinal": 73,
      "start_ms": 255999,
      "end_ms": 257819,
      "text": "所以我会加入"
    },
    {
      "ordinal": 74,
      "start_ms": 259079,
      "end_ms": 262440,
      "text": "我会加入芬兰的"
    },
    {
      "ordinal": 75,
      "start_ms": 264060,
      "end_ms": 265820,
      "text": "无产阶级的啊"
    },
    {
      "ordinal": 76,
      "start_ms": 265820,
      "end_ms": 268300,
      "text": "你说他的红军或者他游击队"
    },
    {
      "ordinal": 77,
      "start_ms": 273500,
      "end_ms": 281640,
      "text": "推翻芬兰代制政府的努力和战争行为当中去"
    },
    {
      "ordinal": 78,
      "start_ms": 282039,
      "end_ms": 283299,
      "text": "我再明确一点"
    },
    {
      "ordinal": 79,
      "start_ms": 283299,
      "end_ms": 285369,
      "text": "如果我出生在那个时代"
    },
    {
      "ordinal": 80,
      "start_ms": 285369,
      "end_ms": 287040,
      "text": "我一定会这样做"
    },
    {
      "ordinal": 81,
      "start_ms": 288079,
      "end_ms": 291459,
      "text": "我一定会去用我的鲜血"
    },
    {
      "ordinal": 82,
      "start_ms": 291459,
      "end_ms": 294100,
      "text": "鲜血鲜血去保卫"
    },
    {
      "ordinal": 83,
      "start_ms": 295220,
      "end_ms": 296580,
      "text": "保卫革命"
    },
    {
      "ordinal": 84,
      "start_ms": 297000,
      "end_ms": 298230,
      "text": "去抗击"
    },
    {
      "ordinal": 85,
      "start_ms": 298230,
      "end_ms": 300300,
      "text": "去反抗苏联啊"
    },
    {
      "ordinal": 86,
      "start_ms": 300300,
      "end_ms": 303560,
      "text": "不是应该是芬兰反动政府的白军"
    },
    {
      "ordinal": 87,
      "start_ms": 305040,
      "end_ms": 306500,
      "text": "我再明确一点"
    },
    {
      "ordinal": 88,
      "start_ms": 307120,
      "end_ms": 308190,
      "text": "明白吗"
    },
    {
      "ordinal": 89,
      "start_ms": 308190,
      "end_ms": 312570,
      "text": "那如果是在后来的苏芬战争过程当中呢"
    },
    {
      "ordinal": 90,
      "start_ms": 312570,
      "end_ms": 318200,
      "text": "我一定会和芬兰的无产阶级站在一起"
    },
    {
      "ordinal": 91,
      "start_ms": 320580,
      "end_ms": 323000,
      "text": "和苏联的无产阶级站在一起"
    },
    {
      "ordinal": 92,
      "start_ms": 323000,
      "end_ms": 328429,
      "text": "一起去推翻芬兰的白色力量的"
    },
    {
      "ordinal": 93,
      "start_ms": 328429,
      "end_ms": 332269,
      "text": "一起去推翻芬兰的小资产阶级和资产阶级"
    },
    {
      "ordinal": 94,
      "start_ms": 332269,
      "end_ms": 336560,
      "text": "小游产阶级他们所组成的"
    },
    {
      "ordinal": 95,
      "start_ms": 339020,
      "end_ms": 340720,
      "text": "芬兰的统治当局"
    },
    {
      "ordinal": 96,
      "start_ms": 346400,
      "end_ms": 347590,
      "text": "我再明确一点"
    },
    {
      "ordinal": 97,
      "start_ms": 347590,
      "end_ms": 350200,
      "text": "如果是我本人以及"
    },
    {
      "ordinal": 98,
      "start_ms": 350460,
      "end_ms": 354060,
      "text": "如果说甚至我带着我的这个公益团体一起"
    },
    {
      "ordinal": 99,
      "start_ms": 354060,
      "end_ms": 356040,
      "text": "我们一定会参与到一个去"
    },
    {
      "ordinal": 100,
      "start_ms": 356040,
      "end_ms": 358260,
      "text": "保障无产阶级根本利益"
    },
    {
      "ordinal": 101,
      "start_ms": 358260,
      "end_ms": 361920,
      "text": "保障无产阶免于帝国主义威胁"
    },
    {
      "ordinal": 102,
      "start_ms": 361920,
      "end_ms": 368839,
      "text": "免于帝国主义战争的无意义的自杀性的消亡"
    },
    {
      "ordinal": 103,
      "start_ms": 368839,
      "end_ms": 374140,
      "text": "以免于恶劣的工作条件和残酷的剥削压榨"
    },
    {
      "ordinal": 104,
      "start_ms": 374680,
      "end_ms": 376320,
      "text": "为了实现这样的目的"
    },
    {
      "ordinal": 105,
      "start_ms": 376320,
      "end_ms": 379230,
      "text": "战争烈度我们可以接受"
    },
    {
      "ordinal": 106,
      "start_ms": 379230,
      "end_ms": 380780,
      "text": "我愿意去接受"
    },
    {
      "ordinal": 107,
      "start_ms": 381180,
      "end_ms": 387090,
      "text": "我就想请问你们作为曼纳海姆啊"
    },
    {
      "ordinal": 108,
      "start_ms": 387090,
      "end_ms": 388650,
      "text": "就是这个历史调研室"
    },
    {
      "ordinal": 109,
      "start_ms": 388650,
      "end_ms": 391500,
      "text": "关于曼纳海姆的一系列视频的观看者"
    },
    {
      "ordinal": 110,
      "start_ms": 391500,
      "end_ms": 393030,
      "text": "你们会站在哪一边"
    },
    {
      "ordinal": 111,
      "start_ms": 393030,
      "end_ms": 396900,
      "text": "你们所虚构的那个所谓的广大的人民"
    },
    {
      "ordinal": 112,
      "start_ms": 399040,
      "end_ms": 401140,
      "text": "我不知道你们指的是什么"
    },
    {
      "ordinal": 113,
      "start_ms": 407220,
      "end_ms": 412100,
      "text": "在一个反抗这些白色统治的过程当中"
    },
    {
      "ordinal": 114,
      "start_ms": 412100,
      "end_ms": 415340,
      "text": "很多情况下我们是少数"
    },
    {
      "ordinal": 115,
      "start_ms": 415340,
      "end_ms": 419000,
      "text": "我们甚至是极少数啊"
    },
    {
      "ordinal": 116,
      "start_ms": 420620,
      "end_ms": 421700,
      "text": "广大不广大"
    },
    {
      "ordinal": 117,
      "start_ms": 421700,
      "end_ms": 424820,
      "text": "不是我们要考虑的啊"
    },
    {
      "ordinal": 118,
      "start_ms": 425140,
      "end_ms": 428020,
      "text": "白色的力量污蔑我们说我们不是人民"
    },
    {
      "ordinal": 119,
      "start_ms": 428020,
      "end_ms": 429790,
      "text": "这也不是我们要考虑的"
    },
    {
      "ordinal": 120,
      "start_ms": 429790,
      "end_ms": 432060,
      "text": "我们要做的就是维护我们的"
    },
    {
      "ordinal": 121,
      "start_ms": 433160,
      "end_ms": 439820,
      "text": "避免无可挽回的悲剧和损害的那种利益"
    },
    {
      "ordinal": 122,
      "start_ms": 439979,
      "end_ms": 442979,
      "text": "那种绝对的利益幸存下来"
    },
    {
      "ordinal": 123,
      "start_ms": 442979,
      "end_ms": 447040,
      "text": "利生存下来的利益不仅要这样幸存下来"
    },
    {
      "ordinal": 124,
      "start_ms": 447040,
      "end_ms": 447880,
      "text": "要这样活下来"
    },
    {
      "ordinal": 125,
      "start_ms": 447880,
      "end_ms": 449560,
      "text": "我们还要团结起来"
    },
    {
      "ordinal": 126,
      "start_ms": 449560,
      "end_ms": 450740,
      "text": "去改变"
    },
    {
      "ordinal": 127,
      "start_ms": 450900,
      "end_ms": 454560,
      "text": "去推翻那个造成我们不可挽回的悲剧的"
    },
    {
      "ordinal": 128,
      "start_ms": 454560,
      "end_ms": 455790,
      "text": "那种模式"
    },
    {
      "ordinal": 129,
      "start_ms": 455790,
      "end_ms": 459320,
      "text": "那种阶级统治的关系"
    },
    {
      "ordinal": 130,
      "start_ms": 460060,
      "end_ms": 461640,
      "text": "这个话说的很清楚了"
    },
    {
      "ordinal": 131,
      "start_ms": 461640,
      "end_ms": 463290,
      "text": "如果我回到那个时代"
    },
    {
      "ordinal": 132,
      "start_ms": 463290,
      "end_ms": 464940,
      "text": "如果芬兰打内战"
    },
    {
      "ordinal": 133,
      "start_ms": 464940,
      "end_ms": 466740,
      "text": "我一定会站在红军那边"
    },
    {
      "ordinal": 134,
      "start_ms": 466740,
      "end_ms": 468440,
      "text": "我死都不会后悔"
    },
    {
      "ordinal": 135,
      "start_ms": 469520,
      "end_ms": 470500,
      "text": "不仅我死都不会"
    },
    {
      "ordinal": 136,
      "start_ms": 470500,
      "end_ms": 473620,
      "text": "后来我还会去尽量的说服我的家人朋友"
    },
    {
      "ordinal": 137,
      "start_ms": 473620,
      "end_ms": 476720,
      "text": "一起参与到这么一个阶级反抗运动当中来"
    },
    {
      "ordinal": 138,
      "start_ms": 476720,
      "end_ms": 479420,
      "text": "它又具有历史的绝对的正义性"
    },
    {
      "ordinal": 139,
      "start_ms": 480040,
      "end_ms": 483420,
      "text": "我就请问你们看了这个人的视频的"
    },
    {
      "ordinal": 140,
      "start_ms": 483420,
      "end_ms": 485660,
      "text": "你们这些人你们会站在哪一边"
    },
    {
      "ordinal": 141,
      "start_ms": 485719,
      "end_ms": 487789,
      "text": "你们是要抽象的"
    },
    {
      "ordinal": 142,
      "start_ms": 487789,
      "end_ms": 491300,
      "text": "虚构一个所谓的广大的芬兰人民"
    },
    {
      "ordinal": 143,
      "start_ms": 492139,
      "end_ms": 495159,
      "text": "你不要站在白色统治那边"
    },
    {
      "ordinal": 144,
      "start_ms": 495159,
      "end_ms": 499829,
      "text": "要就是站在这种资产阶级或者说这种当权的啊"
    },
    {
      "ordinal": 145,
      "start_ms": 499829,
      "end_ms": 502979,
      "text": "这些旧沙俄贵族军官统治精英"
    },
    {
      "ordinal": 146,
      "start_ms": 502979,
      "end_ms": 504820,
      "text": "既得利益者那边"
    },
    {
      "ordinal": 147,
      "start_ms": 507360,
      "end_ms": 509060,
      "text": "那你就站在那一边吧"
    },
    {
      "ordinal": 148,
      "start_ms": 509060,
      "end_ms": 511520,
      "text": "啊那你就是我们的敌人"
    },
    {
      "ordinal": 149,
      "start_ms": 513159,
      "end_ms": 514140,
      "text": "很明确的"
    },
    {
      "ordinal": 150,
      "start_ms": 514140,
      "end_ms": 515340,
      "text": "这个话说的非常明确"
    },
    {
      "ordinal": 151,
      "start_ms": 515340,
      "end_ms": 515880,
      "text": "但我说了"
    },
    {
      "ordinal": 152,
      "start_ms": 515880,
      "end_ms": 517140,
      "text": "这是一个历史的假设"
    },
    {
      "ordinal": 153,
      "start_ms": 517140,
      "end_ms": 519539,
      "text": "说如果说我们穿越到"
    },
    {
      "ordinal": 154,
      "start_ms": 519539,
      "end_ms": 522438,
      "text": "穿越到芬兰的那个时局当中去"
    },
    {
      "ordinal": 155,
      "start_ms": 522659,
      "end_ms": 527599,
      "text": "就算我现在知道芬兰内战当中红军失败了"
    },
    {
      "ordinal": 156,
      "start_ms": 527840,
      "end_ms": 530870,
      "text": "芬兰内战的红军团死了2万多人"
    },
    {
      "ordinal": 157,
      "start_ms": 530870,
      "end_ms": 533000,
      "text": "白军可能就死了几千啊"
    },
    {
      "ordinal": 158,
      "start_ms": 533000,
      "end_ms": 534590,
      "text": "说曼纳海姆军事胜利了"
    },
    {
      "ordinal": 159,
      "start_ms": 534590,
      "end_ms": 536920,
      "text": "这2万多人当中有我一个"
    },
    {
      "ordinal": 160,
      "start_ms": 537580,
      "end_ms": 538800,
      "text": "我死而无悔"
    },
    {
      "ordinal": 161,
      "start_ms": 541380,
      "end_ms": 542280,
      "text": "我不在乎"
    },
    {
      "ordinal": 162,
      "start_ms": 543080,
      "end_ms": 546250,
      "text": "因为我所维护的是我们的根本利益"
    },
    {
      "ordinal": 163,
      "start_ms": 546250,
      "end_ms": 547780,
      "text": "绝对利益"
    },
    {
      "ordinal": 164,
      "start_ms": 551460,
      "end_ms": 553760,
      "text": "你们当然说你们到时候去投靠白居"
    },
    {
      "ordinal": 165,
      "start_ms": 553760,
      "end_ms": 556140,
      "text": "你更有可能幸存下来"
    },
    {
      "ordinal": 166,
      "start_ms": 557700,
      "end_ms": 559280,
      "text": "那是你们的选择"
    },
    {
      "ordinal": 167,
      "start_ms": 559280,
      "end_ms": 560920,
      "text": "我再明确一点"
    },
    {
      "ordinal": 168,
      "start_ms": 563320,
      "end_ms": 564810,
      "text": "我再明确一点"
    },
    {
      "ordinal": 169,
      "start_ms": 564810,
      "end_ms": 568980,
      "text": "我无法容忍一种资产阶级代议制下面的"
    },
    {
      "ordinal": 170,
      "start_ms": 568980,
      "end_ms": 570270,
      "text": "虚假的平等"
    },
    {
      "ordinal": 171,
      "start_ms": 570270,
      "end_ms": 572400,
      "text": "虚假的所谓的大多数"
    },
    {
      "ordinal": 172,
      "start_ms": 572420,
      "end_ms": 574340,
      "text": "这代表大多数人民了吗"
    },
    {
      "ordinal": 173,
      "start_ms": 577160,
      "end_ms": 581020,
      "text": "一个错误的一个反动的统治模式下"
    },
    {
      "ordinal": 174,
      "start_ms": 581260,
      "end_ms": 584290,
      "text": "说不定大多数人是受益的"
    },
    {
      "ordinal": 175,
      "start_ms": 584290,
      "end_ms": 587920,
      "text": "但是只要有一小部分人受到的危害"
    },
    {
      "ordinal": 176,
      "start_ms": 587920,
      "end_ms": 592000,
      "text": "受绝对的是绝对的屈辱"
    },
    {
      "ordinal": 177,
      "start_ms": 592000,
      "end_ms": 594000,
      "text": "绝对的不可挽回的"
    },
    {
      "ordinal": 178,
      "start_ms": 595680,
      "end_ms": 599260,
      "text": "他手所遭遇的是绝对的非人的待遇"
    },
    {
      "ordinal": 179,
      "start_ms": 600520,
      "end_ms": 602460,
      "text": "他的未来是绝对没有希望的"
    },
    {
      "ordinal": 180,
      "start_ms": 602460,
      "end_ms": 604650,
      "text": "那么无论这么统治博士"
    },
    {
      "ordinal": 181,
      "start_ms": 604650,
      "end_ms": 608370,
      "text": "他让再多的人感受到某种好处"
    },
    {
      "ordinal": 182,
      "start_ms": 608370,
      "end_ms": 610930,
      "text": "感受到某种生存的幸福"
    },
    {
      "ordinal": 183,
      "start_ms": 610930,
      "end_ms": 612190,
      "text": "生活的幸福"
    },
    {
      "ordinal": 184,
      "start_ms": 612190,
      "end_ms": 613880,
      "text": "我们都要去反抗他"
    },
    {
      "ordinal": 185,
      "start_ms": 619980,
      "end_ms": 623750,
      "text": "无产阶级当中生存最困顿的"
    },
    {
      "ordinal": 186,
      "start_ms": 623750,
      "end_ms": 630270,
      "text": "并且在资本主义在不正义的统治模式下"
    },
    {
      "ordinal": 187,
      "start_ms": 630270,
      "end_ms": 637680,
      "text": "生产分配关系下受到极端压迫啊"
    },
    {
      "ordinal": 188,
      "start_ms": 637680,
      "end_ms": 639370,
      "text": "过度剥削啊"
    },
    {
      "ordinal": 189,
      "start_ms": 639370,
      "end_ms": 642450,
      "text": "甚至说任何剥削其实都在我眼中都是过度的"
    },
    {
      "ordinal": 190,
      "start_ms": 642450,
      "end_ms": 643590,
      "text": "在这种情况下"
    },
    {
      "ordinal": 191,
      "start_ms": 643590,
      "end_ms": 647280,
      "text": "无产阶级一定会迸发出他的绝对的反抗的意志"
    },
    {
      "ordinal": 192,
      "start_ms": 647280,
      "end_ms": 648660,
      "text": "这跟人数多少没有关系"
    },
    {
      "ordinal": 193,
      "start_ms": 648660,
      "end_ms": 650340,
      "text": "无产阶级的反抗意志一旦形成"
    },
    {
      "ordinal": 194,
      "start_ms": 650340,
      "end_ms": 652020,
      "text": "不会因为它是历史的少数"
    },
    {
      "ordinal": 195,
      "start_ms": 652020,
      "end_ms": 653120,
      "text": "他就不反抗"
    },
    {
      "ordinal": 196,
      "start_ms": 653720,
      "end_ms": 655720,
      "text": "他的反抗不是因为他人多人少"
    },
    {
      "ordinal": 197,
      "start_ms": 655720,
      "end_ms": 661219,
      "text": "而是因为他遭受的苦难和折磨的绝对性顽固性"
    },
    {
      "ordinal": 198,
      "start_ms": 663180,
      "end_ms": 664580,
      "text": "不可补偿性"
    },
    {
      "ordinal": 199,
      "start_ms": 665660,
      "end_ms": 667719,
      "text": "希望你们能想清楚这一点"
    },
    {
      "ordinal": 200,
      "start_ms": 668680,
      "end_ms": 672320,
      "text": "你们这些看了这个历史调研室写的这些东西的"
    },
    {
      "ordinal": 201,
      "start_ms": 672320,
      "end_ms": 672980,
      "text": "乱七八糟的"
    },
    {
      "ordinal": 202,
      "start_ms": 672980,
      "end_ms": 674870,
      "text": "这些小孩青年"
    },
    {
      "ordinal": 203,
      "start_ms": 674870,
      "end_ms": 676640,
      "text": "或者说有工作的人"
    },
    {
      "ordinal": 204,
      "start_ms": 676640,
      "end_ms": 679540,
      "text": "甚至我在怀疑有一部分是学生"
    },
    {
      "ordinal": 205,
      "start_ms": 679540,
      "end_ms": 683800,
      "text": "还有一部分甚至说是有这个事业内工作的人啊"
    },
    {
      "ordinal": 206,
      "start_ms": 683800,
      "end_ms": 684400,
      "text": "不是啊"
    },
    {
      "ordinal": 207,
      "start_ms": 684400,
      "end_ms": 685240,
      "text": "这个体制内工作"
    },
    {
      "ordinal": 208,
      "start_ms": 685240,
      "end_ms": 687780,
      "text": "你们这些人好好拷问"
    },
    {
      "ordinal": 209,
      "start_ms": 687780,
      "end_ms": 688770,
      "text": "拷问你自己"
    },
    {
      "ordinal": 210,
      "start_ms": 688770,
      "end_ms": 692920,
      "text": "如果让你回到191几年"
    },
    {
      "ordinal": 211,
      "start_ms": 692920,
      "end_ms": 696150,
      "text": "二几年三几年的这个芬兰"
    },
    {
      "ordinal": 212,
      "start_ms": 696150,
      "end_ms": 697860,
      "text": "你会站在哪一边"
    },
    {
      "ordinal": 213,
      "start_ms": 697860,
      "end_ms": 701220,
      "text": "你从军你会去哪一个部队里面从军"
    },
    {
      "ordinal": 214,
      "start_ms": 701220,
      "end_ms": 703359,
      "text": "你们自己好好想一想吧"
    },
    {
      "ordinal": 215,
      "start_ms": 703720,
      "end_ms": 705640,
      "text": "啊如果说就算是二战啊"
    },
    {
      "ordinal": 216,
      "start_ms": 705640,
      "end_ms": 706450,
      "text": "苏芬战争"
    },
    {
      "ordinal": 217,
      "start_ms": 706450,
      "end_ms": 710660,
      "text": "那我会作为芬兰的红色游击队的一员"
    },
    {
      "ordinal": 218,
      "start_ms": 710660,
      "end_ms": 714079,
      "text": "我会和苏联的布尔什维克站在一起"
    },
    {
      "ordinal": 219,
      "start_ms": 714320,
      "end_ms": 717200,
      "text": "一起反抗法西斯的芬兰"
    },
    {
      "ordinal": 220,
      "start_ms": 717200,
      "end_ms": 719380,
      "text": "一起反抗纳粹德国"
    },
    {
      "ordinal": 221,
      "start_ms": 720380,
      "end_ms": 722920,
      "text": "哪怕他打的名义是所谓的收复失地"
    },
    {
      "ordinal": 222,
      "start_ms": 722920,
      "end_ms": 725080,
      "text": "打一个民族主义的名义就是收复失地"
    },
    {
      "ordinal": 223,
      "start_ms": 725080,
      "end_ms": 725980,
      "text": "我作为无产阶级"
    },
    {
      "ordinal": 224,
      "start_ms": 725980,
      "end_ms": 730160,
      "text": "我不会被曼纳海姆的谎言所欺骗"
    },
    {
      "ordinal": 225,
      "start_ms": 731720,
      "end_ms": 736000,
      "text": "我清醒地意识到我的我真正的同胞"
    },
    {
      "ordinal": 226,
      "start_ms": 736280,
      "end_ms": 739520,
      "text": "不是那些和我操着同样语言的"
    },
    {
      "ordinal": 227,
      "start_ms": 739520,
      "end_ms": 741200,
      "text": "仅仅是因为和我操着同样语言"
    },
    {
      "ordinal": 228,
      "start_ms": 741200,
      "end_ms": 743540,
      "text": "但是完全是站在我的阶级立场对立面的"
    },
    {
      "ordinal": 229,
      "start_ms": 743540,
      "end_ms": 745599,
      "text": "那些白色的既得利益集团"
    },
    {
      "ordinal": 230,
      "start_ms": 745940,
      "end_ms": 747479,
      "text": "我真是同胞"
    },
    {
      "ordinal": 231,
      "start_ms": 747940,
      "end_ms": 751060,
      "text": "是和我一样穷苦出身"
    },
    {
      "ordinal": 232,
      "start_ms": 751060,
      "end_ms": 752590,
      "text": "在资本主义统治下"
    },
    {
      "ordinal": 233,
      "start_ms": 752590,
      "end_ms": 755719,
      "text": "一眼望不到任何希望的"
    },
    {
      "ordinal": 234,
      "start_ms": 756340,
      "end_ms": 757740,
      "text": "哪怕他是不同民族"
    },
    {
      "ordinal": 235,
      "start_ms": 757740,
      "end_ms": 758580,
      "text": "不同种族的"
    },
    {
      "ordinal": 236,
      "start_ms": 758580,
      "end_ms": 760060,
      "text": "哪怕他说不同的语言"
    },
    {
      "ordinal": 237,
      "start_ms": 760200,
      "end_ms": 763800,
      "text": "我们有同样的生存的绝对的一个困境"
    },
    {
      "ordinal": 238,
      "start_ms": 766450,
      "end_ms": 767530,
      "text": "才能拯救我们自己"
    },
    {
      "ordinal": 239,
      "start_ms": 767530,
      "end_ms": 770050,
      "text": "实现我们自己的人生未来的价值"
    },
    {
      "ordinal": 240,
      "start_ms": 770050,
      "end_ms": 771250,
      "text": "他才是我们的同胞"
    },
    {
      "ordinal": 241,
      "start_ms": 771250,
      "end_ms": 772699,
      "text": "他们才是我们的同胞"
    },
    {
      "ordinal": 242,
      "start_ms": 774380,
      "end_ms": 775660,
      "text": "再强调一遍"
    },
    {
      "ordinal": 243,
      "start_ms": 775660,
      "end_ms": 777479,
      "text": "无产阶级没有祖国"
    },
    {
      "ordinal": 244,
      "start_ms": 778680,
      "end_ms": 781370,
      "text": "苏联以一个所谓国家的形式存在"
    },
    {
      "ordinal": 245,
      "start_ms": 781370,
      "end_ms": 784079,
      "text": "只是说只是说"
    },
    {
      "ordinal": 246,
      "start_ms": 785720,
      "end_ms": 790300,
      "text": "只是说啊是后来的后面的发生的事情"
    },
    {
      "ordinal": 247,
      "start_ms": 790300,
      "end_ms": 794240,
      "text": "把这么一个历史上存在的政治实体定义为国家"
    },
    {
      "ordinal": 248,
      "start_ms": 795420,
      "end_ms": 798660,
      "text": "再强调一遍啊"
    },
    {
      "ordinal": 249,
      "start_ms": 798660,
      "end_ms": 799140,
      "text": "当然说了"
    },
    {
      "ordinal": 250,
      "start_ms": 799140,
      "end_ms": 802470,
      "text": "你全球的统治模式是以什么联合国人模式啊"
    },
    {
      "ordinal": 251,
      "start_ms": 802470,
      "end_ms": 808780,
      "text": "united nations nation这个词与其说是翻译成国家"
    },
    {
      "ordinal": 252,
      "start_ms": 808780,
      "end_ms": 810340,
      "text": "或者说它是不同的民族"
    },
    {
      "ordinal": 253,
      "start_ms": 810340,
      "end_ms": 812260,
      "text": "或者说不同的人类的"
    },
    {
      "ordinal": 254,
      "start_ms": 812260,
      "end_ms": 813410,
      "text": "出于文化"
    },
    {
      "ordinal": 255,
      "start_ms": 813410,
      "end_ms": 815780,
      "text": "宗教历史传统"
    },
    {
      "ordinal": 256,
      "start_ms": 815940,
      "end_ms": 817590,
      "text": "血缘关系"
    },
    {
      "ordinal": 257,
      "start_ms": 817590,
      "end_ms": 819180,
      "text": "还有这个聚居关系"
    },
    {
      "ordinal": 258,
      "start_ms": 819180,
      "end_ms": 820350,
      "text": "群众关系"
    },
    {
      "ordinal": 259,
      "start_ms": 820350,
      "end_ms": 823040,
      "text": "还有很重要的政治理念"
    },
    {
      "ordinal": 260,
      "start_ms": 823200,
      "end_ms": 825060,
      "text": "形成了大型共同体"
    },
    {
      "ordinal": 261,
      "start_ms": 825060,
