{
  "bvid": "BV1Le4y1M7yq",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "e18a9e8c95c0266ed76096124de379be051560b4f255d669131b9c766406a0ab",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 1820,
      "end_ms": 5060,
      "text": "这个也是应该是17年18年左右"
    },
    {
      "ordinal": 1,
      "start_ms": 5060,
      "end_ms": 5900,
      "text": "写的一首词啊"
    },
    {
      "ordinal": 2,
      "start_ms": 5900,
      "end_ms": 9260,
      "text": "我们来唱一下"
    },
    {
      "ordinal": 3,
      "start_ms": 31620,
      "end_ms": 35320,
      "text": "嘟嘟嘟"
    },
    {
      "ordinal": 4,
      "start_ms": 36620,
      "end_ms": 40300,
      "text": "站在微微的阳光里"
    },
    {
      "ordinal": 5,
      "start_ms": 40300,
      "end_ms": 43000,
      "text": "忽然下起了雨"
    },
    {
      "ordinal": 6,
      "start_ms": 43280,
      "end_ms": 49700,
      "text": "一朵容颜最动人的丁香花"
    },
    {
      "ordinal": 7,
      "start_ms": 50040,
      "end_ms": 53660,
      "text": "从那一处孤独泪水"
    },
    {
      "ordinal": 8,
      "start_ms": 53660,
      "end_ms": 55880,
      "text": "柔软的花蕾"
    },
    {
      "ordinal": 9,
      "start_ms": 55880,
      "end_ms": 62390,
      "text": "一阵阵一阵阵幽幽清香在飘送"
    },
    {
      "ordinal": 10,
      "start_ms": 62390,
      "end_ms": 70940,
      "text": "这就是这就是穿越了遥远时空归来的"
    },
    {
      "ordinal": 11,
      "start_ms": 70940,
      "end_ms": 72350,
      "text": "归来的"
    },
    {
      "ordinal": 12,
      "start_ms": 72350,
      "end_ms": 78240,
      "text": "再将你迎接的春天啊"
    },
    {
      "ordinal": 13,
      "start_ms": 78760,
      "end_ms": 82440,
      "text": "遥远的春天啊"
    },
    {
      "ordinal": 14,
      "start_ms": 82540,
      "end_ms": 88260,
      "text": "闭上眼温柔抚摸你脸颊"
    },
    {
      "ordinal": 15,
      "start_ms": 89200,
      "end_ms": 95760,
      "text": "哎呀你给我的爱啊"
    },
    {
      "ordinal": 16,
      "start_ms": 96260,
      "end_ms": 98740,
      "text": "怀念你的声音"
    },
    {
      "ordinal": 17,
      "start_ms": 98740,
      "end_ms": 101560,
      "text": "编织的童话"
    },
    {
      "ordinal": 18,
      "start_ms": 116780,
      "end_ms": 120340,
      "text": "全都寄托在你心里"
    },
    {
      "ordinal": 19,
      "start_ms": 120340,
      "end_ms": 127020,
      "text": "我的心儿知道今天你的消息"
    },
    {
      "ordinal": 20,
      "start_ms": 127020,
      "end_ms": 129960,
      "text": "我依然期待"
    },
    {
      "ordinal": 21,
      "start_ms": 129960,
      "end_ms": 135780,
      "text": "无论这无穷的岁月如何变化"
    },
    {
      "ordinal": 22,
      "start_ms": 135780,
      "end_ms": 142480,
      "text": "直到直到平凡生命的尽头"
    },
    {
      "ordinal": 23,
      "start_ms": 142480,
      "end_ms": 149050,
      "text": "这就是这就是穿越了每一个明天"
    },
    {
      "ordinal": 24,
      "start_ms": 149050,
      "end_ms": 155940,
      "text": "有一天有一天要降临在你我身边"
    },
    {
      "ordinal": 25,
      "start_ms": 155940,
      "end_ms": 157740,
      "text": "春天啊"
    },
    {
      "ordinal": 26,
      "start_ms": 158940,
      "end_ms": 161340,
      "text": "找不到春天啊"
    },
    {
      "ordinal": 27,
      "start_ms": 162780,
      "end_ms": 168240,
      "text": "茫然你失去方向的人啊"
    },
    {
      "ordinal": 28,
      "start_ms": 169140,
      "end_ms": 170480,
      "text": "梦境啊"
    },
    {
      "ordinal": 29,
      "start_ms": 172220,
      "end_ms": 175700,
      "text": "你编织这片梦"
    },
    {
      "ordinal": 30,
      "start_ms": 176260,
      "end_ms": 181500,
      "text": "带着温柔目光轻轻抱着我"
    },
    {
      "ordinal": 31,
      "start_ms": 182640,
      "end_ms": 189260,
      "text": "凤凰这浅浅的梦啊"
    },
    {
      "ordinal": 32,
      "start_ms": 189260,
      "end_ms": 191720,
      "text": "转眼他已消逝"
    },
    {
      "ordinal": 33,
      "start_ms": 191720,
      "end_ms": 194060,
      "text": "却把我留下"
    },
    {
      "ordinal": 34,
      "start_ms": 196100,
      "end_ms": 198280,
      "text": "死是你啊"
    },
    {
      "ordinal": 35,
      "start_ms": 198740,
      "end_ms": 202420,
      "text": "正思念着你啊"
    },
    {
      "ordinal": 36,
      "start_ms": 202920,
      "end_ms": 208160,
      "text": "一边走在你曾走过的路上"
    },
    {
      "ordinal": 37,
      "start_ms": 209640,
      "end_ms": 212060,
      "text": "如同雨滴滑落"
    },
    {
      "ordinal": 38,
      "start_ms": 212060,
      "end_ms": 215120,
      "text": "失去了轨迹"
    },
    {
      "ordinal": 39,
      "start_ms": 216320,
      "end_ms": 218800,
      "text": "如同春花飘零"
    },
    {
      "ordinal": 40,
      "start_ms": 218800,
      "end_ms": 221680,
      "text": "失去了踪迹"
    },
    {
      "ordinal": 41,
      "start_ms": 225160,
      "end_ms": 227740,
      "text": "春天啊"
    },
    {
      "ordinal": 42,
      "start_ms": 228880,
      "end_ms": 232060,
      "text": "遥远的春天啊"
    },
    {
      "ordinal": 43,
      "start_ms": 232460,
      "end_ms": 234120,
      "text": "闭上眼"
    },
    {
      "ordinal": 44,
      "start_ms": 234120,
      "end_ms": 237060,
      "text": "温柔抚摸着脸颊"
    },
    {
      "ordinal": 45,
      "start_ms": 239340,
      "end_ms": 245400,
      "text": "哎呀你给我的爱啊"
    },
    {
      "ordinal": 46,
      "start_ms": 246220,
      "end_ms": 248640,
      "text": "怀念你的生命"
    },
    {
      "ordinal": 47,
      "start_ms": 248640,
      "end_ms": 251280,
      "text": "编织的童话"
    },
    {
      "ordinal": 48,
      "start_ms": 252460,
      "end_ms": 259000,
      "text": "春天啊找不到春天啊"
    },
    {
      "ordinal": 49,
      "start_ms": 259040,
      "end_ms": 260680,
      "text": "茫然泪"
    },
    {
      "ordinal": 50,
      "start_ms": 260680,
      "end_ms": 264820,
      "text": "失去方向的人呀"
    },
    {
      "ordinal": 51,
      "start_ms": 265800,
      "end_ms": 268340,
      "text": "风景哈哈哈"
    },
    {
      "ordinal": 52,
      "start_ms": 268410,
      "end_ms": 272420,
      "text": "一边织这片梦"
    },
    {
      "ordinal": 53,
      "start_ms": 272920,
      "end_ms": 275340,
      "text": "带着温柔目光"
    },
    {
      "ordinal": 54,
      "start_ms": 275340,
      "end_ms": 278400,
      "text": "轻轻抱着"
    },
    {
      "ordinal": 55,
      "start_ms": 305320,
      "end_ms": 305920,
      "text": "好"
    },
    {
      "ordinal": 56,
      "start_ms": 309340,
      "end_ms": 310780,
      "text": "这边这句唱错了啊"
    },
    {
      "ordinal": 57,
      "start_ms": 310780,
      "end_ms": 312520,
      "text": "是你呀啊"
    },
    {
      "ordinal": 58,
      "start_ms": 312520,
      "end_ms": 313540,
      "text": "把那个思念"
    },
    {
      "ordinal": 59,
      "start_ms": 313540,
      "end_ms": 314500,
      "text": "我把他抢拍了啊"
    },
    {
      "ordinal": 60,
      "start_ms": 314500,
      "end_ms": 314860,
      "text": "不好意思"
    },
    {
      "ordinal": 61,
      "start_ms": 314860,
      "end_ms": 315640,
      "text": "抢到前面去啊"
    },
    {
      "ordinal": 62,
      "start_ms": 315640,
      "end_ms": 316260,
      "text": "不好意思"
    }
  ],
  "text": "这个也是应该是17年18年左右\n写的一首词啊\n我们来唱一下\n嘟嘟嘟\n站在微微的阳光里\n忽然下起了雨\n一朵容颜最动人的丁香花\n从那一处孤独泪水\n柔软的花蕾\n一阵阵一阵阵幽幽清香在飘送\n这就是这就是穿越了遥远时空归来的\n归来的\n再将你迎接的春天啊\n遥远的春天啊\n闭上眼温柔抚摸你脸颊\n哎呀你给我的爱啊\n怀念你的声音\n编织的童话\n全都寄托在你心里\n我的心儿知道今天你的消息\n我依然期待\n无论这无穷的岁月如何变化\n直到直到平凡生命的尽头\n这就是这就是穿越了每一个明天\n有一天有一天要降临在你我身边\n春天啊\n找不到春天啊\n茫然你失去方向的人啊\n梦境啊\n你编织这片梦\n带着温柔目光轻轻抱着我\n凤凰这浅浅的梦啊\n转眼他已消逝\n却把我留下\n死是你啊\n正思念着你啊\n一边走在你曾走过的路上\n如同雨滴滑落\n失去了轨迹\n如同春花飘零\n失去了踪迹\n春天啊\n遥远的春天啊\n闭上眼\n温柔抚摸着脸颊\n哎呀你给我的爱啊\n怀念你的生命\n编织的童话\n春天啊找不到春天啊\n茫然泪\n失去方向的人呀\n风景哈哈哈\n一边织这片梦\n带着温柔目光\n轻轻抱着\n好\n这边这句唱错了啊\n是你呀啊\n把那个思念\n我把他抢拍了啊\n不好意思\n抢到前面去啊\n不好意思",
