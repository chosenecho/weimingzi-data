{"segments":[{"start":1.82,"end":5.06,"text":"这个也是应该是17年18年左右"},{"start":5.06,"end":5.9,"text":"写的一首词啊"},{"start":5.9,"end":9.26,"text":"我们来唱一下"},{"start":31.62,"end":35.32,"text":"嘟嘟嘟"},{"start":36.62,"end":40.3,"text":"站在微微的阳光里"},{"start":40.3,"end":43.0,"text":"忽然下起了雨"},{"start":43.28,"end":49.7,"text":"一朵容颜最动人的丁香花"},{"start":50.04,"end":53.66,"text":"从那一处孤独泪水"},{"start":53.66,"end":55.88,"text":"柔软的花蕾"},{"start":55.88,"end":62.39,"text":"一阵阵一阵阵幽幽清香在飘送"},{"start":62.39,"end":70.94,"text":"这就是这就是穿越了遥远时空归来的"},{"start":70.94,"end":72.35,"text":"归来的"},{"start":72.35,"end":78.24,"text":"再将你迎接的春天啊"},{"start":78.76,"end":82.44,"text":"遥远的春天啊"},{"start":82.54,"end":88.26,"text":"闭上眼温柔抚摸你脸颊"},{"start":89.2,"end":95.76,"text":"哎呀你给我的爱啊"},{"start":96.26,"end":98.74,"text":"怀念你的声音"},{"start":98.74,"end":101.56,"text":"编织的童话"},{"start":116.78,"end":120.34,"text":"全都寄托在你心里"},{"start":120.34,"end":127.02,"text":"我的心儿知道今天你的消息"},{"start":127.02,"end":129.96,"text":"我依然期待"},{"start":129.96,"end":135.78,"text":"无论这无穷的岁月如何变化"},{"start":135.78,"end":142.48,"text":"直到直到平凡生命的尽头"},{"start":142.48,"end":149.05,"text":"这就是这就是穿越了每一个明天"},{"start":149.05,"end":155.94,"text":"有一天有一天要降临在你我身边"},{"start":155.94,"end":157.74,"text":"春天啊"},{"start":158.94,"end":161.34,"text":"找不到春天啊"},{"start":162.78,"end":168.24,"text":"茫然你失去方向的人啊"},{"start":169.14,"end":170.48,"text":"梦境啊"},{"start":172.22,"end":175.7,"text":"你编织这片梦"},{"start":176.26,"end":181.5,"text":"带着温柔目光轻轻抱着我"},{"start":182.64,"end":189.26,"text":"凤凰这浅浅的梦啊"},{"start":189.26,"end":191.72,"text":"转眼他已消逝"},{"start":191.72,"end":194.06,"text":"却把我留下"},{"start":196.1,"end":198.28,"text":"死是你啊"},{"start":198.74,"end":202.42,"text":"正思念着你啊"},{"start":202.92,"end":208.16,"text":"一边走在你曾走过的路上"},{"start":209.64,"end":212.06,"text":"如同雨滴滑落"},{"start":212.06,"end":215.12,"text":"失去了轨迹"},{"start":216.32,"end":218.8,"text":"如同春花飘零"},{"start":218.8,"end":221.68,"text":"失去了踪迹"},{"start":225.16,"end":227.74,"text":"春天啊"},{"start":228.88,"end":232.06,"text":"遥远的春天啊"},{"start":232.46,"end":234.12,"text":"闭上眼"},{"start":234.12,"end":237.06,"text":"温柔抚摸着脸颊"},{"start":239.34,"end":245.4,"text":"哎呀你给我的爱啊"},{"start":246.22,"end":248.64,"text":"怀念你的生命"},{"start":248.64,"end":251.28,"text":"编织的童话"},{"start":252.46,"end":259.0,"text":"春天啊找不到春天啊"},{"start":259.04,"end":260.68,"text":"茫然泪"},{"start":260.68,"end":264.82,"text":"失去方向的人呀"},{"start":265.8,"end":268.34,"text":"风景哈哈哈"},{"start":268.41,"end":272.42,"text":"一边织这片梦"},{"start":272.92,"end":275.34,"text":"带着温柔目光"},{"start":275.34,"end":278.4,"text":"轻轻抱着"},{"start":305.32,"end":305.92,"text":"好"},{"start":309.34,"end":310.78,"text":"这边这句唱错了啊"},{"start":310.78,"end":312.52,"text":"是你呀啊"},{"start":312.52,"end":313.54,"text":"把那个思念"},{"start":313.54,"end":314.5,"text":"我把他抢拍了啊"},{"start":314.5,"end":314.86,"text":"不好意思"},{"start":314.86,"end":315.64,"text":"抢到前面去啊"},{"start":315.64,"end":316.26,"text":"不好意思"}],"source":"subtitle"}
