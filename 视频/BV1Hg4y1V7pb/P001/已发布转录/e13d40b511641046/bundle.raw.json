tart":333.71,"end":336.95,"text":"和这个做家教的这两件事的一个立场啊"},{"start":336.95,"end":338.15,"text":"一个一个立场"},{"start":338.15,"end":341.75,"text":"那么我们现在就是说我不失望啊"},{"start":341.75,"end":342.89,"text":"有一件事情发生了"},{"start":342.89,"end":344.75,"text":"我对这个事情并不吃惊"},{"start":344.75,"end":345.909,"text":"也不感到失望"},{"start":345.909,"end":349.629,"text":"就是说有之前被我批评了某个团体啊"},{"start":349.629,"end":352.36,"text":"一个匿名的小角色"},{"start":354.12,"end":356.0,"text":"啊搞这个知识付费啊"},{"start":356.0,"end":361.5,"text":"很明显我从来不认为这个啊他的老板"},{"start":361.56,"end":366.24,"text":"他在这个上面的头头都知道他姓甚名谁啊"},{"start":366.24,"end":367.92,"text":"搞什么研究的啊"},{"start":367.92,"end":369.24,"text":"家里住哪里的"},{"start":369.479,"end":374.309,"text":"他绝对不是一个呃所谓的地下的隐秘的活动家"},{"start":374.309,"end":376.079,"text":"他弄这些钱是为了什么"},{"start":376.079,"end":377.879,"text":"无非就是他个人消费吧"},{"start":377.879,"end":379.38,"text":"或者说瓦雷啊"},{"start":379.38,"end":381.78,"text":"当然它也是合法经营啊"},{"start":381.78,"end":383.72,"text":"合法的一个一个一个一"},{"start":383.72,"end":386.36,"text":"所以说在这个上下这个个体呢"},{"start":386.36,"end":387.02,"text":"在我们眼里"},{"start":387.02,"end":391.6,"text":"它只是一个小段阶级的一个文化产品的生产者"},{"start":391.74,"end":392.94,"text":"仅此而已"},{"start":392.94,"end":394.86,"text":"我没有降低它的负面评啊"},{"start":394.86,"end":396.299,"text":"没有降低他的社会评价"},{"start":396.299,"end":397.289,"text":"仅此而已"},{"start":397.289,"end":398.459,"text":"不要把他幻想成他"},{"start":398.459,"end":402.419,"text":"好像说啊他弄的这些钱要要去什么啊"},{"start":402.419,"end":403.139,"text":"资助革命"},{"start":403.139,"end":404.78,"text":"怎么可能他没有"},{"start":405.8,"end":407.5,"text":"就是个小小文人"},{"start":407.5,"end":409.15,"text":"或者说是个知识分子"},{"start":409.15,"end":413.22,"text":"小知识分子啊啊这个就在眼皮子底下"},{"start":413.28,"end":415.02,"text":"一点独立性都没有的"},{"start":415.02,"end":417.54,"text":"一点活动的空间都没有的啊"},{"start":417.54,"end":420.32,"text":"这么一个小年轻啊啊"},{"start":420.32,"end":423.92,"text":"他周围还有几个什么什么什么静静啊"},{"start":423.92,"end":425.3,"text":"还有他的几个几个同学"},{"start":425.3,"end":425.9,"text":"几个朋友"},{"start":425.9,"end":428.709,"t