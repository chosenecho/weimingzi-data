  "segments": [
    {
      "ordinal": 0,
      "start_ms": 7180,
      "end_ms": 9640,
      "text": "看来今日是你"
    },
    {
      "ordinal": 1,
      "start_ms": 9640,
      "end_ms": 11560,
      "text": "我分哪去"
    },
    {
      "ordinal": 2,
      "start_ms": 16359,
      "end_ms": 17480,
      "text": "呀"
    },
    {
      "ordinal": 3,
      "start_ms": 45620,
      "end_ms": 47740,
      "text": "往事不要再提"
    },
    {
      "ordinal": 4,
      "start_ms": 49480,
      "end_ms": 51820,
      "text": "人生已多风雨"
    },
    {
      "ordinal": 5,
      "start_ms": 53460,
      "end_ms": 54920,
      "text": "纵然寂寞"
    },
    {
      "ordinal": 6,
      "start_ms": 54920,
      "end_ms": 59500,
      "text": "不去爱与恨都还在心里"
    },
    {
      "ordinal": 7,
      "start_ms": 60380,
      "end_ms": 62740,
      "text": "真的要断了过去"
    },
    {
      "ordinal": 8,
      "start_ms": 64060,
      "end_ms": 66820,
      "text": "让明天好好继续"
    },
    {
      "ordinal": 9,
      "start_ms": 68480,
      "end_ms": 74380,
      "text": "你就不要再苦苦追问我的消息"
    },
    {
      "ordinal": 10,
      "start_ms": 75300,
      "end_ms": 78800,
      "text": "爱情它是个难题"
    },
    {
      "ordinal": 11,
      "start_ms": 79200,
      "end_ms": 82140,
      "text": "让人目眩神迷"
    },
    {
      "ordinal": 12,
      "start_ms": 83480,
      "end_ms": 85600,
      "text": "忘了痛或许可以"
    },
    {
      "ordinal": 13,
      "start_ms": 85600,
      "end_ms": 86320,
      "text": "忘了你"
    },
    {
      "ordinal": 14,
      "start_ms": 86320,
      "end_ms": 89360,
      "text": "却太不容易"
    },
    {
      "ordinal": 15,
      "start_ms": 90280,
      "end_ms": 92640,
      "text": "你不曾真的离去"
    },
    {
      "ordinal": 16,
      "start_ms": 94200,
      "end_ms": 96720,
      "text": "你始终在我心里"
    },
    {
      "ordinal": 17,
      "start_ms": 98360,
      "end_ms": 100600,
      "text": "我对你仍有爱意"
    },
    {
      "ordinal": 18,
      "start_ms": 100600,
      "end_ms": 103840,
      "text": "我对自己无能为力"
    },
    {
      "ordinal": 19,
      "start_ms": 105060,
      "end_ms": 108470,
      "text": "因为我仍有梦"
    },
    {
      "ordinal": 20,
      "start_ms": 108470,
      "end_ms": 112480,
      "text": "依然将你放在我心中"
    },
    {
      "ordinal": 21,
      "start_ms": 112760,
      "end_ms": 116380,
      "text": "总是容易被往事打动"
    },
    {
      "ordinal": 22,
      "start_ms": 116520,
      "end_ms": 119790,
      "text": "总是为了你心痛"
    },
    {
      "ordinal": 23,
      "start_ms": 119790,
      "end_ms": 123440,
      "text": "别留恋岁月中"
    },
    {
      "ordinal": 24,
      "start_ms": 123620,
      "end_ms": 127460,
      "text": "我无意的柔情万种"
    },
    {
      "ordinal": 25,
      "start_ms": 127820,
      "end_ms": 131510,
      "text": "不要问我是否再相逢"
    },
    {
      "ordinal": 26,
      "start_ms": 131510,
      "end_ms": 134810,
      "text": "不要问我是否言不由衷"
    },
    {
      "ordinal": 27,
      "start_ms": 134810,
      "end_ms": 137959,
      "text": "为何你不懂"
    },
    {
      "ordinal": 28,
      "start_ms": 139339,
      "end_ms": 142080,
      "text": "只要有爱就有痛"
    },
    {
      "ordinal": 29,
      "start_ms": 143279,
      "end_ms": 145519,
      "text": "有一天你会知道"
    },
    {
      "ordinal": 30,
      "start_ms": 146599,
      "end_ms": 147799,
      "text": "人生没有"
    },
    {
      "ordinal": 31,
      "start_ms": 147799,
      "end_ms": 150250,
      "text": "我并不会不同"
    },
    {
      "ordinal": 32,
      "start_ms": 150250,
      "end_ms": 153769,
      "text": "人生已经太匆匆"
    },
    {
      "ordinal": 33,
      "start_ms": 153769,
      "end_ms": 155329,
      "text": "我好害怕"
    },
    {
      "ordinal": 34,
      "start_ms": 155329,
      "end_ms": 157780,
      "text": "总是泪眼朦胧"
    },
    {
      "ordinal": 35,
      "start_ms": 158160,
      "end_ms": 160470,
      "text": "忘了我就没有痛"
    },
    {
      "ordinal": 36,
      "start_ms": 160470,
      "end_ms": 163740,
      "text": "将往事留在风中"
    },
    {
