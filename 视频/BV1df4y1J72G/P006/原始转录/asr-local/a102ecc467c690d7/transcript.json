  "segments": [
    {
      "ordinal": 0,
      "start_ms": 45920,
      "end_ms": 48080,
      "text": "往事不要再提，"
    },
    {
      "ordinal": 1,
      "start_ms": 49520,
      "end_ms": 51440,
      "text": "人生已多风雨。"
    },
    {
      "ordinal": 2,
      "start_ms": 53680,
      "end_ms": 58560,
      "text": "纵然记忆抹不去，爱与恨都还在心里。"
    },
    {
      "ordinal": 3,
      "start_ms": 60640,
      "end_ms": 62720,
      "text": "真的要断了过去，"
    },
    {
      "ordinal": 4,
      "start_ms": 64160,
      "end_ms": 66240,
      "text": "让明天好好继续。"
    },
    {
      "ordinal": 5,
      "start_ms": 68720,
      "end_ms": 72800,
      "text": "你就不要再苦苦追问我的消息。"
    },
    {
      "ordinal": 6,
      "start_ms": 75600,
      "end_ms": 78160,
      "text": "爱情那是个难题，"
    },
    {
      "ordinal": 7,
      "start_ms": 79440,
      "end_ms": 81360,
      "text": "让人目眩神迷。"
    },
    {
      "ordinal": 8,
      "start_ms": 83760,
      "end_ms": 88720,
      "text": "忘了痛或许可以，忘了你却太不容易。"
    },
    {
      "ordinal": 9,
      "start_ms": 90560,
      "end_ms": 92400,
      "text": "你不曾真的离去，"
    },
    {
      "ordinal": 10,
      "start_ms": 94240,
      "end_ms": 96320,
      "text": "你始终在我心里。"
    },
    {
      "ordinal": 11,
      "start_ms": 98640,
      "end_ms": 103120,
      "text": "我对你仍有爱意，我对自己无能为力。"
    },
    {
      "ordinal": 12,
      "start_ms": 105360,
      "end_ms": 112480,
      "text": "因为我仍有梦，依然将你放在我心中。"
    },
    {
      "ordinal": 13,
      "start_ms": 113120,
      "end_ms": 119360,
      "text": "总是容易被往事打动，总是为了你心痛。"
    },
    {
      "ordinal": 14,
      "start_ms": 120160,
      "end_ms": 122880,
      "text": "别留恋岁月中"
    },
    {
      "ordinal": 15,
      "start_ms": 124000,
      "end_ms": 127600,
      "text": "我无意的柔情万种。"
    },
    {
      "ordinal": 16,
      "start_ms": 128160,
      "end_ms": 138080,
      "text": "不要问我是否再相逢，不要问我是否言不由衷。为何你不懂？"
    },
    {
      "ordinal": 17,
      "start_ms": 139360,
      "end_ms": 142240,
      "text": "只要有爱就有痛。"
    },
    {
      "ordinal": 18,
      "start_ms": 143520,
      "end_ms": 150160,
      "text": "有一天你会知道，人生没有我并不会不同。"
    },
    {
      "ordinal": 19,
      "start_ms": 150560,
      "end_ms": 152880,
      "text": "人生已经太匆匆，"
    },
    {
      "ordinal": 20,
      "start_ms": 154160,
      "end_ms": 157680,
      "text": "我好害怕总是泪眼朦胧。"
    },
    {
      "ordinal": 21,
      "start_ms": 158480,
      "end_ms": 164400,
      "text": "忘了我就没有痛，将往事留在风中。"
    },
    {
      "ordinal": 22,
      "start_ms": 195432,
      "end_ms": 197832,
      "text": "因为我仍有梦，"
    },
    {
      "ordinal": 23,
      "start_ms": 198872,
      "end_ms": 202312,
      "text": "依然将你放在我心中。"
    },
    {
      "ordinal": 24,
      "start_ms": 202952,
      "end_ms": 209352,
      "text": "总是容易被往事打动，总是为了你心痛。"
    },
    {
