{
  "bvid": "BV1df4y1J72G",
  "page": 5,
  "source": "asr-local",
  "language": "Chinese",
  "model": {
    "model_name": "source://production/models/Qwen3-ASR-1.7B-hf",
    "revision": "bcd2b5b7f32b480ab5790554cfa8347f246a14f3"
  },
  "content_sha256": "b595a304ccd2b164e6fbf88fee1503100b45e025c26aa9ac0d147c242ce76a50",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 17920,
      "end_ms": 23360,
      "text": "徐徐回望，尽属于彼此的晚上。"
    },
    {
      "ordinal": 1,
      "start_ms": 25280,
      "end_ms": 30400,
      "text": "红红人是你，赠我的心中一样。"
    },
    {
      "ordinal": 2,
      "start_ms": 32320,
      "end_ms": 38160,
      "text": "如流傻泪，期望可体恤兼见谅。"
    },
    {
      "ordinal": 3,
      "start_ms": 38880,
      "end_ms": 44720,
      "text": "明晨离别你，留也喺孤单的晚上。"
    },
    {
      "ordinal": 4,
      "start_ms": 46480,
      "end_ms": 49040,
      "text": "一瞬间，太多东西要讲，"
    },
    {
      "ordinal": 5,
      "start_ms": 50080,
      "end_ms": 52880,
      "text": "可惜即将在各一方。"
    },
    {
      "ordinal": 6,
      "start_ms": 53120,
      "end_ms": 58800,
      "text": "只好深深把这刻，尽凝望。"
    },
    {
      "ordinal": 7,
      "start_ms": 59840,
      "end_ms": 65120,
      "text": "来日纵是清清曲歌，飘远翻我楼上。"
    },
    {
      "ordinal": 8,
      "start_ms": 65120,
      "end_ms": 74000,
      "text": "来日纵是千千晚星，能过今晚月亮。"
    },
    {
      "ordinal": 9,
      "start_ms": 74000,
      "end_ms": 80480,
      "text": "逗比吧，喺只小美丽，亦绝不可使我更欣赏。"
    },
    {
      "ordinal": 10,
      "start_ms": 81040,
      "end_ms": 88000,
      "text": "啊，因你今晚共我唱。啊！"
    },
    {
      "ordinal": 11,
      "start_ms": 89200,
      "end_ms": 104960,
      "text": "哎他妈折了，我靠。"
    },
    {
      "ordinal": 12,
      "start_ms": 105120,
      "end_ms": 109680,
      "text": "他妈的非要咋呼咋呼这一句。啊！"
    },
    {
      "ordinal": 13,
      "start_ms": 110960,
      "end_ms": 114960,
      "text": "这演唱会版本一定要他妈咋呼咋呼这句啊！我也不知道为什么。"
    },
    {
      "ordinal": 14,
      "start_ms": 114960,
      "end_ms": 128640,
      "text": "临行临别，才顿感哀伤的漂亮。"
    },
    {
      "ordinal": 15,
      "start_ms": 128880,
      "end_ms": 130160,
      "text": "原来全是你，令我的思念漫长。"
    },
    {
      "ordinal": 16,
      "start_ms": 133600,
      "end_ms": 140640,
      "text": "何年何月，才又可今宵一样？"
    },
    {
      "ordinal": 17,
      "start_ms": 142480,
      "end_ms": 147760,
      "text": "停留凝望里，人眼睛讲彼此落象。"
    },
    {
      "ordinal": 18,
      "start_ms": 149600,
      "end_ms": 160160,
      "text": "当某天雨点轻敲你窗，当风声吹乱你旧想，可否抽空想这章，够没人。"
    },
    {
      "ordinal": 19,
      "start_ms": 160160,
      "end_ms": 168160,
      "text": "来日纵是清清曲歌，飘远翻我楼上。"
    },
    {
      "ordinal": 20,
      "start_ms": 168160,
      "end_ms": 175560,
      "text": "来日纵是千千晚星，能过今晚月亮。"
    },
    {
      "ordinal": 21,
      "start_ms": 175620,
      "end_ms": 180240,
      "text": "逗比吧，喺只小美丽。"
    },
    {
      "ordinal": 22,
      "start_ms": 181168,
      "end_ms": 188848,
      "text": "亦绝不可思，我更欣赏啊，因你今晚共我唱。"
    },
    {
      "ordinal": 23,
      "start_ms": 188848,
      "end_ms": 208128,
      "text": "啊，枕头被抛弃，这烧"
    },
    {
      "ordinal": 24,
      "start_ms": 209568,
      "end_ms": 217248,
      "text": "米梨，亦绝不可思，我更欣赏，因今宵的我可共你唱。"
    },
    {
      "ordinal": 25,
      "start_ms": 217248,
      "end_ms": 225088,
      "text": "来日纵是千千阙歌，飘远飞我楼上。"
    },
    {
      "ordinal": 26,
      "start_ms": 225088,
      "end_ms": 233968,
      "text": "来日纵是千千晚星，亮过今晚月亮。"
    },
    {
      "ordinal": 27,
      "start_ms": 234448,
      "end_ms": 244928,
      "text": "斗比吧，起这烧米梨，亦绝不可思，我更欣赏啊，因我今晚共你唱。"
    },
    {
      "ordinal": 28,
      "start_ms": 244928,
      "end_ms": 253488,
      "text": "来日纵是千千阙歌，飘远飞我楼上。"
    },
    {
      "ordinal": 29,
      "start_ms": 253488,
      "end_ms": 260498,
      "text": "来日纵是千千晚星，亮过今晚月亮。"
    },
    {
      "ordinal": 30,
      "start_ms": 260542,
      "end_ms": 265548,
      "text": "斗比吧，起这烧米梨，斗射不清今晚我"
    },
    {
      "ordinal": 31,
      "start_ms": 266728,
      "end_ms": 274208,
      "text": "所想，因不知哪天再共你唱。"
    },
    {
      "ordinal": 32,
      "start_ms": 274208,
      "end_ms": 281968,
      "text": "啊，中间那个是往上唱的啊，我们唱到中间去了，不好意思"
    },
    {
      "ordinal": 33,
      "start_ms": 283008,
      "end_ms": 288848,
      "text": "啊，啊失误啊，小失误，说明我张国荣的演唱会版本听的不够多啊。"
    },
    {
      "ordinal": 34,
      "start_ms": 291008,
      "end_ms": 296208,
      "text": "哦，我平时听都听陈淑桦版啊，不是陈慧娴版本的，然后我基本上听不完我就切割了。"
    }
  ],
