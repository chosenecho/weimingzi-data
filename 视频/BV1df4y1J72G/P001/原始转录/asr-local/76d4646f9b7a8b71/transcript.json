  "content_sha256": "76d4646f9b7a8b712012e9200f9871e3ebabdd500f4d9cde8a6ef0bb80542004",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 26080,
      "end_ms": 33520,
      "text": "抬头望星空一片静，我独行夜雨渐甜。"
    },
    {
      "ordinal": 1,
      "start_ms": 36240,
      "end_ms": 42970,
      "text": "茫然是此刻的冷战，笑问谁简单照然。"
    },
    {
      "ordinal": 2,
      "start_ms": 43270,
      "end_ms": 61440,
      "text": "风加风也清，旧知变还是某点，未明是我苦笑给每天，不善眠，只算双手去抚平。"
    },
    {
      "ordinal": 3,
      "start_ms": 61440,
      "end_ms": 97440,
      "text": "矛盾是无力去暂停，可未知我心里困倦满腔，夜难眠，问有谁共鸣？"
    },
    {
      "ordinal": 4,
      "start_ms": 97440,
      "end_ms": 100320,
      "text": "从前是听针不冷静，爱"
    },
    {
      "ordinal": 5,
      "start_ms": 101840,
      "end_ms": 104880,
      "text": "自由或会茫然。"
    },
    {
      "ordinal": 6,
      "start_ms": 104880,
      "end_ms": 110000,
      "text": "明白是得失总有定，去"
    },
    {
      "ordinal": 7,
      "start_ms": 111760,
      "end_ms": 116000,
      "text": "或留轻松对言。"
    },
    {
      "ordinal": 8,
      "start_ms": 117600,
      "end_ms": 121760,
      "text": "孤单中颤抖，可知我实在难受。"
    },
    {
      "ordinal": 9,
      "start_ms": 121920,
      "end_ms": 125360,
      "text": "问谁愿一失去了"
    },
    {
      "ordinal": 10,
      "start_ms": 126960,
      "end_ms": 131920,
      "text": "自由，想退后，心里只装我拥有。"
    },
    {
      "ordinal": 11,
      "start_ms": 132720,
      "end_ms": 135440,
      "text": "前去亦全力去寻求，"
    },
    {
      "ordinal": 12,
      "start_ms": 137360,
      "end_ms": 141813,
      "text": "风也清，晚空中我问句声，夜难眠，问有谁共鸣？"
    },
    {
      "ordinal": 13,
      "start_ms": 142026,
      "end_ms": 143805,
      "text": "孤单中颤抖，可知我实在难受。"
    },
    {
      "ordinal": 14,
      "start_ms": 143977,
      "end_ms": 146320,
      "text": "问谁愿一失去了自由，想退后。"
    },
    {
      "ordinal": 15,
      "start_ms": 180236,
      "end_ms": 182556,
      "text": "心礼知足，我拥有"
    },
    {
      "ordinal": 16,
      "start_ms": 183756,
      "end_ms": 187436,
      "text": "情去亦全离开，身后。"
    },
    {
      "ordinal": 17,
      "start_ms": 188316,
      "end_ms": 197996,
      "text": "风也清，晚空中我问句仙，夜阑前问有谁共眠。"
    },
    {
      "ordinal": 18,
      "start_ms": 198556,
      "end_ms": 208556,
      "text": "风也清，晚空中我问句仙，夜阑前问有谁共眠。"
    }
  ],
