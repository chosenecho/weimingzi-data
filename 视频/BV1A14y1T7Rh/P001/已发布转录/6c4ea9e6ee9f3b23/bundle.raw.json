{"segments":[{"start":0.24,"end":2.239,"text":"这个也是之前写的一首啊"},{"start":5.32,"end":8.56,"text":"啊"},{"start":26.52,"end":32.0,"text":"玉兰清玉石"},{"start":33.48,"end":39.08,"text":"风吹散两只"},{"start":40.64,"end":46.0,"text":"抹去谁人知"},{"start":47.6,"end":53.14,"text":"同是一半痴"},{"start":53.48,"end":59.24,"text":"在晚风轻风流的湖边"},{"start":62.0,"end":67.12,"text":"飘幽灵有几片"},{"start":67.52,"end":74.74,"text":"更无须似凉风的语言"},{"start":76.0,"end":81.3,"text":"不觉在耳边"},{"start":87.24,"end":91.98,"text":"绿蓝青玉石"},{"start":93.48,"end":99.02,"text":"风吹散两只"},{"start":100.7,"end":106.12,"text":"千万谁人知"},{"start":107.86,"end":112.56,"text":"秋去春来迟"},{"start":113.44,"end":117.56,"text":"在命理难远"},{"start":117.56,"end":119.48,"text":"去吃人间"},{"start":122.24,"end":132.86,"text":"飘林有几天到也叫无情多情"},{"start":132.86,"end":135.02,"text":"人间"},{"start":136.02,"end":141.48,"text":"不必非遮掩"},{"start":143.2,"end":146.12,"text":"越南情"},{"start":146.12,"end":147.02,"text":"于是"},{"start":150.14,"end":154.06,"text":"风吹散两只"},{"start":156.52,"end":163.4,"text":"是轻轻难以感胜过乔峰"},{"start":164.14,"end":169.04,"text":"不留40年依"},{"start":171.32,"end":176.72,"text":"照进黄河"},{"start":185.48,"end":190.48,"text":"扎破尽黄昏"}],"source":"subtitle"}
