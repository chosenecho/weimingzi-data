  "segments": [
    {
      "ordinal": 0,
      "start_ms": 240,
      "end_ms": 2239,
      "text": "这个也是之前写的一首啊"
    },
    {
      "ordinal": 1,
      "start_ms": 5320,
      "end_ms": 8560,
      "text": "啊"
    },
    {
      "ordinal": 2,
      "start_ms": 26520,
      "end_ms": 32000,
      "text": "玉兰清玉石"
    },
    {
      "ordinal": 3,
      "start_ms": 33480,
      "end_ms": 39080,
      "text": "风吹散两只"
    },
    {
      "ordinal": 4,
      "start_ms": 40640,
      "end_ms": 46000,
      "text": "抹去谁人知"
    },
    {
      "ordinal": 5,
      "start_ms": 47600,
      "end_ms": 53140,
      "text": "同是一半痴"
    },
    {
      "ordinal": 6,
      "start_ms": 53480,
      "end_ms": 59240,
      "text": "在晚风轻风流的湖边"
    },
    {
      "ordinal": 7,
      "start_ms": 62000,
      "end_ms": 67120,
      "text": "飘幽灵有几片"
    },
    {
      "ordinal": 8,
      "start_ms": 67520,
      "end_ms": 74740,
      "text": "更无须似凉风的语言"
    },
    {
      "ordinal": 9,
      "start_ms": 76000,
      "end_ms": 81300,
      "text": "不觉在耳边"
    },
    {
      "ordinal": 10,
      "start_ms": 87240,
      "end_ms": 91980,
      "text": "绿蓝青玉石"
    },
    {
      "ordinal": 11,
      "start_ms": 93480,
      "end_ms": 99020,
      "text": "风吹散两只"
    },
    {
      "ordinal": 12,
      "start_ms": 100700,
      "end_ms": 106120,
      "text": "千万谁人知"
    },
    {
      "ordinal": 13,
      "start_ms": 107860,
      "end_ms": 112560,
      "text": "秋去春来迟"
    },
    {
      "ordinal": 14,
      "start_ms": 113440,
      "end_ms": 117560,
      "text": "在命理难远"
    },
    {
      "ordinal": 15,
      "start_ms": 117560,
      "end_ms": 119480,
      "text": "去吃人间"
    },
    {
      "ordinal": 16,
      "start_ms": 122240,
      "end_ms": 132860,
      "text": "飘林有几天到也叫无情多情"
    },
    {
      "ordinal": 17,
      "start_ms": 132860,
      "end_ms": 135020,
      "text": "人间"
    },
    {
      "ordinal": 18,
      "start_ms": 136020,
      "end_ms": 141480,
      "text": "不必非遮掩"
    },
    {
      "ordinal": 19,
      "start_ms": 143200,
      "end_ms": 146120,
      "text": "越南情"
    },
    {
      "ordinal": 20,
      "start_ms": 146120,
      "end_ms": 147020,
      "text": "于是"
    },
    {
      "ordinal": 21,
      "start_ms": 150140,
      "end_ms": 154060,
      "text": "风吹散两只"
    },
    {
      "ordinal": 22,
      "start_ms": 156520,
      "end_ms": 163400,
      "text": "是轻轻难以感胜过乔峰"
    },
    {
      "ordinal": 23,
      "start_ms": 164140,
      "end_ms": 169040,
      "text": "不留40年依"
    },
    {
      "ordinal": 24,
      "start_ms": 171320,
      "end_ms": 176720,
      "text": "照进黄河"
    },
    {
      "ordinal": 25,
      "start_ms": 185480,
      "end_ms": 190480,
      "text": "扎破尽黄昏"
    }
  ],
  "text": "这个也是之前写的一首啊\n啊\n玉兰清玉石\n风吹散两只\n抹去谁人知\n同是一半痴\n在晚风轻风流的湖边\n飘幽灵有几片\n更无须似凉风的语言\n不觉在耳边\n绿蓝青玉石\n风吹散两只\n千万谁人知\n秋去春来迟\n在命理难远\n去吃人间\n飘林有几天到也叫无情多情\n人间\n不必非遮掩\n越南情\n于是\n风吹散两只\n是轻轻难以感胜过乔峰\n不留40年依\n照进黄河\n扎破尽黄昏",
  "timing_issue": null
}
