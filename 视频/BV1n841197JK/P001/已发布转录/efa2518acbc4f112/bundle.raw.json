{"segments":[{"start":0.5,"end":3.38,"text":"呃我们目前的最大的敌人"},{"start":3.38,"end":7.439,"text":"我明确一点告诉你们是分离主义"},{"start":8.299,"end":11.28,"text":"分离主义是最大的敌人"},{"start":11.28,"end":14.67,"text":"很多东西都有可能长成分离主义"},{"start":14.67,"end":17.28,"text":"但是那些东西在长成分离主义之前"},{"start":17.28,"end":19.14,"text":"它未必是分离主义"},{"start":20.199,"end":24.38,"text":"据我了解的消息是美国的"},{"start":25.199,"end":28.5,"text":"或者说英国的一些"},{"start":33.74,"end":34.84,"text":"我国的"},{"start":37.3,"end":39.739,"text":"啊之前的一个地区"},{"start":40.52,"end":44.44,"text":"流亡出去的一部分无政府主义者"},{"start":44.72,"end":46.52,"text":"据我了解的信息啊"},{"start":46.52,"end":51.48,"text":"这些人呢上个月又有一些"},{"start":53.58,"end":55.099,"text":"偷偷回来了"},{"start":55.9,"end":57.06,"text":"那么这些人呢"},{"start":57.06,"end":60.86,"text":"就是打着这些人身份就无政府主义"},{"start":60.86,"end":61.76,"text":"所以我最近为什么"},{"start":61.76,"end":64.2,"text":"我举报那个无政府主义网站啊"},{"start":64.94,"end":68.8,"text":"因为我有很大的理由去"},{"start":70.64,"end":75.12,"text":"去推测这些人应该是认识的啊"},{"start":75.12,"end":78.78,"text":"这些人应该是认识的某个边陲小城"},{"start":78.78,"end":82.32,"text":"或者说某个岛屿啊"},{"start":82.32,"end":86.76,"text":"以及是这个英国和美国啊"},{"start":86.76,"end":89.25,"text":"都有一些流亡的无政府主义者"},{"start":89.25,"end":94.32,"text":"这些人实质上呢他们会打着无政府主义的旗号"},{"start":94.32,"end":95.56,"text":"做的事情呢"},{"start":95.64,"end":97.56,"text":"实际上是分离主义"},{"start":97.56,"end":102.21,"text":"实际上是分离主义啊"},{"start":102.21,"end":108.74,"text":"分离主义想要从一个统一的啊"},{"start":108.74,"end":111.54,"text":"统一的啊"},{"start":111.54,"end":112.86,"text":"多民族国家啊"},{"start":112.86,"end":117.08,"text":"或者是一个大型啊民族共同体当中"},{"start":117.3,"end":121.74,"text":"获得他的局部的啊裂开来分离主义"},{"start":121.74,"end":123.52,"text":"分裂主义这种人"},{"start":123.92,"end":127.55,"text":"那么我在我在这里啊明确告诉各位"},{"start":127.55,"end":130.22,"text":"分离主义的实质并不是取得独立"},{"start":130.22,"end":130.979,"text":"自主"},{"start":141.64,"end":144.33,"text":"我们最大的敌人"},{"start":144.33,"end":148.86,"text":"或者说我们很容易遇到的一个啊"},{"start":148.86,"end":151.2,"text":"很多东西它实质上是分离主义"},{"start":151.2,"end":152.97,"text":"但是他会套各种皮"},{"start":152.97,"end":154.86,"text":"比如我刚刚说的无政府主义"},{"start":154.86,"end":156.46,"text":"他们会套这种皮"},{"start":157.32,"end":158.6,"text":"这种无政府主义呢"},{"start":158.6,"end":164.35,"text":"它会使得想要把某些地区啊割裂开来"},{"start":169.69,"end":174.68,"text":"让跨国资本来主导那个地方的社会关系"},{"start":174.68,"end":178.04,"text":"然后就说这个地方就是局部地"},{"start":178.04,"end":179.7,"text":"实现了无政府主义"},{"start":179.92,"end":184.439,"text":"然后一种什么浸润在资本主义国际"},{"start":184.439,"end":187.379,"text":"国际资产阶级当局的控制之下"},{"start":187.379,"end":191.339,"text":"的一个所谓的无政府主义啊"},{"start":191.339,"end":192.059,"text":"无声无息"},{"start":193.559,"end":196.939,"text":"尤其是他们就想把那边啊"},{"start":196.939,"end":199.879,"text":"幻想可以把一个金融金融的一个城市"},{"start":199.879,"end":202.88,"text":"或者说幻想把一个这个在资产阶级"},{"start":202.88,"end":204.5,"text":"资本主义的分工体系里面"},{"start":204.5,"end":208.2,"text":"有一个比较利润相对丰厚的一个一个省份"},{"start":208.86,"end":212.66,"text":"他们想把它转化成一种所谓的无政府主义"},{"start":212.66,"end":215.0,"text":"那么它的实质是分离主义"},{"start":215.0,"end":220.409,"text":"同样的这样的分离主义也会表现为"},{"start":220.409,"end":225.64,"text":"有的时候一些啊大的主体民族的沙文主义"},{"start":225.64,"end":229.84,"text":"其实表面上看它是主体民族的沙文主义"},{"start":231.499,"end":238.049,"text":"但是其实他也是想要让一部分省份啊"},{"start":238.049,"end":244.84,"text":"摆脱一个啊一个统一的"},{"start":246.98,"end":252.48,"text":"中央权力的控制融入国际资本主义秩序当中去"},{"start":252.78,"end":253.95,"text":"这样的"},{"start":253.95,"end":257.16,"text":"比如说我点名了狭隘的大汉族主义"},{"start":258.019,"end":259.839,"text":"狭隘的大汉族主义"},{"start":259.839,"end":264.16,"text":"也可以是一种表现为一种分离主义"},{"start":264.16,"end":267.66,"text":"或者说他不仅他自己表现为一种分离主义"},{"start":267.66,"end":272.44,"text":"它也可能会促成其他边缘地区的分离主义"},{"start":273.16,"end":276.54,"text":"我也就任其他边远地区的分离主义"},{"start":277.24,"end":278.94,"text":"睁一只眼闭一只眼"},{"start":278.94,"end":281.46,"text":"实际上是和国际资产阶级"},{"start":281.46,"end":284.3,"text":"国际资本主义当局啊"},{"start":284.3,"end":289.42,"text":"欧美的大型的占优势的帝国主义资本啊"},{"start":289.42,"end":291.37,"text":"其实和他们达成协议了"},{"start":291.37,"end":295.829,"text":"背叛这个多民族国家的长远利益"},{"start":295.829,"end":297.749,"text":"背叛人民"},{"start":297.749,"end":300.14,"text":"背叛劳动群众的长远利益"},{"start":302.819,"end":305.029,"text":"这里面有典型的一种叙事"},{"start":305.029,"end":306.349,"text":"我明确说了"},{"start":306.349,"end":308.04,"text":"三和四省"},{"start":308.099,"end":314.4,"text":"山河四省这种叙事搞什么山河大学啊"},{"start":314.4,"end":316.24,"text":"这里面这种"},{"start":317.0,"end":319.9,"text":"但是他是说是啊"},{"start":319.9,"end":323.47,"text":"他以这个汉族正统自居的四个省份吧"},{"start":323.47,"end":326.78,"text":"汉民族发源地啊啊"},{"start":328.74,"end":333.36,"text":"但是我说的这样的思潮是有可能酝酿出啊"},{"start":333.36,"end":335.55,"text":"酝酿出地域歧视的"},{"start":335.55,"end":337.64,"text":"他至少会导致地方主义"},{"start":337.64,"end":340.04,"text":"当然说它不一定会导致分离主义"},{"start":340.04,"end":343.96,"text":"但是说一旦这样的地方主义甚嚣尘上"},{"start":344.66,"end":349.24,"text":"他就会为其他的一些更容易融入国际"},{"start":349.24,"end":352.59,"text":"资本主义秩序的一些分离主义势力"},{"start":352.59,"end":358.34,"text":"分离主义的思潮提供借口和把柄啊"},{"start":358.34,"end":359.82,"text":"提供借口和把柄"},{"start":360.74,"end":362.86,"text":"所以不要轻易的去搞这种啊"},{"start":362.86,"end":367.099,"text":"什么大汉族民族主义叙事或者山河四神这些啊"},{"start":367.099,"end":367.879,"text":"汉族同胞"},{"start":367.879,"end":369.739,"text":"汉族省份都是受苦的啊"},{"start":369.739,"end":371.66,"text":"都是被怎么怎么样的"},{"start":377.1,"end":384.19,"text":"然后还有一点就是说我们一定看清楚"},{"start":384.19,"end":389.85,"text":"有很多一些啊"},{"start":389.85,"end":393.36,"text":"我们说的他说打着独立自主的旗号"},{"start":393.599,"end":399.28,"text":"以某个呃西方近代的民族国家的这个啊"},{"start":399.28,"end":403.06,"text":"这个民族国家的形成使啊"},{"start":403.84,"end":405.93,"text":"把它美化啊"},{"start":405.93,"end":407.15,"text":"把他这个说说"},{"start":407.15,"end":408.53,"text":"要说它自古以来"},{"start":408.53,"end":410.96,"text":"它有一个相对独立的一个民族内核"},{"start":410.96,"end":413.39,"text":"然后在一个现代化的进程当中啊"},{"start":413.39,"end":414.71,"text":"他通过某种方式"},{"start":414.71,"end":418.56,"text":"它形成了一个独立的民族认同"},{"start":418.56,"end":421.77,"text":"然后它就可以割据出一片领土"},{"start":421.77,"end":427.58,"text":"从之前的母国统一的多民族国家身上嗯"},{"start":427.58,"end":429.68,"text":"割据出一片领土啊"},{"start":429.68,"end":432.76,"text":"那么又把它鼓吹成是一种独立自主"},{"start":433.54,"end":438.06,"text":"他如果仅仅是描述个历史现实过程当中"},{"start":438.06,"end":445.61,"text":"对于相应的人物进行过分美化也是有问题的啊"},{"start":445.61,"end":448.55,"text":"在啊期盼这样的人物出来"},{"start":448.55,"end":452.52,"text":"期盼这样的分离主义投机客出来"},{"start":453.88,"end":457.89,"text":"生拔硬造一个自古以来"},{"start":457.89,"end":460.35,"text":"它有它相对独立的民族认同"},{"start":460.35,"end":464.779,"text":"这个地区如果说在一个相对动荡的过程当中"},{"start":464.779,"end":468.169,"text":"他就可以在那里格局啊"},{"start":468.169,"end":470.629,"text":"或在那里违背啊"},{"start":470.629,"end":472.189,"text":"要先交投名状"},{"start":472.189,"end":474.36,"text":"像国际资产阶级交投名状"},{"start":474.36,"end":476.79,"text":"镇压他自己的无产阶级"},{"start":476.79,"end":480.5,"text":"然后呢再向他的母国发起进攻"},{"start":481.319,"end":483.679,"text":"那实现它的这个地缘胜利"},{"start":483.679,"end":486.28,"text":"局部的一个地缘军事形成"},{"start":487.46,"end":489.52,"text":"然后他就可以啊"},{"start":489.52,"end":492.24,"text":"看上去俨然就像一个现代民族之父"},{"start":493.12,"end":499.9,"text":"这个我们不妨去了解一下什么南斯拉夫的历史"},{"start":499.9,"end":504.11,"text":"南联盟的历史啊"},{"start":504.11,"end":507.26,"text":"塞尔维亚的主体民族地位"},{"start":507.26,"end":511.02,"text":"为什么丢失了这么一个问题啊"},{"start":511.819,"end":518.38,"text":"大赛族主义最终也会导致分离主义的现实了啊"},{"start":518.38,"end":520.48,"text":"这是我们刚刚刚讲过的"},{"start":520.48,"end":524.32,"text":"大的主体民族主义会导致分离主义的结果"},{"start":524.32,"end":526.839,"text":"所以不要上这个上这个当"},{"start":526.94,"end":528.35,"text":"不要中这个招"},{"start":528.35,"end":532.24,"text":"有些民族主义者我说了大的主体民族主义"},{"start":533.64,"end":537.41,"text":"或者说你那个大的这个这个呃"},{"start":537.41,"end":541.16,"text":"和国家对应的那个统一的中华民族"},{"start":541.5,"end":545.68,"text":"如果你过分强调它当中的主体民族"},{"start":545.82,"end":548.67,"text":"过分强调某某个单一文化"},{"start":548.67,"end":550.23,"text":"单一民族叙事"},{"start":550.23,"end":554.939,"text":"单一的历史的一个呃正统性叙事的话"},{"start":554.94,"end":558.8,"text":"都有可能授人以柄啊"},{"start":558.8,"end":560.9,"text":"都有可能被别人利用了"},{"start":560.9,"end":562.46,"text":"来你这种地方主义"},{"start":562.46,"end":564.32,"text":"或者说你这种狭隘的沙文主义"},{"start":564.32,"end":566.14,"text":"是不要沙文主义化"},{"start":566.18,"end":571.76,"text":"否则会被人利用来撩拨其他的一些相对弱势的"},{"start":571.76,"end":574.22,"text":"相对边缘的其他民族的"},{"start":574.22,"end":575.76,"text":"它的分离主义倾向"},{"start":577.22,"end":578.29,"text":"对不对"},{"start":578.29,"end":581.92,"text":"你本来是确实是这个这个家里面"},{"start":581.92,"end":583.8,"text":"你是这个很大的一个分量"},{"start":584.4,"end":588.74,"text":"但是你不能不能变得非常的这个暴躁啊"},{"start":588.74,"end":590.84,"text":"不能变得非常的武断啊"},{"start":590.84,"end":593.87,"text":"不能非常的就无视啊"},{"start":593.87,"end":595.8,"text":"家庭其他成员的感受"},{"start":596.56,"end":600.62,"text":"否则是把家里的其他成员往对立面去推啊"},{"start":602.22,"end":603.38,"text":"那我们要说了"},{"start":603.38,"end":607.64,"text":"就是说我们绝不容许啊"},{"start":607.64,"end":614.0,"text":"我们绝不容许出现这样的这个地地缘的这个啊"},{"start":614.0,"end":617.839,"text":"我们这要就地缘的这个外围板块啊"},{"start":617.86,"end":620.5,"text":"脱离绝不容许"},{"start":620.5,"end":622.959,"text":"绝不容许啊"},{"start":623.64,"end":626.42,"text":"我们的这个少数民族兄弟同胞"},{"start":626.42,"end":629.03,"text":"他们的利益啊"},{"start":629.03,"end":631.04,"text":"他们的劳动群众的根本利益"},{"start":633.65,"end":637.91,"text":"是要在我们的民族团结的大家庭当中"},{"start":637.91,"end":640.599,"text":"才能够最好的得到保障的"},{"start":640.72,"end":642.97,"text":"地缘局势的动荡"},{"start":642.97,"end":644.44,"text":"分离主义"},{"start":644.44,"end":647.12,"text":"极端的民族主义的这个盛行"},{"start":647.12,"end":652.92,"text":"都会给各族人民带来无穷无尽的痛苦啊"},{"start":653.32,"end":656.88,"text":"啊带来毫无必要的仇恨啊"},{"start":656.88,"end":658.56,"text":"带来无穷无尽的痛苦"},{"start":658.56,"end":664.04,"text":"那么最终都是逼迫其中的这个一部分啊"},{"start":664.06,"end":665.86,"text":"把另外一部分残杀"},{"start":665.86,"end":668.74,"text":"然后当投名状啊"},{"start":669.12,"end":671.43,"text":"邀请域外势力来干涉"},{"start":671.43,"end":675.4,"text":"当投名状要融入国际资本主义秩序"},{"start":675.62,"end":679.68,"text":"当投名状找个主子给自己撑腰"},{"start":679.68,"end":683.16,"text":"让自己犯下的这些罪过造成这些仇恨呢"},{"start":683.16,"end":687.659,"text":"可以有一个更强大的力量啊来撑腰"},{"start":687.659,"end":691.63,"text":"那么就不要去制造这样的仇恨啊"},{"start":691.63,"end":695.199,"text":"就维持一个和睦的关系啊"},{"start":696.26,"end":698.35,"text":"刻意去制造这样的仇恨"},{"start":698.35,"end":700.82,"text":"刻意去挑拨啊"},{"start":700.82,"end":703.34,"text":"夸大扭曲啊"},{"start":703.34,"end":704.69,"text":"人民内部矛盾"},{"start":704.69,"end":706.25,"text":"人民群众的啊"},{"start":706.25,"end":711.26,"text":"多民族之间的一些嗯细小的一些冲突"},{"start":711.9,"end":716.36,"text":"都是在啊都是居心叵测的啊"},{"start":716.36,"end":718.52,"text":"这样的做法都是居心叵测"},{"start":718.52,"end":720.56,"text":"都是刻意为之的"},{"start":722.1,"end":724.0,"text":"那我们要讲的就是说"},{"start":725.56,"end":733.78,"text":"所以对于我国以及广大的东亚无产阶级"},{"start":733.92,"end":737.22,"text":"有一个统一的多民族"},{"start":737.22,"end":739.71,"text":"我们甚至说我们国家的存在"},{"start":739.71,"end":742.68,"text":"是可以给东南亚做范本的"},{"start":744.78,"end":745.94,"text":"我始终认为"},{"start":745.94,"end":749.96,"text":"我们国家的这样的一种多民族和睦的统一的"},{"start":749.96,"end":750.86,"text":"存在的状况"},{"start":750.86,"end":754.86,"text":"是可以给东南亚好多国家做范本的"},{"start":754.86,"end":757.35,"text":"东南亚的好多国家是没做到这一点的"},{"start":757.35,"end":759.6,"text":"东南亚好国家好多还是一个"},{"start":759.6,"end":761.24,"text":"这是什么啊"},{"start":761.24,"end":764.57,"text":"有是什么各种民第五半歌剧状态的"},{"start":764.57,"end":766.3,"text":"他们都是失败的"},{"start":766.58,"end":769.34,"text":"我们国家非常良好的啊"},{"start":770.36,"end":771.979,"text":"可以作为一个示范"},{"start":772.7,"end":776.62,"text":"那么这个示范就意味着说统一的多民族国家"},{"start":776.62,"end":781.48,"text":"和睦的和谐的安定的多民族国家"},{"start":781.48,"end":786.04,"text":"并且我们的统一我们还要进一步一统啊"},{"start":787.16,"end":789.64,"text":"我们还进一步实现国家的彻底统一"},{"start":789.64,"end":793.48,"text":"完整统一这么一个统一的多民族国家"},{"start":793.48,"end":797.5,"text":"安定和谐的啊"},{"start":797.5,"end":799.719,"text":"这么一个巨大的版图"},{"start":800.4,"end":803.33,"text":"它是我们甚至要说的"},{"start":803.33,"end":805.1,"text":"不仅是我国的"},{"start":805.1,"end":810.87,"text":"而且是东亚无产阶级的宝贵财富"},{"start":810.87,"end":814.04,"text":"最为宝贵的最为珍贵的财富"},{"start":815.7,"end":819.59,"text":"维护国家统一完整啊"},{"start":819.59,"end":821.66,"text":"反对一切分裂力量"},{"start":821.66,"end":824.33,"text":"反对一切分离主义的啊"},{"start":824.33,"end":827.24,"text":"这种狂妄的啊"}