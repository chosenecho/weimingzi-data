  "content_sha256": "2e76e381dbcd7b60067b4d031610a76d7fb117b24f05ff656b0023b4504d19b6",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 1380,
      "end_ms": 4580,
      "text": "我们阶段性的总结一下这个现代哲学史"
    },
    {
      "ordinal": 1,
      "start_ms": 7540,
      "end_ms": 9240,
      "text": "好我们用游戏讲哲学"
    },
    {
      "ordinal": 2,
      "start_ms": 9240,
      "end_ms": 10860,
      "text": "用游戏讲哲学"
    },
    {
      "ordinal": 3,
      "start_ms": 10860,
      "end_ms": 12600,
      "text": "用游戏做比喻"
    },
    {
      "ordinal": 4,
      "start_ms": 12600,
      "end_ms": 16440,
      "text": "就是我们可以把笛卡尔和这个斯宾诺莎"
    },
    {
      "ordinal": 5,
      "start_ms": 16440,
      "end_ms": 18000,
      "text": "还有这个莱布尼兹三个"
    },
    {
      "ordinal": 6,
      "start_ms": 18000,
      "end_ms": 19950,
      "text": "我们来做一个简单的比喻啊"
    },
    {
      "ordinal": 7,
      "start_ms": 19950,
      "end_ms": 24620,
      "text": "就是笛卡尔笛卡尔玩的游戏叫什么"
    },
    {
      "ordinal": 8,
      "start_ms": 24620,
      "end_ms": 25910,
      "text": "这叫页游"
    },
    {
      "ordinal": 9,
      "start_ms": 25910,
      "end_ms": 26960,
      "text": "网页游戏"
    },
    {
      "ordinal": 10,
      "start_ms": 26960,
      "end_ms": 28190,
      "text": "flash小游戏"
    },
    {
      "ordinal": 11,
      "start_ms": 28190,
      "end_ms": 29570,
      "text": "flash小游戏"
    },
    {
      "ordinal": 12,
      "start_ms": 29570,
      "end_ms": 33110,
      "text": "页游就是你的本地文件是没有的"
    },
    {
      "ordinal": 13,
      "start_ms": 33110,
      "end_ms": 35620,
      "text": "你本地文件都是存在人家服务器里的"
    },
    {
      "ordinal": 14,
      "start_ms": 37140,
      "end_ms": 39660,
      "text": "就存在那个管理员那边的"
    },
    {
      "ordinal": 15,
      "start_ms": 40400,
      "end_ms": 41860,
      "text": "你玩着玩着玩去"
    },
    {
      "ordinal": 16,
      "start_ms": 41860,
      "end_ms": 42520,
      "text": "你的心灵"
    },
    {
      "ordinal": 17,
      "start_ms": 42520,
      "end_ms": 43060,
      "text": "你的心灵"
    },
    {
      "ordinal": 18,
      "start_ms": 43060,
      "end_ms": 46210,
      "text": "你的心灵不过是一个不过是一个网页"
    },
    {
      "ordinal": 19,
      "start_ms": 46210,
      "end_ms": 47820,
      "text": "不过是个网页入口"
    },
    {
      "ordinal": 20,
      "start_ms": 48060,
      "end_ms": 49779,
      "text": "心灵是个网页"
    },
    {
      "ordinal": 21,
      "start_ms": 50180,
      "end_ms": 52040,
      "text": "所以笛卡尔主义实际上"
    },
    {
      "ordinal": 22,
      "start_ms": 52040,
      "end_ms": 53360,
      "text": "就相当于你玩的这个世界"
    },
    {
      "ordinal": 23,
      "start_ms": 53360,
      "end_ms": 56700,
      "text": "这个游戏是一个所有的缓存"
    },
    {
      "ordinal": 24,
      "start_ms": 56700,
      "end_ms": 58470,
      "text": "都是缓存在服务器里面"
    },
    {
      "ordinal": 25,
      "start_ms": 58470,
      "end_ms": 59400,
      "text": "被一个大佬"
    },
    {
      "ordinal": 26,
      "start_ms": 59400,
      "end_ms": 63960,
      "text": "被一个程序员控制的一个一个页游"
    },
    {
      "ordinal": 27,
      "start_ms": 63960,
      "end_ms": 65280,
      "text": "一个页游啊"
    },
    {
      "ordinal": 28,
      "start_ms": 65280,
      "end_ms": 66130,
      "text": "一个页游"
    },
    {
      "ordinal": 29,
      "start_ms": 66130,
      "end_ms": 67930,
      "text": "那你就会担心我靠"
    },
    {
      "ordinal": 30,
      "start_ms": 67930,
      "end_ms": 71890,
      "text": "我的什么存档都存在页游这个服务器里面"
    },
    {
      "ordinal": 31,
      "start_ms": 71890,
      "end_ms": 73810,
      "text": "他哪天翻脸不认不认账了"
    },
    {
      "ordinal": 32,
      "start_ms": 73810,
      "end_ms": 76680,
      "text": "这个页游比如说我充了好多钱对吧"
    },
    {
      "ordinal": 33,
      "start_ms": 76680,
      "end_ms": 78480,
      "text": "最后夜游卷服跑人了"
    },
    {
      "ordinal": 34,
      "start_ms": 78480,
      "end_ms": 79590,
      "text": "那怎么办对吧"
    },
    {
      "ordinal": 35,
      "start_ms": 79590,
      "end_ms": 81360,
      "text": "笛卡尔的怀疑论差不多"
    },
    {
      "ordinal": 36,
      "start_ms": 81360,
      "end_ms": 85090,
      "text": "就是这种一个页游大佬充了十几万"
    },
    {
      "ordinal": 37,
      "start_ms": 85090,
      "end_ms": 87490,
      "text": "20几万在游戏里面一身神装出来"
    },
    {
      "ordinal": 38,
      "start_ms": 87490,
      "end_ms": 88630,
      "text": "像砍天杀地"
    },
    {
      "ordinal": 39,
      "start_ms": 88630,
      "end_ms": 90850,
      "text": "第二天再打开发现自己就变成裸吊了"
    },
    {
      "ordinal": 40,
      "start_ms": 90850,
      "end_ms": 91740,
      "text": "怎么回事"
    },
    {
      "ordinal": 41,
      "start_ms": 92280,
      "end_ms": 95580,
      "text": "怎么会是服服务器管理员说我靠"
    },
    {
      "ordinal": 42,
      "start_ms": 95580,
      "end_ms": 96510,
      "text": "不好意思"
    },
    {
      "ordinal": 43,
      "start_ms": 96510,
      "end_ms": 99360,
      "text": "那个昨天那个是我们那个一个game"
    },
    {
      "ordinal": 44,
      "start_ms": 99360,
      "end_ms": 101460,
      "text": "违法违规给你操作"
    },
    {
      "ordinal": 45,
      "start_ms": 101460,
      "end_ms": 104640,
      "text": "他当时充钱的那个端口都是假的"
    },
    {
      "ordinal": 46,
      "start_ms": 104740,
      "end_ms": 106540,
      "text": "我们不承认的啊"
    },
    {
      "ordinal": 47,
      "start_ms": 106540,
      "end_ms": 107320,
      "text": "就完蛋了"
    },
    {
      "ordinal": 48,
      "start_ms": 107320,
      "end_ms": 107980,
      "text": "笛卡就完蛋了"
    },
    {
      "ordinal": 49,
      "start_ms": 107980,
      "end_ms": 108460,
      "text": "对不对"
    },
    {
      "ordinal": 50,
      "start_ms": 108460,
      "end_ms": 110800,
      "text": "那个服务服务器管理员逃跑了"
    },
    {
      "ordinal": 51,
      "start_ms": 110800,
      "end_ms": 111520,
      "text": "已经逃跑"
    },
    {
      "ordinal": 52,
      "start_ms": 111520,
      "end_ms": 112670,
      "text": "跑到另外一个"
    },
    {
      "ordinal": 53,
      "start_ms": 112670,
      "end_ms": 114890,
      "text": "另外一个我们敌对的页游公司里面去"
    },
    {
      "ordinal": 54,
      "start_ms": 114890,
      "end_ms": 116230,
      "text": "开了另外一个私服了"
    },
    {
      "ordinal": 55,
      "start_ms": 116230,
      "end_ms": 118570,
      "text": "所以笛卡尔主义就相当于是玩页游的"
    },
    {
      "ordinal": 56,
      "start_ms": 118570,
      "end_ms": 120010,
      "text": "他就担心自己的那个账号"
    },
    {
      "ordinal": 57,
      "start_ms": 120010,
      "end_ms": 122340,
      "text": "会不会被服务器给坑了"
    },
    {
      "ordinal": 58,
      "start_ms": 122540,
      "end_ms": 123600,
      "text": "那么"
    },
    {
      "ordinal": 59,
      "start_ms": 125340,
      "end_ms": 132080,
      "text": "然后那个斯宾诺莎就是一个很简单的很SPINOZA"
    },
    {
      "ordinal": 60,
      "start_ms": 132080,
      "end_ms": 133940,
      "text": "斯宾诺莎这四个字好烦呀"
    },
    {
      "ordinal": 61,
      "start_ms": 133940,
      "end_ms": 136430,
      "text": "我最讨厌写这四个字好长"
    },
    {
      "ordinal": 62,
      "start_ms": 136430,
      "end_ms": 140430,
      "text": "SPINOSA写英语不好吗"
    },
    {
      "ordinal": 63,
      "start_ms": 140430,
      "end_ms": 143280,
      "text": "ZA好像是斯宾诺莎"
    },
    {
      "ordinal": 64,
      "start_ms": 143280,
      "end_ms": 144880,
      "text": "他是一个单机狂魔"
    },
    {
      "ordinal": 65,
      "start_ms": 146939,
      "end_ms": 149539,
      "text": "我不知道你在宿舍里面有没有见到那种人"
    },
    {
      "ordinal": 66,
      "start_ms": 149539,
      "end_ms": 150679,
      "text": "就是玩一个单机游戏"
    },
    {
      "ordinal": 67,
      "start_ms": 150679,
      "end_ms": 151819,
      "text": "可以玩4年"
    },
    {
      "ordinal": 68,
      "start_ms": 151819,
      "end_ms": 153379,
      "text": "他不腻单机狂魔"
    },
    {
      "ordinal": 69,
      "start_ms": 153379,
      "end_ms": 155600,
      "text": "我记得我之前有个有个室友"
    },
    {
      "ordinal": 70,
      "start_ms": 155600,
      "end_ms": 158040,
      "text": "他玩一款游戏叫曹操传"
    },
    {
      "ordinal": 71,
      "start_ms": 159920,
      "end_ms": 161560,
      "text": "他玩的是玩了4年"
    },
    {
      "ordinal": 72,
      "start_ms": 161560,
      "end_ms": 162130,
      "text": "他不腻"
    },
    {
      "ordinal": 73,
      "start_ms": 162130,
      "end_ms": 163870,
      "text": "我太服了我太服了"
    },
    {
      "ordinal": 74,
      "start_ms": 163870,
      "end_ms": 165220,
      "text": "斯宾诺莎就是单机狂魔啊"
    },
    {
      "ordinal": 75,
      "start_ms": 165220,
      "end_ms": 168320,
      "text": "他觉得就说哎我玩了玩去"
    },
    {
      "ordinal": 76,
      "start_ms": 168320,
      "end_ms": 169700,
      "text": "这个游戏就是一个单机游戏"
    },
    {
      "ordinal": 77,
      "start_ms": 169700,
      "end_ms": 171500,
      "text": "就是个大型单机游戏"
    },
    {
      "ordinal": 78,
      "start_ms": 173839,
      "end_ms": 175539,
      "text": "大型单机游戏"
    },
    {
      "ordinal": 79,
      "start_ms": 175539,
      "end_ms": 178569,
      "text": "对我的世界本身就是个大型单机游戏"
    },
    {
      "ordinal": 80,
      "start_ms": 178569,
      "end_ms": 180760,
      "text": "但不存在管理员这种东西"
    },
    {
      "ordinal": 81,
      "start_ms": 180940,
      "end_ms": 184540,
      "text": "这管理员就是个大大型单机游戏本身理解吗"
    },
    {
      "ordinal": 82,
      "start_ms": 184540,
      "end_ms": 188420,
      "text": "你你如果就是所谓的上帝啊"
    },
    {
      "ordinal": 83,
      "start_ms": 188420,
      "end_ms": 191300,
      "text": "也不过就是这个大就是大型单机游戏本身"
    },
    {
      "ordinal": 84,
      "start_ms": 191300,
      "end_ms": 193160,
      "text": "那么它有的时候可能会人格化"
    },
    {
      "ordinal": 85,
      "start_ms": 193160,
      "end_ms": 193820,
      "text": "人格化的话"
    },
    {
      "ordinal": 86,
      "start_ms": 193820,
      "end_ms": 197849,
      "text": "就是这个游戏里面会生成一个"
    },
    {
      "ordinal": 87,
      "start_ms": 197849,
      "end_ms": 202439,
      "text": "好像是某某某某管理员头上戴个王冠的啊"
    },
    {
      "ordinal": 88,
      "start_ms": 202439,
      "end_ms": 206240,
      "text": "你可以过去跟他和这个游戏看看"
    },
    {
      "ordinal": 89,
      "start_ms": 206240,
      "end_ms": 207320,
      "text": "游戏攻略什么什么"
    },
    {
      "ordinal": 90,
      "start_ms": 207320,
      "end_ms": 209060,
      "text": "但是他是个象征性的人文化的"
    },
    {
      "ordinal": 91,
      "start_ms": 209060,
      "end_ms": 211340,
      "text": "但是归根结底他是个大型的单机游戏"
    },
    {
      "ordinal": 92,
      "start_ms": 211340,
      "end_ms": 213510,
      "text": "他外面没有没东西了没了"
    },
    {
      "ordinal": 93,
      "start_ms": 213510,
      "end_ms": 216210,
      "text": "那所有一切东西都在这个单机游戏里面"
    },
    {
      "ordinal": 94,
      "start_ms": 216210,
      "end_ms": 218790,
      "text": "我们一辈子只要静静的玩这个单机游戏"
    },
    {
      "ordinal": 95,
      "start_ms": 218790,
      "end_ms": 219270,
      "text": "就可以了"
    },
    {
      "ordinal": 96,
      "start_ms": 219270,
      "end_ms": 220960,
      "text": "这是斯宾诺莎的哲学"
    },
    {
      "ordinal": 97,
      "start_ms": 231200,
      "end_ms": 233080,
      "text": "但是斯宾诺莎的哲学其实可以"
    },
    {
      "ordinal": 98,
      "start_ms": 233080,
      "end_ms": 234190,
      "text": "我们可以进一步说的"
    },
    {
      "ordinal": 99,
      "start_ms": 234190,
      "end_ms": 235120,
      "text": "再夸张一点"
    },
    {
      "ordinal": 100,
      "start_ms": 235120,
      "end_ms": 237920,
      "text": "就是说他连玩家都不需要"
    },
    {
      "ordinal": 101,
      "start_ms": 240100,
      "end_ms": 241680,
      "text": "他连玩家都不需要"
    },
    {
      "ordinal": 102,
      "start_ms": 241680,
      "end_ms": 242730,
      "text": "他不需要玩家"
    },
    {
      "ordinal": 103,
      "start_ms": 242730,
      "end_ms": 245140,
      "text": "他有点像那种放置型游戏"
    },
    {
      "ordinal": 104,
      "start_ms": 250300,
      "end_ms": 253620,
      "text": "他游戏像那种无限长时间不停升级"
    },
    {
      "ordinal": 105,
      "start_ms": 253620,
      "end_ms": 254940,
      "text": "那种放置音游戏"
    },
    {
      "ordinal": 106,
      "start_ms": 254940,
      "end_ms": 256019,
      "text": "它不需要玩家"
    },
    {
      "ordinal": 107,
      "start_ms": 256019,
      "end_ms": 257459,
      "text": "他这个自己玩自己的"
    },
    {
      "ordinal": 108,
      "start_ms": 257459,
      "end_ms": 260738,
      "text": "我不知道你们有没有玩过他这个游戏"
    },
    {
      "ordinal": 109,
      "start_ms": 260738,
      "end_ms": 262220,
      "text": "自己玩自己"
    },
    {
      "ordinal": 110,
      "start_ms": 267040,
      "end_ms": 268200,
      "text": "他这个是个游戏"
    },
    {
      "ordinal": 111,
      "start_ms": 268200,
      "end_ms": 269700,
      "text": "自己玩自己一个放置性游戏"
    },
    {
      "ordinal": 112,
      "start_ms": 269700,
      "end_ms": 273440,
      "text": "在那边五对五个英雄跑到哪里去冒险"
    },
    {
      "ordinal": 113,
      "start_ms": 274940,
      "end_ms": 276040,
      "text": "跑到哪里去冒险"
    },
    {
      "ordinal": 114,
      "start_ms": 276040,
      "end_ms": 277360,
      "text": "然后把杀怪升级"
    },
    {
      "ordinal": 115,
      "start_ms": 277360,
      "end_ms": 278580,
      "text": "装备升级了啊"
    },
    {
      "ordinal": 116,
      "start_ms": 278580,
      "end_ms": 279300,
      "text": "然后升级"
    },
    {
      "ordinal": 117,
      "start_ms": 279300,
      "end_ms": 280620,
      "text": "然后技能又学会了啊"
    },
    {
      "ordinal": 118,
      "start_ms": 280620,
      "end_ms": 281640,
      "text": "又跑到另外一个地方"
    },
    {
      "ordinal": 119,
      "start_ms": 281640,
      "end_ms": 283080,
      "text": "它都是自动的自动脚本"
    },
    {
      "ordinal": 120,
      "start_ms": 283080,
      "end_ms": 285649,
      "text": "不停的自己在那边升级的啊"
    },
    {
      "ordinal": 121,
      "start_ms": 285649,
      "end_ms": 288829,
      "text": "不停的他就是大型放射性单机游戏"
    },
    {
      "ordinal": 122,
      "start_ms": 288829,
      "end_ms": 290179,
      "text": "所以斯宾诺莎的哲学"
    },
    {
      "ordinal": 123,
      "start_ms": 290179,
      "end_ms": 293180,
      "text": "它是游戏自己玩自己玩家本人的存在"
    },
    {
      "ordinal": 124,
      "start_ms": 293180,
      "end_ms": 295520,
      "text": "实际上也是个游戏生成出来的一个幻象"
    },
    {
      "ordinal": 125,
      "start_ms": 295520,
      "end_ms": 296210,
      "text": "一个幻想"
    },
    {
      "ordinal": 126,
      "start_ms": 296210,
      "end_ms": 299490,
      "text": "这样你大概能理解斯宾诺莎就是我说的"
    },
    {
      "ordinal": 127,
      "start_ms": 299490,
      "end_ms": 301050,
      "text": "他是大同木辉夜的写轮眼"
    },
    {
      "ordinal": 128,
      "start_ms": 301050,
      "end_ms": 303070,
      "text": "本身他都无限阅读"
    },
    {
      "ordinal": 129,
      "start_ms": 303070,
      "end_ms": 304870,
      "text": "它是这个写轮眼本身在阅读"
    },
    {
      "ordinal": 130,
      "start_ms": 304870,
      "end_ms": 306640,
      "text": "他自己对"
    },
    {
