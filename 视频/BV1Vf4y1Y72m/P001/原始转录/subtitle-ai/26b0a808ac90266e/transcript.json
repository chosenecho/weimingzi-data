      "ordinal": 0,
      "start_ms": 13140,
      "end_ms": 15030,
      "text": "红尘多可笑"
    },
    {
      "ordinal": 1,
      "start_ms": 15030,
      "end_ms": 17160,
      "text": "痴情最无聊"
    },
    {
      "ordinal": 2,
      "start_ms": 17160,
      "end_ms": 20000,
      "text": "目空一切也好"
    },
    {
      "ordinal": 3,
      "start_ms": 21340,
      "end_ms": 22830,
      "text": "此生未了"
    },
    {
      "ordinal": 4,
      "start_ms": 22830,
      "end_ms": 25050,
      "text": "心却已无所扰"
    },
    {
      "ordinal": 5,
      "start_ms": 25050,
      "end_ms": 28380,
      "text": "只想换得半世逍遥"
    },
    {
      "ordinal": 6,
      "start_ms": 28660,
      "end_ms": 30670,
      "text": "心事对人笑"
    },
    {
      "ordinal": 7,
      "start_ms": 30670,
      "end_ms": 32380,
      "text": "梦中全忘掉"
    },
    {
      "ordinal": 8,
      "start_ms": 33400,
      "end_ms": 35699,
      "text": "叹天黑得太早"
    },
    {
      "ordinal": 9,
      "start_ms": 37040,
      "end_ms": 38560,
      "text": "来生难料"
    },
    {
      "ordinal": 10,
      "start_ms": 38560,
      "end_ms": 40739,
      "text": "爱恨一笔勾销"
    },
    {
      "ordinal": 11,
      "start_ms": 40960,
      "end_ms": 42280,
      "text": "对酒当歌"
    },
    {
      "ordinal": 12,
      "start_ms": 42280,
      "end_ms": 44510,
      "text": "我只愿开心到老"
    },
    {
      "ordinal": 13,
      "start_ms": 44510,
      "end_ms": 45620,
      "text": "风再冷"
    },
    {
      "ordinal": 14,
      "start_ms": 45620,
      "end_ms": 46610,
      "text": "不想逃"
    },
    {
      "ordinal": 15,
      "start_ms": 46610,
      "end_ms": 50720,
      "text": "花再美也不想要任我飘摇"
    },
    {
      "ordinal": 16,
      "start_ms": 52460,
      "end_ms": 54470,
      "text": "天越高心越小"
    },
    {
      "ordinal": 17,
      "start_ms": 54470,
      "end_ms": 56330,
      "text": "不问因果有多少"
    },
    {
      "ordinal": 18,
      "start_ms": 56330,
      "end_ms": 59420,
      "text": "独自醉倒"
    },
    {
      "ordinal": 19,
      "start_ms": 60220,
      "end_ms": 62340,
      "text": "今天哭明天笑"
    },
    {
      "ordinal": 20,
      "start_ms": 62340,
      "end_ms": 67380,
      "text": "不求有人能明了一身骄傲"
    },
    {
      "ordinal": 21,
      "start_ms": 68140,
      "end_ms": 69600,
      "text": "可在唱舞"
    },
    {
      "ordinal": 22,
      "start_ms": 69600,
      "end_ms": 70800,
      "text": "在跳长夜"
    },
    {
      "ordinal": 23,
      "start_ms": 70800,
      "end_ms": 72000,
      "text": "漫漫不觉晓"
    },
    {
      "ordinal": 24,
      "start_ms": 72000,
      "end_ms": 74179,
      "text": "将快乐寻找"
    },
