{
  "bvid": "BV13a4y117DV",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "201fa4d2eb3a9629d6896bb5a8fc3a72fa4f544f59cd55ea2ee5f9dbc5c0bf6c",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 1100,
      "end_ms": 1520,
      "text": "你好"
    },
    {
      "ordinal": 1,
      "start_ms": 1520,
      "end_ms": 4250,
      "text": "我最近遭遇到一些有关周易的问题"
    },
    {
      "ordinal": 2,
      "start_ms": 4250,
      "end_ms": 5570,
      "text": "哲学水平不高"
    },
    {
      "ordinal": 3,
      "start_ms": 5570,
      "end_ms": 7250,
      "text": "求求求一些帮助"
    },
    {
      "ordinal": 4,
      "start_ms": 7250,
      "end_ms": 10890,
      "text": "本人一位朋友在接触易学之后"
    },
    {
      "ordinal": 5,
      "start_ms": 10890,
      "end_ms": 12330,
      "text": "国学用于算命"
    },
    {
      "ordinal": 6,
      "start_ms": 12330,
      "end_ms": 14100,
      "text": "去见了一位相关人士"
    },
    {
      "ordinal": 7,
      "start_ms": 14100,
      "end_ms": 17570,
      "text": "这位人士把周易通俗的解释为一部剧本"
    },
    {
      "ordinal": 8,
      "start_ms": 17570,
      "end_ms": 19070,
      "text": "每个人都是用剧本表演"
    },
    {
      "ordinal": 9,
      "start_ms": 19070,
      "end_ms": 21180,
      "text": "虽然拿到的剧本"
    },
    {
      "ordinal": 10,
      "start_ms": 21180,
      "end_ms": 23460,
      "text": "但是依旧可以在演出过程中获得"
    },
    {
      "ordinal": 11,
      "start_ms": 23460,
      "end_ms": 26460,
      "text": "不同的情感体验与生命体验"
    },
    {
      "ordinal": 12,
      "start_ms": 26460,
      "end_ms": 28080,
      "text": "因此从这个角度来讲"
    },
    {
      "ordinal": 13,
      "start_ms": 28080,
      "end_ms": 29520,
      "text": "周易不是用来算命的"
    },
    {
      "ordinal": 14,
      "start_ms": 29520,
      "end_ms": 30960,
      "text": "可以帮更好的生活"
    },
    {
      "ordinal": 15,
      "start_ms": 30960,
      "end_ms": 32310,
      "text": "只有沉迷于算命"
    },
    {
      "ordinal": 16,
      "start_ms": 32310,
      "end_ms": 34440,
      "text": "其实歪曲了周易的本意"
    },
    {
      "ordinal": 17,
      "start_ms": 34440,
      "end_ms": 36240,
      "text": "现在朋友沉迷其中"
    },
    {
      "ordinal": 18,
      "start_ms": 36240,
      "end_ms": 37440,
      "text": "那就不要跟他做朋友"
    },
    {
      "ordinal": 19,
      "start_ms": 37440,
      "end_ms": 38640,
      "text": "当他是啊"
    },
    {
      "ordinal": 20,
      "start_ms": 38640,
      "end_ms": 41940,
      "text": "他现在用卦象来解释我和他之关系"
    },
    {
      "ordinal": 21,
      "start_ms": 41940,
      "end_ms": 43560,
      "text": "以及性格接待人生道路"
    },
    {
      "ordinal": 22,
      "start_ms": 43560,
      "end_ms": 46200,
      "text": "并且解释一切社会发生的现象"
    },
    {
      "ordinal": 23,
      "start_ms": 46200,
      "end_ms": 47970,
      "text": "什么他说什么"
    },
    {
      "ordinal": 24,
      "start_ms": 47970,
      "end_ms": 49140,
      "text": "如何看待马克思主义"
    },
    {
      "ordinal": 25,
      "start_ms": 49140,
      "end_ms": 51800,
      "text": "他认为马克思主义是易经具象化"
    },
    {
      "ordinal": 26,
      "start_ms": 51800,
      "end_ms": 52880,
      "text": "理由如下"
    },
    {
      "ordinal": 27,
      "start_ms": 52880,
      "end_ms": 54200,
      "text": "什么易经的原理"
    },
    {
      "ordinal": 28,
      "start_ms": 54200,
      "end_ms": 55040,
      "text": "天象什么"
    },
    {
      "ordinal": 29,
      "start_ms": 55040,
      "end_ms": 59879,
      "text": "人类构成了社会主体"
    },
    {
      "ordinal": 30,
      "start_ms": 59879,
      "end_ms": 62489,
      "text": "人的力量没法跟天体比较"
    },
    {
      "ordinal": 31,
      "start_ms": 62489,
      "end_ms": 65849,
      "text": "人类什么引力比天地要小什么"
    },
    {
      "ordinal": 32,
      "start_ms": 65849,
      "end_ms": 68820,
      "text": "所以人都可以被物化"
    },
    {
      "ordinal": 33,
      "start_ms": 68820,
      "end_ms": 75640,
      "text": "被易经代码化解释易经就可以预测了"
    },
    {
      "ordinal": 34,
      "start_ms": 82660,
      "end_ms": 87860,
      "text": "说是什么气运什么什么什么什么好好好"
    },
    {
      "ordinal": 35,
      "start_ms": 87860,
      "end_ms": 89750,
      "text": "然后说他无法接受这种解释"
    },
    {
      "ordinal": 36,
      "start_ms": 89750,
      "end_ms": 91310,
      "text": "否认命的存在"
    },
    {
      "ordinal": 37,
      "start_ms": 91310,
      "end_ms": 94730,
      "text": "并认为每个人都是自由的"
    },
    {
      "ordinal": 38,
      "start_ms": 99460,
      "end_ms": 102000,
      "text": "一个人的人生应当由其实践活动决定"
    },
    {
      "ordinal": 39,
      "start_ms": 102000,
      "end_ms": 104250,
      "text": "他认为这套理论有宿命论的成分在"
    },
    {
      "ordinal": 40,
      "start_ms": 104250,
      "end_ms": 107990,
      "text": "但是本人哲学水平不足以支撑自己的观点"
    },
    {
      "ordinal": 41,
      "start_ms": 108070,
      "end_ms": 109930,
      "text": "你不需要用哲学支撑"
    },
    {
      "ordinal": 42,
      "start_ms": 109930,
      "end_ms": 112100,
      "text": "你用信念支撑就行了"
    },
    {
      "ordinal": 43,
      "start_ms": 112100,
      "end_ms": 113690,
      "text": "你就当他放屁"
    },
    {
      "ordinal": 44,
      "start_ms": 113690,
      "end_ms": 114860,
      "text": "跟他远离"
    },
    {
      "ordinal": 45,
      "start_ms": 114860,
      "end_ms": 116540,
      "text": "当他在拉屎不就行了"
    },
    {
      "ordinal": 46,
      "start_ms": 116540,
      "end_ms": 119130,
      "text": "在拉了自己吃屎"
    },
    {
      "ordinal": 47,
      "start_ms": 120010,
      "end_ms": 122670,
      "text": "什么他看过我的什么主意主意"
    },
    {
      "ordinal": 48,
      "start_ms": 122670,
      "end_ms": 126470,
      "text": "二杠二杠三和二杠二杠三杠一"
    },
    {
      "ordinal": 49,
      "start_ms": 126750,
      "end_ms": 130250,
      "text": "他说易经不是让什么人民按照他的描述去运行"
    },
    {
      "ordinal": 50,
      "start_ms": 130250,
      "end_ms": 131810,
      "text": "只是推测个人与我"
    },
    {
      "ordinal": 51,
      "start_ms": 131810,
      "end_ms": 135450,
      "text": "从来没有说易经是推测个人和国家发展的趋势"
    },
    {
      "ordinal": 52,
      "start_ms": 135450,
      "end_ms": 136710,
      "text": "什么吊东西啊"
    },
    {
      "ordinal": 53,
      "start_ms": 136710,
      "end_ms": 137850,
      "text": "看老子视频"
    },
    {
      "ordinal": 54,
      "start_ms": 137850,
      "end_ms": 139720,
      "text": "看到狗肚子里去了"
    },
    {
      "ordinal": 55,
      "start_ms": 139720,
      "end_ms": 140980,
      "text": "就我个人而言"
    },
    {
      "ordinal": 56,
      "start_ms": 140980,
      "end_ms": 143860,
      "text": "在某种程度上可以理解视频中的一些观点"
    },
    {
      "ordinal": 57,
      "start_ms": 143860,
      "end_ms": 146800,
      "text": "但是他已经陷入到他朋友的预测中了"
    },
    {
      "ordinal": 58,
      "start_ms": 146800,
      "end_ms": 151660,
      "text": "他他和他的那个朋友和相关人士进行大量实验"
    },
    {
      "ordinal": 59,
      "start_ms": 151660,
      "end_ms": 153980,
      "text": "结果十分精准"
    },
    {
      "ordinal": 60,
      "start_ms": 153980,
      "end_ms": 159690,
      "text": "你在做广告吧啊这个现象让他陷入怀疑"
    },
    {
      "ordinal": 61,
      "start_ms": 159690,
      "end_ms": 160470,
      "text": "结果十分精准"
    },
    {
      "ordinal": 62,
      "start_ms": 160470,
      "end_ms": 161490,
      "text": "大姐去搞吧"
    },
    {
      "ordinal": 63,
      "start_ms": 161490,
      "end_ms": 162870,
      "text": "本人是准大学生"
    },
    {
      "ordinal": 64,
      "start_ms": 162870,
      "end_ms": 164670,
      "text": "是典型中产阶级家庭"
    },
    {
      "ordinal": 65,
      "start_ms": 164670,
      "end_ms": 165450,
      "text": "眼界不广"
    },
    {
      "ordinal": 66,
      "start_ms": 165450,
      "end_ms": 168430,
      "text": "没有太多社会经实践经历"
    },
    {
      "ordinal": 67,
      "start_ms": 168430,
      "end_ms": 172730,
      "text": "对外部了解很大一部分来自什么什么"
    },
    {
      "ordinal": 68,
      "start_ms": 173010,
      "end_ms": 176710,
      "text": "没看过太多较深奥的哲学书籍"
    },
    {
      "ordinal": 69,
      "start_ms": 176710,
      "end_ms": 179890,
      "text": "也算不上是一个唯物主义者或马克思主义者"
    },
    {
      "ordinal": 70,
      "start_ms": 179890,
      "end_ms": 182430,
      "text": "只是对马克思主义原理有了解"
    },
    {
      "ordinal": 71,
      "start_ms": 182430,
      "end_ms": 185490,
      "text": "他的行为导致我出现了一定程度上信仰危机"
    },
    {
      "ordinal": 72,
      "start_ms": 185490,
      "end_ms": 186390,
      "text": "他想反驳他朋友"
    },
    {
      "ordinal": 73,
      "start_ms": 186390,
      "end_ms": 187860,
      "text": "另外原因比较庸俗"
    },
    {
      "ordinal": 74,
      "start_ms": 187860,
      "end_ms": 190480,
      "text": "他认为就是那个人算命算出来说"
    },
    {
      "ordinal": 75,
      "start_ms": 190480,
      "end_ms": 192850,
      "text": "他读博的时候无法得到满意的结果"
    },
    {
      "ordinal": 76,
      "start_ms": 192850,
      "end_ms": 194320,
      "text": "他想掌握自己的命运"
    },
    {
      "ordinal": 77,
      "start_ms": 194320,
      "end_ms": 198910,
      "text": "但他但他现在对写信人想掌握自己命运"
    },
    {
      "ordinal": 78,
      "start_ms": 198910,
      "end_ms": 202329,
      "text": "但是他对现在这种情况手足无措"
    },
    {
      "ordinal": 79,
      "start_ms": 202329,
      "end_ms": 204429,
      "text": "什么都充满了焦虑与疑惑"
    },
    {
      "ordinal": 80,
      "start_ms": 204429,
      "end_ms": 206950,
      "text": "希望能一些建议和帮助"
    },
    {
      "ordinal": 81,
      "start_ms": 206950,
      "end_ms": 208390,
      "text": "我的建议和帮助"
    },
    {
      "ordinal": 82,
      "start_ms": 208390,
      "end_ms": 209830,
      "text": "就是你不要焦虑和疑惑"
    },
    {
      "ordinal": 83,
      "start_ms": 209830,
      "end_ms": 211990,
      "text": "你当他在放屁"
    },
    {
      "ordinal": 84,
      "start_ms": 213660,
      "end_ms": 215800,
      "text": "你充满了教育和疑惑"
    },
    {
      "ordinal": 85,
      "start_ms": 215800,
      "end_ms": 218080,
      "text": "在我看来都是没有根据的"
    },
    {
      "ordinal": 86,
      "start_ms": 218080,
      "end_ms": 219100,
      "text": "没有根据的焦虑"
    },
    {
      "ordinal": 87,
      "start_ms": 219100,
      "end_ms": 220210,
      "text": "没有根据的疑惑"
    },
    {
      "ordinal": 88,
      "start_ms": 220210,
      "end_ms": 223000,
      "text": "我的建议就是说我就命令你执行这个命令"
    },
    {
      "ordinal": 89,
      "start_ms": 223000,
      "end_ms": 223600,
      "text": "不要焦虑"
    },
    {
      "ordinal": 90,
      "start_ms": 223600,
      "end_ms": 224260,
      "text": "不要疑惑"
    },
    {
      "ordinal": 91,
      "start_ms": 224260,
      "end_ms": 225580,
      "text": "执行这个命令"
    },
    {
      "ordinal": 92,
      "start_ms": 228080,
      "end_ms": 231600,
      "text": "你能不能执行这个这个我给给你下的命令"
    },
    {
      "ordinal": 93,
      "start_ms": 232060,
      "end_ms": 232860,
      "text": "很荒谬"
    },
    {
      "ordinal": 94,
      "start_ms": 232860,
      "end_ms": 233160,
      "text": "对不对"
    },
    {
      "ordinal": 95,
      "start_ms": 233160,
      "end_ms": 235730,
      "text": "你为什么要执行别人给你下达命令"
    },
    {
      "ordinal": 96,
      "start_ms": 235730,
      "end_ms": 238250,
      "text": "你该疑惑该该疑惑疑惑"
    },
    {
      "ordinal": 97,
      "start_ms": 238250,
      "end_ms": 239150,
      "text": "该焦虑焦虑"
    },
    {
      "ordinal": 98,
      "start_ms": 239150,
      "end_ms": 241670,
      "text": "为什么别人说的一番话就会引起你的疑惑"
    },
    {
      "ordinal": 99,
      "start_ms": 241670,
      "end_ms": 242390,
      "text": "引起你的焦虑"
    },
    {
      "ordinal": 100,
      "start_ms": 242390,
      "end_ms": 242810,
      "text": "很荒谬"
    },
    {
      "ordinal": 101,
      "start_ms": 242810,
      "end_ms": 243690,
      "text": "对不对"
    },
    {
      "ordinal": 102,
      "start_ms": 243690,
      "end_ms": 244710,
      "text": "我给你下命令"
    },
    {
      "ordinal": 103,
      "start_ms": 244710,
      "end_ms": 245670,
      "text": "你不允许这样做"
    },
    {
      "ordinal": 104,
      "start_ms": 245670,
      "end_ms": 247110,
      "text": "那个B给你下了命令"
    },
    {
      "ordinal": 105,
      "start_ms": 247110,
      "end_ms": 249330,
      "text": "下了心理学暗示说你要焦虑"
    },
    {
      "ordinal": 106,
      "start_ms": 249330,
      "end_ms": 250140,
      "text": "你要疑惑"
    },
    {
      "ordinal": 107,
      "start_ms": 250140,
      "end_ms": 251380,
      "text": "你会过不好"
    },
    {
      "ordinal": 108,
      "start_ms": 251380,
      "end_ms": 252460,
      "text": "一样的呀"
    },
    {
      "ordinal": 109,
      "start_ms": 253900,
      "end_ms": 255040,
      "text": "你不会执行我的命令"
    },
    {
      "ordinal": 110,
      "start_ms": 255040,
      "end_ms": 256480,
      "text": "你也不会执行他的命令"
    },
    {
      "ordinal": 111,
      "start_ms": 256480,
      "end_ms": 257289,
      "text": "对不对"
    },
    {
      "ordinal": 112,
      "start_ms": 257289,
      "end_ms": 258829,
      "text": "你是奴才吗"
    },
    {
      "ordinal": 113,
      "start_ms": 258829,
      "end_ms": 260720,
      "text": "你是他鞭子下的畜生吗"
    },
    {
      "ordinal": 114,
      "start_ms": 260720,
      "end_ms": 262250,
      "text": "是不是你自己问一问"
    },
    {
      "ordinal": 115,
      "start_ms": 262250,
      "end_ms": 263030,
      "text": "问一问你自己"
    },
    {
      "ordinal": 116,
      "start_ms": 263030,
      "end_ms": 263630,
      "text": "你是奴才"
    },
    {
      "ordinal": 117,
      "start_ms": 263630,
      "end_ms": 264920,
      "text": "你是他鞭子下的畜生吗"
    },
    {
      "ordinal": 118,
      "start_ms": 264920,
      "end_ms": 265700,
      "text": "是吗"
    },
    {
      "ordinal": 119,
      "start_ms": 265700,
      "end_ms": 266570,
      "text": "不是呀"
    },
    {
      "ordinal": 120,
      "start_ms": 266570,
      "end_ms": 267980,
      "text": "你是我的奴才吗"
    },
    {
      "ordinal": 121,
      "start_ms": 267980,
      "end_ms": 269780,
      "text": "你是我鞭子下的畜生吗"
    },
    {
      "ordinal": 122,
      "start_ms": 269780,
      "end_ms": 271130,
      "text": "不是的呀"
    },
    {
      "ordinal": 123,
      "start_ms": 271130,
      "end_ms": 273560,
      "text": "是就是是不是就是不是"
    },
    {
      "ordinal": 124,
      "start_ms": 273560,
      "end_ms": 275970,
      "text": "他说的话跟你做的事情没有关系"
    },
    {
      "ordinal": 125,
      "start_ms": 275970,
      "end_ms": 279420,
      "text": "你遭遇到的事情也跟他说的话也没有关系"
    },
    {
      "ordinal": 126,
      "start_ms": 279420,
      "end_ms": 281340,
      "text": "跟他做的什么吊毛预测没有关系"
    },
    {
      "ordinal": 127,
      "start_ms": 281340,
      "end_ms": 283200,
      "text": "这两本来就不搭界的东西"
    },
    {
      "ordinal": 128,
      "start_ms": 283200,
      "end_ms": 285180,
      "text": "除非你是说自己做错了事"
    },
    {
      "ordinal": 129,
      "start_ms": 285180,
      "end_ms": 287179,
      "text": "要赖皮怪到别人身上去"
    },
    {
      "ordinal": 130,
      "start_ms": 287900,
      "end_ms": 288730,
      "text": "对不对"
    },
    {
      "ordinal": 131,
      "start_ms": 288730,
      "end_ms": 291060,
      "text": "自己拿到点好处"
    },
    {
      "ordinal": 132,
      "start_ms": 291060,
      "end_ms": 294030,
