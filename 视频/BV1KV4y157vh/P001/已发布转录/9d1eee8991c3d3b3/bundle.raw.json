{"segments":[{"start":0.0,"end":2.04,"text":"回应信件说可公开啊"},{"start":3.42,"end":4.44,"text":"未明子什么"},{"start":4.44,"end":4.92,"text":"您好"},{"start":4.92,"end":7.249,"text":"我有一个困惑了一段时间问题"},{"start":7.249,"end":9.229,"text":"希望您可以帮我开辟一个新思路或者骂我"},{"start":9.229,"end":10.009,"text":"我明显做错的"},{"start":11.569,"end":12.529,"text":"我先说下我的经历"},{"start":12.529,"end":13.97,"text":"以便您理解我的问题"},{"start":13.97,"end":15.05,"text":"我去年出生高"},{"start":15.05,"end":15.53,"text":"很幸运"},{"start":15.53,"end":17.39,"text":"是我们那个小县城里最好的高中"},{"start":17.39,"end":18.29,"text":"然后上高中后"},{"start":18.29,"end":19.97,"text":"我对自己实力严重失误啊"},{"start":19.97,"end":20.69,"text":"平板严重失误"},{"start":20.69,"end":22.44,"text":"在今历几次华丽落后"},{"start":22.44,"end":23.64,"text":"心态有所崩塌"},{"start":23.64,"end":25.5,"text":"同时大概是因为我不善于社交"},{"start":25.5,"end":25.92,"text":"不爱社交"},{"start":25.92,"end":27.74,"text":"我的同桌连带着周围人一起孤立我"},{"start":27.74,"end":28.7,"text":"关于我的不善于社交"},{"start":28.7,"end":29.3,"text":"就举个例子"},{"start":29.3,"end":30.68,"text":"把握短短15年的人生中"},{"start":30.68,"end":31.28,"text":"只有六个人"},{"start":31.28,"end":32.06,"text":"我可以与他交流"},{"start":32.06,"end":32.9,"text":"而不太厌烦"},{"start":32.9,"end":34.43,"text":"其中有两个是我的家人"},{"start":34.43,"end":35.51,"text":"因为以上的原因"},{"start":35.51,"end":38.459,"text":"我换上了一个新现代年轻人的常惯"},{"start":39.18,"end":40.34,"text":"毕竟你不是年轻人"},{"start":40.34,"end":41.44,"text":"你是小孩儿"},{"start":42.82,"end":44.76,"text":"才上初中高中"},{"start":44.76,"end":45.6,"text":"你是小孩"},{"start":45.6,"end":46.53,"text":"你不是年轻人"},{"start":46.53,"end":50.12,"text":"以为这从去年10月份到今年9月份"},{"start":50.12,"end":50.84,"text":"我休学了1年"},{"start":50.84,"end":51.8,"text":"在那段时间里"},{"start":54.86,"end":56.36,"text":"起床看吃饭"},{"start":56.36,"end":57.26,"text":"看小说睡觉"},{"start":57.26,"end":57.98,"text":"那就是我的一天"},{"start":57.98,"end":58.82,"text":"我厌恶那样自己"},{"start":58.82,"end":61.36,"text":"但那时的我不知道该做些什么"},{"start":64.34,"end":66.32,"text":"大概就是那时我有些无所谓了"},{"start":66.32,"end":67.76,"text":"我不在乎未来物质条件如何"},{"start":67.76,"end":69.08,"text":"我没有什么特别想学的"},{"start":70.36,"end":72.28,"text":"事情的转机发生在7月份左右"},{"start":72.28,"end":73.66,"text":"我喜欢上了一个动漫角色"},{"start":73.66,"end":75.74,"text":"喜欢他眼中的山川河流和无限自由"},{"start":75.74,"end":78.68,"text":"因为我最初的梦与他现在做的很是相像"},{"start":78.68,"end":79.88,"text":"于是我明确了我的前途"},{"start":79.88,"end":80.84,"text":"我要快乐的活着"},{"start":80.84,"end":81.74,"text":"想去环球旅行"},{"start":81.74,"end":84.06,"text":"必知道各地人文"},{"start":84.06,"end":85.32,"text":"找到三次元的太阳"},{"start":85.32,"end":87.06,"text":"再解释一下我自小听的故事"},{"start":87.06,"end":90.07,"text":"看的动漫里面最美的都是不为自己"},{"start":90.07,"end":91.15,"text":"只为理想之处"},{"start":91.15,"end":92.17,"text":"终年常青的人"},{"start":92.17,"end":95.34,"text":"因此我十分厌恶眼中只有六便士而无月亮的人"},{"start":95.82,"end":98.22,"text":"有月亮的人是有6万便士"},{"start":98.22,"end":101.02,"text":"6亿便士眼中就有月亮了"},{"start":106.72,"end":109.08,"text":"眼中没有六便士"},{"start":109.08,"end":113.1,"text":"或者眼中有的是六便士的匮乏的人"},{"start":113.1,"end":115.84,"text":"他们的眼睛本身就是月亮"},{"start":116.24,"end":117.41,"text":"听得懂吗"},{"start":117.41,"end":124.72,"text":"小朋友就是说盐里面有六便士的人和盐就是和真的有"},{"start":124.72,"end":126.7,"text":"有月亮的人都是垃圾"},{"start":128.02,"end":131.67,"text":"追求六便士或者已经有了六便士"},{"start":131.67,"end":133.2,"text":"已经有了月亮的人都是垃圾"},{"start":133.2,"end":133.98,"text":"已经有月亮的人"},{"start":138.749,"end":140.44,"text":"擦脂抹粉"},{"start":142.999,"end":145.779,"text":"对于六遍是孜孜以求的人"},{"start":145.779,"end":146.439,"text":"分两种"},{"start":146.439,"end":148.179,"text":"一种呢它是小私人阶级"},{"start":148.179,"end":152.13,"text":"还有一种他的生活匮乏"},{"start":152.13,"end":154.47,"text":"也就是说被生产就是他的劳动"},{"start":154.47,"end":157.02,"text":"劳动果实被剥夺六块钱"},{"start":157.02,"end":158.06,"text":"他也舍不得"},{"start":158.54,"end":161.06,"text":"他的眼里面不是说有六便士"},{"start":161.06,"end":165.43,"text":"而是他眼里面充满了对于六便士匮乏的恐惧"},{"start":165.43,"end":167.8,"text":"这些人的眼睛就是月亮"},{"start":175.09,"end":177.68,"text":"就是人类的月亮"},{"start":178.899,"end":179.699,"text":"小朋友"},{"start":179.699,"end":180.719,"text":"你是这个高中生"},{"start":180.719,"end":182.