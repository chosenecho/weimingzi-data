{
  "bvid": "BV1oT411M7KY",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "d62a75d624be68e237ae18567b4975dec70dc19bfd6b47e8486e3a25d913da4a",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 780,
      "end_ms": 2280,
      "text": "回应一个信件啊"
    },
    {
      "ordinal": 1,
      "start_ms": 2280,
      "end_ms": 4620,
      "text": "他连我的名字一开始写错了"
    },
    {
      "ordinal": 2,
      "start_ms": 4620,
      "end_ms": 5920,
      "text": "后面改正了"
    },
    {
      "ordinal": 3,
      "start_ms": 8660,
      "end_ms": 10480,
      "text": "他的名字叫埃尼亚克"
    },
    {
      "ordinal": 4,
      "start_ms": 10480,
      "end_ms": 12660,
      "text": "零二高中辍学"
    },
    {
      "ordinal": 5,
      "start_ms": 13680,
      "end_ms": 16059,
      "text": "然后彻底不上学了"
    },
    {
      "ordinal": 6,
      "start_ms": 16620,
      "end_ms": 19130,
      "text": "他父亲是人力资源总监"
    },
    {
      "ordinal": 7,
      "start_ms": 19130,
      "end_ms": 20560,
      "text": "屁股特别歪"
    },
    {
      "ordinal": 8,
      "start_ms": 20800,
      "end_ms": 23350,
      "text": "对李鸿章还持证明观点"
    },
    {
      "ordinal": 9,
      "start_ms": 23350,
      "end_ms": 26920,
      "text": "然后他一直跟他父亲有理论之争"
    },
    {
      "ordinal": 10,
      "start_ms": 31400,
      "end_ms": 35239,
      "text": "说他他和他母亲都是他父亲的一个牺牲品啊"
    },
    {
      "ordinal": 11,
      "start_ms": 35640,
      "end_ms": 38220,
      "text": "人力资源总监h2 d"
    },
    {
      "ordinal": 12,
      "start_ms": 43350,
      "end_ms": 44800,
      "text": "祸及妻子"
    },
    {
      "ordinal": 13,
      "start_ms": 45980,
      "end_ms": 49240,
      "text": "这个孩子书都没办法正常念下去"
    },
    {
      "ordinal": 14,
      "start_ms": 50440,
      "end_ms": 54519,
      "text": "精神病理化具体是什么我就不说了"
    },
    {
      "ordinal": 15,
      "start_ms": 56440,
      "end_ms": 57660,
      "text": "但是他自认哦"
    },
    {
      "ordinal": 16,
      "start_ms": 57660,
      "end_ms": 61710,
      "text": "他自认我这个他我也不知道他有没有确诊"
    },
    {
      "ordinal": 17,
      "start_ms": 61710,
      "end_ms": 63300,
      "text": "跟我没关系"
    },
    {
      "ordinal": 18,
      "start_ms": 69570,
      "end_ms": 70890,
      "text": "就是他父亲"
    },
    {
      "ordinal": 19,
      "start_ms": 70890,
      "end_ms": 73440,
      "text": "他父亲是个会施加冷暴力的"
    },
    {
      "ordinal": 20,
      "start_ms": 73440,
      "end_ms": 75270,
      "text": "一个是一个心理学大师"
    },
    {
      "ordinal": 21,
      "start_ms": 75270,
      "end_ms": 76880,
      "text": "跟他一块生活了"
    },
    {
      "ordinal": 22,
      "start_ms": 76920,
      "end_ms": 78540,
      "text": "那我对你的建议呢"
    },
    {
      "ordinal": 23,
      "start_ms": 78540,
      "end_ms": 79440,
      "text": "就是说"
    },
    {
      "ordinal": 24,
      "start_ms": 83400,
      "end_ms": 86360,
      "text": "他说他和对人工智能和哲学感兴趣"
    },
    {
      "ordinal": 25,
      "start_ms": 86360,
      "end_ms": 88040,
      "text": "对两者融合更感兴趣"
    },
    {
      "ordinal": 26,
      "start_ms": 88040,
      "end_ms": 88880,
      "text": "希望我能回血"
    },
    {
      "ordinal": 27,
      "start_ms": 88880,
      "end_ms": 91440,
      "text": "我觉得你不要管什么人工智能和哲学"
    },
    {
      "ordinal": 28,
      "start_ms": 91440,
      "end_ms": 93180,
      "text": "请你出去工作"
    },
    {
      "ordinal": 29,
      "start_ms": 93180,
      "end_ms": 95080,
      "text": "打零工也好"
    },
    {
      "ordinal": 30,
      "start_ms": 97420,
      "end_ms": 101460,
      "text": "甚至说在我看来最坏的选项去电子厂工作"
    },
    {
      "ordinal": 31,
      "start_ms": 101460,
      "end_ms": 103030,
      "text": "无论如何呢"
    },
    {
      "ordinal": 32,
      "start_ms": 103030,
      "end_ms": 104530,
      "text": "找个办法去工作"
    },
    {
      "ordinal": 33,
      "start_ms": 104530,
      "end_ms": 105310,
      "text": "参与劳动"
    },
    {
      "ordinal": 34,
      "start_ms": 105310,
      "end_ms": 108759,
      "text": "摆脱你对于你父亲的寄生关系"
    },
    {
      "ordinal": 35,
      "start_ms": 110160,
      "end_ms": 111770,
      "text": "去在劳动当中"
    },
    {
      "ordinal": 36,
      "start_ms": 111770,
      "end_ms": 115160,
      "text": "他说自己没有傍一一击傍身"
    },
    {
      "ordinal": 37,
      "start_ms": 119700,
      "end_ms": 120720,
      "text": "制造业为主"
    },
    {
      "ordinal": 38,
      "start_ms": 120720,
      "end_ms": 121800,
      "text": "无论如何"
    },
    {
      "ordinal": 39,
      "start_ms": 121800,
      "end_ms": 123300,
      "text": "你去做学徒也好"
    },
    {
      "ordinal": 40,
      "start_ms": 123300,
      "end_ms": 125899,
      "text": "去从事任何工作去做"
    },
    {
      "ordinal": 41,
      "start_ms": 126100,
      "end_ms": 128289,
      "text": "你去好好先攒一笔钱"
    },
    {
      "ordinal": 42,
      "start_ms": 128289,
      "end_ms": 131939,
      "text": "然后去给人家做代驾啊"
    },
    {
      "ordinal": 43,
      "start_ms": 131939,
      "end_ms": 133379,
      "text": "或者说弄个电瓶车"
    },
    {
      "ordinal": 44,
      "start_ms": 133379,
      "end_ms": 134099,
      "text": "甚至再拖一点"
    },
    {
      "ordinal": 45,
      "start_ms": 134099,
      "end_ms": 136289,
      "text": "用电瓶车去跑外卖"
    },
    {
      "ordinal": 46,
      "start_ms": 136289,
      "end_ms": 137099,
      "text": "无论如何"
    },
    {
      "ordinal": 47,
      "start_ms": 137099,
      "end_ms": 139280,
      "text": "先用你的劳动养活你自己"
    },
    {
      "ordinal": 48,
      "start_ms": 139380,
      "end_ms": 141860,
      "text": "摆脱你对你父亲的依赖"
    },
    {
      "ordinal": 49,
      "start_ms": 142719,
      "end_ms": 144359,
      "text": "外面去更加合租一个"
    },
    {
      "ordinal": 50,
      "start_ms": 144359,
      "end_ms": 145379,
      "text": "或者租个宿舍"
    },
    {
      "ordinal": 51,
      "start_ms": 145379,
      "end_ms": 146729,
      "text": "几百块钱一个月"
    },
    {
      "ordinal": 52,
      "start_ms": 146729,
      "end_ms": 148469,
      "text": "自己过自己的日子"
    },
    {
      "ordinal": 53,
      "start_ms": 148469,
      "end_ms": 150299,
      "text": "你母亲是怎样的话"
    },
    {
      "ordinal": 54,
      "start_ms": 150299,
      "end_ms": 154679,
      "text": "某种意义上讲是你可以努力去救他"
    },
    {
      "ordinal": 55,
      "start_ms": 155879,
      "end_ms": 158900,
      "text": "但他他自己对他自己的生活难道没有责任吗"
    },
    {
      "ordinal": 56,
      "start_ms": 159939,
      "end_ms": 162959,
      "text": "你不要说你无法忍受一个和你有对意识信赖的"
    },
    {
      "ordinal": 57,
      "start_ms": 162959,
      "end_ms": 164879,
      "text": "人什么什么什么一块生活"
    },
    {
      "ordinal": 58,
      "start_ms": 164879,
      "end_ms": 165959,
      "text": "那你就你无法忍受"
    },
    {
      "ordinal": 59,
      "start_ms": 165959,
      "end_ms": 166949,
      "text": "你不要忍受啊"
    },
    {
      "ordinal": 60,
      "start_ms": 166949,
      "end_ms": 168059,
      "text": "请你出去工作"
    },
    {
      "ordinal": 61,
      "start_ms": 168059,
      "end_ms": 169020,
      "text": "出去劳动"
    },
    {
      "ordinal": 62,
      "start_ms": 169140,
      "end_ms": 170580,
      "text": "从今天开始"
    },
    {
      "ordinal": 63,
      "start_ms": 170580,
      "end_ms": 175820,
      "text": "不要一天到晚在依赖于你的父亲啊"
    },
    {
      "ordinal": 64,
      "start_ms": 175820,
      "end_ms": 178520,
      "text": "你反正你你可以有个过渡期"
    },
    {
      "ordinal": 65,
      "start_ms": 178520,
      "end_ms": 180440,
      "text": "比如说这三个月你还在家里面吃饭"
    },
    {
      "ordinal": 66,
      "start_ms": 180440,
      "end_ms": 182600,
      "text": "你还要在家里面睡觉养着你"
    },
    {
      "ordinal": 67,
      "start_ms": 182600,
      "end_ms": 185220,
      "text": "但是三个月三个月过程当中"
    },
    {
      "ordinal": 68,
      "start_ms": 185220,
      "end_ms": 187140,
      "text": "请你比如说花两个星期"
    },
    {
      "ordinal": 69,
      "start_ms": 187140,
      "end_ms": 189280,
      "text": "花一个星期去找工作"
    },
    {
      "ordinal": 70,
      "start_ms": 189280,
      "end_ms": 190400,
      "text": "好好找"
    },
    {
      "ordinal": 71,
      "start_ms": 192279,
      "end_ms": 193589,
      "text": "跟你父亲协商"
    },
    {
      "ordinal": 72,
      "start_ms": 193589,
      "end_ms": 194819,
      "text": "跟你父亲好好聊"
    },
    {
      "ordinal": 73,
      "start_ms": 194819,
      "end_ms": 195680,
      "text": "好好谈"
    },
    {
      "ordinal": 74,
      "start_ms": 196380,
      "end_ms": 197660,
      "text": "你到底要怎么活"
    },
    {
      "ordinal": 75,
      "start_ms": 197660,
      "end_ms": 201980,
      "text": "怎么过这个日子你自己好好想一想"
    },
    {
      "ordinal": 76,
      "start_ms": 201980,
      "end_ms": 203280,
      "text": "你跟哲学"
    },
    {
      "ordinal": 77,
      "start_ms": 204899,
      "end_ms": 206809,
      "text": "哲学是第一生活方式"
    },
    {
      "ordinal": 78,
      "start_ms": 206809,
      "end_ms": 208819,
      "text": "你现在没有任何资格主张"
    },
    {
      "ordinal": 79,
      "start_ms": 208819,
      "end_ms": 210499,
      "text": "你可以过你自己想要的生活"
    },
    {
      "ordinal": 80,
      "start_ms": 210499,
      "end_ms": 211939,
      "text": "你完全是依附性的"
    },
    {
      "ordinal": 81,
      "start_ms": 211939,
      "end_ms": 213680,
      "text": "完全只是你父亲的"
    },
    {
      "ordinal": 82,
      "start_ms": 215059,
      "end_ms": 219279,
      "text": "你父亲的肉体和精神的延伸"
    },
    {
      "ordinal": 83,
      "start_ms": 220359,
      "end_ms": 222120,
      "text": "也不知道是不是人工智能的"
    },
    {
      "ordinal": 84,
      "start_ms": 222860,
      "end_ms": 226420,
      "text": "你的意思难道不是你父母的家庭环境催生出来的"
    },
    {
      "ordinal": 85,
      "start_ms": 226420,
      "end_ms": 230650,
      "text": "你就是一个猴子的身体里面培养出来的一个人工智能"
    },
    {
      "ordinal": 86,
      "start_ms": 231910,
      "end_ms": 234850,
      "text": "把你生长出来的一个人工智能催生出来的"
    },
    {
      "ordinal": 87,
      "start_ms": 234850,
      "end_ms": 240180,
      "text": "我觉得你先不要专题化的去思考人工智能和哲学"
    },
    {
      "ordinal": 88,
      "start_ms": 240180,
      "end_ms": 242460,
      "text": "也不要去思考他们两者的融合"
    },
    {
      "ordinal": 89,
      "start_ms": 242500,
      "end_ms": 247000,
      "text": "你必须这是一个这是一个你自己应该意识到"
    },
    {
      "ordinal": 90,
      "start_ms": 247000,
      "end_ms": 247480,
      "text": "这是一个"
    },
    {
      "ordinal": 91,
      "start_ms": 247480,
      "end_ms": 248540,
      "text": "必须的"
    },
    {
      "ordinal": 92,
      "start_ms": 251839,
      "end_ms": 256269,
      "text": "你必须不再依赖你父亲吃饭和睡觉"
    },
    {
      "ordinal": 93,
      "start_ms": 256269,
      "end_ms": 262879,
      "text": "你的住所居所和你的食物应当靠你自己去找到"
    },
    {
      "ordinal": 94,
      "start_ms": 262879,
      "end_ms": 265069,
      "text": "也就是说你必须离开这个家了"
    },
    {
      "ordinal": 95,
      "start_ms": 265069,
      "end_ms": 265729,
      "text": "你成年了"
    },
    {
      "ordinal": 96,
      "start_ms": 265729,
      "end_ms": 267060,
      "text": "满18岁了"
    },
    {
      "ordinal": 97,
      "start_ms": 267159,
      "end_ms": 271180,
      "text": "18岁高中就辍学了"
    },
    {
      "ordinal": 98,
      "start_ms": 272000,
      "end_ms": 273740,
      "text": "字都写不连签"
    },
    {
      "ordinal": 99,
      "start_ms": 274520,
      "end_ms": 275920,
      "text": "刚刚一封信"
    },
    {
      "ordinal": 100,
      "start_ms": 275920,
      "end_ms": 279960,
      "text": "一个高一的他家里面情况也不乐观"
    },
    {
      "ordinal": 101,
      "start_ms": 281540,
      "end_ms": 282460,
      "text": "他母亲的话"
    },
    {
      "ordinal": 102,
      "start_ms": 282460,
      "end_ms": 284200,
      "text": "他是直接是精神病理化的"
    },
    {
      "ordinal": 103,
      "start_ms": 284200,
      "end_ms": 286540,
      "text": "他母亲情况比你不乐观"
    },
    {
      "ordinal": 104,
      "start_ms": 286900,
      "end_ms": 294180,
      "text": "他爸可能就是还不如管他河南省的那个生存环境更激烈"
    },
    {
      "ordinal": 105,
      "start_ms": 294180,
      "end_ms": 300559,
      "text": "但是他愿意去去去去去去训练他自己训练他"
    },
    {
      "ordinal": 106,
      "start_ms": 300559,
      "end_ms": 302629,
      "text": "至少他他不至于辍学"
    },
    {
      "ordinal": 107,
      "start_ms": 302629,
      "end_ms": 306300,
      "text": "至少他高中还能够强迫自己能够读下来"
    },
    {
      "ordinal": 108,
      "start_ms": 308639,
      "end_ms": 310099,
      "text": "现在有高中可上"
    },
    {
      "ordinal": 109,
      "start_ms": 312320,
      "end_ms": 313160,
      "text": "你有高中"
    },
    {
      "ordinal": 110,
      "start_ms": 313160,
      "end_ms": 314450,
      "text": "你还辍学"
    },
    {
      "ordinal": 111,
      "start_ms": 314450,
      "end_ms": 316280,
      "text": "这就有点可耻了"
    },
    {
      "ordinal": 112,
      "start_ms": 316280,
      "end_ms": 316760,
      "text": "实事求是"
    },
    {
      "ordinal": 113,
      "start_ms": 316760,
      "end_ms": 319099,
      "text": "这你有受教育机会"
    },
    {
      "ordinal": 114,
      "start_ms": 319099,
      "end_ms": 320239,
      "text": "你不珍惜"
    },
    {
      "ordinal": 115,
      "start_ms": 324679,
      "end_ms": 327120,
      "text": "让那些让那些更更废的人"
    },
    {
      "ordinal": 116,
      "start_ms": 327360,
      "end_ms": 330930,
      "text": "但我不知道你是不是就已经是比较废的人了"
    },
    {
      "ordinal": 117,
      "start_ms": 330930,
      "end_ms": 335739,
      "text": "我只能说归根结底要怪谁啊"
    },
    {
      "ordinal": 118,
      "start_ms": 337599,
      "end_ms": 338679,
      "text": "不要怪社会吗"
    },
    {
      "ordinal": 119,
      "start_ms": 338679,
      "end_ms": 340820,
      "text": "哎要怪什么呢"
    },
    {
      "ordinal": 120,
      "start_ms": 343850,
      "end_ms": 345800,
      "text": "不要总想着去责备"
    },
    {
      "ordinal": 121,
      "start_ms": 345800,
      "end_ms": 347480,
      "text": "去怪去to blame"
    },
    {
      "ordinal": 122,
      "start_ms": 347480,
      "end_ms": 348080,
      "text": "no"
    },
    {
      "ordinal": 123,
      "start_ms": 348360,
      "end_ms": 350460,
      "text": "不要做一个责责备者"
    },
    {
      "ordinal": 124,
      "start_ms": 350460,
      "end_ms": 351060,
      "text": "责怪者"
    },
    {
      "ordinal": 125,
      "start_ms": 351060,
      "end_ms": 352020,
      "text": "甩锅的"
    },
    {
      "ordinal": 126,
      "start_ms": 352020,
      "end_ms": 353820,
      "text": "你先看看你自己"
    },
    {
      "ordinal": 127,
      "start_ms": 356660,
      "end_ms": 358550,
      "text": "不想和他一块生活"
    },
    {
      "ordinal": 128,
      "start_ms": 358550,
      "end_ms": 361350,
      "text": "你想办法你想办法呀"
    },
    {
      "ordinal": 129,
      "start_ms": 361350,
      "end_ms": 362670,
      "text": "你想办法呀"
    },
    {
      "ordinal": 130,
      "start_ms": 362670,
      "end_ms": 363060,
      "text": "你去"
    },
    {
      "ordinal": 131,
      "start_ms": 363060,
      "end_ms": 363690,
      "text": "做呀"
    },
    {
      "ordinal": 132,
      "start_ms": 363690,
      "end_ms": 365520,
      "text": "你鞋子穿袜子穿"
    },
    {
      "ordinal": 133,
      "start_ms": 365520,
      "end_ms": 366900,
      "text": "你今天吃饱饭了"
    },
    {
      "ordinal": 134,
