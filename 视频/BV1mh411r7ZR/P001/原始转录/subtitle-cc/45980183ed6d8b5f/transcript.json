      "ordinal": 153,
      "start_ms": 690400,
      "end_ms": 691575,
      "text": "大他者也可以说"
    },
    {
      "ordinal": 154,
      "start_ms": 691650,
      "end_ms": 692650,
      "text": "因此这个大他者"
    },
    {
      "ordinal": 155,
      "start_ms": 692675,
      "end_ms": 694950,
      "text": "这个符号学秩序A的化身就可以说"
    },
    {
      "ordinal": 156,
      "start_ms": 695300,
      "end_ms": 700950,
      "text": "我也是有超越"
    },
    {
      "ordinal": 157,
      "start_ms": 701275,
      "end_ms": 705925,
      "text": "就我也是有外部保障的"
    },
    {
      "ordinal": 158,
      "start_ms": 705975,
      "end_ms": 707975,
      "text": "我也是有外部保障的"
    },
    {
      "ordinal": 159,
      "start_ms": 707975,
      "end_ms": 708800,
      "text": "你了解吗"
    },
    {
      "ordinal": 160,
      "start_ms": 708800,
      "end_ms": 711300,
      "text": "就是说 一般的他者 1、2、3"
    },
    {
      "ordinal": 161,
