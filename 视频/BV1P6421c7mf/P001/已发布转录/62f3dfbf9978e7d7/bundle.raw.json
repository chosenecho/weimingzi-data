{"segments":[{"start":0.16,"end":6.34,"text":"呃我们直接来说结论就是呃那个"},{"start":7.78,"end":10.23,"text":"未成年人作恶的这个事儿啊"},{"start":10.23,"end":14.969,"text":"那么这个事简短说一下结论就是邪恶确实存在"},{"start":14.969,"end":19.109,"text":"而邪恶会以某种方式逃脱惩罚"},{"start":19.64,"end":22.96,"text":"呃但是呢"},{"start":24.4,"end":27.18,"text":"你又不能一刀切啊"},{"start":27.18,"end":28.71,"text":"但是你又不能一刀切"},{"start":28.71,"end":35.16,"text":"因为呃对于这种未成年人的这种豁免"},{"start":36.6,"end":44.42,"text":"也是在防止成年人对未成年人的伤害太过度了"},{"start":45.02,"end":47.74,"text":"作为一个总体未成年人"},{"start":47.74,"end":51.04,"text":"需要这样的豁免形式上的这样豁免"},{"start":51.04,"end":54.48,"text":"来确保他们不受到啊"},{"start":54.48,"end":62.5,"text":"不受到成年人以及他的同龄人的戕害"},{"start":63.71,"end":67.89,"text":"主要是啊对于这个成年人"},{"start":68.65,"end":71.37,"text":"比如说被这个父母虐待"},{"start":71.37,"end":75.3,"text":"或者被这个族亲虐待的过头的"},{"start":75.3,"end":77.94,"text":"那么未成年人可以以某种方式"},{"start":77.94,"end":80.1,"text":"比较极端的方式啊"},{"start":80.32,"end":83.22,"text":"要去维护他的利益"},{"start":86.5,"end":91.47,"text":"所以这个法律我认为主要是他的目的"},{"start":91.47,"end":95.16,"text":"还是是让这个力量对比啊"},{"start":95.16,"end":100.21,"text":"倾向于在法律上给未成年人一种保护吧"},{"start":100.43,"end":103.94,"text":"但是你为了给这么一重保护"},{"start":103.94,"end":108.11,"text":"必然有的邪恶他会逃脱相应的制裁"},{"start":108.11,"end":111.8,"text":"逃脱相应的法网啊"},{"start":111.8,"end":113.57,"text":"那么这种邪恶它存在"},{"start":114.65,"end":117.65,"text":"那这是代价啊"},{"start":117.65,"end":121.04,"text":"这是你为了提供供给一种正义"},{"start":121.04,"end":124.49,"text":"那你就得容忍相应的这种邪恶的存在"},{"start":124.49,"end":127.44,"text":"但说我们并不是完全无能为力的"},{"start":127.44,"end":129.3,"text":"不是完全无能为力的"},{"start":130.74,"end":134.119,"text":"比如说对这些人严加监视啊"},{"start":134.119,"end":139.339,"text":"只要有一个强而有力的公共的监管体系"},{"start":139.339,"end":140.509,"text":"治安力量"},{"start":140.509,"end":143.13,"text":"那么这些人是可以严加监视的"},{"start":143.13,"end":144.09,"text":"那么这些人"},{"start":144.09,"end":149.02,"text":"他的人生的每一天都确保是受到良心的谴责"},{"start":149.02,"end":150.61,"text":"是受到折磨的"},{"start":150.61,"end":151.96,"text":"是很痛苦的"},{"start":151.96,"end":154.54,"text":"那么我觉得在这个意义上讲呃"},{"start":154.54,"end":155.65,"text":"判判死刑"},{"start":155.65,"end":158.08,"text":"只要社会能够持续地给压力"},{"start":158.08,"end":160.3,"text":"让他感到痛苦痛苦一辈子"},{"start":160.3,"end":161.65,"text":"这个最俗赎不掉的"},{"start":161.65,"end":162.19,"text":"实事求是讲"},{"start":162.19,"end":162.79,"text":"这样的邪恶"},{"start":162.79,"end":165.079,"text":"这种罪是赎不掉的"},{"start":165.079,"end":166.279,"text":"输不了的"},{"start":166.279,"end":168.29,"text":"除非他用生命"},{"start":168.29,"end":170.51,"text":"他也献出生命啊"},{"start":170.51,"end":174.11,"text":"为了维护某某个弱势群体啊"},{"start":174.11,"end":179.61,"text":"那么而且是也以一个比他做出这些恶"},{"start":179.61,"end":180.75,"text":"更为惨烈的"},{"start":180.75,"end":181.53,"text":"更为惨烈的"},{"start":181.53,"end":182.76,"text":"更为难以承受的"},{"start":182.76,"end":183.99,"text":"加倍的多的"},{"start":183.99,"end":187.16,"text":"那么你说是除掉他的罪孽呢"},{"start":187.16,"end":188.12,"text":"我认为不至于"},{"start":188.12,"end":190.39,"text":"但是至少让这个灵魂"},{"start":190.39,"end":193.69,"text":"他面对他的这在牺牲奉献的时候"},{"start":193.69,"end":195.93,"text":"我假如说他真的要赎罪的话"},{"start":195.93,"end":198.09,"text":"他面对他的终结的时候"},{"start":198.09,"end":199.98,"text":"他有一丝喘息"},{"start":199.98,"end":203.61,"text":"那么这种东西不能强迫他去做啊"},{"start":203.61,"end":205.79,"text":"不能强迫他们去做"},{"start":206.13,"end":206.87,"text":"你再说"},{"start":206.87,"end":209.75,"text":"万一他真的是成就了这些"},{"start":209.75,"end":215.51,"text":"也就是说我的观点是社会有社会的义务"},{"start":215.51,"end":218.51,"text":"持续的对这些人进行道德负面评价"},{"start":218.51,"end":221.569,"text":"盯着他们国家有国家的义务啊"},{"start":221.569,"end":224.32,"text":"在这个法律上啊"},{"start":224.66,"end":226.18,"text":"这些人都要通通建党"},{"start":226.18,"end":228.19,"text":"打入建立档案"},{"start":228.19,"end":229.06,"text":"打入另册"},{"start":230.2,"end":232.86,"text":"持续地对他们加以监控"},{"start":239.18,"end":241.81,"text":"还有一个重要的一个结论呢"},{"start":241.81,"end":243.49,"text":"你们要始终知道"},{"start":243.49,"end":245.86,"text":"现实当中就是有这样的邪恶"},{"start":245.86,"end":246.769,"text":"它存在"},{"start":246.769,"end":249.379,"text":"他在破坏基本秩序"},{"start":249.379,"end":251.41,"text":"他在伤害无辜者"},{"start":251.41,"end":253.0,"text":"这种邪恶确实存在"},{"start":253.0,"end":256.57,"text":"而且他是一个这样的方式在伪装着的存在"},{"start":256.57,"end":260.159,"text":"它不会直接的就是直接的就是邪恶啊"},{"start":260.159,"end":264.11,"text":"直接它是以伪装出来的形式存在的"},{"start":264.379,"end":268.52,"text":"那我们对于这些邪恶呃"},{"start":268.52,"end":270.95,"text":"它有它产生的土壤和根源啊"},{"start":270.95,"end":274.86,"text":"它有它产生的土壤和根源啊"},{"start":274.86,"end":276.69,"text":"当然有其产生的土壤和规律"},{"start":276.69,"end":280.37,"text":"但是并不是所有留守儿童都做这些极端的事情"},{"start":280.37,"end":282.35,"text":"主观的恶当然是存在的"},{"start":282.35,"end":286.43,"text":"主观的邪恶当然是里面的关键因素"},{"start":287.62,"end":296.069,"text":"呃我们不想把这种呃有直接承受责任的"},{"start":296.069,"end":301.16,"text":"主观要素的这样的形式问题"},{"start":301.16,"end":302.96,"text":"统统说成是个结构性的问题"},{"start":302.96,"end":303.5,"text":"给他脱罪"},{"start":303.5,"end":304.43,"text":"我们不给他脱罪"},{"start":304.43,"end":306.5,"text":"就是罪恶就是罪恶"},{"start":306.5,"end":310.92,"text":"而且我们的建议就是治安力量啊"},{"start":310.92,"end":313.53,"text":"永远盯着他们社会评价"},{"start":313.53,"end":314.88,"text":"永远给他负面评价"},{"start":314.88,"end":317.05,"text":"让他们一辈子受良心的折磨"},{"start":317.05,"end":319.09,"text":"一辈子承受极大的痛苦"},{"start":319.09,"end":321.13,"text":"精神上的极大的痛苦"},{"start":321.13,"end":324.01,"text":"我觉得一个比较好的就是诛心啊"},{"start":324.01,"end":324.79,"text":"一直住他们的心"},{"start":324.79,"end":325.909,"text":"让他们早夭"},{"start":325.909,"end":328.369,"text":"让他们就是说睡觉睡不着"},{"start":328.369,"end":331.12,"text":"非常疯狂折磨啊"},{"start":331.12,"end":333.7,"text":"那这是需要社会的整体的公众舆论的"},{"start":335.92,"end":340.819,"text":"啊我比较担心的就是3分钟热度诶"},{"start":340.819,"end":344.21,"text":"拿来吃人血馒头啊"},{"start":344.21,"end":345.68,"text":"显得自己批评他一下"},{"start":345.68,"end":346.88,"text":"显得自己义愤填膺"},{"start":346.88,"end":348.77,"text":"或者怎么样的"},{"start":352.26,"end":355.16,"text":"但是市民社会好像就是有这么一个倾向"},{"start":355.16,"end":356.09,"text":"3分钟热度"},{"start":356.09,"end":358.19,"text":"忘了之后就不管了"},{"start":358.19,"end":361.43,"text":"他完全只是有的一些居心叵测的人"},{"start":361.43,"end":362.09,"text":"拿这些议题"},{"start":362.09,"end":366.87,"text":"就是纯粹是给这个啊这个治安力量施压的"},{"start":366.87,"end":371.35,"text":"或者是给这给整个这个社会治理力量施压的"},{"start":371.35,"end":373.6,"text":"那就没什么好说的"},{"start":373.6,"end":376.16,"text":"我们讲的邪恶一直存在"},{"start":376.16,"end":378.74,"text":"而且邪恶往往扮演成正义的样子"},{"start":378.74,"end":381.75,"text":"扮演成好像是某种无辜的样子啊"},{"start":381.75,"end":384.03,"text":"不是说他一直能够扮演成正义的样子"},{"start":384.03,"end":387.37,"text":"有的时候他能够扮演成这个无辜的样子"},{"start":387.71,"end":390.13,"text":"那么结论就是我一直在说"},{"start":390.13,"end":392.59,"text":"结论就是所以真正的结论是什么"},{"start":392.59,"end":395.76,"text":"真正的结论就是永远不能停止战斗"},{"start":395.76,"end":397.95,"text":"防御性的战斗也是战斗"},{"start":397.95,"end":403.17,"text":"永远不能停止锻炼自己的防御性的战斗力量"},{"start":403.17,"end":405.29,"text":"每一个个体啊"},{"start":405.29,"end":407.27,"text":"比如说作为成年人"},{"start":407.27,"end":411.56,"text":"成年人你得锻炼身体啊"},{"start":411.56,"end":415.64,"text":"你得就是说对于一些防御性的手段啊"},{"start":415.64,"end":418.62,"text":"在受到不法侵害的时候"},{"start":418.62,"end":421.38,"text":"你必须去掌握这些防御性的手段"},{"start":421.38,"end":425.39,"text":"尤其是直接设计你的人身安危的"},{"start":425.79,"end":431.33,"text":"我是一个始终处在一个被威胁状态的个体"},{"start":431.33,"end":433.17,"text":"我本人啊"},{"start":433.17,"end":434.73,"text":"我被很多人威胁啊"},{"start":434.73,"end":438.91,"text":"被很多人这个以各种方式在迫害伤害"},{"start":438.91,"end":440.65,"text":"严重的破坏严重的伤害"},{"start":440.65,"end":444.119,"text":"那么出于一些保密的义务"},{"start":444.119,"end":444.959,"text":"我不能把它"},{"start":444.959,"end":448.87,"text":"把这些东西暴暴露到这个公开平台上"},{"start":448.87,"end":451.33,"text":"所以我我我始终知道就恶人存在"},{"start":451.33,"end":452.62,"text":"邪恶的人存在啊"},{"start":452.62,"end":454.75,"text":"肮脏的卑劣的啊"},{"start":454.75,"end":456.32,"text":"直接用这些手段"},{"start":457.26,"end":459.11,"text":"这个暗箭伤人的"},{"start":459.11,"end":461.0,"text":"甚至说用极端暴力手段"},{"start":461.0,"end":464.12,"text":"极端的一些罪恶的手段来迫害"},{"start":464.12,"end":466.07,"text":"加害于无辜者的人"},{"start":466.07,"end":470.03,"text":"有的事有的事永远不要放弃"},{"start":470.03,"end":473.84,"text":"锻炼你自己的防御性的战斗力量啊"},{"start":473.84,"end":475.52,"text":"永远不要放弃这一点"},{"start":475.52,"end":476.84,"text":"作为个体"},{"start":476.84,"end":479.33,"text":"你的体力脑力勇气"},{"start":479.33,"end":479.87,"text":"意志力"},{"start":479.87,"end":481.07,"text":"耐力啊"},{"start":481.07,"end":482.03,"text":"耐心"},{"start":482.03,"end":486.07,"text":"还有就是说与敌人缠斗的这种意愿"},{"start":486.07,"end":487.72,"text":"都要一直保有着"},{"start":487.72,"end":488.71,"text":"另外一方面"},{"start":488.71,"end":491.14,"text":"作为群体没有学会抱团"},{"start":491.14,"end":492.61,"text":"学会相互支持"},{"start":492.61,"end":493.33,"text":"相互鼓励"},{"start":493.33,"end":495.47,"text":"相互理解啊"},{"start":495.47,"end":499.04,"text":"在根本价值的同样的一个认同上"},{"start":499.04,"end":500.24,"text":"认同基础之上"},{"start":500.24,"end":507.41,"text":"相互之间保有一个啊保护啊的一个支撑的"},{"start":507.41,"end":511.01,"text":"一个共同的职责"},{"start":511.94,"end":515.07,"text":"这是现实的问题啊"},{"start":515.07,"end":516.57,"text":"这是一个现实的问题"},{"start":516.57,"end":519.659,"text":"这不是你们头脑当中虚幻的一个东西"},{"start":519.659,"end":521.01,"text":"这是现实的"},{"start":521.01,"end":523.779,"text":"这不是头脑中虚幻的东西啊"},{"start":523.779,"end":526.24,"text":"头脑中虚幻的个体"},{"start":526.76,"end":530.98,"text":"就会把这些东西统统当成某种情绪滋养"},{"start":530.98,"end":531.94,"text":"情绪滋长"},{"start":531.94,"end":536.44,"text":"情绪发泄不满的一种餐食"},{"start":537.46,"end":540.09,"text":"甚至某种饮品啊"},{"start":540.09,"end":542.849,"text":"刺激性的点缀性的饮品"},{"start":542.849,"end":545.069,"text":"看到这种新闻就像喝了烈酒一样"},{"start":545.069,"end":547.229,"text":"然后就发疯是吧"},{"start":547.229,"end":549.52,"text":"这个我觉得是没有意义的"},{"start":549.52,"end":551.23,"text":"我觉得没有意义啊"},{"start":551.23,"end":552.76,"text":"比如说你看到这些新闻之后"},{"start":552.76,"end":555.92,"text":"你能够坚持锻炼身体耐力"},{"start":555.92,"end":557.39,"text":"肌肉爆发力啊"},{"start":557.39,"end":560.69,"text":"这个这个一定的自我防备的啊"},{"start":560.69,"end":563.29,"text":"一些力量性的支撑"},{"start":563.29,"end":566.95,"text":"我不说武力性支撑防御性的逃避性的逃跑"},{"start":566.95,"end":568.03,"text":"你也跑得快吧"},{"start":568.03,"end":569.29,"text":"对不对啊"},{"start":569.29,"end":572.909,"text":"还有一些呃工具上的准备"},{"start":572.909,"end":574.199,"text":"强光手电啊"},{"start":574.199,"end":576.269,"text":"就是一些合法的自卫工具"},{"start":576.269,"end":582.85,"text":"防卫的卫你到了成年人才大概成年人"},{"start":582.85,"end":583.63,"text":"这我觉得"},{"start":583.63,"end":586.45,"text":"所以说这些事件对于我们一般个体的意义"},{"start":586.45,"end":587.53,"text":"就在于此啊"},{"start":587.53,"end":589.36,"text":"一般的公众的意义就在于此"},{"start":589.36,"end":593.75,"text":"邪恶你就不能怪任何这个机构的"},{"start":593.75,"end":595.13,"text":"不能怪任何机关的"},{"start":595.13,"end":596.33,"text":"不能怪治理"},{"start":596.33,"end":597.29,"text":"治理性的力量"},{"start":597.29,"end":597.65,"text":"我说了"},{"start":601.34,"end":604.44,"text":"来防备成年人对他的迫害加害"},{"start":604.44,"end":608.37,"text":"所以他们可以通过极端方式来保障自己的利益"},{"start":608.37,"end":611.49,"text":"因为他们不是时时刻刻可以像成年人那样"},{"start":611.49,"end":615.14,"text":"获得司法救济者啊"},{"start":616.7,"end":619.66,"text":"但是他相信代价"},{"start":619.66,"end":622.9,"text":"不是说这个代价是因为这样的治理方式"},{"start":622.9,"end":624.64,"text":"然后由社会承担相应的代价"},{"start":624.64,"end":625.24,"text":"不是的"},{"start":625.24,"end":626.56,"text":"是不这样治理"},{"start":626.56,"end":628.67,"text":"整个社会会遭受更大的"},{"start":628.67,"end":630.23,"text":"会更不成熟"},{"start":630.23,"end":633.8,"text":"那这孩童未成年就成为成年人的奴隶"},{"start":633.8,"end":636.25,"text":"而被牢牢地控制着啊"},{"start":636.25,"end":638.02,"text":"家庭关系会更糟糕"},{"start":638.02,"end":641.65,"text":"所以政治性的用这样的法律的方式去介入"},{"start":641.65,"end":644.39,"text":"去保证未成年人的生存是没问题的"},{"start":644.39,"end":646.55,"text":"但是在个例上"},{"start":646.89,"end":649.73,"text":"邪恶确实产生了这个邪恶产生的土壤"},{"start":649.73,"end":651.79,"text":"也不能不能甩锅"},{"start":651.79,"end":654.55,"text":"甩到是这个智理性的力量"},{"start":654.55,"end":655.9,"text":"政治性的力量上面去"},{"start":655.9,"end":657.82,"text":"邪恶产生的土壤多呢"},{"start":657.82,"end":664.48,"text":"人本身就人类人类的内核"},{"start":667.06,"end":670.5,"text":"如果不加以教化和约束的话"},{"start":670.5,"end":673.15,"text":"本身就是"},{"start":673.97,"end":675.25,"text":"实事求是讲"},{"start":675.25,"end":676.69,"text":"实事求是讲"},{"start":676.69,"end":679.57,"text":"但是我们要讲的就