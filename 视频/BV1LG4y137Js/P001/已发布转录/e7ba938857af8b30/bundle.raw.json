rt":1242.2,"end":1244.159,"text":"他自己有他做事的自由"},{"start":1244.66,"end":1246.91,"text":"这个就搞笑了"},{"start":1246.91,"end":1248.98,"text":"哪里是他的自由啊"},{"start":1250.7,"end":1252.58,"text":"他根本他有应该回答"},{"start":1252.58,"end":1253.86,"text":"他有义务"},{"start":1254.5,"end":1257.61,"text":"他有义务公开平均的分配啊"},{"start":1257.61,"end":1258.6,"text":"平等的分配啊"},{"start":1258.6,"end":1260.32,"text":"他有义务平等的分配啊"},{"start":1261.7,"end":1264.78,"text":"因为他是那个你在说我卖苏打水的"},{"start":1264.78,"end":1265.86,"text":"我没有平等分配"},{"start":1265.86,"end":1267.12,"text":"我卖苏打水的"},{"start":1267.12,"end":1268.28,"text":"帮我干活的"},{"start":1268.28,"end":1269.36,"text":"在这个意义上讲"},{"start":1269.36,"end":1270.95,"text":"我们自己作为"},{"start":1272.24,"end":1272.84,"text":"小资人"},{"start":1272.84,"end":1273.83,"text":"我们没有赚到钱"},{"start":1273.83,"end":1275.15,"text":"我自己是亏的"},{"start":1275.15,"end":1278.05,"text":"都在还债给我劳动的人"},{"start":1278.05,"end":1280.139,"text":"我们也是尊重他的意愿"},{"start":1280.3,"end":1282.55,"text":"给予他啊"},{"start":1282.55,"end":1283.99,"text":"劳动报酬了"},{"start":1283.99,"end":1284.98,"text":"我们自己就亏了"},{"start":1284.98,"end":1286.03,"text":"亏了大哥"},{"start":1286.03,"end":1287.32,"text":"你了解吗"},{"start":1289.22,"end":1293.11,"text":"然后我然后就说我对于那种饮料灌装厂"},{"start":1293.11,"end":1294.5,"text":"贴牌厂"},{"start":1294.5,"end":1296.57,"text":"货运当中那些无产阶"},{"start":1296.57,"end":1297.29,"text":"我没有能力"},{"start":1297.29,"end":1299.66,"text":"我没有能力去主导里面的分配关系"},{"start":1299.66,"end":1300.77,"text":"这个我实事求是讲"},{"start":1300.77,"end":1302.75,"text":"我没有能力去主导里面分配关系"},{"start":1302.75,"end":1305.38,"text":"我选了所有的啊"},{"start":1305.38,"end":1307.96,"text":"每一家每一户它的分配关系都不太乐观"},{"start":1307.96,"end":1309.159,"text":"都不太乐观"},{"start":1310.28,"end":1315.76,"text":"但是这位刘海庆同志权企业家的同志"},{"start":1315.76,"end":1316.78,"text":"刘海清同志"},{"start":1316.78,"end":1317.92,"text":"如果他还是个同志的话"},{"start":1319.48,"end":1320.659,"text":"平等的分配啊"},{"start":1320.84,"end":1323.36,"text":"因为他是那个合作社"},{"start":1323.36,"end":1326.8,"text":"他一个人就占了40%的股权"},{"start":1327.18,"end":1332.08,"text":"他的家人只要说服其中的一位诶"},{"start":1332.08,"end":1336.61,"text":"而且事实上他是为那个事业"},{"start":1336.61,"end":1338.98,"text":"我们去看他的央视啊"},{"start":1338.98,"end":1340.5,"text":"给他的采访啊"},{"start":1340.5,"end":1341.34,"text":"他都是这个事业"},{"start":1341.34,"end":1342.42,"text":"是他一手发起的"},{"start":1342.42,"end":1344.04,"text":"他是实际控制人"},{"start":1344.04,"end":1345.27,"text":"他是灵魂人物"},{"start":1345.27,"end":1347.74,"text":"他有义务也有权利"},{"start":1347.74,"end":1349.33,"text":"也有真正的权利"},{"start":1349.33,"end":1351.399,"text":"能力却平等地分配"},{"start":1355.92,"end":1357.75,"text":"现在是不是不确定的这么一位"},{"start":1357.75,"end":1359.28,"text":"你就有义务诶"},{"start":1359.28,"end":1361.159,"text":"你杨老师本人有义务啊"},{"start":1362.599,"end":1363.859,"text":"你有这个义务"},{"start":1363.859,"end":1365.119,"text":"如果你都没有"},{"start":1365.119,"end":1367.02,"text":"那全世界还有谁有"},{"start":1367.76,"end":1369.16,"text":"如果你都没有了"},{"start":1369.16,"end":1371.17,"text":"全世界全中国还有谁有吗"},{"start":1375.28,"end":1377.56,"text":"你如果你在合理的一个"},{"start":1377.56,"end":1381.08,"text":"就是说可以说是有点有点那种"},{"start":1381.08,"end":1383.06,"text":"你的那种亲近的晚辈"},{"start":1383.06,"end":1383.63,"text":"一个亲"},{"start":1383.63,"end":1385.52,"text":"说是亲近的晚辈不为过吧"},{"start":1385.52,"end":1386.84,"text":"你把它称之为小刘"},{"start":1386.84,"end":1389.17,"text":"和他并肩拍照啊"},{"start":1389.17,"end":1390.22,"text":"并肩拍视频"},{"start":1390.22,"end":1391.9,"text":"为他的商品做代言"},{"start":1391.9,"end":1393.25,"text":"这么一个亲近的您"},{"start":1393.25,"end":1394.81,"text":"而且这个亲近的晚辈"},{"start":1397.889,"end":1399.569,"text":"曾经是个理想主义者"},{"start":1399.569,"end":1401.129,"text":"他现在是不是我们不确定"},{"start":1401.129,"end":1404.87,"text":"我不能说他不是在这样的条件之下"},{"start":1404.87,"end":1406.85,"text":"在这样的情况之下"},{"start":1406.85,"end":1409.5,"text":"您竟然认为这是他的自由"},{"start":1409.74,"end":1411.9,"text":"而不认为他有义务"},{"start":1411.9,"end":1413.46,"text":"也不认为你有义务"},{"start":1413.46,"end":1416.96,"text":"那全中国我们还能指望谁呀"},{"start":1418.02,"end":1420.159,"text":"我们还可以指望首页啊"},{"start":1421.34,"end":1422.02,"text":"对不对"},{"start":1422.02,"end":1425.32,"text":"您您都您是最跟踪苗红的了"},{"start":1425.32,"end":1426.88,"text":"不仅仅在理论上"},{"start":1426.88,"end":1429.22,"text":"在实践上做了几十年老工人"},{"start":1429.22,"end":1431.36,"text":"在理论上对不对"},{"start":1431.36,"end":1433.34,"text":"也是一个这个教授级别的人物"},{"start":1433.34,"end":1434.6,"text":"自学啊"},{"start":1434.6,"end":1436.5,"text":"政治经济学啊"},{"start":1436.5,"end":1437.7,"text":"在身世上"},{"start":1437.7,"end":1438.72,"text":"在出生上面"},{"start":1443.66,"end":1445.22,"text":"那环境熏陶了"},{"start":1445.22,"end":1447.98,"text":"连您都认为这是他的自由"},{"start":1448.8,"end":1450.2,"text":"这句话说出来"},{"start":1450.2,"end":1451.1,"text":"那是他的自由"},{"start":1451.1,"end":1454.84,"text":"这句话说出来很多东西会破产的"},{"start":1456.12,"end":1457.34,"text":"这句话说出来"},{"start":1457.34,"end":1460.4,"text":"他的合作社的股东会赚得盆满钵满"},{"start":1460.4,"end":1463.15,"text":"但是很多无形的资产"},{"start":1463.15,"end":1467.75,"text":"很多在人民共和国的内心深处"},{"start":1472.91,"end":1481.4,"text":"根本性的立场都会蒙受损失啊"},{"start":1481.4,"end":1484.76,"text":"蒙受这个屈辱的啊"},{"start":1489.02,"end":1492.6,"text":"也有很大的可能性会破产的"},{"start":1493.32,"end":1494.48,"text":"了解不"},{"start":1496.7,"end":1498.98,"text":"我希望这句话能说出来的"},{"start":1498.98,"end":1501.8,"text":"一个就是说您能够证明刘海静"},{"start":1501.8,"end":1504.73,"text":"他真的是一个马里马主义者啊"},{"start":1506.29,"end":1507.67,"text":"那我们反过来这个球的"},{"start":1507.67,"end":1510.43,"text":"就如果说您是出于对他信任"},{"start":1510.43,"end":1512.2,"text":"就绝对信任刘海军同志"},{"start":1513.22,"end":1514.38,"text":"我绝对信任他"},{"start":1514.38,"end":1515.46,"text":"那是他的自由"},{"start":1515.46,"end":1519.9,"text":"这句话的意思不是说他可以自由去分配啊"},{"start":1519.9,"end":1520.92,"text":"我管不着他"},{"start":1520.92,"end":1522.72,"text":"而是说我已经对他"},{"start":1522.72,"end":1525.57,"text":"我我可以拍着胸脯讲他是一个"},{"start":1529.56,"end":1531.33,"text":"他一定会分配好的"},{"start":1531.33,"end":1534.24,"text":"而不要说这种容易引起大家误解的话"},{"start":1534.24,"end":1534.36,"text":"说"},{"start":1534.36,"end":1535.7,"text":"那是他的自由"},{"start":1536.12,"end":1537.92,"text":"按照这样的话说"},{"start":1537.92,"end":1541.47,"text":"对于一些那对于任何工厂主"},{"start":1541.47,"end":1543.0,"text":"你都没有资格批判他了"},{"start":1543.84,"end":1545.38,"text":"你都没办法批判他了"},{"start":1545.38,"end":1547.54,"text":"因为连你身边的"},{"start":1547.54,"end":1549.46,"text":"或者说就是至少你打过交道的"},{"start":1549.46,"end":1551.34,"text":"这个清净的这么一个晚辈"},{"start":1551.5,"end":1554.76,"text":"曾经在你身边是清静的"},{"start":1554.76,"end":1555.6,"text":"拍过两张照"},{"start":1555.6,"end":1557.4,"text":"拍过拍过拍过视频的"},{"start":1557.4,"end":1558.6,"text":"拍过一张照片"},{"start":1558.6,"end":1559.82,"text":"就是一个视频的"},{"start":1559.82,"end":1561.44,"text":"你愿意为他商品做代言呢"},{"start":1561.44,"end":1562.34,"text":"连这么一个人"},{"start":1565.8,"end":1567.09,"text":"你都不批评他"},{"start":1567.09,"end":1569.3,"text":"你又给予他这个这个自由"},{"start":1569.4,"end":1571.92,"text":"那你又有什么资格"},{"start":1575.52,"end":1578.68,"text":"那你平时又在批评什么呢"},{"start":1579.86,"end":1581.2,"text":"你平时又在说"},{"start":1581.2,"end":1582.04,"text":"这是不对的"},{"start":1583.84,"end":1584.68,"text":"这是这条路"},{"start":1584.68,"end":1586.92,"text":"不就您你"},{"start":1586.92,"end":1590.78,"text":"你其他的那些话语的利润资格又何在呢"},{"start":1597.5,"end":1602.39,"text":"你在根本的这么一个政治纪律上"},{"start":1602.39,"end":1608.1,"text":"已经纵容了一个这么一个直接纵容"},{"start":1608.1,"end":1610.65,"text":"一种直接的助长啊"},{"start":1610.65,"end":1613.86,"text":"放任一种商业上的自由主义"},{"start":1614.36,"end":1615.92,"text":"那是他的自由"},{"start":1615.92,"end":1617.54,"text":"这个自由我很想知道"},{"start":1623.22,"end":1624.12,"text":"我非常想知道"},{"start":1624.12,"end":1626.51,"text":"i want to know啊"},{"start":1626.51,"end":1629.09,"text":"就是很多人都反映他都是这样回复的"},{"start":1629.09,"end":1634.86,"text":"很多他的支持者是听到了这个回复之后啊"},{"start":1635.68,"end":1637.56,"text":"眼睛就黯淡了"},{"start":1637.82,"end":1639.98,"text":"眼睛就暗淡了啊"},{"start":1639.98,"end":1641.21,"text":"眼睛就暗淡了"},{"start":1641.21,"end":1642.84,"text":"眼睛就暗淡了"},{"start":1642.84,"end":1643.68,"text":"所以我说"},{"start":1643.68,"end":1649.08,"text":"不要因为自由主义而让青年的眼睛黯淡啊"},{"start":1649.08,"end":1649.86,"text":"那就讲到这边"}],"source":"subtitle"}
