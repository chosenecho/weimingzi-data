{"start":735.7,"end":737.29,"text":"那善于发掘人才"},{"start":737.29,"end":739.45,"text":"善于承认别人比自己强"},{"start":739.45,"end":740.89,"text":"善于也慧眼识珠"},{"start":740.89,"end":742.33,"text":"知道别人比自己强"},{"start":742.33,"end":744.31,"text":"那这个人如果他有觉悟"},{"start":744.31,"end":746.26,"text":"如果他愿意一起啊"},{"start":746.26,"end":747.4,"text":"引为同伴的话"},{"start":747.4,"end":748.78,"text":"他能做哪些事情"},{"start":748.78,"end":749.88,"text":"对不对"},{"start":750.24,"end":751.38,"text":"那就讲到这边啊"},{"start":751.38,"end":752.48,"text":"那就讲到这里好吧"}],"source":"subtitle"}
