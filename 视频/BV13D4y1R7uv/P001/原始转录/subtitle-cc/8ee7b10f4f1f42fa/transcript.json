{
  "bvid": "BV13D4y1R7uv",
  "page": 1,
  "source": "subtitle-cc",
  "language": "zh-CN",
  "model": null,
  "content_sha256": "8ee7b10f4f1f42fa5f2f1f81481dc2a00748a1fa268f39968f76a3a57af95fb3",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 3200,
      "end_ms": 4720,
      "text": "这是同样的一个问题"
    },
    {
      "ordinal": 1,
      "start_ms": 5360,
      "end_ms": 7680,
      "text": "就是和鸡生蛋生鸡"
    },
    {
      "ordinal": 2,
      "start_ms": 7680,
      "end_ms": 8960,
      "text": "同样的另外一个问题"
    },
    {
      "ordinal": 3,
      "start_ms": 9000,
      "end_ms": 10920,
      "text": "就是先有鸡还是先有蛋"
    },
    {
      "ordinal": 4,
      "start_ms": 11440,
      "end_ms": 11880,
      "text": "正题："
    },
    {
      "ordinal": 5,
      "start_ms": 11880,
      "end_ms": 12520,
      "text": "先有鸡"
    },
    {
      "ordinal": 6,
      "start_ms": 12520,
      "end_ms": 13760,
      "text": "反题：先有蛋"
    },
    {
      "ordinal": 7,
      "start_ms": 13840,
      "end_ms": 14680,
      "text": "那么它的合题"
    },
    {
      "ordinal": 8,
      "start_ms": 14680,
      "end_ms": 16040,
      "text": "庸俗的合题是"
    },
    {
      "ordinal": 9,
      "start_ms": 16600,
      "end_ms": 17520,
      "text": "“神仙都不知道"
    },
    {
      "ordinal": 10,
      "start_ms": 17520,
      "end_ms": 18760,
      "text": "是先有鸡还是先有蛋”"
    },
    {
      "ordinal": 11,
      "start_ms": 18760,
      "end_ms": 20280,
      "text": "“这根本是一个不能解决问题”"
    },
    {
      "ordinal": 12,
      "start_ms": 20280,
      "end_ms": 21920,
      "text": "或者说是另外一种庸俗的合题"
    },
    {
      "ordinal": 13,
      "start_ms": 21920,
      "end_ms": 23760,
      "text": "就是“鸡生蛋生鸡生蛋……”"
    },
    {
      "ordinal": 14,
      "start_ms": 23800,
      "end_ms": 26160,
      "text": "是无穷尽的"
    },
    {
      "ordinal": 15,
      "start_ms": 26320,
      "end_ms": 27520,
      "text": "就算往前追溯"
    },
    {
      "ordinal": 16,
      "start_ms": 27520,
      "end_ms": 28560,
      "text": "也是无穷尽的"
    },
    {
      "ordinal": 17,
      "start_ms": 28560,
      "end_ms": 30480,
      "text": "这些答案都是虚假的"
    },
    {
      "ordinal": 18,
      "start_ms": 30480,
      "end_ms": 31440,
      "text": "都是整体主义"
    },
    {
      "ordinal": 19,
      "start_ms": 31440,
      "end_ms": 33760,
      "text": "都是庸俗的辩证法"
    },
    {
      "ordinal": 20,
      "start_ms": 34200,
      "end_ms": 35560,
      "text": "正确答案是"
    },
    {
      "ordinal": 21,
      "start_ms": 36360,
      "end_ms": 39240,
      "text": "我们把重音放到【先】字上面去"
    },
    {
      "ordinal": 22,
      "start_ms": 39240,
      "end_ms": 40680,
      "text": "重新把正题读一遍"
    },
    {
      "ordinal": 23,
      "start_ms": 40680,
      "end_ms": 41560,
      "text": "就正确答案了"
    },
    {
      "ordinal": 24,
      "start_ms": 41880,
      "end_ms": 42560,
      "text": "很简单"
    },
    {
      "ordinal": 25,
      "start_ms": 42560,
      "end_ms": 43440,
      "text": "为什么加引号"
    },
    {
      "ordinal": 26,
      "start_ms": 43440,
      "end_ms": 44200,
      "text": "我后面再说"
    },
    {
      "ordinal": 27,
      "start_ms": 45680,
      "end_ms": 47240,
      "text": "先有鸡先有蛋"
    },
    {
      "ordinal": 28,
      "start_ms": 47240,
      "end_ms": 48800,
      "text": "其实我们之前上一讲"
    },
    {
      "ordinal": 29,
      "start_ms": 48800,
      "end_ms": 49840,
      "text": "已经讲过了"
    },
    {
      "ordinal": 30,
      "start_ms": 49840,
      "end_ms": 51920,
      "text": "鸡“生”蛋是一个创造的行为"
    },
    {
      "ordinal": 31,
      "start_ms": 51920,
      "end_ms": 52800,
      "text": "蛋“生”鸡"
    },
    {
      "ordinal": 32,
      "start_ms": 52960,
      "end_ms": 55000,
      "text": "它是一个变化的行为"
    },
    {
      "ordinal": 33,
      "start_ms": 55000,
      "end_ms": 56120,
      "text": "它是一个东西"
    },
    {
      "ordinal": 34,
      "start_ms": 56280,
      "end_ms": 58520,
      "text": "变成它自己本身所发生的变化"
    },
    {
      "ordinal": 35,
      "start_ms": 59200,
      "end_ms": 60200,
      "text": "而创造的行为"
    },
    {
      "ordinal": 36,
      "start_ms": 60200,
      "end_ms": 62320,
      "text": "它是无中生有的"
    },
    {
      "ordinal": 37,
      "start_ms": 62360,
      "end_ms": 63800,
      "text": "我本来只有一只鸡"
    },
    {
      "ordinal": 38,
      "start_ms": 63920,
      "end_ms": 64920,
      "text": "但是它生了一个蛋"
    },
    {
      "ordinal": 39,
      "start_ms": 65080,
      "end_ms": 66200,
      "text": "我就无中生有"
    },
    {
      "ordinal": 40,
      "start_ms": 66200,
      "end_ms": 67680,
      "text": "凭空多出了一个蛋"
    },
    {
      "ordinal": 41,
      "start_ms": 68000,
      "end_ms": 68480,
      "text": "了解？"
    },
    {
      "ordinal": 42,
      "start_ms": 72360,
      "end_ms": 73880,
      "text": "蛋生鸡它是"
    },
    {
      "ordinal": 43,
      "start_ms": 74840,
      "end_ms": 76440,
      "text": "蛋变成了鸡"
    },
    {
      "ordinal": 44,
      "start_ms": 76480,
      "end_ms": 78440,
      "text": "它是自己变成了鸡"
    },
    {
      "ordinal": 45,
      "start_ms": 78760,
      "end_ms": 81960,
      "text": "它是一个东西变成另外一种形态"
    },
    {
      "ordinal": 46,
      "start_ms": 82360,
      "end_ms": 84080,
      "text": "所以在这个意义上"
    },
    {
      "ordinal": 47,
      "start_ms": 84080,
      "end_ms": 85440,
      "text": "如果我们把重音"
    },
    {
      "ordinal": 48,
      "start_ms": 85440,
      "end_ms": 87360,
      "text": "转到【先】有鸡上面的话"
    },
    {
      "ordinal": 49,
      "start_ms": 87360,
      "end_ms": 88560,
      "text": "【先】这个字的话"
    },
    {
      "ordinal": 50,
      "start_ms": 88560,
      "end_ms": 89360,
      "text": "我们就会发现"
    },
    {
      "ordinal": 51,
      "start_ms": 89360,
      "end_ms": 90400,
      "text": "创造的行为"
    },
    {
      "ordinal": 52,
      "start_ms": 90400,
      "end_ms": 93120,
      "text": "是比变化具有优先性的"
    },
    {
      "ordinal": 53,
      "start_ms": 94480,
      "end_ms": 96960,
      "text": "创造是比这个蛋成为鸡……"
    },
    {
      "ordinal": 54,
      "start_ms": 96960,
      "end_ms": 98400,
      "text": "鸡创造蛋的行为"
    },
    {
      "ordinal": 55,
      "start_ms": 98400,
      "end_ms": 99120,
      "text": "是优先于（蛋成为鸡的）"
    },
    {
      "ordinal": 56,
      "start_ms": 99680,
      "end_ms": 101320,
      "text": "所以这是一层意思"
    },
    {
      "ordinal": 57,
      "start_ms": 101320,
      "end_ms": 102840,
      "text": "为什么叫“【先】有鸡”"
    },
    {
      "ordinal": 58,
      "start_ms": 102840,
      "end_ms": 104240,
      "text": "是这个问题的答案"
    },
    {
      "ordinal": 59,
      "start_ms": 104880,
      "end_ms": 107040,
      "text": "另外一方面我加了引号"
    },
    {
      "ordinal": 60,
      "start_ms": 107720,
      "end_ms": 108720,
      "text": "我加了引号"
    },
    {
      "ordinal": 61,
      "start_ms": 108720,
      "end_ms": 109920,
      "text": "如果我们熟悉"
    },
    {
      "ordinal": 62,
      "start_ms": 110200,
      "end_ms": 112120,
      "text": "熟悉西方传统《圣经》的话"
    },
    {
      "ordinal": 63,
      "start_ms": 112120,
      "end_ms": 113160,
      "text": "我们就知道上帝"
    },
    {
      "ordinal": 64,
      "start_ms": 113840,
      "end_ms": 114800,
      "text": "《创世纪》说的第一句话"
    },
    {
      "ordinal": 65,
      "start_ms": 114840,
      "end_ms": 116560,
      "text": "叫做先“要有光”"
    },
    {
      "ordinal": 66,
      "start_ms": 117120,
      "end_ms": 118840,
      "text": "“要有光”它加引号的"
    },
    {
      "ordinal": 67,
      "start_ms": 118840,
      "end_ms": 119560,
      "text": "它是个命令"
    },
    {
      "ordinal": 68,
      "start_ms": 119560,
      "end_ms": 120200,
      "text": "“要有光！”"
    },
    {
      "ordinal": 69,
      "start_ms": 120200,
      "end_ms": 121160,
      "text": "你要这样想"
    },
    {
      "ordinal": 70,
      "start_ms": 121720,
      "end_ms": 123080,
      "text": "如果我是个上帝"
    },
    {
      "ordinal": 71,
      "start_ms": 123080,
      "end_ms": 124760,
      "text": "我是所谓的创造者"
    },
    {
      "ordinal": 72,
      "start_ms": 124800,
      "end_ms": 126880,
      "text": "我要创造鸡和蛋"
    },
    {
      "ordinal": 73,
      "start_ms": 128720,
      "end_ms": 130600,
      "text": "创造鸡了之后"
    },
    {
      "ordinal": 74,
      "start_ms": 130639,
      "end_ms": 132960,
      "text": "鸡它自己就能创造出蛋"
    },
    {
      "ordinal": 75,
      "start_ms": 132960,
      "end_ms": 134960,
      "text": "不需要我去额外地创造蛋"
    },
    {
      "ordinal": 76,
      "start_ms": 135000,
      "end_ms": 135840,
      "text": "你明白吗"
    },
    {
      "ordinal": 77,
      "start_ms": 136360,
      "end_ms": 138040,
      "text": "我额外创造出来那个蛋"
    },
    {
      "ordinal": 78,
      "start_ms": 138040,
      "end_ms": 139240,
      "text": "它不叫蛋"
    },
    {
      "ordinal": 79,
      "start_ms": 140200,
      "end_ms": 142040,
      "text": "它不是鸡创造出来的东西"
    },
    {
      "ordinal": 80,
      "start_ms": 142040,
      "end_ms": 143000,
      "text": "它不是蛋"
    },
    {
      "ordinal": 81,
      "start_ms": 143880,
      "end_ms": 144560,
      "text": "了解吗"
    },
    {
      "ordinal": 82,
      "start_ms": 145120,
      "end_ms": 147920,
      "text": "所以上帝不可能先创造蛋"
    },
    {
      "ordinal": 83,
      "start_ms": 147920,
      "end_ms": 150040,
      "text": "然后再让蛋变成鸡"
    },
    {
      "ordinal": 84,
      "start_ms": 150040,
      "end_ms": 151840,
      "text": "他觉得这是多此一举"
    },
    {
      "ordinal": 85,
      "start_ms": 151840,
      "end_ms": 153120,
      "text": "他肯定先创造一个"
    },
    {
      "ordinal": 86,
      "start_ms": 153120,
      "end_ms": 154400,
      "text": "同样能创造"
    },
    {
      "ordinal": 87,
      "start_ms": 154680,
      "end_ms": 155520,
      "text": "它自己的（东西）"
    },
    {
      "ordinal": 88,
      "start_ms": 156520,
      "end_ms": 158000,
      "text": "因为他有休息日"
    },
    {
      "ordinal": 89,
      "start_ms": 158080,
      "end_ms": 160400,
      "text": "他自己的工作量就节省了"
    },
    {
      "ordinal": 90,
      "start_ms": 160640,
      "end_ms": 162360,
      "text": "所以如果是他是个聪明的上帝"
    },
    {
      "ordinal": 91,
      "start_ms": 162400,
      "end_ms": 164560,
      "text": "他是个聪明的造物者的话"
    },
    {
      "ordinal": 92,
      "start_ms": 164600,
      "end_ms": 166120,
      "text": "他肯定会创造一个创造者"
    },
    {
      "ordinal": 93,
      "start_ms": 166120,
      "end_ms": 167960,
      "text": "然后让创造者去创造"
    },
    {
      "ordinal": 94,
      "start_ms": 168040,
      "end_ms": 169280,
      "text": "其他他自己不必要"
    },
    {
      "ordinal": 95,
      "start_ms": 169280,
      "end_ms": 170880,
      "text": "亲自去创造东西"
    },
    {
      "ordinal": 96,
      "start_ms": 171000,
      "end_ms": 174000,
      "text": "去创造一些在概念规定上"
    },
    {
      "ordinal": 97,
      "start_ms": 174000,
      "end_ms": 176360,
      "text": "是从属于它的一些东西"
    },
    {
      "ordinal": 98,
      "start_ms": 176560,
      "end_ms": 177920,
      "text": "所以在这个意义上"
    },
    {
      "ordinal": 99,
      "start_ms": 178360,
      "end_ms": 179920,
      "text": "是先有鸡"
    },
    {
      "ordinal": 100,
      "start_ms": 179960,
      "end_ms": 181760,
      "text": "或者我们可以进一步推"
    },
    {
      "ordinal": 101,
      "start_ms": 182240,
      "end_ms": 183120,
      "text": "【先】有鸡"
    },
    {
      "ordinal": 102,
      "start_ms": 183120,
      "end_ms": 184200,
      "text": "如果我们这样去念"
    },
    {
      "ordinal": 103,
      "start_ms": 184200,
      "end_ms": 185880,
      "text": "它把【先】字着重"
    },
    {
      "ordinal": 104,
      "start_ms": 185880,
      "end_ms": 187600,
      "text": "然后我们把它当成一个命令一样的"
    },
    {
      "ordinal": 105,
      "start_ms": 187880,
      "end_ms": 189320,
      "text": "先有鸡！"
    },
    {
      "ordinal": 106,
      "start_ms": 189680,
      "end_ms": 192040,
      "text": "我们就能够从这三个字当中"
    },
    {
      "ordinal": 107,
      "start_ms": 192040,
      "end_ms": 194320,
      "text": "感受到背后有那么一个"
    },
    {
      "ordinal": 108,
      "start_ms": 195000,
      "end_ms": 196480,
      "text": "无中生有的那种力量"
    },
    {
      "ordinal": 109,
      "start_ms": 196480,
      "end_ms": 199640,
      "text": "有那种造物主在那边存在着"
    },
    {
      "ordinal": 110,
      "start_ms": 199680,
      "end_ms": 202360,
      "text": "那么这个意义上就是最先有的"
    },
    {
      "ordinal": 111,
      "start_ms": 202360,
      "end_ms": 203640,
      "text": "也不是鸡也不是蛋"
    },
    {
      "ordinal": 112,
      "start_ms": 203640,
      "end_ms": 205920,
      "text": "最先有的是创造出“鸡”"
    },
    {
      "ordinal": 113,
      "start_ms": 205920,
      "end_ms": 207520,
      "text": "这个概念的"
    },
    {
      "ordinal": 114,
      "start_ms": 207640,
      "end_ms": 210120,
      "text": "这种实体的力量、原初力量"
    },
    {
      "ordinal": 115,
      "start_ms": 210120,
      "end_ms": 211680,
      "text": "所以通过念“【先】有鸡”"
    },
    {
      "ordinal": 116,
      "start_ms": 211720,
      "end_ms": 212560,
      "text": "我们可以看到"
    },
    {
      "ordinal": 117,
      "start_ms": 212600,
      "end_ms": 213640,
      "text": "比鸡优先"
    },
    {
      "ordinal": 118,
      "start_ms": 213640,
      "end_ms": 214840,
      "text": "比蛋更优先的一种（第一创造者）"
    }
  ],
