  "content_sha256": "540c7690f3eed439f43d8dd37d4684f1655188aea55e6b1fa451b9bdc07ddef1",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 400,
      "end_ms": 12880,
      "text": "我们今天来唱唱一首歌啊，这歌是我自己写的啊，啊叫秋风啊原曲也是秋风，是那个城之内啊谱的曲子。我们来听一下。"
    },
    {
      "ordinal": 1,
      "start_ms": 14060,
      "end_ms": 31216,
      "text": "白云悠悠，一"
    },
    {
      "ordinal": 2,
      "start_ms": 33486,
      "end_ms": 58450,
      "text": "路飞去秋风起，"
    },
    {
      "ordinal": 3,
      "start_ms": 60720,
      "end_ms": 75680,
      "text": "花儿都谢了，燕子都去了，漫漫长夜黯然相思，秋风里，月儿都倦了，云儿都睡了。"
    },
    {
      "ordinal": 4,
      "start_ms": 75680,
      "end_ms": 82960,
      "text": "过月见落雁，扫云空雨歇，在这"
    },
    {
      "ordinal": 5,
      "start_ms": 84640,
      "end_ms": 91760,
      "text": "般凄凉的夜，苍白的语言，"
    },
    {
      "ordinal": 6,
      "start_ms": 95680,
      "end_ms": 98560,
      "text": "这秋风无依无靠，无端"
    },
    {
      "ordinal": 7,
      "start_ms": 99920,
      "end_ms": 103440,
      "text": "无了，不说不笑，哭不嚎，"
    },
    {
      "ordinal": 8,
      "start_ms": 106640,
      "end_ms": 109920,
      "text": "寂灭到真难分难了，"
    },
    {
      "ordinal": 9,
      "start_ms": 111680,
      "end_ms": 121680,
      "text": "什么这么说，无需知道，情不明了，早就分晓。"
    },
    {
      "ordinal": 10,
      "start_ms": 122720,
      "end_ms": 124880,
      "text": "这秋风让目光"
    },
    {
      "ordinal": 11,
      "start_ms": 126480,
      "end_ms": 129840,
      "text": "迷了傻，生出了迷惘。"
    },
    {
      "ordinal": 12,
      "start_ms": 129840,
      "end_ms": 140320,
      "text": "你不肯说，你不肯说，你不肯说心底的思量。"
    },
    {
      "ordinal": 13,
      "start_ms": 140320,
      "end_ms": 153520,
      "text": "你不肯说，你不肯说，你不肯说心底的思量。"
    },
    {
      "ordinal": 14,
      "start_ms": 154080,
      "end_ms": 159600,
      "text": "白云悠悠，一路飞去千万里，花儿不见了，"
    },
    {
      "ordinal": 15,
      "start_ms": 161040,
      "end_ms": 166160,
      "text": "燕子不见了，漫漫长夜一人相思在梦里，"
    },
    {
      "ordinal": 16,
      "start_ms": 168160,
      "end_ms": 172240,
      "text": "月儿不见了，月儿不见了。"
    },
    {
      "ordinal": 17,
      "start_ms": 173200,
      "end_ms": 177680,
      "text": "到如今秋风过，月见落雁。"
    },
    {
      "ordinal": 18,
      "start_ms": 179790,
      "end_ms": 184670,
      "text": "搜云空雨闲，指天间凄"
    },
    {
      "ordinal": 19,
      "start_ms": 186030,
      "end_ms": 194510,
      "text": "凉的屋檐，苍白的语言。"
    },
    {
      "ordinal": 20,
      "start_ms": 194510,
      "end_ms": 200670,
      "text": "若逢五楼沾湿长夜，天下尽无眠。"
    },
    {
      "ordinal": 21,
      "start_ms": 202270,
      "end_ms": 213790,
      "text": "下着飘零，躺好荒野，上这挂林间。"
    },
    {
      "ordinal": 22,
      "start_ms": 215150,
      "end_ms": 216990,
      "text": "八月秋高风怒"
    },
    {
      "ordinal": 23,
      "start_ms": 218110,
      "end_ms": 222110,
      "text": "号，卷我屋上三重茅。"
    },
    {
      "ordinal": 24,
      "start_ms": 222670,
      "end_ms": 241870,
      "text": "如住去，归来倚杖自叹，叹息安得广厦千万，安得广厦千万大庇天下寒士俱欢颜，俱欢颜。"
    },
    {
      "ordinal": 25,
      "start_ms": 241950,
      "end_ms": 250190,
      "text": "南村群童，谁能对面对盗贼？"
    },
    {
      "ordinal": 26,
      "start_ms": 250270,
      "end_ms": 255310,
      "text": "对盗贼，不肯说，不肯说，"
    },
    {
      "ordinal": 27,
      "start_ms": 257150,
      "end_ms": 261870,
      "text": "不肯说心底的思量。"
    },
    {
      "ordinal": 28,
      "start_ms": 262110,
      "end_ms": 265310,
      "text": "不肯说，不肯说，"
    },
    {
      "ordinal": 29,
      "start_ms": 267070,
      "end_ms": 273150,
      "text": "不肯说心底的思量。不肯说。"
    },
    {
      "ordinal": 30,
      "start_ms": 276430,
      "end_ms": 284510,
      "text": "这个南村群童指的不是年轻人，他指的是哪些人？其实我们都知道。好的，就这样啊。"
    }
  ],
