{
  "bvid": "BV1Tt4y167iN",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "198feb4d01ec0be54968fbdd9dcc281e9d8a80f332a44ca03206b7a58d2b9b6e",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 300,
      "end_ms": 2160,
      "text": "我们今天来唱一唱一首歌啊"
    },
    {
      "ordinal": 1,
      "start_ms": 2160,
      "end_ms": 3660,
      "text": "这歌是我自己写的啊"
    },
    {
      "ordinal": 2,
      "start_ms": 3660,
      "end_ms": 5160,
      "text": "叫秋风啊"
    },
    {
      "ordinal": 3,
      "start_ms": 5160,
      "end_ms": 6180,
      "text": "原曲也是秋风"
    },
    {
      "ordinal": 4,
      "start_ms": 6180,
      "end_ms": 8519,
      "text": "是那个城之内啊"
    },
    {
      "ordinal": 5,
      "start_ms": 8519,
      "end_ms": 9179,
      "text": "不是曲子"
    },
    {
      "ordinal": 6,
      "start_ms": 12119,
      "end_ms": 13200,
      "text": "我们来听一下"
    },
    {
      "ordinal": 7,
      "start_ms": 55380,
      "end_ms": 61180,
      "text": "白飞春秋风起花落"
    },
    {
      "ordinal": 8,
      "start_ms": 61180,
      "end_ms": 64519,
      "text": "红色的银子都去了"
    },
    {
      "ordinal": 9,
      "start_ms": 66920,
      "end_ms": 69640,
      "text": "相思秋风里"
    },
    {
      "ordinal": 10,
      "start_ms": 69640,
      "end_ms": 71740,
      "text": "月儿头卷了"
    },
    {
      "ordinal": 11,
      "start_ms": 72900,
      "end_ms": 74220,
      "text": "我都说了"
    },
    {
      "ordinal": 12,
      "start_ms": 75540,
      "end_ms": 77860,
      "text": "我不见我的"
    },
    {
      "ordinal": 13,
      "start_ms": 79840,
      "end_ms": 82800,
      "text": "搜云空不见"
    },
    {
      "ordinal": 14,
      "start_ms": 83880,
      "end_ms": 85580,
      "text": "在这段期"
    },
    {
      "ordinal": 15,
      "start_ms": 89200,
      "end_ms": 91960,
      "text": "苍白的"
    },
    {
      "ordinal": 16,
      "start_ms": 95400,
      "end_ms": 99710,
      "text": "这秋风有黑无靠不断"
    },
    {
      "ordinal": 17,
      "start_ms": 99710,
      "end_ms": 100200,
      "text": "无"
    },
    {
      "ordinal": 18,
      "start_ms": 101480,
      "end_ms": 104540,
      "text": "我说不想哭"
    },
    {
      "ordinal": 19,
      "start_ms": 104540,
      "end_ms": 107330,
      "text": "不怕寂灭"
    },
    {
      "ordinal": 20,
      "start_ms": 107330,
      "end_ms": 112660,
      "text": "逃难分难了什么"
    },
    {
      "ordinal": 21,
      "start_ms": 112660,
      "end_ms": 114580,
      "text": "这么说"
    },
    {
      "ordinal": 22,
      "start_ms": 115680,
      "end_ms": 123880,
      "text": "曲折荡秋风在秋分享这个秋风"
    },
    {
      "ordinal": 23,
      "start_ms": 124080,
      "end_ms": 131020,
      "text": "让目光里的沙深处的迷茫"
    },
    {
      "ordinal": 24,
      "start_ms": 134100,
      "end_ms": 135180,
      "text": "你不肯说"
    },
    {
      "ordinal": 25,
      "start_ms": 136380,
      "end_ms": 138000,
      "text": "你不肯说"
    },
    {
      "ordinal": 26,
      "start_ms": 139459,
      "end_ms": 140329,
      "text": "不肯说"
    },
    {
      "ordinal": 27,
      "start_ms": 140329,
      "end_ms": 145380,
      "text": "心底的测量也不肯说"
    },
    {
      "ordinal": 28,
      "start_ms": 147020,
      "end_ms": 151420,
      "text": "说你不肯说心底的"
    },
    {
      "ordinal": 29,
      "start_ms": 153779,
      "end_ms": 154999,
      "text": "白云悠悠"
    },
    {
      "ordinal": 30,
      "start_ms": 154999,
      "end_ms": 160140,
      "text": "你无非是千万里花儿不见了"
    },
    {
      "ordinal": 31,
      "start_ms": 160640,
      "end_ms": 162860,
      "text": "天色不见了"
    },
    {
      "ordinal": 32,
      "start_ms": 162860,
      "end_ms": 168560,
      "text": "漫漫长夜一晚相思在月儿"
    },
    {
      "ordinal": 33,
      "start_ms": 168560,
      "end_ms": 170030,
      "text": "会在老"
    },
    {
      "ordinal": 34,
      "start_ms": 170030,
      "end_ms": 172100,
      "text": "月儿不见了"
    },
    {
      "ordinal": 35,
      "start_ms": 172839,
      "end_ms": 174329,
      "text": "到如今"
    },
    {
      "ordinal": 36,
      "start_ms": 174329,
      "end_ms": 177119,
      "text": "秋风破月前"
    },
    {
      "ordinal": 37,
      "start_ms": 177119,
      "end_ms": 182439,
      "text": "落叶手无限"
    },
    {
      "ordinal": 38,
      "start_ms": 183579,
      "end_ms": 187220,
      "text": "只听见清凉的屋檐"
    },
    {
      "ordinal": 39,
      "start_ms": 188839,
      "end_ms": 191500,
      "text": "苍白的"
    },
    {
      "ordinal": 40,
      "start_ms": 193579,
      "end_ms": 203359,
      "text": "五楼战士长夜天下皆下者飘零"
    },
    {
      "ordinal": 41,
      "start_ms": 204499,
      "end_ms": 210840,
      "text": "躺好荒野闪着挂人间"
    },
    {
      "ordinal": 42,
      "start_ms": 214839,
      "end_ms": 218909,
      "text": "8月秋高风怒号卷"
    },
    {
      "ordinal": 43,
      "start_ms": 218909,
      "end_ms": 221759,
      "text": "我不上三重"
    },
    {
      "ordinal": 44,
      "start_ms": 221759,
      "end_ms": 225640,
      "text": "茅不住去回来"
    },
    {
      "ordinal": 45,
      "start_ms": 225739,
      "end_ms": 228739,
      "text": "一张紫檀叹息"
    },
    {
      "ordinal": 46,
      "start_ms": 228739,
      "end_ms": 233080,
      "text": "安得广厦千寒"
    },
    {
      "ordinal": 47,
      "start_ms": 233080,
      "end_ms": 235300,
      "text": "月光洒千万"
    },
    {
      "ordinal": 48,
      "start_ms": 237990,
      "end_ms": 239670,
      "text": "世俱欢"
    },
    {
      "ordinal": 49,
      "start_ms": 239670,
      "end_ms": 241440,
      "text": "颜俱欢"
    },
    {
      "ordinal": 50,
      "start_ms": 241440,
      "end_ms": 243070,
      "text": "颜难遵循"
    },
    {
      "ordinal": 51,
      "start_ms": 243070,
      "end_ms": 247700,
      "text": "同情对面回到前"
    },
    {
      "ordinal": 52,
      "start_ms": 249399,
      "end_ms": 253320,
      "text": "盗贼你不肯说"
    },
    {
      "ordinal": 53,
      "start_ms": 256819,
      "end_ms": 258839,
      "text": "不肯说心底"
    },
    {
      "ordinal": 54,
      "start_ms": 262240,
      "end_ms": 265680,
      "text": "不敢说不敢说"
    },
    {
      "ordinal": 55,
      "start_ms": 267380,
      "end_ms": 269740,
      "text": "说心底的思量"
    },
    {
      "ordinal": 56,
      "start_ms": 272020,
      "end_ms": 273320,
      "text": "不肯说"
    },
    {
      "ordinal": 57,
      "start_ms": 276100,
      "end_ms": 278580,
      "text": "这个南村群众指的不是年轻人"
    },
    {
      "ordinal": 58,
      "start_ms": 278580,
      "end_ms": 280590,
      "text": "他指的是哪些人"
    },
    {
      "ordinal": 59,
      "start_ms": 280590,
      "end_ms": 281980,
      "text": "其实我们都知道"
    },
    {
      "ordinal": 60,
      "start_ms": 283460,
      "end_ms": 284500,
      "text": "好的就这样啊"
    }
  ],
  "text": "我们今天来唱一唱一首歌啊\n这歌是我自己写的啊\n叫秋风啊\n原曲也是秋风\n是那个城之内啊\n不是曲子\n我们来听一下\n白飞春秋风起花落\n红色的银子都去了\n相思秋风里\n月儿头卷了\n我都说了\n我不见我的\n搜云空不见\n在这段期\n苍白的\n这秋风有黑无靠不断\n无\n我说不想哭\n不怕寂灭\n逃难分难了什么\n这么说\n曲折荡秋风在秋分享这个秋风\n让目光里的沙深处的迷茫\n你不肯说\n你不肯说\n不肯说\n心底的测量也不肯说\n说你不肯说心底的\n白云悠悠\n你无非是千万里花儿不见了\n天色不见了\n漫漫长夜一晚相思在月儿\n会在老\n月儿不见了\n到如今\n秋风破月前\n落叶手无限\n只听见清凉的屋檐\n苍白的\n五楼战士长夜天下皆下者飘零\n躺好荒野闪着挂人间\n8月秋高风怒号卷\n我不上三重\n茅不住去回来\n一张紫檀叹息\n安得广厦千寒\n月光洒千万\n世俱欢\n颜俱欢\n颜难遵循\n同情对面回到前\n盗贼你不肯说\n不肯说心底\n不敢说不敢说\n说心底的思量\n不肯说\n这个南村群众指的不是年轻人\n他指的是哪些人\n其实我们都知道\n好的就这样啊",
  "timing_issue": null
}
