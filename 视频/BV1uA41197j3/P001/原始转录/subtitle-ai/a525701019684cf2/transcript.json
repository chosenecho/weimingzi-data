  "model": null,
  "content_sha256": "a525701019684cf299e9827b1016d8108093764736c83168844664e594e76725",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 220,
      "end_ms": 4840,
      "text": "这个是16年写的一首老词啊"
    },
    {
      "ordinal": 1,
      "start_ms": 5260,
      "end_ms": 7120,
      "text": "用的这个曲子呢是什么"
    },
    {
      "ordinal": 2,
      "start_ms": 7120,
      "end_ms": 9520,
      "text": "火云邪神的那个里面的啊"
    },
    {
      "ordinal": 3,
      "start_ms": 20040,
      "end_ms": 24820,
      "text": "几番风染层林如霜"
    },
    {
      "ordinal": 4,
      "start_ms": 25500,
      "end_ms": 29060,
      "text": "化作你人泪"
    },
    {
      "ordinal": 5,
      "start_ms": 30900,
      "end_ms": 35720,
      "text": "谁诉漂泊烟雨残身"
    },
    {
      "ordinal": 6,
      "start_ms": 36360,
      "end_ms": 39980,
      "text": "天寒秋来"
    },
    {
      "ordinal": 7,
      "start_ms": 41790,
      "end_ms": 50790,
      "text": "悠悠云飞月落何方不曾入梦中"
    },
    {
      "ordinal": 8,
      "start_ms": 52650,
      "end_ms": 57440,
      "text": "一是清理边角摘星"
    },
    {
      "ordinal": 9,
      "start_ms": 58140,
      "end_ms": 61640,
      "text": "浊酒注定"
    },
    {
      "ordinal": 10,
      "start_ms": 63950,
      "end_ms": 69880,
      "text": "小知晓当年又惨淡多情"
    },
    {
      "ordinal": 11,
      "start_ms": 69880,
      "end_ms": 71530,
      "text": "春雨不影"
    },
    {
      "ordinal": 12,
      "start_ms": 71530,
      "end_ms": 74300,
      "text": "如断如诗"
    },
    {
      "ordinal": 13,
      "start_ms": 74900,
      "end_ms": 77800,
      "text": "愿只愿他乡多"
    },
    {
      "ordinal": 14,
      "start_ms": 77800,
      "end_ms": 80380,
      "text": "忘却忧伤"
    },
    {
      "ordinal": 15,
      "start_ms": 80560,
      "end_ms": 85140,
      "text": "归时佳人亡故疏狂"
    },
    {
      "ordinal": 16,
      "start_ms": 86540,
      "end_ms": 90880,
      "text": "谁说赠与他人的心"
    },
    {
      "ordinal": 17,
      "start_ms": 91500,
      "end_ms": 94940,
      "text": "还得来正义"
    },
    {
      "ordinal": 18,
      "start_ms": 96840,
      "end_ms": 101759,
      "text": "谁说种在心中的梦"
    },
    {
      "ordinal": 19,
      "start_ms": 102339,
      "end_ms": 105899,
      "text": "不容置疑"
    },
    {
      "ordinal": 20,
      "start_ms": 107720,
      "end_ms": 116840,
      "text": "谁说梦里清晰的你看透了往昔"
    },
    {
      "ordinal": 21,
      "start_ms": 118610,
      "end_ms": 121510,
      "text": "谁说告别了你"
    },
    {
      "ordinal": 22,
      "start_ms": 121510,
      "end_ms": 127630,
      "text": "如今是我自己"
    },
    {
      "ordinal": 23,
      "start_ms": 129899,
      "end_ms": 135940,
      "text": "不必问少年有几多痴情"
    },
    {
      "ordinal": 24,
      "start_ms": 135940,
      "end_ms": 140040,
      "text": "成语丝雨如影随形"
    },
    {
      "ordinal": 25,
      "start_ms": 140140,
      "end_ms": 146320,
      "text": "不必问他乡是谁在忧伤"
    },
    {
      "ordinal": 26,
      "start_ms": 146540,
      "end_ms": 149440,
      "text": "谁说佳人望不输"
    },
    {
      "ordinal": 27,
      "start_ms": 149440,
      "end_ms": 151090,
      "text": "狂"
    },
    {
      "ordinal": 28,
      "start_ms": 151190,
      "end_ms": 153310,
      "text": "抢拍了你们自己调整的唱啊"
    },
    {
      "ordinal": 29,
      "start_ms": 153310,
      "end_ms": 155110,
      "text": "最后最后那个不必问抢拍"
    },
    {
      "ordinal": 30,
      "start_ms": 155110,
      "end_ms": 156040,
      "text": "你们自己调整一下"
    }
  ],
  "text": "这个是16年写的一首老词啊\n用的这个曲子呢是什么\n火云邪神的那个里面的啊\n几番风染层林如霜\n化作你人泪\n谁诉漂泊烟雨残身\n天寒秋来\n悠悠云飞月落何方不曾入梦中\n一是清理边角摘星\n浊酒注定\n小知晓当年又惨淡多情\n春雨不影\n如断如诗\n愿只愿他乡多\n忘却忧伤\n归时佳人亡故疏狂\n谁说赠与他人的心\n还得来正义\n谁说种在心中的梦\n不容置疑\n谁说梦里清晰的你看透了往昔\n谁说告别了你\n如今是我自己\n不必问少年有几多痴情\n成语丝雨如影随形\n不必问他乡是谁在忧伤\n谁说佳人望不输\n狂\n抢拍了你们自己调整的唱啊\n最后最后那个不必问抢拍\n你们自己调整一下",
  "timing_issue": null
}
