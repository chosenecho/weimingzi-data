  "content_sha256": "98ccec464c9a2b149935181c4e4ab52a2db747c27e6e5ab6e0686181819a171e",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 400,
      "end_ms": 4640,
      "text": "这个是一六年写的一首老词啊，"
    },
    {
      "ordinal": 1,
      "start_ms": 5760,
      "end_ms": 7120,
      "text": "用的这个曲子呢是什么？"
    },
    {
      "ordinal": 2,
      "start_ms": 7120,
      "end_ms": 9280,
      "text": "火云邪神的这个里面的啊。"
    },
    {
      "ordinal": 3,
      "start_ms": 20320,
      "end_ms": 23360,
      "text": "几番风染层林如"
    },
    {
      "ordinal": 4,
      "start_ms": 25840,
      "end_ms": 28560,
      "text": "霜，化作离人泪。"
    },
    {
      "ordinal": 5,
      "start_ms": 31120,
      "end_ms": 42240,
      "text": "谁诉漂泊烟雨残声？天寒秋冷。"
    },
    {
      "ordinal": 6,
      "start_ms": 42240,
      "end_ms": 50240,
      "text": "悠悠云回月落何方？不曾入梦中。"
    },
    {
      "ordinal": 7,
      "start_ms": 53040,
      "end_ms": 59920,
      "text": "已是锦里鬓角摘星，浊酒初停。"
    },
    {
      "ordinal": 8,
      "start_ms": 64240,
      "end_ms": 69200,
      "text": "笑只笑当年又惨淡多情，"
    },
    {
      "ordinal": 9,
      "start_ms": 70480,
      "end_ms": 73040,
      "text": "春雨不雨如断如续。"
    },
    {
      "ordinal": 10,
      "start_ms": 75280,
      "end_ms": 79040,
      "text": "怨只怨他乡多忘却忧伤，"
    },
    {
      "ordinal": 11,
      "start_ms": 80880,
      "end_ms": 84640,
      "text": "归时佳人望故疏狂。"
    },
    {
      "ordinal": 12,
      "start_ms": 86960,
      "end_ms": 93360,
      "text": "谁说赠与他人的心，换得来真意？"
    },
    {
      "ordinal": 13,
      "start_ms": 97040,
      "end_ms": 104240,
      "text": "谁说种在心中的梦，不容质疑？"
    },
    {
      "ordinal": 14,
      "start_ms": 108000,
      "end_ms": 115440,
      "text": "谁说梦里清晰的你，看透了往昔？"
    },
    {
      "ordinal": 15,
      "start_ms": 118880,
      "end_ms": 126240,
      "text": "谁说告别了你如今，是我自己？"
    },
    {
      "ordinal": 16,
      "start_ms": 130240,
      "end_ms": 133920,
      "text": "不必问少年有几多痴情，"
    },
    {
      "ordinal": 17,
      "start_ms": 136400,
      "end_ms": 138880,
      "text": "春雨似雨如影随形。"
    },
    {
      "ordinal": 18,
      "start_ms": 140480,
      "end_ms": 144800,
      "text": "不必问他乡是谁在忧伤？"
    },
    {
      "ordinal": 19,
      "start_ms": 146880,
      "end_ms": 150720,
      "text": "谁说佳人望故疏狂？"
    },
    {
      "ordinal": 20,
      "start_ms": 151520,
      "end_ms": 156000,
      "text": "抢拍了，你们自己调整的唱啊，最后最后那个不必问抢拍，你们自己调整一下。"
    }
  ],
  "text": "这个是一六年写的一首老词啊，\n用的这个曲子呢是什么？\n火云邪神的这个里面的啊。\n几番风染层林如\n霜，化作离人泪。\n谁诉漂泊烟雨残声？天寒秋冷。\n悠悠云回月落何方？不曾入梦中。\n已是锦里鬓角摘星，浊酒初停。\n笑只笑当年又惨淡多情，\n春雨不雨如断如续。\n怨只怨他乡多忘却忧伤，\n归时佳人望故疏狂。\n谁说赠与他人的心，换得来真意？\n谁说种在心中的梦，不容质疑？\n谁说梦里清晰的你，看透了往昔？\n谁说告别了你如今，是我自己？\n不必问少年有几多痴情，\n春雨似雨如影随形。\n不必问他乡是谁在忧伤？\n谁说佳人望故疏狂？\n抢拍了，你们自己调整的唱啊，最后最后那个不必问抢拍，你们自己调整一下。",
  "timing_issue": null
}
