{"segments":[{"start":0.22,"end":4.84,"text":"这个是16年写的一首老词啊"},{"start":5.26,"end":7.12,"text":"用的这个曲子呢是什么"},{"start":7.12,"end":9.52,"text":"火云邪神的那个里面的啊"},{"start":20.04,"end":24.82,"text":"几番风染层林如霜"},{"start":25.5,"end":29.06,"text":"化作你人泪"},{"start":30.9,"end":35.72,"text":"谁诉漂泊烟雨残身"},{"start":36.36,"end":39.98,"text":"天寒秋来"},{"start":41.79,"end":50.79,"text":"悠悠云飞月落何方不曾入梦中"},{"start":52.65,"end":57.44,"text":"一是清理边角摘星"},{"start":58.14,"end":61.64,"text":"浊酒注定"},{"start":63.95,"end":69.88,"text":"小知晓当年又惨淡多情"},{"start":69.88,"end":71.53,"text":"春雨不影"},{"start":71.53,"end":74.3,"text":"如断如诗"},{"start":74.9,"end":77.8,"text":"愿只愿他乡多"},{"start":77.8,"end":80.38,"text":"忘却忧伤"},{"start":80.56,"end":85.14,"text":"归时佳人亡故疏狂"},{"start":86.54,"end":90.88,"text":"谁说赠与他人的心"},{"start":91.5,"end":94.94,"text":"还得来正义"},{"start":96.84,"end":101.759,"text":"谁说种在心中的梦"},{"start":102.339,"end":105.899,"text":"不容置疑"},{"start":107.72,"end":116.84,"text":"谁说梦里清晰的你看透了往昔"},{"start":118.61,"end":121.51,"text":"谁说告别了你"},{"start":121.51,"end":127.63,"text":"如今是我自己"},{"start":129.899,"end":135.94,"text":"不必问少年有几多痴情"},{"start":135.94,"end":140.04,"text":"成语丝雨如影随形"},{"start":140.14,"end":146.32,"text":"不必问他乡是谁在忧伤"},{"start":146.54,"end":149.44,"text":"谁说佳人望不输"},{"start":149.44,"end":151.09,"text":"狂"},{"start":151.19,"end":153.31,"text":"抢拍了你们自己调整的唱啊"},{"start":153.31,"end":155.11,"text":"最后最后那个不必问抢拍"},{"start":155.11,"end":156.04,"text":"你们自己调整一下"}],"source":"subtitle"}
