    {
      "ordinal": 36,
      "start_ms": 144899,
      "end_ms": 147300,
      "text": "要做自宫螺丝"
    },
    {
      "ordinal": 37,
      "start_ms": 148439,
      "end_ms": 149359,
      "text": "不要做"
    },
    {
      "ordinal": 38,
      "start_ms": 150679,
      "end_ms": 153680,
      "text": "不要做断了头的"
    },
    {
      "ordinal": 39,
      "start_ms": 155219,
      "end_ms": 160580,
      "text": "也就是说不要做自宫螺丝"
    },
    {
      "ordinal": 40,
      "start_ms": 161640,
      "end_ms": 162920,
      "text": "断了头的"
    },
    {
      "ordinal": 41,
      "start_ms": 163940,
      "end_ms": 168079,
      "text": "等着等着一个位置掉进去的"
    },
    {
      "ordinal": 42,
      "start_ms": 168079,
      "end_ms": 169099,
      "text": "等着一个洞"
    },
    {
      "ordinal": 43,
      "start_ms": 169099,
      "end_ms": 171960,
      "text": "等一个洞掉进去的"
    },
    {
      "ordinal": 44,
      "start_ms": 174779,
      "end_ms": 176760,
      "text": "啊有一个自宫螺丝"
    },
    {
      "ordinal": 45,
      "start_ms": 178439,
      "end_ms": 179659,
      "text": "我们要做自宫了"
    },
    {
      "ordinal": 46,
      "start_ms": 179659,
      "end_ms": 181320,
      "text": "螺丝啊"
    },
    {
      "ordinal": 47,
      "start_ms": 183219,
      "end_ms": 185639,
      "text": "做自宫螺丝意味着两点"
    },
    {
      "ordinal": 48,
      "start_ms": 186839,
      "end_ms": 191459,
      "text": "首先你要你看这个头是尖的尖"
    },
    {
      "ordinal": 49,
      "start_ms": 191459,
      "end_ms": 192389,
      "text": "如一根刺"
    },
    {
      "ordinal": 50,
      "start_ms": 192389,
      "end_ms": 194129,
      "text": "你要有这个刺头"
    },
    {
      "ordinal": 51,
      "start_ms": 194129,
      "end_ms": 195700,
      "text": "要有这个刺性"
    },
    {
      "ordinal": 52,
      "start_ms": 196600,
      "end_ms": 197760,
      "text": "你要是一个次"
    },
    {
      "ordinal": 53,
      "start_ms": 199500,
      "end_ms": 201740,
      "text": "其次你要有你的螺纹呐"
    },
    {
      "ordinal": 54,
      "start_ms": 205219,
      "end_ms": 206920,
      "text": "螺纹纹理"
    },
    {
      "ordinal": 55,
      "start_ms": 207820,
      "end_ms": 209640,
      "text": "我们先说这个刺头啊"
    },
    {
      "ordinal": 56,
      "start_ms": 209640,
      "end_ms": 211890,
      "text": "理想你是一个刺头"
    },
    {
      "ordinal": 57,
      "start_ms": 211890,
      "end_ms": 212880,
      "text": "意味着"
    },
    {
      "ordinal": 58,
      "start_ms": 214600,
      "end_ms": 216630,
      "text": "你敢于去戳破"
    },
    {
      "ordinal": 59,
      "start_ms": 216630,
      "end_ms": 221100,
      "text": "敢于去戳破这个啊局面当中"
    },
    {
      "ordinal": 60,
      "start_ms": 223440,
      "end_ms": 226630,
      "text": "不合理的啊"
    },
    {
      "ordinal": 61,
      "start_ms": 226630,
      "end_ms": 230800,
      "text": "敢于去自己去找到他的软肋啊"
    },
    {
      "ordinal": 62,
      "start_ms": 230800,
      "end_ms": 232120,
      "text": "找到他的软肋"
    },
    {
      "ordinal": 63,
      "start_ms": 233119,
      "end_ms": 237360,
      "text": "然后去啊自己创造缝隙"
    },
    {
      "ordinal": 64,
      "start_ms": 239459,
      "end_ms": 242380,
      "text": "找寻找人类创造缝隙啊"
    },
    {
      "ordinal": 65,
      "start_ms": 244100,
      "end_ms": 245080,
      "text": "软肋"
    },
    {
      "ordinal": 66,
      "start_ms": 245080,
      "end_ms": 246580,
      "text": "寻找软肋"
    },
    {
      "ordinal": 67,
      "start_ms": 246580,
      "end_ms": 247980,
      "text": "创造缝隙"
    },
    {
      "ordinal": 68,
      "start_ms": 249160,
      "end_ms": 251280,
      "text": "有这个勇气"
    },
    {
      "ordinal": 69,
      "start_ms": 251280,
      "end_ms": 253300,
      "text": "有这个胆量"
    },
    {
      "ordinal": 70,
      "start_ms": 255540,
      "end_ms": 256519,
      "text": "有这个勇气"
    },
    {
      "ordinal": 71,
      "start_ms": 256519,
      "end_ms": 257810,
      "text": "有这个胆量"
    },
    {
      "ordinal": 72,
      "start_ms": 257810,
      "end_ms": 260060,
      "text": "由于你具有这种次性啊"
    },
    {
      "ordinal": 73,
      "start_ms": 260060,
      "end_ms": 261050,
      "text": "刺头性"
    },
    {
      "ordinal": 74,
      "start_ms": 261050,
      "end_ms": 265480,
      "text": "所以你不是行尸走肉"
    },
    {
      "ordinal": 75,
      "start_ms": 265480,
      "end_ms": 267580,
      "text": "当你在刺入进去之前啊"
    },
    {
      "ordinal": 76,
      "start_ms": 267580,
      "end_ms": 269320,
      "text": "你不是行尸走肉"
