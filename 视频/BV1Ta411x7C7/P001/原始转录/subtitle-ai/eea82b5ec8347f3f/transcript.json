  "segments": [
    {
      "ordinal": 0,
      "start_ms": 120,
      "end_ms": 3420,
      "text": "今天要来讲一个比喻"
    },
    {
      "ordinal": 1,
      "start_ms": 4440,
      "end_ms": 6040,
      "text": "要讲一个比喻"
    },
    {
      "ordinal": 2,
      "start_ms": 12800,
      "end_ms": 14500,
      "text": "要成为什么样的人"
    },
    {
      "ordinal": 3,
      "start_ms": 15540,
      "end_ms": 16580,
      "text": "我有个比喻"
    },
    {
      "ordinal": 4,
      "start_ms": 16580,
      "end_ms": 18440,
      "text": "要做螺丝钉对吧"
    },
    {
      "ordinal": 5,
      "start_ms": 18440,
      "end_ms": 19320,
      "text": "要做"
    },
    {
      "ordinal": 6,
      "start_ms": 21060,
      "end_ms": 22400,
      "text": "螺丝钉"
    },
    {
      "ordinal": 7,
      "start_ms": 35060,
      "end_ms": 36460,
      "text": "我认为这不够"
    },
    {
      "ordinal": 8,
      "start_ms": 37600,
      "end_ms": 40459,
      "text": "螺丝钉的话有个前提啊"
    },
    {
      "ordinal": 9,
      "start_ms": 40640,
      "end_ms": 42530,
      "text": "做螺丝钉的话"
    },
    {
      "ordinal": 10,
      "start_ms": 42530,
      "end_ms": 43940,
      "text": "是不是这个螺还是个螺"
    },
    {
      "ordinal": 11,
      "start_ms": 43940,
      "end_ms": 46760,
      "text": "不管做螺丝钉有个前提"
    },
    {
      "ordinal": 12,
      "start_ms": 46860,
      "end_ms": 50100,
      "text": "你可以很自然的做螺丝钉的一个前提"
    },
    {
      "ordinal": 13,
      "start_ms": 50100,
      "end_ms": 54459,
      "text": "就是这个啊这个孔啊"
    },
    {
      "ordinal": 14,
      "start_ms": 55720,
      "end_ms": 57210,
      "text": "这里面的孔"
    },
    {
      "ordinal": 15,
      "start_ms": 57210,
      "end_ms": 62160,
      "text": "这里面的这些位置位置啊"
    },
    {
      "ordinal": 16,
      "start_ms": 69060,
      "end_ms": 70830,
      "text": "符合天然的"
    },
    {
      "ordinal": 17,
      "start_ms": 78500,
      "end_ms": 80680,
      "text": "那么在那样的理想社会之下"
    },
    {
      "ordinal": 18,
      "start_ms": 80680,
      "end_ms": 81880,
      "text": "天然理想社会之下"
    },
    {
      "ordinal": 19,
      "start_ms": 81880,
      "end_ms": 83620,
      "text": "我说我们愿意啊"
    },
    {
      "ordinal": 20,
      "start_ms": 83620,
      "end_ms": 85820,
      "text": "直接的做一个螺丝钉"
    },
    {
      "ordinal": 21,
      "start_ms": 86040,
      "end_ms": 87900,
      "text": "当然服从安排"
    },
    {
      "ordinal": 22,
      "start_ms": 87900,
      "end_ms": 90800,
      "text": "做一个直接的螺丝钉可以"
    },
    {
      "ordinal": 23,
      "start_ms": 91540,
      "end_ms": 93270,
      "text": "那么如果不是这样的话"
    },
    {
      "ordinal": 24,
      "start_ms": 93270,
      "end_ms": 96870,
      "text": "如果是还还处在一个现实"
    },
    {
      "ordinal": 25,
      "start_ms": 96870,
      "end_ms": 100380,
      "text": "像像理想去运动的"
    },
    {
      "ordinal": 26,
      "start_ms": 101100,
      "end_ms": 105660,
      "text": "处在一个现实向理想运动的一个过程当中的话"
    },
    {
      "ordinal": 27,
      "start_ms": 105780,
      "end_ms": 107820,
      "text": "唉我们依然要做螺丝钉"
    },
    {
      "ordinal": 28,
      "start_ms": 107820,
      "end_ms": 110780,
      "text": "但是我们不能做一般的螺丝钉"
    },
    {
      "ordinal": 29,
      "start_ms": 111860,
      "end_ms": 118310,
      "text": "我们要做一个有刺头的螺丝钉啊"
    },
    {
      "ordinal": 30,
      "start_ms": 118310,
      "end_ms": 122840,
      "text": "那么有刺头的螺丝钉能用我们的行话说"
    },
    {
      "ordinal": 31,
      "start_ms": 122840,
      "end_ms": 124380,
      "text": "就是要做一个"
    },
    {
      "ordinal": 32,
      "start_ms": 126580,
      "end_ms": 128100,
      "text": "自宫螺丝"
    },
    {
      "ordinal": 33,
      "start_ms": 132499,
      "end_ms": 135460,
      "text": "啊要做一个自宫螺丝"
    },
    {
      "ordinal": 34,
      "start_ms": 139920,
      "end_ms": 142560,
      "text": "这就是我们今天要讲的"
    },
    {
      "ordinal": 35,
      "start_ms": 142560,
      "end_ms": 144580,
      "text": "要做自宫螺丝"
