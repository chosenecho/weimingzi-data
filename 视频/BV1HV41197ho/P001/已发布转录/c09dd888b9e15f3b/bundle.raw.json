{"segments":[{"start":0.4,"end":6.96,"text":"今天我们要来结合现实啊"},{"start":6.96,"end":13.5,"text":"结合目前的状况来讲一首李世民的诗啊"},{"start":13.5,"end":14.955,"text":"李世民的诗"},{"start":18.28,"end":20.64,"text":"李世民的郑筱宇啊"},{"start":21.96,"end":25.2,"text":"那么他的原文是"},{"start":26.08,"end":30.92,"text":"疾风知劲草"},{"start":33.22,"end":35.4,"text":"板凳"},{"start":37.72,"end":43.519,"text":"呃至成陈啊"},{"start":43.519,"end":48.97,"text":"前面两句这个这个这个十应该念字啊"},{"start":48.97,"end":54.98,"text":"他应该是那个去声平水韵里面应该是去声的字"},{"start":54.98,"end":56.15,"text":"标记的意思"},{"start":56.15,"end":60.12,"text":"记也标记的意思啊"},{"start":60.12,"end":62.59,"text":"就板凳啊"},{"start":62.59,"end":64.42,"text":"天下动荡的时候"},{"start":64.42,"end":67.69,"text":"能够标记出谁是臣臣啊"},{"start":67.69,"end":72.58,"text":"谁是想要让这个天下恢复安宁的啊"},{"start":75.46,"end":77.0,"text":"然后"},{"start":79.42,"end":82.44,"text":"后面两句其实不是特别为人所知啊"},{"start":82.44,"end":85.5,"text":"勇夫安识"},{"start":85.5,"end":87.45,"text":"这个应该念十啊"},{"start":87.45,"end":91.08,"text":"时知道时写的"},{"start":91.08,"end":92.49,"text":"他应该是入声字"},{"start":92.49,"end":96.14,"text":"按时一啊"},{"start":96.14,"end":99.44,"text":"最后一句是智者"},{"start":100.4,"end":102.88,"text":"比以怀仁"},{"start":104.08,"end":105.58,"text":"勇夫安识义"},{"start":105.58,"end":107.699,"text":"智者必怀仁"},{"start":107.699,"end":110.819,"text":"我们先来讲前面两句啊"},{"start":110.819,"end":111.779,"text":"前面两句"},{"start":111.779,"end":113.219,"text":"疾风之疾"},{"start":113.219,"end":113.879,"text":"风知劲"},{"start":113.879,"end":116.88,"text":"草板荡至沉沉啊"},{"start":117.78,"end":120.37,"text":"疾风知劲草呃"},{"start":120.37,"end":123.4,"text":"这个东西呢实事求是讲呃"},{"start":123.4,"end":127.45,"text":"目前一些据说他的言论"},{"start":127.45,"end":130.24,"text":"那其实和意识形态相冲突的"},{"start":130.24,"end":133.649,"text":"和我们的意识形态底色相冲突的"},{"start":134.049,"end":139.92,"text":"那么在经济或者说这个"},{"start":141.32,"end":143.56,"text":"啊发展上略有困顿"},{"start":143.56,"end":145.15,"text":"略有挫折的时候"},{"start":145.15,"end":147.01,"text":"还不能算疾风呢"},{"start":147.01,"end":150.3,"text":"就知道这些人啊啊是"},{"start":151.25,"end":154.45,"text":"他们的心思可以啊"},{"start":154.45,"end":155.89,"text":"有二心啊"},{"start":155.89,"end":158.66,"text":"这些人可以说是有二心的"},{"start":158.66,"end":162.58,"text":"很明显是有二星的啊"},{"start":162.58,"end":164.32,"text":"说话方式阴阳怪气的"},{"start":164.32,"end":169.36,"text":"而且比如说呃这个马前卒"},{"start":169.36,"end":175.09,"text":"这个我可以说是以身犯险"},{"start":175.09,"end":177.91,"text":"已经是非常明确民事的"},{"start":177.91,"end":182.39,"text":"在也要提醒他或者怎么样的"},{"start":182.39,"end":184.4,"text":"他还要那样去冲他"},{"start":184.4,"end":188.12,"text":"一而再再而三的抨击"},{"start":189.94,"end":191.1,"text":"其实到老实说"},{"start":191.1,"end":193.38,"text":"主要他抨击的两个点"},{"start":193.38,"end":198.25,"text":"那都是可以说是别有用心"},{"start":199.38,"end":200.66,"text":"针对性很强"},{"start":200.66,"end":201.32,"text":"别有用心"},{"start":201.32,"end":203.33,"text":"针对性很强啊"},{"start":203.33,"end":205.85,"text":"然后还有一些持续曝光"},{"start":205.85,"end":210.79,"text":"刻意去曝光或者挑唆社会的阴暗面的"},{"start":210.79,"end":215.78,"text":"那么这些家伙呢可以叫做啊"},{"start":215.94,"end":219.74,"text":"可以甚至缓风之烂草啊"},{"start":219.74,"end":221.36,"text":"那个简单来讲啊"},{"start":221.36,"end":222.86,"text":"这个风吹的并不快"},{"start":222.86,"end":227.56,"text":"但是他们啊屁股都已经露出来了"},{"start":227.56,"end":232.51,"text":"然后下面一句叫板荡至沉沉啊"},{"start":232.51,"end":241.34,"text":"这个情况就是啊这个情况反正你也懂的"},{"start":241.34,"end":242.96,"text":"大家明白这是什么意思啊"},{"start":243.98,"end":247.22,"text":"就是局势稍有不利"},{"start":247.22,"end":252.16,"text":"局势稍有顿挫"},{"start":255.88,"end":257.13,"text":"稍有顿挫"},{"start":257.13,"end":261.12,"text":"比如说最近就有人唱空这个股市"},{"start":261.12,"end":263.25,"text":"但实际上我们都知道呃"},{"start":263.25,"end":268.07,"text":"就是你对于经济了解比较充分的人"},{"start":268.07,"end":270.23,"text":"应当知道"},{"start":272.28,"end":278.009,"text":"老实说我们呃我们简单来讲一下"},{"start":278.009,"end":280.8,"text":"我们觉得股市嗯"},{"start":280.8,"end":285.94,"text":"就是说它和经济的大的基本面的关系啊"},{"start":285.94,"end":287.41,"text":"啊并不大"},{"start":287.41,"end":288.4,"text":"股市的好坏"},{"start":288.4,"end":291.79,"text":"并不等于经济本身的基本面的好坏啊"},{"start":291.79,"end":298.16,"text":"他只是说我们反倒就说你们知道有一个行"},{"start":298.16,"end":300.5,"text":"就专门就是帮别人做上市的"},{"start":300.5,"end":301.61,"text":"有一个行当"},{"start":301.61,"end":303.08,"text":"有一个行当"},{"start":303.08,"end":307.68,"text":"我曾经认识一些在另外一个省份"},{"start":307.68,"end":309.27,"text":"隔壁省份的专门"},{"start":309.27,"end":312.54,"text":"然后他是去上海去帮别人做上市的"},{"start":312.54,"end":313.62,"text":"就说穿了"},{"start":313.62,"end":317.09,"text":"就是说拿到足够多的筹码之后"},{"start":317.09,"end":322.18,"text":"就可以按照一定的游戏规则割割韭菜啊"},{"start":322.46,"end":324.04,"text":"专门做做上市的包"},{"start":324.04,"end":326.07,"text":"别人做上市的那个家伙"},{"start":326.07,"end":327.81,"text":"所以在这里上股市"},{"start":327.81,"end":330.87,"text":"其实和基本面是有很大程度上脱离的"},{"start":330.87,"end":334.47,"text":"很大程度上脱离脱离可以说是蛮严重的"},{"start":334.47,"end":337.31,"text":"他的脱离是相当严重的"},{"start":337.83,"end":343.58,"text":"因为因为首先就是说呃融资上市上市之后"},{"start":343.58,"end":348.11,"text":"他的很多就是遇到他刻意叫做做上市嘛啊"},{"start":348.11,"end":350.36,"text":"一下子就是有很多大额的现金"},{"start":350.36,"end":351.23,"text":"怎么怎么样的"},{"start":351.23,"end":352.61,"text":"这个我们就不细谈了"},{"start":352.61,"end":357.34,"text":"这个东西是个灰尘灰色的灰色的啊"},{"start":357.425,"end":359.11,"text":"大家不要去搞这个事"},{"start":359.11,"end":362.81,"text":"另外一方面就是说股票"},{"start":362.81,"end":365.9,"text":"股市总的来说是用来融资的"},{"start":365.9,"end":369.039,"text":"用来融资的啊"},{"start":369.039,"end":372.86,"text":"但是说由于呢你光有钱"},{"start":372.86,"end":376.91,"text":"而不能让各种生产要素啊得到一个良性的结合"},{"start":376.91,"end":379.1,"text":"一个这个均衡的配置的话"},{"start":379.1,"end":381.72,"text":"其实你也做不出新的产业啊"},{"start":381.72,"end":382.68,"text":"你要有创新"},{"start":382.68,"end":383.34,"text":"要有人才"},{"start":383.34,"end":384.0,"text":"对不对"},{"start":384.0,"end":385.89,"text":"要有政策落地的空间"},{"start":385.89,"end":386.67,"text":"是不是"},{"start":386.67,"end":389.72,"text":"所以他这个股市光融到钱"},{"start":390.06,"end":392.9,"text":"单融资单单是融资而言"},{"start":392.9,"end":395.3,"text":"它是只强调这个面向的话"},{"start":395.3,"end":397.77,"text":"会使得它的投机性比较强啊"},{"start":397.77,"end":399.75,"text":"投进比较强比较重啊"},{"start":399.75,"end":401.37,"text":"他所谓的2亿股民"},{"start":401.37,"end":403.96,"text":"2亿股民里面搞搞长线"},{"start":403.96,"end":406.48,"text":"说我看好某个产业"},{"start":406.48,"end":409.0,"text":"然后是帮助这个企业融资"},{"start":409.0,"end":413.269,"text":"然后我就指望着他分红的啊"},{"start":413.269,"end":415.789,"text":"你很少很少很少啊"},{"start":415.789,"end":418.94,"text":"我觉得很多人还是投机性啊"},{"start":419.054,"end":422.27,"text":"绝大部分投机性的小散的"},{"start":422.27,"end":424.58,"text":"然后就跟做期货差不多的"},{"start":424.58,"end":426.2,"text":"你知道吗"},{"start":426.69,"end":429.44,"text":"呃所以股市本身不能代表基本面"},{"start":429.44,"end":432.89,"text":"所以你也不能说现在就是什么板荡之势啊"},{"start":432.89,"end":434.07,"text":"经济基本面"},{"start":434.07,"end":437.61,"text":"我的判断我认为是没有特别大问题的"},{"start":437.61,"end":439.81,"text":"是向好的板凳"},{"start":439.81,"end":443.89,"text":"所以说让板凳你也不能说什么就标记出了"},{"start":443.89,"end":447.69,"text":"但是实际上是板凳志沉沉"},{"start":447.69,"end":453.419,"text":"他是能够把这些心思陈"},{"start":453.419,"end":458.38,"text":"就是说他是渴望的天下太平了啊"},{"start":458.38,"end":460.06,"text":"他是追求天下太平了"},{"start":460.06,"end":464.679,"text":"是一心追求天下太平啊"},{"start":465.319,"end":468.159,"text":"啊啊不是说有另有所图谋"},{"start":468.159,"end":469.659,"text":"某些私欲啊"},{"start":469.659,"end":471.55,"text":"某些就是说野心啊"},{"start":471.55,"end":473.11,"text":"所以他能够标记出来"},{"start":473.11,"end":474.04,"text":"在这种情况下"},{"start":474.04,"end":475.36,"text":"你的一举一动"},{"start":475.36,"end":478.02,"text":"你的行为是落井下石"},{"start":478.02,"end":485.38,"text":"是是想要怎么样想要这个啊啊煽风点火"},{"start":485.38,"end":487.36,"text":"还是想要追求天下太平"},{"start":487.36,"end":489.49,"text":"是能区分的出来的啊"},{"start":489.49,"end":492.31,"text":"区分出来这两句就是说大面上这样讲啊"},{"start":492.31,"end":493.3,"text":"大面上这样讲"},{"start":493.3,"end":497.04,"text":"那么就说这个鱼钩弓的这面"},{"start":497.04,"end":499.26,"text":"这两句的愚公的这面我讲完了"},{"start":499.26,"end":500.83,"text":"那么鱼丝的这一面呢"},{"start":500.83,"end":503.32,"text":"鱼丝的这一面疾风知劲"},{"start":503.32,"end":505.21,"text":"草板荡至沉沉"},{"start":505.21,"end":506.41,"text":"鱼丝的这一面"},{"start":506.41,"end":507.85,"text":"我要感谢一下"},{"start":507.85,"end":509.36,"text":"感谢啊"},{"start":509.36,"end":511.43,"text":"一直为我们提供帮助啊"},{"start":511.43,"end":513.99,"text":"提供支持的伙伴啊"},{"start":513.99,"end":517.65,"text":"好感谢给我们提供设计啊"},{"start":517.65,"end":518.669,"text":"法律资源"},{"start":518.669,"end":519.69,"text":"法源啊"},{"start":519.69,"end":522.549,"text":"还有这个技术啊"},{"start":522.549,"end":526.089,"text":"以及以及我们老师说"},{"start":526.089,"end":529.389,"text":"以及就是说在各地独自奋斗着的啊"},{"start":529.389,"end":533.21,"text":"独自奋斗努力着的认同我们的理念"},{"start":533.21,"end":536.27,"text":"独自奋斗努力着的朋友"},{"start":536.27,"end":538.38,"text":"独自奋斗努力着朋友"},{"start":538.38,"end":541.26,"text":"我不可能说指挥你们做什么事情"},{"start":541.26,"end":543.81,"text":"我不可能说是安排你们做什么事情"},{"start":543.81,"end":546.24,"text":"你们和我没有上下级的关系啊"},{"start":546.24,"end":548.32,"text":"但是呃如果你们办好"},{"start":548.32,"end":549.97,"text":"我呃"},{"start":549.97,"end":551.59,"text":"我向你们敬一杯酒啊"},{"start":551.59,"end":554.74,"text":"我就说有机会还还到时候啊"},{"start":554.74,"end":559.18,"text":"你们都以我的省各地的粉丝粉丝团啊自居嘛"},{"start":559.18,"end":561.53,"text":"我还去那边吃顿饭啊"},{"start":561.53,"end":563.9,"text":"这个叫做鱼私"},{"start":563.9,"end":569.0,"text":"我这一方面我的这个影响力所涉及的范围"},{"start":569.0,"end":570.32,"text":"就是要鼓励大家"},{"start":570.32,"end":571.97,"text":"感谢和鼓励大家"},{"start":571.97,"end":573.38,"text":"鼓励大家"},{"start":573.38,"end":576.64,"text":"叫你们也不是我的臣子"},{"start":576.64,"end":577.36,"text":"这个臣来说"},{"start":577.36,"end":579.19,"text":"大家都是我们不是臣子"},{"start":579.19,"end":581.08,"text":"我们都是为人民服务嘛"},{"start":581.08,"end":581.38,"text":"对不对"},{"start":583.96,"end":586.05,"text":"这个事业做贡献做努力"},{"start":586.05,"end":588.57,"text":"这个成呢你就说说努力的人"},{"start":588.57,"end":589.83,"text":"努力做事的事"},{"start":589.83,"end":591.87,"text":"做事的人"},{"start":592.669,"end":594.969,"text":"正儿八经正儿八经做事啊"},{"start":596.829,"end":601.09,"text":"没有说是这个啊装模作样的"},{"start":601.09,"end":604.629,"text":"是确实是在呃寻找这个啊"},{"start":604.629,"end":605.889,"text":"让自己生活过起来"},{"start":605.889,"end":608.949,"text":"让自己能够在社会上弘扬正能量啊"},{"start":608.949,"end":610.329,"text":"正能量这个词就不说了"},{"start":610.329,"end":613.03,"text":"这个词的我们都不太喜欢用啊"},{"start":613.03,"end":617.25,"text":"因为他的那个啊好"},{"start":617.25,"end":620.7,"text":"就这两方面刚才讲过了啊"},{"start":620.7,"end":622.65,"text":"因为其实我们也感受到了"},{"start":622.65,"end":627.76,"text":"也就是说比如说我们这个餐饮店本地的这个啊"},{"start":627.76,"end":630.13,"text":"会员顾客还有的失业了"},{"start":630.13,"end":633.82,"text":"他这个呃经济并不是特别宽裕的"},{"start":633.82,"end":635.38,"text":"他还过来支持我们啊"},{"start":635.38,"end":636.61,"text":"还是过来支持我们"},{"start":636.61,"end":637.69,"text":"非常感谢啊"},{"start":637.69,"end":638.56,"text":"非常感激"},{"start":638.56,"end":642.49,"text":"然后我们主要讲的就是后面这个勇夫安识义"},{"start":642.49,"end":644.23,"text":"有智者必怀仁"},{"start":644.23,"end":645.31,"text":"后面这两句"},{"start":645.31,"end":651.67,"text":"这两句我觉得就是都呃论家都把它解读错了"},{"start":651.67,"end":659.68,"text":"永夫安石E啊"},{"start":659.68,"end":661.78,"text":"智者"},{"start":663.22,"end":664.98,"text":"B怀仁"},{"start":667.14,"end":672.13,"text":"啊自古以来的论者或者我在我觉得那些腐儒啊"},{"start":672.13,"end":673.57,"text":"无知之之徒啊"},{"start":673.57,"end":677.2,"text":"都会把上面变成一个反问句"},{"start":677.36,"end":680.14,"text":"反问句后面变成一个判断句"},{"start":681.76,"end":683.5,"text":"或者后面变成一个陈述句"},{"start":683.5,"end":685.13,"text":"判断句"},{"start":686.46,"end":688.94,"text":"这个在我看来是大大的错误"},{"start":688.94,"end":690.5,"text":"他们就会把它解解读成"},{"start":690.5,"end":694.99,"text":"就是说那些空有一空有一腔之勇的人"},{"start":694.99,"end":699.01,"text":"怎么能够认识到大义的所在呢"},{"start":699.01,"end":704.05,"text":"而那些智者才一定是会怀有仁慈之心的啊"},{"start":704.05,"end":707.75,"text":"怀有仁慈的心中总是有这个仁慈"},{"start":707.75,"end":711.35,"text":"就把上半句变成就是勇夫都不懂得大义"},{"start":711.35,"end":712.01,"text":"不识大义"},{"start":712.01,"end":713.69,"text":"那么智者是必知啊"},{"start":713.69,"end":717.07,"text":"这个仁仁仁慈这个上面的反问句"},{"start":717.07,"end":718.99,"text":"下面就是一点一包嘛"},{"start":718.99,"end":720.88,"text":"他认为下面上面是扁"},{"start":720.88,"end":722.88,"text":"下面是包"},{"start":723.34,"end":724.26,"text":"那么在我看来"},{"start":724.26,"end":726.0,"text":"这是一个庸俗的解读"},{"start":726.0,"end":727.2