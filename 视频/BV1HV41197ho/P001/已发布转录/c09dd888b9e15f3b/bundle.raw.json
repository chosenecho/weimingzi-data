2298.22,"text":"我有私心的"},{"start":2298.22,"end":2302.549,"text":"这个是老说咎由自取"},{"start":2302.549,"end":2304.679,"text":"但是你年纪小"},{"start":2304.679,"end":2310.0,"text":"我们都把你当成是小孩子啊"},{"start":2310.0,"end":2311.65,"text":"对于小孩子来说"},{"start":2311.65,"end":2313.36,"text":"老实说都是仁慈啊"},{"start":2314.62,"end":2317.279,"text":"有的是认识了好多年的朋友"},{"start":2317.279,"end":2319.019,"text":"我们认识很多年的朋友"},{"start":2319.019,"end":2321.399,"text":"都在反过来在劝阻"},{"start":2321.399,"end":2324.519,"text":"趁着天还是饶了他吧"},{"start":2324.519,"end":2325.629,"text":"饶了这个小孩吧"},{"start":2325.629,"end":2331.3,"text":"饶了这个这个这个小孩很多很多年的朋友"},{"start":2331.3,"end":2332.74,"text":"不要再深究下去"},{"start":2332.74,"end":2333.82,"text":"不要再深究下去"},{"start":2333.82,"end":2335.92,"text":"有的东西不值得深究"},{"start":2335.92,"end":2338.55,"text":"不要不要再深究下去"},{"start":2339.01,"end":2341.25,"text":"所以在这样上意义上讲"},{"start":2342.27,"end":2344.25,"text":"我觉得我还是仁慈啊"},{"start":2344.25,"end":2346.95,"text":"相对是非常仁慈"},{"start":2348.42,"end":2350.27,"text":"你不识大意啊"},{"start":2350.27,"end":2351.26,"text":"没办法"},{"start":2351.26,"end":2356.54,"text":"但是我们就是说不要跳太高"},{"start":2356.54,"end":2359.87,"text":"跳太高摔下来会摔得更惨的"},{"start":2361.01,"end":2364.68,"text":"所以这个与诸位共勉啊"},{"start":2364.68,"end":2371.48,"text":"勇夫安石意智者"},{"start":2372.98,"end":2375.24,"text":"毕怀仁"},{"start":2375.88,"end":2379.05,"text":"如果你这个勇夫能够产生这个我"},{"start":2379.05,"end":2382.23,"text":"我要去哪里认识大义"},{"start":2382.23,"end":2384.27,"text":"如果你有这份心在"},{"start":2384.27,"end":2387.21,"text":"有这个有这个意向性"},{"start":2387.21,"end":2388.71,"text":"有这个意象在啊"},{"start":2388.71,"end":2391.05,"text":"但凡你有这个意向时"},{"start":2391.05,"end":2394.53,"text":"得天下大义所在的这个意象"},{"start":2397.06,"end":2398.88,"text":"曹操都不一定会斩你的头"},{"start":2398.88,"end":2399.69,"text":"对不对"},{"start":2399.69,"end":2401.55,"text":"你是个吕布"},{"start":2401.71,"end":2404.28,"text":"只要你想要知道天下大义何在"},{"start":2404.28,"end":2405.93,"text":"而不是说就是要征伐"},{"start":2405.93,"end":2406.65,"text":"要杀人"},{"start":2406.65,"end":2408.39,"text":"吕布给曹操开出来"},{"start":2408.39,"end":2411.24,"text":"就说你将步兵"},{"start":2411.24,"end":2412.08,"text":"我将起兵"},{"start":2412.08,"end":2416.7,"text":"天下一鼓而当不识大义嘛"},{"start":2416.7,"end":2421.08,"text":"天下不能不能长久的经受刀割了"},{"start":2421.08,"end":2422.86,"text":"对我是曹操"},{"start":2422.86,"end":2423.82,"text":"我也一下子把他砍了"},{"start":2423.82,"end":2425.02,"text":"对不对啊"},{"start":2426.28,"end":2427.98,"text":"对不对啊"},{"start":2429.02,"end":2433.9,"text":"你只要你能够还能够发起一个问题"},{"start":2433.9,"end":2436.61,"text":"去追问大义何在"},{"start":2436.61,"end":2438.35,"text":"天下的大义何在"},{"start":2438.35,"end":2442.18,"text":"那我觉得对你的生死啊"},{"start":2442.18,"end":2443.77,"text":"对于你的生死"},{"start":2443.77,"end":2447.08,"text":"你的生死之病操之人手啊"},{"start":2447.08,"end":2451.319,"text":"我觉得我们这些智者"},{"start":2451.319,"end":2453.299,"text":"我们这些智者"},{"start":2453.299,"end":2458.34,"text":"还是对于你怀有一定的仁慈之心的"},{"start":2458.92,"end":2459.72,"text":"这个话"},{"start":2461.34,"end":2463.05,"text":"你听了再难听"},{"start":2463.05,"end":2465.06,"text":"你也要听"},{"start":2467.64,"end":2470.28,"text":"任何人啊"},{"start":2470.28,"end":2471.66,"text":"你不要以为自己勇敢"},{"start":2471.66,"end":2472.26,"text":"怎么样"},{"start":2472.26,"end":2477.06,"text":"你首先请你去问一问大意何在"},{"start":2477.38,"end":2479.54,"text":"去问这个问题"},{"start":2480.8,"end":2482.0,"text":"去向别人问"},{"start":2482.0,"end":2483.75,"text":"去向天下人问"},{"start":2483.75,"end":2486.48,"text":"不要沉浸在你那个小圈子里"},{"start":2486.48,"end":2489.84,"text":"不要在一个小圈子要向天下去问"},{"start":2489.84,"end":2491.4,"text":"向天下人问"},{"start":2491.4,"end":2492.72,"text":"大义何在"},{"start":2492.72,"end":2494.34,"text":"大义安在"},{"start":2494.5,"end":2496.38,"text":"只要你有这份心"},{"start":2496.38,"end":2499.23,"text":"哪怕你就是说还不确定他的答案"},{"start":2499.23,"end":2500.46,"text":"哪怕你还是个问号"},{"start":2500.46,"end":2502.26,"text":"还不确定他的答案"},{"start":2502.6,"end":2505.89,"text":"我觉得智者都怀有仁慈之心"},{"start":2505.89,"end":2509.16,"text":"如果你把这个大意已经有了一个答案"},{"start":2509.16,"end":2511.53,"text":"但是这个答案是一个偏私的"},{"start":2511.53,"end":2517.14,"text":"偏狭的偏私偏狭的一个既得利益的某个势力"},{"start":2517.14,"end":2520.589,"text":"既得利益势力的一个答案啊"},{"start":2520.589,"end":2521.999,"text":"那么不好意思"},{"start":2523.019,"end":2527.369,"text":"智者怀有的这个仁慈包不包含你这个会永夫"},{"start":2527.369,"end":2529.4,"text":"那就不一定了"},{"start":2529.86,"end":2533.6,"text":"因为你这个既得利益偏私偏狭利"},{"start":2533.6,"end":2537.8,"text":"并不一定对天下人士怀有仁慈之心"},{"start":2538.88,"end":2540.47,"text":"可能是要制造动乱"},{"start":2540.47,"end":2544.72,"text":"可能是要牺牲底层老百姓啊"},{"start":2544.72,"end":2546.28,"text":"那言尽于此啊"},{"start":2546.28,"end":2551.06,"text":"所以说这个东西呢反正说这几句话我也想嗯"},{"start":2551.06,"end":2553.67,"text":"反正就这四首四句诗"},{"start":2553.67,"end":2557.73,"text":"我们向各个方向都讲明白了他的意味"},{"start":2557.73,"end":2561.9,"text":"所以说现在还是一个疾风之劲"},{"start":2561.9,"end":2568.87,"text":"草板荡至沉沉这么一个状态啊"},{"start":2568.87,"end":2571.11,"text":"然后对于我们自己人啊"},{"start":2571.11,"end":2572.01,"text":"我们也要说的"},{"start":2572.01,"end":2573.87,"text":"我们就是说我们自己团队"},{"start":2573.87,"end":2574.53,"text":"我们自己团队"},{"start":2574.53,"end":2576.149,"text":"也也我们自己团队"},{"start":2576.149,"end":2578.129,"text":"勇夫安识义"},{"start":2578.129,"end":2578.789,"text":"智者必怀"},{"start":2578.789,"end":2580.229,"text":"我们也是很勇敢的"},{"start":2580.229,"end":2581.129,"text":"很了不起啊"},{"start":2581.129,"end":2582.749,"text":"我们的成员呃"},{"start":2582.749,"end":2585.83,"text":"我就是说大家都是一样的"},{"start":2585.83,"end":2588.59,"text":"我们都是就是这个这个在意义上"},{"start":2588.59,"end":2590.93,"text":"我们觉得我们的成员和我们呃"},{"start":2590.93,"end":2593.03,"text":"呃这个决策团队或怎么样的"},{"start":2593.03,"end":2594.41,"text":"我们一起努力啊"},{"start":2594.41,"end":2599.07,"text":"就是我不会用这些东西来要求你们啊"},{"start":2599.07,"end":2601.35,"text":"我觉得大家都是还是专心做事情的"},{"start":2601.35,"end":2603.27,"text":"比如我们现在做乐高"},{"start":2603.27,"end":2606.46,"text":"还有没有这准备做一些旅游的一些项目啊"},{"start":2606.46,"end":2607.96,"text":"计划啊"},{"start":2607.96,"end":2611.95,"text":"大家都是这个很勇敢"},{"start":2611.95,"end":2613.39,"text":"很很有这个拼劲"},{"start":2613.39,"end":2614.56,"text":"很有这个闯劲"},{"start":2614.56,"end":2617.21,"text":"也就是对我很有信任啊"},{"start":2617.21,"end":2618.11,"text":"我自己的团队啊"},{"start":2618.11,"end":2620.55,"text":"这些话是说给我自己团队的成员听的"},{"start":2620.55,"end":2622.41,"text":"我感到非常荣幸啊"},{"start":2622.41,"end":2623.73,"text":"我感到非常的幸运啊"},{"start":2623.73,"end":2628.77,"text":"我感到我非常感激能够和你们这个一路相伴啊"},{"start":2628.77,"end":2631.17,"text":"能够和你们一起努力啊"},{"start":2631.17,"end":2633.63,"text":"一起工作永不安时"},{"start":2633.63,"end":2634.71,"text":"义智者必怀仁"},{"start":2634.71,"end":2638.81,"text":"那我觉得就是说不是说不能说在我手底下干活"},{"start":2638.81,"end":2640.73,"text":"就是跟我一起做事情呢"},{"start":2640.73,"end":2643.71,"text":"我们团队的成员大家都是智者啊"},{"start":2643.71,"end":2645.9,"text":"大家都怀有一颗仁慈之心"},{"start":2645.9,"end":2648.33,"text":"都怀有一个就是说为天地苍生啊"},{"start":2648.33,"end":2649.67,"text":"无论男女老少啊"},{"start":2649.67,"end":2653.69,"text":"无论这个呃这个东西中外啊啊都追求"},{"start":2653.69,"end":2656.54,"text":"更当然有的是要论呢"},{"start":2656.54,"end":2659.72,"text":"就是说要论你是不是劳动群众"},{"start":2659.72,"end":2663.58,"text":"是不是就是说啊弱势群体啊"},{"start":2664.1,"end":2665.26,"text":"不劳动不得食的"},{"start":2665.26,"end":2667.36,"text":"那要优先照顾你的利益"},{"start":2667.36,"end":2669.04,"text":"为优先照顾他们利益"},{"start":2669.04,"end":2672.33,"text":"才能照顾所有人的长远的利益"},{"start":2672.37,"end":2675.78,"text":"对于这些群体的这个大义和仁慈"},{"start":2675.78,"end":2678.69,"text":"我觉得我们的团队成员啊都是有的都是有的"},{"start":2678.69,"end":2679.89,"text":"都是能够认识到的"},{"start":2679.89,"end":2681.13,"text":"都是能够认识到的"},{"start":2681.13,"end":2684.28,"text":"这个是我们是天天讲日谈的啊"},{"start":2684.28,"end":2685.03,"text":"好吧"},{"start":2685.03,"end":2685.87,"text":"那就讲到这里啊"},{"start":2685.87,"end":2687.37,"text":"那就讲到这里呃"},{"start":2687.37,"end":2692.5,"text":"我希望你们也能以这四首四句诗自勉"},{"start":2692.5,"end":2693.55,"text":"好好去想一想"},{"start":2693.55,"end":2697.44,"text":"好好去思考思考行吧"}],"source":"subtitle"}
