    {
      "ordinal": 273,
      "start_ms": 711110,
      "end_ms": 714590,
      "text": "不要出现太多的这个隔膜"
    },
    {
      "ordinal": 274,
      "start_ms": 714590,
      "end_ms": 716540,
      "text": "人格心不隔啊"
    },
    {
      "ordinal": 275,
      "start_ms": 716540,
      "end_ms": 718520,
      "text": "通过这种形式可以互相体谅"
    },
    {
      "ordinal": 276,
      "start_ms": 718520,
