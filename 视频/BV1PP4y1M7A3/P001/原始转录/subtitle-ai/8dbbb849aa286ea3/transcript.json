    {
      "ordinal": 362,
      "start_ms": 884290,
      "end_ms": 885910,
      "text": "或者借给哪个员工了"
    },
    {
      "ordinal": 363,
      "start_ms": 885910,
      "end_ms": 887280,
      "text": "你你父母就是个老板"
