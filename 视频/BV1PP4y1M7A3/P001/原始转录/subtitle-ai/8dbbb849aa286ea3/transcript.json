    {
      "ordinal": 270,
      "start_ms": 702180,
      "end_ms": 706130,
      "text": "就是说在呃时局比较紧张的人与人之间啊"
    },
    {
      "ordinal": 271,
      "start_ms": 706130,
      "end_ms": 708170,
      "text": "不要出现太多的误解"
