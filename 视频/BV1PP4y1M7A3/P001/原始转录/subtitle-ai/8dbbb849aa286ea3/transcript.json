    {
      "ordinal": 364,
      "start_ms": 887280,
      "end_ms": 888060,
      "text": "借给哪个员工"
    },
    {
      "ordinal": 365,
      "start_ms": 888060,
      "end_ms": 889320,
      "text": "或者你父母也是打工的"
