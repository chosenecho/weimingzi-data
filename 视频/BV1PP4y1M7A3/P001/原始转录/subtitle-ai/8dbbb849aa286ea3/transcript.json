    {
      "ordinal": 344,
      "start_ms": 855530,
      "end_ms": 857120,
      "text": "那这个东西不在我的"
    },
    {
      "ordinal": 345,
      "start_ms": 857120,
      "end_ms": 858710,
      "text": "不在我的呼吁范围之内啊"
    },
    {
      "ordinal": 346,
      "start_ms": 858710,
      "end_ms": 859610,
      "text": "这个我要澄清一点"
