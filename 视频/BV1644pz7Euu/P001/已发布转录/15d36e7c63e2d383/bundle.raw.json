99,"end":409.87,"text":"当然我们可咨询员"},{"start":409.87,"end":412.01,"text":"或者说我们这些我的秘书"},{"start":412.01,"end":417.2,"text":"他们会量身给每个人设定他的必要劳动时间"},{"start":417.44,"end":419.36,"text":"这个是另外一个上的必要劳动时间"},{"start":419.36,"end":421.04,"text":"这个必要劳动时间对于什么必要"},{"start":421.04,"end":425.08,"text":"对于你能够维持你正式成员的一个正式会员的"},{"start":425.08,"end":425.68,"text":"说错了"},{"start":425.68,"end":426.66,"text":"他们都不是成员"},{"start":426.66,"end":430.65,"text":"都是正式会员的身份都已经是这样了"},{"start":430.65,"end":432.07,"text":"如果这样都不行"},{"start":432.07,"end":433.03,"text":"烂泥糊不上墙"},{"start":433.03,"end":433.97,"text":"我们不会放人"},{"start":433.97,"end":437.45,"text":"烂泥混在这个有用的砖石当中的"},{"start":439.66,"end":441.5,"text":"仁至义尽"},{"start":441.5,"end":445.36,"text":"你非要自己通过这种方式"},{"start":445.36,"end":447.26,"text":"获得一个冰冷的一个处置的话"},{"start":447.26,"end":449.18,"text":"那是你自找的了"},{"start":451.76,"end":453.92,"text":"那么现在第一批的话全是男的"},{"start":453.92,"end":456.28,"text":"手脚没有一个在我看来有残疾的"},{"start":456.28,"end":458.799,"text":"有手有脚不愿意找工作"},{"start":458.799,"end":460.379,"text":"什么工作都不愿意去找"},{"start":460.379,"end":461.399,"text":"那不好意思"},{"start":461.399,"end":463.039,"text":"这个共同提的话"},{"start":463.039,"end":466.259,"text":"或者什么形态的劳动都不愿意去"},{"start":466.259,"end":470.48,"text":"非那个劳动是有额外的意义"},{"start":470.48,"end":471.16,"text":"额外的价值"},{"start":471.16,"end":474.7,"text":"额外的这个妄想幻想的可能性的"},{"start":474.7,"end":476.58,"text":"那是不符合我们的理念的"},{"start":476.58,"end":479.28,"text":"现实是真实的"},{"start":480.0,"end":481.26,"text":"人民群众的生活"},{"start":481.26,"end":483.72,"text":"每个子儿每一个喘息的缝隙"},{"start":483.72,"end":486.789,"text":"都是自己加倍努力换来的"},{"start":486.789,"end":489.909,"text":"你说这个状况是否就是一定是合理的"},{"start":489.909,"end":490.669,"text":"或者是正义的"},{"start":490.669,"end":493.02,"text":"正当的这个另当别论"},{"start":493.02,"end":496.4,"text":"你自己得把你的生存姿态摆出来"},{"start":496.4,"end":502.31,"text":"那么也由此呢就有一个衍生的衍生的一个"},{"start":502.31,"end":504.53,"text":"我们说一个比较强制的规定"},{"start":504.53,"end":507.39,"text":"就是不允许相互拆借了"},{"start":507.39,"end":512.47,"text":"特别是对于那些生存状况是刻意挂逼"},{"start":512.95,"end":515.27,"text":"刻意逃避"},{"start":515.27,"end":520.23,"text":"躲避一切形态的这个有压力的劳动的话"},{"start":520.7,"end":522.76,"text":"他们是施压状态"},{"start":522.76,"end":523.78,"text":"失去了压力"},{"start":523.78,"end":526.5,"text":"失去了生存的压力啊"},{"start":526.5,"end":530.43,"text":"就像这个弹簧弹出来的一样"},{"start":531.87,"end":533.19,"text":"这不蹦到哪里去了"},{"start":533.19,"end":534.55,"text":"很难找到的"},{"start":534.55,"end":536.55,"text":"所以对于这部分人"},{"start":536.55,"end":539.01,"text":"或者说更广泛意义上的话"},{"start":539.01,"end":540.704,"text":"相互拆借"},{"start":544.07,"end":547.89,"text":"你如果是急需有一些投资项目计划安排"},{"start":547.89,"end":549.19,"text":"或者家人生病了"},{"start":549.19,"end":549.79,"text":"要水滴筹"},{"start":549.79,"end":550.87,"text":"众筹什么这些东西的"},{"start":550.87,"end":552.069,"text":"这都好谈"},{"start":552.069,"end":554.029,"text":"甚至说俱乐部可以就是说出面"},{"start":554.029,"end":556.26,"text":"官方帮你去做这些事情"},{"start":556.26,"end":558.34,"text":"做这些协调接洽"},{"start":558.34,"end":561.86,"text":"但是你如果只是个人纯粹的懒惰"},{"start":561.86,"end":566.13,"text":"一天复一天的在出租屋里面逃避自己"},{"start":566.13,"end":568.73,"text":"要养活自己的一个基本命运的话"},{"start":568.73,"end":570.19,"text":"那么不好意思"},{"start":570.19,"end":571.09,"text":"我再说了"},{"start":571.09,"end":572.13,"text":"最后一次不好意思了"},{"start":572.13,"end":574.01,"text":"你会被清退"},{"start":576.58,"end":578.86,"text":"啊你就会"},{"start":580.34,"end":581.98,"text":"很多人把这里当伊甸园了啊"},{"start":581.98,"end":583.62,"text":"很多人把自己当成一个小天堂"},{"start":583.62,"end":585.46,"text":"那你就纯粹过来挂逼占便宜了"},{"start":585.46,"end":588.15,"text":"这不是我们要的资源是有限的"},{"start":588.15,"end":589.63,"text":"你挂壁占便宜了"},{"start":589.63,"end":590.21,"text":"什么都不做"},{"start":590.21,"end":591.31,"text":"占着茅坑不拉屎"},{"start":591.31,"end":593.43,"text":"那另外一个可以振作起来"},{"start":593.43,"end":594.84,"text":"可以帮助他自己"},{"start":594.84,"end":595.72,"text":"帮助他的家庭"},{"start":595.72,"end":596.88,"text":"甚至说不重要"},{"start":596.88,"end":600.28,"text":"他帮助我们以及帮助就整个社会这些人"},{"start":600.28,"end":601.44,"text":"他的资源被你占了"},{"start":601.44,"end":602.51,"text":"被浪费了"},{"start":602.51,"end":603.93,"text":"不应当如此"},{"start":603.93,"end":607.35,"text":"我们这个资源不仅是是吃喝的一个资源啊"},{"start":607.35,"end":610.1,"text":"我们提供的资源还包括生活的关怀"},{"start":610.1,"end":613.28,"text":"对你整个人的一个动向的一个把握"},{"start":613.28,"end":614.48,"text":"有辅导员啊"},{"start":614.48,"end":616.75,"text":"现在有些相对有心理老师啊"},{"start":616.75,"end":617.99,"text":"你有认同啊"},{"start":617.99,"end":620.31,"text":"这些虚的这些东西都是正式会员"},{"start":620.31,"end":621.27,"text":"他"},{"start":622.66,"end":625.86,"text":"才有的才一定就有的"},{"start":626.24,"end":628.08,"text":"所以看上去好像制造了一个家的感觉"},{"start":628.08,"end":630.36,"text":"但是毕竟这不是你的家"},{"start":630.47,"end":632.17,"text":"你家里是一位血缘"},{"start":632.17,"end":634.31,"text":"或者你是对这个父母的这个将来"},{"start":634.31,"end":636.45,"text":"未来这个养老的预期"},{"start":636.45,"end":638.96,"text":"一个职责责任"},{"start":639.32,"end":640.9,"text":"但是呢这里不是冤家"},{"start":640.9,"end":643.32,"text":"这里没有人要你们来养老"},{"start":643.489,"end":645.169,"text":"这里也没有人说合理"},{"start":645.169,"end":649.409,"text":"就是有血缘的那种法律上抹除不掉的一些关联"},{"start":649.83,"end":652.19,"text":"归根结底从一开始"},{"start":652.19,"end":654.15,"text":"一在一开始的时候是陌生人嘛"},{"start":654.15,"end":655.71,"text":"后面逐渐熟络变成朋友"},{"start":655.71,"end":660.88,"text":"相互之间啊相互扶持扶持了"},{"start":668.04,"end":673.99,"text":"所以这个时期呢很多人的考察七"},{"start":673.99,"end":676.89,"text":"就是陆陆续续都要到期了"},{"start":676.89,"end":679.13,"text":"有的是什么签了所谓对赌协议"},{"start":679.13,"end":680.71,"text":"如果要找找不到工作"},{"start":680.71,"end":684.17,"text":"最低意义上的就最简单的门槛"},{"start":684.17,"end":688.69,"text":"最低的工作是不愿意找"},{"start":691.22,"end":695.73,"text":"然后我们觉得只能说这里不是你适合待的地方"},{"start":695.73,"end":697.35,"text":"你待在这里只占便宜而已"},{"start":697.35,"end":699.07,"text":"我干嘛要让你占便宜呢"},{"start":699.07,"end":701.13,"text":"那么为了适应"},{"start":701.57,"end":703.81,"text":"就是说不不允许拆借"},{"start":703.81,"end":705.19,"text":"不要再借钱给他们了"},{"start":705.19,"end":708.95,"text":"就是大家都要达成一个共识啊"},{"start":708.95,"end":710.31,"text":"有钱也不借了"},{"start":710.31,"end":711.45,"text":"你做不下去"},{"start":711.45,"end":713.13,"text":"那你就收拾铺盖卷回去吧"},{"start":713.13,"end":714.65,"text":"跟你家里没人要要一笔钱"},{"start":714.65,"end":715.21,"text":"你滚吧"},{"start":715.21,"end":717.01,"text":"或者不叫滚蛋啊"},{"start":721.06,"end":722.66,"text":"如果你想支棱起来"},{"start":722.66,"end":724.78,"text":"那可以有电瓶车给你用"},{"start":725.98,"end":728.49,"text":"或者可以有相应的这个培训啊"},{"start":728.49,"end":732.27,"text":"相应的这个这个讲座让你熟练上手"},{"start":733.55,"end":735.27,"text":"直接有一个很初步"},{"start":735.27,"end":740.18,"text":"初步的一个就相当于项目组啊"},{"start":740.18,"end":742.16,"text":"你看他妈你去送外送"},{"start":742.16,"end":743.88,"text":"送快送外卖啊"},{"start":743.88,"end":745.88,"text":"都不是单枪匹马的去送的"},{"start":745.88,"end":748.81,"text":"都是几个好朋友一块去送的"},{"start":748.81,"end":752.42,"text":"状况都差不多的人一起去送的"},{"start":757.74,"end":760.74,"text":"然后是这样的呃"},{"start":761.86,"end":764.24,"text":"这只是权宜之计"},{"start":764.24,"end":769.03,"text":"但是这个就哪怕是这样的一个极低的一个标准"},{"start":769.03,"end":770.05,"text":"很多人不愿意"},{"start":770.05,"end":770.83,"text":"那就再见了"},{"start":770.83,"end":774.39,"text":"然后还有一个宿宿舍的这个居住状况"},{"start":774.39,"end":775.35,"text":"要调整一下"},{"start":775.35,"end":776.91,"text":"这种比较类似的"},{"start":776.91,"end":781.01,"text":"相当于啊随时随地可能被放逐的"},{"start":781.01,"end":782.39,"text":"那他们要去"},{"start":782.39,"end":785.83,"text":"我的想法是这里面的房东啊"},{"start":785.83,"end":788.8,"text":"主要如果说房东本身烂了啊"},{"start":788.8,"end":789.44,"text":"不叫房东啊"},{"start":789.44,"end":792.36,"text":"就是租房租租房的那个人"},{"start":792.36,"end":794.02,"text":"合同相关方"},{"start":794.02,"end":795.36,"text":"他本身烂了"},{"start":795.36,"end":797.68,"text":"本身就就放弃了"},{"start":797.68,"end":798.42,"text":"堕落了"},{"start":798.42,"end":800.12,"text":"那么怎么样"},{"start":800.73,"end":802.37,"text":"那就其他人先走啊"},{"start":802.37,"end":803.23,"text":"这个留给你啊"},{"start":803.23,"end":804.83,"text":"然后就是臭味相投"},{"start":804.83,"end":806.61,"text":"同病相怜的那群人都在里面"},{"start":806.61,"end":809.0,"text":"那就这整个就把他切断掉"},{"start":809.0,"end":810.06,"text":"再见"},{"start":810.06,"end":812.24,"text":"不跟你打交道的"},{"start":812.24,"end":814.28,"text":"再也不不打交道了啊"},{"start":815.68,"end":818.08,"text":"这是一种情况"},{"start":820.8,"end":822.4,"text":"第二种情况是什么"},{"start":834.36,"end":836.88,"text":"这个状态也不是长久的"},{"start":836.88,"end":838.48,"text":"我们即刻要给他接洽"},{"start":838.48,"end":841.6,"text":"到制定他这个人的发展的方案"},{"start":842.01,"end":845.67,"text":"所以制定一个人在这里调整好"},{"start":845.67,"end":846.71,"text":"发展好"},{"start":846.71,"end":849.46,"text":"首先是消过度调整"},{"start":849.46,"end":856.86,"text":"然后再是重新这个切接入到一个有一定烈度的"},{"start":856.86,"end":857.88,"text":"有一定压力的"},{"start":857.88,"end":863.39,"text":"有一定未来预期的啊生活进程当中去"},{"start":864.0,"end":868.8,"text":"现在问题就是说这些人哈真的不是小富即安的"},{"start":868.8,"end":874.059,"text":"真的是小小保基安饭吃了"},{"start":874.059,"end":875.139,"text":"往那一躺呢"},{"start":875.139,"end":877.819,"text":"做做的事情越少越好"},{"start":883.22,"end":885.66,"text":"这不是我们提倡的"},{"start":885.66,"end":886.66,"text":"你什么都不做"},{"start":886.66,"end":892.48,"text":"你就一直一堆这个有机物往这一摆摆摆烂"},{"start":892.48,"end":893.12,"text":"摆在这边"},{"start":894.44,"end":897.48,"text":"然后我们要讲的是呃"},{"start":899.6,"end":901.54,"text":"允许你们有抗辩权"},{"start":901.54,"end":903.36,"text":"比如说你是因为各式各样的原因"},{"start":903.36,"end":906.68,"text":"没办法或者害怕恐害怕高速啊"},{"start":906.68,"end":908.44,"text":"还害怕这个电气啊什么"},{"start":908.44,"end":911.06,"text":"你如果有恐惧症或者类似的一个抗辩权"},{"start":911.06,"end":916.78,"text":"可以向最后一次跟你进行一个"},{"start":916.78,"end":921.29,"text":"在这里的发展意向进行汇报"},{"start":921.29,"end":927.17,"text":"咨询的那个咨询员表明你有什么样的困难"},{"start":927.17,"end":930.71,"text":"你有什么不得不啃老啊"},{"start":930.71,"end":933.99,"text":"或者不得不没法下定下一个啊"},{"start":933.99,"end":936.38,"text":"不仅仅是这个"},{"start":939.36,"end":941.3,"text":"还有就是"},{"start":942.17,"end":945.57,"text":"本职工作也是完全是结构化的"},{"start":945.57,"end":946.49,"text":"没有办法找到的"},{"start":946.49,"end":947.93,"text":"你证明你的路断绝了"},{"start":947.93,"end":949.29,"text":"然后你又"},{"start":952.8,"end":958.65,"text":"必须要一个俱乐部正式会员的身份来庇护你"},{"start":958.65,"end":960.35,"text":"这一情况也可以载明"},{"start":960.35,"end":962.65,"text":"说明我们不是不近人情的"},{"start":962.65,"end":965.47,"text":"如果你真的是什么家里面欠了一大堆钱"},{"start":965.47,"end":967.45,"text":"什么咳在躲债类似的"},{"start":967.45,"end":970.84,"text":"自己又被父母忽悠了什么什么东西的"},{"start":970.84,"end":973.36,"text":"我们也是会酌情放宽"},{"start":973.36,"end":976.53,"text":"但是你不表述"},{"start":977.69,"end":978.85,"text":"你不说清楚"},{"start":978.85,"end":981.589,"text":"那就是有意对抗"},{"start":981.989,"end":985.27,"text":"那就是你不把别人的心里当回事"},{"start":985.59,"end":987.03,"text":"纯粹自私自利的人"},{"start":987.03,"end":992.05,"text":"没必要来俱乐部共同收获幸福快乐"},{"start":992.05,"end":993.51,"text":"生生命的意义"},{"start":993.51,"end":997.11,"text":"你自己一个人去做单件不行的啊"},{"start":997.11,"end":999.78,"text":"所以呃总结起来"},{"start":999.78,"end":1003.28,"text":"我们会尽量的在场地上调整好"},{"start":1003.28,"end":1007.59,"text":"不要弄得就是他们这边俱乐部会员当不了了"},{"start":1007.59,"end":1009.03,"text":"那退出不好退了"},{"start":1009.03,"end":1012.27,"text":"现在起矛盾就是一点"},{"start":1018.12,"end":1019.16,"text":"第二点是"},{"start":1019.16,"end":1021.41,"text":"无论你咳"},{"start":1021.41,"end":1022.87,"text":"当然我们说了不允许拆页嘛"},{"start":1022.87,"end":1025.23,"text":"还有我说的就是最后一点的"},{"start":1025.23,"end":1028.78,"text":"相当于无论你有多大的才能"},{"start":1029.099,"end":1033.28,"text":"无论你在是是不是准备多牛逼的一个技术"},{"start":1033.28,"end":1035.619,"text":"或者说一个是什么创业项目"},{"start":1036.74,"end":1038.24,"text":"无论怎样"},{"start":1046.0,"end":1047.5,"text":"或者说某种形式的就业"},{"start":1047.5,"end":1049.28,"text":"要扩大交际圈"},{"start":1049.28,"end":1052.66,"text":"不要完全在那里这样腐化"},{"start":1052.81,"end":1055.21,"text":"那圆起来扩大交际圈"},{"start":1055.21,"end":1056.39,"text":"然后呢"},{"start":1056.39,"end":1062.409,"text":"和相对还具有专门的专业的商业化运作"},{"start":1062.409,"end":1069.3,"text":"和经营理念的那个社会分工的载体啊"},{"start":1069.3,"end":1070.22,"text":"比如说这个厂"},{"start":1070.22,"end":1073.78,"text":"我说这个你去送外卖啊"},{"start":1073.78,"end":1075.28,"text":"送外卖也会有个车队"},{"start":1075.28,"end":1079.46,"text":"有个站骑手驿站啊"},{"start":1079.46,"end":1080.26,"text":"你去搞设计"},{"start":1081.38,"end":1082.44,"text":"接点私单"},{"start":1082.44,"end":1085.38,"text":"那他也有一个相当于一个圈层啊"},{"start":1085.38,"end":1087.52,"text":"可能有微信群或QQ群"},{"start":1087.88,"end":1088.8,"text":"无论怎样"},{"start":1090.48,"end":1095.519,"text":"你要加入这些和俱乐部封闭的内在关系"},{"start":1095.519,"end":1097.839,"text":"不一样的一个人际关系当中去"},{"start":1097.839,"end":1098.919,"text":"然后通过对比"},{"start":1098.919,"end":1101.1,"text":"你还觉得这里好"},{"start":1102.02,"end":1107.389,"text":"啊不是说我给你提供工作"},{"start":1107.389,"end":1109.149,"text":"这不是我给你提供工作"},{"start":1109.149,"end":1113.869,"text":"是我们提供一些技术培训知识铺垫"},{"start":1113.869,"end":1121.03,"text":"还有啧是吧的劳动工具或生产资料"},{"start":1121.03,"end":1122.63,"text":"我们提供这些便利"},{"start":1122.63,"end":1125.095,"text":"但是更多是以你为主"},{"start":1125.579,"end":1130.74,"text":"但是呢为了查证你真的在做这些事情"},{"start":1130.74,"end":1134.57,"text":"我们会有特别的一些办法去"},{"start":1134.57,"end":1138.21,"text":"这当然是就得到你的许可了啊"},{"start":1138.21,"end":1139.77,"text":"去了解你到底跑了多少路"},{"start":1139.77,"end":1140.37,"text":"跑了多少单"},{"start":1140.37,"end":1142.22,"text":"赚了多少钱"},{"start":1148.58,"end":1149.24,"text":"是吧"},{"start":1149.24,"end":1151.48,"text":"反正这个话我们已经说在前头了"},{"start":1151.48,"end":1153.38,"text":"做好心理准备"},{"start":1153.78,"end":1156.74,"text":"不是就是你拿完去送外卖"},{"start":1156.74,"end":1159.33,"text":"那个电瓶车都给你买了电瓶车了"},{"start":1159.33,"end":1161.73,"text":"你怎么能一天只要送我三个小时"},{"start":1161.73,"end":1164.31,"text":"然后就可以在这还有一点"},{"start":1164.31,"end":1168.01,"text":"当然还有最后一点就是必须到店"},{"start":1168.47,"end":1171.39,"text":"不允许窝在这个宿舍里面"},{"start":1171.39,"end":1174.76,"text":"而且必须是在早上到店到练了之后"},{"start":1174.76,"end":1176.46,"text":"对于你的状况进行一个登机"},{"start":1176.46,"end":1177.64,"text":"然后进行一个"},{"start":1177.64,"end":1181.72,"text":"甚至说将来会有一些方案"},{"start":1181.72,"end":1185.07,"text":"是比较具有普遍代表性的方案"},{"start":1185.07,"end":1190.6,"text":"然后这些每一个方案就成这几个人相互监督啊"},{"start":1190.6,"end":1191.72,"text":"你可以去宿舍里面"},{"start":1191.72,"end":1192.84,"text":"你不你不是室友"},{"start":1192.84,"end":1194.82,"text":"但是到这里你是同选一个"},{"start":1199.44,"end":1201.889,"text":"那就相应的在这里面会有一些"},{"start":1204.889,"end":1207.969,"text":"还会有些别的一些事情你要去完成达成"},{"start":1207.969,"end":1210.57,"text":"来证明你回归主流社会"},{"start":1210.57,"end":1217.02,"text":"或者说啊把自己嵌入到啊"},{"start":1217.02,"end":1222.88,"text":"现实的物质利益纠纷的生存情态里面去"},{"start":1224.38,"end":1225.74,"text":"然后我还是强调一遍"},{"start":1225.74,"end":1226.34,"text":"有钱的"},{"start":1226.34,"end":1227.38,"text":"不要他妈同情心"},{"start":1227.38,"end":1228.61,"text":"道德主义泛滥"},{"start":1228.61,"end":1231.81,"text":"严肃的要批评所有道德主义错误"},{"start":1231.81,"end":1233.01,"text":"你豢养他"},{"start":1233.01,"end":1233.81,"text":"你纵容他"},{"start":1233.81,"end":1235.42,"text":"是害了他"},{"start":1235.74,"end":1238.26,"text":"一次又一次的这个人没有希望"},{"start":1238.26,"end":1242.66,"text":"这个人没有改变的这个内在动力啊"},{"start":1242.66,"end":1244.16,"text":"他跑到哪个房间里"},{"start":1244.16,"end":1244.8,"text":"把房门一锁"},{"start":1244.8,"end":1247.08,"text":"你鬼知道里面会发生什么"},{"start":1253.4,"end":1254.28,"text":"对吧"},{"start":1254.28,"end":1257.46,"text":"所以我们这里就是说提供了"},{"start":1257.46,"end":1259.34,"text":"生活上的保障和支柱"},{"start":1259.34,"end":1261.63,"text":"是有前提的"},{"start":1261.63,"end":1262.67,"text":"是有前提的"},{"start":1262.67,"end":1265.49,"text":"你能有一个积极向上的心态"},{"start":1265.49,"end":1273.34,"text":"把我们的理念往更广更宽大的方向去这个宣讲"},{"start":1274.86,"end":1276.34,"text":"其实我又很困了"},{"start":1276.34,"end":1277.28,"text":"刚刚讲的那些东西"},{"start":1277.28,"end":1279.94,"text":"在工作记忆里面都是不停的乱的"},{"start":1279.94,"end":1282.34,"text":"我要不停的去理他们的"},{"start":1286.6,"end":1290.74,"text":"那我就要费这个口舌跟你们讲这个东西"},{"start":1290.74,"end":1292.4,"text":"因为我再强调一遍"},{"start":1292.4,"end":1296.61,"text":"我们我们现在已经下定决心"},{"start":1297.17,"end":1301.16,"text":"不在大是大非的问题上面啊"},{"start":1301.16,"end":1302.64,"text":"跟着人情走了"},{"start":1302.64,"end":1305.56,"text":"我们不再说对你们有什么情感上的亏欠"},{"start":1305.56,"end":1306.18,"text":"歉疚了"},{"start":1306.18,"end":1306.58,"text":"这个东西"},{"start":1306.58,"end":1307.74,"text":"这个游戏到此结束了"},{"start":1307.74,"end":1309.68,"text":"到此为止了"},{"start":1317.58,"end":1318.14,"text":"行吧"},{"start":1318.14,"end":1319.62,"text":"我都已经不停打哈欠了"},{"start":1319.62,"end":1320.5,"text":"已经很困了"},{"start":1320.5,"end":1321.78,"text":"就讲到这里啊"}],"source":"subtitle"}
