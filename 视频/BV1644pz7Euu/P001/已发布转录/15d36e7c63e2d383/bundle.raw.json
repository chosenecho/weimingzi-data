{"segments":[{"start":0.14,"end":4.71,"text":"呃我们再明确强调一点"},{"start":5.45,"end":6.779,"text":"无论如何"},{"start":6.779,"end":8.779,"text":"你得以某种形式就业啊"},{"start":8.779,"end":11.979,"text":"就是在在地的俱乐部会员成员啊"},{"start":11.979,"end":14.98,"text":"正式的会员嗯"},{"start":18.44,"end":22.3,"text":"呃我们已经非常正式的非常正式"},{"start":22.3,"end":31.31,"text":"也非常这个认真的向呃俱乐部成员传达了"},{"start":31.43,"end":33.63,"text":"这里的比较廉价的时速"},{"start":33.63,"end":38.829,"text":"不是为了你挂逼而存在的啊"},{"start":38.829,"end":40.95,"text":"而提供给你的"},{"start":41.35,"end":44.07,"text":"如果你完全失能"},{"start":44.07,"end":46.47,"text":"不能有任何的劳动产出"},{"start":46.47,"end":48.22,"text":"无论是产品还是服务"},{"start":48.22,"end":50.64,"text":"无论是实实物的产品"},{"start":50.64,"end":53.46,"text":"还是说虚拟产品啊"},{"start":53.46,"end":56.96,"text":"现实服务还是在线的服务"},{"start":60.16,"end":65.14,"text":"那我们是不会无止境的去把我们所能够提供的"},{"start":65.14,"end":65.74,"text":"帮助"},{"start":65.74,"end":71.8,"text":"这些资源以这个极低廉的价格提供给你们的"},{"start":81.3,"end":83.1,"text":"这里不是家庭"},{"start":84.66,"end":86.38,"text":"不是家族"},{"start":90.48,"end":92.48,"text":"这里有基本要求基本底线"},{"start":93.56,"end":95.2,"text":"所以这个基本要求基本底线"},{"start":95.2,"end":97.749,"text":"现在明确告知你"},{"start":99.189,"end":100.189,"text":"但是你得就业"},{"start":100.189,"end":102.189,"text":"并且达到一定的就业"},{"start":105.14,"end":106.98,"text":"在这个就业时长当中"},{"start":106.98,"end":109.5,"text":"我们可以提供"},{"start":111.64,"end":117.0,"text":"啊我们可以提供这个就业形态本身需要的一些"},{"start":117.0,"end":118.77,"text":"培训辅助"},{"start":119.21,"end":120.21,"text":"比如送外卖"},{"start":120.21,"end":121.65,"text":"我们可以租电瓶车给你"},{"start":121.65,"end":125.09,"text":"甚至说前面一两个月这个电瓶车就是借给你用"},{"start":125.09,"end":126.69,"text":"不要钱"},{"start":130.5,"end":133.1,"text":"啊你如果说是要去做设计"},{"start":133.1,"end":135.38,"text":"那我们也会提供相应的培训"},{"start":136.7,"end":139.6,"text":"那你哪怕是在网上接商单什么东西的"},{"start":142.48,"end":143.96,"text":"在就业时间范围内啊"},{"start":143.96,"end":145.3,"text":"在就业时间之外"},{"start":145.3,"end":147.8,"text":"我们提供廉价的食宿"},{"start":150.42,"end":153.22,"text":"啊我们也提供一些进阶的发展的机会"},{"start":153.22,"end":155.22,"text":"有培训啊"},{"start":155.22,"end":157.67,"text":"有项目活动参与的机会"},{"start":157.83,"end":160.71,"text":"但是这一切的前提是你无论如何"},{"start":160.71,"end":163.75,"text":"你不能一天到晚挂在宿舍里面"},{"start":164.07,"end":166.19,"text":"或者说漫无目的的游荡"},{"start":170.63,"end":172.39,"text":"送外卖"},{"start":173.49,"end":176.41,"text":"啊哪怕你是做保安"},{"start":179.28,"end":182.72,"text":"啊就是这个分拣快递打零工"},{"start":183.72,"end":189.72,"text":"但是他要就是并不是说不允许你有闲暇"},{"start":191.42,"end":192.42,"text":"你送外卖的话"},{"start":192.42,"end":195.02,"text":"你一天送个四五个小时"},{"start":197.52,"end":202.56,"text":"但是四五小时也就是或者说他是参封单比较多"},{"start":202.56,"end":204.22,"text":"但你只做一个餐风"},{"start":204.22,"end":207.3,"text":"然后你可以做做跑腿或者怎样"},{"start":207.3,"end":209.22,"text":"你一天最起码说一个餐封"},{"start":209.22,"end":212.16,"text":"加上一个附带的大段的时间"},{"start":212.16,"end":215.06,"text":"你是在创造劳动价值的"},{"start":215.06,"end":220.54,"text":"当然你完全逃避劳动"},{"start":220.54,"end":229.63,"text":"完全逃避一个被这个生活的物质压力压缩"},{"start":232.72,"end":235.6,"text":"加载的这种啊"},{"start":235.6,"end":240.24,"text":"有一定的这个分量的这种生活状况的话"},{"start":240.7,"end":243.08,"text":"我见不到任何的可能性"},{"start":243.08,"end":246.459,"text":"你在我们提供的帮助支持之下"},{"start":246.459,"end":247.899,"text":"能够成长"},{"start":247.899,"end":248.859,"text":"能够进步"},{"start":248.859,"end":251.219,"text":"那我们提供一些帮助和支持"},{"start":251.219,"end":255.0,"text":"就变成对于你的一种纵容了啊"},{"start":255.0,"end":256.76,"text":"豢养懒惰"},{"start":256.76,"end":262.0,"text":"或者说豢养这个孬没出息"},{"start":266.08,"end":269.92,"text":"所以我们该传达的都已经明确传达了"},{"start":270.62,"end":274.3,"text":"处在这个临界状态的人不少"},{"start":275.05,"end":276.39,"text":"肯定是一只手"},{"start":276.39,"end":279.01,"text":"这个数不过来的"},{"start":280.01,"end":283.039,"text":"那我们也已经是倒计时了"},{"start":283.199,"end":284.919,"text":"倒计时啦"},{"start":285.69,"end":287.35,"text":"而且我说难听点"},{"start":287.35,"end":289.89,"text":"你有一个俱乐部在这边"},{"start":289.89,"end":293.88,"text":"餐饮店提供的这些廉价餐饮"},{"start":293.88,"end":295.28,"text":"就像玩儿一样呀"},{"start":295.28,"end":296.6,"text":"你就把你当