  "content_sha256": "10a7920ad77cc6c014730b404565538099aa6a294db80b522b28344be1922fd2",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 24360,
      "end_ms": 24940,
      "text": "嗯"
    },
    {
      "ordinal": 1,
      "start_ms": 55760,
      "end_ms": 60850,
      "text": "三生间处处是晦暗无边"
    },
    {
      "ordinal": 2,
      "start_ms": 60850,
      "end_ms": 64619,
      "text": "你情景在何方"
    },
    {
      "ordinal": 3,
      "start_ms": 69620,
      "end_ms": 73840,
      "text": "他长夜漫漫的露水"
    },
    {
      "ordinal": 4,
      "start_ms": 73840,
      "end_ms": 76600,
      "text": "如光静安尘"
    },
    {
      "ordinal": 5,
      "start_ms": 76600,
      "end_ms": 80060,
      "text": "无意彷徨啊"
    },
    {
      "ordinal": 6,
      "start_ms": 83560,
      "end_ms": 87000,
      "text": "一醉青钢风华奏"
    },
    {
      "ordinal": 7,
      "start_ms": 87000,
      "end_ms": 88500,
      "text": "寻无方"
    },
    {
      "ordinal": 8,
      "start_ms": 88500,
      "end_ms": 92520,
      "text": "暗剑无情浮神光"
    },
    {
      "ordinal": 9,
      "start_ms": 97260,
      "end_ms": 101360,
      "text": "要多风中烛红点翠"
    },
    {
      "ordinal": 10,
      "start_ms": 101360,
      "end_ms": 103040,
      "text": "水上身"
    },
    {
      "ordinal": 11,
      "start_ms": 103040,
      "end_ms": 106539,
      "text": "落花白叶残妆"
    },
    {
      "ordinal": 12,
      "start_ms": 112460,
      "end_ms": 114940,
      "text": "何方"
    },
    {
      "ordinal": 13,
      "start_ms": 116900,
      "end_ms": 122220,
      "text": "小金属狂看笑我"
    },
    {
      "ordinal": 14,
      "start_ms": 123580,
      "end_ms": 128660,
      "text": "仰天之不见周好"
    },
    {
      "ordinal": 15,
      "start_ms": 139899,
      "end_ms": 141920,
      "text": "猖狂"
    },
    {
      "ordinal": 16,
      "start_ms": 143619,
      "end_ms": 148800,
      "text": "称呼射出一片神光"
    },
    {
      "ordinal": 17,
      "start_ms": 150540,
      "end_ms": 155760,
      "text": "容貌竟如此堂皇"
    },
    {
      "ordinal": 18,
      "start_ms": 157459,
      "end_ms": 161460,
      "text": "你情尽在何方"
    },
    {
      "ordinal": 19,
      "start_ms": 165959,
      "end_ms": 171829,
      "text": "凡人间处处是灰暗无边迷"
    },
    {
      "ordinal": 20,
      "start_ms": 171829,
      "end_ms": 174640,
      "text": "情景在何方"
    },
    {
      "ordinal": 21,
      "start_ms": 180200,
      "end_ms": 183280,
      "text": "长夜漫漫旅途"
    },
    {
      "ordinal": 22,
      "start_ms": 183280,
      "end_ms": 184780,
      "text": "水如光"
    },
    {
      "ordinal": 23,
      "start_ms": 184780,
      "end_ms": 190180,
      "text": "静安尘雾里彷徨啊"
    },
    {
      "ordinal": 24,
      "start_ms": 193300,
      "end_ms": 198250,
      "text": "一醉青钢风花搜寻无方"
    },
    {
      "ordinal": 25,
      "start_ms": 198250,
      "end_ms": 202200,
      "text": "暗剑无情出神光"
    },
    {
      "ordinal": 26,
      "start_ms": 207020,
      "end_ms": 212600,
      "text": "要躲风中烛红点催谁伤神"
    },
    {
      "ordinal": 27,
      "start_ms": 212600,
      "end_ms": 216680,
      "text": "罗花爱也残妆"
    },
    {
      "ordinal": 28,
      "start_ms": 221140,
      "end_ms": 225270,
      "text": "但当世事千言无常"
    },
    {
      "ordinal": 29,
      "start_ms": 225270,
      "end_ms": 226800,
      "text": "总有愁"
    },
    {
      "ordinal": 30,
      "start_ms": 226800,
      "end_ms": 229240,
      "text": "岂敢赴于长"
    },
    {
      "ordinal": 31,
      "start_ms": 234359,
      "end_ms": 239039,
      "text": "如花作流水倏然远去"
    },
    {
      "ordinal": 32,
      "start_ms": 239039,
      "end_ms": 242820,
      "text": "在鬼市疏落满仓"
    },
    {
      "ordinal": 33,
      "start_ms": 243019,
      "end_ms": 244100,
      "text": "好好好好好"
    },
    {
      "ordinal": 34,
      "start_ms": 247480,
      "end_ms": 250500,
      "text": "一醉清刚风华"
    },
    {
      "ordinal": 35,
      "start_ms": 250500,
      "end_ms": 256200,
      "text": "搜寻五方暗剑无情浮神光"
    },
    {
      "ordinal": 36,
      "start_ms": 260759,
      "end_ms": 263959,
      "text": "要多风中烛红"
    },
    {
      "ordinal": 37,
      "start_ms": 263959,
      "end_ms": 266510,
      "text": "天随水上神"
    },
    {
      "ordinal": 38,
      "start_ms": 266510,
      "end_ms": 271220,
      "text": "罗花白叶残妆"
    },
    {
      "ordinal": 39,
      "start_ms": 313979,
      "end_ms": 314520,
      "text": "嗯"
    }
  ],
  "text": "嗯\n三生间处处是晦暗无边\n你情景在何方\n他长夜漫漫的露水\n如光静安尘\n无意彷徨啊\n一醉青钢风华奏\n寻无方\n暗剑无情浮神光\n要多风中烛红点翠\n水上身\n落花白叶残妆\n何方\n小金属狂看笑我\n仰天之不见周好\n猖狂\n称呼射出一片神光\n容貌竟如此堂皇\n你情尽在何方\n凡人间处处是灰暗无边迷\n情景在何方\n长夜漫漫旅途\n水如光\n静安尘雾里彷徨啊\n一醉青钢风花搜寻无方\n暗剑无情出神光\n要躲风中烛红点催谁伤神\n罗花爱也残妆\n但当世事千言无常\n总有愁\n岂敢赴于长\n如花作流水倏然远去\n在鬼市疏落满仓\n好好好好好\n一醉清刚风华\n搜寻五方暗剑无情浮神光\n要多风中烛红\n天随水上神\n罗花白叶残妆\n嗯",
  "timing_issue": null
}
