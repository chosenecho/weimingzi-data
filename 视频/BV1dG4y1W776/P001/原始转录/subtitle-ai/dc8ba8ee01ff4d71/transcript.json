{
  "bvid": "BV1dG4y1W776",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "dc8ba8ee01ff4d71afeb312739eaf2adbc6a3731f120d88623f5d887f1ec58bd",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 2300,
      "end_ms": 3380,
      "text": "哲学"
    },
    {
      "ordinal": 1,
      "start_ms": 10590,
      "end_ms": 15220,
      "text": "就是说反思性就有个蠢货"
    },
    {
      "ordinal": 2,
      "start_ms": 15220,
      "end_ms": 17820,
      "text": "说我不反思我的预设"
    },
    {
      "ordinal": 3,
      "start_ms": 18800,
      "end_ms": 25220,
      "text": "说我认为哲学一定要要挺辩证法"
    },
    {
      "ordinal": 4,
      "start_ms": 28580,
      "end_ms": 30440,
      "text": "要挺观念论"
    },
    {
      "ordinal": 5,
      "start_ms": 32000,
      "end_ms": 34180,
      "text": "要听结构主义"
    },
    {
      "ordinal": 6,
      "start_ms": 35660,
      "end_ms": 38200,
      "text": "要挺这个结构主义"
    },
    {
      "ordinal": 7,
      "start_ms": 38200,
      "end_ms": 43019,
      "text": "结构主义的整体论"
    },
    {
      "ordinal": 8,
      "start_ms": 46320,
      "end_ms": 48140,
      "text": "说我不反思这东西"
    },
    {
      "ordinal": 9,
      "start_ms": 48140,
      "end_ms": 49300,
      "text": "说我是"
    },
    {
      "ordinal": 10,
      "start_ms": 51720,
      "end_ms": 53600,
      "text": "我靠我"
    },
    {
      "ordinal": 11,
      "start_ms": 53600,
      "end_ms": 54230,
      "text": "我有点"
    },
    {
      "ordinal": 12,
      "start_ms": 54230,
      "end_ms": 58320,
      "text": "我睡前就说我天天在反思这东西"
    },
    {
      "ordinal": 13,
      "start_ms": 58320,
      "end_ms": 59640,
      "text": "我反思这个东西"
    },
    {
      "ordinal": 14,
      "start_ms": 59640,
      "end_ms": 62959,
      "text": "我出了几百个视频了吧"
    },
    {
      "ordinal": 15,
      "start_ms": 69560,
      "end_ms": 70960,
      "text": "反观念论"
    },
    {
      "ordinal": 16,
      "start_ms": 70960,
      "end_ms": 74250,
      "text": "我举的旗子够不够高了"
    },
    {
      "ordinal": 17,
      "start_ms": 74250,
      "end_ms": 75930,
      "text": "我出n个视频讲"
    },
    {
      "ordinal": 18,
      "start_ms": 75930,
      "end_ms": 77070,
      "text": "为什么关键论是错的"
    },
    {
      "ordinal": 19,
      "start_ms": 77070,
      "end_ms": 80310,
      "text": "为什么关键论里面那个主体的绝对性独一性啊"
    },
    {
      "ordinal": 20,
      "start_ms": 80310,
      "end_ms": 82860,
      "text": "为什么关键论里面的那个体系的循环性"
    },
    {
      "ordinal": 21,
      "start_ms": 82860,
      "end_ms": 85480,
      "text": "为什么关键论里面的种种种种"
    },
    {
      "ordinal": 22,
      "start_ms": 88100,
      "end_ms": 89800,
      "text": "反辩证法"
    },
    {
      "ordinal": 23,
      "start_ms": 89800,
      "end_ms": 92050,
      "text": "辩证法失灵的地方"
    },
    {
      "ordinal": 24,
      "start_ms": 92050,
      "end_ms": 95200,
      "text": "我讲的所有的精神分析当中的症状"
    },
    {
      "ordinal": 25,
      "start_ms": 95200,
      "end_ms": 98150,
      "text": "发声学都是在讲辩证法失灵的地方"
    },
    {
      "ordinal": 26,
      "start_ms": 102780,
      "end_ms": 106280,
      "text": "整个爱欲经济学体系都是在反辨认罚"
    },
    {
      "ordinal": 27,
      "start_ms": 107360,
      "end_ms": 109119,
      "text": "你们可能看不出来"
    },
    {
      "ordinal": 28,
      "start_ms": 109360,
      "end_ms": 113940,
      "text": "反辩证法律不能打着旗号说我是在反辩证法"
    },
    {
      "ordinal": 29,
      "start_ms": 114360,
      "end_ms": 115740,
      "text": "像德勒兹做的那样"
    },
    {
      "ordinal": 30,
      "start_ms": 115740,
      "end_ms": 119039,
      "text": "那你的辨认你的反辩证法就会变成另外一种辩证法"
    },
    {
      "ordinal": 31,
      "start_ms": 119680,
      "end_ms": 120660,
      "text": "明白吧"
    },
    {
      "ordinal": 32,
      "start_ms": 120660,
      "end_ms": 123840,
      "text": "反辨认法必须像黑格尔自己说的"
    },
    {
      "ordinal": 33,
      "start_ms": 123840,
      "end_ms": 125250,
      "text": "精神是头盖骨"
    },
    {
      "ordinal": 34,
      "start_ms": 125250,
      "end_ms": 126700,
      "text": "那我就说了"
    },
    {
      "ordinal": 35,
      "start_ms": 127640,
      "end_ms": 129639,
      "text": "脸漂亮是骷髅头"
    },
    {
      "ordinal": 36,
      "start_ms": 129639,
      "end_ms": 130419,
      "text": "是鼻孔"
    },
    {
      "ordinal": 37,
      "start_ms": 130419,
      "end_ms": 130930,
      "text": "骷髅头"
    },
    {
      "ordinal": 38,
      "start_ms": 130930,
      "end_ms": 133990,
      "text": "反辩证法的实践只能直接做"
    },
    {
      "ordinal": 39,
      "start_ms": 133990,
      "end_ms": 136320,
      "text": "不能说说出来就不灵了"
    },
    {
      "ordinal": 40,
      "start_ms": 138180,
      "end_ms": 141980,
      "text": "他你知不知道我做了多少反变的"
    },
    {
      "ordinal": 41,
      "start_ms": 141980,
      "end_ms": 143040,
      "text": "反而努力"
    },
    {
      "ordinal": 42,
      "start_ms": 143480,
      "end_ms": 147860,
      "text": "你知不知道真正的反辩证法的就是反黑格尔"
    },
    {
      "ordinal": 43,
      "start_ms": 147860,
      "end_ms": 149570,
      "text": "反黑格尔一场辩证法"
    },
    {
      "ordinal": 44,
      "start_ms": 149570,
      "end_ms": 154960,
      "text": "罗素都没有能力真正知道黑格尔的辩证法的症结在哪里"
    },
    {
      "ordinal": 45,
      "start_ms": 154960,
      "end_ms": 159160,
      "text": "他是个他是个他虽然自称是个黑格尔主义之后的这个学家"
    },
    {
      "ordinal": 46,
      "start_ms": 159160,
      "end_ms": 165540,
      "text": "但是他完全不理解黑格尔真正的反黑格尔辩证法的唯一方式"
    },
    {
      "ordinal": 47,
      "start_ms": 168270,
      "end_ms": 170520,
      "text": "在历史的现实当中去做"
    },
    {
      "ordinal": 48,
      "start_ms": 170660,
      "end_ms": 173270,
      "text": "什么叫历史的现实当中去做"
    },
    {
      "ordinal": 49,
      "start_ms": 173270,
      "end_ms": 175340,
      "text": "你知道在历史的现实当中"
    },
    {
      "ordinal": 50,
      "start_ms": 175340,
      "end_ms": 182910,
      "text": "做一个反黑格尔的那种绝对者观念论的那种辩证法的那种"
    },
    {
      "ordinal": 51,
      "start_ms": 182910,
      "end_ms": 185000,
      "text": "你知道意味着什么吗"
    },
    {
      "ordinal": 52,
      "start_ms": 185920,
      "end_ms": 187360,
      "text": "你什么都不知道"
    },
    {
      "ordinal": 53,
      "start_ms": 187360,
      "end_ms": 189100,
      "text": "你无知透顶"
    },
    {
      "ordinal": 54,
      "start_ms": 189399,
      "end_ms": 192309,
      "text": "你在冒犯一个神圣的任务"
    },
    {
      "ordinal": 55,
      "start_ms": 192309,
      "end_ms": 196850,
      "text": "你就你你做这种事情也是极为可耻的"
    },
    {
      "ordinal": 56,
      "start_ms": 196850,
      "end_ms": 198440,
      "text": "但是由于你的无知"
    },
    {
      "ordinal": 57,
      "start_ms": 198440,
      "end_ms": 199700,
      "text": "我原谅"
    },
    {
      "ordinal": 58,
      "start_ms": 199980,
      "end_ms": 201600,
      "text": "由于你的极度无知"
    },
    {
      "ordinal": 59,
      "start_ms": 201600,
      "end_ms": 203160,
      "text": "我就盯苍蝇死"
    },
    {
      "ordinal": 60,
      "start_ms": 203160,
      "end_ms": 206780,
      "text": "盯的已经是尸神落魄的"
    },
    {
      "ordinal": 61,
      "start_ms": 207559,
      "end_ms": 214820,
      "text": "我不和你这种三流四流货色一般见识呃"
    },
    {
      "ordinal": 62,
      "start_ms": 214820,
      "end_ms": 217190,
      "text": "另外一方面啊"
    },
    {
      "ordinal": 63,
      "start_ms": 217190,
      "end_ms": 219840,
      "text": "反结构主义整体论"
    },
    {
      "ordinal": 64,
      "start_ms": 220119,
      "end_ms": 221319,
      "text": "那很明显"
    },
    {
      "ordinal": 65,
      "start_ms": 221319,
      "end_ms": 226560,
      "text": "反结构主义整体论你必须要有你自己的主体性的发声学"
    },
    {
      "ordinal": 66,
      "start_ms": 236959,
      "end_ms": 241460,
      "text": "你觉得我能不足够去反思结构主义整体论吗"
    },
    {
      "ordinal": 67,
      "start_ms": 244490,
      "end_ms": 248060,
      "text": "你就说这个结构主义整体论为什么就就是打破他"
    },
    {
      "ordinal": 68,
      "start_ms": 248060,
      "end_ms": 250300,
      "text": "就是要去搞主体性发声学"
    },
    {
      "ordinal": 69,
      "start_ms": 254339,
      "end_ms": 256440,
      "text": "你的这几个为什么"
    },
    {
      "ordinal": 70,
      "start_ms": 258999,
      "end_ms": 260579,
      "text": "我现在说你不配"
    },
    {
      "ordinal": 71,
      "start_ms": 260579,
      "end_ms": 263399,
      "text": "知道为什么你不配"
    },
    {
      "ordinal": 72,
      "start_ms": 263399,
      "end_ms": 264440,
      "text": "你知道吗"
    },
    {
      "ordinal": 73,
      "start_ms": 264599,
      "end_ms": 265979,
      "text": "你知道你不配吗"
    },
    {
      "ordinal": 74,
      "start_ms": 284030,
      "end_ms": 288580,
      "text": "你不配你不配就是不配"
    },
    {
      "ordinal": 75,
      "start_ms": 290259,
      "end_ms": 291659,
      "text": "这个我都讲过啊"
    },
    {
      "ordinal": 76,
      "start_ms": 291659,
      "end_ms": 293039,
      "text": "我都讲过啊"
    },
    {
      "ordinal": 77,
      "start_ms": 293039,
      "end_ms": 296139,
      "text": "我都讲过啊"
    },
    {
      "ordinal": 78,
      "start_ms": 296139,
      "end_ms": 296919,
      "text": "我就讲过"
    },
    {
      "ordinal": 79,
      "start_ms": 296919,
      "end_ms": 298119,
      "text": "我不想在这里重复"
    },
    {
      "ordinal": 80,
      "start_ms": 298119,
      "end_ms": 301539,
      "text": "我不想给这些废物敌人以某种暗示"
    },
    {
      "ordinal": 81,
      "start_ms": 301539,
      "end_ms": 303999,
      "text": "因为我觉得他们过的人生是可耻可鄙的"
    },
    {
      "ordinal": 82,
      "start_ms": 303999,
      "end_ms": 304850,
      "text": "肮脏的"
    },
    {
      "ordinal": 83,
      "start_ms": 304850,
      "end_ms": 307320,
      "text": "我不想我不想争取他们"
    },
    {
      "ordinal": 84,
      "start_ms": 307320,
      "end_ms": 309660,
      "text": "我放任他们被历史的潮流裹挟"
    },
    {
      "ordinal": 85,
      "start_ms": 309660,
      "end_ms": 314440,
      "text": "变成那种令人憎恶的那种那种那种那种玩意"
    },
    {
      "ordinal": 86,
      "start_ms": 315040,
      "end_ms": 316770,
      "text": "我我觉得很庆幸"
    },
    {
      "ordinal": 87,
      "start_ms": 316770,
      "end_ms": 320920,
      "text": "我对历史的这种这种这种对于人类尊严的背叛"
    },
    {
      "ordinal": 88,
      "start_ms": 320920,
      "end_ms": 321760,
      "text": "在他们身上的"
    },
    {
      "ordinal": 89,
      "start_ms": 321760,
      "end_ms": 322900,
      "text": "对于人类尊严的背叛"
    },
    {
      "ordinal": 90,
      "start_ms": 322900,
      "end_ms": 323950,
      "text": "我觉得庆幸"
    },
    {
      "ordinal": 91,
      "start_ms": 323950,
      "end_ms": 328510,
      "text": "这是我唯一为历史的可憎的一面欢呼的地方"
    },
    {
      "ordinal": 92,
      "start_ms": 328510,
      "end_ms": 330440,
      "text": "我觉得没有任何同情"
    },
    {
      "ordinal": 93,
      "start_ms": 334100,
      "end_ms": 335260,
      "text": "结构主义整体论"
    },
    {
      "ordinal": 94,
      "start_ms": 335260,
      "end_ms": 336550,
      "text": "如果说要反的话"
    },
    {
      "ordinal": 95,
      "start_ms": 336550,
      "end_ms": 337510,
      "text": "这样说吧"
    },
    {
      "ordinal": 96,
      "start_ms": 337510,
      "end_ms": 338740,
      "text": "比较朴素的"
    },
    {
      "ordinal": 97,
      "start_ms": 338740,
      "end_ms": 340960,
      "text": "整个佛教都是结构主义整体论"
    },
    {
      "ordinal": 98,
      "start_ms": 340960,
      "end_ms": 343420,
      "text": "整个佛教哲学名相都是假的"
    },
    {
      "ordinal": 99,
      "start_ms": 344240,
      "end_ms": 349600,
      "text": "或者说这种拆分女性的这种整个一个险叫外面的这些玩意"
    },
    {
      "ordinal": 100,
      "start_ms": 349600,
      "end_ms": 350260,
      "text": "全他妈假的"
    },
    {
      "ordinal": 101,
      "start_ms": 350260,
      "end_ms": 354799,
      "text": "是整个佛教的哲学或都都是反结构主义整体论的"
    },
    {
      "ordinal": 102,
      "start_ms": 354799,
      "end_ms": 357859,
      "text": "那我我我我还进一步批判佛"
    },
    {
      "ordinal": 103,
      "start_ms": 357859,
      "end_ms": 362890,
      "text": "我整个整个佛教哲学都是都是结构主义整体论啊"
    },
    {
      "ordinal": 104,
      "start_ms": 362890,
      "end_ms": 367500,
      "text": "我我我一整个地批判了佛教哲学的源流"
    },
    {
      "ordinal": 105,
      "start_ms": 367659,
      "end_ms": 369099,
      "text": "这工作还不够吗"
    },
    {
      "ordinal": 106,
      "start_ms": 369099,
      "end_ms": 370059,
      "text": "你懂个屁呀"
    },
    {
      "ordinal": 107,
      "start_ms": 370059,
      "end_ms": 374470,
      "text": "我靠说老子缺乏反思性"
    },
    {
      "ordinal": 108,
      "start_ms": 374470,
      "end_ms": 375700,
      "text": "也对于反思性"
    },
    {
      "ordinal": 109,
      "start_ms": 375700,
      "end_ms": 376780,
      "text": "知道个毛"
    },
    {
      "ordinal": 110,
      "start_ms": 376780,
      "end_ms": 379030,
      "text": "你知道什么叫反思吗"
    },
    {
      "ordinal": 111,
      "start_ms": 379030,
      "end_ms": 380130,
      "text": "废物而言"
    },
    {
      "ordinal": 112,
      "start_ms": 380130,
      "end_ms": 381570,
      "text": "三流四流货色"
    },
    {
      "ordinal": 113,
      "start_ms": 381570,
      "end_ms": 382350,
      "text": "我是不是三流"
    },
    {
      "ordinal": 114,
      "start_ms": 382350,
      "end_ms": 383070,
      "text": "我每次说三流"
    },
    {
      "ordinal": 115,
      "start_ms": 383070,
      "end_ms": 383790,
      "text": "我要改口"
    },
    {
      "ordinal": 116,
      "start_ms": 383790,
      "end_ms": 384690,
      "text": "罗素是三流"
    },
    {
      "ordinal": 117,
      "start_ms": 384690,
      "end_ms": 385350,
      "text": "你是四流"
    },
    {
      "ordinal": 118,
      "start_ms": 385350,
      "end_ms": 385890,
      "text": "四流货色"
    },
    {
      "ordinal": 119,
      "start_ms": 385890,
      "end_ms": 387780,
      "text": "你知道什么叫反思性吗"
    },
    {
      "ordinal": 120,
      "start_ms": 397639,
      "end_ms": 399219,
      "text": "i feel disgusting"
    },
    {
      "ordinal": 121,
      "start_ms": 399219,
      "end_ms": 403029,
      "text": "那我们就说我们要讲的就是这类人物为什么让我感到恶心"
    },
    {
      "ordinal": 122,
      "start_ms": 403029,
      "end_ms": 406880,
      "text": "我这样说的这类人物为什么令人感到恶心啊"
    },
    {
      "ordinal": 123,
      "start_ms": 409420,
      "end_ms": 412130,
      "text": "因为首先它维护自信统治"
    },
    {
      "ordinal": 124,
      "start_ms": 412130,
      "end_ms": 415490,
      "text": "他维护一种他的反思是假反思不彻底的"
    },
    {
      "ordinal": 125,
      "start_ms": 415490,
      "end_ms": 418100,
      "text": "他的反思是一部分人有反思权"
    },
    {
      "ordinal": 126,
      "start_ms": 418100,
      "end_ms": 419980,
      "text": "或者他鼓励提倡一部分"
    },
    {
      "ordinal": 127,
      "start_ms": 419980,
      "end_ms": 423880,
      "text": "卧槽就应该按他那个方式去玩儿反思的游戏"
    },
    {
      "ordinal": 128,
      "start_ms": 423880,
      "end_ms": 425660,
      "text": "反思的贵族游戏"
    },
    {
      "ordinal": 129,
      "start_ms": 426020,
      "end_ms": 429240,
      "text": "他又是这种贵族游戏是无门槛的"
    },
