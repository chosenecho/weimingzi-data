    {
      "ordinal": 95,
      "start_ms": 295250,
      "end_ms": 297200,
      "text": "获得某种确定性的那种人"
    },
    {
      "ordinal": 96,
      "start_ms": 297200,
      "end_ms": 299600,
      "text": "所以他就麻痹了一个本质主义者"
    },
    {
      "ordinal": 97,
      "start_ms": 299600,
      "end_ms": 300770,
      "text": "他还是个本质主义"
    },
    {
      "ordinal": 98,
      "start_ms": 300770,
      "end_ms": 301730,
      "text": "各种后现代主义"
    },
    {
      "ordinal": 99,
      "start_ms": 301730,
      "end_ms": 304240,
      "text": "他还是一种本质主义啊"
    },
    {
      "ordinal": 100,
      "start_ms": 304240,
      "end_ms": 305860,
      "text": "那么在这个过程中"
    },
    {
      "ordinal": 101,
      "start_ms": 305860,
      "end_ms": 310299,
      "text": "我我劝我劝这周本质主义者"
    },
    {
      "ordinal": 102,
      "start_ms": 310299,
      "end_ms": 311979,
      "text": "这种麻痹的本质主义者"
    },
    {
      "ordinal": 103,
      "start_ms": 311979,
      "end_ms": 315450,
      "text": "这种后现代庸俗后现代主义者看到一个东西"
    },
    {
      "ordinal": 104,
      "start_ms": 315450,
      "end_ms": 319110,
      "text": "就是他们这些东西之间的一个不要看到的差异"
    },
    {
      "ordinal": 105,
      "start_ms": 319110,
      "end_ms": 322260,
      "text": "要看到他们的一个公约数"
    },
    {
      "ordinal": 106,
      "start_ms": 323680,
      "end_ms": 324600,
      "text": "他们的公约数"
    },
    {
      "ordinal": 107,
      "start_ms": 324600,
      "end_ms": 327060,
      "text": "这个时候你就是要利用除法的思维"
    },
    {
      "ordinal": 108,
      "start_ms": 327060,
      "end_ms": 328710,
      "text": "他们的公约数是什么"
