    {
      "ordinal": 16,
      "start_ms": 55380,
      "end_ms": 57740,
      "text": "我们就给它不叫新的表象"
    },
    {
      "ordinal": 17,
      "start_ms": 57740,
      "end_ms": 59300,
      "text": "我们就表象加一撇"
    },
    {
      "ordinal": 18,
      "start_ms": 61740,
      "end_ms": 64709,
      "text": "表象加一撇在下面啊"
    },
    {
      "ordinal": 19,
      "start_ms": 64709,
      "end_ms": 69419,
