    {
      "ordinal": 109,
      "start_ms": 328710,
      "end_ms": 330220,
      "text": "是这个"
    },
    {
      "ordinal": 110,
      "start_ms": 332100,
      "end_ms": 338180,
      "text": "内向型内向运动是一种内在性"
    },
    {
      "ordinal": 111,
      "start_ms": 339639,
      "end_ms": 342539,
      "text": "是这种内在性就是你永远可以做哦"
    },
    {
      "ordinal": 112,
      "start_ms": 342539,
      "end_ms": 344480,
      "text": "这个表象眠不过是什么"
    },
    {
      "ordinal": 113,
      "start_ms": 344480,
      "end_ms": 346160,
      "text": "这个表象不过是什么"
    },
    {
      "ordinal": 114,
      "start_ms": 346160,
      "end_ms": 347540,
      "text": "这个表象不过是什么"
    },
    {
      "ordinal": 115,
      "start_ms": 347540,
      "end_ms": 348740,
      "text": "这个表象不过是什么"
    },
    {
      "ordinal": 116,
      "start_ms": 348740,
      "end_ms": 353400,
      "text": "这个不过你可以把它看成是一种不停的进行"
    },
    {
      "ordinal": 117,
      "start_ms": 353400,
      "end_ms": 355080,
      "text": "但是它不过时"
    },
    {
      "ordinal": 118,
      "start_ms": 355080,
      "end_ms": 357240,
      "text": "或者说它实质上不过是他"
    },
    {
      "ordinal": 119,
      "start_ms": 357240,
      "end_ms": 358840,
      "text": "他本质上是你不停的说"
    },
    {
      "ordinal": 120,
      "start_ms": 358840,
      "end_ms": 360100,
      "text": "它本质上不过是本质上"
    },
    {
      "ordinal": 121,
      "start_ms": 360100,
      "end_ms": 363040,
      "text": "不过是本质上不过是假设有一个本质在那边"
    },
