    {
      "ordinal": 93,
      "start_ms": 290779,
      "end_ms": 292169,
      "text": "他是没办法"
    },
    {
      "ordinal": 94,
      "start_ms": 292169,
      "end_ms": 295250,
      "text": "没办法在这种消解表象的过程当中"
