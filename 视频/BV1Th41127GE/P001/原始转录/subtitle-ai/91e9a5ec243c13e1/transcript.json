    {
      "ordinal": 24,
      "start_ms": 83020,
      "end_ms": 85120,
      "text": "再往里面又一层表象"
    },
    {
      "ordinal": 25,
      "start_ms": 85120,
      "end_ms": 86320,
      "text": "我举个例子啊"
