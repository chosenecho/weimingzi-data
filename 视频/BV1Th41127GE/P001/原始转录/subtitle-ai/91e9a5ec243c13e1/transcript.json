    },
    {
      "ordinal": 35,
      "start_ms": 110510,
      "end_ms": 119820,
      "text": "是一个是一个啊物理学公式和物理学公式啊"
    },
    {
      "ordinal": 36,
      "start_ms": 119820,
      "end_ms": 122280,
      "text": "他说会第二层表象是什么"
    },
    {
      "ordinal": 37,
      "start_ms": 122880,
      "end_ms": 124710,
      "text": "原子想象模式"
    },
    {
      "ordinal": 38,
      "start_ms": 124710,
      "end_ms": 126720,
      "text": "原子的想象模式"
    },
    {
      "ordinal": 39,
      "start_ms": 126720,
      "end_ms": 130699,
      "text": "原子想象图下面一层表象"
    },
    {
      "ordinal": 40,
      "start_ms": 130699,
      "end_ms": 132109,
      "text": "什么原子的想象图"
    },
    {
      "ordinal": 41,
      "start_ms": 132109,
      "end_ms": 133279,
      "text": "不过是什么"
    },
    {
      "ordinal": 42,
      "start_ms": 133279,
      "end_ms": 136179,
      "text": "不过是人类啊"
    },
    {
      "ordinal": 43,
      "start_ms": 136179,
      "end_ms": 140080,
      "text": "这个这个社群社群的"
    },
    {
      "ordinal": 44,
      "start_ms": 141859,
