{"segments":[{"start":0.38,"end":3.659,"text":"这第一个视频我现在回应一个信件啊"},{"start":12.14,"end":13.68,"text":"可以公开啊"},{"start":34.16,"end":35.08,"text":"未明子你好"},{"start":35.08,"end":35.8,"text":"我叫秋香"},{"start":35.8,"end":36.7,"text":"今年27岁"},{"start":36.7,"end":38.5,"text":"已经工作13年"},{"start":38.5,"end":40.19,"text":"14岁开始工作了"},{"start":40.19,"end":41.33,"text":"受我父亲的影响"},{"start":41.33,"end":43.07,"text":"从小比较喜欢看书阅读"},{"start":43.07,"end":44.21,"text":"也因为种种原因"},{"start":44.21,"end":45.65,"text":"成长之路一直比较痛苦"},{"start":45.65,"end":47.45,"text":"所以脑子也喜欢胡思乱想"},{"start":47.45,"end":50.35,"text":"如此下来便就是现在的我了"},{"start":50.35,"end":57.07,"text":"来信无非就是想说一些对我现实当下的一些问题以及迷茫"},{"start":57.07,"end":60.77,"text":"不是想在您这里得到什么答案"},{"start":60.77,"end":63.08,"text":"入总还是得自己一步步走"},{"start":63.08,"end":63.74,"text":"文化不高"},{"start":63.74,"end":64.64,"text":"表示能力有限"},{"start":64.64,"end":65.91,"text":"尽请谅解"},{"start":65.91,"end":69.09,"text":"和大部分我这种成长经历相似的人来说"},{"start":69.09,"end":70.8,"text":"我的社会经历也是如此"},{"start":70.8,"end":72.42,"text":"没有稳定的工作"},{"start":73.92,"end":75.62,"text":"没有过硬的专业技能"},{"start":75.62,"end":76.58,"text":"也没有存到钱"},{"start":76.58,"end":80.64,"text":"所以一直维持在这种没有发展得过且过的生存状态"},{"start":80.78,"end":83.18,"text":"之前也想过这些问题"},{"start":83.18,"end":85.04,"text":"也想过这些问题啊"},{"start":85.04,"end":86.48,"text":"读书这条路走不通"},{"start":86.48,"end":88.82,"text":"那就要有个技术"},{"start":91.28,"end":94.6,"text":"第一份学徒工作是我父亲帮我找的铲车维修"},{"start":94.6,"end":95.44,"text":"然而不到半年"},{"start":95.44,"end":96.87,"text":"因为我年纪小"},{"start":96.87,"end":98.19,"text":"安全意识不够强"},{"start":98.19,"end":99.78,"text":"在一次维修工作中"},{"start":99.78,"end":101.4,"text":"师傅在操作铲车"},{"start":101.4,"end":103.59,"text":"当时已经拆掉了一个后轮"},{"start":103.59,"end":105.51,"text":"用千斤顶支撑着我"},{"start":105.51,"end":107.97,"text":"用手去扶千斤顶不慎倒塌"},{"start":107.97,"end":113.77,"text":"导致我左手食指中指无名指三个手指粉碎性骨折"},{"start":113.77,"end":115.84,"text":"应该是09年发生的事情"},{"start":115.84,"end":117.7,"text":"那就11年之前"},{"start":118.76,"end":119.8,"text":"09年"},{"start":126.86,"end":129.16,"text":"后来在医院养了几个月"},{"start":129.16,"end":132.04,"text":"这期间我父亲在一些其他病友的劝说下"},{"start":132.04,"end":134.92,"text":"他之前不准备找我师傅要赔偿金"},{"start":134.92,"end":139.23,"text":"所以在出院后向对方四人要了5万块钱"},{"start":139.23,"end":140.97,"text":"当时我跟她交涉说"},{"start":140.97,"end":142.41,"text":"想回去继续念书"},{"start":142.41,"end":143.99,"text":"他15岁啊"},{"start":143.99,"end":144.92,"text":"我他不同意"},{"start":144.92,"end":146.75,"text":"他一直对我灌输读书无用论"},{"start":146.75,"end":147.92,"text":"觉得自己很厉害"},{"start":147.92,"end":149.3,"text":"15岁就出去闯世界了"},{"start":149.3,"end":151.68,"text":"那儿子带着14岁就出去闯了"},{"start":151.68,"end":152.46,"text":"我们吵了一架"},{"start":152.46,"end":153.6,"text":"我没能顺利"},{"start":153.6,"end":159.769,"text":"后来他拿那笔钱加盟了一家通过电视广告看到的某种新奇小吃点"},{"start":165.44,"end":167.16,"text":"各走各韭菜割走了"},{"start":168.219,"end":170.219,"text":"结果是在两个月时间不到"},{"start":170.219,"end":171.62,"text":"这笔钱就一分不剩了"},{"start":171.62,"end":172.46,"text":"在这之后"},{"start":172.46,"end":174.77,"text":"我与他很多地方冲突起来啊"},{"start":174.77,"end":176.3,"text":"冲冲突越来越大"},{"start":176.3,"end":177.26,"text":"矛盾越来越深"},{"start":177.26,"end":178.76,"text":"于是就离开他"},{"start":183.26,"end":184.42,"text":"投奔朋友去了"},{"start":184.42,"end":185.98,"text":"虽然摆脱了我父亲"},{"start":185.98,"end":188.26,"text":"可是我一个人在外面生存也并不如意"},{"start":188.26,"end":189.36,"text":"做过很多工作"},{"start":189.36,"end":190.32,"text":"淘宝客服"},{"start":190.32,"end":192.24,"text":"仓库打包花店学徒"},{"start":192.24,"end":193.02,"text":"还在后厨"},{"start":193.02,"end":194.83,"text":"总之每份工作都不久"},{"start":194.83,"end":196.15,"text":"总是很快厌烦"},{"start":196.15,"end":197.579,"text":"并选择放弃"},{"start":197.579,"end":199.679,"text":"疫情过后生存难度加大"},{"start":199.679,"end":201.059,"text":"于是我也进过工厂"},{"start":201.059,"end":201.989,"text":"送过外卖"},{"start":201.989,"end":203.639,"text":"当然一样时间干不长"},{"start":203.639,"end":206.19,"text":"不过确实增强了自己的吃苦能力"},{"start":206.19,"end":207.93,"text":"一直苟活到现在"},{"start":207.93,"end":209.07,"text":"可能因为性格关系"},{"start":209.07,"end":212.63,"text":"我极度讨厌工厂里面12个小时不停的劳动"},{"start":212.63,"end":217.25,"text":"还有狠人恶心你"},{"start":217.25,"end":218.31,"text":"管控你"},{"start":218.31,"end":222.93,"text":"而我现今比较喜欢的工作是和朋友一起去做土地调查"},{"start":222.93,"end":225.33,"text":"每天开车去农村往山上跑"},{"start":225.33,"end":228.559,"text":"虽然有时候得钻草丛走"},{"start":228.559,"end":230.299,"text":"已经走不通了的路"},{"start":230.299,"end":234.88,"text":"可我喜欢这种边看风景边在路上的工作"},{"start":234.88,"end":236.89,"text":"还有就是工地做小工"},{"start":236.89,"end":242.73,"text":"土地调查的可能是受一些农业农农业公司"},{"start":242.73,"end":244.38,"text":"我我我就不明白"},{"start":244.38,"end":245.97,"text":"和一些投资公司委托吧"},{"start":245.97,"end":249.93,"text":"土地调查去调查土地的情况"},{"start":249.93,"end":251.64,"text":"农村土地的情况"},{"start":251.88,"end":253.74,"text":"还有就是在工地做小工"},{"start":253.74,"end":255.54,"text":"每天只需干八个小时"},{"start":255.54,"end":257.459,"text":"收入比厂里还要高一些"},{"start":257.839,"end":260.089,"text":"有相对充分的自己的时间"},{"start":260.089,"end":261.139,"text":"说回当下"},{"start":261.139,"end":262.579,"text":"由于之前上海封城"},{"start":262.579,"end":264.5,"text":"导致我放弃了啊"},{"start":264.5,"end":265.46,"text":"我的那份工作"},{"start":265.46,"end":266.72,"text":"并且换了一个城市"},{"start":271.119,"end":272.079,"text":"因为欠了一些钱"},{"start":272.079,"end":273.459,"text":"自己之前过度消费"},{"start":273.459,"end":274.779,"text":"以及帮助一个朋友分担"},{"start":274.779,"end":278.74,"text":"所以不得不做这种拿钱快的工作"},{"start":278.74,"end":280.72,"text":"正式工作会压工资"},{"start":281.2,"end":284.68,"text":"而且很有可能就是说就被坑了"},{"start":284.68,"end":286.09,"text":"就拿不到工资啊"},{"start":286.09,"end":289.0,"text":"所以他要做这种日结活啊"},{"start":289.0,"end":291.66,"text":"打算在9月份去内蒙捡土豆"},{"start":291.66,"end":293.76,"text":"我不知道他现在在不在捡土豆了"},{"start":293.76,"end":295.56,"text":"之前错过一个捡松塔的"},{"start":295.56,"end":296.88,"text":"能挣更多的活"},{"start":296.88,"end":298.68,"text":"让我懊恼不已"},{"start":299.94,"end":301.46,"text":"脑用的是月字旁"},{"start":301.46,"end":302.96,"text":"倒不是那个心字旁的"},{"start":302.96,"end":307.699,"text":"说明这个人还是崇尚脑力劳动啊"},{"start":307.699,"end":310.579,"text":"由于还有大概一个月的时间空档"},{"start":310.579,"end":314.1,"text":"准备在长沙找一个短期开车送货的工作"},{"start":314.14,"end":315.25,"text":"他会开车"},{"start":315.25,"end":319.66,"text":"就说明他十几年摸爬滚打还是能攒到一点钱"},{"start":319.66,"end":321.12,"text":"把驾照也削了"},{"start":321.2,"end":322.54,"text":"别考了"},{"start":322.64,"end":325.28,"text":"之前在宁波来长沙两个月左右"},{"start":325.28,"end":326.3,"text":"期间送过外卖"},{"start":326.3,"end":330.36,"text":"去广西和朋友做过土地调查啊"},{"start":330.36,"end":332.52,"text":"我的未来规划是把钱还完"},{"start":332.52,"end":335.3,"text":"然后报考一个成人考试区的一个学历"},{"start":335.3,"end":337.61,"text":"并且买一套比较便宜的房子"},{"start":337.61,"end":340.54,"text":"他这个28岁相当于人家活了两辈子啊"},{"start":343.98,"end":346.38,"text":"考完考学历"},{"start":346.38,"end":347.76,"text":"我一直相当于别人"},{"start":347.76,"end":352.98,"text":"就像很多人28岁可能研究生毕业的状况和他14岁差不多呀"},{"start":352.98,"end":354.82,"text":"他的生活丰富啊"},{"start":354.82,"end":358.219,"text":"天南海北都去过考考学历啊"},{"start":358.219,"end":360.019,"text":"我一直犹犹豫豫好几年了"},{"start":360.019,"end":362.9,"text":"虽然我知道成考并不能给"},{"start":365.22,"end":369.69,"text":"什么带来并不能给带来很大的现状改变"},{"start":369.69,"end":372.15,"text":"但我一直有这么个愿望"},{"start":372.15,"end":375.19,"text":"也许对未来一些考证有帮助"},{"start":375.19,"end":376.06,"text":"至于房子"},{"start":376.06,"end":377.47,"text":"因我是农村的"},{"start":377.47,"end":380.23,"text":"我家就我和父亲两个人"},{"start":380.23,"end":382.27,"text":"他又是一个极其不靠谱的人"},{"start":382.27,"end":383.53,"text":"且不走正路的人"},{"start":383.53,"end":385.59,"text":"所以我想给自己一个居所"},{"start":385.59,"end":387.99,"text":"我希望能组建一个自己的家庭"},{"start":387.99,"end":390.69,"text":"当然也想过在农村自己盖一个"},{"start":390.69,"end":393.16,"text":"可是现在农村建房比较麻烦"},{"start":393.16,"end":395.14,"text":"家里的田地我都不知道在哪里了"},{"start":395.14,"end":396.64,"text":"是否已经撂荒"},{"start":396.659,"end":399.839,"text":"而且和亲属关系也较为冷淡"},{"start":399.839,"end":402.509,"text":"我们父子在老家口风都不算好"},{"start":402.509,"end":404.15,"text":"并不想回到老家"},{"start":404.15,"end":405.32,"text":"说的可能比较乱"},{"start":405.32,"end":407.03,"text":"也没有表达出具体意思"},{"start":407.03,"end":409.79,"text":"如果老哥能给点建议供我参考"},{"start":409.79