{
  "bvid": "BV1RS4y1S7iv",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "4c597d659f8bfdee661c2321cbcef3d4e165c6714f4b2693f1c452b836d0af19",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 300,
      "end_ms": 4180,
      "text": "我今天要讲一个教师教育公开的"
    },
    {
      "ordinal": 1,
      "start_ms": 5080,
      "end_ms": 6640,
      "text": "违法的"
    },
    {
      "ordinal": 2,
      "start_ms": 9680,
      "end_ms": 12100,
      "text": "啊激进啊"
    },
    {
      "ordinal": 3,
      "start_ms": 14320,
      "end_ms": 15860,
      "text": "理想主义做斗争啊"
    },
    {
      "ordinal": 4,
      "start_ms": 23220,
      "end_ms": 26240,
      "text": "要与公开的违法的激进理想主义作斗争"
    },
    {
      "ordinal": 5,
      "start_ms": 26240,
      "end_ms": 27020,
      "text": "为什么呢"
    },
    {
      "ordinal": 6,
      "start_ms": 27020,
      "end_ms": 31350,
      "text": "不是因为我们站在一个什么既定秩序一边"
    },
    {
      "ordinal": 7,
      "start_ms": 31350,
      "end_ms": 35460,
      "text": "而是因为这是一种伪装的伪装的"
    },
    {
      "ordinal": 8,
      "start_ms": 37800,
      "end_ms": 38879,
      "text": "召回派"
    },
    {
      "ordinal": 9,
      "start_ms": 40620,
      "end_ms": 42140,
      "text": "这是一种机会主义"
    },
    {
      "ordinal": 10,
      "start_ms": 42140,
      "end_ms": 42920,
      "text": "投机主义"
    },
    {
      "ordinal": 11,
      "start_ms": 42920,
      "end_ms": 43520,
      "text": "你知道吗"
    },
    {
      "ordinal": 12,
      "start_ms": 43520,
      "end_ms": 46279,
      "text": "这是一种机会主义"
    },
    {
      "ordinal": 13,
      "start_ms": 47160,
      "end_ms": 48680,
      "text": "是一种投机主义"
    },
    {
      "ordinal": 14,
      "start_ms": 51860,
      "end_ms": 53500,
      "text": "Opportunism"
    },
    {
      "ordinal": 15,
      "start_ms": 53620,
      "end_ms": 58780,
      "text": "我靠为什么就是公开的啊"
    },
    {
      "ordinal": 16,
      "start_ms": 58780,
      "end_ms": 61140,
      "text": "违法的激进理想主义"
    },
    {
      "ordinal": 17,
      "start_ms": 61260,
      "end_ms": 64980,
      "text": "这个理想主义往往是它伪装成L或者伪装成S"
    },
    {
      "ordinal": 18,
      "start_ms": 64980,
      "end_ms": 66240,
      "text": "或者伪装成M"
    },
    {
      "ordinal": 19,
      "start_ms": 66240,
      "end_ms": 66660,
      "text": "无论如何"
    },
    {
      "ordinal": 20,
      "start_ms": 66660,
      "end_ms": 68160,
      "text": "它会伪装成这个东西"
    },
    {
      "ordinal": 21,
      "start_ms": 70740,
      "end_ms": 72320,
      "text": "卧槽他这个"
    },
    {
      "ordinal": 22,
      "start_ms": 74540,
      "end_ms": 78759,
      "text": "他其实就是说哦他就是有点"
    },
    {
      "ordinal": 23,
      "start_ms": 80440,
      "end_ms": 81900,
      "text": "我有点受不了了"
    },
    {
      "ordinal": 24,
      "start_ms": 81900,
      "end_ms": 82980,
      "text": "我有点受不了了"
    },
    {
      "ordinal": 25,
      "start_ms": 82980,
      "end_ms": 84000,
      "text": "我有点受不了了"
    },
    {
      "ordinal": 26,
      "start_ms": 84000,
      "end_ms": 86550,
      "text": "或者说他明知这种公开的话语"
    },
    {
      "ordinal": 27,
      "start_ms": 86550,
      "end_ms": 88140,
      "text": "他会意味着什么"
    },
    {
      "ordinal": 28,
      "start_ms": 88140,
      "end_ms": 89679,
      "text": "现实意味着什么"
    },
    {
      "ordinal": 29,
      "start_ms": 90960,
      "end_ms": 93590,
      "text": "但是他非要这样去啊"
    },
    {
      "ordinal": 30,
      "start_ms": 93590,
      "end_ms": 95060,
      "text": "捋捋虎须"
    },
    {
      "ordinal": 31,
      "start_ms": 95060,
      "end_ms": 98210,
      "text": "或者说非要这样去过嘴瘾"
    },
    {
      "ordinal": 32,
      "start_ms": 98210,
      "end_ms": 99660,
      "text": "过嘴瘾啊"
    },
    {
      "ordinal": 33,
      "start_ms": 105720,
      "end_ms": 108880,
      "text": "这是病态的病态的"
    },
    {
      "ordinal": 34,
      "start_ms": 110260,
      "end_ms": 115140,
      "text": "非常幼稚的病态的死就是小布尔乔亚性质"
    },
    {
      "ordinal": 35,
      "start_ms": 115140,
      "end_ms": 116600,
      "text": "小布尔乔亚心思"
    },
    {
      "ordinal": 36,
      "start_ms": 119160,
      "end_ms": 120860,
      "text": "他越这样呼喊"
    },
    {
      "ordinal": 37,
      "start_ms": 120860,
      "end_ms": 122540,
      "text": "这个压力不会到他头上"
    },
    {
      "ordinal": 38,
      "start_ms": 122540,
      "end_ms": 124400,
      "text": "因为他只是个匿名的网友而已"
    },
    {
      "ordinal": 39,
      "start_ms": 124400,
      "end_ms": 126360,
      "text": "他顶多去引导他"
    },
    {
      "ordinal": 40,
      "start_ms": 126360,
      "end_ms": 128639,
      "text": "顶多去写个保证书或者什么的"
    },
    {
      "ordinal": 41,
      "start_ms": 128639,
      "end_ms": 134539,
      "text": "但是这个压力是刺激真正的这个秩序啊"
    },
    {
      "ordinal": 42,
      "start_ms": 134539,
      "end_ms": 136639,
      "text": "他自己现实的秩序过度紧张"
    },
    {
      "ordinal": 43,
      "start_ms": 136639,
      "end_ms": 139789,
      "text": "以为就是已经形成一个什么局势或者怎么样了"
    },
    {
      "ordinal": 44,
      "start_ms": 139789,
      "end_ms": 143840,
      "text": "反而让那些在一线的普通人"
    },
    {
      "ordinal": 45,
      "start_ms": 144040,
      "end_ms": 147970,
      "text": "更受到更受到更大的紧张和压力"
    },
    {
      "ordinal": 46,
      "start_ms": 147970,
      "end_ms": 150520,
      "text": "他们他们并不是"
    },
    {
      "ordinal": 47,
      "start_ms": 150520,
      "end_ms": 155280,
      "text": "他们这种是他这个就是让别人压力更大"
    },
    {
      "ordinal": 48,
      "start_ms": 155280,
      "end_ms": 155880,
      "text": "你知道吗"
    },
    {
      "ordinal": 49,
      "start_ms": 155880,
      "end_ms": 157680,
      "text": "让现实的压力更大"
    },
    {
      "ordinal": 50,
      "start_ms": 158880,
      "end_ms": 160340,
      "text": "这种事是什么"
    },
    {
      "ordinal": 51,
      "start_ms": 160340,
      "end_ms": 161420,
      "text": "你是我操"
    },
    {
      "ordinal": 52,
      "start_ms": 161420,
      "end_ms": 162860,
      "text": "是你是一个"
    },
    {
      "ordinal": 53,
      "start_ms": 163359,
      "end_ms": 167019,
      "text": "当然违法性肯定是已经很糟糕了"
    },
    {
      "ordinal": 54,
      "start_ms": 167019,
      "end_ms": 168100,
      "text": "很错误了"
    },
    {
      "ordinal": 55,
      "start_ms": 168540,
      "end_ms": 170880,
      "text": "你这个还公开去闹"
    },
    {
      "ordinal": 56,
      "start_ms": 170880,
      "end_ms": 174000,
      "text": "公开去宣扬这种违法的激进主义啊"
    },
    {
      "ordinal": 57,
      "start_ms": 174000,
      "end_ms": 175360,
      "text": "激进的理想主义"
    },
    {
      "ordinal": 58,
      "start_ms": 178360,
      "end_ms": 179640,
      "text": "它有两个效果"
    },
    {
      "ordinal": 59,
      "start_ms": 179640,
      "end_ms": 181740,
      "text": "一方面就是好像包容了他"
    },
    {
      "ordinal": 60,
      "start_ms": 181740,
      "end_ms": 186519,
      "text": "包容了他包容了这个东西啊"
    },
    {
      "ordinal": 61,
      "start_ms": 186519,
      "end_ms": 192279,
      "text": "上面包容了他就隐约觉得上面还是有某种"
    },
    {
      "ordinal": 62,
      "start_ms": 195680,
      "end_ms": 199880,
      "text": "就就就他想造成一种幻觉幻觉"
    },
    {
      "ordinal": 63,
      "start_ms": 199880,
      "end_ms": 200660,
      "text": "你懂吗"
    },
    {
      "ordinal": 64,
      "start_ms": 200660,
      "end_ms": 203600,
      "text": "就就啊上面包容他这些人"
    },
    {
      "ordinal": 65,
      "start_ms": 203600,
      "end_ms": 206140,
      "text": "就就俨然就他自己就是怎么样"
    },
    {
      "ordinal": 66,
      "start_ms": 206339,
      "end_ms": 208199,
      "text": "他自己就好像就是他"
    },
    {
      "ordinal": 67,
      "start_ms": 208199,
      "end_ms": 211439,
      "text": "就他他就好像弄得他自己上面有人一样的"
    },
    {
      "ordinal": 68,
      "start_ms": 211439,
      "end_ms": 212939,
      "text": "就只有他能够这样"
    },
    {
      "ordinal": 69,
      "start_ms": 212939,
      "end_ms": 214379,
      "text": "别人不能够这样的"
    },
    {
      "ordinal": 70,
      "start_ms": 214379,
      "end_ms": 216240,
      "text": "他就隐约就觉得哦"
    },
    {
      "ordinal": 71,
      "start_ms": 216240,
      "end_ms": 219680,
      "text": "原来他是是其实他和上面是一条新的"
    },
    {
      "ordinal": 72,
      "start_ms": 220880,
      "end_ms": 224680,
      "text": "如果他说他的他的那个这种不当言论言论啊"
    },
    {
      "ordinal": 73,
      "start_ms": 224680,
      "end_ms": 227080,
      "text": "没有保留多久就被删除了的话"
    },
    {
      "ordinal": 74,
      "start_ms": 227080,
      "end_ms": 228940,
      "text": "这个应该是更更引导法"
    },
    {
      "ordinal": 75,
      "start_ms": 228940,
      "end_ms": 229990,
      "text": "更应当是这样的"
    },
    {
      "ordinal": 76,
      "start_ms": 229990,
      "end_ms": 231040,
      "text": "就被删除的话"
    },
    {
      "ordinal": 77,
      "start_ms": 231040,
      "end_ms": 235740,
      "text": "他就更加怨恨怨恨怨恨一切"
    },
    {
      "ordinal": 78,
      "start_ms": 235760,
      "end_ms": 237530,
      "text": "怨恨一切啊"
    },
    {
      "ordinal": 79,
      "start_ms": 237530,
      "end_ms": 240550,
      "text": "包括那些缓步推进的合理的那些言论"
    },
    {
      "ordinal": 80,
      "start_ms": 240550,
      "end_ms": 244030,
      "text": "包括那些真正到处现实真相的那些言论"
    },
    {
      "ordinal": 81,
      "start_ms": 244030,
      "end_ms": 245290,
      "text": "他就会怨恨他"
    },
    {
      "ordinal": 82,
      "start_ms": 245290,
      "end_ms": 247450,
      "text": "直觉得他的那种掀桌子的这些言论"
    },
    {
      "ordinal": 83,
      "start_ms": 247450,
      "end_ms": 249670,
      "text": "没有被公开的表达出来"
    },
    {
      "ordinal": 84,
      "start_ms": 249670,
      "end_ms": 251410,
      "text": "他就觉得一切都错了"
    },
    {
      "ordinal": 85,
      "start_ms": 251410,
      "end_ms": 253300,
      "text": "整个体系都是虚伪的"
    },
    {
      "ordinal": 86,
      "start_ms": 253300,
      "end_ms": 253960,
      "text": "都是假的"
    },
    {
      "ordinal": 87,
      "start_ms": 253960,
      "end_ms": 256060,
      "text": "他就陷于现在这种怨恨当中"
    },
    {
      "ordinal": 88,
      "start_ms": 256060,
      "end_ms": 257920,
      "text": "自我怜惜"
    },
    {
      "ordinal": 89,
      "start_ms": 257920,
      "end_ms": 260600,
      "text": "你开始陷入一种自恋了"
    },
    {
      "ordinal": 90,
      "start_ms": 261600,
      "end_ms": 263700,
      "text": "这种自恋是什么嘛"
    },
    {
      "ordinal": 91,
      "start_ms": 263880,
      "end_ms": 266070,
      "text": "这种自恋是什么东西嘛"
    },
    {
      "ordinal": 92,
      "start_ms": 266070,
      "end_ms": 267660,
      "text": "这种自恋无非就是"
    },
    {
      "ordinal": 93,
      "start_ms": 267660,
      "end_ms": 271060,
      "text": "他不想真正的去解决现实的状况"
    },
    {
      "ordinal": 94,
      "start_ms": 271080,
      "end_ms": 273540,
      "text": "他只想享用这种自恋"
    },
    {
      "ordinal": 95,
      "start_ms": 273540,
      "end_ms": 275720,
      "text": "他只想享用这种自我"
    },
    {
      "ordinal": 96,
      "start_ms": 278220,
      "end_ms": 280700,
      "text": "一自我嘲讽自己的无能"
    },
    {
      "ordinal": 97,
      "start_ms": 280700,
      "end_ms": 283700,
      "text": "另外一方面又嘲讽这个整个体系的无能"
    },
    {
      "ordinal": 98,
      "start_ms": 283700,
      "end_ms": 285800,
      "text": "说你连我这点话都不可能容忍你"
    },
    {
      "ordinal": 99,
      "start_ms": 285800,
      "end_ms": 287230,
      "text": "这个体系真是无能"
    },
    {
      "ordinal": 100,
      "start_ms": 287230,
      "end_ms": 290680,
      "text": "三嘲讽那些真正去行动者的无能"
    },
    {
      "ordinal": 101,
      "start_ms": 290680,
      "end_ms": 293740,
      "text": "他无非叫嘲讽一切的无能啊"
    },
    {
      "ordinal": 102,
      "start_ms": 293740,
      "end_ms": 295260,
      "text": "当然也包括他自己来"
    },
    {
      "ordinal": 103,
      "start_ms": 295320,
      "end_ms": 297180,
      "text": "他就把自己塑造成一个"
    },
    {
      "ordinal": 104,
      "start_ms": 297180,
      "end_ms": 300840,
      "text": "他有能力来看到所有这一切的无力的"
    },
    {
      "ordinal": 105,
      "start_ms": 300840,
      "end_ms": 303280,
      "text": "这一切无能的啊"
    },
    {
      "ordinal": 106,
      "start_ms": 303280,
      "end_ms": 304600,
      "text": "他就变成这种人啊"
    },
    {
      "ordinal": 107,
      "start_ms": 304600,
      "end_ms": 306340,
      "text": "他实际上就是想观看"
    },
    {
      "ordinal": 108,
      "start_ms": 307199,
      "end_ms": 309559,
      "text": "想在观看上获得某种胜利"
    },
    {
      "ordinal": 109,
      "start_ms": 309559,
      "end_ms": 312169,
      "text": "想在思维的判定上获得某种胜利"
    },
    {
      "ordinal": 110,
      "start_ms": 312169,
      "end_ms": 314560,
      "text": "这种胜利是没有任何意义的"
    },
    {
      "ordinal": 111,
      "start_ms": 314560,
      "end_ms": 316000,
      "text": "这种胜利是反动的"
    },
    {
      "ordinal": 112,
      "start_ms": 316000,
      "end_ms": 316540,
      "text": "这种胜利"
    },
    {
      "ordinal": 113,
      "start_ms": 316540,
      "end_ms": 319840,
      "text": "无非就是对于现实状况不断的一个确认"
    },
    {
      "ordinal": 114,
      "start_ms": 319840,
      "end_ms": 324180,
      "text": "他他需要现实处在一个他随时随地可以看到的"
    },
    {
      "ordinal": 115,
      "start_ms": 324180,
      "end_ms": 325230,
      "text": "一个糟糕的状况"
    },
    {
      "ordinal": 116,
      "start_ms": 325230,
      "end_ms": 326850,
      "text": "他才能获得这种优越感"
    },
    {
      "ordinal": 117,
      "start_ms": 326850,
      "end_ms": 328659,
      "text": "沉溺在这种优越感当中啊"
    },
    {
      "ordinal": 118,
      "start_ms": 328659,
      "end_ms": 330939,
      "text": "就是这个让我感到非常的荒谬"
    },
    {
      "ordinal": 119,
      "start_ms": 330939,
      "end_ms": 332439,
      "text": "这个是在我们这个时代"
    },
    {
      "ordinal": 120,
      "start_ms": 332439,
      "end_ms": 335740,
      "text": "让我感到极为的不是的奇怪"
    },
    {
      "ordinal": 121,
      "start_ms": 335740,
      "end_ms": 336760,
      "text": "觉得恶心的"
    },
    {
      "ordinal": 122,
      "start_ms": 336760,
      "end_ms": 339640,
      "text": "他是一个cosplay的照召回派"
    },
    {
      "ordinal": 123,
      "start_ms": 339640,
      "end_ms": 340460,
      "text": "你知道吗"
    },
    {
      "ordinal": 124,
      "start_ms": 340460,
      "end_ms": 342260,
      "text": "cos play你知道吗"
    },
    {
      "ordinal": 125,
      "start_ms": 342260,
      "end_ms": 343100,
      "text": "太恶心了"
    },
    {
      "ordinal": 126,
      "start_ms": 343100,
      "end_ms": 344060,
      "text": "你知道吗"
    },
    {
      "ordinal": 127,
      "start_ms": 345540,
      "end_ms": 351180,
      "text": "他是一个在司徒卢威的报纸上刊登宣言的"
    },
    {
      "ordinal": 128,
      "start_ms": 351180,
      "end_ms": 352820,
      "text": "召回派神经病"
    },
    {
      "ordinal": 129,
      "start_ms": 352860,
      "end_ms": 354900,
      "text": "这不是变态吗"
    },
    {
      "ordinal": 130,
      "start_ms": 354900,
      "end_ms": 357120,
      "text": "这是一个极为妖孽"
    },
    {
      "ordinal": 131,
      "start_ms": 357120,
      "end_ms": 359160,
      "text": "极为恶心的一个现象"
    },
    {
      "ordinal": 132,
      "start_ms": 360980,
      "end_ms": 363460,
      "text": "你如果真是一个召回派的话"
    },
    {
      "ordinal": 133,
