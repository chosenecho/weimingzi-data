    {
      "ordinal": 188,
      "start_ms": 469020,
      "end_ms": 470140,
      "text": "你知道吗"
    },
    {
      "ordinal": 189,
      "start_ms": 470140,
      "end_ms": 472420,
      "text": "我觉得大家应该更更应当理解的"
