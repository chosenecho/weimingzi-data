      "end_ms": 369160,
      "text": "一看这猫腻"
    },
    {
      "ordinal": 141,
      "start_ms": 369160,
      "end_ms": 370000,
      "text": "什么都看看"
    },
    {
      "ordinal": 142,
      "start_ms": 370000,
      "end_ms": 371580,
      "text": "看明白看清楚了"
