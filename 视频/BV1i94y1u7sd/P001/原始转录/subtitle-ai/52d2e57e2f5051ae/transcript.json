    {
      "ordinal": 144,
      "start_ms": 372540,
      "end_ms": 373050,
      "text": "你知道吗"
    },
    {
      "ordinal": 145,
      "start_ms": 373050,
      "end_ms": 375000,
      "text": "破灭了他想我操老子去读研"
