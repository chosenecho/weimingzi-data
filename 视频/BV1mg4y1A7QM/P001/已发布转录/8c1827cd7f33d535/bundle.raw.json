{"segments":[{"start":0.0,"end":0.99,"text":"这样跟你们说吧"},{"start":0.99,"end":2.559,"text":"这个也要发一个"},{"start":2.74,"end":4.42,"text":"很多人黑斯大林说"},{"start":4.42,"end":8.92,"text":"斯大林啊在这个莫斯科审判清洗过程当中"},{"start":8.92,"end":10.08,"text":"杀了好多人"},{"start":12.8,"end":14.22,"text":"我这样跟你说"},{"start":17.339,"end":19.58,"text":"最后成员就他一个活下来了"},{"start":20.06,"end":23.3,"text":"那个军队将领派系里面就他一个派系"},{"start":23.3,"end":25.36,"text":"他自己的几个铁杆活下来的"},{"start":25.62,"end":28.64,"text":"这不是因为他是胜利者"},{"start":29.58,"end":31.58,"text":"他是幸存者"},{"start":31.58,"end":36.26,"text":"希望你们能明白他是幸存者"},{"start":38.48,"end":43.0,"text":"他是在苏俄革命啊"},{"start":43.0,"end":45.82,"text":"他成功之后的这个民族国家的集体之上"},{"start":45.82,"end":46.6,"text":"建立起来的"},{"start":46.6,"end":49.3,"text":"一个以革命理想主义建立起来的"},{"start":49.3,"end":51.199,"text":"一个统治框架当中"},{"start":52.46,"end":56.49,"text":"这个统治框架呢它延续了一方面"},{"start":56.49,"end":59.55,"text":"他在政治上延续了很多浪漫和热情"},{"start":61.98,"end":64.34,"text":"他在铁杆马仔啊"},{"start":64.34,"end":65.6,"text":"只有不带保镖的"},{"start":65.6,"end":66.98,"text":"然后被杀掉了"},{"start":66.98,"end":69.98,"text":"这是导火索啊"},{"start":77.26,"end":79.86,"text":"或者都是都是直接在大街上走路的"},{"start":80.7,"end":84.08,"text":"但是我说的这么一个理想主义的一个政权"},{"start":84.08,"end":90.16,"text":"建立在一个落后的啊半工业国半农业国的国家"},{"start":90.96,"end":94.98,"text":"这是非常非常其实是非常非常不切实际的"},{"start":96.54,"end":97.5,"text":"然后"},{"start":102.04,"end":108.06,"text":"就算是他已经实现了赢了苏联俄革命赢了"},{"start":108.06,"end":112.54,"text":"但是他的白军也被击败了"},{"start":112.54,"end":113.11,"text":"对不对"},{"start":113.11,"end":115.399,"text":"但是就世界范围来讲"},{"start":116.52,"end":118.91,"text":"全世界的各种政治派别"},{"start":118.91,"end":120.14,"text":"资资本主义力量"},{"start":120.14,"end":121.88,"text":"以及是沙俄复国主义力量"},{"start":121.88,"end":123.17,"text":"各式各样的反对力量"},{"start":123.17,"end":126.85,"text":"他在你这个苏俄的统治的地盘里面的渗透"},{"start":126.85,"end":128.259,"text":"是无孔不入的"},{"start":128.259,"end":129.919,"text":"无孔不入的"},{"start":130.839,"end":135.179,"text":"包括哪怕是你自己有时候没有被外人渗透"},{"start":135.179,"end":141.06,"text":"你自己这个落后的这个半工业半农业国里面"},{"start":141.06,"end":143.16,"text":"残存的那一代人都没有死亡的"},{"start":143.16,"end":145.32,"text":"不是说革命了之后立刻就换一批人了"},{"start":145.32,"end":145.83,"text":"没有的"},{"start":145.83,"end":147.69,"text":"他残存的统治关系"},{"start":147.69,"end":149.31,"text":"主仆关系"},{"start":149.31,"end":151.35,"text":"经济关系啊"},{"start":151.35,"end":153.96,"text":"利益分配关系明白吗"},{"start":153.96,"end":157.59,"text":"还有一些宗族道德伦理宗教"},{"start":157.59,"end":163.119,"text":"他的一些秩序都和你的革命的新兴的法律啊"},{"start":163.119,"end":167.619,"text":"这个什么新兴的道德是共存的"},{"start":167.619,"end":169.66,"text":"并且是激烈冲突着的"},{"start":169.92,"end":173.46,"text":"而且在阶级时代被压抑的啊"},{"start":173.46,"end":175.35,"text":"阶级矛盾啊"},{"start":175.35,"end":177.93,"text":"群体矛盾是家族矛盾"},{"start":177.93,"end":182.58,"text":"私人恩怨它都是继续在酝酿着的"},{"start":182.58,"end":183.63,"text":"明白吗"},{"start":183.63,"end":185.73,"text":"甚至说我之前就讲过"},{"start":185.73,"end":187.41,"text":"就是说而且这个东西呢"},{"start":187.41,"end":189.81,"text":"新的这个范式在台面上"},{"start":189.81,"end":193.419,"text":"在在为很多以前的弱者在主持公道"},{"start":193.419,"end":197.69,"text":"但是当这些弱者经过一代人半代人"},{"start":197.69,"end":199.67,"text":"他就说他的小孩慢慢长大"},{"start":199.67,"end":204.18,"text":"又发现他在这个社会财富利益权力的分配上"},{"start":204.18,"end":205.62,"text":"发现他还是弱势"},{"start":205.62,"end":206.8,"text":"还被压迫"},{"start":206.959,"end":211.549,"text":"这个时候就会出现一种自发的暴力"},{"start":211.549,"end":214.3,"text":"民间会出现一种自发的暴力"},{"start":215.2,"end":216.15,"text":"明白吗"},{"start":216.15,"end":217.56,"text":"就我举个例子啊"},{"start":217.56,"end":220.74,"text":"就包括这个斯大林的那个马仔被杀掉"},{"start":220.74,"end":223.16,"text":"后来调查说是被一个"},{"start":224.8,"end":229.38,"text":"受到处罚的一个前布尔什维克的一个一个一个"},{"start":229.38,"end":234.379,"text":"一个一个一个社区里面的一个一个一个官员"},{"start":235.999,"end":237.559,"text":"那个就是他人生的一切了"},{"start":237.559,"end":240.699,"text":"他本来是一个呃造反的无产阶级"},{"start":240.699,"end":243.13,"text":"后来他因为他参加了革命"},{"start":243.13,"end":245.35,"text":"所以他后来有一定的社会地位了"},{"start":245.35,"end":247.21,"text":"但是呢他由于犯了一些事"},{"start":247.21,"end":250.3,"text":"然后被剥夺了这么一个社会地位"},{"start":250.3,"end":252.16,"text":"也就是他整个人生就崩塌了嘛"},{"start":252.16,"end":254.999,"text":"然后他就去刺杀他"},{"start":254.999,"end":260.139,"text":"就是刺杀了这个这个这个这个啊这个彼得格勒"},{"start":261.879,"end":262.389,"text":"记不得"},{"start":262.389,"end":265.12,"text":"反正就是斯大林的这个马仔的"},{"start":265.12,"end":266.47,"text":"一个很重要的马仔了"},{"start":266.47,"end":267.94,"text":"很重要的一个手下了"},{"start":268.9,"end":270.42,"text":"那你们就可以知道啊"},{"start":270.42,"end":271.52,"text":"你们就可以知道"},{"start":271.62,"end":274.74,"text":"就是说无产阶级通过这样的革命"},{"start":276.9,"end":281.4,"text":"但是里面很多千丝万缕的一些利益关系"},{"start":281.4,"end":283.12,"text":"并没有被完全的根除"},{"start":284.16,"end":287.54,"text":"在半代人十几十几年之后"},{"start":287.54,"end":290.12,"text":"革命的年轻一代老去了"},{"start":290.18,"end":292.94,"text":"他逐步逐步又失去他的视力"},{"start":292.94,"end":294.56,"text":"或者说他们的后代啊"},{"start":294.56,"end":299.02,"text":"他们的子女并没有在这个新的社会环境当中"},{"start":300.139,"end":303.879,"text":"在这个新的社会制度当中获得真正的优势"},{"start":303.879,"end":305.5,"text":"那么会发生的是什么"},{"start":305.88,"end":308.13,"text":"社会的统治的正当性"},{"start":308.13,"end":312.12,"text":"合法性的标准已经发生了转变了啊"},{"start":312.12,"end":313.29,"text":"无产阶级至上"},{"start":313.29,"end":315.36,"text":"劳动者至上啊"},{"start":316.199,"end":321.12,"text":"但是你这个建立政权的这十几年"},{"start":321.599,"end":323.099,"text":"表面上占了便宜"},{"start":323.099,"end":326.039,"text":"但实际上你还是没有占多大的便宜嘛"},{"start":326.039,"end":327.92,"text":"那么会发生什么"},{"start":328.5,"end":329.94,"text":"这就意味着什么"},{"start":329.94,"end":333.22,"text":"意味着当时的革命它并不是一劳永逸的"},{"start":333.539,"end":337.65,"text":"你光是宣布法令调整一些啊"},{"start":337.65,"end":340.23,"text":"泛泛的表层的一些经济关系"},{"start":340.23,"end":342.89,"text":"他并没有完全的调整"},{"start":342.89,"end":345.8,"text":"这个民族集体完全的改"},{"start":345.8,"end":348.83,"text":"把这个民族集体往一个新的一种统治模式"},{"start":348.83,"end":350.27,"text":"利益分配关系上面去引导"},{"start":350.27,"end":353.139,"text":"那么等到十几年一过"},{"start":353.139,"end":354.74,"text":"会发生的是什么"},{"start":354.74,"end":355.58,"text":"会发生的"},{"start":355.58,"end":359.54,"text":"实际上是在一个成功了的革命的机体上的的"},{"start":359.54,"end":360.74,"text":"一次二次革命"},{"start":360.74,"end":362.06,"text":"但是这第二次革命"},{"start":362.06,"end":367.14,"text":"他会打着这个表面的统治合法性的旗号"},{"start":367.96,"end":372.42,"text":"他会做一些这个革命所建立的政权"},{"start":372.42,"end":373.95,"text":"会睁一只眼闭一只眼"},{"start":373.95,"end":375.9,"text":"任由民间的自发的力量"},{"start":375.9,"end":378.179,"text":"通过某种恐怖的暴力的手段"},{"start":378.179,"end":381.029,"text":"去调整现实的利益关系"},{"start":381.029,"end":386.38,"text":"这当中就包括那些在革命之后的年十几年当中"},{"start":386.38,"end":391.96,"text":"没有能够捋顺的仇恨利益关系"},{"start":391.96,"end":393.2,"text":"长久的纠纷"},{"start":394.879,"end":396.579,"text":"没有得到清算的东西"},{"start":397.659,"end":398.52,"text":"明白吗"},{"start":398.84,"end":401.81,"text":"革命胜利者并不是所有一切都得到清算的"},{"start":401.81,"end":404.439,"text":"而且由于它是一个出生的"},{"start":404.439,"end":407.139,"text":"一个弱小的一个一个政权"},{"start":407.139,"end":411.23,"text":"所以他需要和旧的统治集团啊"},{"start":411.23,"end":414.86,"text":"或者说旧的专业专业的人士要跟他们合作"},{"start":414.86,"end":417.88,"text":"所以某种意义上保留了他们的一些利益"},{"start":418.759,"end":421.539,"text":"但是在过了十几十几年之后呢"},{"start":421.539,"end":423.6,"text":"这个局势相对稳定下来了"},{"start":423.9,"end":425.85,"text":"需要兑现"},{"start":425.85,"end":429.36,"text":"革命需要兑现他对于无产阶级的承诺"},{"start":429.7,"end":431.659,"text":"要做到事实的主人"},{"start":431.659,"end":432.859,"text":"所以在这个情况下"},{"start":432.859,"end":435.529,"text":"我们会看到大型的无产阶级国家"},{"start":435.529,"end":439.5,"text":"只要它能够幸存超过二十三十四十年"},{"start":439.68,"end":442.59,"text":"那么在过了这十几年之后"},{"start":442.59,"end":446.28,"text":"都会发生这样的一个烈度的民间"},{"start":446.28,"end":450.389,"text":"烈度的民间自发的一个极具烈度的一个"},{"start":450.389,"end":452.56,"text":"我们可以说是二次革命"},{"start":454.48,"end":455.64,"text":"所以在这个意义上讲"},{"start":455.64,"end":456.96,"text":"斯大林说他要清党"},{"start":456.96,"end":459.75,"text":"或者说他只是说一开始只是要查什么"},{"start":459.75,"end":461.84,"text":"他只是要查凶手"},{"start":462.12,"end":462.96,"text":"查凶手"},{"start":462.96,"end":463.68,"text":"那他为什么呢"},{"start":463.68,"end":467.1,"text":"他的内务部门会给他把这个案子越弄越大"},{"start":467.1,"end":467.64,"text":"越弄越大"},{"start":467.64,"end":468.6,"text":"越弄越大"},{"start":469.5,"end":471.38,"text":"你要知道什么原因"},{"start":471.38,"end":472.1,"text":"对不对"},{"start":472.1,"end":473.15,"text":"什么原因呢"},{"start":473.15,"end":476.6,"text":"因为当然他的统治的秩序当中"},{"start":476.6,"end":481.74,"text":"尤其他的不解他的他的要命的那些权力"},{"start":481.74,"end":483.27,"text":"实权部门当中"},{"start":483.27,"end":485.16,"text":"他也有他的权力斗争"},{"start":486.02,"end":488.29,"text":"它也有它的所谓的真理"},{"start":488.29,"end":490.45,"text":"真相的生产方式"},{"start":490.45,"end":493.3,"text":"那么由于你的实际上"},{"start":493.3,"end":497.09,"text":"你的利益关系是没有理顺的"},{"start":497.09,"end":498.8,"text":"由于你的政府"},{"start":498.8,"end":500.57,"text":"由于你的这个政权内部"},{"start":500.57,"end":503.63,"text":"还是有很多旧势力利益的代言人"},{"start":503.63,"end":507.26,"text":"旧的一些利益方式的代言人"},{"start":509.66,"end":512.84,"text":"所以民间的这种清算"},{"start":512.84,"end":516.919,"text":"民间的这种暴力的狂欢一定会蔓延到"},{"start":517.059,"end":519.309,"text":"无非是哪一个是导火索"},{"start":519.309,"end":521.76,"text":"实事求是讲啊"},{"start":521.76,"end":524.79,"text":"有的可能是因为一个刑事案件是个导火索"},{"start":524.79,"end":527.25,"text":"有的可能是民间的某些特殊的"},{"start":527.25,"end":530.49,"text":"某某个部门的一些群体性的事件是导火索"},{"start":530.49,"end":531.96,"text":"有的可能是政治"},{"start":531.96,"end":532.41,"text":"不是"},{"start":532.41,"end":533.72,"text":"有的可能是文化"},{"start":533.72,"end":537.079,"text":"文化层面的一个一些东西是导火索"},{"start":537.56,"end":538.4,"text":"明白吗"},{"start":538.4,"end":539.96,"text":"有的可能是一个对外关系"},{"start":539.96,"end":542.51,"text":"或者说一个军事冲突当中是导火索"},{"start":542.51,"end":543.5,"text":"无论如何"},{"start":543.5,"end":547.64,"text":"其实这个火药库革命胜利之后"},{"start":548.46,"end":551.0,"text":"被革命所降温了的那种"},{"start":551.0,"end":553.43,"text":"社会内在的那种矛盾和冲突"},{"start":553.43,"end":554.96,"text":"在十几年之后"},{"start":554.96,"end":556.1,"text":"他会继续"},{"start":556.1,"end":557.459,"text":"只要这个革命啊"},{"start":557.64,"end":560.76,"text":"他是他是疲于应付外敌的"},{"start":560.76,"end":562.38,"text":"疲于应付外侮的"},{"start":563.3,"end":564.16,"text":"还有一个特点"},{"start":564.16,"end":567.51,"text":"就是它这个革命是他的一开始那个力量"},{"start":567.51,"end":569.07,"text":"前几年的那个力量"},{"start":569.07,"end":572.1,"text":"精华的力量是用来对外打仗的"},{"start":572.1,"end":573.54,"text":"保卫自己"},{"start":573.64,"end":575.74,"text":"他要去抵御外侮的"},{"start":575.74,"end":577.72,"text":"那么肯定这个革命政权"},{"start":577.72,"end":580.319,"text":"他是没有一个非常大的一个"},{"start":580.32,"end":582.3,"text":"就算他说我要进行改造"},{"start":582.3,"end":584.04,"text":"他这个不能改造非常彻底"},{"start":584.04,"end":585.12,"text":"我说了"},{"start":585.12,"end":589.559,"text":"对于这种革命成功之后的一个国家的内部的"},{"start":589.559,"end":591.119,"text":"这些社会关系的这个改造"},{"start":591.119,"end":595.43,"text":"它的力度一定要是准准军事性的"},{"start":595.43,"end":597.47,"text":"纯粹是法律层面的"},{"start":597.47,"end":599.0,"text":"纯粹是行政层面的"},{"start":599.0,"end":600.02,"text":"没用的"},{"start":600.12,"end":603.12,"text":"旧有的关系会继续以各式各样的方式"},{"start":603.12,"end":604.47,"text":"巧取豪夺的"},{"start":604.47,"end":606.8,"text":"巧言令色的继续存在着"},{"start":607.18,"end":610.18,"text":"如果政府不能给予一个准军事性的"},{"start":610.18,"end":612.34,"text":"对于这些层面的一个调整"},{"start":612.34,"end":613.87,"text":"民间自己会去调整"},{"start":613.87,"end":616.33,"text":"民间在这个调整的过程当中的暴力"},{"start":616.33,"end":620.48,"text":"一定会蔓延到这个政权内部"},{"start":620.48,"end":622.3,"text":"所以在这个意义上讲"},{"start":629.16,"end":629.66,"text":"被"},{"start":631.7,"end":635.52,"text":"俄国的尤其是那几个大城市啊"},{"start":635.52,"end":639.77,"text":"他这个力度很大的这种内在的民间仇杀"},{"start":646.8,"end":647.94,"text":"在这个意义上讲"},{"start":647.94,"end":649.26,"text":"内务部门的"},{"start":649.44,"end":651.12,"text":"还有这个情报部门"},{"start":651.12,"end":652.14,"text":"军事部门的"},{"start":652.14,"end":654.0,"text":"他这样一种仇杀"},{"start":654.0,"end":655.8,"text":"相互仇杀就为了卡位吗"},{"start":655.8,"end":660.5,"text":"抢位置以及他拼命的仇杀还是一方面啊"},{"start":663.77,"end":665.79,"text":"一方面是他拼命的仇杀"},{"start":665.79,"end":668.14,"text":"是里面当然是有权力斗争的"},{"start":668.14,"end":670.6,"text":"因为每一个权力部门的每一个人都代表着某种"},{"start":670.6,"end":672.64,"text":"比如说它代表了那个什么军事贵族"},{"start":672.64,"end":675.38,"text":"比如军队里面