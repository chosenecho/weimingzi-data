862.849,"text":"分装的啊"},{"start":1862.849,"end":1864.609,"text":"做这个售后的呃"},{"start":1864.609,"end":1866.389,"text":"感谢所有的我们的团队"},{"start":1866.389,"end":1867.509,"text":"牛逼"},{"start":1867.509,"end":1868.149,"text":"我很挫"},{"start":1868.149,"end":1869.009,"text":"我他妈垃圾啊"},{"start":1869.009,"end":1870.829,"text":"我他妈一直直播到深夜"},{"start":1870.829,"end":1871.469,"text":"他妈睡大觉"},{"start":1871.469,"end":1872.029,"text":"睡到下午"},{"start":1872.029,"end":1872.469,"text":"他妈的"},{"start":1872.469,"end":1872.949,"text":"我不是人"},{"start":1872.949,"end":1873.509,"text":"我是垃圾"},{"start":1874.369,"end":1875.409,"text":"我是第一人"},{"start":1875.409,"end":1876.46,"text":"我是吊人"},{"start":1876.46,"end":1878.1,"text":"我是肺部嗯"},{"start":1878.1,"end":1879.6,"text":"我我我我很可耻"},{"start":1879.6,"end":1880.28,"text":"可耻"},{"start":1880.28,"end":1881.74,"text":"熬夜可耻啊"},{"start":1881.74,"end":1882.94,"text":"睡睡了觉可耻"},{"start":1882.94,"end":1884.67,"text":"他妈的啊"},{"start":1884.67,"end":1886.13,"text":"我检讨我自卑"},{"start":1886.13,"end":1887.97,"text":"我错了哇"},{"start":1887.97,"end":1892.35,"text":"那反正就是说希望大家那个嗯"},{"start":1892.35,"end":1895.59,"text":"我们还是希望这国庆能够安稳的过过去啊"},{"start":1895.59,"end":1898.29,"text":"过过去这个我在最后还说一句"},{"start":1898.29,"end":1902.37,"text":"就是说敌人有的其实是所谓的敌人"},{"start":1902.37,"end":1903.37,"text":"还有的是什么事"},{"start":1903.37,"end":1906.07,"text":"事实上他的社会化失败的小年轻"},{"start":1906.07,"end":1908.59,"text":"他们有的一些敌意是很深重的"},{"start":1908.59,"end":1909.59,"text":"瞄准我们的"},{"start":1909.59,"end":1911.47,"text":"你觉得我们赚的不得了的钱了"},{"start":1911.47,"end":1913.659,"text":"觉得我们他妈的是什么啊"},{"start":1913.659,"end":1915.999,"text":"有不得了的本事不得了的能力"},{"start":1915.999,"end":1917.619,"text":"但是却不去拯救他们"},{"start":1917.619,"end":1918.639,"text":"不去帮助他们"},{"start":1918.639,"end":1921.57,"text":"所以他们有很大的那个很大的攻击性"},{"start":1921.57,"end":1923.39,"text":"嘲笑我们对吗"},{"start":1923.39,"end":1924.61,"text":"这个甚至有一些"},{"start":1924.61,"end":1928.069,"text":"这个对我们产生如此巨大攻击性的"},{"start":1928.069,"end":1932.18,"text":"曾经是打着我们同路人的旗号的啊"},{"start":1932.18,"end":1934.28,"text":"有要对对我们产生极大的攻击性"},{"start":1934.28,"end":1935.26,"text":"所以在这个状态下"},{"start":1935.26,"end":1936.78,"text":"我们甚至说在这个国庆"},{"start":1936.78,"end":1937.84,"text":"在这个假期"},{"start":1937.84,"end":1941.11,"text":"我们我对我们的这个工作人员的这个要求"},{"start":1941.11,"end":1942.31,"text":"是一级战备状态"},{"start":1943.39,"end":1945.31,"text":"就是就千万要盯着"},{"start":1945.31,"end":1946.23,"text":"不要让魔怔人过来"},{"start":1946.23,"end":1947.56,"text":"他妈搞事"},{"start":1947.56,"end":1948.38,"text":"懂了吧"},{"start":1948.38,"end":1950.48,"text":"然后就最近这个舆论这个点"},{"start":1950.48,"end":1952.34,"text":"他们选择在国庆之前引爆"},{"start":1952.34,"end":1954.48,"text":"也是想让我分身乏术"},{"start":1954.48,"end":1956.639,"text":"他们好想好暗度陈仓"},{"start":1956.639,"end":1959.079,"text":"那我们今天我就就要拿出我熬夜的本事"},{"start":1959.079,"end":1962.079,"text":"来把这个整个他妈的迷雾给大家揭开啊"},{"start":1962.079,"end":1964.119,"text":"把这个事情给大家说清楚"},{"start":1964.119,"end":1964.8,"text":"说明白"},{"start":1964.8,"end":1965.6,"text":"你放马过来"},{"start":1965.6,"end":1966.44,"text":"你能怎样"},{"start":1966.44,"end":1967.16,"text":"我实事求讲"},{"start":1967.16,"end":1967.76,"text":"你你妈的"},{"start":1967.76,"end":1968.64,"text":"你要造这些谣"},{"start":1968.64,"end":1969.54,"text":"你要搞老子"},{"start":1969.54,"end":1970.56,"text":"在搞笑"},{"start":1970.56,"end":1973.56,"text":"你这个的道路就是什么"},{"start":1973.56,"end":1978.76,"text":"我靠还还这个这种到境外去传播啊"},{"start":1978.76,"end":1979.78,"text":"伪造诽谤"},{"start":1979.78,"end":1981.36,"text":"你自己先掂一掂你"},{"start":1981.36,"end":1983.0,"text":"你会遭受一个什么样的处置"},{"start":1983.0,"end":1984.889,"text":"搞笑硬碰硬"},{"start":1984.889,"end":1986.089,"text":"你碰的不是我"},{"start":1986.089,"end":1986.369,"text":"对不对"},{"start":1986.369,"end":1987.609,"text":"你一碰你碰的不是我"},{"start":1987.609,"end":1989.309,"text":"好吧啊"},{"start":1989.309,"end":1992.729,"text":"我觉得就是说珍珍惜自己日常的生活"},{"start":1992.729,"end":1995.079,"text":"不要丧心病狂啊"},{"start":1995.079,"end":1996.859,"text":"不要牺牲自己未来的幸福"},{"start":1996.859,"end":1998.039,"text":"好好想一想啊"},{"start":1998.039,"end":2000.569,"text":"我劝这些人啊好吧"},{"start":2000.569,"end":2003.009,"text":"那就是我们预祝我们这国庆假期"},{"start":2003.009,"end":2005.849,"text":"这个整个俱乐部的活动能够顺利圆满的啊"},{"start":2005.849,"end":2007.6,"text":"定型OK啊"},{"start":2007.6,"end":2010.36,"text":"然后那个纪念品价格稍微有点小贵啊"},{"start":2010.36,"end":2012.8,"text":"你们担待一下啊"},{"start":2012.8,"end":2017.11,"text":"是给他们这但是给这两个地方筹筹租子啊"},{"start":2017.11,"end":2018.53,"text":"筹这个筹工资"},{"start":2018.53,"end":2021.35,"text":"筹地租的一分钱到不了我们的口袋的"},{"start":2021.35,"end":2023.67,"text":"一分钱到不了我们这些什么管理层"},{"start":2023.67,"end":2025.73,"text":"就是我们这些他妈的高管"},{"start":2025.73,"end":2028.21,"text":"资本家一分钱到不了我们口袋的"},{"start":2028.21,"end":2029.92,"text":"好吧啊"},{"start":2029.92,"end":2031.12,"text":"你非要骂我个资本家"},{"start":2031.12,"end":2032.36,"text":"我资本家我他妈可耻"},{"start":2032.36,"end":2033.04,"text":"我有罪啊"},{"start":2033.04,"end":2033.48,"text":"我有罪"},{"start":2033.48,"end":2034.3,"text":"你的"},{"start":2034.3,"end":2036.44,"text":"我我帮那谁呢啊"},{"start":2036.44,"end":2038.64,"text":"我自己难道是以增值为目的的吗"},{"start":2038.64,"end":2042.0,"text":"整个这这个这个世界是以我个人的私人财富"},{"start":2042.0,"end":2043.199,"text":"增值为目的的"},{"start":2043.199,"end":2044.439,"text":"放你妈狗屁啊"},{"start":2044.439,"end":2047.33,"text":"这些生产资料都是被劳动者控制的啊"},{"start":2047.33,"end":2050.09,"text":"然后这就完全是按劳分配的啊"},{"start":2050.09,"end":2051.29,"text":"完全是就是不干活"},{"start":2051.29,"end":2052.17,"text":"一分钱没有"},{"start":2052.17,"end":2055.01,"text":"我没有钱的好吧"},{"start":2055.75,"end":2057.429,"text":"OK来讲到这边啊"},{"start":2058.989,"end":2059.96,"text":"讲到这里"}],"source":"subtitle"}
