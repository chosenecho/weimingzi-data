    },
    {
      "ordinal": 15,
      "start_ms": 44420,
      "end_ms": 46030,
      "text": "very interesting啊"
    },
    {
      "ordinal": 16,
      "start_ms": 46030,
      "end_ms": 48490,
      "text": "就是这个时代精神"
    },
    {
      "ordinal": 17,
      "start_ms": 48490,
      "end_ms": 53320,
      "text": "你一定要你open your mind"
    },
    {
      "ordinal": 18,
      "start_ms": 53320,
      "end_ms": 54340,
      "text": "you have to open your mind"
    },
    {
      "ordinal": 19,
      "start_ms": 54340,
      "end_ms": 55300,
      "text": "你学我这个东西"
    },
    {
      "ordinal": 20,
      "start_ms": 55300,
      "end_ms": 56200,
      "text": "你不敢摸"
    },
    {
      "ordinal": 21,
      "start_ms": 56200,
      "end_ms": 57310,
      "text": "open your mind的话"
    },
    {
      "ordinal": 22,
      "start_ms": 57310,
      "end_ms": 60220,
      "text": "我已经是一个已经这么无耻的搞结构主义的"
