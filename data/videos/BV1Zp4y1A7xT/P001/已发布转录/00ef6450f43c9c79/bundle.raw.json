{"segments":[{"start":0.0,"end":3.24,"text":"啊就是我现在就是民族主义和自由主义合流"},{"start":3.24,"end":5.26,"text":"会是心腹大患"},{"start":5.54,"end":8.3,"text":"你跑步的时候就心肌痉挛的那个意义上"},{"start":8.3,"end":11.28,"text":"那个大环不能放任的"},{"start":12.42,"end":13.02,"text":"不能放任的"},{"start":13.02,"end":14.2,"text":"这是我的观点"},{"start":14.919,"end":16.619,"text":"这个当当年越南的时候"},{"start":16.619,"end":17.879,"text":"那个南海仲裁的时候"},{"start":17.879,"end":19.919,"text":"那那就那很明显的一个例子"},{"start":19.919,"end":21.34,"text":"那当时越南"},{"start":24.34,"end":24.76,"text":"合流的"},{"start":24.76,"end":28.4,"text":"在这起诉他的那个得很夸张的是危机"},{"start":28.4,"end":31.52,"text":"他这是核心合法性的啊"},{"start":34.06,"end":36.54,"text":"你这个authority作为authority"},{"start":36.54,"end":41.38,"text":"要和这个要和这个社会市民阶级的"},{"start":41.38,"end":44.86,"text":"这个大大的人口要去抢夺民族主义的合法性"},{"start":44.86,"end":46.0,"text":"是抢不过的"},{"start":46.1,"end":47.48,"text":"永远抢不过的呀"},{"start":47.48,"end":49.22,"text":"而且而且你是要应对危机"},{"start":49.22,"end":49.88,"text":"应对挑战"},{"start":49.88,"end":50.72,"text":"应对危机的挑战"},{"start":50.72,"end":51.75,"text":"就可能要出错"},{"start":51.75,"end":52.41,"text":"出了错"},{"start":52.41,"end":54.45,"text":"然后你就被别人指着鼻子骂"},{"start":54.45,"end":57.32,"text":"或者说就是就是趁你病要你命吗"},{"start":57.58,"end":58.42,"text":"不行呀"},{"start":58.42,"end":60.68,"text":"对不对啊"},{"start":60.68,"end":63.26,"text":"所以我的建议就是说有些东西我举个例子"},{"start":63.26,"end":64.31,"text":"就是说比如汉服"},{"start":64.31,"end":66.72,"text":"汉服这个东西不能放任它"},{"start":67.14,"end":69.54,"text":"所以我这不仅仅是那个什么和服"},{"start":69.54,"end":70.56,"text":"大街上不能穿"},{"start":70.56,"end":72.78,"text":"危危害这个民族情感"},{"start":74.2,"end":75.99,"text":"汉服也不能随便穿"},{"start":75.99,"end":77.31,"text":"这是我的观点"},{"start":77.31,"end":80.4,"text":"当然你不是说你不是说不能穿啊"},{"start":80.4,"end":81.96,"text":"而是说这个东西"},{"start":82.18,"end":83.92,"text":"你不能让它变成一个"},{"start":83.92,"end":86.119,"text":"由市民阶级自制的一个潮流"},{"start":86.36,"end":88.1,"text":"又有很大的问题的"},{"start":88.1,"end":88.64,"text":"你知道吗"},{"start":88.64,"end":90.02,"text":"会有很大的问题的"},{"start":90.02,"end":92.699,"text":"那我们现在看到这个市面界自制的潮流"},{"start":92.699,"end":94.079,"text":"只是还是散漫的"},{"start":94.079,"end":95.219,"text":"没有没有聚合起来"},{"start":95.219,"end":95.669,"text":"对不对"},{"start":95.669,"end":96.779,"text":"他没有聚合起来"},{"start":96.779,"end":98.42,"text":"那我要说难听点啊"},{"start":98.42,"end":99.77,"text":"我说的难听点啊"},{"start":99.77,"end":101.619,"text":"如果有汉民族主义者"},{"start":101.98,"end":104.65,"text":"汉民族主义者都我"},{"start":104.65,"end":107.14,"text":"我留长头发是因为我想省个理发钱啊"},{"start":107.14,"end":109.22,"text":"汉民族主者都他妈穿长发"},{"start":109.36,"end":111.28,"text":"头上戴个头巾"},{"start":111.28,"end":113.78,"text":"然后就是穿汉服那样的生存"},{"start":115.44,"end":116.3,"text":"对不对"},{"start":116.3,"end":120.97,"text":"就开始讲究他那个呃追溯汉唐那种什么工业啊"},{"start":120.97,"end":123.85,"text":"变成狂热的那个所谓的这个这个这个呃"},{"start":123.85,"end":127.69,"text":"崇崇崇拜那个什么工业的那种人民粹主义化"},{"start":127.69,"end":128.389,"text":"这群人"},{"start":128.389,"end":130.62,"text":"你怎么怎么怎么处理他吗"},{"start":131.48,"end":135.04,"text":"专门专门某个势力他妈的养他妈几千号这种人"},{"start":135.04,"end":136.09,"text":"我靠"},{"start":136.09,"end":137.71,"text":"那你城管怎么管他"},{"start":137.71,"end":139.6,"text":"那协警辅警怎么管他"},{"start":140.679,"end":141.64,"text":"对不对"},{"start":143.26,"end":145.32,"text":"所以说这个东西这个标准啊"},{"start":145.32,"end":149.12,"text":"这个就是这个服饰的这个向前现代"},{"start":149.12,"end":152.18,"text":"或者像什么民族的那种什么标准就回溯"},{"start":152.18,"end":154.42,"text":"不能轻易让这个民间来搞的"},{"start":154.64,"end":160.89,"text":"不能轻易让让这个商品让这个资本来搞的啊"},{"start":160.89,"end":166.819,"text":"因为它这个这个服饰具有他在某种状态下"},{"start":166.819,"end":168.859,"text":"它具有某种动员力的服饰"},{"start":168.859,"end":171.439,"text":"专门统一某种服饰穿穿成某种东西"},{"start":173.179,"end":175.7,"text":"再加上自由主义色彩啊"},{"start":175.7,"end":178.84,"text":"自由主义色彩懂吗"},{"start":178.84,"end":181.48,"text":"它具有某种某种某种某种这种动物园里的"},{"start":181.48,"end":182.82,"text":"是是蛮危险的"},{"start":182.82,"end":184.8,"text":"所以但是目前看不出来"},{"start":184.8,"end":185.82,"text":"目前都是小女孩"},{"start":185.82,"end":187.74,"text":"或者说一些这个比较文弱的"},{"start":187.74,"end":189.9,"text":"但是我们也看到一些要穿盔甲的嘛"},{"start":189.9,"end":190.54,"text":"对不对"},{"start":190.54,"end":193.18,"text":"因为他穿的是什么古代军军装戎装的"},{"start":193.18,"end":196.09,"text":"现在大家都是带有这个审美的那个啊"},{"start":196.09,"end":198.0,"text":"看一下这个长得像什么"},{"start":198.0,"end":200.64,"text":"这个这个穿铠甲的这个男的长得像谁呀"},{"start":200.64,"end":201.9,"text":"像什么安禄山啊"},{"start":201.9,"end":203.74,"text":"还带一种方式的调侃"},{"start":204.239,"end":206.38,"text":"怎么调侃啊啊"},{"start":208.44,"end":211.68,"text":"唉那我要讲的就是说呃"},{"start":212.6,"end":217.439,"text":"不把这个放到放给这个都市里面"},{"start":217.439,"end":218.579,"text":"这些消费主义人群"},{"start":218.579,"end":219.94,"text":"不把它放到民间"},{"start":220.72,"end":221.76,"text":"要放到哪里去"},{"start":221.76,"end":224.79,"text":"我觉得需要有一些国家机构啊来定制标准啊"},{"start":224.79,"end":226.12,"text":"定制相应的标准"},{"start":226.98,"end":229.34,"text":"但是我不知道我国的学界啊"},{"start":229.34,"end":231.74,"text":"我国这个文化学者和历史学者"},{"start":231.74,"end":233.68,"text":"能不能看见这一系列啊"},{"start":233.82,"end":235.26,"text":"然后把它判定好了"},{"start":235.26,"end":235.92,"text":"就束之高阁"},{"start":235.92,"end":236.7,"text":"不要用它"},{"start":236.7,"end":238.02,"text":"我们毕竟是现代国家"},{"start":240.359,"end":242.039,"text":"我们不用这吊东西"},{"start":242.039,"end":243.86,"text":"只要把它束之高阁"},{"start":243.86,"end":245.36,"text":"进行一次演示"},{"start":245.36,"end":247.88,"text":"然后这里面理智严严格的这个等级"},{"start":247.88,"end":249.38,"text":"就是森严的这个体系"},{"start":249.38,"end":252.209,"text":"包括他这个这个平民和贵族"},{"start":252.209,"end":254.94,"text":"在这个泾渭分明的这么一个区分"},{"start":255.6,"end":257.0,"text":"给他做一系列出来"},{"start":257.0,"end":259.64,"text":"首先是孔子学院国内版作为系列出来"},{"start":259.64,"end":261.04,"text":"但是树之高阁"},{"start":261.939,"end":264.359,"text":"偶尔他妈亮一次项就行了"},{"start":264.359,"end":266.52,"text":"然后民间不准随意用"},{"start":268.46,"end":269.51,"text":"没有啊"},{"start":269.51,"end":272.99,"text":"民间那些东西可以可以阶段性的去批评"},{"start":272.99,"end":273.53,"text":"这些东西"},{"start":273.53,"end":275.75,"text":"都是就是要求他们有现代化"},{"start":275.75,"end":278.92,"text":"怎么能要求这些东西就现代化啊"},{"start":278.92,"end":280.48,"text":"都这审美潮流化"},{"start":281.12,"end":282.73,"text":"不允许他们往一个"},{"start":282.73,"end":286.06,"text":"否则老实说你如果现在冒出新的一批人"},{"start":286.06,"end":288.56,"text":"我已经我老师告诉你们哦"},{"start":289.42,"end":292.86,"text":"已经有民间资本在往这个方向在发展了"},{"start":293.02,"end":296.2,"text":"这个炉教的这个服饰"},{"start":296.2,"end":297.58,"text":"它有一套等级制的"},{"start":297.58,"end":299.24,"text":"这个等级制有动原理的"},{"start":299.599,"end":302.599,"text":"你不要到时候他妈的抓到哪个哪个企业里面"},{"start":302.599,"end":303.619,"text":"这群人已经什么事"},{"start":303.619,"end":307.25,"text":"中尚书这么什么什么屏障"},{"start":307.25,"end":308.48,"text":"什么都已经封好了"},{"start":308.48,"end":309.92,"text":"我靠一群人在那边干嘛呢"},{"start":309.92,"end":312.22,"text":"我靠明白吗"},{"start":313.42,"end":316.26,"text":"不要有这种复古主义者潮流啊"},{"start":320.6,"end":322.82,"text":"所以说最好的办法就是说"},{"start":322.82,"end":324.92,"text":"用国家的权威性的一个力量"},{"start":324.92,"end":328.1,"text":"把汉民族主义的这些这个潮流服饰给他"},{"start":328.1,"end":329.42,"text":"就是规定好了之后"},{"start":329.42,"end":331.48,"text":"以这个国家的基准作为基准"},{"start":331.64,"end":333.53,"text":"把这个作为基准好了"},{"start":333.53,"end":336.1,"text":"然后进行一次展览啊"},{"start":336.1,"end":337.78,"text":"这这这就叫树之高阁"},{"start":337.78,"end":341.07,"text":"要束之高阁以后就不提了啊"},{"start":341.07,"end":342.84,"text":"要要就不搞了"},{"start":342.84,"end":343.2,"text":"对不对"},{"start":343.2,"end":344.52,"text":"也就不就不搞了"},{"start":344.52,"end":346.97,"text":"也就不提了啊"},{"start":346.97,"end":351.58,"text":"然后要对于怎么样古装剧要统一要其一"},{"start":352.0,"end":354.91,"text":"对于这个对于这个古装剧啊"},{"start":354.91,"end":357.4,"text":"它里面的这个服饰要统一要齐"},{"start":357.4,"end":358.88,"text":"要有权威的"},{"start":359.62,"end":360.66,"text":"你不能搞啊"},{"start":360.66,"end":362.46,"text":"搞啊什么什么啊"},{"start":362.46,"end":365.499,"text":"包括到游戏行业这里面明白"},{"start":365.499,"end":367.119,"text":"就是说这个权利你不去拿"},{"start":367.119,"end":367.719,"text":"留给民间"},{"start":367.719,"end":370.569,"text":"那民间到时候他自己凝结成这个权利和"},{"start":370.569,"end":372.279,"text":"那到时候你搞不过来"},{"start":372.279,"end":373.54,"text":"很烦呐"},{"start":373.719,"end":375.639,"text":"这个东西为什么我不愿意看见"},{"start":375.639,"end":376.179,"text":"为什么"},{"start":376.179,"end":376.959,"text":"为什么"},{"start":376.959,"end":381.88,"text":"俄国东正教他搞的那个等级森严的那一套"},{"start":381.88,"end":383.56,"text":"那他妈又他妈又起来了"},{"start":383.56,"end":384.6,"text":"死灰复燃了"},{"start":385.38,"end":388.1,"text":"当然也是他这个当年的分裂主义啊"},{"start":388.1,"end":391.479,"text":"当年的解体时候的一个挺有支柱性的"},{"start":391.479,"end":392.319,"text":"一个力量的"},{"start":393.819,"end":394.68,"text":"明白吗"},{"start":403.5,"end":406.28,"text":"极端民族是同时要维持他这个市民阶级的"},{"start":406.28,"end":409.28,"text":"那就是在城市里面那种那个自由自由消费的"},{"start":409.28,"end":410.84,"text":"那种那种生活的这群人"},{"start":410.84,"end":412.19,"text":"那一体两面的"},{"start":412.19,"end":417.07,"text":"他不就是说需要有一个呃等级是分明的"},{"start":417.07,"end":417.97,"text":"非常严格的"},{"start":417.97,"end":419.47,"text":"他自己自己产生出来的"},{"start":419.47,"end":423.37,"text":"一个一个一个东正教教廷的通天教的体系"},{"start":423.37,"end":424.8,"text":"给他做支撑的"},{"start":425.92,"end":428.46,"text":"所以你不要以为儒教是他妈的乖宝宝"},{"start":430.2,"end":432.04,"text":"不要以为儒教是乖宝宝"},{"start":432.26,"end":433.76,"text":"儒教很有生命力啊"},{"start":433.76,"end":437.98,"text":"我靠儒教那套什么什么什么什么的"},{"start":437.98,"end":440.5,"text":"那套什么三公九卿那吊东西"},{"start":442.88,"end":444.7,"text":"那个叼毛玩意儿"},{"start":444.7,"end":446.44,"text":"它这很有很有问题的"},{"start":446.44,"end":447.34,"text":"你知道吗"},{"start":447.34,"end":449.08,"text":"他很有问题的"},{"start":450.94,"end":453.54,"text":"就说你相比于儒教那个三公九卿"},{"start":453.54,"end":454.44,"text":"那个什么什么"},{"start":454.44,"end":457.08,"text":"致使那个什么什么什么什么什么什么"},{"start":457.08,"end":459.58,"text":"这这玩意的什么什么什么"},{"start":462.36,"end":465.82,"text":"什么命啊令啊这这种东西的这个这个体系而言"},{"start":466.219,"end":469.099,"text":"我们这个现代化的这这里面这套体系"},{"start":469.099,"end":470.719,"text":"这就是才算外来户"},{"start":470.719,"end":471.409,"text":"你知道吗"},{"start":471.409,"end":472.92,"text":"才算是外来户"},{"start":476.74,"end":477.54,"text":"明白吧"},{"start":480.48,"end":486.85,"text":"唉所以尤其是当这个在这个"},{"start":486.85,"end":494.64,"text":"就是当这个我们说在这个就是我们说原位的"},{"start":496.08,"end":499.36,"text":"想象图示和世界"},{"start":499.36,"end":503.32,"text":"就是资本主义世界的那个逐渐要要要区分开来"},{"start":503.32,"end":505.18,"text":"区分度越来越大的时候"},{"start":505.92,"end":509.0,"text":"也要注意要和儒教体系"},{"start":509.0,"end":512.14,"text":"儒教的那个名为体系要给它区分开来"},{"start":513.2,"end":517.179,"text":"要比较注意不一不小心"},{"start":518.32,"end":520.099,"text":"一不小心就会被夺走"},{"start":521.179,"end":522.159,"text":"一不小心啊"},{"start":522.159,"end":522.94,"text":"这是我的观点啊"},{"start":522.94,"end":523.84,"text":"这是我的观点"},{"start":523.84,"end":530.42,"text":"我我我始终认为心腹大患是呃上有古典学之称"},{"start":530.5,"end":535.21,"text":"上有这么一个严肃的呃等级森严的礼教支撑"},{"start":535.21,"end":535.6,"text":"下"},{"start":535.6,"end":539.14,"text":"有这个充沛的民间的这个自由主义的"},{"start":539.14,"end":542.719,"text":"一个就是既有社会基准啊"},{"start":542.719,"end":545.059,"text":"既有这个权威性的这个知识性的"},{"start":545.059,"end":547.549,"text":"历史性的文明传承的基准做支撑"},{"start":547.549,"end":549.199,"text":"又有钱源源不断的钱"},{"start":549.199,"end":552.78,"text":"市场有源源不断的市民阶级对于这个现代生活"},{"start":552.78,"end":555.56,"text":"现代享乐生活的一个一个想象"},{"start":555.56,"end":556.91,"text":"他只不过说在服装上啊"},{"start":556.91,"end":561.32,"text":"他这个复古上面既有这个支撑"},{"start":561.32,"end":563.48,"text":"有这个想象政治想象的图示"},{"start":563.48,"end":565.47,"text":"下面又有这个钱来做支撑"},{"start":565.47,"end":568.14,"text":"那么中间就会滋生出他的有生力量"},{"start":568.14,"end":570.78,"text":"那么这个会是心腹大患也"},{"start":570.78,"end":574.9,"text":"此心腹之大患也啊"},{"start":574.9,"end":576.099,"text":"这个是幸福大环"},{"start":581.1,"end":582.44,"text":"啊这是我的观点啊"},{"start":582.44,"end":583.58,"text":"这是我的观点来说"},{"start":583.58,"end":586.4,"text":"我们现在没有民间没有冒出核心那种人啊"},{"start":586.4,"end":587.42,"text":"都是他妈歪瓜裂枣"},{"start":587.42,"end":590.44,"text":"我靠没有冒出核心影啊什么的"},{"start":590.44,"end":592.75,"text":"王者王传奇那种人啊"},{"start":592.75,"end":594.46,"text":"那现在冒出来的歪瓜裂枣"},{"start":594.46,"end":597.04,"text":"但是他妈的有几个哲学系的"},{"start":597.04,"end":598.469,"text":"好像搞儒学的"},{"start":598.469,"end":600.389,"text":"好像他们也也搞做"},{"start":600.389,"end":601.349,"text":"做不成这种人物啊"},{"start":601.349,"end":601.829,"text":"现在没有"},{"start":601.829,"end":604.2,"text":"就说没有自由主义势力掏钱"},{"start":604.2,"end":610.05,"text":"也没有这个什么上面这种这个这个这个呃"},{"start":610.05,"end":611.34,"text":"某种给他做加持"},{"start":611.34,"end":611.94,"text":"对不对啊"},{"start":611.94,"end":613.8,"text":"所以这中间的这些投机分子呢"},{"start":613.8,"end":615.15,"text":"还没有找到一个结合点"},{"start":615.15,"end":616.92,"text":"没找到结合点害"},{"start":619.26,"end":622.16,"text":"但是说他们摆占这个点位"},{"start":622.16,"end":623.44,"text":"占这种点位啊"},{"start":623.44,"end":625.57,"text":"在这种儒教等级制点位"},{"start":625.57,"end":627.73,"text":"讲心学已经算算好了呀"},{"start":627.73,"end":630.4,"text":"讲心学就说不往等级去靠"},{"start":630.4,"end":633.01,"text":"往往往他的金主那边靠"},{"start":633.01,"end":635.02,"text":"他就只是要钱而已"},{"start":635.02,"end":638.08,"text":"但如果有人开始不仅讲心学"},{"start":638.08,"end":639.459,"text":"也开始讲礼教"},{"start":640.58,"end":642.28,"text":"该讲什么天绝地绝"},{"start":642.28,"end":644.83,"text":"天改讲爵位啊"},{"start":644.83,"end":649.94,"text":"讲什么什么三公三公三师什么这种东西"},{"start":649.94,"end":652.48,"text":"那就不一样了啊"},{"start":652.48,"end":653.26,"text":"那也不一样了"},{"start":654.88,"end":655.87,"text":"那就不一样了"},{"start":655.87,"end":657.85,"text":"就是说会有一个信号点"},{"start":657.85,"end":660.78,"text":"就是说搞强行搞那个对应关系"},{"start":660.78,"end":662.64,"text":"那就那就很危险了"},{"start":662.64,"end":663.66,"text":"那就很危险了"},{"start":663.66,"end":665.25,"text":"如果有那种什么大卢"},{"start":665.25,"end":665.82,"text":"举个例子"},{"start":665.82,"end":667.17,"text":"他学界很有名的大儒"},{"start":667.17,"end":672.01,"text":"强行在文文词当中把一些一些岗位"},{"start":672.01,"end":675.45,"text":"一些植物都重新翻译成"},{"start":675.45,"end":678.71,"text":"其他都用那东西来翻译啊"},{"start":678.71,"end":680.54,"text":"重新重用儒家的方式"},{"start":680.54,"end":683.59,"text":"儒家的这个这个名位来来对应"},{"start":683.59,"end":684.73,"text":"那就问题就大了"},{"start":684.73,"end":685.87,"text":"那个时候就开始有问题了"},{"start":685.87,"end":687.28,"text":"但是国人这个想象模式"},{"start":687.28,"end":690.6,"text":"图示开始切换到那边去了啊"},{"start":690.6,"end":692.16,"text":"那就不太一样了啊"},{"start":692.16,"end":693.15,"text":"那就不太一样了"},{"start":693.15,"end":698.42,"text":"那这个这才是复兴之大患也啊"},{"start":700.04,"end":701.48,"text":"啊这就是我的观点啊"},{"start":701.48,"end":702.41,"text":"这是我的观点"},{"start":702.41,"end":705.16,"text":"那个好吧"},{"start":709.0,"end":712.24,"text":"是个妥协是个妥协啊"},{"start":712.24,"end":714.28,"text":"但他真的有很强的控制力的时候"},{"start":714.28,"end":716.099,"text":"非常强大的控制力啊"},{"start":719.14,"end":722.54,"text":"移动吧啊就是不不太用这个意识形态啊"},{"start":722.54,"end":723.68,"text":"不太用这个意识形态"},{"start":723.68,"end":724.82,"text":"这个意识形态已经是"},{"start":724.82,"end":727.45,"text":"其实已经是那个掉掉稳定度"},{"start":727.45,"end":729.73,"text":"稳定度掉了一格之后才会用这东西"},{"start":729.73,"end":730.75,"text":"稳定度再调一格"},{"start":732.31,"end":733.999,"text":"稳定度再再掉一格的时候"},{"start":733.999,"end":735.799,"text":"可能就要讲讲讲什么"},{"start":735.799,"end":737.899,"text":"就可能要退退退退"},{"start":737.899,"end":738.939,"text":"守道什么"},{"start":742.6,"end":744.0,"text":"什么家家庭了"},{"start":744.0,"end":744.42,"text":"你知道吗"},{"start":744.42,"end":745.38,"text":"退守的什么家族"},{"start":745.38,"end":748.56,"text":"家族家族这种东西我退的往后退的"},{"start":758.64,"end":760.64,"text":"好吧那就那就聊到这里啊"},{"start":760.64,"end":761.36,"text":"那就聊到这里"},{"start":761.36,"end":768.18,"text":"这个是所以我对于抗疟奇的一些也就这个东西"},{"start":769.48,"end":771.84,"text":"民间其实民间不好"},{"start":771.84,"end":773.82,"text":"他妈的拿占这个点位"},{"start":773.82,"end":775.56,"text":"这个点位是个危险的点位"},{"start":776.26,"end":779.94,"text":"民间不好占这个点位的这个点位是危险点位"},{"start":779.94,"end":781.68,"text":"占这个点位的人"},{"start":781.68,"end":785.36,"text":"嘴巴上说说自己没有这个政治企图"},{"start":786.86,"end":788.61,"text":"他说只是个商人是吧"},{"start":788.61,"end":790.95,"text":"那个人说我没有正式企图"},{"start":790.95,"end":794.42,"text":"他那个名字三个字三个字母缩写跟我一样的啊"},{"start":794.42,"end":796.1,"text":"我没有政治企图啊"},{"start":796.1,"end":797.21,"text":"不懂政治啊"},{"start":797.21,"end":798.8,"text":"你妈不懂政治就怪了"},{"start":798.8,"end":801.0,"text":"我靠这搞笑"},{"start":801.92,"end":803.9,"text":"那都是不是"},{"start":803.9,"end":804.86,"text":"好歹也没读过书"},{"start":804.86,"end":805.8