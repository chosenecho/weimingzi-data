  "content_sha256": "ccf737240749f103e19a214082441bc6c003a8695d35069b2efa2539745455be",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 120,
      "end_ms": 3550,
      "text": "我觉得就是说我们要用行动"
    },
    {
      "ordinal": 1,
      "start_ms": 3550,
      "end_ms": 6280,
      "text": "而且是要用行动所追求的"
    },
    {
      "ordinal": 2,
      "start_ms": 6280,
      "end_ms": 9800,
      "text": "我经常所说的追求的那个态势"
    },
    {
      "ordinal": 3,
      "start_ms": 13020,
      "end_ms": 14720,
      "text": "来进行自我定义啊"
    },
    {
      "ordinal": 4,
      "start_ms": 14720,
      "end_ms": 16100,
      "text": "来进行"
    },
    {
      "ordinal": 5,
      "start_ms": 18160,
      "end_ms": 20080,
      "text": "自我的身份定义"
    },
    {
      "ordinal": 6,
      "start_ms": 24140,
      "end_ms": 25000,
      "text": "除此之外"
    },
    {
      "ordinal": 7,
      "start_ms": 25000,
      "end_ms": 25960,
      "text": "没有任何东西"
    },
    {
      "ordinal": 8,
      "start_ms": 25960,
      "end_ms": 26620,
      "text": "除此之外"
    },
    {
      "ordinal": 9,
      "start_ms": 26620,
      "end_ms": 28330,
      "text": "没有没有任何东西可以定义"
    },
    {
      "ordinal": 10,
      "start_ms": 28330,
      "end_ms": 30130,
      "text": "除此之外"
    },
    {
      "ordinal": 11,
      "start_ms": 30130,
      "end_ms": 31880,
      "text": "除此之外"
    },
    {
      "ordinal": 12,
      "start_ms": 33960,
      "end_ms": 40360,
      "text": "一切口号观念文化消费品"
    },
    {
      "ordinal": 13,
      "start_ms": 42860,
      "end_ms": 44379,
      "text": "身份符号"
    },
    {
      "ordinal": 14,
      "start_ms": 46980,
      "end_ms": 49820,
      "text": "这些东西都没有资格"
    },
    {
      "ordinal": 15,
      "start_ms": 51500,
      "end_ms": 53290,
      "text": "都都是假的啊"
    },
    {
      "ordinal": 16,
      "start_ms": 53290,
      "end_ms": 58380,
      "text": "除此之外这些其他的这些一切这些东西都是虚假的"
    },
    {
      "ordinal": 17,
      "start_ms": 58380,
      "end_ms": 60000,
      "text": "我们统统可以把"
    },
    {
      "ordinal": 18,
      "start_ms": 60000,
      "end_ms": 64860,
      "text": "就是如果你通过这种方式来进行自我身份定义的话"
    },
    {
      "ordinal": 19,
      "start_ms": 64860,
      "end_ms": 68520,
      "text": "就以我的立场就是你就是文化布尔乔亚"
    },
    {
      "ordinal": 20,
      "start_ms": 68520,
      "end_ms": 71060,
      "text": "你的实质就是文化布尔乔亚"
    },
    {
      "ordinal": 21,
      "start_ms": 78650,
      "end_ms": 79190,
      "text": "身份符号"
    },
    {
      "ordinal": 22,
      "start_ms": 79190,
      "end_ms": 80090,
      "text": "文化消费品"
    },
    {
      "ordinal": 23,
      "start_ms": 84960,
      "end_ms": 85920,
      "text": "多么怎么怎么样的"
    },
    {
      "ordinal": 24,
      "start_ms": 91540,
      "end_ms": 95050,
      "text": "它取决于你的行动所追求的态势"
    },
    {
      "ordinal": 25,
      "start_ms": 95050,
      "end_ms": 97330,
      "text": "你的行动所追求的态势"
    },
    {
      "ordinal": 26,
      "start_ms": 97330,
      "end_ms": 99539,
      "text": "对于现实的影响"
    },
    {
      "ordinal": 27,
      "start_ms": 99820,
      "end_ms": 103000,
      "text": "对于现实的人的现实利益和生存方式"
    },
    {
      "ordinal": 28,
      "start_ms": 103000,
      "end_ms": 113130,
      "text": "这里又说了对于现实的人的利益和方式和实质性的立场"
    },
    {
      "ordinal": 29,
      "start_ms": 113130,
      "end_ms": 115170,
      "text": "围绕着行动方式"
    },
    {
      "ordinal": 30,
      "start_ms": 115170,
      "end_ms": 119890,
      "text": "围绕着利益和行动方式的实质性的立场的改变"
    },
    {
      "ordinal": 31,
      "start_ms": 119890,
      "end_ms": 122000,
      "text": "而不是口号性的立场"
    },
    {
      "ordinal": 32,
      "start_ms": 126860,
      "end_ms": 129190,
      "text": "你要评价我没事"
    },
    {
      "ordinal": 33,
      "start_ms": 129190,
      "end_ms": 131440,
      "text": "我赚到的钱做什么"
    },
    {
      "ordinal": 34,
      "start_ms": 131440,
      "end_ms": 134220,
      "text": "我自有我的打算"
    },
    {
      "ordinal": 35,
      "start_ms": 140339,
      "end_ms": 142639,
      "text": "你在多大程度上了解我的行动"
    },
    {
      "ordinal": 36,
      "start_ms": 142639,
      "end_ms": 143539,
      "text": "了解我的现实"
    },
    {
      "ordinal": 37,
      "start_ms": 143539,
      "end_ms": 145360,
      "text": "对现实的人的影响"
    },
    {
      "ordinal": 38,
      "start_ms": 145899,
      "end_ms": 148079,
      "text": "你就可以在多大程度上评价我"
    },
    {
      "ordinal": 39,
      "start_ms": 148079,
      "end_ms": 150299,
      "text": "你们歪曲我或者误解我"
    },
    {
      "ordinal": 40,
      "start_ms": 150299,
      "end_ms": 154100,
      "text": "或者说你认为你识别到真正的我的追求没问题"
    },
    {
      "ordinal": 41,
      "start_ms": 155899,
      "end_ms": 156639,
      "text": "好吧"
    },
    {
      "ordinal": 42,
      "start_ms": 156639,
      "end_ms": 157479,
      "text": "除此之外"
    },
    {
      "ordinal": 43,
      "start_ms": 157479,
      "end_ms": 159489,
      "text": "一切口号观念文化消费品"
    },
    {
      "ordinal": 44,
      "start_ms": 159489,
      "end_ms": 160419,
      "text": "身份符号"
    },
    {
      "ordinal": 45,
      "start_ms": 160419,
      "end_ms": 162160,
      "text": "什么听的什么音乐"
    },
    {
      "ordinal": 46,
      "start_ms": 162160,
      "end_ms": 163510,
      "text": "看的什么"
    },
    {
      "ordinal": 47,
      "start_ms": 163510,
      "end_ms": 165740,
      "text": "我甚至说看的书籍"
    },
    {
      "ordinal": 48,
      "start_ms": 167059,
      "end_ms": 168960,
      "text": "崇拜的偶像"
    },
    {
      "ordinal": 49,
      "start_ms": 169499,
      "end_ms": 174379,
      "text": "这些东西通通都不足以认定你的自我身份"
    },
    {
      "ordinal": 50,
      "start_ms": 174379,
      "end_ms": 176720,
      "text": "一点用处都没有"
    },
    {
      "ordinal": 51,
      "start_ms": 177140,
      "end_ms": 178220,
      "text": "没有用"
    },
    {
      "ordinal": 52,
      "start_ms": 178220,
      "end_ms": 179930,
      "text": "那个都是假的"
    },
    {
      "ordinal": 53,
      "start_ms": 179930,
      "end_ms": 181520,
      "text": "他没有实质性的用处"
    },
    {
      "ordinal": 54,
      "start_ms": 181520,
      "end_ms": 185180,
      "text": "他就是你就像你尿急了要撒尿"
    },
    {
      "ordinal": 55,
      "start_ms": 185180,
      "end_ms": 186740,
      "text": "但是你是你做梦在撒尿"
    },
    {
      "ordinal": 56,
      "start_ms": 186740,
      "end_ms": 188700,
      "text": "你请问你这尿真的撒出去了吗"
    },
    {
      "ordinal": 57,
      "start_ms": 188700,
      "end_ms": 190830,
      "text": "假的他在宣传你"
    },
    {
      "ordinal": 58,
      "start_ms": 190830,
      "end_ms": 194800,
      "text": "你在梦里面做梦的时候在上厕所"
    },
    {
      "ordinal": 59,
      "start_ms": 194800,
      "end_ms": 197500,
      "text": "你这种梦里面上厕所上的越多"
    },
    {
      "ordinal": 60,
      "start_ms": 197500,
      "end_ms": 199930,
      "text": "你越不会起身去真的上厕所"
    },
    {
      "ordinal": 61,
      "start_ms": 199930,
      "end_ms": 201640,
      "text": "你说有宣传上的意义"
    },
    {
      "ordinal": 62,
      "start_ms": 201640,
      "end_ms": 203870,
      "text": "没有的零"
    },
    {
      "ordinal": 63,
      "start_ms": 203870,
      "end_ms": 205820,
      "text": "没有宣传上的意义的"
    },
    {
      "ordinal": 64,
      "start_ms": 209160,
      "end_ms": 210860,
      "text": "我再强调一遍"
    },
    {
      "ordinal": 65,
      "start_ms": 210860,
      "end_ms": 214640,
      "text": "它取决于你现实的用行动所追求的一个"
    },
    {
      "ordinal": 66,
      "start_ms": 214640,
      "end_ms": 217980,
      "text": "我们甚至可以说的很直白的一个利益态势"
    },
    {
      "ordinal": 67,
      "start_ms": 217980,
      "end_ms": 220470,
      "text": "利益和权利态势"
    },
    {
      "ordinal": 68,
      "start_ms": 220470,
      "end_ms": 225339,
      "text": "它取决于这个权利是人身控制性行为"
    },
    {
      "ordinal": 69,
      "start_ms": 225339,
      "end_ms": 230029,
      "text": "控制性的利益是决定了你这个人的生存和发展的这些利益"
    },
    {
      "ordinal": 70,
      "start_ms": 230029,
      "end_ms": 231559,
      "text": "现实的钱啊"
    },
    {
      "ordinal": 71,
      "start_ms": 231559,
      "end_ms": 233599,
      "text": "现实的物质资源呀"
    },
    {
      "ordinal": 72,
      "start_ms": 233599,
      "end_ms": 235560,
      "text": "现实的人力呀"
    },
    {
      "ordinal": 73,
      "start_ms": 235920,
      "end_ms": 237210,
      "text": "物力啊"
    },
    {
      "ordinal": 74,
      "start_ms": 237210,
      "end_ms": 239040,
      "text": "权力是现实的控制"
    },
    {
      "ordinal": 75,
      "start_ms": 239040,
      "end_ms": 240600,
      "text": "现实的对于这个人的影响"
    },
    {
      "ordinal": 76,
      "start_ms": 240600,
      "end_ms": 242160,
      "text": "他明天会去做什么"
    },
    {
      "ordinal": 77,
      "start_ms": 242160,
      "end_ms": 243880,
      "text": "下一瞬间会去做什么"
    },
    {
      "ordinal": 78,
      "start_ms": 243880,
      "end_ms": 249660,
      "text": "由这些东西所体现出来的来进行自我的身份定义"
    },
    {
      "ordinal": 79,
      "start_ms": 251839,
      "end_ms": 252819,
      "text": "除此之外"
    },
    {
      "ordinal": 80,
      "start_ms": 252819,
      "end_ms": 256298,
      "text": "你通通通过这种文化符号给自己擦脂抹粉"
    },
    {
      "ordinal": 81,
      "start_ms": 256298,
      "end_ms": 257499,
      "text": "呼喊口号"
    },
    {
      "ordinal": 82,
      "start_ms": 257499,
      "end_ms": 259959,
      "text": "用观念需要去驳倒别人"
    },
    {
      "ordinal": 83,
      "start_ms": 259959,
      "end_ms": 261160,
      "text": "抨击别人"
    },
    {
      "ordinal": 84,
      "start_ms": 261478,
      "end_ms": 263159,
      "text": "要崇拜某个偶像"
    },
    {
      "ordinal": 85,
      "start_ms": 263159,
      "end_ms": 264689,
      "text": "要去听什么音乐"
    },
    {
      "ordinal": 86,
      "start_ms": 264689,
      "end_ms": 266699,
      "text": "要是自己自封"
    },
    {
      "ordinal": 87,
      "start_ms": 266699,
      "end_ms": 267659,
      "text": "自己是个什么身份"
    },
    {
      "ordinal": 88,
      "start_ms": 267659,
      "end_ms": 268439,
      "text": "是个什么什么"
    },
    {
      "ordinal": 89,
      "start_ms": 268439,
      "end_ms": 270210,
      "text": "所以通通都是假的"
    },
    {
      "ordinal": 90,
      "start_ms": 270210,
      "end_ms": 272010,
      "text": "彻彻底底的是虚假的"
    },
    {
      "ordinal": 91,
      "start_ms": 272010,
      "end_ms": 273150,
      "text": "你这实质就是个文化"
    },
    {
      "ordinal": 92,
      "start_ms": 273150,
      "end_ms": 273690,
      "text": "布尔乔亚"
    },
    {
      "ordinal": 93,
      "start_ms": 273690,
      "end_ms": 279100,
      "text": "你通过富集这些我们叫负极这样的"
    },
    {
      "ordinal": 94,
      "start_ms": 279100,
      "end_ms": 281400,
      "text": "在你看来差异性的符号"
    },
    {
      "ordinal": 95,
      "start_ms": 282020,
      "end_ms": 286030,
      "text": "负极这些差异性的符号来打造你自己的一个人设"
    },
    {
      "ordinal": 96,
      "start_ms": 286030,
      "end_ms": 289140,
      "text": "这个人设可以作为一个资本"
    },
    {
      "ordinal": 97,
      "start_ms": 289159,
      "end_ms": 292200,
      "text": "可以作为一个资本来进行增值"
    },
    {
      "ordinal": 98,
      "start_ms": 296540,
      "end_ms": 299080,
      "text": "你不劳动这个人设就会慢慢涨起来"
    },
    {
      "ordinal": 99,
      "start_ms": 299080,
      "end_ms": 301180,
      "text": "不劳动这个人设慢慢涨起来"
    },
    {
      "ordinal": 100,
      "start_ms": 303360,
      "end_ms": 304760,
      "text": "这是老生常谈"
    },
    {
      "ordinal": 101,
      "start_ms": 304760,
      "end_ms": 309320,
      "text": "但是我今天我发现我去看个什么什么什么石家庄人那首歌"
    },
    {
      "ordinal": 102,
      "start_ms": 309320,
      "end_ms": 313160,
      "text": "就有一群人在那边品评那个摇滚乐"
    },
    {
      "ordinal": 103,
      "start_ms": 313160,
      "end_ms": 313700,
      "text": "好"
    },
    {
      "ordinal": 104,
      "start_ms": 313700,
      "end_ms": 316190,
      "text": "那个什么音乐作词人"
    },
    {
      "ordinal": 105,
      "start_ms": 316190,
      "end_ms": 317540,
      "text": "他真的左"
    },
    {
      "ordinal": 106,
      "start_ms": 317540,
      "end_ms": 318350,
      "text": "不好意思"
    },
    {
      "ordinal": 107,
      "start_ms": 318350,
      "end_ms": 320700,
      "text": "他们通通都是文化布尔乔亚"
    },
    {
      "ordinal": 108,
      "start_ms": 320979,
      "end_ms": 324129,
      "text": "他们和和和这个"
    },
    {
      "ordinal": 109,
      "start_ms": 324129,
      "end_ms": 330380,
      "text": "你说这你如果说这个leftism只是一个意识形态意义上的leftism的话"
    },
    {
      "ordinal": 110,
      "start_ms": 330380,
      "end_ms": 334940,
      "text": "那他们确实是可以用用leftism来来来自己擦拭抹粉的"
    },
    {
      "ordinal": 111,
      "start_ms": 334940,
      "end_ms": 337720,
      "text": "但是这意味着他们和"
    },
    {
      "ordinal": 112,
      "start_ms": 340800,
      "end_ms": 343100,
      "text": "和行动没有任何关系"
    },
    {
      "ordinal": 113,
      "start_ms": 344700,
      "end_ms": 347380,
      "text": "you they have nothing to do"
    },
    {
      "ordinal": 114,
      "start_ms": 350300,
      "end_ms": 352180,
      "text": "what are they describes"
    },
    {
      "ordinal": 115,
      "start_ms": 352740,
      "end_ms": 354450,
      "text": "what requires about"
    },
    {
      "ordinal": 116,
      "start_ms": 354450,
      "end_ms": 356310,
      "text": "what the describes about"
    },
    {
      "ordinal": 117,
      "start_ms": 356310,
      "end_ms": 360720,
      "text": "他和他们所描述的是他们所哭喊的那些内容"
    },
    {
      "ordinal": 118,
      "start_ms": 360720,
      "end_ms": 362900,
      "text": "那些现实没有关系"
    },
    {
      "ordinal": 119,
      "start_ms": 367300,
      "end_ms": 368430,
      "text": "好吧"
    },
    {
      "ordinal": 120,
      "start_ms": 368430,
      "end_ms": 373990,
      "text": "这个我就觉得就是说就是评价很简单"
    },
    {
      "ordinal": 121,
      "start_ms": 373990,
      "end_ms": 376000,
      "text": "你在单位里面"
    },
    {
      "ordinal": 122,
      "start_ms": 376000,
      "end_ms": 379660,
      "text": "你在学校里面有老师待人不公了"
    },
    {
      "ordinal": 123,
      "start_ms": 379660,
      "end_ms": 383570,
      "text": "你有有这个老板或者有这个什么"
    },
    {
      "ordinal": 124,
      "start_ms": 388020,
      "end_ms": 389700,
      "text": "那你按照按劳分配"
    },
    {
      "ordinal": 125,
      "start_ms": 389700,
      "end_ms": 392340,
      "text": "同工同酬的原则去引导我们"
    },
    {
      "ordinal": 126,
      "start_ms": 392340,
      "end_ms": 393660,
      "text": "这个话说了100遍了"
    },
    {
      "ordinal": 127,
      "start_ms": 393660,
      "end_ms": 394590,
      "text": "你做一分"
    },
    {
      "ordinal": 128,
      "start_ms": 394590,
      "end_ms": 396120,
      "text": "你才是一分的"
    },
    {
      "ordinal": 129,
      "start_ms": 396120,
      "end_ms": 398880,
      "text": "我们所所谓的辩证唯物主义者"
    },
    {
      "ordinal": 130,
      "start_ms": 398880,
      "end_ms": 399570,
      "text": "你不做"
    },
    {
      "ordinal": 131,
      "start_ms": 399570,
      "end_ms": 400650,
      "text": "你什么都不做"
    },
    {
      "ordinal": 132,
      "start_ms": 400650,
      "end_ms": 402210,
      "text": "那你没有任何资格"
    },
    {
      "ordinal": 133,
      "start_ms": 402210,
      "end_ms": 403470,
      "text": "你消费越多"
    },
    {
      "ordinal": 134,
