{"segments":[{"start":0.1,"end":4.57,"text":"我们讲哲学基础不是一般的基础"},{"start":4.81,"end":8.25,"text":"哲学的基础和其他学科的基础是不一样的"},{"start":9.45,"end":13.81,"text":"其他学科的基础还要给你们准备的是什么"},{"start":14.56,"end":17.28,"text":"他的基础的论域"},{"start":17.28,"end":19.09,"text":"关键的问题"},{"start":19.41,"end":21.43,"text":"它的要素性的知识"},{"start":21.43,"end":25.59,"text":"最基本的最简单的形态的要素性的知识"},{"start":25.59,"end":29.12,"text":"它的主要的方法啊"},{"start":29.12,"end":33.38,"text":"他的一个显著的思维方式和其他学科的差别"},{"start":33.38,"end":37.72,"text":"但是哲学基础会是这样"},{"start":38.44,"end":39.16,"text":"为什么呢"},{"start":40.16,"end":43.1,"text":"因为哲学它不是一门学科"},{"start":43.1,"end":47.12,"text":"但它名字叫哲学咳"},{"start":47.12,"end":49.1,"text":"但是哲学不是一门学科啊"},{"start":49.1,"end":50.4,"text":"换言之"},{"start":50.4,"end":52.82,"text":"我可以给你开一门课叫哲学基础"},{"start":52.82,"end":55.71,"text":"但是我不可能给你开一门课叫哲学"},{"start":56.23,"end":59.27,"text":"这些不是一般事"},{"start":59.48,"end":65.64,"text":"那我通常在网上反复强调的哲学是什么"},{"start":66.43,"end":69.46,"text":"你们有谁能跟我说一下诶"},{"start":69.46,"end":70.86,"text":"你叫啥来啊"},{"start":70.86,"end":71.78,"text":"没有没有"},{"start":71.78,"end":74.64,"text":"你不知道呃"},{"start":74.64,"end":76.62,"text":"不是魏小将吗"},{"start":76.9,"end":78.3,"text":"昨天直播的时候"},{"start":78.3,"end":79.4,"text":"你来说下"},{"start":79.4,"end":82.32,"text":"我按照我理解就是说一种生活"},{"start":82.32,"end":82.9,"text":"生活自在"},{"start":82.9,"end":83.46,"text":"生活方式"},{"start":83.46,"end":83.9,"text":"生活自在"},{"start":83.9,"end":84.94,"text":"这话就是标准答案"},{"start":84.94,"end":85.83,"text":"没错"},{"start":85.83,"end":88.86,"text":"有其他不一样的答案吗"},{"start":89.74,"end":92.96,"text":"对啊说了哲学还行吧"},{"start":92.96,"end":97.28,"text":"就是资产阶级在野状况的资产阶级"},{"start":97.28,"end":101.88,"text":"他的通知方式明白吧"},{"start":101.88,"end":104.48,"text":"哲学它不是一门学问啊"},{"start":104.48,"end":105.5,"text":"不是一门学问"},{"start":105.5,"end":107.479,"text":"它叫做爱智慧"},{"start":107.479,"end":113.27,"text":"比如索菲亚爱智慧是一个活动"},{"start":113.75,"end":115.41,"text":"那你说一种活动"},{"start":115.41,"end":119.11,"text":"他怎么会有所谓的基数呢"},{"start":119.11,"end":122.59,"text":"你是他是他是跳帕梅拉的"},{"start":122.59,"end":123.66,"text":"对不对"},{"start":124.38,"end":127.76,"text":"对你跳帕梅拉式算是某种技术吗"},{"start":127.76,"end":128.639,"text":"算是吧"},{"start":128.639,"end":130.079,"text":"健美操对吧"},{"start":130.079,"end":131.339,"text":"是对"},{"start":131.339,"end":134.099,"text":"所以当你们理解哲学基础的时候"},{"start":134.099,"end":138.479,"text":"第一个正确的理解是他是一个活动"},{"start":139.52,"end":141.16,"text":"叫入门"},{"start":141.36,"end":148.14,"text":"这个基础可以理解成是一种运动方式的初级的一个手写"},{"start":148.14,"end":149.96,"text":"一个体验"},{"start":150.879,"end":153.319,"text":"哲学之所以是一种生活方式"},{"start":154.959,"end":159.57,"text":"这个东西呢实际上是非常明确的啊"},{"start":160.73,"end":162.59,"text":"一旦你学习了哲学"},{"start":162.59,"end":165.41,"text":"一旦你适应了这种生活方式"},{"start":166.08,"end":170.12,"text":"你甚至可以说你的整个生活就不一样了"},{"start":171.36,"end":174.06,"text":"整个生活的看待生活"},{"start":174.06,"end":179.709,"text":"进入生活和其他人打交道的方式是完全不一样的"},{"start":181.62,"end":185.08,"text":"平民普通人掌握哲学"},{"start":185.08,"end":191.51,"text":"他经受的变化相当于是从就是报废说一下啊"},{"start":191.51,"end":194.19,"text":"相当于是从女人变成了男人"},{"start":197.16,"end":198.64,"text":"从女人变成了男人"},{"start":200.92,"end":202.88,"text":"为什么这么说呢"},{"start":203.45,"end":212.74,"text":"因为我们通常说女性的这个生活或者心理不是特别良好的规训能力"},{"start":212.74,"end":215.0,"text":"你玩过牌人都知道"},{"start":215.0,"end":217.62,"text":"女人会赖皮"},{"start":218.31,"end":219.65,"text":"男人会出千"},{"start":219.65,"end":223.76,"text":"男人会就是啊表面上看不出来"},{"start":223.76,"end":224.84,"text":"但她实际上作弊"},{"start":224.84,"end":227.12,"text":"但是女性呢她快要输的时候"},{"start":227.12,"end":228.52,"text":"她直接耍赖"},{"start":229.32,"end":230.4,"text":"他的生活呢"},{"start":230.4,"end":234.28,"text":"比如说并不是说是完整的规训的"},{"start":234.28,"end":236.56,"text":"完整的有序化的"},{"start":237.08,"end":239.76,"text":"充满了混乱男人"},{"start":239.76,"end":240.4,"text":"那就相反"},{"start":241.64,"end":243.7,"text":"学习哲学也是这么个过程"},{"start":243.7,"end":246.0,"text":"去记录一种秩序"},{"start":254.18,"end":255.5,"text":"进入一种秩序"},{"start":255.5,"end":262.1,"text":"但是这个秩序和一个孩子进入性秩序是不一样的"},{"start":262.1,"end":263.42,"text":"一个孩子进入性质时"},{"start":263.42,"end":267.2,"text":"他开始对自己的身体某些部分开始产生羞耻感"},{"start":267.2,"end":270.35,"text":"我说他知道有性别这种东西存在啊"},{"start":270.35,"end":272.07,"text":"有禁忌存在"},{"start":273.56,"end":281.909,"text":"哲学他所要要求你进入的秩序必须是由你自己生产的"},{"start":283.42,"end":285.24,"text":"自己生产秩序啊"},{"start":285.24,"end":286.96,"text":"自产的秩序"},{"start":286.96,"end":289.34,"text":"自己生产出来的秩序"},{"start":291.38,"end":295.289,"text":"但凡有一丁点不是你自己生产的"},{"start":295.289,"end":297.389,"text":"就不服从"},{"start":297.389,"end":298.769,"text":"就要退出"},{"start":298.769,"end":301.329,"text":"就要重新去设想"},{"start":302.54,"end":306.09,"text":"一旦进入这种秩序之后"},{"start":306.09,"end":310.61,"text":"哲学反过来会支配你的所有的行为"},{"start":310.61,"end":312.41,"text":"所有的生活态度"},{"start":312.41,"end":316.15,"text":"生活判断和所有的人际关系"},{"start":319.26,"end":320.66,"text":"我们来总结一下啊"},{"start":320.66,"end":324.5,"text":"就是说我希望你下次来的时候可以带笔记本啊"},{"start":324.5,"end":325.12,"text":"做笔记"},{"start":325.12,"end":327.21,"text":"我怕你们脑袋我感觉进不去"},{"start":327.21,"end":329.37,"text":"哲学不是一门学问"},{"start":329.37,"end":331.15,"text":"它是种生活方式"},{"start":331.15,"end":334.21,"text":"或者说其实这个答案也不是正确的"},{"start":334.21,"end":338.13,"text":"哲学是生活方式本身是一种自觉的"},{"start":338.13,"end":340.25,"text":"对于生活方式的选择"},{"start":340.25,"end":342.31,"text":"甚至不仅仅是选择"},{"start":342.31,"end":345.35,"text":"由于他自己生产出他自己的秩序"},{"start":345.35,"end":347.81,"text":"哲学是一种自觉的"},{"start":347.81,"end":350.55,"text":"甚至说是狂妄的"},{"start":350.55,"end":354.09,"text":"不断的去设立自己的生活方式"},{"start":354.09,"end":357.47,"text":"去创造产生自己的生活方式"},{"start":358.54,"end":361.3,"text":"那么问题来了啊"},{"start":363.56,"end":365.56,"text":"那一个人是在社会当中生存"},{"start":365.56,"end":366.419,"text":"对不对"},{"start":366.419,"end":367.519,"text":"你这样想"},{"start":367.519,"end":369.579,"text":"直接过上自己想过的生活"},{"start":369.579,"end":372.679,"text":"我脑子里面给自己产生了秩序"},{"start":372.679,"end":373.579,"text":"设立的秩序"},{"start":373.579,"end":375.169,"text":"我就要过着日子"},{"start":375.169,"end":376.729,"text":"做得到吗"},{"start":377.349,"end":378.469,"text":"做不到对不对"},{"start":378.469,"end":379.649,"text":"完全做不到"},{"start":379.649,"end":384.349,"text":"资产阶级可以在他的统治的领地当中"},{"start":384.349,"end":388.0,"text":"不服从于他所处时代"},{"start":388.0,"end":391.91,"text":"其他的一些封建贵族人身依附宗教"},{"start":391.91,"end":394.15,"text":"甚至说是法律的一些关联"},{"start":394.15,"end":399.04,"text":"直接在他统治的领域当中去贯彻他的世界观"},{"start":399.04,"end":400.28,"text":"他的生活观"},{"start":400.28,"end":401.87,"text":"他的秩序"},{"start":402.19,"end":403.73,"text":"所以哲学啊"},{"start":403.73,"end":406.75,"text":"他是那种自制的啊"},{"start":406.75,"end":409.02,"text":"自制性的"},{"start":411.86,"end":414.18,"text":"他这种自制的统治"},{"start":417.22,"end":419.66,"text":"咳嘶"},{"start":423.3,"end":426.36,"text":"但是问题就是对于普通人来讲"},{"start":426.36,"end":427.76,"text":"就是你不是资产阶级"},{"start":427.76,"end":431.11,"text":"你没有那么大的一个经济势力范围"},{"start":431.31,"end":436.21,"text":"你没有办法在社会当中圈出一片领地"},{"start":436.21,"end":437.39,"text":"在这个领地里面"},{"start":437.39,"end":440.59,"text":"按照我对这个世界的想法"},{"start":440.59,"end":446.569,"text":"我对我自己生活意义的这些设想去灌注一种秩序的话"},{"start":446.569,"end":448.849,"text":"那么哲学对于个体来讲"},{"start":448.849,"end":451.849,"text":"首先要求做得到的是什么"},{"start":452.65,"end":453.97,"text":"这个答案呼之欲出啊"},{"start":453.97,"end":455.41,"text":"你要学会推理啊"},{"start":455.41,"end":456.53,"text":"这种情况怎么办"},{"start":456.53,"end":465.659,"text":"你说你自己能能操控能改变如此能操控能改变的一些情况"},{"start":465.659,"end":468.179,"text":"就要努力去操控改变是吧"},{"start":468.83,"end":470.83,"text":"那这跟哲学有什么关系啊"},{"start":472.39,"end":473.67,"text":"因为我能操控就操控"},{"start":473.67,"end":475.94,"text":"不能超过就不超过"},{"start":480.76,"end":483.68,"text":"这是说局部的应用哲学是吧"},{"start":483.68,"end":484.92,"text":"局部的应用自己的推理"},{"start":484.92,"end":487.08,"text":"运用自己的想法去介入现实"},{"start":488.32,"end":489.32,"text":"这是个妥协吧"},{"start":489.32,"end":490.469,"text":"这是个折中"},{"start":491.56,"end":493.74,"text":"但是这还不是哲学实践它的方式"},{"start":493.74,"end":497.96,"text":"哲学在历史上是怎么实现它的一个比较长的历史阶段当中"},{"start":497.96,"end":500.039,"text":"哲学是怎么做的"},{"start":500.94,"end":502.48,"text":"那你就想着一个孩子"},{"start":502.48,"end":503.78,"text":"他想做自己的主人"},{"start":503.78,"end":505.24,"text":"但是它还没有长大"},{"start":505.24,"end":508.3,"text":"没有获得自己的一个房间"},{"start":510.16,"end":512.72,"text":"也没有主宰自己的一个家庭"},{"start":512.72,"end":514.799,"text":"就学会怎么做"},{"start":515.619,"end":519.72,"text":"就是如何如何去做"},{"start":519.72,"end":524.98,"text":"才能够去达到他所谓自产秩序自治的统治"},{"start":525.25,"end":528.61,"text":"你做的如果你们是聪明人的话"},{"start":528.61,"end":529.61,"text":"你就知道了"},{"start":529.61,"end":537.23,"text":"所以哲学会怎样会放弃那些他不太能支配控制的那个势力范围"},{"start":537.23,"end":541.38,"text":"还被宗教王权法度"},{"start":542.88,"end":545.4,"text":"不是说被不是自己生产的秩序"},{"start":545.4,"end":547.36,"text":"是被预设的秩序所支配的"},{"start":547.36,"end":550.0,"text":"那些领地放弃讨论他们"},{"start":550.0,"end":552.1,"text":"那他会选择"},{"start":553.37,"end":554.95,"text":"他能够讨论的"},{"start":554.95,"end":561.95,"text":"他能够去为其设立秩序的地方去适应试试"},{"start":561.95,"end":565.599,"text":"也是说他会逃到形而上的世界当中"},{"start":566.079,"end":570.279,"text":"逃到一个看似虚无的观念的领域当中去"},{"start":570.279,"end":571.959,"text":"这里面这些东西说不清楚"},{"start":571.959,"end":573.279,"text":"道不明白"},{"start":574.23,"end":576.51,"text":"但是呢只要他能说清楚"},{"start":576.51,"end":577.77,"text":"他能说明白"},{"start":577.77,"end":580.91,"text":"相当于成为这个领地里面的秩序的主人"},{"start":580.91,"end":582.53,"text":"主张里面的一套秩序"},{"start":582.53,"end":584.45,"text":"所以哲学在古希腊的时候"},{"start":584.45,"end":586.02,"text":"他做的事情是什么"},{"start":586.02,"end":587.42,"text":"成为形而上学"},{"start":587.42,"end":591.16,"text":"去探索那些不畏城邦的主人"},{"start":591.16,"end":594.849,"text":"或者说不畏世俗的胜利者啊"},{"start":594.849,"end":596.549,"text":"所掌控的东西"},{"start":596.549,"end":598.47,"text":"比如说世界的起源"},{"start":598.83,"end":600.93,"text":"说至善美德"},{"start":600.93,"end":605.15,"text":"还有各种神秘主义的一些永生不朽啊"},{"start":605.61,"end":611.52,"text":"逃到这些抽离与现实世界的问题当中去去解释"},{"start":611.52,"end":614.8,"text":"就说当他没有办法直接统治的时候"},{"start":614.8,"end":617.94,"text":"他会去选择去解释"},{"start":620.2,"end":621.44,"text":"解释什么呢"},{"start":623.28,"end":626.04,"text":"解释不可解释的东西"},{"start":632.54,"end":634.34,"text":"真干嘛啊"},{"start":634.34,"end":640.78,"text":"好哲学会去选择挑选一个精致的领地"},{"start":640.78,"end":642.47,"text":"在这个领地当中"},{"start":642.47,"end":644.61,"text":"世俗的统治权"},{"start":644.61,"end":646.97,"text":"世俗的优胜关系"},{"start":646.97,"end":649.56,"text":"在这里不直接适用了"},{"start":650.68,"end":655.16,"text":"他会调整到一个还会不清的"},{"start":655.16,"end":656.88,"text":"一般人难以去思考的"},{"start":656.88,"end":657.72,"text":"难以把握的"},{"start":657.72,"end":661.4,"text":"有点力量去试图解释那些不可解释的东西"},{"start":661.4,"end":663.4,"text":"大家一旦解释成功"},{"start":663.4,"end":664.36,"text":"他的理论"},{"start":665.68,"end":669.8,"text":"他所设立的规则就成为那个领域当中的法律"},{"start":670.24,"end":673.14,"text":"这就是希腊的形而上学的努力"},{"start":673.14,"end":675.24,"text":"全部的意在里面"},{"start":675.9,"end":677.06,"text":"明白吗"},{"start":677.06,"end":679.82,"text":"这是一个失败者的策略"},{"start":681.14,"end":686.88,"text":"人类的思想运行是通过哎呀"},{"start":687.15,"end":691.29,"text":"把自己的失败磨到一个他可以略微获得胜利"},{"start":697.45,"end":702.33,"text":"形而上学它天然的充满了失败的意味"},{"start":702.89,"end":704.77,"text":"这是哲学的第一个基础啊"},{"start":706.01,"end":709.9,"text":"第一个基础就是喜欢上学"},{"start":712.28,"end":715.6,"text":"那你们要意识到现在上学他实际上是是一门学问吗"},{"start":716.84,"end":719.03,"text":"可能是一门学问嗯"},{"start":719.03,"end":722.27,"text":"但是其实他也不是还不是一门学问"},{"start":722.27,"end":725.3,"text":"它是这个一种生活方式"},{"start":725.3,"end":727.04,"text":"热爱智慧的生活方式"},{"start":727.04,"end":729.11,"text":"这种非常偏执的生活方式"},{"start":729.11,"end":730.55,"text":"极端偏执的生活方式"},{"start":730.55,"end":733.21,"text":"在现实当中遭遇了阻碍"},{"start":733.21,"end":734.73,"text":"遭遇了困难之后"},{"start":734.73,"end":738.23,"text":"他要逃遁到自己的领地当中去"},{"start":738.31,"end":741.01,"text":"他逃到这些抽象的问题当中去"},{"start":741.01,"end":748.11,"text":"比如说一个不能够被具体的个别的生命去验证的"},{"start":748.11,"end":751.63,"text":"或者说不会被别人占领的一些世界当中去"},{"start":751.63,"end":756.849,"text":"必须宣誓像上学的话叫什么MEAPHICS啊"},{"start":757.889,"end":762.31,"text":"自学之后的东西快时间快到了"},{"start":763.59,"end":767.35,"text":"这录音这录音的是吧嗯"},{"start":769.1,"end":770.94,"text":"那么这是哲学的第一个基础"},{"start":770.94,"end":772.86,"text":"你们会看见他的第一个基础"},{"start":772.86,"end":774.62,"text":"实际上"},{"start":775.8,"end":776.92,"text":"算是基础吗"},{"start":779.48,"end":780.92,"text":"不是基础"},{"start":781.47,"end":783.51,"text":"实际上是我们要明确说啊"},{"start":783.51,"end":784.49,"text":"哲学的基础"},{"start":784.49,"end":786.07,"text":"如果从历史上来讲"},{"start":786.07,"end":787.609,"text":"他是从形而上学开始的"},{"start":787.609,"end":789.729,"text":"但实际上呢他是他的失败"},{"start":789.729,"end":790.569,"text":"第一个失败"},{"start":790.569,"end":793.66,"text":"或者说是他的第一次逃避"},{"start":794.26,"end":796.58,"text":"躲避躲藏"},{"start":796.92,"end":800.48,"text":"他逃避到这样的形而上学框架当中去呢"},{"start":800.48,"end":807.77,"text":"他其实没有能力在生活当中践行自己的种种原则"},{"start":807.77,"end":811.49,"text":"他就看上去说我要从形而上学的探索当中"},{"start":811.49,"end":815.01,"text":"然后再来推导出伦理学"},{"start":820.98,"end":824.16,"text":"然后再由这个伦理学来支配我的生活"},{"start":824.16,"end":827.0,"text":"就这个方向是错误的"},{"start":827.0,"end":828.4,"text":"这个是柏拉图"},{"start":828.4,"end":829.95,"text":"这是家里说的"},{"start":830.86,"end":832.58,"text":"明白吧"},{"start":832.58,"end":833.76,"text":"啧啧啧啧"},{"start":835.54,"end":837.1,"text":"哲学真正的基础"},{"start":837.1,"end":841.78,"text":"按照我们的理解是要从伦理学要进展到谁要上学吗"},{"start":842.78,"end":844.11,"text":"有必要吗"},{"start":844.75,"end":846.15,"text":"可能有一定的必要性"},{"start":847.31,"end":848.63,"text":"为什么呢"},{"start":849.21,"end":852.85,"text":"因为哪怕你是从伦理学直接要抵达生活方式的话"},{"start":852.85,"end":857.964,"text":"我们把或者说叫这种自产的秩序的话啊"},{"start":860.52,"end":861.76,"text":"它也不是直接的"},{"start":863.2,"end":864.4,"text":"它也并非直接的"},{"start":865.68,"end":867.2,"text":"为什么呢"},{"start":867.2,"end":872.45,"text":"这里面有个很关键的一个问题啧"},{"start":872.45,"end":877.8,"text":"哲学来自于一个人对于他的生活的反思"},{"start":877.8,"end":880.94,"text":"对于他自己生活秩序的设定"},{"start":880.94,"end":882.4,"text":"但是这个宇宙当中"},{"start":882.4,"end":885.36,"text":"这个社会当中难道只有你一个人吗"},{"start":887.58,"end":889.84,"text":"所以我们会看到在古希腊啊"},{"start":889.84,"end":892.74,"text":"他是有一些哲学家从伦理学出发的"},{"start":893.98,"end":899.619,"text":"比如说什么第欧根尼伊比鸠鲁犬儒主义"},{"start":899.619,"end":901.599,"text":"还有那个享乐主义"},{"start":902.09,"end":904.77,"text":"他纯粹的哲学世界怎样"},{"start":904.77,"end":907.75,"text":"他反正想的并不怎么出众出彩"},{"start":907.75,"end":910.21,"text":"人生采取什么态度"},{"start":910.45,"end":911.57,"text":"非常执拗"},{"start":911.57,"end":912.83,"text":"非常的偏执"},{"start":912.83,"end":916.57,"text":"但是呢你说他是实现了自己的哲学吗"},{"start":917.14,"end":919.06,"text":"并非如此"},{"start":920.02,"end":922.18,"text":"啧啧并非如此"},{"start":922.18,"end":925.14,"text":"因为哲学叫做爱"},{"start":925.14,"end":929.08,"text":"智慧是对于智慧的追求"},{"start":930.32,"end":934.96,"text":"而不是简简单单是我要过我想过的生活"},{"start":935.16,"end":940.39,"text":"你想过的生活必定是要得到充分的论证"},{"start":940.91,"end":944.63,"text":"绝对的辩护的是一丝马虎"},{"start":944.63,"end":946.35,"text":"苟且不得的"},{"start":947.86,"end":950.5,"text":"如果你急切的是采用伦理学"},{"start":950.5,"end":951.9,"text":"也就是说啊"},{"start":951.9,"end":956.7,"text":"我在人世间应当如何去处理我和他人的关系"},{"start":956.7,"end":958.24,"text":"我和享乐快乐的关系"},{"start":959.28,"end":968.19,"text":"我和这个就是仅仅是在人间打交道的那些条件和要素"},{"start":969.15,"end":971.51,"text":"那么我产生出来的我的生活方式"},{"start":971.51,"end":973.83,"text":"它和智慧有什么关系呢"},{"start":979.7,"end":980.82,"text":"什么叫做智慧"},{"start":981.9,"end":985.34,"text":"智慧应该从哪里获得"},{"start":986.02,"end":988.76,"text":"啧啧如果我们仅仅是停留在人间"},{"start":988.76,"end":990.38,"text":"停留在人和人的关系当中"},{"start":991.38,"end":993.26,"text":"我们是无法获得智慧的"},{"start":993.26,"end":998.32,"text":"因为这意味着你只是依附于习俗"},{"start":999.8,"end":1001.6,"text":"依附于斗争的结果"},{"start":1001.6,"end":1007.04,"text":"利益的偏好产生一些对于你自己最有利的"},{"start":1007.04,"end":1010.86,"text":"或者说最能说服你自己的一种生活方式"},{"start":1010.86,"end":1014.31,"text":"但这种生活方式和智慧还是没关系"},{"start":1014.9,"end":1016.5,"text":"那么问题就来了"},{"start":1016.5,"end":1018.14,"text":"那么什么叫智慧呢"},{"start":1019.18,"end":1020.38,"text":"我们回过头来讲"},{"start":1020.38,"end":1022.02,"text":"就是说"},{"start":1034.499,"end":1037.858,"text":"或者至少是追求智慧啊"},{"start":1039.7,"end":1040.64,"text":"爱智慧"},{"start":1040.64,"end":1041.619,"text":"追求智慧"},{"start":1041.619,"end":1045.2,"text":"对智慧具有强大的爱欲"},{"start":1045.64,"end":1047.92,"text":"智慧这个东西"},{"start":1049.92,"end":1052.2,"text":"他是喜而上的东西吧"},{"start":1053.47,"end":1056.49,"text":"他是来自于说我要逃避我的生活"},{"start":1056.49,"end":1059.85,"text":"我要到一个抽象的空间里面做主人"},{"start":1059.85,"end":1061.19,"text":"称王称霸"},{"start":1061.19,"end":1064.56,"text":"不是这样的智慧"},{"start":1064.92,"end":1067.76,"text":"他首先来自于是所谓的"},{"start":1069.76,"end":1071.12,"text":"善"},{"start":1073.96,"end":1079.23,"text":"但是这个善呢或者我们换一换另外一个词叫做好啊"},{"start":1079.75,"end":1083.79,"text":"有的哲学家会把它翻译成好good"},{"start":1085.56,"end":1088.44,"text":"这是古希腊哲学最经典的"},{"start":1089.6,"end":1092.53,"text":"我们所谓追求这个智慧啊"},{"start":1092.53,"end":1097.35,"text":"其实就是追求事物的或者生存的最美好的"},{"start":1097.35,"end":1099.06,"text":"最应当的"},{"start":1099.06,"end":1101.7,"text":"最恰当的一种存在方式"},{"start":1103.14,"end":1107.34,"text":"比如这个变成某种哈自我循环啊"},{"start":1109.34,"end":1112.9,"text":"嗯嗯所以"},{"start":1118.38,"end":1123.8,"text":"本来哲学追求的是一种热爱智慧的生活方式"},{"start":1123.8,"end":1127.92,"text":"现在由于你是要热爱智慧"},{"start":1129.04,"end":1134.57,"text":"智慧反倒成为了你不得不去追求"},{"start":1134.85,"end":1135.51,"text":"追求"},{"start":1135.51,"end":1138.99,"text":"到了获得了你对于智慧的把握"},{"start":1138.99,"end":1143.49,"text":"或者说你在获得某种次一级的智慧"},{"start":1143.94,"end":1145.82,"text":"不是最终的真相"},{"start":1145.82,"end":1150.48,"text":"但是是你在追求过程当中积累的某种经验"},{"start":1150.48,"end":1158.51,"text":"这些经验呢能够反过来教导你什么样的生活是叫做你在追求智慧"},{"start":1159.55,"end":1164.08,"text":"或者说什么样的价值可以被称得上是好"},{"start":1164.08,"end":1167.0,"text":"什么样的目标可以被称得上是善"},{"start":1167.0,"end":1170.1,"text":"你往这个方向去运动"},{"start":1170.1,"end":1175.02,"text":"这个运动本身就是你过上你的啊"},{"start":1176.42,"end":1178.7,"text":"追求智慧的生活方式"},{"start":1179.979,"end":1187.49,"text":"所以这里面就是说哲学和智慧是一个主动和被动的关系"},{"start":1187.49,"end":1190.19,"text":"智慧被看成是被动的存在"},{"start":1190.19,"end":1193.19,"text":"被看成是永恒的静态的存在"},{"start":1193.19,"end":1196.87,"text":"而哲学被看成是对他的追求"},{"start":1204.92,"end":1209.8,"text":"你们考虑过追求一个永恒的静态的存在吗"},{"start":1212.2,"end":1214.76,"text":"一种抵达了它就可以不再运动"},{"start":1216.56,"end":1221.52,"text":"一种生活吧有吗"},{"start":1222.04,"end":1225.0,"text":"或者说你会感受到内在的那种不安定"},{"start":1225.0,"end":1225.94,"text":"彷徨"},{"start":1225.94,"end":1229.46,"text":"失落和痛苦驱逐着你"},{"start":1229.46,"end":1233.08,"text":"去寻找一个绝对的宁静的基准"},{"start":1233.08,"end":1237.18,"text":"一个终点有吗"},{"start":1242.66,"end":1244.78,"text":"你这在疑惑着是吧"},{"start":1244.78,"end":1246.82,"text":"这在困惑着"},{"start":1248.6,"end":1257.07,"text":"所以哲学啊它在起源上实际上是一种神秘主义宗教体验"},{"start":1257.7,"end":1259.34,"text":"这种神秘主义宗教体验呢"},{"start":1260.7,"end":1264.68,"text":"他把智慧当成是一种完备的"},{"start":1264.68,"end":1267.54,"text":"不再需要有所更改的"},{"start":1267.54,"end":1272.269,"text":"宁静的安定的一种存在方式"},{"start":1273.749,"end":1274.969,"text":"那么在基督教时代呢"},{"start":1274.969,"end":1277.309,"text":"这叫做神智论"},{"start":1278.56,"end":1280.04,"text":"在获得智慧之后"},{"start":1280.04,"end":1282.12,"text":"个体就处在一种迷狂"},{"start":1283.48,"end":1285.24,"text":"然后极端亢奋"},{"start":1285.24,"end":1287.28,"text":"又是极端安宁的状态"},{"start":1287.94,"end":1294.51,"text":"这个在基督教神学当中呢是一度是可以做到的"},{"start":1294.51,"end":1298.25,"text":"可以做到的就是非常疯狂的欣喜"},{"start":1298.65,"end":1300.45,"text":"那么做到了之后呢"},{"start":1301.77,"end":1306.769,"text":"而且生活方式本身只要去使得这样一种智性操练"},{"start":1306.769,"end":1308.749,"text":"可以不停的重复就行了"},{"start":1308.749,"end":1311.92,"text":"他觉得这种生活就是具有意义了"},{"start":1311.92,"end":1313.22,"text":"就具有价值的"},{"start":1313.22,"end":1318.58,"text":"那这种生活呢就像那个僧侣修道院里面僧侣一样"},{"start":1318.82,"end":1322.68,"text":"那么在资产阶级的哲学谱系当中的黑格尔主义者"},{"start":1322.68,"end":1324.32,"text":"特别是晚期黑格尔主义者"},{"start":1324.32,"end":1326.58,"text":"他过的就是这种生活"},{"start":1327.52,"end":1328.72,"text":"明白吧"},{"start":1328.72,"end":1331.0,"text":"他这种生活是可以过得上的"},{"start":1331.0,"end":1332.58,"text":"你们谁想过这种生活"},{"start":1332.58,"end":1336.99,"text":"你去你去把那黑格尔的逻辑学啊"},{"start":1336.99,"end":1341.31,"text":"什么哲学史讲演讲演录这东西看看了之之后"},{"start":1341.31,"end":1344.05,"text":"然后自己去推就推不同的环节"},{"start":1344.05,"end":1345.17,"text":"一个对你这辈子"},{"start":1345.17,"end":1351.41,"text":"你可以陷入一种不断的去确认所谓智慧的一种欣喜和快乐当中"},{"start":1354.06,"end":1355.9,"text":"但是这样问题就来了"},{"start":1355.9,"end":1357.78,"text":"那么这种状态是好的吗"},{"start":1357.78,"end":1359.5,"text":"是善的吗"},{"start":1360.51,"end":1364.41,"text":"停止在一种智慧的结局当中"},{"start":1364.41,"end":1365.43,"text":"是好的"},{"start":1365.43,"end":1366.91,"text":"是善的吧"},{"start":1369.84,"end":1372.62,"text":"所以哲学他的发问的基础"},{"start":1372.62,"end":1374.96,"text":"或者说哲学的真正的基础"},{"start":1374.96,"end":1377.84,"text":"它会变成一个问题"},{"start":1379.6,"end":1383.2,"text":"或者说他停下了对于智慧的追逐"},{"start":1386.7,"end":1397.32,"text":"因为哲学它是一个不停的对那个非常遥远的智慧完美终极答案"},{"start":1398.44,"end":1401.2,"text":"然后狂热的去追逐的过程"},{"start":1401.2,"end":1405.24,"text":"把这个追逐过程看成自己的生活方式"},{"start":1406.51,"end":1410.87,"text":"在这个追逐过程当中会不断的产生对于一切的结论"},{"start":1410.87,"end":1412.74,"text":"由这些结论"},{"start":1413.06,"end":1414.64,"text":"这些结论实际上是什么"},{"start":1414.64,"end":1416.66,"text":"让你追求这个目标"},{"start":1416.66,"end":1418.74,"text":"你得到的很多启发"},{"start":1418.74,"end":1421.159,"text":"你自己想采取的各样的手段"},{"start":1421.159,"end":1426.819,"text":"你觉得你能够改善提高你的追追逐的效率的这方法"},{"start":1426.819,"end":1429.27,"text":"然后你就去疯狂的去执行它"},{"start":1429.27,"end":1430.59,"text":"拿你的生命"},{"start":1430.59,"end":1437.979,"text":"拿你在这个社会当中的所有的影响作为赌注去实现这一点"},{"start":1438.99,"end":1442.03,"text":"但是这个过程是很愚蠢的"},{"start":1442.03,"end":1443.63,"text":"对不对"},{"start":1444.5,"end":1450.6,"text":"因为你并没有在不停的去修正你所追逐的目标"},{"start":1450.6,"end":1453.08,"text":"他到底是不是"},{"start":1458.52,"end":1461.88,"text":"他到底是不是你所爱的东西"},{"start":1462.179,"end":1465.139,"text":"这哲学的根底它叫做爱智慧"},{"start":1466.139,"end":1470.5,"text":"爱智慧的话就是非常有意思的东西啊"},{"start":1470.74,"end":1472.34,"text":"你们你们谈过恋爱吗"},{"start":1473.38,"end":1474.94,"text":"谈过恋爱的举个手吧"},{"start":1474.94,"end":1477.46,"text":"狂热的爱过一个人"},{"start":1478.94,"end":1482.68,"text":"在那个狂热的爱过一个人的时候"},{"start":1482.68,"end":1485.42,"text":"你们会不会对他产生一个疑问呢"},{"start":1485.42,"end":1488.4,"text":"就是不是他到底爱不爱我"},{"start":1488.4,"end":1489.88,"text":"而是说我到底爱不爱他"},{"start":1489.88,"end":1495.95,"text":"或者说我爱的那个那个对象到底是不是那个我要追求的对象"},{"start":1495.95,"end":1499.19,"text":"你们会不会产生这种这种困惑"},{"start":1499.19,"end":1500.73,"text":"会是吧"},{"start":1500.73,"end":1504.11,"text":"有没有有的时候会觉得自己追逐的是个幻影"},{"start":1504.11,"end":1507.11,"text":"是自己心里面想的已经是一个坏人"},{"start":1507.11,"end":1509.1,"text":"已经本身就是一个幻影了对吧"},{"start":1509.1,"end":1511.86,"text":"但是那个幻影是你没办法根除的"},{"start":1511.86,"end":1515.26,"text":"他在你的内心一遍一遍的出现的"},{"start":1517.0,"end":1519.16,"text":"爱情是哲学的"},{"start":1520.44,"end":1521.04,"text":"某种意义上"},{"start":1521.04,"end":1522.28,"text":"爱情是哲学的基础啊"},{"start":1522.28,"end":1523.72,"text":"你们一定要记得啊"},{"start":1523.72,"end":1526.31,"text":"就是爱智慧的前提"},{"start":1526.31,"end":1527.94,"text":"你得会爱"},{"start":1527.94,"end":1530.18,"text":"就是你得受过爱的折磨"},{"start":1530.18,"end":1532.44,"text":"你在爱当中动摇过"},{"start":1532.44,"end":1534.94,"text":"对于你所瞄准的那个对象"},{"start":1534.94,"end":1539.13,"text":"你怀疑过我到底还爱不爱吃东西"},{"start":1539.45,"end":1545.42,"text":"所以很多哲学家的他的那个哲学历程来自于一个失败的爱情啊"},{"start":1545.42,"end":1547.8,"text":"他在爱情当中他怯懦了"},{"start":1547.8,"end":1548.66,"text":"他退缩了"},{"start":1548.66,"end":1551.48,"text":"他开始停下脚步来想一想我到底爱的是什么"},{"start":1551.48,"end":1551.92,"text":"爱的是什么"},{"start":1551.92,"end":1553.639,"text":"爱的是什么"},{"start":1553.96,"end":1557.84,"text":"这这是哲学的又一个基础"},{"start":1557.84,"end":1565.32,"text":"但是这个基础实际上我要说的是和我刚刚讲的作为形而上学的"},{"start":1567.88,"end":1570.0,"text":"基础是同一个基础"},{"start":1571.76,"end":1574.74,"text":"如果我们对于形而上学加一个精确定义的话"},{"start":1574.74,"end":1578.58,"text":"形而上学就是爱情或者爱"},{"start":1578.58,"end":1580.86,"text":"就是一种形而上学"},{"start":1582.62,"end":1585.82,"text":"你们你们有没有看过齐泽克的那个那个视频"},{"start":1586.12,"end":1590.91,"text":"有一个视频就是说我就是当我忽然之间爱"},{"start":1590.91,"end":1592.15,"text":"就是忽然把你击倒"},{"start":1592.15,"end":1593.25,"text":"然后失衡了"},{"start":1593.25,"end":1596.54,"text":"你爱上他之后会发现他整个都不一样了"},{"start":1596.54,"end":1597.14,"text":"对不对"},{"start":1598.22,"end":1598.76,"text":"明白吗"},{"start":1598.76,"end":1605.3,"text":"就是说我们要承认这个世界不是说都是形而下的"},{"start":1605.3,"end":1607.22,"text":"它是有一个形而上的位面的"},{"start":1607.22,"end":1611.02,"text":"但是这个形而上的位面它不是飘在上面"},{"start":1611.02,"end":1612.02,"text":"它是会降临的"},{"start":1612.02,"end":1614.09,"text":"就是它是直接会显现出来的"},{"start":1614.09,"end":1616.53,"text":"你们要理解什么叫形而上学啊"},{"start":1617.57,"end":1621.33,"text":"你们得拿爱情作为你的答案"},{"start":1621.33,"end":1622.67,"text":"当你爱上一个人"},{"start":1622.67,"end":1627.87,"text":"这个人浑身原本非常庸俗或者非常平凡的样子"},{"start":1627.87,"end":1629.949,"text":"一下子就变得不一样了"},{"start":1629.949,"end":1631.989,"text":"这种力量就是形而上"},{"start":1631.989,"end":1634.78,"text":"形而上学就是就是那个位面"},{"start":1634.78,"end":1635.9,"text":"明白吗"},{"start":1635.9,"end":1639.88,"text":"当你胃又或者说你病态的去呃"},{"start":1639.88,"end":1641.74,"text":"要收集某种收藏品的时候"},{"start":1641.74,"end":1643.79,"text":"那收藏品明明就是一张卡"},{"start":1643.79,"end":1645.67,"text":"但是它就完全不一样了"},{"start":1645.67,"end":1650.11,"text":"就好像他是就是进入了整个存在秩序的缝隙当中"},{"start":1650.11,"end":1654.42,"text":"和万事万物都就非比寻常"},{"start":1654.42,"end":1660.77,"text":"这个位面这个显现出来的就是形而上学的世界啊"},{"start":1660.93,"end":1661.81,"text":"另外一方面"},{"start":1661.81,"end":1662.45,"text":"形而上本"},{"start":1662.45,"end":1664.21,"text":"形而上学本身是一种爱"},{"start":1664.21,"end":1667.89,"text":"形而上学本身就是爱情而笑"},{"start":1667.89,"end":1669.85,"text":"因为形而上学"},{"start":1671.06,"end":1678.5,"text":"它意味着对于现实生活的呃额外的追问"},{"start":1679.06,"end":1680.46,"text":"或者说我们要说的话"},{"start":1680.46,"end":1683.98,"text":"我们说说形而上学是对于世界的额外的爱"},{"start":1685.72,"end":1686.68,"text":"就是"},{"start":1688.92,"end":1689.68,"text":"是这样的啊"},{"start":1690.68,"end":1692.54,"text":"嗯啧啧"},{"start":1692.54,"end":1694.48,"text":"这个东西我都不想"},{"start":1694.48,"end":1696.8,"text":"有点有点有点不不想直接报答案了"},{"start":1696.8,"end":1698.84,"text":"但是我我不善于教授啊"},{"start":1698.84,"end":1700.3,"text":"我只能给你报答案了"},{"start":1700.3,"end":1702.18,"text":"当你理解何为形而上学的时候"},{"start":1702.18,"end":1703.94,"text":"你要去理解哲学家"},{"start":1703.94,"end":1706.2,"text":"他本来是执拗的"},{"start":1706.2,"end":1708.18,"text":"偏执的去设立自己的生活"},{"start":1708.18,"end":1711.12,"text":"想要在自己的方式当中存在"},{"start":1711.12,"end":1713.2,"text":"但是呢他失败了"},{"start":1713.2,"end":1714.04,"text":"他失败了"},{"start":1714.04,"end":1715.64,"text":"但是"},{"start":1724.88,"end":1727.22,"text":"啊他之所以是哲学家"},{"start":1727.22,"end":1730.54,"text":"而不是成为什么军阀"},{"start":1730.54,"end":1732.74,"text":"而不是争权夺利的原因"},{"start":1732.74,"end":1736.5,"text":"他之所以退到形而上的世界当中"},{"start":1736.5,"end":1748.39,"text":"他其实是想要去把他追逐智慧的这种爱分享给这个世界本身"},{"start":1748.39,"end":1750.29,"text":"形而上学还有一个特点"},{"start":1750.29,"end":1754.78,"text":"就是说他是一个啧我"},{"start":1754.78,"end":1755.46,"text":"我打个比方"},{"start":1755.46,"end":1758.179,"text":"就是如果你把这整个世界看成是一个恋人"},{"start":1758.179,"end":1761.779,"text":"把他一个哲学家所身处的这个世界或者这个宇宙"},{"start":1761.779,"end":1764.739,"text":"这个社会当成是一个人的话"},{"start":1764.739,"end":1766.44,"text":"就这个人太笨了"},{"start":1766.44,"end":1767.2,"text":"不开窍"},{"start":1768.2,"end":1770.48,"text":"他不知道他是什么"},{"start":1770.83,"end":1774.33,"text":"他不知道他应当如何存在"},{"start":1774.33,"end":1776.07,"text":"他不知道他背后的真相"},{"start":1776.07,"end":1779.79,"text":"哲学家通过形而上学把他的真相告诉他"},{"start":1779.79,"end":1784.639,"text":"所以形而上学你可以看成是哲人对于世界的爱"},{"start":1784.639,"end":1787.639,"text":"所以香菜本身是一种爱"},{"start":1788.4,"end":1790.78,"text":"一个哲学家探索形而上学的时候"},{"start":1790.78,"end":1795.34,"text":"就是在对于整个世界在抒发他的爱意"},{"start":1795.34,"end":1800.259,"text":"他想告诉一个愚蠢的无知的一个懵懂的一种存在"},{"start":1800.259,"end":1802.379,"text":"我来告诉你你是什么"},{"start":1803.539,"end":1807.37,"text":"我来把你的智慧作为赠礼馈赠给你"},{"start":1807.409,"end":1808.449,"text":"就是这种探索"},{"start":1810.169,"end":1814.29,"text":"我来到这么一个你尚未存在的啊"},{"start":1814.29,"end":1822.96,"text":"嗯你无法返回的一个抽离的遥远的超越的位面去寻找你的踪迹"},{"start":1822.96,"end":1829.18,"text":"寻找你之所以成为你自己的证据和来路"},{"start":1829.62,"end":1831.38,"text":"相当于是给他安排归宿"},{"start":1833.14,"end":1835.99,"text":"这是形而上学的基本指去"},{"start":1836.47,"end":1842.59,"text":"否则你难以去解释为什么追加如此痴狂的去啊"},{"start":1842.59,"end":1843.77,"text":"脱离现实世界"},{"start":1843.77,"end":1845.77,"text":"又不完全脱离"},{"start":1845.77,"end":1852.6,"text":"去寻找现实世界的根源和他的根据"},{"start":1857.32,"end":1862.93,"text":"所以这个基础和形而上学是同一个东西"},{"start":1863.09,"end":1870.179,"text":"哲学家所探索的形而上学并不是对于世界的支配的载质性的"},{"start":1870.179,"end":1874.41,"text":"或者说统治性的那个故事"},{"start":1874.73,"end":1875.63,"text":"你们要记啊"},{"start":1875.63,"end":1877.63,"text":"就是说形而上学和宗教"},{"start":1877.63,"end":1884.235,"text":"神学和世界的起源论的差异在于它并不是说是要去宰治这个世界"},{"start":1884.44,"end":1888.36,"text":"而是类似于告诉一个愚蠢的恋人"},{"start":1888.36,"end":1890.72,"text":"你为什么如此可爱"},{"start":1890.72,"end":1893.81,"text":"你为什么会是你现在这个样子"},{"start":1893.81,"end":1895.61,"text":"你从哪里来"},{"start":1895.61,"end":1898.34,"text":"你的姓名是什么"},{"start":1899.06,"end":1903.26,"text":"真正的你是如何生长出来的"},{"start":1904.129,"end":1904.849,"text":"观众无话"},{"start":1904.849,"end":1908.629,"text":"我们就说形而上学在这个意义上讲是可以被理解成是什么"},{"start":1908.629,"end":1911.4,"text":"是宇宙的加宇宙的归宿"},{"start":1911.4,"end":1919.1,"text":"就是这个现实的这个已经咳降到俗世当中的这个世界的他的归宿"},{"start":1919.1,"end":1921.52,"text":"他的家明白吧"},{"start":1921.52,"end":1926.76,"text":"所以想上学可以成就是世界的基础啊"},{"start":1926.76,"end":1928.4,"text":"世界的巢穴"},{"start":1928.64,"end":1930.36,"text":"那么这个基础和巢穴呢"},{"start":1930.36,"end":1935.26,"text":"他是作为哲学家对于世界的爱而提供给他的"},{"start":1935.26,"end":1940.61,"text":"哲学家在形而上学当中所饱含的好奇啊"},{"start":1940.61,"end":1942.57,"text":"那种不断追问的毅力"},{"start":1943.57,"end":1950.599,"text":"还有是对于那种超越性真相的那种一厢情愿的信任"},{"start":1950.599,"end":1955.139,"text":"相信他其实都怎么说呢"},{"start":1957.56,"end":1959.04,"text":"都已经是一种爱了"},{"start":1960.52,"end":1964.1,"text":"所以哲学它叫爱智慧"},{"start":1964.1,"end":1965.22,"text":"对不对"},{"start":1972.48,"end":1973.96,"text":"你们要记住一下啊"},{"start":1973.96,"end":1979.5,"text":"就是说一般我们把哲学作为爱智慧是理解成你去追求一种智慧"},{"start":1979.5,"end":1981.88,"text":"但是我们反过来要说的是"},{"start":1981.88,"end":1983.28,"text":"哲学本身"},{"start":1983.28,"end":1986.33,"text":"它是作为一种爱存在的"},{"start":1986.33,"end":1988.05,"text":"是一种特殊的爱"},{"start":1988.05,"end":1992.09,"text":"这种特殊的爱不是给某个个体的"},{"start":1992.09,"end":1993.93,"text":"也不是给某个什么"},{"start":1993.93,"end":1996.59,"text":"就是哦哲学就是爱哲学本身吗"},{"start":1996.59,"end":1997.99,"text":"不是的"},{"start":1998.33,"end":2002.65,"text":"哲学他的爱是作为智慧发出来的"},{"start":2002.65,"end":2007.55,"text":"爱哲人的智慧通过形而上学的探索"},{"start":2007.55,"end":2009.41,"text":"它形成一种关爱"},{"start":2009.41,"end":2012.2,"text":"这种关爱是朝向世界本身的"},{"start":2012.2,"end":2014.68,"text":"是对世界本身的不安定"},{"start":2014.68,"end":2018.5,"text":"丑陋悲剧创伤的抚慰"},{"start":2019.02,"end":2020.16,"text":"明白吧"},{"start":2020.16,"end":2025.88,"text":"这个这种活动就相当于说我作为哲学家"},{"start":2025.88,"end":2028.76,"text":"我追求我的最理想的生活方式"},{"start":2028.76,"end":2030.28,"text":"但这还不够"},{"start":2030.28,"end":2034.06,"text":"因为我要确定我的最理想的方式的前提是"},{"start":2034.06,"end":2036.78,"text":"我得知道这个世界本身的最理想的"},{"start":2036.78,"end":2040.28,"text":"或者说它最本来应当的存在方式"},{"start":2040.56,"end":2044.72,"text":"我知道他本应如何最理想的存在"},{"start":2044.72,"end":2046.04,"text":"我才知道我怎么样"},{"start":2046.04,"end":2047.85,"text":"我才是最理想的生存"},{"start":2047.85,"end":2050.71,"text":"甚至说这里面会得到非常偏激的答案"},{"start":2050.71,"end":2052.65,"text":"有的只要会推定"},{"start":2052.65,"end":2056.159,"text":"如果这个世界最好的生存在方式"},{"start":2056.159,"end":2059.199,"text":"是要把我们这些有智慧的人不应该存在"},{"start":2059.199,"end":2060.079,"text":"人家应该保持一致"},{"start":2060.079,"end":2061.359,"text":"他会自杀"},{"start":2062.409,"end":2063.65,"text":"他会得到结论"},{"start":2063.65,"end":2068.96,"text":"就是说我死去才是我最应当存在的方式"},{"start":2068.96,"end":2075.389,"text":"我把这个死亡作为一个证赠给这个世界啊是吧"},{"start":2075.389,"end":2079.05,"text":"所以我们得到了这个三人组的统一啊"},{"start":2079.05,"end":2089.53,"text":"就这里还有一个爱爱和形而上学和作为世界的基础的啊"},{"start":2089.53,"end":2091.449,"text":"形而上学在这里是作为世界的基础"},{"start":2091.449,"end":2092.469,"text":"但是作为世界基础"},{"start":2092.469,"end":2094.3,"text":"它是一种爱"},{"start":2096.02,"end":2099.84,"text":"它是一种哲学家试图为整个世界进行奠基"},{"start":2099.84,"end":2103.34,"text":"不再愿意这个世界作为一个无根的"},{"start":2103.34,"end":2104.58,"text":"没有根据的"},{"start":2104.58,"end":2105.88,"text":"没有来由的"},{"start":2105.88,"end":2107.64,"text":"没有依据的存在"},{"start":2107.64,"end":2109.08,"text":"所以哲学家有个特点"},{"start":2109.08,"end":2112.78,"text":"他会把整个世界看成是一个孤儿啊"},{"start":2112.78,"end":2114.64,"text":"他抚慰这种孤独的创伤"},{"start":2114.64,"end":2119.78,"text":"哲人是不太容易感受到个体自我的孤独的"},{"start":2120.36,"end":2121.0,"text":"明白吗"},{"start":2122.0,"end":2125.2,"text":"因为比他孤独的多的是这个世界本身"},{"start":2126.66,"end":2130.4,"text":"啊我看我讲了多久"},{"start":2130.4,"end":2132.14,"text":"现在七点钟了"},{"start":2132.14,"end":2133.34,"text":"45分钟啊"},{"start":2133.34,"end":2135.81,"text":"讲到一个7.10分"},{"start":2138.18,"end":2139.78,"text":"所以你们要学习哲学"},{"start":2140.78,"end":2144.34,"text":"你们要善于去感受这个世界本身的创伤"},{"start":2144.34,"end":2146.67,"text":"痛苦不一致性"},{"start":2147.03,"end":2151.91,"text":"这种创伤的痛苦不仅仅体现在人间"},{"start":2155.78,"end":2160.78,"text":"不是只有人类才会感到痛苦和创伤的"},{"start":2163.74,"end":2167.92,"text":"而宇宙本身是在处在一种痛苦和创伤撕裂当中的"},{"start":2167.92,"end":2169.7,"text":"处在一种历史的烦闷"},{"start":2169.7,"end":2171.82,"text":"无聊不安"},{"start":2174.28,"end":2176.84,"text":"但是如何感受到这一点呢"},{"start":2179.98,"end":2182.14,"text":"如何感知到这一点呢"},{"start":2187.36,"end":2188.28,"text":"如果感受到"},{"start":2188.28,"end":2193.42,"text":"就是说人类之外的整个世界当中的某种响动"},{"start":2194.84,"end":2196.4,"text":"某种异常呢"},{"start":2196.4,"end":2199.96,"text":"这就是哲学家他的某种历史使命了"},{"start":2200.48,"end":2204.05,"text":"那么答案很简单了啊"},{"start":2204.05,"end":2207.23,"text":"答案就是非常清楚和明白了"},{"start":2207.23,"end":2209.47,"text":"哲人通过热爱智慧"},{"start":2209.47,"end":2211.31,"text":"对于智慧的爱"},{"start":2211.79,"end":2215.19,"text":"它是可以得到智慧"},{"start":2215.19,"end":2218.55,"text":"但是又不作为智慧存在的"},{"start":2218.55,"end":2224.27,"text":"就是说哲学的理想状态是爱着智慧"},{"start":2224.27,"end":2225.77,"text":"拥有了智慧"},{"start":2225.77,"end":2227.67,"text":"但不占有它"},{"start":2227.67,"end":2231.53,"text":"和他保持单纯的爱的关系"},{"start":2231.53,"end":2236.2,"text":"并且在这种宁静当中舍弃自我"},{"start":2238.22,"end":2240.06,"text":"来学习哲学"},{"start":2240.06,"end":2241.79,"text":"要善于去思"},{"start":2241.885,"end":2243.25,"text":"善于去"},{"start":2243.25,"end":2246.67,"text":"就是说这个是你们日常要去训练的一种精神状态啊"},{"start":2246.67,"end":2248.35,"text":"比如说你爱上一个女孩子"},{"start":2248.35,"end":2250.62,"text":"她也跟你谈恋爱了"},{"start":2250.62,"end":2252.5,"text":"不是让你获得它"},{"start":2252.5,"end":2256.6,"text":"但是一般而言就是说这个时候我再跟她结婚"},{"start":2256.6,"end":2258.22,"text":"然后就是支配他生活"},{"start":2258.22,"end":2261.79,"text":"或者说作为一个家庭来支配两人的共同的生活"},{"start":2261.79,"end":2264.69,"text":"去设想是怎么样的啊"},{"start":2264.69,"end":2267.27,"text":"这个过程当中不知不觉爱情就消失了"},{"start":2267.27,"end":2268.75,"text":"转化成亲情啊"},{"start":2268.75,"end":2269.87,"text":"责任感啊"},{"start":2269.87,"end":2275.88,"text":"甚至说是呃一种两个人大伙过日子的那种经营算计的东西"},{"start":2277.24,"end":2280.52,"text":"那问题就在于你如何去维持你的爱情"},{"start":2281.82,"end":2285.66,"text":"处在一种激动的宁静当中"},{"start":2286.28,"end":2289.94,"text":"这个状态是可以一直维持的"},{"start":2289.94,"end":2293.18,"text":"就是说在人和人之间是很难维持的"},{"start":2293.18,"end":2296.12,"text":"但是在一个哲学家和他的智慧之间"},{"start":2296.77,"end":2299.63,"text":"和他已经获得的智慧之剑"},{"start":2299.63,"end":2301.27,"text":"回答已经产生了"},{"start":2301.27,"end":2304.81,"text":"对于什么是事物的存在理想状态"},{"start":2304.81,"end":2308.33,"text":"事物运行发展的正确道路等等等等"},{"start":2308.33,"end":2315.7,"text":"这些智慧之间他是能保持一种暧昧的甜蜜的距离的"},{"start":2316.1,"end":2318.16,"text":"当你有了智慧之后"},{"start":2318.16,"end":2321.26,"text":"不去占据它"},{"start":2321.9,"end":2323.78,"text":"不去撕碎它"},{"start":2323.78,"end":2329.48,"text":"不去把这些所谓的智慧就变成你驰骋人世间的啊"},{"start":2329.48,"end":2330.72,"text":"功利算计这些手段"},{"start":2331.92,"end":2336.57,"text":"策略变成人和人之间相互倾轧的啊"},{"start":2336.57,"end":2338.21,"text":"那些武器"},{"start":2339.2,"end":2340.88,"text":"而是把它作为"},{"start":2344.12,"end":2345.64,"text":"一个老朋友"},{"start":2345.97,"end":2353.819,"text":"一个伴侣把你通过哲学学习获得的智慧拟人化"},{"start":2353.819,"end":2355.639,"text":"类似于成为一个伴侣"},{"start":2355.639,"end":2360.579,"text":"成为一个不断的给你的生活提供建议"},{"start":2361.14,"end":2368.54,"text":"对你的角色进行劝阻或者说诱导的一个伴侣维持这种关系"},{"start":2369.44,"end":2373.28,"text":"你能够获得一种宁静的爱的状态"},{"start":2374.76,"end":2377.16,"text":"这种宁静的爱的状态"},{"start":2378.68,"end":2381.08,"text":"他会成为你的精神气质的底色"},{"start":2382.16,"end":2384.36,"text":"一般就是哲学家所谓的自信的一个状态"},{"start":2384.36,"end":2389.05,"text":"或者说一种哦那种就古希腊哲人走到哪边"},{"start":2389.05,"end":2391.71,"text":"就是就不害怕去和别人辩论"},{"start":2391.71,"end":2394.92,"text":"不害怕对于终极的问题进行探讨啊"},{"start":2394.92,"end":2397.08,"text":"那么这种姿态的话"},{"start":2401.66,"end":2402.8,"text":"你们叫什么"},{"start":2402.8,"end":2404.52,"text":"就是一种好奇的"},{"start":2404.52,"end":2408.679,"text":"善问的期待答案的期待回想啊"},{"start":2408.679,"end":2412.919,"text":"然后就是不不时的引发惊奇的一种状态"},{"start":2412.919,"end":2414.039,"text":"那么我们说了"},{"start":2414.039,"end":2417.62,"text":"处在这种状态之下的哲人是幸福的"},{"start":2418.06,"end":2419.74,"text":"但是是过于幸福的"},{"start":2420.98,"end":2423.7,"text":"过于幸福就会变得昏溃"},{"start":2423.7,"end":2424.96,"text":"看不见"},{"start":2424.96,"end":2427.0,"text":"那么问题就是"},{"start":2428.39,"end":2428.79,"text":"啊"},{"start":2431.31,"end":2433.66,"text":"喂哲人处在这种状态下"},{"start":2433.66,"end":2434.66,"text":"你已经是个哲学家了"},{"start":2434.66,"end":2435.42,"text":"没问题"},{"start":2435.42,"end":2436.76,"text":"爱智慧者"},{"start":2436.76,"end":2441.28,"text":"并且伴随着所爱的智慧生存的一种状态"},{"start":2441.68,"end":2443.66,"text":"但是这个问题就在于是"},{"start":2443.66,"end":2446.82,"text":"你只能感受到人间的痛苦了"},{"start":2446.82,"end":2453.17,"text":"你不能感受到这个世界本身的创伤和他的不一致性"},{"start":2453.17,"end":2454.49,"text":"往往这种情况下"},{"start":2454.49,"end":2456.63,"text":"这个哲学家他对于这个宇宙论"},{"start":2456.63,"end":2460.589,"text":"对于本体论的构造都是相对比较闭合的了啊"},{"start":2460.589,"end":2464.689,"text":"相对比较稳固的比比典型就是斯宾诺莎这种人啊"},{"start":2464.689,"end":2467.269,"text":"斯宾诺莎这种货"},{"start":2467.42,"end":2470.48,"text":"他实现了他的这个本体论与宙论闭合了之后"},{"start":2470.48,"end":2475.3,"text":"他处在一种安定的类似于宗教圣徒的一种精神状态"},{"start":2478.36,"end":2481.74,"text":"额会是一种甜蜜的状态"},{"start":2481.74,"end":2484.28,"text":"但是就是瞎了啊"},{"start":2484.28,"end":2484.82,"text":"龙类"},{"start":2484.82,"end":2486.76,"text":"你那我们要讲的就是说"},{"start":2486.76,"end":2488.94,"text":"如当你处在这种状态之后"},{"start":2488.94,"end":2491.52,"text":"你还能够去介入现实"},{"start":2491.84,"end":2498.52,"text":"不停的去用你的这种内在的和知识和智慧之间的良好的伴侣关系"},{"start":2498.52,"end":2501.11,"text":"去承受考验的时候"},{"start":2501.57,"end":2503.65,"text":"你所承受的痛苦"},{"start":2503.65,"end":2505.79,"text":"你所产生的新的怀疑"},{"start":2505.79,"end":2506.87,"text":"不自信"},{"start":2506.87,"end":2510.65,"text":"你所产生的你的情感上的失衡"},{"start":2510.65,"end":2511.87,"text":"或者说那个智慧"},{"start":2511.87,"end":2513.13,"text":"你凝练出来的智慧"},{"start":2513.13,"end":2514.67,"text":"他变得越来越可疑"},{"start":2514.67,"end":2517.01,"text":"越来越面目可憎"},{"start":2517.01,"end":2519.629,"text":"甚至这个过程当中"},{"start":2519.629,"end":2522.749,"text":"你感受到的就是这个世界本身的创伤"},{"start":2524.8,"end":2528.56,"text":"这个过程中你感受的就是这个世界本身的内在缺陷"},{"start":2528.56,"end":2530.64,"text":"他向你显现"},{"start":2531.17,"end":2535.25,"text":"你获得了一个像是爱智慧之间的这个关联"},{"start":2535.25,"end":2538.06,"text":"像像一面镜子一样"},{"start":2538.7,"end":2541.419,"text":"横个人在嘶"},{"start":2541.419,"end":2544.859,"text":"横亘在你和这个世界的真相之间"},{"start":2544.859,"end":2552.71,"text":"所以说爱智慧不等于爱真理不等于爱真相"},{"start":2554.06,"end":2555.72,"text":"哲学是爱智慧"},{"start":2555.72,"end":2559.1,"text":"但是哲学绝不热爱真相"},{"start":2562.48,"end":2566.56,"text":"哲学是憎恨真相的"},{"start":2568.2,"end":2570.84,"text":"哲学也是逃避真相"},{"start":2574.28,"end":2578.44,"text":"那么哲学什么时候开始去面对真相了呢"},{"start":2580.56,"end":2583.44,"text":"哪个哲学家啧啧啧"},{"start":2583.44,"end":2584.92,"text":"他就不在哲学家了"},{"start":2584.92,"end":2586.96,"text":"你们知道是哪一个吗"},{"start":2587.19,"end":2588.79,"text":"不是马克思"},{"start":2590.43,"end":2592.11,"text":"你们知道是哪个吗"},{"start":2592.93,"end":2595.89,"text":"啊不不不也不是"},{"start":2595.89,"end":2600.16,"text":"这泥是尼采好哲学"},{"start":2600.16,"end":2601.0,"text":"从爱智慧"},{"start":2601.0,"end":2602.76,"text":"典型的爱智慧的哲学"},{"start":2602.76,"end":2608.01,"text":"所谓的古典哲学转化成真正意义上的现代哲学"},{"start":2608.01,"end":2611.29,"text":"它就不再是从这个啊"},{"start":2611.29,"end":2616.31,"text":"从不再是从对于智慧之爱当中来获得自己的人生基准感"},{"start":2616.31,"end":2620.97,"text":"转而是对于真相的一个拼命的一个追寻"},{"start":2620.97,"end":2623.09,"text":"实际上怎么说呢"},{"start":2623.09,"end":2628.25,"text":"其实说对尼采才是真正彻底的柏拉图主义者"},{"start":2628.25,"end":2632.55,"text":"虽然他一直在在在在这个反对柏拉主义"},{"start":2632.55,"end":2633.43,"text":"因为柏拉图主义"},{"start":2633.43,"end":2636.79,"text":"基督教式的柏拉图主义一直在掩盖真相啊"},{"start":2637.49,"end":2640.82,"text":"尼采的他的口号叫什么啊"},{"start":2641.94,"end":2642.86,"text":"重估一切价值"},{"start":2642.86,"end":2643.66,"text":"对不对"},{"start":2643.66,"end":2645.44,"text":"那翻译成英文人之下"},{"start":2645.44,"end":2647.57,"text":"revue嗯"},{"start":2647.57,"end":2649.31,"text":"Every values"},{"start":2649.31,"end":2652.11,"text":"但是问题就是说revue by what"},{"start":2652.11,"end":2654.15,"text":"你用什么来重估一切价值"},{"start":2654.15,"end":2657.03,"text":"价值本身尺度本身就是衡量事物的"},{"start":2657.03,"end":2659.095,"text":"价值本身就是用来衡量事物的"},{"start":2659.14,"end":2661.48,"text":"你要去重新衡量价值"},{"start":2661.48,"end":2664.16,"text":"你用什么东西来衡量"},{"start":2666.18,"end":2668.7,"text":"你猜答案是什么"},{"start":2670.92,"end":2674.96,"text":"真相在尼采那边有一个另外一个名字叫什么"},{"start":2679.36,"end":2681.21,"text":"叫命运"},{"start":2681.93,"end":2685.81,"text":"所以尼采答案是哲人不应当爱真"},{"start":2685.81,"end":2687.17,"text":"而不应当爱智慧"},{"start":2687.17,"end":2688.37,"text":"应当爱真相"},{"start":2688.37,"end":2690.85,"text":"那么真相啧"},{"start":2690.85,"end":2694.529,"text":"在生命当中的真相就是命运"},{"start":2694.529,"end":2696.349,"text":"哪怕是幻象"},{"start":2696.349,"end":2698.409,"text":"也是正向命运"},{"start":2698.409,"end":2701.51,"text":"对于你的摆弄欺骗"},{"start":2702.11,"end":2706.51,"text":"对你的纠缠也是真相"},{"start":2708.82,"end":2715.54,"text":"所以哲学基础在尼采之后是发生了一个重大的转变的"},{"start":2715.54,"end":2718.5,"text":"尼采同时期是黑格尔"},{"start":2718.5,"end":2718.94,"text":"对不对"},{"start":2721.14,"end":2723.86,"text":"哦是之后是之前是吧"},{"start":2725.78,"end":2731.1,"text":"叔本华和黑格尔一个时代的尼采特点的是"},{"start":2732.18,"end":2736.52,"text":"他并不是通过逻辑推论来得到这些东西"},{"start":2736.52,"end":2744.67,"text":"它是通过在命运当中的挣扎来得到哲学的新的基础发射"},{"start":2744.67,"end":2749.07,"text":"所以哲学的基础不再是通过形而上学"},{"start":2749.07,"end":2754.95,"text":"不再是通过一种对于世界的爱"},{"start":2755.86,"end":2762.18,"text":"或者说不再是在爱的过程当中看到"},{"start":2762.18,"end":2764.2,"text":"切换自己的视角"},{"start":2764.2,"end":2769.43,"text":"看到这个这个事物本身凸显出来的那个与众不同的那一面"},{"start":2769.43,"end":2770.49,"text":"然后感到惊奇"},{"start":2770.49,"end":2774.21,"text":"然后开始我要去看我如何爱护好这个世界"},{"start":2774.21,"end":2777.2,"text":"如何给这个世界一个交代"},{"start":2777.2,"end":2778.7,"text":"一种解释"},{"start":2778.7,"end":2779.86,"text":"一套说辞"},{"start":2779.86,"end":2783.519,"text":"让这个世界觉得它是个美好的世界"},{"start":2783.519,"end":2786.279,"text":"就是以尼采之前的哲学是这样做的"},{"start":2786.279,"end":2787.579,"text":"尼采之后的哲学"},{"start":2787.579,"end":2789.499,"text":"他关注的是什么"},{"start":2791.0,"end":2793.6,"text":"他关注的是这些视角本身"},{"start":2794.949,"end":2796.789,"text":"啊perspective"},{"start":2796.789,"end":2798.469,"text":"他是视角主义的"},{"start":2798.469,"end":2802.37,"text":"他关注的是你在沉入爱当中"},{"start":2802.37,"end":2808.01,"text":"你发是发现这个是这个这个人一下子从非常美"},{"start":2808.01,"end":2810.6,"text":"非常庸俗变得非常美好"},{"start":2810.96,"end":2820.04,"text":"并不是后面那个非常美好的形而上的那个位面主宰了一个哲人的追求"},{"start":2820.04,"end":2826.13,"text":"而是说这个变化这里面的变化它到底意味着什么"},{"start":2826.13,"end":2827.97,"text":"你爱上一个人"},{"start":2827.97,"end":2829.55,"text":"或者说你爱上这个世界"},{"start":2829.55,"end":2831.79,"text":"它到底意味着什么"},{"start":2832.38,"end":2833.06,"text":"咳"},{"start":2833.06,"end":2835.06,"text":"他主宰了这个哲学家的追求"},{"start":2836.18,"end":2838.3,"text":"智慧不再是直接的智慧了"},{"start":2838.3,"end":2841.93,"text":"智慧是通过和命运的缠斗"},{"start":2842.839,"end":2847.44,"text":"智慧是通过对形而上的价值啊"},{"start":2847.44,"end":2849.98,"text":"对于这个包括是什么自己生产秩序"},{"start":2849.98,"end":2852.83,"text":"在尼采那边也是几乎是不可能的"},{"start":2853.51,"end":2857.39,"text":"不能或者说至少不能通过这么一个简单的回路去获得了"},{"start":2858.12,"end":2861.88,"text":"而是在和命运的缠斗当中去获得"},{"start":2862.68,"end":2864.58,"text":"这个过程中命运会欺骗你"},{"start":2864.58,"end":2866.44,"text":"会给你虚假的智慧"},{"start":2866.44,"end":2868.84,"text":"会告诉你虚假的爱"},{"start":2869.33,"end":2870.85,"tex