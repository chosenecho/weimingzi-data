{"segments":[{"start":0.46,"end":4.6,"text":"你说这个杨和平啊又开始出来阴阳怪气了"},{"start":4.6,"end":6.76,"text":"他说什么"},{"start":7.96,"end":10.36,"text":"他是拿美国举例子啊"},{"start":10.36,"end":14.94,"text":"说美国那个什么工人积极分子啊"},{"start":14.94,"end":17.34,"text":"他得偷偷的私下串联"},{"start":17.72,"end":19.02,"text":"然后呢"},{"start":19.52,"end":21.17,"text":"像公贼呢"},{"start":21.17,"end":22.22,"text":"这是公贼"},{"start":22.22,"end":23.21,"text":"就是厌恶我了"},{"start":28.9,"end":31.08,"text":"他的意思就是说我指责他"},{"start":35.5,"end":37.26,"text":"我我我们举个例子啊"},{"start":37.26,"end":40.04,"text":"就是说这个东西我真的是没话说的"},{"start":40.44,"end":42.36,"text":"我真是没话说的"},{"start":44.42,"end":49.72,"text":"你住在你住在工厂主的家里面"},{"start":51.34,"end":55.43,"text":"叫你做做任何事情"},{"start":55.43,"end":60.419,"text":"你在一楼二楼或者在地下室做的事情"},{"start":60.64,"end":62.26,"text":"工厂主在一楼二楼"},{"start":62.26,"end":64.36,"text":"在楼上听得一清二楚"},{"start":64.36,"end":65.42,"text":"干干净净"},{"start":72.7,"end":77.78,"text":"其次你还是工厂主的小孩儿的老师"},{"start":80.16,"end":81.5,"text":"你住人家家里面"},{"start":81.5,"end":82.92,"text":"给人家小孩当老师"},{"start":84.78,"end":86.66,"text":"我天然的就不可能信任你"},{"start":86.66,"end":87.08,"text":"对不对"},{"start":89.3,"end":92.48,"text":"是不是真的真的好意思呢"},{"start":92.48,"end":93.68,"text":"我我实事求是讲"},{"start":93.68,"end":94.82,"text":"我实事求是讲"},{"start":95.96,"end":97.53,"text":"我有点受不了了"},{"start":97.53,"end":100.57,"text":"说什么我给说我是公贼"},{"start":102.01,"end":103.15,"text":"所以我就是工贼"},{"start":103.15,"end":105.91,"text":"他们私下里是有地下的什么秘密活动的"},{"start":105.91,"end":107.29,"text":"了不起的秘密活动的"},{"start":107.29,"end":109.28,"text":"高级的解放性的秘密活动的"},{"start":109.28,"end":111.26,"text":"你那些高级解放性的秘密活动"},{"start":111.26,"end":111.86,"text":"我说了"},{"start":111.86,"end":113.72,"text":"你们就是宝藏二元论"},{"start":115.94,"end":117.259,"text":"造的时候瞎造"},{"start":117.28,"end":118.88,"text":"要别人送死"},{"start":119.3,"end":120.8,"text":"要不送死的瞎子"},{"start":120.8,"end":122.18,"text":"嘴巴上饱了要死死"},{"start":122.18,"end":123.62,"text":"脑部思想不解放"},{"start":123.62,"end":124.58,"text":"讲原教旨"},{"start":124.58,"end":125.12,"text":"叨逼叨"},{"start":125.12,"end":126.2,"text":"讲原教旨"},{"start":126.2,"end":128.72,"text":"一点现实的经验都没有"},{"start":129.359,"end":131.179,"text":"一点现实的产业都没有"},{"start":131.179,"end":137.02,"text":"一点现实的和劳动群众现实打交道的"},{"start":137.02,"end":140.02,"text":"现实的打交道的"},{"start":140.02,"end":141.56,"text":"你有你自己的"},{"start":142.019,"end":144.599,"text":"你也有自己的一个产业"},{"start":148.26,"end":150.3,"text":"你光是什么分析调查啊"},{"start":150.3,"end":152.46,"text":"我靠下去陪人家喝喝酒"},{"start":152.46,"end":153.18,"text":"吹吹牛逼"},{"start":153.18,"end":154.42,"text":"这东西算什么"},{"start":155.14,"end":156.24,"text":"真的是搞笑"},{"start":156.24,"end":158.16,"text":"我真的是受不了的"},{"start":158.359,"end":159.919,"text":"我我最后我再说"},{"start":159.919,"end":163.939,"text":"你住在你住在你住在工厂主家里面"},{"start":163.939,"end":166.42,"text":"给工厂主子女做老师"},{"start":166.76,"end":169.64,"text":"住在他家给他做老师"},{"start":169.64,"end":173.98,"text":"你这只而且更不用说了"},{"start":173.98,"end":178.48,"text":"你们当年写求情信写的那个什么样子"},{"start":181.24,"end":182.58,"text":"真的好意思"},{"start":182.58,"end":184.24,"text":"还说别人是公贼"},{"start":184.519,"end":185.839,"text":"真的太搞笑了"},{"start":185.839,"end":187.339,"text":"我觉得这真的太搞笑了"},{"start":187.339,"end":189.259,"text":"太可笑了太可笑了"},{"start":189.259,"end":190.039,"text":"可笑至极"},{"start":190.039,"end":190.76,"text":"对不对"},{"start":198.16,"end":201.34,"text":"积极分子不会住在工厂主的家里面"},{"start":201.98,"end":205.88,"text":"积极分子不会给工厂主的子女做老师"},{"start":207.7,"end":208.58,"text":"就讲到这里"}],"source":"subtitle"}
