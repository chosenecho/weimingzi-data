  "segments": [
    {
      "ordinal": 0,
      "start_ms": 55520,
      "end_ms": 58080,
      "text": "回头再看，迷迷灯光，"
    },
    {
      "ordinal": 1,
      "start_ms": 59200,
      "end_ms": 61600,
      "text": "眸之景寂寥不安。"
    },
    {
      "ordinal": 2,
      "start_ms": 62640,
      "end_ms": 69520,
      "text": "藏身于无形鸡窗，想跟你道晚安。"
    },
    {
      "ordinal": 3,
      "start_ms": 69520,
      "end_ms": 75440,
      "text": "沥沥细雨，茫茫星光，明朝走别来惊慌。"
    },
    {
      "ordinal": 4,
      "start_ms": 76240,
      "end_ms": 82640,
      "text": "投奔于遥遥他方，愿遗忘无寄望。"
    },
    {
      "ordinal": 5,
      "start_ms": 83520,
      "end_ms": 92400,
      "text": "原谅今宵我告别了活泼的心，像下沉掉。"
    },
    {
      "ordinal": 6,
      "start_ms": 92400,
      "end_ms": 97760,
      "text": "梦里有他，有计微妙，情怎可了？"
    },
    {
      "ordinal": 7,
      "start_ms": 99680,
      "end_ms": 118080,
      "text": "怀念当初你太重要，但你始终未尽全力，让这颗心渐渐逃脱，情也没掉。"
    },
    {
      "ordinal": 8,
      "start_ms": 118080,
      "end_ms": 123680,
      "text": "回头再看，迷迷灯光，眸之景寂寥不安。"
    },
    {
      "ordinal": 9,
      "start_ms": 124720,
      "end_ms": 130160,
      "text": "藏身于无形鸡窗，想跟你道晚安。"
    },
    {
      "ordinal": 10,
      "start_ms": 130160,
      "end_ms": 137360,
      "text": "沥沥细雨，茫茫星光，明朝走别来惊慌。"
    },
    {
      "ordinal": 11,
      "start_ms": 138160,
      "end_ms": 142080,
      "text": "投奔于遥遥他方，愿遗忘无寄望。"
    },
    {
      "ordinal": 12,
      "start_ms": 142080,
      "end_ms": 153840,
      "text": "原谅今宵我告别了活泼的心，像下沉掉。"
    },
    {
      "ordinal": 13,
      "start_ms": 154160,
      "end_ms": 160720,
      "text": "梦里有他，有计微妙，情怎可了？"
    },
    {
      "ordinal": 14,
      "start_ms": 160720,
      "end_ms": 171360,
      "text": "怀念当初你太重要，但你始终未尽全力，让这颗心渐渐逃脱，情也没掉。"
    },
    {
      "ordinal": 15,
      "start_ms": 182697,
      "end_ms": 206057,
      "text": "今天起的美满，纵有星光灿烂。"
    },
    {
      "ordinal": 16,
      "start_ms": 207177,
      "end_ms": 213817,
      "text": "可惜心灰意冷，前头更黯淡，路更漫。"
    },
    {
      "ordinal": 17,
      "start_ms": 214217,
      "end_ms": 218697,
      "text": "今天起的美满，那要珍惜岁月。"
    },
    {
      "ordinal": 18,
      "start_ms": 218697,
      "end_ms": 226697,
      "text": "不必感叹，情缘或为某日再返。"
    },
    {
      "ordinal": 19,
      "start_ms": 236777,
      "end_ms": 245097,
      "text": "云冷，今宵我告别了活泼的心，像下沉掉。"
    },
    {
      "ordinal": 20,
      "start_ms": 245577,
      "end_ms": 250537,
      "text": "梦里有他，又计微妙，情怎可料？"
    },
    {
      "ordinal": 21,
      "start_ms": 252057,
      "end_ms": 270137,
      "text": "全是你一心轻佻，无情地把我当玩笑，让这颗心渐渐透掉，情也没掉。快一点啊！"
    },
    {
      "ordinal": 22,
      "start_ms": 270297,
      "end_ms": 273737,
      "text": "丢，演唱会的时候就喜欢玩这种"
    },
    {
      "ordinal": 23,
      "start_ms": 275897,
      "end_ms": 280057,
      "text": "稀奇古怪的、花里胡哨的，太糟糕。"
    },
    {
      "ordinal": 24,
      "start_ms": 281897,
      "end_ms": 285177,
      "text": "我管了，啊，就是他妈唱低音来唱了。"
    },
    {
      "ordinal": 25,
      "start_ms": 287257,
      "end_ms": 288377,
      "text": "还有一个是吧？"
    },
    {
      "ordinal": 26,
      "start_ms": 290137,
      "end_ms": 292777,
      "text": "啦啦啦之歌，又要人唱啦啦啦之歌。"
    },
    {
      "ordinal": 27,
      "start_ms": 308697,
      "end_ms": 310697,
      "text": "来来来，这个封一封啊！"
    },
    {
      "ordinal": 28,
      "start_ms": 311097,
      "end_ms": 314297,
      "text": "这个这个这个什么回形针、paper clips啊？"
    },
    {
      "ordinal": 29,
      "start_ms": 315017,
      "end_ms": 316697,
      "text": "你有资格给我？"
    },
    {
      "ordinal": 30,
      "start_ms": 316697,
      "end_ms": 319497,
      "text": "的妈的，叫什么？"
    },
    {
      "ordinal": 31,
      "start_ms": 319897,
      "end_ms": 324617,
      "text": "指手画脚，还什么可以的？可以怎么样啊？"
    },
    {
      "ordinal": 32,
      "start_ms": 324777,
      "end_ms": 327577,
      "text": "我就不去看，我觉得你low，拜拜。哈哈。"
    },
    {
      "ordinal": 33,
      "start_ms": 328377,
      "end_ms": 348697,
      "text": "又要唱这首歌。"
    },
    {
      "ordinal": 34,
      "start_ms": 388376,
      "end_ms": 396536,
      "text": "沧海一声笑，滔滔两岸潮。"
    },
    {
      "ordinal": 35,
      "start_ms": 396536,
      "end_ms": 402664,
      "text": "浮沉随浪知几今朝。"
    },
    {
      "ordinal": 36,
      "start_ms": 403176,
      "end_ms": 415256,
      "text": "苍天笑，纷纷世上潮。谁负谁先错？天知晓。"
    },
    {
      "ordinal": 37,
      "start_ms": 415256,
      "end_ms": 420616,
      "text": "江山笑，烟雨遥。"
    },
    {
      "ordinal": 38,
      "start_ms": 421096,
      "end_ms": 430936,
      "text": "头棱头尽红尘浊世几多娇。"
    },
    {
      "ordinal": 39,
      "start_ms": 430936,
      "end_ms": 439976,
      "text": "清风笑，景野寂寥。"
    },
    {
      "ordinal": 40,
      "start_ms": 440136,
      "end_ms": 445656,
      "text": "后前还剩了一更晚照。"
    },
    {
      "ordinal": 41,
      "start_ms": 446136,
      "end_ms": 452172,
      "text": "沧桑笑，不再寂寥。"
    },
    {
      "ordinal": 42,
      "start_ms": 452600,
      "end_ms": 459016,
      "text": "后前仍执痴痴笑笑。"
    },
    {
      "ordinal": 43,
      "start_ms": 459016,
      "end_ms": 552649,
      "text": "啦好的，这两首。"
    }
  ],
