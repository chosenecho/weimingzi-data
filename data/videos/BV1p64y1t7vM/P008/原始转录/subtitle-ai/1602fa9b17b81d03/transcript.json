  "segments": [
    {
      "ordinal": 0,
      "start_ms": 120,
      "end_ms": 4180,
      "text": "啊感觉我看你知道不爽"
    },
    {
      "ordinal": 1,
      "start_ms": 5580,
      "end_ms": 12200,
      "text": "呜呜我有力气很远"
    },
    {
      "ordinal": 2,
      "start_ms": 14419,
      "end_ms": 16779,
      "text": "我在开车的时候都能唱上去"
    },
    {
      "ordinal": 3,
      "start_ms": 16779,
      "end_ms": 18279,
      "text": "但是为什么坐到这里"
    },
    {
      "ordinal": 4,
      "start_ms": 18279,
      "end_ms": 19419,
      "text": "我就是唱不上去的"
    },
    {
      "ordinal": 5,
      "start_ms": 19419,
      "end_ms": 20499,
      "text": "因为我不够皮"
    },
    {
      "ordinal": 6,
      "start_ms": 20499,
      "end_ms": 21540,
      "text": "你知道吗"
    },
    {
      "ordinal": 7,
      "start_ms": 21880,
      "end_ms": 24180,
      "text": "他也他也庄重了"
    },
    {
      "ordinal": 8,
      "start_ms": 27640,
      "end_ms": 29280,
      "text": "我放松呀"
    },
    {
      "ordinal": 9,
      "start_ms": 31580,
      "end_ms": 33280,
      "text": "不要问"
    },
    {
      "ordinal": 10,
      "start_ms": 33280,
      "end_ms": 35020,
      "text": "不要说"
    },
    {
      "ordinal": 11,
      "start_ms": 35020,
      "end_ms": 38350,
      "text": "一切尽在不言中"
    },
    {
      "ordinal": 12,
      "start_ms": 38350,
      "end_ms": 41819,
      "text": "这一刻围着烛光"
    },
    {
      "ordinal": 13,
      "start_ms": 41819,
      "end_ms": 44939,
      "text": "让我们静静的渡过"
    },
    {
      "ordinal": 14,
      "start_ms": 44939,
      "end_ms": 46589,
      "text": "莫挥手"
    },
    {
      "ordinal": 15,
      "start_ms": 46589,
      "end_ms": 48220,
      "text": "莫回头"
    },
    {
      "ordinal": 16,
      "start_ms": 48220,
      "end_ms": 51490,
      "text": "当我唱起这首歌"
    },
    {
      "ordinal": 17,
      "start_ms": 51490,
      "end_ms": 56559,
      "text": "怕只怕泪水轻轻地滑落"
    },
    {
      "ordinal": 18,
      "start_ms": 58180,
      "end_ms": 63680,
      "text": "愿心中永远留着我的笑容"
    },
    {
      "ordinal": 19,
      "start_ms": 64900,
      "end_ms": 69940,
      "text": "伴你走过每一个春夏秋冬"
    },
    {
      "ordinal": 20,
      "start_ms": 71520,
      "end_ms": 74720,
      "text": "几许愁几许忧"
    },
    {
      "ordinal": 21,
      "start_ms": 74720,
      "end_ms": 77990,
      "text": "人生难免苦与痛"
    },
    {
      "ordinal": 22,
      "start_ms": 77990,
      "end_ms": 84610,
      "text": "失去过才能真正懂得去珍惜和拥有"
    },
    {
      "ordinal": 23,
      "start_ms": 84610,
      "end_ms": 85210,
      "text": "情"
    },
    {
      "ordinal": 24,
      "start_ms": 85210,
      "end_ms": 87850,
      "text": "难舍人难留"
    },
    {
      "ordinal": 25,
      "start_ms": 87850,
      "end_ms": 89830,
      "text": "今朝一别"
    },
    {
      "ordinal": 26,
      "start_ms": 89830,
      "end_ms": 92760,
      "text": "各西东冷和热"
    },
    {
      "ordinal": 27,
      "start_ms": 92760,
      "end_ms": 96200,
      "text": "点点滴滴在心头"
    },
    {
      "ordinal": 28,
      "start_ms": 97900,
      "end_ms": 103420,
      "text": "愿心中永远留着我的笑容"
    },
    {
      "ordinal": 29,
      "start_ms": 104480,
      "end_ms": 109460,
      "text": "伴你走过每一个春夏秋冬"
    },
    {
      "ordinal": 30,
      "start_ms": 111100,
      "end_ms": 113140,
      "text": "伤离别"
    },
    {
      "ordinal": 31,
      "start_ms": 114580,
      "end_ms": 117870,
      "text": "离别虽然在眼前"
    },
    {
      "ordinal": 32,
      "start_ms": 117870,
      "end_ms": 119679,
      "text": "说再见"
    },
    {
      "ordinal": 33,
      "start_ms": 121000,
      "end_ms": 124380,
      "text": "再见不会太遥远"
    },
    {
      "ordinal": 34,
      "start_ms": 124380,
      "end_ms": 126060,
      "text": "若有缘"
    },
    {
      "ordinal": 35,
      "start_ms": 126060,
      "end_ms": 133370,
      "text": "有缘就能期待明天你和我重逢"
    },
    {
      "ordinal": 36,
      "start_ms": 133370,
      "end_ms": 137240,
      "text": "在灿烂的季节"
    },
    {
      "ordinal": 37,
      "start_ms": 141700,
      "end_ms": 142960,
      "text": "感觉有点流氓"
    },
    {
      "ordinal": 38,
      "start_ms": 142960,
      "end_ms": 143740,
      "text": "感觉"
    },
    {
      "ordinal": 39,
      "start_ms": 171059,
      "end_ms": 172940,
      "text": "伤离别"
    },
    {
      "ordinal": 40,
      "start_ms": 174420,
      "end_ms": 180970,
      "text": "离别虽然在眼前说再见嗯"
    },
    {
      "ordinal": 41,
      "start_ms": 180970,
      "end_ms": 184270,
      "text": "再见不会太遥远"
    },
    {
      "ordinal": 42,
      "start_ms": 184270,
      "end_ms": 193070,
      "text": "若有缘有缘就能期待明天你和我重逢"
    },
    {
      "ordinal": 43,
      "start_ms": 193070,
      "end_ms": 196480,
      "text": "在灿烂的季节"
    },
    {
      "ordinal": 44,
