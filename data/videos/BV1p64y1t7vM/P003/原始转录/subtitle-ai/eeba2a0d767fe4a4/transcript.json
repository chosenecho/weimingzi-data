{
  "bvid": "BV1p64y1t7vM",
  "page": 3,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "eeba2a0d767fe4a4d08120c92077b63d7fc53422f8cbf5b9ce330fabfc41c3b9",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 1660,
      "end_ms": 3679,
      "text": "梅艳芳的太低了"
    },
    {
      "ordinal": 1,
      "start_ms": 19840,
      "end_ms": 21930,
      "text": "同是过路"
    },
    {
      "ordinal": 2,
      "start_ms": 21930,
      "end_ms": 23820,
      "text": "同做过梦"
    },
    {
      "ordinal": 3,
      "start_ms": 23820,
      "end_ms": 26439,
      "text": "本应是一对"
    },
    {
      "ordinal": 4,
      "start_ms": 26439,
      "end_ms": 35040,
      "text": "当当当当人在少年中不觉醒后要归去"
    },
    {
      "ordinal": 5,
      "start_ms": 35500,
      "end_ms": 39540,
      "text": "三餐一宿也共一双"
    },
    {
      "ordinal": 6,
      "start_ms": 39540,
      "end_ms": 42839,
      "text": "到底会是谁"
    },
    {
      "ordinal": 7,
      "start_ms": 43400,
      "end_ms": 45430,
      "text": "但凡没得到"
    },
    {
      "ordinal": 8,
      "start_ms": 45430,
      "end_ms": 52460,
      "text": "但凡是过去总是最登对台下"
    },
    {
      "ordinal": 9,
      "start_ms": 52460,
      "end_ms": 59830,
      "text": "你望台看我做你想做的喜情"
    },
    {
      "ordinal": 10,
      "start_ms": 59830,
      "end_ms": 61400,
      "text": "是故人"
    },
    {
      "ordinal": 11,
      "start_ms": 61680,
      "end_ms": 69020,
      "text": "有点你可曾记得起欢喜伤悲"
    },
    {
      "ordinal": 12,
      "start_ms": 69020,
      "end_ms": 70970,
      "text": "老病生死"
    },
    {
      "ordinal": 13,
      "start_ms": 70970,
      "end_ms": 75390,
      "text": "说不上传奇恨"
    },
    {
      "ordinal": 14,
      "start_ms": 75390,
      "end_ms": 78300,
      "text": "台上卿卿或台上我"
    },
    {
      "ordinal": 15,
      "start_ms": 78300,
      "end_ms": 79920,
      "text": "我不是"
    },
    {
      "ordinal": 16,
      "start_ms": 79920,
      "end_ms": 84700,
      "text": "我跟你作尘渺渺"
    },
    {
      "ordinal": 17,
      "start_ms": 84700,
      "end_ms": 86680,
      "text": "天意茫茫"
    },
    {
      "ordinal": 18,
      "start_ms": 86680,
      "end_ms": 89420,
      "text": "将你共我分开"
    },
    {
      "ordinal": 19,
      "start_ms": 90500,
      "end_ms": 93460,
      "text": "断肠指点点风雨"
    },
    {
      "ordinal": 20,
      "start_ms": 93460,
      "end_ms": 97720,
      "text": "心灵里死是故意来"
    },
    {
      "ordinal": 21,
      "start_ms": 98360,
      "end_ms": 102400,
      "text": "何日再在何地再聚"
    },
    {
      "ordinal": 22,
      "start_ms": 102400,
      "end_ms": 105020,
      "text": "说今夜真暖"
    },
    {
      "ordinal": 23,
      "start_ms": 106180,
      "end_ms": 110250,
      "text": "无份有缘回忆不断"
    },
    {
      "ordinal": 24,
      "start_ms": 110250,
      "end_ms": 112960,
      "text": "生命却苦短"
    },
    {
      "ordinal": 25,
      "start_ms": 114040,
      "end_ms": 116070,
      "text": "一种相思"
    },
    {
      "ordinal": 26,
      "start_ms": 116070,
      "end_ms": 123970,
      "text": "两段苦恋本身说无缘在年月深渊"
    },
    {
      "ordinal": 27,
      "start_ms": 123970,
      "end_ms": 125080,
      "text": "望明月"
    },
    {
      "ordinal": 28,
      "start_ms": 125080,
      "end_ms": 128620,
      "text": "远远相信你有缘"
    },
    {
      "ordinal": 29,
      "start_ms": 142400,
      "end_ms": 145360,
      "text": "想象你忧忧郁啊"
    },
    {
      "ordinal": 30,
      "start_ms": 146660,
      "end_ms": 147880,
      "text": "歌词弄错了"
    },
    {
      "ordinal": 31,
      "start_ms": 147880,
      "end_ms": 148990,
      "text": "不是想象你优越"
    },
    {
      "ordinal": 32,
      "start_ms": 148990,
      "end_ms": 150260,
      "text": "想象你优越"
    },
    {
      "ordinal": 33,
      "start_ms": 161240,
      "end_ms": 163210,
      "text": "昨尘渺渺"
    },
    {
      "ordinal": 34,
      "start_ms": 163210,
      "end_ms": 165190,
      "text": "天意茫茫"
    },
    {
      "ordinal": 35,
      "start_ms": 165190,
      "end_ms": 168500,
      "text": "将你共我分开"
    },
    {
      "ordinal": 36,
      "start_ms": 169020,
      "end_ms": 171050,
      "text": "断肠自丁丁"
    },
    {
      "ordinal": 37,
      "start_ms": 171050,
      "end_ms": 173030,
      "text": "风雨心凛凛"
    },
    {
      "ordinal": 38,
      "start_ms": 173030,
      "end_ms": 178460,
      "text": "只是故人来留下你"
    },
    {
      "ordinal": 39,
      "start_ms": 178460,
      "end_ms": 184260,
      "text": "或留下我在世间上终老"
    },
    {
      "ordinal": 40,
      "start_ms": 184740,
      "end_ms": 185900,
      "text": "离别"
    },
    {
      "ordinal": 41,
      "start_ms": 185900,
      "end_ms": 187820,
      "text": "以前未知"
    },
    {
      "ordinal": 42,
      "start_ms": 187820,
      "end_ms": 189860,
      "text": "相对当日"
    },
    {
      "ordinal": 43,
      "start_ms": 189860,
      "end_ms": 190880,
      "text": "那么"
    },
    {
      "ordinal": 44,
      "start_ms": 192520,
      "end_ms": 196500,
      "text": "知知指手铐有分手"
    },
    {
      "ordinal": 45,
      "start_ms": 196500,
      "end_ms": 199920,
      "text": "爱得有还无"
    },
    {
      "ordinal": 46,
      "start_ms": 200380,
      "end_ms": 203520,
      "text": "10年后双双万年后"
    },
    {
      "ordinal": 47,
      "start_ms": 203520,
      "end_ms": 207020,
      "text": "对对只恨看不到"
    },
    {
      "ordinal": 48,
      "start_ms": 208279,
      "end_ms": 219180,
      "text": "10年后双双万年后对对只恨看不到不"
    },
    {
      "ordinal": 49,
      "start_ms": 229540,
      "end_ms": 231540,
      "text": "啊对"
    },
    {
      "ordinal": 50,
      "start_ms": 238499,
      "end_ms": 239680,
      "text": "啊不好意思啊"
    }
  ],
  "text": "梅艳芳的太低了\n同是过路\n同做过梦\n本应是一对\n当当当当人在少年中不觉醒后要归去\n三餐一宿也共一双\n到底会是谁\n但凡没得到\n但凡是过去总是最登对台下\n你望台看我做你想做的喜情\n是故人\n有点你可曾记得起欢喜伤悲\n老病生死\n说不上传奇恨\n台上卿卿或台上我\n我不是\n我跟你作尘渺渺\n天意茫茫\n将你共我分开\n断肠指点点风雨\n心灵里死是故意来\n何日再在何地再聚\n说今夜真暖\n无份有缘回忆不断\n生命却苦短\n一种相思\n两段苦恋本身说无缘在年月深渊\n望明月\n远远相信你有缘\n想象你忧忧郁啊\n歌词弄错了\n不是想象你优越\n想象你优越\n昨尘渺渺\n天意茫茫\n将你共我分开\n断肠自丁丁\n风雨心凛凛\n只是故人来留下你\n或留下我在世间上终老\n离别\n以前未知\n相对当日\n那么\n知知指手铐有分手\n爱得有还无\n10年后双双万年后\n对对只恨看不到\n10年后双双万年后对对只恨看不到不\n啊对\n啊不好意思啊",
  "timing_issue": null
}
