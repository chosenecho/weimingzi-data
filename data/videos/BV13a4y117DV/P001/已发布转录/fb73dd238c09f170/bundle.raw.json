{"segments":[{"start":1.1,"end":1.52,"text":"你好"},{"start":1.52,"end":4.25,"text":"我最近遭遇到一些有关周易的问题"},{"start":4.25,"end":5.57,"text":"哲学水平不高"},{"start":5.57,"end":7.25,"text":"求求求一些帮助"},{"start":7.25,"end":10.89,"text":"本人一位朋友在接触易学之后"},{"start":10.89,"end":12.33,"text":"国学用于算命"},{"start":12.33,"end":14.1,"text":"去见了一位相关人士"},{"start":14.1,"end":17.57,"text":"这位人士把周易通俗的解释为一部剧本"},{"start":17.57,"end":19.07,"text":"每个人都是用剧本表演"},{"start":19.07,"end":21.18,"text":"虽然拿到的剧本"},{"start":21.18,"end":23.46,"text":"但是依旧可以在演出过程中获得"},{"start":23.46,"end":26.46,"text":"不同的情感体验与生命体验"},{"start":26.46,"end":28.08,"text":"因此从这个角度来讲"},{"start":28.08,"end":29.52,"text":"周易不是用来算命的"},{"start":29.52,"end":30.96,"text":"可以帮更好的生活"},{"start":30.96,"end":32.31,"text":"只有沉迷于算命"},{"start":32.31,"end":34.44,"text":"其实歪曲了周易的本意"},{"start":34.44,"end":36.24,"text":"现在朋友沉迷其中"},{"start":36.24,"end":37.44,"text":"那就不要跟他做朋友"},{"start":37.44,"end":38.64,"text":"当他是啊"},{"start":38.64,"end":41.94,"text":"他现在用卦象来解释我和他之关系"},{"start":41.94,"end":43.56,"text":"以及性格接待人生道路"},{"start":43.56,"end":46.2,"text":"并且解释一切社会发生的现象"},{"start":46.2,"end":47.97,"text":"什么他说什么"},{"start":47.97,"end":49.14,"text":"如何看待马克思主义"},{"start":49.14,"end":51.8,"text":"他认为马克思主义是易经具象化"},{"start":51.8,"end":52.88,"text":"理由如下"},{"start":52.88,"end":54.2,"text":"什么易经的原理"},{"start":54.2,"end":55.04,"text":"天象什么"},{"start":55.04,"end":59.879,"text":"人类构成了社会主体"},{"start":59.879,"end":62.489,"text":"人的力量没法跟天体比较"},{"start":62.489,"end":65.849,"text":"人类什么引力比天地要小什么"},{"start":65.849,"end":68.82,"text":"所以人都可以被物化"},{"start":68.82,"end":75.64,"text":"被易经代码化解释易经就可以预测了"},{"start":82.66,"end":87.86,"text":"说是什么气运什么什么什么什么好好好"},{"start":87.86,"end":89.75,"text":"然后说他无法接受这种解释"},{"start":89.75,"end":91.31,"text":"否认命的存在"},{"start":91.31,"end":94.73,"text":"并认为每个人都是自由的"},{"start":99.46,"end":102.0,"text":"一个人的人生应当由其实践活动决定"},{"start":102.0,"end":104.25,"text":"他认为这套理论有宿命论的成分在"},{"start":104.25,"end":107.99,"text":"但是本人哲学水平不足以支撑自己的观点"},{"start":108.07,"end":109.93,"text":"你不需要用哲学支撑"},{"start":109.93,"end":112.1,"text":"你用信念支撑就行了"},{"start":112.1,"end":113.69,"text":"你就当他放屁"},{"start":113.69,"end":114.86,"text":"跟他远离"},{"start":114.86,"end":116.54,"text":"当他在拉屎不就行了"},{"start":116.54,"end":119.13,"text":"在拉了自己吃屎"},{"start":120.01,"end":122.67,"text":"什么他看过我的什么主意主意"},{"start":122.67,"end":126.47,"text":"二杠二杠三和二杠二杠三杠一"},{"start":126.75,"end":130.25,"text":"他说易经不是让什么人民按照他的描述去运行"},{"start":130.25,"end":131.81,"text":"只是推测个人与我"},{"start":131.81,"end":135.45,"text":"从来没有说易经是推测个人和国家发展的趋势"},{"start":135.45,"end":136.71,"text":"什么吊东西啊"},{"start":136.71,"end":137.85,"text":"看老子视频"},{"start":137.85,"end":139.72,"text":"看到狗肚子里去了"},{"start":139.72,"end":140.98,"text":"就我个人而言"},{"start":140.98,"end":143.86,"text":"在某种程度上可以理解视频中的一些观点"},{"start":143.86,"end":146.8,"text":"但是他已经陷入到他朋友的预测中了"},{"start":146.8,"end":151.66,"text":"他他和他的那个朋友和相关人士进行大量实验"},{"start":151.66,"end":153.98,"text":"结果十分精准"},{"start":153.98,"end":159.69,"text":"你在做广告吧啊这个现象让他陷入怀疑"},{"start":159.69,"end":160.47,"text":"结果十分精准"},{"start":160.47,"end":161.49,"text":"大姐去搞吧"},{"start":161.49,"end":162.87,"text":"本人是准大学生"},{"start":162.87,"end":164.67,"text":"是典型中产阶级家庭"},{"start":164.67,"end":165.45,"text":"眼界不广"},{"start":165.45,"end":168.43,"text":"没有太多社会经实践经历"},{"start":168.43,"end":172.73,"text":"对外部了解很大一部分来自什么什么"},{"start":173.01,"end":176.71,"text":"没看过太多较深奥的哲学书籍"},{"start":176.71,"end":179.89,"text":"也算不上是一个唯物主义者或马克思主义者"},{"start":179.89,"end":182.43,"text":"只是对马克思主义原理有了解"},{"start":182.43,"end":185.49,"text":"他的行为导致我出现了一定程度上信仰危机"},{"start":185.49,"end":186.39,"text":"他想反驳他朋友"},{"start":186.39,"end":187.86,"text":"另外原因比较庸俗"},{"start":187.86,"end":190.48,"text":"他认为就是那个人算命算出来说"},{"start":190.48,"end":192.85,"text":"他读博的时候无法得到满意的结果"},{"start":192.85,"end":194.32,"text":"他想掌握自己的命运"},{"start":194.32,"end":198.91,"text":"但他但他现在对写信人想掌握自己命运"},{"start":198.91,"end":202.329,"text":"但是他对现在这种情况手足无措"},{"start":202.329,"end":204.429,"text":"什么都充满了焦虑与疑惑"},{"start":204.429,"end":206.95,"text":"希望能一些建议和帮助"},{"start":206.95,"end":208.39,"text":"我的建议和帮助"},{"start":208.39,"end":209.83,"text":"就是你不要焦虑和疑惑"},{"start":209.83,"end":211.99,"text":"你当他在放屁"},{"start":213.66,"end":215.8,"text":"你充满了教育和疑惑"},{"start":215.8,"end":218.08,"text":"在我看来都是没有根据的"},{"start":218.08,"end":219.1,"text":"没有根据的焦虑"},{"start":219.1,"end":220.21,"text":"没有根据的疑惑"},{"start":220.21,"end":223.0,"text":"我的建议就是说我就命令你执行这个命令"},{"start":223.0,"end":223.6,"text":"不要焦虑"},{"start":223.6,"end":224.26,"text":"不要疑惑"},{"start":224.26,"end":225.58,"text":"执行这个命令"},{"start":228.08,"end":231.6,"text":"你能不能执行这个这个我给给你下的命令"},{"start":232.06,"end":232.86,"text":"很荒谬"},{"start":232.86,"end":233.16,"text":"对不对"},{"start":233.16,"end":235.73,"text":"你为什么要执行别人给你下达命令"},{"start":235.73,"end":238.25,"text":"你该疑惑该该疑惑疑惑"},{"start":238.25,"end":239.15,"text":"该焦虑焦虑"},{"start":239.15,"end":241.67,"text":"为什么别人说的一番话就会引起你的疑惑"},{"start":241.67,"end":242.39,"text":"引起你的焦虑"},{"start":242.39,"end":242.81,"text":"很荒谬"},{"start":242.81,"end":243.69,"text":"对不对"},{"start":243.69,"end":244.71,"text":"我给你下命令"},{"start":244.71,"end":245.67,"text":"你不允许这样做"},{"start":245.67,"end":247.11,"text":"那个B给你下了命令"},{"start":247.11,"end":249.33,"text":"下了心理学暗示说你要焦虑"},{"start":249.33,"end":250.14,"text":"你要疑惑"},{"start":250.14,"end":251.38,"text":"你会过不好"},{"start":251.38,"end":252.46,"text":"一样的呀"},{"start":253.9,"end":255.04,"text":"你不会执行我的命令"},{"start":255.04,"end":256.48,"text":"你也不会执行他的命令"},{"start":256.48,"end":257.289,"text":"对不对"},{"start":257.289,"end":258.829,"text":"你是奴才吗"},{"start":258.829,"end":260.72,"text":"你是他鞭子下的畜生吗"},{"start":260.72,"end":262.25,"text":"是不是你自己问一问"},{"start":262.25,"end":263.03,"text":"问一问你自己"},{"start":263.03,"end":263.63,"text":"你是奴才"},{"start":263.63,"end":264.92,"text":"你是他鞭子下的畜生吗"},{"start":264.92,"end":265.7,"text":"是吗"},{"start":265.7,"end":266.57,"text":"不是呀"},{"start":266.57,"end":267.98,"text":"你是我的奴才吗"},{"start":267.98,"end":269.78,"text":"你是我鞭子下的畜生吗"},{"start":269.78,"end":271.13,"text":"不是的呀"},{"start":271.13,"end":273.56,"text":"是就是是不是就是不是"},{"start":273.56,"end":275.97,"text":"他说的话跟你做的事情没有关系"},{"start":275.97,"end":279.42,"text":"你遭遇到的事情也跟他说的话也没有关系"},{"start":279.42,"end":281.34,"text":"跟他做的什么吊毛预测没有关系"},{"start":281.34,"end":283.2,"text":"这两本来就不搭界的东西"},{"start":283.2,"end":285.18,"text":"除非你是说自己做错了事"},{"start":285.18,"end":287.179,"text":"要赖皮怪到别人身上去"},{"start":287.9,"end":288.73,"text":"对不对"},{"start":288.73,"end":291.06,"text":"自己拿到点好处"},{"start":291.06,"end":294.03,"text":"不认为不相信是自己努力获得的"},{"start":294.03,"end":295.65,"text":"要要要要要怪到别人"},{"start":295.65,"end":301.02,"text":"要要算到别人头上去一阵下一个"}],"source":"subtitle"}
