{"segments":[{"start":0.18,"end":2.82,"text":"而且这些人肯定是会分裂的"},{"start":2.82,"end":5.34,"text":"他们就是归根结理念是不不同的嘛"},{"start":5.34,"end":7.88,"text":"有的是在劳动过程中受欺负了"},{"start":7.88,"end":8.7,"text":"极进化的"},{"start":10.36,"end":11.24,"text":"对不对"},{"start":11.24,"end":13.8,"text":"有的是是怀念他以前那个日子"},{"start":13.8,"end":15.2,"text":"那个以后以前禁欲主义"},{"start":15.2,"end":18.08,"text":"保守的那个等级制的那个日子"},{"start":18.08,"end":19.41,"text":"那这也是极有"},{"start":19.41,"end":21.91,"text":"然后有的是这个中右翼这些小商人"},{"start":21.91,"end":24.26,"text":"小摊贩或者小小妇人"},{"start":24.26,"end":27.7,"text":"他拿来这个给自己这个赎罪券"},{"start":27.7,"end":29.18,"text":"心里心安理得一点"},{"start":29.18,"end":29.68,"text":"赚到钱"},{"start":29.68,"end":30.58,"text":"心安理得享受"},{"start":30.58,"end":31.79,"text":"心安理得一点"},{"start":31.79,"end":33.57,"text":"那有的是中左翼的"},{"start":33.57,"end":36.19,"text":"他想要以这种这种温和的方式"},{"start":36.19,"end":39.87,"text":"这种旅游的方式才能实现它的那个秘密串联"},{"start":39.87,"end":43.13,"text":"他不想直接的就去嗯"},{"start":43.13,"end":45.29,"text":"然后这个钟左翼的秘密串联了之后"},{"start":45.29,"end":48.81,"text":"他又和西方什么自由势力啊啊策应啊"},{"start":48.81,"end":49.99,"text":"策应一下"},{"start":49.99,"end":51.39,"text":"说乱起来上街了"},{"start":51.39,"end":53.03,"text":"他策应一下啊"},{"start":53.03,"end":54.62,"text":"他自己可能不上街"},{"start":54.62,"end":56.02,"text":"就这就这些东西嘛"},{"start":56.02,"end":59.57,"text":"他可能我说这四个四派人全在里面"},{"start":59.57,"end":61.43,"text":"然后这是一个共享的旗号"},{"start":61.43,"end":63.21,"text":"这个旗号反正就不会直接给你打掉"},{"start":63.21,"end":64.65,"text":"因为这打掉太难看了啊"},{"start":64.65,"end":68.23,"text":"那不是这个否认了这个建国的价值的基础嘛"},{"start":68.23,"end":70.1,"text":"核心嘛是吧"},{"start":70.58,"end":71.36,"text":"懂了吧"},{"start":71.36,"end":73.22,"text":"就各怀鬼胎"},{"start":73.22,"end":74.62,"text":"这里面"},{"start":77.32,"end":79.92,"text":"然后这这当中有一些是共同点吧"},{"start":79.92,"end":82.13,"text":"比如说找最穷的人去"},{"start":82.13,"end":87.24,"text":"就是直接的去所谓实践去帮帮到这些最穷的人"},{"start":87.24,"end":89.12,"text":"那么这四四类人的话"},{"start":89.12,"end":92.38,"text":"我看这四类人当中"},{"start":100.79,"end":103.51,"text":"