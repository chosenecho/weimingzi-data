art":397.14,"end":398.32,"text":"是宗教关系啊"},{"start":398.32,"end":399.12,"text":"来解释这个东西"},{"start":399.12,"end":400.06,"text":"那么极右翼呢"},{"start":400.06,"end":400.92,"text":"极右翼"},{"start":400.92,"end":403.79,"text":"其实极右翼其实是"},{"start":403.79,"end":408.05,"text":"他不是说希望由政府来行政力量来干涉"},{"start":408.05,"end":413.1,"text":"来设置一个一种设置一种那种啊包办一切"},{"start":413.1,"end":414.14,"text":"把一切问题都解决"},{"start":414.14,"end":418.59,"text":"把市场的资本主义的一切的弊弊端都消弭掉"},{"start":418.59,"end":420.91,"text":"所谓的极右翼拥抱绝对专制"},{"start":420.91,"end":421.35,"text":"不是的"},{"start":421.35,"end":422.29,"text":"极右翼是这样的"},{"start":422.29,"end":424.05,"text":"极右翼是要天经地义"},{"start":424.05,"end":424.92,"text":"你知道吗"},{"start":424.92,"end":429.7,"text":"他不需要行政力量来实现某种介入性的专制"},{"start":429.7,"end":430.82,"text":"极右翼认为"},{"start":430.82,"end":431.34,"text":"就是说"},{"start":431.34,"end":432.82,"text":"所有人的思想观念"},{"start":432.82,"end":437.05,"text":"应当就是恢复一种天经地义的等级制"},{"start":437.05,"end":438.59,"text":"这个天经地义的等级制"},{"start":438.59,"end":440.13,"text":"等级制是道德伦理"},{"start":440.13,"end":441.45,"text":"意识形态层面的"},{"start":441.45,"end":442.91,"text":"是就是就是对的"},{"start":442.91,"end":444.22,"text":"就就懂吗"},{"start":444.22,"end":446.54,"text":"然后你政府只是这个绝对正确的"},{"start":446.54,"end":449.27,"text":"这个等级制的执行者"},{"start":449.87,"end":450.63,"text":"刘该"},{"start":452.79,"end":454.03,"text":"明白吧"},{"start":455.299,"end":457.679,"text":"他可能是某某种教"},{"start":457.679,"end":459.099,"text":"也可能某种圣人崇拜"},{"start":459.099,"end":460.499,"text":"在这个圣人崇拜之下"},{"start":460.499,"end":461.77,"text":"谁离圣人最近"},{"start":461.77,"end":463.15,"text":"谁就是更牛逼的"},{"start":463.15,"end":465.69,"text":"或者谁谁是圣人给他打的旗号"},{"start":465.69,"end":466.57,"text":"他就是最牛逼的"},{"start":466.57,"end":470.07,"text":"所以极右翼等级制原教旨的这个呃"},{"start":471.43,"end":473.81,"text":"原教我们国家的原教旨主义"},{"start":473.81,"end":476.77,"text":"你这它就是一种极右翼等级制"},{"start":478.43,"end":479.85,"text":"它是一种极右翼等级制"},{"start":479.85,"end":483.11,"text":"他在最底层的那个平民贫穷的贫"},{"start":483.11,"end":485.51,"text":"在最底层平民的那个思想观念"},{"start":485.51,"end":485.71,"text":"都"},{"start":485.71,"end":489.03,"text":"尤其是农村的保守的宗族秩序下"},{"start":489.03,"end":490.27,"text":"那些平民的思想观念里面"},{"start":490.27,"end":494.94,"text":"这个就是就是谁离这个他偶像崇拜的"},{"start":494.94,"end":496.38,"text":"或神话的那个对象最近"},{"start":497.42,"end":501.42,"text":"谁就就是分享他的那个教拳神拳"},{"start":501.42,"end":504.04,"text":"那个逐次衰减下来"},{"start":504.04,"end":506.7,"text":"那那他作为一个民间的狂信者"},{"start":506.7,"end":508.66,"text":"他只要够纯正够纯洁"},{"start":508.66,"end":511.35,"text":"那他也可以分有这样一种神性"},{"start":511.35,"end":515.629,"text":"所以他只有乙understand嗯"},{"start":516.789,"end":519.089,"text":"他是你可以理解这是儒教变种嘛"},{"start":519.089,"end":523.9,"text":"他这是儒教变种没多大差别的儒教变种"},{"start":526.94,"end":529.31,"text":"他明白吗"},{"start":529.31,"end":531.37,"text":"你比如说那个江西"},{"start":531.37,"end":532.89,"text":"江西的一些地方"},{"start":532.89,"end":536.87,"text":"就是把这个相当这个神像的供奉呢"},{"start":536.87,"end":539.87,"text":"你说这些东西是真的是什么"},{"start":539.87,"end":541.15,"text":"这已经是宗教了"},{"start":541.15,"end":541.71,"text":"你知道吗"},{"start":541.71,"end":542.87,"text":"前线的宗教"},{"start":542.87,"end":543.51,"text":"极右翼"},{"start":543.51,"end":544.25,"text":"前线的宗教"},{"start":544.25,"end":545.19,"text":"他就觉得这个东西"},{"start":545.19,"end":546.91,"text":"这不是政府介入不介入的东西"},{"start":546.91,"end":551.48,"text":"但是就是说他是直直接穿透到狂信徒的"},{"start":551.48,"end":553.97,"text":"他的所谓的平信图"},{"start":553.97,"end":556.67,"text":"没有任何这个呃"},{"start":556.67,"end":560.75,"text":"没有任何教师集团的那个头衔和等级"},{"start":560.75,"end":563.27,"text":"身份的的平信徒"},{"start":570.96,"end":575.2,"text":"嗯所以极右翼在等级制在天然等级之下啊"},{"start":575.2,"end":578.6,"text":"极右翼的等级是天然等级制是宗教"},{"start":578.6,"end":579.96,"text":"宗教神权性质"},{"start":579.96,"end":582.52,"text":"覆盖全全真全宇宙的"},{"start":582.52,"end":582.96,"text":"你知道吗"},{"start":582.96,"end":583.84,"text":"全宇宙"},{"start":583.84,"end":584.64,"text":"全人类"},{"start":584.64,"end":585.08,"text":"全宇宙"},{"start":585.08,"end":588.79,"text":"全社会一切的一个一个神权等级制下面"},{"start":588.79,"end":590.74,"text":"他有自己的安稳的位置"},{"start":590.74,"end":592.74,"text":"然后这里面的政府"},{"start":592.74,"end":596.64,"text":"或者说具体的执行治理性的治理权利"},{"start":596.64,"end":598.49,"text":"就是民政权利"},{"start":598.49,"end":602.35,"text":"这些东西都是被反而是被看不起的"},{"start":602.35,"end":602.77,"text":"你知道吗"},{"start":602.77,"end":606.87,"text":"反而是反而在这种极右翼当中是反而是被骂的"},{"start":606.87,"end":609.2,"text":"说你腐败不对"},{"start":609.52,"end":612.12,"text":"不够圣圣洁啊"},{"start":612.12,"end":614.76,"text":"所以反而你就说极右翼的那个"},{"start":614.76,"end":616.76,"text":"你说的是集权专制吗"},{"start":616.76,"end":620.92,"text":"其实他这不不标准"},{"start":620.92,"end":624.9,"text":"他这个答案这种描述是不对的啊"},{"start":624.9,"end":627.16,"text":"我们这只能我们只能说他是个总体主义"},{"start":627.16,"end":629.42,"text":"然后这个里面的行政介入性权利"},{"start":629.42,"end":631.42,"text":"反而是在这个总体主义当中是比较"},{"start":631.42,"end":639.48,"text":"那个是是是会大家会默认他可能出错的"}],"source":"subtitle"}
