{
  "bvid": "BV1iV4y1w7VL",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "6e8b5f6b2d54d96f5c600241f715721910ad7ef8432a3eb7ca32dbb29a49167a",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 600,
      "end_ms": 1920,
      "text": "游戏结束了"
    },
    {
      "ordinal": 1,
      "start_ms": 1920,
      "end_ms": 5130,
      "text": "化石先生或者叫杨和平先生"
    },
    {
      "ordinal": 2,
      "start_ms": 5130,
      "end_ms": 6510,
      "text": "游戏结束了"
    },
    {
      "ordinal": 3,
      "start_ms": 6510,
      "end_ms": 7710,
      "text": "game over"
    },
    {
      "ordinal": 4,
      "start_ms": 7710,
      "end_ms": 8900,
      "text": "化石先生"
    },
    {
      "ordinal": 5,
      "start_ms": 9499,
      "end_ms": 10779,
      "text": "这位化石先生"
    },
    {
      "ordinal": 6,
      "start_ms": 10779,
      "end_ms": 14079,
      "text": "2017年在激烈网上发表一篇文章"
    },
    {
      "ordinal": 7,
      "start_ms": 14079,
      "end_ms": 16119,
      "text": "叫10月革命百年后的回响"
    },
    {
      "ordinal": 8,
      "start_ms": 16119,
      "end_ms": 18520,
      "text": "里面说什么啊"
    },
    {
      "ordinal": 9,
      "start_ms": 20240,
      "end_ms": 22840,
      "text": "那么非常巧合的是"
    },
    {
      "ordinal": 10,
      "start_ms": 22840,
      "end_ms": 28290,
      "text": "在啊2017年11月11日的时候啊"
    },
    {
      "ordinal": 11,
      "start_ms": 28290,
      "end_ms": 31020,
      "text": "这个激烈网和毛主席旗帜网"
    },
    {
      "ordinal": 12,
      "start_ms": 31020,
      "end_ms": 36560,
      "text": "召开了纪念10月革命100年的这个这个研讨会"
    },
    {
      "ordinal": 13,
      "start_ms": 36560,
      "end_ms": 39040,
      "text": "名字也叫10月革命百年后的回响"
    },
    {
      "ordinal": 14,
      "start_ms": 39300,
      "end_ms": 43560,
      "text": "这个研讨会里面记录了杨和平老师的发言"
    },
    {
      "ordinal": 15,
      "start_ms": 43560,
      "end_ms": 46120,
      "text": "的主要内容啊"
    },
    {
      "ordinal": 16,
      "start_ms": 47440,
      "end_ms": 51860,
      "text": "它主要内容里面就是说指出啊什么"
    },
    {
      "ordinal": 17,
      "start_ms": 53560,
      "end_ms": 55260,
      "text": "我们俩两个对照着看吧"
    },
    {
      "ordinal": 18,
      "start_ms": 55260,
      "end_ms": 55560,
      "text": "好吧"
    },
    {
      "ordinal": 19,
      "start_ms": 55560,
      "end_ms": 58660,
      "text": "我们把这两个对照着看啊"
    },
    {
      "ordinal": 20,
      "start_ms": 61660,
      "end_ms": 63630,
      "text": "啊什么啊"
    },
    {
      "ordinal": 21,
      "start_ms": 63630,
      "end_ms": 66300,
      "text": "他里面说列列宁指出啊"
    },
    {
      "ordinal": 22,
      "start_ms": 66300,
      "end_ms": 68880,
      "text": "军队警察中国家是阶级不可啊"
    },
    {
      "ordinal": 23,
      "start_ms": 68880,
      "end_ms": 70720,
      "text": "这边啊"
    },
    {
      "ordinal": 24,
      "start_ms": 74080,
      "end_ms": 77900,
      "text": "他应该是他这里面说的是实施了主要"
    },
    {
      "ordinal": 25,
      "start_ms": 77900,
      "end_ms": 80780,
      "text": "这里面主要内容是资产阶级各个派别"
    },
    {
      "ordinal": 26,
      "start_ms": 80780,
      "end_ms": 85380,
      "text": "有的着眼于这个这个资产阶级的宏观理由"
    },
    {
      "ordinal": 27,
      "start_ms": 85380,
      "end_ms": 86910,
      "text": "只用于自然与微观利益啊"
    },
    {
      "ordinal": 28,
      "start_ms": 86910,
      "end_ms": 88320,
      "text": "会出台不同的措施"
    },
    {
      "ordinal": 29,
      "start_ms": 88320,
      "end_ms": 90320,
      "text": "然后这由于10月革命"
    },
    {
      "ordinal": 30,
      "start_ms": 90320,
      "end_ms": 92360,
      "text": "激发了各国工人阶级的觉悟"
    },
    {
      "ordinal": 31,
      "start_ms": 92360,
      "end_ms": 95600,
      "text": "逼迫那些卓越于资资产阶级宏宏观利那派"
    },
    {
      "ordinal": 32,
      "start_ms": 95600,
      "end_ms": 96880,
      "text": "维护自然地制度"
    },
    {
      "ordinal": 33,
      "start_ms": 96880,
      "end_ms": 98200,
      "text": "瓦解工人阶级斗争"
    },
    {
      "ordinal": 34,
      "start_ms": 98200,
      "end_ms": 99460,
      "text": "采取了一些改良的措施"
    },
    {
      "ordinal": 35,
      "start_ms": 99460,
      "end_ms": 101350,
      "text": "实施了一些资产阶级民主措施"
    },
    {
      "ordinal": 36,
      "start_ms": 101350,
      "end_ms": 102850,
      "text": "但是对于私有制而言"
    },
    {
      "ordinal": 37,
      "start_ms": 102850,
      "end_ms": 105970,
      "text": "社会改良和自然基总总是第二位的"
    },
    {
      "ordinal": 38,
      "start_ms": 105970,
      "end_ms": 108610,
      "text": "它上面就是说就是说实革命之后"
    },
    {
      "ordinal": 39,
      "start_ms": 108610,
      "end_ms": 109979,
      "text": "自然经济改良了"
    },
    {
      "ordinal": 40,
      "start_ms": 109979,
      "end_ms": 112859,
      "text": "但是这改良是第二位的啊"
    },
    {
      "ordinal": 41,
      "start_ms": 114059,
      "end_ms": 115679,
      "text": "我看这篇文章里面"
    },
    {
      "ordinal": 42,
      "start_ms": 122520,
      "end_ms": 124580,
      "text": "然后说你来看嘛"
    },
    {
      "ordinal": 43,
      "start_ms": 124580,
      "end_ms": 127220,
      "text": "这些就喷什么三权分立啊"
    },
    {
      "ordinal": 44,
      "start_ms": 127220,
      "end_ms": 131620,
      "text": "是最利于自然一调节协调自然一什么什么什么"
    },
    {
      "ordinal": 45,
      "start_ms": 133939,
      "end_ms": 135639,
      "text": "怎么缩小一点"
    },
    {
      "ordinal": 46,
      "start_ms": 135639,
      "end_ms": 136520,
      "text": "缩小一点"
    },
    {
      "ordinal": 47,
      "start_ms": 143580,
      "end_ms": 146600,
      "text": "就是说10月革命以后啊"
    },
    {
      "ordinal": 48,
      "start_ms": 146600,
      "end_ms": 147680,
      "text": "自然界一部分意识到"
    },
    {
      "ordinal": 49,
      "start_ms": 147680,
      "end_ms": 149840,
      "text": "本阶级宏观利益和微观利益的对立"
    },
    {
      "ordinal": 50,
      "start_ms": 149840,
      "end_ms": 152060,
      "text": "尤其是30年代大萧条之后啊"
    },
    {
      "ordinal": 51,
      "start_ms": 152060,
      "end_ms": 154610,
      "text": "一部分一部分自然就意识到宏观利益"
    },
    {
      "ordinal": 52,
      "start_ms": 154610,
      "end_ms": 155990,
      "text": "这边也是的啊"
    },
    {
      "ordinal": 53,
      "start_ms": 155990,
      "end_ms": 157970,
      "text": "有的着眼于自然界宏观利益"
    },
    {
      "ordinal": 54,
      "start_ms": 157970,
      "end_ms": 159780,
      "text": "有的着眼于微观利益啊"
    },
    {
      "ordinal": 55,
      "start_ms": 160499,
      "end_ms": 162559,
      "text": "意识到宏观历的那些啊"
    },
    {
      "ordinal": 56,
      "start_ms": 162559,
      "end_ms": 164899,
      "text": "提出了一系列符合资本主义宏观利措施"
    },
    {
      "ordinal": 57,
      "start_ms": 164899,
      "end_ms": 166309,
      "text": "成了什么什么啊"
    },
    {
      "ordinal": 58,
      "start_ms": 166309,
      "end_ms": 170100,
      "text": "这种改良食的资本主义剥削具有可持续性啊"
    },
    {
      "ordinal": 59,
      "start_ms": 170359,
      "end_ms": 171859,
      "text": "宏观要卓越"
    },
    {
      "ordinal": 60,
      "start_ms": 171859,
      "end_ms": 175039,
      "text": "宏观利益的给给一些好的措施啊"
    },
    {
      "ordinal": 61,
      "start_ms": 175039,
      "end_ms": 176959,
      "text": "就改良了啊"
    },
    {
      "ordinal": 62,
      "start_ms": 176959,
      "end_ms": 178759,
      "text": "短视的呢就是这"
    },
    {
      "ordinal": 63,
      "start_ms": 178759,
      "end_ms": 181819,
      "text": "其实这篇这篇这一段话就是对杨和平的"
    },
    {
      "ordinal": 64,
      "start_ms": 181819,
      "end_ms": 185549,
      "text": "这篇就是对化石先生这篇文章的一个啊"
    },
    {
      "ordinal": 65,
      "start_ms": 185549,
      "end_ms": 188189,
      "text": "化石先生这篇文章的一个那个描述啊"
    },
    {
      "ordinal": 66,
      "start_ms": 188189,
      "end_ms": 191339,
      "text": "这边就指的那些是什宏观利益的啊"
    },
    {
      "ordinal": 67,
      "start_ms": 191339,
      "end_ms": 194130,
      "text": "宏观利微观利益什么什么哎呀"
    },
    {
      "ordinal": 68,
      "start_ms": 194130,
      "end_ms": 197310,
      "text": "比如为了资产阶级自身在后面就罗列了啊"
    },
    {
      "ordinal": 69,
      "start_ms": 197310,
      "end_ms": 199350,
      "text": "罗列了这里面的一些改良的自然界"
    },
    {
      "ordinal": 70,
      "start_ms": 199350,
      "end_ms": 201160,
      "text": "改良的一些手段手法"
    },
    {
      "ordinal": 71,
      "start_ms": 204260,
      "end_ms": 207940,
      "text": "然后离开资本主义宏观利益和微观利益的对立"
    },
    {
      "ordinal": 72,
      "start_ms": 207940,
      "end_ms": 209080,
      "text": "这分框架啊"
    },
    {
      "ordinal": 73,
      "start_ms": 209080,
      "end_ms": 210880,
      "text": "什么什么什么什么"
    },
    {
      "ordinal": 74,
      "start_ms": 210880,
      "end_ms": 212140,
      "text": "反正啊"
    },
    {
      "ordinal": 75,
      "start_ms": 212140,
      "end_ms": 213100,
      "text": "但是在"
    },
    {
      "ordinal": 76,
      "start_ms": 215420,
      "end_ms": 216860,
      "text": "我们来看啊"
    },
    {
      "ordinal": 77,
      "start_ms": 216860,
      "end_ms": 219020,
      "text": "就是说但是相对私有制而言"
    },
    {
      "ordinal": 78,
      "start_ms": 219020,
      "end_ms": 222620,
      "text": "社会改良和这个自然界民主总是第二位的"
    },
    {
      "ordinal": 79,
      "start_ms": 232899,
      "end_ms": 236189,
      "text": "他这个这句话是对上面那句话一个一个描述啊"
    },
    {
      "ordinal": 80,
      "start_ms": 236189,
      "end_ms": 237120,
      "text": "但是"
    },
    {
      "ordinal": 81,
      "start_ms": 239959,
      "end_ms": 242799,
      "text": "在这里工人阶级参与改良斗争不是目的"
    },
    {
      "ordinal": 82,
      "start_ms": 242799,
      "end_ms": 243819,
      "text": "而是手段啊"
    },
    {
      "ordinal": 83,
      "start_ms": 243819,
      "end_ms": 245600,
      "text": "改良总是第二位的啊"
    },
    {
      "ordinal": 84,
      "start_ms": 246019,
      "end_ms": 249679,
      "text": "不不不不是社会改良和相对于私有之言"
    },
    {
      "ordinal": 85,
      "start_ms": 249679,
      "end_ms": 250999,
      "text": "他这个私有制在上面"
    },
    {
      "ordinal": 86,
      "start_ms": 250999,
      "end_ms": 253340,
      "text": "这上面就是说你必须接受私有制"
    },
    {
      "ordinal": 87,
      "start_ms": 253700,
      "end_ms": 255920,
      "text": "相反的工人阶级必须认同私有制"
    },
    {
      "ordinal": 88,
      "start_ms": 255920,
      "end_ms": 257839,
      "text": "必须放弃对资本主义制度的挑战"
    },
    {
      "ordinal": 89,
      "start_ms": 257839,
      "end_ms": 259279,
      "text": "才能享受到改良"
    },
    {
      "ordinal": 90,
      "start_ms": 259279,
      "end_ms": 261440,
      "text": "才能享受到民主啊"
    },
    {
      "ordinal": 91,
      "start_ms": 261440,
      "end_ms": 263240,
      "text": "资产阶级民主总是第二位的"
    },
    {
      "ordinal": 92,
      "start_ms": 263240,
      "end_ms": 264140,
      "text": "相对于私有制"
    },
    {
      "ordinal": 93,
      "start_ms": 264140,
      "end_ms": 265640,
      "text": "改良和民主总是第二位的"
    },
    {
      "ordinal": 94,
      "start_ms": 265640,
      "end_ms": 267040,
      "text": "那就对应上面这句话"
    },
    {
      "ordinal": 95,
      "start_ms": 267040,
      "end_ms": 269080,
      "text": "相反的工人阶级必须认同私有制"
    },
    {
      "ordinal": 96,
      "start_ms": 269080,
      "end_ms": 271000,
      "text": "必须放弃对私有制度的挑战"
    },
    {
      "ordinal": 97,
      "start_ms": 271000,
      "end_ms": 274180,
      "text": "才能享受到资本主义下的民主啊"
    },
    {
      "ordinal": 98,
      "start_ms": 274180,
      "end_ms": 276940,
      "text": "并且劳动人民对私有制政同的程度越高"
    },
    {
      "ordinal": 99,
      "start_ms": 276940,
      "end_ms": 278080,
      "text": "对资本主义威胁越少"
    },
    {
      "ordinal": 100,
      "start_ms": 278080,
      "end_ms": 281200,
      "text": "就能享受到的资产阶明度就越越越多"
    },
    {
      "ordinal": 101,
      "start_ms": 281200,
      "end_ms": 283769,
      "text": "这句话对应的就是啊这段话啊"
    },
    {
      "ordinal": 102,
      "start_ms": 283769,
      "end_ms": 285839,
      "text": "就这段话相对于私有制而言"
    },
    {
      "ordinal": 103,
      "start_ms": 285839,
      "end_ms": 288419,
      "text": "总是授予了自然移民组成第二位的"
    },
    {
      "ordinal": 104,
      "start_ms": 288419,
      "end_ms": 290800,
      "text": "然后在资本主义社会中"
    },
    {
      "ordinal": 105,
      "start_ms": 290800,
      "end_ms": 293160,
      "text": "资产阶级的军队啊"
    },
    {
      "ordinal": 106,
      "start_ms": 293380,
      "end_ms": 295990,
      "text": "据警察法庭各有各的分工"
    },
    {
      "ordinal": 107,
      "start_ms": 295990,
      "end_ms": 297580,
      "text": "这个也是在上面的啊"
    },
    {
      "ordinal": 108,
      "start_ms": 297580,
      "end_ms": 299030,
      "text": "在资本制度下"
    },
    {
      "ordinal": 109,
      "start_ms": 299030,
      "end_ms": 300830,
      "text": "国家的暴力机器"
    },
    {
      "ordinal": 110,
      "start_ms": 300830,
      "end_ms": 301670,
      "text": "军队法"
    },
    {
      "ordinal": 111,
      "start_ms": 301670,
      "end_ms": 303200,
      "text": "警察和法庭各有分工"
    },
    {
      "ordinal": 112,
      "start_ms": 303200,
      "end_ms": 304550,
      "text": "你看这个化石先生"
    },
    {
      "ordinal": 113,
      "start_ms": 304550,
      "end_ms": 307799,
      "text": "为了让他不被识破"
    },
    {
      "ordinal": 114,
      "start_ms": 307799,
      "end_ms": 308639,
      "text": "他就是杨和平"
    },
    {
      "ordinal": 115,
      "start_ms": 308639,
      "end_ms": 310289,
      "text": "他把他内容倒过来写"
    },
    {
      "ordinal": 116,
      "start_ms": 310289,
      "end_ms": 311189,
      "text": "懂了吗"
    },
    {
      "ordinal": 117,
      "start_ms": 311189,
      "end_ms": 314400,
      "text": "他演讲的时候的内容是从上往下的"
    },
    {
      "ordinal": 118,
      "start_ms": 314500,
      "end_ms": 316660,
      "text": "但是他发这篇文章的时候"
    },
    {
      "ordinal": 119,
      "start_ms": 316660,
      "end_ms": 318940,
      "text": "他把这个内容倒过来写啊"
    },
    {
      "ordinal": 120,
      "start_ms": 318940,
      "end_ms": 320080,
      "text": "顺序打乱一下"
    },
    {
      "ordinal": 121,
      "start_ms": 320080,
      "end_ms": 321160,
      "text": "好像别人看不出来"
    },
    {
      "ordinal": 122,
      "start_ms": 321160,
      "end_ms": 322120,
      "text": "他妈都是一样的"
    },
    {
      "ordinal": 123,
      "start_ms": 322120,
      "end_ms": 323830,
      "text": "在各有各分工"
    },
    {
      "ordinal": 124,
      "start_ms": 323830,
      "end_ms": 326620,
      "text": "人家记录着在资本主义各有分"
    },
    {
      "ordinal": 125,
      "start_ms": 326620,
      "end_ms": 327670,
      "text": "各有各的分工"
    },
    {
      "ordinal": 126,
      "start_ms": 327670,
      "end_ms": 329290,
      "text": "我告诉你还更夸张的"
    },
    {
      "ordinal": 127,
      "start_ms": 329290,
      "end_ms": 332650,
      "text": "他他是把一半文章上半部分内容倒过来写"
    },
    {
      "ordinal": 128,
      "start_ms": 332650,
      "end_ms": 334210,
      "text": "你看百年之后的今天"
    },
    {
      "ordinal": 129,
      "start_ms": 334210,
      "end_ms": 335110,
      "text": "列宁主义过时了吗"
