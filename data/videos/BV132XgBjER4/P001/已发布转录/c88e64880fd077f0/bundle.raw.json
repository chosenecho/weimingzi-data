{"segments":[{"start":0.08,"end":1.86,"text":"在1月17号当天"},{"start":1.86,"end":3.74,"text":"这个"},{"start":4.72,"end":11.28,"text":"我的独认的独认的执行权"},{"start":11.28,"end":13.62,"text":"独认的啊"},{"start":13.62,"end":16.88,"text":"唯一的最终决策权和一票否决权"},{"start":16.88,"end":27.39,"text":"在现场被两名额分工关系上比我次一级的成员质疑他裹挟"},{"start":27.39,"end":31.83,"text":"现场还有七名左右的再次两级的成员"},{"start":39.38,"end":46.979,"text":"当然在当时这两名比我次一级的成员呢"},{"start":48.059,"end":56.72,"text":"实际上事实上啊在非经营性的工作分工上"},{"start":61.02,"end":62.68,"text":"已经早就被我架空了"},{"start":62.68,"end":67.34,"text":"边缘化了一个只呃"},{"start":67.34,"end":69.42,"text":"只负责这个"},{"start":70.78,"end":73.22,"text":"局部的地区的经营性事务"},{"start":73.22,"end":80.98,"text":"还有另外一个只负责充当某种就是另外一个地区的某种荣誉性的啊"},{"start":82.54,"end":85.26,"text":"宣传推广性质的一个辅助工作"},{"start":87.92,"end":95.2,"text":"这两个次级成员实质上的呃对于非经营性活动的影响力"},{"start":95.73,"end":97.23,"text":"只在那个局部"},{"start":97.23,"end":100.53,"text":"利用他当时现场的人数优势"},{"start":101.8,"end":107.74,"text":"试图要挟我向他们的这种架空"},{"start":111.14,"end":111.98,"text":"妥协嘛"},{"start":113.06,"end":115.86,"text":"然后他们最后这两个人自己都没有达成共识"},{"start":116.94,"end":120.86,"text":"现场的情况是啊"},{"start":121.94,"end":123.5,"text":"各位想想啊"},{"start":124.3,"end":125.74,"text":"这个词我说了好多遍了"},{"start":126.94,"end":129.58,"text":"其中一个情形最为恶劣的要求"},{"start":131.78,"end":136.14,"text":"他要求成立一个呃由三方面构成的"},{"start":137.34,"end":140.46,"text":"就是由另外一个啊这个人"},{"start":140.46,"end":142.28,"text":"另外那一个人算一票"},{"start":142.28,"end":143.59,"text":"我算一票"},{"start":143.59,"end":150.17,"text":"然后再由这个各地的负责人组成一个联席的啊会议"},{"start":150.17,"end":153.27,"text":"然后统合意见再算一票"},{"start":153.68,"end":156.96,"text":"那么对于这个所谓各地负责人的这个联席会议"},{"start":156.96,"end":159.64,"text":"提出这个呃"},{"start":159.64,"end":161.64,"text":"提出这个议案的人"},{"start":161.64,"end":162.6,"text":"提出这个方案的人"},{"start":162.6,"end":165.29,"text":"他自己自认为可以在里面占据主导"},{"start":165.29,"end":167.23,"text":"然后这是众人的意见"},{"start":167.23,"end":171.13,"text":"所以他相当于就拿着这个众人的意见就可以占据主导"},{"start":171.56,"end":174.84,"text":"但是这个方案最后被否了啊"},{"start":174.84,"end":177.44,"text":"因为就是说另外一个他本身也算一票的"},{"start":177.44,"end":178.66,"text":"那个人说"},{"start":178.66,"end":179.9,"text":"那那不就这样了"},{"start":179.9,"end":181.1,"text":"不这样了啊"},{"start":181.1,"end":182.86,"text":"这个活儿风险太大"},{"start":182.86,"end":186.169,"text":"这个活儿这个呃没人承受得了这个烈度"},{"start":186.169,"end":189.69,"text":"或者说这个活只有我有战略眼光"},{"start":189.69,"end":194.75,"text":"所以最后现场得出来的这个结论"},{"start":195.11,"end":196.91,"text":"哪怕他是一次非法的"},{"start":196.91,"end":197.75,"text":"不正当的"},{"start":198.75,"end":201.3,"text":"他在议程上完全不正当"},{"start":201.82,"end":203.22,"text":"在授权级别上"},{"start":204.34,"end":207.32,"text":"他们不可能说就靠现场这两个人"},{"start":207.32,"end":209.58,"text":"然后这个"},{"start":210.469,"end":215.669,"text":"还有这个再次两极的现场的另外六七个人"},{"start":215.669,"end":217.709,"text":"这群人就能够形成所谓的合议"},{"start":217.709,"end":220.5,"text":"不可能的啊"},{"start":220.5,"end":224.26,"text":"所以这个方案本身没有被通过"},{"start":225.01,"end":230.19,"text":"并且他及时的就被这个我比我次一级的两个成员当中的另外一个"},{"start":230.19,"end":232.37,"text":"他本身又否掉了"},{"start":235.34,"end":238.42,"text":"然后我要进一步说的是呃"},{"start":238.42,"end":242.95,"text":"当天这个协商结束了之后"},{"start":242.95,"end":245.329,"text":"或者说在它的末尾的时候"},{"start":245.329,"end":248.369,"text":"由于在现场程序上"},{"start":248.369,"end":258.32,"text":"我还是具有所有这些人员的这个非经营活动和身份的裁决权"},{"start":258.8,"end":261.87,"text":"可任命权的和任免权的"},{"start":261.87,"end":263.51,"text":"所以我当时我就宣布"},{"start":271.83,"end":275.91,"text":"然后他事后一系列的这个所作所为"},{"start":275.91,"end":279.75,"text":"足以将其定性为叛乱分子好吧"},{"start":280.39,"end":282.47,"text":"然后事情往后面发展"},{"start":282.47,"end":288.76,"text":"比我次一级的这个成员是用脚投票啊"},{"start":288.76,"end":289.32,"text":"用脚投票"},{"start":289.32,"end":290.78,"text":"不服从的就退出了"},{"start":290.78,"end":292.88,"text":"最后用脚投票下来"},{"start":292.88,"end":297.96,"text":"是我们是压倒性多数不服从的是退出了"},{"start":297.96,"end":302.22,"text":"或者说直接以这个呃这个反对性的行为啊"},{"start":302.22,"end":305.69,"text":"施加一个地下的负面影响"},{"start":305.69,"end":307.67,"text":"还有一些是保持中立"},{"start":307.67,"end":310.909,"text":"但是呢由于在信任关系上可疑"},{"start":310.909,"end":312.549,"text":"我们也把它边缘化了"},{"start":312.549,"end":314.089,"text":"或者说直接推到外面去了"},{"start":314.089,"end":316.149,"text":"以脱离来处理"},{"start":317.92,"end":319.32,"text":"我很明确告诉你"},{"start":320.72,"end":324.0,"text":"以压倒性的票型在人数上"},{"start":324.0,"end":325.4,"text":"压倒性的票皮"},{"start":325.4,"end":326.76,"text":"在功能上"},{"start":326.76,"end":328.69,"text":"我们作为主体"},{"start":328.69,"end":332.55,"text":"完全能够继续如常的安定的运行"},{"start":332.55,"end":334.71,"text":"而他们散乱"},{"start":334.71,"end":337.895,"text":"失去了所有的非经营性功能"},{"start":340.24,"end":342.96,"text":"人数上压倒性啊"},{"start":342.96,"end":345.92,"text":"从这个功能的完备性完整性上面"},{"start":345.92,"end":347.64,"text":"作为这个主体部分"},{"start":347.64,"end":349.01,"text":"我们依然维持着"},{"start":349.729,"end":360.78,"text":"然后这个妄图在现场这个提出这种叛乱性的这个方案呢"},{"start":360.78,"end":362.98,"text":"这家伙啊"},{"start":364.4,"end":369.15,"text":"也得到了核心管理层的共识"},{"start":369.67,"end":372.11,"text":"将其定性为叛乱分子"},{"start":374.94,"end":376.6,"text":"有脱离的"},{"start":376.6,"end":377.84,"text":"有脱离的"},{"start":377.84,"end":382.1,"text":"脱离脱离的这个刺激成员或者再刺激成员的话"},{"start":382.1,"end":383.58,"text":"人数是"},{"start":386.37,"end":392.97,"text":"脱离的比我次一级和再次一级的成员的人数是六人"},{"start":399.96,"end":401.46,"text":"这是少数"},{"start":401.46,"end":404.08,"text":"这是绝对少数"},{"start":418.22,"end":421.32,"text":"我要明确的公开向你们定型"},{"start":421.32,"end":426.49,"text":"然后继续和大家都知道这个所谓的这个家伙是谁啊"},{"start":426.49,"end":429.54,"text":"继续和他有任何合作关系"},{"start":429.54,"end":432.92,"text":"继续去参与他所参与的这些活动的"},{"start":432.92,"end":436.74,"text":"一律会被我们定性为从逆者"},{"start":437.66,"end":438.98,"text":"好吧"},{"start":442.92,"end":445.2,"text":"就是我要公开宣布这一点"},{"start":449.84,"end":451.96,"text":"我这就有合法授权的"},{"start":459.139,"end":460.279,"text":"要把我罢免"},{"start":460.279,"end":461.699,"text":"可以没问题"},{"start":461.699,"end":464.51,"text":"联合所有的次级成员"},{"start":464.95,"end":468.31,"text":"因为我如果指挥不动所有的比我次一级的人的话"},{"start":471.69,"end":474.17,"text":"那么他们采取的是非法程序"},{"start":474.17,"end":476.13,"text":"非法手段"},{"start":479.02,"end":481.62,"text":"这里的这个法不是指国家的法律啊"},{"start":481.62,"end":486.5,"text":"这个法指的是合法程序意向的正当程序"},{"start":496.94,"end":499.46,"text":"嘶行那就讲到这里了"}],"source":"subtitle"}
