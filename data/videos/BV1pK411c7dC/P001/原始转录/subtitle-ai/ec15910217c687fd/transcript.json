    {
      "ordinal": 173,
      "start_ms": 515490,
      "end_ms": 516539,
      "text": "同时是有"
    },
    {
      "ordinal": 174,
      "start_ms": 516539,
      "end_ms": 517320,
      "text": "同时是无"
    },
    {
      "ordinal": 175,
      "start_ms": 517320,
      "end_ms": 518340,
      "text": "它是最高级的"
    },
    {
      "ordinal": 176,
      "start_ms": 518340,
      "end_ms": 519299,
      "text": "五也是最高级的"
    },
    {
      "ordinal": 177,
      "start_ms": 519299,
      "end_ms": 521450,
      "text": "有这是在二杠二里面"
    },
    {
      "ordinal": 178,
      "start_ms": 521450,
      "end_ms": 524059,
      "text": "它设立的二杠二里面它会是这样设立的"
    },
    {
      "ordinal": 179,
      "start_ms": 524059,
      "end_ms": 526720,
      "text": "这个东西不知道太一嘛"
    },
    {
      "ordinal": 180,
      "start_ms": 526720,
      "end_ms": 527920,
      "text": "太一生水"
    },
    {
      "ordinal": 181,
      "start_ms": 529360,
      "end_ms": 531660,
      "text": "他一口水都算这种东西啊"
    },
    {
      "ordinal": 182,
      "start_ms": 531660,
      "end_ms": 534420,
      "text": "他就是他在有无二分之前呢"
    },
    {
      "ordinal": 183,
      "start_ms": 534420,
      "end_ms": 535380,
      "text": "那么"
    },
