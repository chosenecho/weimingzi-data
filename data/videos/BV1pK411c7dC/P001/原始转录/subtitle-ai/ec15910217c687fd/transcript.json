      "ordinal": 220,
      "start_ms": 636780,
      "end_ms": 637740,
      "text": "有一个第三方"
    },
    {
      "ordinal": 221,
      "start_ms": 637740,
      "end_ms": 639060,
      "text": "第三方就是自我意识"
