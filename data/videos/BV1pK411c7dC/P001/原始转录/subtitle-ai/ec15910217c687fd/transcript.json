      "text": "对不对"
    },
    {
      "ordinal": 162,
      "start_ms": 488420,
      "end_ms": 489260,
      "text": "形而上的"
    },
    {
      "ordinal": 163,
      "start_ms": 489260,
      "end_ms": 490340,
      "text": "那么这里面是什么"
    },
