  "content_sha256": "f54657b39bff259b5bd4eb1952e632227d7b646fcb0856949ba55c110df9a733",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 980,
      "end_ms": 2840,
      "text": "我真的是要笑死了"
    },
    {
      "ordinal": 1,
      "start_ms": 4200,
      "end_ms": 7790,
      "text": "我没有说法律不违法的运动"
    },
    {
      "ordinal": 2,
      "start_ms": 7790,
      "end_ms": 9480,
      "text": "它不违法的"
    },
    {
      "ordinal": 3,
      "start_ms": 9860,
      "end_ms": 12200,
      "text": "完全不违法的"
    },
    {
      "ordinal": 4,
      "start_ms": 12200,
      "end_ms": 14150,
      "text": "我没有在说任何不"
    },
    {
      "ordinal": 5,
      "start_ms": 14150,
      "end_ms": 18140,
      "text": "我只是说按照我们自己的道德标准去评判他们"
    },
    {
      "ordinal": 6,
      "start_ms": 18220,
      "end_ms": 20470,
      "text": "according our own morality"
    },
    {
      "ordinal": 7,
      "start_ms": 20470,
      "end_ms": 23140,
      "text": "你不是说前面我不是批评过道德吗"
    },
    {
      "ordinal": 8,
      "start_ms": 23140,
      "end_ms": 24210,
      "text": "那我要讲的是"
    },
    {
      "ordinal": 9,
      "start_ms": 24210,
      "end_ms": 26250,
      "text": "我并不是批评所有道德"
    },
    {
      "ordinal": 10,
      "start_ms": 26250,
      "end_ms": 27900,
      "text": "我们自己有一套道德"
    },
    {
      "ordinal": 11,
      "start_ms": 27900,
      "end_ms": 31590,
      "text": "我们自己有一套衡量价值的一种观念体系"
    },
    {
      "ordinal": 12,
      "start_ms": 31590,
      "end_ms": 32479,
      "text": "一种规范性"
    },
    {
      "ordinal": 13,
      "start_ms": 32479,
      "end_ms": 36740,
      "text": "就可以用这这种道德这种规范来主宰我们的情感"
    },
    {
      "ordinal": 14,
      "start_ms": 36740,
      "end_ms": 38779,
      "text": "主宰我们对于世界的认知"
    },
    {
      "ordinal": 15,
      "start_ms": 41600,
      "end_ms": 42790,
      "text": "难道不行吗"
    },
    {
      "ordinal": 16,
      "start_ms": 42790,
      "end_ms": 44440,
      "text": "我不是我不是我"
    },
    {
      "ordinal": 17,
      "start_ms": 44440,
      "end_ms": 45100,
      "text": "我不能理解"
    },
    {
      "ordinal": 18,
      "start_ms": 45100,
      "end_ms": 46060,
      "text": "i can't understand"
    },
    {
      "ordinal": 19,
      "start_ms": 46060,
      "end_ms": 47230,
      "text": "我就是不能理解"
    },
    {
      "ordinal": 20,
      "start_ms": 47230,
      "end_ms": 48640,
      "text": "我就是不能理解啊"
    },
    {
      "ordinal": 21,
      "start_ms": 48640,
      "end_ms": 50419,
      "text": "我真是不能理解"
    },
    {
      "ordinal": 22,
      "start_ms": 50820,
      "end_ms": 53940,
      "text": "就说你如果连情感上都不能认同"
    },
    {
      "ordinal": 23,
      "start_ms": 53940,
      "end_ms": 54180,
      "text": "你"
    },
    {
      "ordinal": 24,
      "start_ms": 54180,
      "end_ms": 57180,
      "text": "如果让情感上都还在继续的伪装成一个"
    },
    {
      "ordinal": 25,
      "start_ms": 57180,
      "end_ms": 58850,
      "text": "就是我要站在他那边"
    },
    {
      "ordinal": 26,
      "start_ms": 58850,
      "end_ms": 60590,
      "text": "我要假装站在他那边"
    },
    {
      "ordinal": 27,
      "start_ms": 60590,
      "end_ms": 63170,
      "text": "我要我要假装我是驯服的"
    },
    {
      "ordinal": 28,
      "start_ms": 63170,
      "end_ms": 65030,
      "text": "我是心甘情愿的"
    },
    {
      "ordinal": 29,
      "start_ms": 65030,
      "end_ms": 66800,
      "text": "我是甘之如饴的"
    },
    {
      "ordinal": 30,
      "start_ms": 67080,
      "end_ms": 69179,
      "text": "哪是假装呀"
    },
    {
      "ordinal": 31,
      "start_ms": 71280,
      "end_ms": 74619,
      "text": "我觉得你没在假装你就是诶"
    },
    {
      "ordinal": 32,
      "start_ms": 77540,
      "end_ms": 80600,
      "text": "我不能我不能理解你在假装啊"
    },
    {
      "ordinal": 33,
      "start_ms": 80600,
      "end_ms": 82520,
      "text": "我不能理解你在假装"
    },
    {
      "ordinal": 34,
      "start_ms": 83300,
      "end_ms": 85600,
      "text": "就说唉这赚钱嘛"
    },
    {
      "ordinal": 35,
      "start_ms": 85600,
      "end_ms": 87440,
      "text": "我又没少分你一分钱"
    },
    {
      "ordinal": 36,
      "start_ms": 87700,
      "end_ms": 89380,
      "text": "你就说这是赚的脏钱"
    },
    {
      "ordinal": 37,
      "start_ms": 89380,
      "end_ms": 90310,
      "text": "你分给我"
    },
    {
      "ordinal": 38,
      "start_ms": 90310,
      "end_ms": 92560,
      "text": "那我我拿你这些分给我的脏钱"
    },
    {
      "ordinal": 39,
      "start_ms": 92560,
      "end_ms": 95200,
      "text": "我去帮你挽回一些"
    },
    {
      "ordinal": 40,
      "start_ms": 95200,
      "end_ms": 97750,
      "text": "你对社会做出的一些负面的价值"
    },
    {
      "ordinal": 41,
      "start_ms": 97750,
      "end_ms": 99320,
      "text": "我来帮你挽回一下"
    },
    {
      "ordinal": 42,
      "start_ms": 101940,
      "end_ms": 103340,
      "text": "然后你就可以喷他"
    },
    {
      "ordinal": 43,
      "start_ms": 103340,
      "end_ms": 108380,
      "text": "我觉得你们你们很多就是自称是是是是是是什么"
    },
    {
      "ordinal": 44,
      "start_ms": 108380,
      "end_ms": 110360,
      "text": "996很痛苦的"
    },
    {
      "ordinal": 45,
      "start_ms": 110560,
      "end_ms": 116020,
      "text": "你们你们说不定可能连在办公室里面公开表达自己痛苦都不敢表达了"
    },
    {
      "ordinal": 46,
      "start_ms": 116300,
      "end_ms": 118160,
      "text": "我觉得是已经是被规训的"
    },
    {
      "ordinal": 47,
      "start_ms": 118160,
      "end_ms": 119750,
      "text": "已经是太太野了啊"
    },
    {
      "ordinal": 48,
      "start_ms": 119750,
      "end_ms": 121980,
      "text": "you非要你感到痛苦"
    },
    {
      "ordinal": 49,
      "start_ms": 121980,
      "end_ms": 123420,
      "text": "你就感到痛苦呗"
    },
    {
      "ordinal": 50,
      "start_ms": 123420,
      "end_ms": 125100,
      "text": "你就表现这种痛苦"
    },
    {
      "ordinal": 51,
      "start_ms": 125100,
      "end_ms": 126660,
      "text": "大声叫难道不能救吗"
    },
    {
      "ordinal": 52,
      "start_ms": 126660,
      "end_ms": 128400,
      "text": "喊出来不能喊出来吗"
    },
    {
      "ordinal": 53,
      "start_ms": 128519,
      "end_ms": 131519,
      "text": "我知道你以为你们已经都不敢了"
    },
    {
      "ordinal": 54,
      "start_ms": 131519,
      "end_ms": 133319,
      "text": "我靠我靠"
    },
    {
      "ordinal": 55,
      "start_ms": 133319,
      "end_ms": 134540,
      "text": "我在想啊"
    },
    {
      "ordinal": 56,
      "start_ms": 135240,
      "end_ms": 136880,
      "text": "我真的在想啊"
    },
    {
      "ordinal": 57,
      "start_ms": 136880,
      "end_ms": 141560,
      "text": "你们在这个高中就说呃"
    },
    {
      "ordinal": 58,
      "start_ms": 142019,
      "end_ms": 143819,
      "text": "在当学生的时候"
    },
    {
      "ordinal": 59,
      "start_ms": 143819,
      "end_ms": 146879,
      "text": "是不是就已经不敢在班级里面大喊"
    },
    {
      "ordinal": 60,
      "start_ms": 146879,
      "end_ms": 150410,
      "text": "哪怕是哪怕是老师不在场的时候"
    },
    {
      "ordinal": 61,
      "start_ms": 150410,
      "end_ms": 151550,
      "text": "你都不敢大喊"
    },
    {
      "ordinal": 62,
      "start_ms": 151550,
      "end_ms": 152450,
      "text": "都不敢喊了"
    },
    {
      "ordinal": 63,
      "start_ms": 152450,
      "end_ms": 154020,
      "text": "是不是"
    },
    {
      "ordinal": 64,
      "start_ms": 154220,
      "end_ms": 156470,
      "text": "哈哈哈哈哈哈哈"
    },
    {
      "ordinal": 65,
      "start_ms": 156470,
      "end_ms": 158780,
      "text": "所以说到高中就已经这样了"
    },
    {
      "ordinal": 66,
      "start_ms": 158780,
      "end_ms": 159200,
      "text": "对不对"
    },
    {
      "ordinal": 67,
      "start_ms": 159200,
      "end_ms": 162820,
      "text": "哎呦高中就已经这样了"
    },
    {
      "ordinal": 68,
      "start_ms": 163179,
      "end_ms": 165459,
      "text": "我记得我们那个时候高中还不是这样的"
    },
    {
      "ordinal": 69,
      "start_ms": 165459,
      "end_ms": 166599,
      "text": "我们那个时候高中还不是"
    },
    {
      "ordinal": 70,
      "start_ms": 166599,
      "end_ms": 168519,
      "text": "我们那个时候高中和老师闹别扭"
    },
    {
      "ordinal": 71,
      "start_ms": 168519,
      "end_ms": 171860,
      "text": "闹到最后就是最后和解了"
    },
    {
      "ordinal": 72,
      "start_ms": 171860,
      "end_ms": 173570,
      "text": "老师还请我吃橘子呢"
    },
    {
      "ordinal": 73,
      "start_ms": 173570,
      "end_ms": 175620,
      "text": "就说你坚持是对的"
    },
    {
      "ordinal": 74,
      "start_ms": 175620,
      "end_ms": 179430,
      "text": "对于你们其他同学的这个成绩提高是有好处的"
    },
    {
      "ordinal": 75,
      "start_ms": 179430,
      "end_ms": 182220,
      "text": "对于你整个班级的大家能够更轻松一点"
    },
    {
      "ordinal": 76,
      "start_ms": 182220,
      "end_ms": 183000,
      "text": "学的更好"
    },
    {
      "ordinal": 77,
      "start_ms": 183000,
      "end_ms": 184940,
      "text": "对共同体利益有好处"
    },
    {
      "ordinal": 78,
      "start_ms": 185260,
      "end_ms": 186220,
      "text": "为什么不敢"
    },
    {
      "ordinal": 79,
      "start_ms": 186220,
      "end_ms": 187540,
      "text": "我不能理解啊"
    },
    {
      "ordinal": 80,
      "start_ms": 187540,
      "end_ms": 189020,
      "text": "i can't understand"
    },
    {
      "ordinal": 81,
      "start_ms": 192339,
      "end_ms": 193439,
      "text": "请到学生处了"
    },
    {
      "ordinal": 82,
      "start_ms": 193439,
      "end_ms": 194900,
      "text": "你不是还是学生吗"
    },
    {
      "ordinal": 83,
      "start_ms": 198719,
      "end_ms": 199879,
      "text": "我再强调一遍"
    },
    {
      "ordinal": 84,
      "start_ms": 199879,
      "end_ms": 201529,
      "text": "我建议你们不要憋"
    },
    {
      "ordinal": 85,
      "start_ms": 201529,
      "end_ms": 203620,
      "text": "真的憋出抑郁症来"
    },
    {
      "ordinal": 86,
      "start_ms": 203660,
      "end_ms": 205610,
      "text": "憋到最后他妈了个巴子"
    },
    {
      "ordinal": 87,
      "start_ms": 205610,
      "end_ms": 210039,
      "text": "这种憋到最后真的是哎呦不要憋啊"
    },
    {
      "ordinal": 88,
      "start_ms": 210039,
      "end_ms": 213219,
      "text": "我的建议就是说你有这些道德信念"
    },
    {
      "ordinal": 89,
      "start_ms": 213219,
      "end_ms": 215620,
      "text": "理论上已经把自己说服了"
    },
    {
      "ordinal": 90,
      "start_ms": 216380,
      "end_ms": 218890,
      "text": "也是要一天到晚看我直播的"
    },
    {
      "ordinal": 91,
      "start_ms": 218890,
      "end_ms": 221020,
      "text": "不要把我这里当成一个赎罪券"
    },
    {
      "ordinal": 92,
      "start_ms": 221020,
      "end_ms": 223000,
      "text": "然后这里当上赎罪券一样的"
    }
  ],
  "text": "我真的是要笑死了\n我没有说法律不违法的运动\n它不违法的\n完全不违法的\n我没有在说任何不\n我只是说按照我们自己的道德标准去评判他们\naccording our own morality\n你不是说前面我不是批评过道德吗\n那我要讲的是\n我并不是批评所有道德\n我们自己有一套道德\n我们自己有一套衡量价值的一种观念体系\n一种规范性\n就可以用这这种道德这种规范来主宰我们的情感\n主宰我们对于世界的认知\n难道不行吗\n我不是我不是我\n我不能理解\ni can't understand\n我就是不能理解\n我就是不能理解啊\n我真是不能理解\n就说你如果连情感上都不能认同\n你\n如果让情感上都还在继续的伪装成一个\n就是我要站在他那边\n我要假装站在他那边\n我要我要假装我是驯服的\n我是心甘情愿的\n我是甘之如饴的\n哪是假装呀\n我觉得你没在假装你就是诶\n我不能我不能理解你在假装啊\n我不能理解你在假装\n就说唉这赚钱嘛\n我又没少分你一分钱\n你就说这是赚的脏钱\n你分给我\n那我我拿你这些分给我的脏钱\n我去帮你挽回一些\n你对社会做出的一些负面的价值\n我来帮你挽回一下\n然后你就可以喷他\n我觉得你们你们很多就是自称是是是是是是什么\n996很痛苦的\n你们你们说不定可能连在办公室里面公开表达自己痛苦都不敢表达了\n我觉得是已经是被规训的\n已经是太太野了啊\nyou非要你感到痛苦\n你就感到痛苦呗\n你就表现这种痛苦\n大声叫难道不能救吗\n喊出来不能喊出来吗\n我知道你以为你们已经都不敢了\n我靠我靠\n我在想啊\n我真的在想啊\n你们在这个高中就说呃\n在当学生的时候\n是不是就已经不敢在班级里面大喊\n哪怕是哪怕是老师不在场的时候\n你都不敢大喊\n都不敢喊了\n是不是\n哈哈哈哈哈哈哈\n所以说到高中就已经这样了\n对不对\n哎呦高中就已经这样了\n我记得我们那个时候高中还不是这样的\n我们那个时候高中还不是\n我们那个时候高中和老师闹别扭\n闹到最后就是最后和解了\n老师还请我吃橘子呢\n就说你坚持是对的\n对于你们其他同学的这个成绩提高是有好处的\n对于你整个班级的大家能够更轻松一点\n学的更好\n对共同体利益有好处\n为什么不敢\n我不能理解啊\ni can't understand\n请到学生处了\n你不是还是学生吗\n我再强调一遍\n我建议你们不要憋\n真的憋出抑郁症来\n憋到最后他妈了个巴子\n这种憋到最后真的是哎呦不要憋啊\n我的建议就是说你有这些道德信念\n理论上已经把自己说服了\n也是要一天到晚看我直播的\n不要把我这里当成一个赎罪券\n然后这里当上赎罪券一样的",
