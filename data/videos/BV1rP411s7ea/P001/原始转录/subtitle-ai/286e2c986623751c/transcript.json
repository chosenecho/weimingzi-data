{
  "bvid": "BV1rP411s7ea",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "286e2c986623751ce877be90d1d6b12d9195ce24937955919d59ba6e43a5d869",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 320,
      "end_ms": 2630,
      "text": "呃一段时间以来啊"
    },
    {
      "ordinal": 1,
      "start_ms": 2630,
      "end_ms": 5870,
      "text": "有许多不法分子啊"
    },
    {
      "ordinal": 2,
      "start_ms": 5870,
      "end_ms": 10669,
      "text": "以捏造的虚假指控啊"
    },
    {
      "ordinal": 3,
      "start_ms": 10669,
      "end_ms": 12139,
      "text": "捏造的事实"
    },
    {
      "ordinal": 4,
      "start_ms": 12139,
      "end_ms": 15840,
      "text": "诽谤性的侮辱性的内容啊"
    },
    {
      "ordinal": 5,
      "start_ms": 16500,
      "end_ms": 19430,
      "text": "对我本人啊"
    },
    {
      "ordinal": 6,
      "start_ms": 19430,
      "end_ms": 27360,
      "text": "以及我们团队呢进行无底线啊打击报复"
    },
    {
      "ordinal": 7,
      "start_ms": 28060,
      "end_ms": 31470,
      "text": "他们的目的呢是要置我于死地"
    },
    {
      "ordinal": 8,
      "start_ms": 31470,
      "end_ms": 32900,
      "text": "某些人"
    },
    {
      "ordinal": 9,
      "start_ms": 35180,
      "end_ms": 39340,
      "text": "知乎平台上面公开说过一句话"
    },
    {
      "ordinal": 10,
      "start_ms": 39340,
      "end_ms": 41980,
      "text": "说不把我送到牢里去"
    },
    {
      "ordinal": 11,
      "start_ms": 41980,
      "end_ms": 43180,
      "text": "绝不罢休"
    },
    {
      "ordinal": 12,
      "start_ms": 46760,
      "end_ms": 47739,
      "text": "这个人呢"
    },
    {
      "ordinal": 13,
      "start_ms": 48100,
      "end_ms": 52000,
      "text": "他在他的知乎的一条动态里面"
    },
    {
      "ordinal": 14,
      "start_ms": 52000,
      "end_ms": 53740,
      "text": "是明确这样说的啊"
    },
    {
      "ordinal": 15,
      "start_ms": 53740,
      "end_ms": 58420,
      "text": "他还说要用什么暴力的手段来对付我啊"
    },
    {
      "ordinal": 16,
      "start_ms": 58420,
      "end_ms": 63160,
      "text": "这些证据呢他自己在跟我打官司的时候"
    },
    {
      "ordinal": 17,
      "start_ms": 63160,
      "end_ms": 67080,
      "text": "他自己都承认这些证据的真实性呢是很明确的"
    },
    {
      "ordinal": 18,
      "start_ms": 67080,
      "end_ms": 68400,
      "text": "是要对我进行打击报复的"
    },
    {
      "ordinal": 19,
      "start_ms": 68400,
      "end_ms": 71160,
      "text": "而且很明确的说要把我送进牢里的"
    },
    {
      "ordinal": 20,
      "start_ms": 73540,
      "end_ms": 78360,
      "text": "啊黑纸白字的说要把我送到牢里去啊"
    },
    {
      "ordinal": 21,
      "start_ms": 81120,
      "end_ms": 82340,
      "text": "他自己啊"
    },
    {
      "ordinal": 22,
      "start_ms": 82340,
      "end_ms": 85399,
      "text": "他现在还要对我发起第二次这个诉讼啊"
    },
    {
      "ordinal": 23,
      "start_ms": 87000,
      "end_ms": 88880,
      "text": "那么在发起这个诉讼之前呢"
    },
    {
      "ordinal": 24,
      "start_ms": 88880,
      "end_ms": 95240,
      "text": "我也遭受了很多这样的啊不时的举报啊"
    },
    {
      "ordinal": 25,
      "start_ms": 95240,
      "end_ms": 97860,
      "text": "打击报复啊"
    },
    {
      "ordinal": 26,
      "start_ms": 100020,
      "end_ms": 105110,
      "text": "啊误导啊误导这个公安机关"
    },
    {
      "ordinal": 27,
      "start_ms": 105110,
      "end_ms": 107800,
      "text": "误导安全机关啊"
    },
    {
      "ordinal": 28,
      "start_ms": 107800,
      "end_ms": 109120,
      "text": "要欺骗他们"
    },
    {
      "ordinal": 29,
      "start_ms": 109120,
      "end_ms": 110830,
      "text": "要对我进行啊"
    },
    {
      "ordinal": 30,
      "start_ms": 110830,
      "end_ms": 115470,
      "text": "这个啊要借助这些力量对我进行打击报复"
    },
    {
      "ordinal": 31,
      "start_ms": 115470,
      "end_ms": 119440,
      "text": "那么我幸存下来了"
    },
    {
      "ordinal": 32,
      "start_ms": 119440,
      "end_ms": 121480,
      "text": "我活下来了啊"
    },
    {
      "ordinal": 33,
      "start_ms": 121480,
      "end_ms": 122500,
      "text": "我幸存下来了"
    },
    {
      "ordinal": 34,
      "start_ms": 122500,
      "end_ms": 123760,
      "text": "我活下来了"
    },
    {
      "ordinal": 35,
      "start_ms": 123760,
      "end_ms": 129899,
      "text": "那么我做的事情呢是完全合法的啊"
    },
    {
      "ordinal": 36,
      "start_ms": 129899,
      "end_ms": 132449,
      "text": "完全合法的啊"
    },
    {
      "ordinal": 37,
      "start_ms": 132449,
      "end_ms": 134520,
      "text": "否则我被立案调查了呀"
    },
    {
      "ordinal": 38,
      "start_ms": 134859,
      "end_ms": 136980,
      "text": "我做的事情完全合法"
    },
    {
      "ordinal": 39,
      "start_ms": 138420,
      "end_ms": 142880,
      "text": "但是呢在意识形态上可能稍显敏感啊"
    },
    {
      "ordinal": 40,
      "start_ms": 142880,
      "end_ms": 151219,
      "text": "但是有可能会啊造成相应的一些舆论的风波啊"
    },
    {
      "ordinal": 41,
      "start_ms": 151219,
      "end_ms": 157039,
      "text": "或者说一些啊容易产生嗯人们误解的啊"
    },
    {
      "ordinal": 42,
      "start_ms": 157039,
      "end_ms": 158980,
      "text": "或者让人们感到困惑的"
    },
    {
      "ordinal": 43,
      "start_ms": 160140,
      "end_ms": 164980,
      "text": "还有一些互联网景观层面的一些影响"
    },
    {
      "ordinal": 44,
      "start_ms": 165160,
      "end_ms": 168520,
      "text": "所以我们做了适当的调整啊"
    },
    {
      "ordinal": 45,
      "start_ms": 168619,
      "end_ms": 174109,
      "text": "我们把名义和口号啊进行了一个去敏感化"
    },
    {
      "ordinal": 46,
      "start_ms": 174109,
      "end_ms": 175459,
      "text": "去异形内化"
    },
    {
      "ordinal": 47,
      "start_ms": 175459,
      "end_ms": 183619,
      "text": "我们也对一些啊我们本来思量不周的做法啊"
    },
    {
      "ordinal": 48,
      "start_ms": 183619,
      "end_ms": 185140,
      "text": "比较这个"
    },
    {
      "ordinal": 49,
      "start_ms": 187700,
      "end_ms": 194859,
      "text": "相对比较粗糙的啊啊我们进行了一个反省啊"
    },
    {
      "ordinal": 50,
      "start_ms": 194859,
      "end_ms": 196620,
      "text": "进行了一个调整"
    },
    {
      "ordinal": 51,
      "start_ms": 199640,
      "end_ms": 200980,
      "text": "所以我幸存下来的"
    },
    {
      "ordinal": 52,
      "start_ms": 200980,
      "end_ms": 201880,
      "text": "我活下来了"
    },
    {
      "ordinal": 53,
      "start_ms": 201880,
      "end_ms": 204220,
      "text": "你们这些打击报复啊"
    },
    {
      "ordinal": 54,
      "start_ms": 204220,
      "end_ms": 207120,
      "text": "你们这些什么报假警啊啊"
    },
    {
      "ordinal": 55,
      "start_ms": 208140,
      "end_ms": 212380,
      "text": "就是各方面的捏造诽谤啊"
    },
    {
      "ordinal": 56,
      "start_ms": 212380,
      "end_ms": 214300,
      "text": "你们在那些群里面啊"
    },
    {
      "ordinal": 57,
      "start_ms": 214300,
      "end_ms": 216310,
      "text": "这个是一天到晚24小时"
    },
    {
      "ordinal": 58,
      "start_ms": 216310,
      "end_ms": 218500,
      "text": "感觉都在想各式样的点子啊"
    },
    {
      "ordinal": 59,
      "start_ms": 218500,
      "end_ms": 219400,
      "text": "要把我弄进去"
    },
    {
      "ordinal": 60,
      "start_ms": 219400,
      "end_ms": 220500,
      "text": "要让我坐牢"
    },
    {
      "ordinal": 61,
      "start_ms": 221520,
      "end_ms": 224060,
      "text": "这些图谋是注定失败的"
    },
    {
      "ordinal": 62,
      "start_ms": 224060,
      "end_ms": 227829,
      "text": "我活下来了啊"
    },
    {
      "ordinal": 63,
      "start_ms": 227829,
      "end_ms": 232709,
      "text": "并且我把我掌握到的关于你们的情况啊"
    },
    {
      "ordinal": 64,
      "start_ms": 232709,
      "end_ms": 234600,
      "text": "也做了相应的反应"
    },
    {
      "ordinal": 65,
      "start_ms": 234899,
      "end_ms": 237389,
      "text": "你们可以继续试着啊"
    },
    {
      "ordinal": 66,
      "start_ms": 237389,
      "end_ms": 239399,
      "text": "再继续递交假材料啊"
    },
    {
      "ordinal": 67,
      "start_ms": 239399,
      "end_ms": 241560,
      "text": "在地区继续报假警"
    },
    {
      "ordinal": 68,
      "start_ms": 241959,
      "end_ms": 247290,
      "text": "你们看上黑名单的是你们还是我啊"
    },
    {
      "ordinal": 69,
      "start_ms": 247290,
      "end_ms": 251700,
      "text": "我奉劝你们赶紧停止这样的打击报复的行动"
    },
    {
      "ordinal": 70,
      "start_ms": 251700,
      "end_ms": 255270,
      "text": "赶紧停止这样的捏造事实"
    },
    {
      "ordinal": 71,
      "start_ms": 255270,
      "end_ms": 257640,
      "text": "诽谤的违法犯罪的行动"
    },
    {
      "ordinal": 72,
      "start_ms": 261980,
      "end_ms": 265320,
      "text": "嗯你不停止的话"
    },
    {
      "ordinal": 73,
      "start_ms": 265320,
      "end_ms": 268500,
      "text": "那只能说你你在为这个公安机关啊"
    },
    {
      "ordinal": 74,
      "start_ms": 268500,
      "end_ms": 271450,
      "text": "或者安全机关的办案提供进一步的线索"
    },
    {
      "ordinal": 75,
      "start_ms": 271450,
      "end_ms": 273550,
      "text": "让他们更快的锁定你们是谁啊"
    },
    {
      "ordinal": 76,
      "start_ms": 273550,
      "end_ms": 275780,
      "text": "你们到底为什么要做这样的事情啊"
    },
    {
      "ordinal": 77,
      "start_ms": 276060,
      "end_ms": 277980,
      "text": "啊要对啊"
    },
    {
      "ordinal": 78,
      "start_ms": 277980,
      "end_ms": 279270,
      "text": "因为爱国的"
    },
    {
      "ordinal": 79,
      "start_ms": 282319,
      "end_ms": 285019,
      "text": "互联网上有一定影响力的啊"
    },
    {
      "ordinal": 80,
      "start_ms": 285019,
      "end_ms": 288960,
      "text": "一个自媒体从业人士进行这样的非法打击"
    },
    {
      "ordinal": 81,
      "start_ms": 289200,
      "end_ms": 291120,
      "text": "你们到底意欲何为啊"
    },
    {
      "ordinal": 82,
      "start_ms": 292500,
      "end_ms": 296460,
      "text": "你们是想要制造出一些惨案啊"
    },
    {
      "ordinal": 83,
      "start_ms": 296460,
      "end_ms": 297780,
      "text": "或者说你是刻意的"
    },
    {
      "ordinal": 84,
      "start_ms": 297780,
      "end_ms": 301530,
      "text": "想要让我遭受这个不幸的一个结局"
    },
    {
      "ordinal": 85,
      "start_ms": 301530,
      "end_ms": 307979,
      "text": "然后啊撩拨起青年的这个啊怒火"
    },
    {
      "ordinal": 86,
      "start_ms": 309479,
      "end_ms": 311700,
      "text": "聊博起这个青年的这个困惑"
    },
    {
      "ordinal": 87,
      "start_ms": 312579,
      "end_ms": 313079,
      "text": "呃"
    },
    {
      "ordinal": 88,
      "start_ms": 313079,
      "end_ms": 314579,
      "text": "你们有各式各样的意图"
    },
    {
      "ordinal": 89,
      "start_ms": 316319,
      "end_ms": 318940,
      "text": "但是没有一个是正当的啊"
    },
    {
      "ordinal": 90,
      "start_ms": 318940,
      "end_ms": 324130,
      "text": "没有一个是想要让我们国家向更稳固的发展"
    },
    {
      "ordinal": 91,
      "start_ms": 324130,
      "end_ms": 326440,
      "text": "让让这个社会呢啊"
    },
    {
      "ordinal": 92,
      "start_ms": 326440,
      "end_ms": 329980,
      "text": "更处在一个安定祥和的一个局面"
    },
    {
      "ordinal": 93,
      "start_ms": 330380,
      "end_ms": 334130,
      "text": "你们这些人啊唯恐天下不乱啊"
    },
    {
      "ordinal": 94,
      "start_ms": 334130,
      "end_ms": 336800,
      "text": "要用我的这个人头啊"
    },
    {
      "ordinal": 95,
      "start_ms": 336800,
      "end_ms": 339460,
      "text": "哦我用我的鲜血啊"
    },
    {
      "ordinal": 96,
      "start_ms": 339460,
      "end_ms": 343000,
      "text": "要在这个是在我这个一个小虾米的"
    },
    {
      "ordinal": 97,
      "start_ms": 343000,
      "end_ms": 345080,
      "text": "这个血雾当中狂欢"
    },
    {
      "ordinal": 98,
      "start_ms": 345380,
      "end_ms": 349020,
      "text": "你们是可耻的啊"
    },
    {
      "ordinal": 99,
      "start_ms": 349020,
      "end_ms": 352180,
      "text": "你搬起石头最终只会砸自己的脚"
    },
    {
      "ordinal": 100,
      "start_ms": 354220,
      "end_ms": 359280,
      "text": "啊那么我不怕你们"
    },
    {
      "ordinal": 101,
      "start_ms": 359280,
      "end_ms": 360840,
      "text": "我从来不惧怕你们"
    },
    {
      "ordinal": 102,
      "start_ms": 363000,
      "end_ms": 363580,
      "text": "啊"
    },
    {
      "ordinal": 103,
      "start_ms": 363659,
      "end_ms": 365339,
      "text": "然后我也始终相信"
    },
    {
      "ordinal": 104,
      "start_ms": 365339,
      "end_ms": 369530,
      "text": "你们终究会受到法律的相应的制裁啊"
    },
    {
      "ordinal": 105,
      "start_ms": 369530,
      "end_ms": 373430,
      "text": "我也不会说用什么其他的方法对你们打击报复"
    },
    {
      "ordinal": 106,
      "start_ms": 373430,
      "end_ms": 374630,
      "text": "或怎么样的"
    },
    {
      "ordinal": 107,
      "start_ms": 374630,
      "end_ms": 375920,
      "text": "犯不着"
    },
    {
      "ordinal": 108,
      "start_ms": 376099,
      "end_ms": 378559,
      "text": "我要维护我的权益啊"
    },
    {
      "ordinal": 109,
      "start_ms": 378559,
      "end_ms": 380299,
      "text": "我走合法途径啊"
    },
    {
      "ordinal": 110,
      "start_ms": 380299,
      "end_ms": 383130,
      "text": "走这个合法的救济渠道"
    },
    {
      "ordinal": 111,
      "start_ms": 383130,
      "end_ms": 384510,
      "text": "我该报警的报警"
    },
    {
      "ordinal": 112,
      "start_ms": 384510,
      "end_ms": 386140,
      "text": "该起诉的起诉啊"
    },
    {
      "ordinal": 113,
      "start_ms": 386599,
      "end_ms": 391179,
      "text": "我该这个举报的举报啊"
    },
    {
      "ordinal": 114,
      "start_ms": 391179,
      "end_ms": 395040,
      "text": "但是说我不会放过你们任何一个人"
    },
    {
      "ordinal": 115,
      "start_ms": 395539,
      "end_ms": 400420,
      "text": "那我终究我要把你们绳之以法啊"
    },
    {
      "ordinal": 116,
      "start_ms": 400420,
      "end_ms": 403780,
      "text": "虽然我现在不知道你们到底还有哪些人啊"
    },
    {
      "ordinal": 117,
      "start_ms": 403780,
      "end_ms": 411360,
      "text": "但是我终究哦我会寻求法律的救济"
    },
    {
      "ordinal": 118,
      "start_ms": 412460,
      "end_ms": 413890,
      "text": "将你们绳之以法"
    },
    {
      "ordinal": 119,
      "start_ms": 413890,
      "end_ms": 416980,
      "text": "我个人只是在这个过程当中提供线索啊"
    },
    {
      "ordinal": 120,
      "start_ms": 416980,
      "end_ms": 418180,
      "text": "出一份力啊"
    },
    {
      "ordinal": 121,
      "start_ms": 418240,
      "end_ms": 419920,
      "text": "并且坚持啊"
    },
    {
      "ordinal": 122,
      "start_ms": 419920,
      "end_ms": 424960,
      "text": "并且坚持我的这么一个自我保护的一个意愿"
    },
    {
      "ordinal": 123,
      "start_ms": 425159,
      "end_ms": 426899,
      "text": "你说我主动说把你们抓起来"
    },
    {
      "ordinal": 124,
      "start_ms": 426899,
      "end_ms": 428459,
      "text": "我没有那本事啊"
    },
    {
      "ordinal": 125,
      "start_ms": 428459,
      "end_ms": 431840,
      "text": "这个是这个执法机关的他的权利"
    },
    {
      "ordinal": 126,
      "start_ms": 431840,
      "end_ms": 433460,
      "text": "我没有这个权利啊"
    },
    {
      "ordinal": 127,
      "start_ms": 433460,
      "end_ms": 437969,
      "text": "我只是一个普通公民啊"
    },
    {
      "ordinal": 128,
      "start_ms": 437969,
      "end_ms": 439619,
      "text": "那么现在我明确告诉你们"
    },
    {
      "ordinal": 129,
      "start_ms": 439619,
      "end_ms": 440699,
      "text": "我幸存下来的"
    },
    {
      "ordinal": 130,
      "start_ms": 440699,
      "end_ms": 441920,
      "text": "我活下来了"
    },
    {
      "ordinal": 131,
      "start_ms": 442699,
      "end_ms": 446940,
      "text": "你们这种几辆是一眼就被看穿了"
    },
    {
      "ordinal": 132,
      "start_ms": 446940,
      "end_ms": 450520,
      "text": "你们这样的打击报复的这种下三滥的这种手段"
    },
    {
      "ordinal": 133,
      "start_ms": 451100,
      "end_ms": 455500,
      "text": "只会提高你们自己被捕的风险"
    },
    {
      "ordinal": 134,
      "start_ms": 456240,
      "end_ms": 459980,
      "text": "只会增加你们自己将来啊"
    },
    {
      "ordinal": 135,
      "start_ms": 459980,
      "end_ms": 464990,
      "text": "受到的这个法律的惩罚的力度啊"
    },
    {
      "ordinal": 136,
      "start_ms": 464990,
      "end_ms": 466280,
      "text": "你说踩缝纫机"
    },
    {
      "ordinal": 137,
      "start_ms": 466280,
      "end_ms": 467780,
      "text": "你可能要多踩一阵"
    },
    {
      "ordinal": 138,
      "start_ms": 468639,
      "end_ms": 471059,
      "text": "你们可以继续尝试做这样的事情"
    },
    {
      "ordinal": 139,
      "start_ms": 471059,
      "end_ms": 474520,
      "text": "我说的可以并不意味着我鼓励你们"
    },
    {
      "ordinal": 140,
      "start_ms": 474620,
      "end_ms": 477080,
      "text": "因为你们一贯在违法犯罪吗"
    },
    {
      "ordinal": 141,
      "start_ms": 477080,
      "end_ms": 480610,
      "text": "我没办法阻止你们这种继续违法犯罪的倾向啊"
    },
    {
      "ordinal": 142,
      "start_ms": 480610,
      "end_ms": 484390,
      "text": "我这个可以只是说在客观的一个评价意义上说"
    },
    {
      "ordinal": 143,
      "start_ms": 484390,
      "end_ms": 487720,
      "text": "你们可能还会要继续对我进行这种非法的迫害"
    },
    {
      "ordinal": 144,
      "start_ms": 487720,
      "end_ms": 488940,
      "text": "打击报复"
    },
    {
      "ordinal": 145,
      "start_ms": 493639,
      "end_ms": 497589,
      "text": "但是我绝不允许你们全身而退"
    },
    {
      "ordinal": 146,
      "start_ms": 497589,
      "end_ms": 500559,
      "text": "绝不允许你们不承担任何的代价"
    },
    {
      "ordinal": 147,
      "start_ms": 500559,
      "end_ms": 502440,
      "text": "不付出啊"
    },
    {
      "ordinal": 148,
      "start_ms": 502440,
      "end_ms": 505320,
      "text": "任何的这个代价啊"
    },
    {
      "ordinal": 149,
      "start_ms": 505320,
      "end_ms": 507140,
      "text": "不承受它的惨痛的教训"
    },
    {
      "ordinal": 150,
      "start_ms": 508420,
      "end_ms": 511000,
      "text": "我这里的可以意思是"
    },
    {
      "ordinal": 151,
      "start_ms": 512679,
      "end_ms": 518880,
      "text": "放马过来瞧瞧看看看到时候到底是谁"
    },
    {
      "ordinal": 152,
      "start_ms": 518880,
      "end_ms": 521599,
      "text": "陷于一个所谓的万劫不复之地"
    },
    {
      "ordinal": 153,
      "start_ms": 521820,
      "end_ms": 523620,
      "text": "公开说要让我坐牢"
    },
    {
      "ordinal": 154,
      "start_ms": 523620,
      "end_ms": 525870,
      "text": "不让我坐牢不罢休的这种人"
    },
    {
      "ordinal": 155,
      "start_ms": 525870,
      "end_ms": 527820,
      "text": "还要打官司"
    },
    {
      "ordinal": 156,
      "start_ms": 527820,
      "end_ms": 529320,
      "text": "还要第二次起诉"
    },
    {
      "ordinal": 157,
      "start_ms": 529320,
      "end_ms": 532330,
      "text": "我太可笑了"
    },
    {
      "ordinal": 158,
      "start_ms": 532330,
      "end_ms": 537070,
      "text": "这个世道我觉得真的是太可笑了"
    },
    {
      "ordinal": 159,
      "start_ms": 537070,
      "end_ms": 541920,
      "text": "你们这种人真是这个公开说这个东西"
    },
    {
      "ordinal": 160,
      "start_ms": 541920,
      "end_ms": 544200,
      "text": "我可以找个截图给你们看一下看啊"
    },
    {
      "ordinal": 161,
      "start_ms": 544200,
      "end_ms": 545700,
      "text": "我找个截图给你们看看"
    },
    {
      "ordinal": 162,
      "start_ms": 545700,
      "end_ms": 548280,
      "text": "公开说一定要让我坐牢啊"
    },
    {
      "ordinal": 163,
      "start_ms": 548280,
      "end_ms": 549180,
      "text": "这个东西真的是"
    },
    {
      "ordinal": 164,
      "start_ms": 549180,
      "end_ms": 553459,
      "text": "他竟然在互联网媒体上公开说这种话"
    },
    {
      "ordinal": 165,
      "start_ms": 555280,
      "end_ms": 558960,
      "text": "所以我当然有十足的正当性"
    },
    {
      "ordinal": 166,
      "start_ms": 558960,
      "end_ms": 561600,
      "text": "去怀疑我受到这些举报啊"
    },
    {
      "ordinal": 167,
      "start_ms": 561600,
      "end_ms": 564440,
      "text": "被他们报的假警啊"
    },
    {
      "ordinal": 168,
      "start_ms": 564440,
      "end_ms": 566690,
      "text": "就可能就有他的这样一份啊"
    },
    {
      "ordinal": 169,
      "start_ms": 566690,
      "end_ms": 568120,
      "text": "有他这一份"
    },
    {
      "ordinal": 170,
      "start_ms": 571620,
      "end_ms": 576140,
      "text": "人身暴力威胁啊啊我都有留存啊"
    },
    {
      "ordinal": 171,
      "start_ms": 576140,
      "end_ms": 577319,
      "text": "我都有留存"
    },
    {
      "ordinal": 172,
      "start_ms": 584160,
      "end_ms": 586820,
      "text": "啊什么革命圈子要清洗我"
    },
    {
      "ordinal": 173,
      "start_ms": 586820,
      "end_ms": 590859,
      "text": "哈哈说你革命圈子自居要要清洗我"
    },
    {
      "ordinal": 174,
      "start_ms": 596200,
      "end_ms": 597800,
      "text": "哎我再找一找"
    },
    {
      "ordinal": 175,
      "start_ms": 695960,
      "end_ms": 697420,
      "text": "这些玩意"
    },
    {
      "ordinal": 176,
      "start_ms": 725640,
      "end_ms": 726620,
      "text": "啊对对对"
    },
    {
      "ordinal": 177,
      "start_ms": 726620,
      "end_ms": 728480,
      "text": "我找到了我找到了"
    },
    {
      "ordinal": 178,
      "start_ms": 728480,
      "end_ms": 730479,
      "text": "我真的是服了"
    },
    {
      "ordinal": 179,
      "start_ms": 731640,
      "end_ms": 732859,
      "text": "哎呀"
    },
    {
      "ordinal": 180,
      "start_ms": 735300,
      "end_ms": 736880,
      "text": "然后可以让你们看一下啊"
    },
    {
      "ordinal": 181,
      "start_ms": 736880,
      "end_ms": 739500,
      "text": "他说什么在未名子"
    },
    {
      "ordinal": 182,
      "start_ms": 739820,
      "end_ms": 742380,
      "text": "什么进入监狱之前"
    },
    {
      "ordinal": 183,
      "start_ms": 747120,
      "end_ms": 749640,
      "text": "呃你们可能看不见啊"
    },
    {
      "ordinal": 184,
      "start_ms": 752800,
      "end_ms": 755240,
      "text": "这个说"
    },
    {
      "ordinal": 185,
      "start_ms": 758400,
      "end_ms": 761660,
      "text": "啊在什么未明子进入监狱之前"
    },
    {
      "ordinal": 186,
      "start_ms": 761660,
      "end_ms": 763220,
      "text": "不会轻易放过他们"
    },
    {
      "ordinal": 187,
      "start_ms": 763220,
      "end_ms": 764720,
      "text": "也不会原谅人们"
    },
    {
      "ordinal": 188,
      "start_ms": 764720,
      "end_ms": 769140,
      "text": "最好为以后要发生的事做好准备"
    },
    {
      "ordinal": 189,
      "start_ms": 769140,
      "end_ms": 773020,
      "text": "他也是他说一定要让我进监狱啊"
    },
    {
      "ordinal": 190,
      "start_ms": 773020,
      "end_ms": 774040,
      "text": "我不会放过他们"
    },
    {
      "ordinal": 191,
      "start_ms": 774040,
      "end_ms": 776200,
      "text": "不会放过什么啊"
    },
    {
      "ordinal": 192,
      "start_ms": 776200,
      "end_ms": 778600,
      "text": "他他说我是什么邪教教徒啊"
    },
    {
      "ordinal": 193,
      "start_ms": 778600,
      "end_ms": 780400,
      "text": "不会放过我的徒子徒孙啊"
    },
    {
      "ordinal": 194,
      "start_ms": 782900,
      "end_ms": 785440,
      "text": "这个这个东西它也是啊"
    },
    {
      "ordinal": 195,
      "start_ms": 785440,
      "end_ms": 787810,
      "text": "包括他还有对我的一些暴力威胁"
    },
    {
      "ordinal": 196,
      "start_ms": 787810,
      "end_ms": 792340,
      "text": "暴力威胁说什么要打一顿不够"
    },
    {
      "ordinal": 197,
      "start_ms": 792340,
      "end_ms": 793360,
      "text": "怎么怎么样的啊"
    },
    {
      "ordinal": 198,
      "start_ms": 793360,
      "end_ms": 796000,
      "text": "然后说要对我进行清洗啊"
    },
    {
      "ordinal": 199,
      "start_ms": 796380,
      "end_ms": 799320,
      "text": "啊暴力对敌人是残酷的"
    },
    {
      "ordinal": 200,
      "start_ms": 799320,
      "end_ms": 801180,
      "text": "这个之前咱们都看过了啊"
    },
    {
      "ordinal": 201,
      "start_ms": 801180,
      "end_ms": 802900,
      "text": "这个之前咱们都看过"
    },
    {
      "ordinal": 202,
      "start_ms": 803320,
      "end_ms": 807780,
      "text": "那么啊没什么好说的"
    },
    {
      "ordinal": 203,
      "start_ms": 807780,
      "end_ms": 811020,
      "text": "我真的是呃我我感到非常不幸的"
    },
    {
      "ordinal": 204,
      "start_ms": 811020,
      "end_ms": 813240,
      "text": "就是我们国家竟然有这样的人"
    },
    {
      "ordinal": 205,
      "start_ms": 813240,
      "end_ms": 815660,
      "text": "既然存在这样的人啊"
    },
    {
      "ordinal": 206,
      "start_ms": 815660,
      "end_ms": 819860,
      "text": "我是为这个人的存在跟他不幸那么类似"
    },
    {
      "ordinal": 207,
      "start_ms": 819860,
      "end_ms": 821540,
      "text": "他的人其实还蛮多的啊"
    },
    {
      "ordinal": 208,
      "start_ms": 821540,
      "end_ms": 822320,
      "text": "还蛮多的"
    },
    {
      "ordinal": 209,
      "start_ms": 822320,
      "end_ms": 826859,
      "text": "对我进行这样的这种恶意举报的打击报复的啊"
    },
    {
      "ordinal": 210,
      "start_ms": 827360,
      "end_ms": 828680,
      "text": "还不止他一个"
    },
    {
      "ordinal": 211,
      "start_ms": 828680,
      "end_ms": 829880,
      "text": "他们还有一个群"
    },
    {
      "ordinal": 212,
      "start_ms": 829880,
      "end_ms": 831530,
      "text": "他们专门有个群的"
    },
    {
      "ordinal": 213,
      "start_ms": 831530,
      "end_ms": 833600,
      "text": "然后有另外一个人起诉我的"
    },
    {
      "ordinal": 214,
      "start_ms": 833600,
      "end_ms": 836130,
      "text": "那个人提交的所谓的证据材料"
    },
    {
      "ordinal": 215,
      "start_ms": 836130,
      "end_ms": 838290,
      "text": "里面包含了有好几个类似"
    },
    {
      "ordinal": 216,
      "start_ms": 838290,
      "end_ms": 840040,
      "text": "刚刚那个人的那个证言"
    },
    {
      "ordinal": 217,
      "start_ms": 840180,
      "end_ms": 842370,
      "text": "跟那几个人跟没关系的"
    },
    {
      "ordinal": 218,
      "start_ms": 842370,
      "end_ms": 843780,
      "text": "他一个人起诉我"
    },
    {
      "ordinal": 219,
      "start_ms": 843780,
      "end_ms": 848670,
      "text": "另外几个也要给他作为证据呢啊作为证据啊"
    },
    {
      "ordinal": 220,
      "start_ms": 848670,
      "end_ms": 851010,
      "text": "就要有几个这个姓姓甚名谁的"
    },
    {
      "ordinal": 221,
      "start_ms": 851010,
      "end_ms": 852400,
      "text": "我都不知道是谁的"
    },
    {
      "ordinal": 222,
      "start_ms": 852400,
      "end_ms": 855670,
      "text": "我觉得他们处在一个非常尴尬的那种精神状态"
    },
    {
      "ordinal": 223,
      "start_ms": 855670,
      "end_ms": 857890,
      "text": "非常糟糕的一个精神状态"
    },
    {
      "ordinal": 224,
      "start_ms": 857890,
      "end_ms": 860470,
      "text": "把我当成他们这个复仇的对象"
    },
    {
      "ordinal": 225,
      "start_ms": 860470,
      "end_ms": 863470,
      "text": "说要让我的这个血舞漫天"
    },
    {
      "ordinal": 226,
      "start_ms": 863470,
      "end_ms": 865450,
      "text": "然后他就觉得啊"
    },
    {
      "ordinal": 227,
      "start_ms": 865450,
      "end_ms": 868790,
      "text": "他这个他就对社会造成某种伤害"
    },
    {
      "ordinal": 228,
      "start_ms": 868790,
      "end_ms": 870350,
      "text": "或者说他就会觉得"
    },
    {
      "ordinal": 229,
      "start_ms": 870350,
      "end_ms": 872780,
      "text": "或者说他幻想他对社会造成某种贡献"
    },
    {
      "ordinal": 230,
      "start_ms": 872780,
      "end_ms": 873800,
      "text": "但是无论如何"
    },
    {
      "ordinal": 231,
      "start_ms": 873800,
      "end_ms": 877300,
      "text": "你们做这些事情是违法犯罪的啊"
    },
    {
      "ordinal": 232,
      "start_ms": 881920,
      "end_ms": 883870,
      "text": "对我进行各式各样的打击报复"
    },
    {
      "ordinal": 233,
      "start_ms": 883870,
      "end_ms": 886520,
      "text": "各式各样的迫害是可耻的"
    },
    {
      "ordinal": 234,
      "start_ms": 886520,
      "end_ms": 888260,
      "text": "是违法犯罪的"
    },
    {
      "ordinal": 235,
      "start_ms": 888260,
      "end_ms": 891240,
      "text": "是违法犯罪是可耻的啊"
    },
    {
      "ordinal": 236,
      "start_ms": 891240,
      "end_ms": 896040,
      "text": "我目前啊我目前由于我没有进一步的证据啊"
    },
    {
      "ordinal": 237,
      "start_ms": 896100,
      "end_ms": 899040,
      "text": "啊我目前我只能说冒一个出来啊"
    },
    {
      "ordinal": 238,
      "start_ms": 899040,
      "end_ms": 901800,
      "text": "我们向公安机关核实一个"
    },
    {
      "ordinal": 239,
      "start_ms": 901800,
      "end_ms": 904060,
      "text": "向安全机构核实一个"
    },
    {
      "ordinal": 240,
      "start_ms": 905020,
      "end_ms": 908719,
      "text": "所以你们你们尽管去递交这样的材料好了"
    },
    {
      "ordinal": 241,
      "start_ms": 909180,
      "end_ms": 910500,
      "text": "我说的尽管去"
    },
    {
      "ordinal": 242,
      "start_ms": 910500,
      "end_ms": 912600,
      "text": "不是说我欢迎你们或者怎么样的"
    },
    {
      "ordinal": 243,
      "start_ms": 912600,
      "end_ms": 913860,
      "text": "我允许你不不不不"
    },
    {
      "ordinal": 244,
      "start_ms": 913860,
      "end_ms": 914580,
      "text": "我绝不欢迎"
    },
    {
      "ordinal": 245,
      "start_ms": 914580,
      "end_ms": 915870,
      "text": "绝不容许我说"
    },
    {
      "ordinal": 246,
      "start_ms": 915870,
      "end_ms": 917040,
      "text": "尽管去你自己"
    },
    {
      "ordinal": 247,
      "start_ms": 917040,
      "end_ms": 920260,
      "text": "我的意思是你自己准备好付出全部的代价"
    },
    {
      "ordinal": 248,
      "start_ms": 925040,
      "end_ms": 926680,
      "text": "啊你们自己准备好"
    },
    {
      "ordinal": 249,
      "start_ms": 926680,
      "end_ms": 928199,
      "text": "付出全部的代价"
    },
    {
      "ordinal": 250,
      "start_ms": 929840,
      "end_ms": 931510,
      "text": "这不是儿戏啊"
    },
    {
      "ordinal": 251,
      "start_ms": 931510,
      "end_ms": 933300,
      "text": "这真的不是儿戏"
    },
    {
      "ordinal": 252,
      "start_ms": 934780,
      "end_ms": 936720,
      "text": "你们这样罗织罪名"
    },
    {
      "ordinal": 253,
      "start_ms": 936720,
      "end_ms": 938900,
      "text": "要打击报复迫害我"
    },
    {
      "ordinal": 254,
      "start_ms": 940080,
      "end_ms": 942140,
      "text": "最后不能查实"
    },
    {
      "ordinal": 255,
      "start_ms": 942140,
      "end_ms": 944160,
      "text": "最后根本就是子虚乌有"
    },
    {
      "ordinal": 256,
      "start_ms": 944180,
      "end_ms": 945740,
      "text": "我不用坐牢"
    },
    {
      "ordinal": 257,
      "start_ms": 945740,
      "end_ms": 947720,
      "text": "但是反过来你们是要坐牢的"
    },
    {
      "ordinal": 258,
      "start_ms": 947720,
      "end_ms": 948170,
      "text": "知道吗"
    },
    {
      "ordinal": 259,
      "start_ms": 948170,
      "end_ms": 949460,
      "text": "你们这是犯罪啊"
    },
    {
      "ordinal": 260,
      "start_ms": 955900,
      "end_ms": 957960,
      "text": "啊你就向队友进行迫害"
    },
    {
      "ordinal": 261,
      "start_ms": 958980,
      "end_ms": 961920,
      "text": "你们这个是构成刑事犯罪的"
    },
    {
      "ordinal": 262,
      "start_ms": 963060,
      "end_ms": 965690,
      "text": "你们是构成刑事犯罪的"
    },
    {
      "ordinal": 263,
      "start_ms": 965690,
      "end_ms": 972840,
      "text": "目前相应的这个执法行政安全部门是在调查"
    },
    {
      "ordinal": 264,
      "start_ms": 972840,
      "end_ms": 974400,
      "text": "你们做的这些事情"
    },
    {
      "ordinal": 265,
      "start_ms": 975220,
      "end_ms": 980240,
      "text": "会对你们进行相应的那相应的一个调查的"
    },
    {
      "ordinal": 266,
      "start_ms": 980500,
      "end_ms": 982240,
      "text": "我奉劝你们一句"
    },
    {
      "ordinal": 267,
      "start_ms": 982240,
      "end_ms": 984160,
      "text": "我真的是奉劝你们一句啊"
    },
    {
      "ordinal": 268,
      "start_ms": 984160,
      "end_ms": 987000,
      "text": "如果你真的内心深处刹不住车的话"
    },
    {
      "ordinal": 269,
      "start_ms": 987360,
      "end_ms": 990549,
      "text": "你到哪个地方去吼一嗓子啊"
    },
    {
      "ordinal": 270,
      "start_ms": 990549,
      "end_ms": 992079,
      "text": "你夜深人静的时候"
    },
    {
      "ordinal": 271,
      "start_ms": 992079,
      "end_ms": 994449,
      "text": "或者你你是没什么洗澡的时候"
    },
    {
      "ordinal": 272,
      "start_ms": 994449,
      "end_ms": 995019,
      "text": "是什么"
    },
    {
      "ordinal": 273,
      "start_ms": 995019,
      "end_ms": 996669,
      "text": "用冷水澡冲一冲"
    },
    {
      "ordinal": 274,
      "start_ms": 996669,
      "end_ms": 1000839,
      "text": "把你那内心的邪火整个方式去发泄一下"
    },
    {
      "ordinal": 275,
      "start_ms": 1002600,
      "end_ms": 1005599,
      "text": "不要自取灭亡"
    },
    {
      "ordinal": 276,
      "start_ms": 1008160,
      "end_ms": 1011540,
      "text": "就是昨天就说说这就是个非常荒谬的一个事"
    },
    {
      "ordinal": 277,
      "start_ms": 1011540,
      "end_ms": 1013280,
      "text": "他要二次起诉我"
    },
    {
      "ordinal": 278,
      "start_ms": 1013280,
      "end_ms": 1014839,
      "text": "你的这些内容"
    },
    {
      "ordinal": 279,
      "start_ms": 1015620,
      "end_ms": 1020280,
      "text": "你那网站里面那些东西是够"
    },
    {
      "ordinal": 280,
      "start_ms": 1021000,
      "end_ms": 1023459,
      "text": "真的是go直接把你逮起来的"
    },
    {
      "ordinal": 281,
      "start_ms": 1023560,
      "end_ms": 1025510,
      "text": "还要二次起诉我"
    },
    {
      "ordinal": 282,
      "start_ms": 1025510,
      "end_ms": 1029470,
      "text": "如果说哪个法法官还敢倾向于你去这样判的话"
    },
    {
      "ordinal": 283,
      "start_ms": 1036260,
      "end_ms": 1037869,
      "text": "真的是非常非常"
    },
    {
      "ordinal": 284,
      "start_ms": 1037869,
      "end_ms": 1042020,
      "text": "我觉得你们这个我觉得我觉得就是说呃"
    },
    {
      "ordinal": 285,
      "start_ms": 1043540,
      "end_ms": 1046140,
      "text": "我能认识邪恶"
    },
    {
      "ordinal": 286,
      "start_ms": 1046140,
      "end_ms": 1047520,
      "text": "我也能认识愚蠢"
    },
    {
      "ordinal": 287,
      "start_ms": 1047520,
      "end_ms": 1053160,
      "text": "但是我有的时候我不太能够认识愚蠢的邪恶啊"
    },
    {
      "ordinal": 288,
      "start_ms": 1053160,
      "end_ms": 1055380,
      "text": "我真的是我觉得这挺可怜的"
    },
    {
      "ordinal": 289,
      "start_ms": 1055380,
      "end_ms": 1055860,
      "text": "实事求是"
    },
    {
      "ordinal": 290,
      "start_ms": 1055860,
      "end_ms": 1060020,
      "text": "想你你你你要邪恶"
    },
    {
      "ordinal": 291,
      "start_ms": 1060020,
      "end_ms": 1060860,
      "text": "你聪明一点"
    },
    {
      "ordinal": 292,
      "start_ms": 1060860,
      "end_ms": 1061460,
      "text": "你要愚蠢"
    },
    {
      "ordinal": 293,
      "start_ms": 1061460,
      "end_ms": 1062120,
      "text": "你善良一点"
    },
    {
      "ordinal": 294,
      "start_ms": 1062120,
      "end_ms": 1064040,
      "text": "你为什么是愚蠢的邪恶"
    },
    {
      "ordinal": 295,
      "start_ms": 1066820,
      "end_ms": 1068670,
      "text": "挺古怪挺诡异的啊"
    },
    {
      "ordinal": 296,
      "start_ms": 1068670,
      "end_ms": 1072210,
      "text": "那当然我会从这种愚蠢的邪恶当中幸存下来啊"
    },
    {
      "ordinal": 297,
      "start_ms": 1072210,
      "end_ms": 1076200,
      "text": "当然这个啊这个执法机构"
    },
    {
      "ordinal": 298,
      "start_ms": 1076200,
      "end_ms": 1079830,
      "text": "安全机构不会被你们这样轻易的误导啊"
    },
    {
      "ordinal": 299,
      "start_ms": 1079830,
      "end_ms": 1082040,
      "text": "不会被你们这样轻易的撩拨啊"
    },
    {
      "ordinal": 300,
      "start_ms": 1082600,
      "end_ms": 1084040,
      "text": "啊你也欺骗不了"
    },
    {
      "ordinal": 301,
      "start_ms": 1084040,
      "end_ms": 1087420,
      "text": "蒙骗不了他们啊"
    },
    {
      "ordinal": 302,
      "start_ms": 1087420,
      "end_ms": 1092600,
      "text": "所以我最后说的就是说哎我希望你回头是岸吧"
    },
    {
      "ordinal": 303,
      "start_ms": 1092600,
      "end_ms": 1093560,
      "text": "好吧哦"
    },
    {
      "ordinal": 304,
      "start_ms": 1093560,
      "end_ms": 1095480,
      "text": "我就奉劝你们一句啊"
    },
    {
      "ordinal": 305,
      "start_ms": 1095480,
      "end_ms": 1096860,
      "text": "回头是岸"
    },
    {
      "ordinal": 306,
      "start_ms": 1097200,
      "end_ms": 1098400,
      "text": "星海无涯"
    },
    {
      "ordinal": 307,
      "start_ms": 1098400,
      "end_ms": 1099580,
      "text": "回头是岸"
    },
    {
      "ordinal": 308,
      "start_ms": 1100780,
      "end_ms": 1103050,
      "text": "这话已经说到这份上了"
    },
    {
      "ordinal": 309,
      "start_ms": 1103050,
      "end_ms": 1105000,
      "text": "不要说我不叫儿猪"
    },
    {
      "ordinal": 310,
      "start_ms": 1105500,
      "end_ms": 1107960,
      "text": "虽然我没有什么权利去把你们什么"
    },
    {
      "ordinal": 311,
      "start_ms": 1107960,
      "end_ms": 1109280,
      "text": "我这个打个比方啊"
    },
    {
      "ordinal": 312,
      "start_ms": 1109280,
      "end_ms": 1112620,
      "text": "不要说我不要说我没给你们提过喜"
    },
    {
      "ordinal": 313,
      "start_ms": 1113020,
      "end_ms": 1114700,
      "text": "我要说我没有给你们"
    },
    {
      "ordinal": 314,
      "start_ms": 1114700,
      "end_ms": 1120810,
      "text": "就是说啊啊一次机会我给你们机会了"
    },
    {
      "ordinal": 315,
      "start_ms": 1120810,
      "end_ms": 1124180,
      "text": "你们在做那些假材料"
    },
    {
      "ordinal": 316,
      "start_ms": 1124340,
      "end_ms": 1125900,
      "text": "夸大现实"
    },
    {
      "ordinal": 317,
      "start_ms": 1125900,
      "end_ms": 1127220,
      "text": "扭曲现实"
    },
    {
      "ordinal": 318,
      "start_ms": 1127220,
      "end_ms": 1128690,
      "text": "捏造罪状"
    },
    {
      "ordinal": 319,
      "start_ms": 1128690,
      "end_ms": 1130160,
      "text": "要置我于死地的时候"
    },
    {
      "ordinal": 320,
      "start_ms": 1130160,
      "end_ms": 1132300,
      "text": "你们何曾给过我机会啊"
    },
    {
      "ordinal": 321,
      "start_ms": 1132760,
      "end_ms": 1134410,
      "text": "我给你们机会了"
    },
    {
      "ordinal": 322,
      "start_ms": 1134410,
      "end_ms": 1136340,
      "text": "我比你们人吃得多"
    },
    {
      "ordinal": 323,
      "start_ms": 1137480,
      "end_ms": 1139300,
      "text": "我比你们宽容得多"
    },
    {
      "ordinal": 324,
      "start_ms": 1139300,
      "end_ms": 1141919,
      "text": "我比你们有底线得多"
    },
    {
      "ordinal": 325,
      "start_ms": 1142440,
      "end_ms": 1145800,
      "text": "我容忍你们做这种事情好久了"
    },
    {
      "ordinal": 326,
      "start_ms": 1145800,
      "end_ms": 1149500,
      "text": "好几个月了啊"
    },
    {
      "ordinal": 327,
      "start_ms": 1149500,
      "end_ms": 1151840,
      "text": "对我知道我被举报的时候"
    },
    {
      "ordinal": 328,
      "start_ms": 1151840,
      "end_ms": 1155560,
      "text": "可能是这个是疫情快结束的时候"
    },
    {
      "ordinal": 329,
      "start_ms": 1156860,
      "end_ms": 1158500,
      "text": "我容忍你们很久了"
    },
    {
      "ordinal": 330,
      "start_ms": 1160960,
      "end_ms": 1163870,
      "text": "啊你们不要自投罗网"
    },
    {
      "ordinal": 331,
      "start_ms": 1163870,
      "end_ms": 1164920,
      "text": "我再强调一遍"
    },
    {
      "ordinal": 332,
      "start_ms": 1164920,
      "end_ms": 1166420,
      "text": "我容忍你们很久了"
    },
    {
      "ordinal": 333,
      "start_ms": 1166420,
      "end_ms": 1169140,
      "text": "你们不要自投罗网啊"
    },
    {
      "ordinal": 334,
      "start_ms": 1169140,
      "end_ms": 1171600,
      "text": "你们不要质疑其咎"
    },
    {
      "ordinal": 335,
      "start_ms": 1173860,
      "end_ms": 1175800,
      "text": "不是说天与不取啊"
    },
    {
      "ordinal": 336,
      "start_ms": 1175800,
      "end_ms": 1177090,
      "text": "什么自以其咎"
    },
    {
      "ordinal": 337,
      "start_ms": 1177090,
      "end_ms": 1180180,
      "text": "这不是什么天宇天与不取的"
    },
    {
      "ordinal": 338,
      "start_ms": 1180180,
      "end_ms": 1182640,
      "text": "上天并没有给你什么机会啊"
    },
    {
      "ordinal": 339,
      "start_ms": 1182640,
      "end_ms": 1183840,
      "text": "让你去把握的"
    },
    {
      "ordinal": 340,
      "start_ms": 1183840,
      "end_ms": 1185400,
      "text": "然后可以置我于死地"
    },
    {
      "ordinal": 341,
      "start_ms": 1185400,
      "end_ms": 1186360,
      "text": "怎么怎么样"
    },
    {
      "ordinal": 342,
      "start_ms": 1186400,
      "end_ms": 1187600,
      "text": "我再强调一遍"
    },
    {
      "ordinal": 343,
      "start_ms": 1187600,
      "end_ms": 1189120,
      "text": "我奉劝你们一句"
    },
    {
      "ordinal": 344,
      "start_ms": 1189620,
      "end_ms": 1191480,
      "text": "我再奉劝你们一句"
    },
    {
      "ordinal": 345,
      "start_ms": 1191480,
      "end_ms": 1194330,
      "text": "真的不要以身试法"
    },
    {
      "ordinal": 346,
      "start_ms": 1194330,
      "end_ms": 1196790,
      "text": "不要拿自己身家性命开玩笑"
    },
    {
      "ordinal": 347,
      "start_ms": 1196790,
      "end_ms": 1198440,
      "text": "我不是恐吓你们"
    },
    {
      "ordinal": 348,
      "start_ms": 1198440,
      "end_ms": 1202159,
      "text": "因为你们再这样搞下去是要坐牢的"
    },
    {
      "ordinal": 349,
      "start_ms": 1204400,
      "end_ms": 1206970,
      "text": "你们再这样弄下去是要坐牢的"
    },
    {
      "ordinal": 350,
      "start_ms": 1206970,
      "end_ms": 1210780,
      "text": "我不是恐吓你们啊"
    },
    {
      "ordinal": 351,
      "start_ms": 1210780,
      "end_ms": 1211980,
      "text": "你对我有一个"
    },
    {
      "ordinal": 352,
      "start_ms": 1215940,
      "end_ms": 1217400,
      "text": "好就讲到这里了"
    },
    {
      "ordinal": 353,
      "start_ms": 1217400,
      "end_ms": 1218780,
      "text": "我是仁至义尽的啊"
    },
    {
      "ordinal": 354,
      "start_ms": 1218780,
      "end_ms": 1220160,
      "text": "我的是我仁至义尽"
    },
    {
      "ordinal": 355,
      "start_ms": 1220160,
      "end_ms": 1222770,
      "text": "我对于你们这些人仁至义尽"
    },
    {
      "ordinal": 356,
      "start_ms": 1222770,
      "end_ms": 1224500,
      "text": "我活下来了"
    },
    {
      "ordinal": 357,
      "start_ms": 1225240,
      "end_ms": 1227600,
      "text": "我又不是说直接就说怎么怎么样的"
    },
    {
      "ordinal": 358,
      "start_ms": 1227600,
      "end_ms": 1228920,
      "text": "反过来就把你们干掉了"
    },
    {
      "ordinal": 359,
      "start_ms": 1228920,
      "end_ms": 1230000,
      "text": "怎么样的"
    },
    {
      "ordinal": 360,
      "start_ms": 1230480,
      "end_ms": 1232250,
      "text": "我略施薄惩"
    },
    {
      "ordinal": 361,
      "start_ms": 1232250,
      "end_ms": 1234260,
      "text": "以儆效尤啊"
    },
    {
      "ordinal": 362,
      "start_ms": 1234260,
      "end_ms": 1238540,
      "text": "对你们其中比较就是说直球的直球"
    },
    {
      "ordinal": 363,
      "start_ms": 1238540,
      "end_ms": 1242170,
      "text": "就刚刚那个公开说要把我让我让我坐牢的那个"
    },
    {
      "ordinal": 364,
      "start_ms": 1242170,
      "end_ms": 1244690,
      "text": "那我这只能叫略施薄惩啊"
    },
    {
      "ordinal": 365,
      "start_ms": 1244690,
      "end_ms": 1246250,
      "text": "以儆效尤啊"
    },
    {
      "ordinal": 366,
      "start_ms": 1246250,
      "end_ms": 1249580,
      "text": "你们其他那些偷着摸着的"
    },
    {
      "ordinal": 367,
      "start_ms": 1249580,
      "end_ms": 1250360,
      "text": "拐着弯儿的"
    },
    {
      "ordinal": 368,
      "start_ms": 1250360,
      "end_ms": 1252610,
      "text": "还还不敢露头出来的"
    },
    {
      "ordinal": 369,
      "start_ms": 1252610,
      "end_ms": 1254280,
      "text": "识相一点"
    },
    {
      "ordinal": 370,
      "start_ms": 1254620,
      "end_ms": 1257180,
      "text": "真的朋友识相一点"
    },
    {
      "ordinal": 371,
      "start_ms": 1258340,
      "end_ms": 1259380,
      "text": "识相一点"
    },
    {
      "ordinal": 372,
      "start_ms": 1260640,
      "end_ms": 1262120,
      "text": "识相一点"
    },
    {
      "ordinal": 373,
      "start_ms": 1264500,
      "end_ms": 1266180,
      "text": "好吧就讲到这里"
