,"end":164.1,"text":"一是有他有先锋队"},{"start":164.1,"end":167.72,"text":"或者说他有他专门的社会性的建制"},{"start":168.84,"end":170.72,"text":"社会建制"},{"start":171.73,"end":175.01,"text":"比如说他有他的市场"},{"start":175.01,"end":178.37,"text":"或者说他有他独属于他的教育啊"},{"start":178.56,"end":180.16,"text":"这是他的阶级机关"},{"start":180.16,"end":182.64,"text":"还有他有他的阶级制识"},{"start":182.64,"end":186.45,"text":"还有全人类的解放方案啊"},{"start":186.45,"end":191.65,"text":"他有这个人类解放的方案"},{"start":195.0,"end":197.1,"text":"还是接一记致食"},{"start":197.1,"end":200.18,"text":"是通过一个阶级机关呈现出来"},{"start":200.18,"end":202.36,"text":"这个阶级机关展现出一种阶级知识"},{"start":202.36,"end":207.34,"text":"提出人类解放方案和具体运动路线啊"},{"start":209.04,"end":210.3,"text":"运动路线"},{"start":210.3,"end":213.24,"text":"那么GG意识我们在这个意义上讲"},{"start":213.24,"end":214.58,"text":"他是个宏观的存在"},{"start":214.58,"end":216.84,"text":"它是某种宏观的存在"},{"start":217.599,"end":219.439,"text":"宏观的一个特征啊"},{"start":219.439,"end":223.88,"text":"他不在于具体的某个人身上展现出来"},{"start":223.88,"end":226.12,"text":"所以阶级意识是一种无意识"},{"start":226.12,"end":227.42,"text":"在个体的"},{"start":227.42,"end":229.88,"text":"对个体来讲是无意识的"},{"start":229.88,"end":234.12,"text":"对于个体他是无意识的"},{"start":237.18,"end":243.65,"text":"然后阶级议事他从抵达这个机关的制石"},{"start":243.65,"end":244.73,"text":"一个先锋队的"},{"start":244.73,"end":246.23,"text":"他的人类解放方案之后"},{"start":246.23,"end":248.42,"text":"他能够转而成为"},{"start":248.42,"end":252.37,"text":"然后通过运动路线转而成为阶级运动的话"},{"start":252.37,"end":257.149,"text":"就是直接的无产者群体发起的战争啊"},{"start":257.149,"end":258.31,"text":"政治动员呀"},{"start":258.31,"end":259.89,"text":"总体战什么这些东西的话"},{"start":259.89,"end":265.19,"text":"那我们把这些过程体现出来的叫做阶级意志啊"},{"start":268.98,"end":273.26,"text":"阶级意志也不是也不是个人意志啊"},{"start":274.61,"end":276.61,"text":"阶级意志也不是个人的意志"},{"start":276.61,"end":278.87,"text":"阶级意志就是革命啊"},{"start":278.87,"end":280.53,"text":"革命是阶级意志"},{"start":280.53,"end":282.05,"text":"不是它的体现"},{"start":282.05,"end":284.39,"text":"革命就是阶级的意志啊"},{"start":285.39,"end":291.48,"text":"嗯嗯class will他的意志啊"},{"start":292.32,"end":295.8,"text":"在这里这里接近意识是class"},{"start":295.8,"end":297.46,"text":"不是俗语啊"},{"start":297.46,"end":300.77,"text":"就是class consciousness"},{"start":301.7,"end":305.25,"text":"他直接可那这里就要加一个热点"},{"start":305.25,"end":307.09,"text":"一个阶级拥有他的革命"},{"start":307.09,"end":308.69,"text":"发起拥有他的革命"},{"start":308.69,"end":312.69,"text":"就是我们简单讲一下阶级意识啊"},{"start":313.17,"end":316.93,"text":"哎呦无产者单个无产者啊"},{"start":316.93,"end":321.46,"text":"个人无产者个人是很难"},{"start":321.46,"end":322.82,"text":"就是从他个人角度"},{"start":322.82,"end":326.33,"text":"他脑袋里面心理层面他很难有他的阶级意识的"},{"start":326.33,"end":329.65,"text":"因为他在心智上是被压迫剥削的"},{"start":329.65,"end":334.05,"text":"心智上受压迫和剥削"},{"start":335.69,"end":341.58,"text":"啊单个的无产者在阶级社会里面比较愚蠢的吧"},{"start":341.58,"end":345.54,"text":"啊比较就是被剥夺了他治理发展的那些机会"},{"start":346.58,"end":349.32,"text":"所以这些无产者心智上受压迫剥削"},{"start":349.32,"end":354.83,"text":"所以他们往往是呃由于生存受到了威胁"},{"start":354.83,"end":356.17,"text":"出于恐惧"},{"start":356.17,"end":358.19,"text":"处于非理性恐慌"},{"start":358.19,"end":361.91,"text":"嗯也是出于客观物质的一些规律"},{"start":361.91,"end":365.59,"text":"他整体上宏观的能产生出某种意识"},{"start":365.59,"end":368.18,"text":"这种宏观的意识就是纪律啊"},{"start":368.18,"end":371.7,"text":"这个纪律也包括它的人口再生产"},{"start":372.759,"end":376.779,"text":"人口再生产的所呈现出的一个规律啊"},{"start":376.779,"end":379.679,"text":"这规律当中有某种族群"},{"start":379.679,"end":384.65,"text":"有族群幸存的啊"},{"start":384.65,"end":388.29,"text":"幸存的一些次优解当然不是最优解啊"},{"start":388.29,"end":391.21,"text":"一些次优解或者说可以接受的一些解法"},{"start":391.21,"end":394.47,"text":"这些次优解也可以看成是某种纪律"},{"start":394.47,"end":395.53,"text":"人口纪律"},{"start":395.53,"end":401.16,"text":"所以我们说阶级意识当中就包括他的人口几率"},{"start":405.24,"end":406.96,"text":"斗争目的性这些东西"},{"start":409.72,"end":411.44,"text":"生产几率"},{"start":415.78,"end":418.63,"text":"啊等等等等这些东西"},{"start":418.63,"end":422.43,"text":"这些这些纪律都是体现他啊"},{"start":422.43,"end":423.59,"text":"体现为他的啊"},{"start":423.59,"end":426.769,"text":"这不是体现就是他的阶级意识的组成部分啊"},{"start":426.769,"end":427.449,"text":"回过头来讲"},{"start":427.449,"end":430.269,"text":"就是无产者个人由于在心智上受压迫"},{"start":430.269,"end":431.28,"text":"受剥削"},{"start":431.28,"end":434.28,"text":"所以他们从个人心理层面"},{"start":434.28,"end":438.59,"text":"心智层面是难以拥有阶级意识的"},{"start":439.07,"end":441.83,"text":"但是他们可以追随即意识"},{"start":442.15,"end":445.13,"text":"他才可以在行动上追随"},{"start":445.13,"end":448.01,"text":"就是他就算心里面有了阶级意识"},{"start":448.01,"end":451.38,"text":"这个阶级意识只是说他把握到了"},{"start":451.38,"end":452.58,"text":"感受到的阶级意识"},{"start":452.58,"end":456.46,"text":"它不是直接不可能直接由他的主观意识所代表"},{"start":456.92,"end":459.84,"text":"他主观意识就算代表了这个阶级意识"},{"start":459.84,"end":460.96,"text":"没有任何意义"},{"start":460.96,"end":463.46,"text":"他必须追随啊"},{"start":463.46,"end":466.26,"text":"无产者要追随他的阶级意识"},{"start":466.54,"end":469.26,"text":"那么追随他的阶级意识就要怎样"},{"start":469.26,"end":472.46,"text":"就要服从他的阶级纪律啊"},{"start":472.46,"end":476.3,"text":"追随他的阶级机关先锋队"},{"start":476.3,"end":481.64,"text":"还有一个就是要啊采取他的阶级制石"},{"start":481.64,"end":484.31,"text":"阶级的解放方案啊"},{"start":484.31,"end":485.41,"text":"他的阶级路线"},{"start":486.49,"end":488.33,"text":"这叫追随阶级意识"},{"start":488.33,"end":490.539,"text":"阶级意识只能被追随"},{"start":490.539,"end":493.559,"text":"你去理解和体验它"},{"start":493.559,"end":495.95,"text":"思考它没有任何意义"},{"start":495.95,"end":498.21,"text":"无产阶级要做的是行动"},{"start":498.21,"end":500.79,"text":"行动上追随你的阶级意识"},{"start":500.79,"end":504.03,"text":"你当然可以有自己关于阶级解放的意识"},{"start":504.03,"end":506.31,"text":"关于何为阶级纪律的意识"},{"start":506.31,"end":507.91,"text":"关于何为阶级机关"},{"start":507.91,"end":512.208,"text":"什么才是真正的值得追随的阶级机关的意识"},{"start":512.208,"end":515.9,"text":"但是这些是无产者个人的意识"},{"start":515.9,"end":518.26,"text":"无产者个人的思考内容"},{"start":518.26,"end":519.73,"text":"而不是阶级意识"},{"start":519.73,"end":521.37,"text":"无产者追随阶意识"},{"start":521.37,"end":525.55,"text":"就是让自己的生活具有纪律性啊"},{"start":526.07,"end":529.73,"text":"然后是有明确的阶级机关啊"},{"start":529.73,"end":535.24,"text":"我说阶级的思考的官能啊啊自我把握的官能"},{"start":535.24,"end":537.76,"text":"还有明确的阶级知识"},{"start":539.92,"end":543.4,"text":"这些理论我提出来的"},{"start":543.4,"end":544.84,"text":"只有我这样讨论