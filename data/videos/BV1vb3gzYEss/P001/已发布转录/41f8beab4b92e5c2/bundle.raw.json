},{"start":1805.28,"end":1806.12,"text":"你创造它"},{"start":1806.12,"end":1810.54,"text":"你提供创造它的机会的无产者才是无产阶级"},{"start":1810.54,"end":1812.06,"text":"才属于无产阶级"},{"start":1812.06,"end":1814.84,"text":"才应当被无产阶级吸纳利用"},{"start":1814.84,"end":1820.71,"text":"征召和动员才代表无产阶级的长远利益"},{"start":1821.02,"end":1823.3,"text":"这就是我要说的"},{"start":1823.3,"end":1827.62,"text":"那么我们要做到的就是引导"},{"start":1827.62,"end":1830.61,"text":"帮助其提炼"},{"start":1831.62,"end":1838.38,"text":"首先你要引导他能够产生生产出生活纪律啊"},{"start":1839.02,"end":1841.38,"text":"良性的生活纪律"},{"start":1841.83,"end":1844.73,"text":"它在生活当中能能够生产出来"},{"start":1844.73,"end":1846.75,"text":"这个富余的有序度"},{"start":1846.75,"end":1850.93,"text":"引导其生产良性的生活纪律"},{"start":1850.93,"end":1852.47,"text":"二要提炼"},{"start":1852.47,"end":1857.5,"text":"从从这种生活纪律中啊"},{"start":1857.5,"end":1860.06,"text":"提炼他的组织纪律"},{"start":1863.02,"end":1868.22,"text":"然后进一步去经由组织纪律去发起他的啊"},{"start":1868.22,"end":1871.58,"text":"经由组织纪律发起他的斗争纪律"},{"start":1872.83,"end":1875.43,"text":"然后在最后一步由斗争纪律再转向"},{"start":1875.43,"end":1877.31,"text":"去产生它新的生产机遇"},{"start":1878.55,"end":1884.04,"text":"无产阶级这个是独立的自主的生产纪律啊"},{"start":1884.2,"end":1888.29,"text":"而不是说是依附于依附于资产阶级"},{"start":1888.29,"end":1890.55,"text":"资本主义生产关系的生产力率啊"},{"start":1893.25,"end":1895.29,"text":"而且是一个排他的"},{"start":1895.29,"end":1898.01,"text":"并不是说依附于附庸于自然界"},{"start":1898.01,"end":1900.07,"text":"生产关系的生产关系啊"},{"start":1900.07,"end":1903.45,"text":"独立自主的是完整的生产关系"},{"start":1903.45,"end":1909.3,"text":"已经和资产阶级的这个市场链条形同敌国了"},{"start":1909.62,"end":1911.46,"text":"那么这是纪律的四部曲"},{"start":1911.46,"end":1913.38,"text":"从生活纪律凝练到组织纪律"},{"start":1913.38,"end":1915.1,"text":"再发展为斗争纪律"},{"start":1915.1,"end":1917.97,"text":"最后再重新产生啊"},{"start":1917.97,"end":1921.09,"text":"完整自主独立的生产纪律"},{"start":1921.09,"end":1924.17,"text":"这个顺序是不能倒过来的"},{"start":1924.17,"end":1926.09,"text":"因为你给不出来"},{"start":1926.09,"end":1927.63,"text":"你就没有明白吗"},{"start":1927.63,"end":1931.46,"text":"就你不能靠意识形态靠钱"},{"start":1931.46,"end":1933.1,"text":"然后靠人事斗争"},{"start":1934.22,"end":1935.18,"text":"靠虚的东西"},{"start":1935.18,"end":1936.88,"text":"说要把这东西生产出来"},{"start":1936.88,"end":1937.58,"text":"那不行了"},{"start":1937.58,"end":1939.35,"text":"做不到"},{"start":1940.19,"end":1943.35,"text":"但是我不是说那我们什么都不做吗"},{"start":1943.35,"end":1944.58,"text":"不"},{"start":1944.9,"end":1950.08,"text":"那我们就要对无人机进行生活教育和组织教育"},{"start":1950.28,"end":1952.6,"text":"要对其进行教育"},{"start":1952.6,"end":1956.4,"text":"要培养其良好的生活习惯和生活纪律"},{"start":1956.4,"end":1958.14,"text":"要"},{"start":1959.3,"end":1962.66,"text":"要把他的生活习惯当中的纪律性"},{"start":1962.66,"end":1967.1,"text":"转化成啊他的组织纪律"},{"start":1967.1,"end":1968.02,"text":"那组织纪律的话"},{"start":1968.02,"end":1970.66,"text":"你不是说是洗脑灌输"},{"start":1970.66,"end":1972.909,"text":"你是通过教育"},{"start":1972.909,"end":1974.489,"text":"那灌输是一部分啊"},{"start":1974.489,"end":1976.389,"text":"那个灌输论意识形态的灌输"},{"start":1976.389,"end":1978.78,"text":"论纪律是灌输不出来的"},{"start":1978.78,"end":1980.42,"text":"我们要讲的这个是纪律"},{"start":1980.42,"end":1981.3,"text":"只能教育出来"},{"start":1981.3,"end":1982.68,"text":"无法灌输出来"},{"start":1982.68,"end":1984.52,"text":"最后一讲的纪律"},{"start":1984.52,"end":1985.96,"text":"意识形态也可以灌输"},{"start":1985.96,"end":1986.4,"text":"意识形态"},{"start":1986.4,"end":1990.0,"text":"忠诚都可以挂输纪律只能教育"},{"start":1991.64,"end":1995.4,"text":"啊无法灌输啊"},{"start":2000.76,"end":2006.51,"text":"因为这里无产阶级是要作为纪律的生产者"},{"start":2006.51,"end":2008.67,"text":"而不是作为纪律的消费者"},{"start":2008.67,"end":2011.57,"text":"你强加的无产阶级的生活纪律"},{"start":2011.57,"end":2014.61,"text":"强迫的军事纪律"},{"start":2014.61,"end":2016.87,"text":"这是在透支纪律"},{"start":2016.87,"end":2019.5,"text":"明白吗啊"},{"start":2019.5,"end":2024.04,"text":"而是要通过教育才能引导其生产纪律"},{"start":2024.04,"end":2027.46,"text":"那么这个教育首先是从生活教育开始"},{"start":2029.76,"end":2031.38,"text":"生活教育开始"},{"start":2031.38,"end":2034.46,"text":"然后再到这个"},{"start":2036.02,"end":2040.94,"text":"其实还有自然教育啊啊自然和社会教育"},{"start":2044.48,"end":2049.03,"text":"这自然和社会教育其实都是他的组织教育啊"},{"start":2049.03,"end":2050.989,"text":"对于这个无人机个体组织教育"},{"start":2050.989,"end":2054.21,"text":"通过自然教育破除迷信"},{"start":2055.279,"end":2058.079,"text":"啊通过社会教育"},{"start":2058.399,"end":2062.458,"text":"把无产阶从虚伪的堕落的组织当中啊"},{"start":2062.458,"end":2065.27,"text":"他能产生组织关系"},{"start":2065.71,"end":2067.23,"text":"产生先进的组织关系"},{"start":2067.23,"end":2069.719,"text":"在在这种先进的组织关系当中"},{"start":2070.04,"end":2072.96,"text":"去进一步的去教育他们"},{"start":2072.96,"end":2077.96,"text":"那么掌握更多的有可以有分工啊"},{"start":2077.96,"end":2082.498,"text":"怎么说阶级组织内的分工"},{"start":2086.3,"end":2089.42,"text":"机关性的分工呃"},{"start":2089.42,"end":2092.179,"text":"他发挥一个阶级机关的一个功能"},{"start":2092.179,"end":2093.48,"text":"的这样一种分工"},{"start":2093.48,"end":2094.969,"text":"通过这样一种分工"},{"start":2094.969,"end":2098.37,"text":"它可以生产出组织纪律"},{"start":2101.44,"end":2103.76,"text":"啊生产出组织纪律"},{"start":2103.76,"end":2106.0,"text":"那么再通过这种组织纪律凝练"},{"start":2106.0,"end":2108.4,"text":"可以变成有组织的斗争"},{"start":2108.4,"end":2109.54,"text":"抗争纪律"},{"start":2109.54,"end":2111.07,"text":"斗争纪律"},{"start":2112.48,"end":2115.52,"text":"所以纪律啊它是是生产出来的"},{"start":2115.52,"end":2117.4,"text":"它是源头活水"},{"start":2117.4,"end":2120.569,"text":"源头活水是生活教育"},{"start":2120.569,"end":2123.349,"text":"让他们看到资产阶级的生产关系"},{"start":2123.349,"end":2125.889,"text":"资产阶级的生产关系当中"},{"start":2125.889,"end":2128.18,"text":"一定会摧毁他们的生活"},{"start":2128.18,"end":2130.7,"text":"可能会让其中1/5"},{"start":2130.7,"end":2132.82,"text":"1/10的幸运儿的生活过得好"},{"start":2132.82,"end":2134.14,"text":"但是作为一个阶级总体"},{"start":2134.14,"end":2136.46,"text":"他们的生活是要被摧毁的"},{"start":2136.46,"end":2138.58,"text":"是要被践踏的"},{"start":2138.58,"end":2142.99,"text":"通过长远的生活教育啊"},{"start":2142.99,"end":2145.51,"text":"让污染机天然的产生认同啊"},{"start":2145.51,"end":2146.37,"text":"天然的产生"},{"start":2146.37,"end":2149.57,"text":"它是绝不从小处入手"},{"start":2149.57,"end":2151.92,"text":"还有从长远处入手"},{"start":2151.92,"end":2156.98,"text":"从父母子女的未来着手是能够形成"},{"start":2156.98,"end":2160.57,"text":"而且这种生活教育是要以身作则"},{"start":2160.57,"end":2164.39,"text":"而不能只是停留在口头教条当中是没用的"},{"start":2164.39,"end":2166.529,"text":"是要和现实相结合的"},{"start":2166.529,"end":2169.649,"text":"而且实际上很多先进的无产者"},{"start":2169.649,"end":2173.729,"text":"他自己就已经实现了对他自己的生活教育"},{"start":2173.729,"end":2177.79,"text":"我们就是呃我们接触到的十个无产者里面"},{"start":2177.79,"end":2180.37,"text":"可能有四个左右"},{"start":2180.37,"end":2184.64,"text":"就已经是已经已经是生活教育上"},{"start":2184.64,"end":2188.48,"text":"他特别是那种爹妈都是没有保障的"},{"start":2188.48,"end":2191.51,"text":"晚年毫无保障的这种良家子啊"},{"start":2192.77,"end":2198.05,"text":"所以我们讲清楚了最重要的"},{"start":2198.05,"end":2202.45,"text":"或者说现在的主题其实反而是教育啊"},{"start":2203.07,"end":2204.59,"text":"教育"},{"start":2206.18,"end":2208.12,"text":"先锋队在这里起到一个作用"},{"start":2208.12,"end":2211.5,"text":"实际上是要对乌战机进行一个纪律性的教育"},{"start":2212.78,"end":2214.34,"text":"纪律教育"},{"start":2216.02,"end":2220.48,"text":"啊继续教育过程中能生成教育性的纪律"},{"start":2220.48,"end":2221.64,"text":"教育纪律"},{"start":2221.64,"end":2226.8,"text":"教育纪律才他是这个组织纪律的原型"},{"start":2227.139,"end":2229.979,"text":"是生活纪律项"},{"start":2231.64,"end":2236.58,"text":"生活纪律向组织纪律转化的中间过渡"},{"start":2236.58,"end":2238.6,"text":"是教育性的纪律"},{"start":2238.889,"end":2242.469,"text":"因为哪怕现代资本主义国家"},{"start":2242.469,"end":2245.04,"text":"他还是会在生活关系当中"},{"start":2245.04,"end":2246.64,"text":"生无产阶级的生活中"},{"start":2246.64,"end":2248.62,"text":"为他们提供基本技教育"},{"start":2248.62,"end":2252.78,"text":"让他们变成好用的工业螺丝钉的啊"},{"start":2252.78,"end":2254.87,"text":"是由这个作为中介的"},{"start":2254.87,"end":2256.75,"text":"有教育基地作为中介"},{"start":2256.75,"end":2260.87,"text":"那么以一个先进的布尔什维克啊"},{"start":2260.87,"end":2264.27,"text":"或者说这个先进的这个先锋队组织"},{"start":2264.27,"end":2270.74,"text":"他一定会通过首先要给好的环境培养生活纪律"},{"start":2271.06,"end":2273.46,"text":"然后经由教育纪律"},{"start":2273.46,"end":2277.04,"text":"使得生活纪律能够转化为组织纪律"},{"start":2277.04,"end":2279.26,"text":"这是必经之路"},{"start":2279.26,"end":2281.84,"text":"那么这个过程中才能凝练"},{"start":2281.84,"end":2286.5,"text":"凝练出这个长远的阶级意识"},{"start":2289.14,"end":2293.14,"text":"和卓绝的斗争纪律"},{"start":2300.02,"end":2302.38,"text":"我已经讲得这么清楚了"},{"start":2303.69,"end":2306.41,"text":"好吧也讲的清楚"},{"start":2306.41,"end":2307.65,"text":"所以"},{"start":2314.08,"end":2316.04,"text":"那思想内部那些东西呢"},{"start":2316.04,"end":2319.61,"text":"或者说呃会妨碍他们在主观上想清楚"},{"start":2319.61,"end":2321.25,"text":"这些东西呢是意识形态"},{"start":2321.25,"end":2325.17,"text":"所以这个纪律教育同时也要有意识形态教育"},{"start":2327.32,"end":2330.08,"text":"那么意识形态主要是破"},{"start":2331.82,"end":2335.1,"text":"而这个技术教育主要是要去利"},{"start":2337.5,"end":2339.78,"text":"这两者不可偏废"},{"start":2339.78,"end":2341.62,"text":"那么既然你都已经进行这个"},{"start":2341.62,"end":2343.38,"text":"纪律教育和意识形态教育了"},{"start":2343.38,"end":2346.05,"text":"你同时其实可以进行一定的生产教育"},{"start":2346.05,"end":2348.67,"text":"生产生活教育啊"},{"start":2348.67,"end":2350.29,"text":"就日常常识"},{"start":2350.29,"end":2351.39,"text":"日常生活常识"},{"start":2351.39,"end":2353.44,"text":"还有基本生产技能"},{"start":2353.44,"end":2359.11,"text":"来维持这个组织纪律的发生所需要的啊"},{"start":2359.11,"end":2360.35,"text":"客观条件"},{"start":2360.35,"end":2361.57,"text":"客观环境啊"},{"start":2361.57,"end":2365.11,"text":"你总归这这这是要吃要喝啊啊"},{"start":2365.11,"end":2367.21,"text":"要有生存的土壤"},{"start":2369.04,"end":2369.76,"text":"行吧"},{"start":2369.76,"end":2372.14,"text":"那么我们也把这东西讲清楚了"},{"start":2372.14,"end":2374.84,"text":"我无愧于历史啊"},{"start":2374.84,"end":2375.74,"text":"无愧于人民"},{"start":2375.74,"end":2384.08,"text":"无愧于我所我所效忠奉献的这个阶级理想啊"},{"start":2384.08,"end":2385.4,"text":"人类解放路线"},{"start":2386.56,"end":2389.71,"text":"所以我尽到了我的义务啊"},{"start":2389.71,"end":2392.11,"text":"但是就是不仅仅是做这个视频了啊"},{"start":2392.11,"end":2394.31,"text":"实事求是讲啊好吧"},{"start":2394.31,"end":2396.83,"text":"那么我希望大家能把这个问题想清楚"},{"start":2396.83,"end":2399.2,"text":"想明白就讲到这边啊"}],"source":"subtitle"}
