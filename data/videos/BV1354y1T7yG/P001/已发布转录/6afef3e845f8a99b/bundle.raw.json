{"segments":[{"start":0.3,"end":3.099,"text":"呃我们要讲的就是说啊"},{"start":4.72,"end":6.7,"text":"送食品啊"},{"start":9.579,"end":14.16,"text":"呃在一定情况下具有兜底性"},{"start":15.94,"end":18.78,"text":"但是他的兜底性目前不明显"},{"start":18.78,"end":20.28,"text":"劳动群众还吃得起饭"},{"start":20.28,"end":22.24,"text":"但是现在好像有点不太像了"},{"start":22.46,"end":25.98,"text":"我本来认为就是说这个局势不会发展这么快"},{"start":27.48,"end":29.84,"text":"就是无产者"},{"start":29.84,"end":30.62,"text":"现在"},{"start":32.84,"end":33.44,"text":"宝"},{"start":36.46,"end":39.3,"text":"在一段时间这个宝还是可以做到的"},{"start":41.34,"end":42.16,"text":"就是"},{"start":44.16,"end":50.23,"text":"哪怕订单或者说工业效率比较低的情况下"},{"start":50.23,"end":52.44,"text":"我还能吃得饱啊"},{"start":52.44,"end":55.5,"text":"但是目前看越越看这个越送食品"},{"start":55.5,"end":57.099,"text":"越来越具有兜底性的"},{"start":58.72,"end":64.05,"text":"比如在这个中华园这个桥洞下面都住满了人啊"},{"start":64.05,"end":65.239,"text":"睡满了人"},{"start":66.24,"end":68.52,"text":"这个这个时候"},{"start":70.22,"end":72.85,"text":"你去送点水饺啥的"},{"start":72.85,"end":75.2,"text":"某种意义上有兜底性的"},{"start":75.8,"end":79.0,"text":"因为这几天还蛮冷的啊"},{"start":79.0,"end":82.86,"text":"那我们要讲的就是说送食品"},{"start":84.6,"end":85.82,"text":"是第一步"},{"start":85.82,"end":90.18,"text":"我更希望你们在一定程度上能进一步啊"},{"start":90.18,"end":93.96,"text":"就是说能送点一些非处方"},{"start":96.4,"end":97.2,"text":"药品"},{"start":100.32,"end":101.2,"text":"然后"},{"start":103.0,"end":104.98,"text":"这个按一定比例来啊"},{"start":105.24,"end":111.92,"text":"然后教导同时能够教导啊怎么用"},{"start":114.68,"end":116.5,"text":"这个劳动群众啊"},{"start":116.5,"end":117.58,"text":"他很容易受伤"},{"start":117.58,"end":118.44,"text":"你知道吗"},{"start":119.22,"end":123.08,"text":"但是这个东西呢我老师说你去做的话"},{"start":123.08,"end":124.04,"text":"实事求是"},{"start":124.04,"end":126.399,"text":"这就很敏感了"},{"start":128.299,"end":129.969,"text":"就非常敏感了"},{"start":129.969,"end":132.519,"text":"因为啊饭所有人都吃的"},{"start":132.519,"end":135.88,"text":"送食品是所有人都吃的"},{"start":135.899,"end":138.84,"text":"所有人都吃饭的"},{"start":140.54,"end":143.94,"text":"但是并非所有人都要药品"},{"start":147.32,"end":149.38,"text":"那你如果说一个人生病了"},{"start":149.38,"end":151.48,"text":"那你就要就私下给不对"},{"start":151.48,"end":154.52,"text":"就会有一个私下赠与"},{"start":155.619,"end":157.799,"text":"就没有办法公开了"},{"start":157.799,"end":159.479,"text":"那你私下就是地下性"},{"start":159.479,"end":160.259,"text":"秘密性"},{"start":160.259,"end":162.08,"text":"那就很敏感了"},{"start":163.1,"end":166.38,"text":"但是这个路实事求是讲"},{"start":167.58,"end":168.5,"text":"我跟你讲"},{"start":168.5,"end":172.92,"text":"就是说谁把无产者当人看"},{"start":176.6,"end":178.4,"text":"当人命看"},{"start":182.339,"end":185.46,"text":"谁就是居天下之治政"},{"start":187.14,"end":191.08,"text":"把无产者的人命当人命看"},{"start":196.58,"end":197.83,"text":"这样去做"},{"start":197.83,"end":198.7,"text":"那我说了"},{"start":201.22,"end":202.98,"text":"我们绝对不做这种人"},{"start":203.06,"end":206.959,"text":"我们绝对不会去说山洞呃"},{"start":206.959,"end":209.809,"text":"我们的劳动者去造反作乱"},{"start":209.809,"end":211.189,"text":"我们绝不这样做"},{"start":211.189,"end":213.049,"text":"我们是把他们当人看"},{"start":213.049,"end":215.08,"text":"把他们的命当命看"},{"start":216.82,"end":218.82,"text":"啊为什么这个工作很重要呢"},{"start":219.9,"end":220.84,"text":"我说了"},{"start":221.559,"end":223.559,"text":"我们越是这样去做"},{"start":223.559,"end":228.36,"text":"那么月当我们的啊"},{"start":228.36,"end":230.08,"text":"我们的这个劳动群众"},{"start":232.92,"end":238.38,"text":"啊无依无靠生命啊"},{"start":238.38,"end":241.26,"text":"生命受到威胁的时候"},{"start":243.8,"end":245.8,"text":"你可以说他没有思想觉悟"},{"start":245.8,"end":246.94,"text":"精神受威胁"},{"start":246.94,"end":247.84,"text":"精神被腐化"},{"start":247.84,"end":249.07,"text":"他们可能觉察不到"},{"start":249.07,"end":251.21,"text":"但是当他们生命受威胁时"},{"start":251.21,"end":252.44,"text":"他们一定觉察到"},{"start":252.44,"end":254.12,"text":"一定会觉察到这一点"},{"start":254.12,"end":255.65,"text":"那么觉察到这一点的时候"},{"start":255.65,"end":256.49,"text":"他又无依无靠"},{"start":256.49,"end":257.56,"text":"他能找谁"},{"start":258.619,"end":262.58,"text":"那么这种情况下他能找谁"},{"start":262.82,"end":265.28,"text":"我希望肯定是有更强大的"},{"start":265.28,"end":267.34,"text":"更伟大的力量站出来了"},{"start":269.6,"end":272.28,"text":"啊这么一个生命受威胁"},{"start":273.48,"end":275.54,"text":"生命生物也当然有两种情况"},{"start":275.54,"end":277.34,"text":"一是直接危害他们"},{"start":277.34,"end":279.04,"text":"一是一个直接的危害"},{"start":279.84,"end":281.75,"text":"直接外敌危害"},{"start":281.75,"end":285.79,"text":"还有一种情况当然强迫送死"},{"start":285.79,"end":287.06,"text":"当然也是了"},{"start":292.92,"end":296.36,"text":"劳动群众生命受威胁时"},{"start":296.36,"end":297.62,"text":"他们找谁"},{"start":298.319,"end":299.64,"text":"就这个问题"},{"start":299.979,"end":304.88,"text":"那么我们平时要做的就是尽量具有一个"},{"start":305.06,"end":306.62,"text":"你说这个兜底性"},{"start":306.62,"end":309.18,"text":"我们做的事情目前不具有兜底性"},{"start":309.219,"end":313.239,"text":"五斗地形我们也不追求说我们越俎代庖"},{"start":313.239,"end":316.359,"text":"那么这个是最伟大最强大的力量去做的事情"},{"start":316.359,"end":318.71,"text":"我们是很弱小的"},{"start":318.71,"end":320.44,"text":"很不够档次的"},{"start":320.479,"end":322.579,"text":"我们是很平凡的"},{"start":322.579,"end":324.139,"text":"很弱小的"},{"start":324.139,"end":325.94,"text":"很贫穷的"},{"start":326.42,"end":328.37,"text":"很困顿的一个力量"},{"start":328.37,"end":331.759,"text":"我们甚至都不能说我们自己是力量啊"},{"start":331.759,"end":333.949,"text":"我们不能说我们具有某种兜底性"},{"start":333.949,"end":335.599,"text":"如果我们不信"},{"start":335.599,"end":339.5,"text":"说我们做的这些鸟事居然具有兜底性了"},{"start":339.56,"end":341.0,"text":"那是我们的错吗"},{"start":342.26,"end":343.94,"text":"那是我们刻意要这样的吗"},{"start":343.94,"end":345.32,"text":"那不是的"},{"start":346.98,"end":351.2,"text":"虎寺之出云霞是谁之过眼云"},{"start":352.639,"end":355.059,"text":"我不希望我永远不追求"},{"start":355.059,"end":357.6,"text":"说我们做的这些事情具有什么兜底性"},{"start":360.34,"end":361.52,"text":"没有吧"},{"start":362.42,"end":364.24,"text":"我们送这点水饺"},{"start":364.24,"end":365.8,"text":"送这点啊"},{"start":365.8,"end":367.24,"text":"如果我们送点什么碘酒"},{"start":367.24,"end":368.05,"text":"送点什么"},{"start":368.05,"end":370.18,"text":"ok帮这些事"},{"start":370.18,"end":372.98,"text":"既然居然具有兜底性的"},{"start":372.98,"end":374.1,"text":"那乖乖"},{"start":374.26,"end":376.3,"text":"那是个什么世道了"},{"start":376.3,"end":378.94,"text":"所以我永远不去刻意的追求"},{"start":378.94,"end":379.9,"text":"我们不主动追求"},{"start":379.9,"end":381.9,"text":"我们做的事情有兜底性啊"},{"start":382.759,"end":388.1,"text":"但是我们可以在不具有兜底性的情况下"},{"start":388.1,"end":390.74,"text":"改善劳动群众的生活状况"},{"start":390.74,"end":392.9,"text":"甚至生健康状况"},{"start":392.9,"end":394.1,"text":"我们可以送一些食品"},{"start":394.1,"end":395.959,"text":"营养食品啊"},{"start":395.959,"end":398.359,"text":"我们可以力所能及的营养均衡点"},{"start":398.359,"end":399.42,"text":"有肉有菜"},{"start":399.52,"end":402.52,"text":"可以送一些非处方药品"},{"start":402.52,"end":404.8,"text":"尤其是最好它不是个药品"},{"start":404.8,"end":409.6,"text":"它就是一些啊创口贴啊"},{"start":413.12,"end":413.92,"text":"了解吗"},{"start":413.92,"end":417.25,"text":"创口贴或者说一些膏药啊"},{"start":417.25,"end":420.3,"text":"膏药的高膏药"},{"start":421.62,"end":424.02,"text":"还有一些这个软膏"},{"start":424.02,"end":425.1,"text":"那就皮炎平"},{"start":425.1,"end":425.86,"text":"你知道吗"},{"start":426.36,"end":427.56,"text":"平原皮啊"},{"start":427.56,"end":428.04,"text":"皮啊"},{"start":428.04,"end":429.12,"text":"皮炎平"},{"start":429.12,"end":430.62,"text":"皮炎平啊"},{"start":431.52,"end":432.71,"text":"皮炎平"},{"start":432.71,"end":435.98,"text":"那或者哎这个牌啊"},{"start":435.98,"end":437.68,"text":"或者金达克宁"},{"start":438.06,"end":439.68,"text":"或者什么双氧水"},{"start":439.68,"end":442.78,"text":"碘酒碘伏啊这东西"},{"start":442.78,"end":446.5,"text":"然后呢你可以教导他们如何用啊"},{"start":446.5,"end":447.7,"text":"教他们怎么用"},{"start":451.1,"end":453.52,"text":"啊怎么又怎么处理伤口"},{"start":453.52,"end":455.38,"text":"怎么包扎啊"},{"start":455.38,"end":456.94,"text":"怎么在受伤了之后呢"},{"start":456.94,"end":459.99,"text":"自己能够快点恢复健康"},{"start":459.99,"end":461.58,"text":"减少一点"},{"start":461.58,"end":462.99,"text":"这个都是力所能及"},{"start":462.99,"end":464.3,"text":"减少1.4损失"},{"start":464.34,"end":466.14,"text":"在力所能及的情况下"},{"start":466.14,"end":468.42,"text":"当然我们绝不越俎代庖"},{"start":468.42,"end":470.76,"text":"我们绝不做法律不许可的事情"},{"start":470.76,"end":473.26,"text":"比如说我们有什么药师资格证"},{"start":473.26,"end":476.319,"text":"什么医师资格证当然没有对吧"},{"start":476.319,"end":478.059,"text":"我们尽量按照科学的"},{"start":478.059,"end":482.1,"text":"按照这个啊一些常识的方式告诉各位"},{"start":482.1,"end":485.46,"text":"买八怎么处理伤口啊"},{"start":485.46,"end":489.99,"text":"我们不去给那种说得了特异疾病的人"},{"start":489.99,"end":494.19,"text":"私下去赠予一些昂贵的特殊的药品"},{"start":494.19,"end":495.51,"text":"我不去做这种事"},{"start":495.51,"end":498.03,"text":"因为你非要说我他妈地下搞地下结社了"},{"start":498.03,"end":502.28,"text":"那我们公开的去给一些普通的大路货"},{"start":503.46,"end":505.28,"text":"力所能给点创口贴"},{"start":505.28,"end":507.98,"text":"甚至给冬天的人家给点润唇膏"},{"start":507.98,"end":510.44,"text":"给点护手霜啊"},{"start":510.44,"end":511.46,"text":"护手霜"},{"start":512.64,"end":517.94,"text":"夏天嘛送一点这个房啊"},{"start":517.94,"end":520.76,"text":"防防中暑的啊"},{"start":520.76,"end":521.75,"text":"一些什么"},{"start":521.75,"end":522.559,"text":"我不知道"},{"start":522.559,"end":523.818,"text":"我不做广告啊"},{"start":523.98,"end":527.34,"text":"啊我不是王老爷防中暑的什么啊"},{"start":527.34,"end":529.26,"text":"口腔溃疡了就给点西瓜霜"},{"start":529.26,"end":531.47,"text":"这种明白吗"},{"start":531.47,"end":532.7,"text":"力所能及"},{"start":533.72,"end":535.04,"text":"不要花很多钱"},{"start":535.04,"end":538.75,"text":"因为自己用你的余力来做"},{"start":538.75,"end":541.72,"text":"不要透支自己有多少做多少"},{"start":541.72,"end":544.079,"text":"实实在在本本分分"},{"start":544.34,"end":547.14,"text":"这个是mojo兜底性"},{"start":547.14,"end":549.48,"text":"如果说他不信具有兜底性的话"},{"start":549.48,"end":552.38,"text":"那不是我们故意让别人贫穷"},{"start":552.38,"end":553.85,"text":"故意让别人困苦的"},{"start":553.85,"end":556.37,"text":"不是我要让劳动者贫穷"},{"start":556.37,"end":557.839,"text":"让劳动者困苦的"},{"start":558.66,"end":559.94,"text":"明白吗"},{"start":559.94,"end":561.68,"text":"跟我没关系啊"},{"start":561.68,"end":562.82,"text":"他这个东西"},{"start":562.82,"end":566.62,"text":"最后他比如说他在桥洞下面瑟瑟发抖"},{"start":566.62,"end":568.12,"text":"竟然靠我的饺子"},{"start":568.12,"end":569.98,"text":"但是我还我还没有去送呢"},{"start":569.98,"end":572.26,"text":"我没有说我要去中华园送送水饺"},{"start":572.26,"end":572.95,"text":"我不敢"},{"start":572.95,"end":574.42,"text":"我胆小人呢"},{"start":574.42,"end":576.82,"text":"除非谁啊"},{"start":576.82,"end":578.8,"text":"有本事给我照着奶啊"},{"start":580.82,"end":581.83,"text":"了解吗"},{"start":581.83,"end":586.959,"text":"所以说光是送水饺送吃的"},{"start":588.96,"end":590.63,"text":"或者说我跟你说"},{"start":590.63,"end":592.8,"text":"最终我就讲清楚一个道理"},{"start":594.94,"end":597.6,"text":"我们做这做这些事啊"},{"start":597.6,"end":599.219,"text":"我们做这些事"},{"start":600.2,"end":602.26,"text":"我们本来是想锦上添花的"},{"start":602.26,"end":603.01,"text":"你知道吗"},{"start":603.01,"end":604.66,"text":"锦上添花而已"},{"start":605.54,"end":608.02,"text":"没有人想雪中送炭"},{"start":608.02,"end":611.71,"text":"因为我们不想他处在冰雪之中"},{"start":611.71,"end":613.6,"text":"他的冰雪也不是我创造的"},{"start":613.6,"end":615.46,"text":"我们本来是想锦上添花的"},{"start":615.46,"end":617.02,"text":"就帮帮忙"},{"start":617.02,"end":619.099,"text":"就是个添点花头"},{"start":620.2,"end":621.599,"text":"做个牵头"},{"start":622.68,"end":623.66,"text":"那我们做"},{"start":623.66,"end":624.56,"text":"如果不信"},{"start":624.56,"end":627.66,"text":"我们做的这些事情竟然变成了雪中送炭"},{"start":631.34,"end":636.8,"text":"那么你就怪不得劳动群众哦"},{"start":636.8,"end":639.32,"text":"劳动群众在大雪中"},{"start":639.32,"end":640.74,"text":"在寒冷的时候"},{"start":640.78,"end":645.64,"text":"在键盘交货的时候会想到我们这个boss"},{"start":645.64,"end":648.089,"text":"我们要去让他想到我们"},{"start":648.089,"end":650.009,"text":"这不是我们让他寒冷"},{"start":650.009,"end":650.969,"text":"让他痛苦"},{"start":650.969,"end":657.82,"text":"我始终说虎四之出云霞是谁之过也余啊"},{"start":657.82,"end":659.2,"text":"所以我觉得我们做这些事情"},{"start":659.2,"end":660.7,"text":"依然可以放心大胆的做"},{"start":660.7,"end":663.079,"text":"这个大雪不是我做出来的"},{"start":663.94,"end":666.54,"text":"我也不是说想让我那一点点花头"},{"start":666.54,"end":669.18,"text":"那点添头变成雪中的炭火"},{"start":669.18,"end":672.76,"text":"我顶多算一个这个小火柴"},{"start":672.76,"end":673.36,"text":"你知道吗"},{"start":675.28,"end":676.16,"text":"了解吗"},{"start":678.74,"end":680.54,"text":"那就劳动群众寒冷的时候"},{"start":680.54,"end":682.52,"text":"居然想到的是一根小火柴"},{"start":682.52,"end":685.479,"text":"而不是想到的是大家围在一起烤的大火堆"},{"start":687.42,"end":690.319,"text":"那至于不能怪在我小火柴头上啊"},{"start":695.7,"end":696.59,"text":"对吧"},{"start":696.59,"end":698.42,"text":"我就是个小火柴"},{"start":698.42,"end":700.099,"text":"我也不卖女孩"},{"start":702.44,"end":704.2,"text":"啊我实事求是这样"},{"start":706.54,"end":708.79,"text":"所以这个信念是"},{"start":708.79,"end":712.98,"text":"或者说这个逻辑实际上是是非常是"},{"start":712.98,"end":716.46,"text":"我从来没有说想要事物发展的危急状态"},{"start":716.46,"end":720.56,"text":"或者说是一个啊劳动群众饥寒交迫的那种状况"},{"start":720.56,"end":721.76,"text":"但是这个逻辑"},{"start":721.76,"end":724.79,"text":"如果这个现实逻辑往那个方向发展"},{"start":724.79,"end":726.56,"text":"那么这个答案就非常明确了"},{"start":726.56,"end":728.58,"text":"我们送温暖"},{"start":728.58,"end":732.459,"text":"但是这个温暖我们仅仅是送温暖而已"},{"start":732.54,"end":734.64,"text":"温饱啊"},{"start":734.64,"end":735.81,"text":"送了一点点温饱"},{"start":735.81,"end":738.97,"text":"一点点就是一点我们送一点温暖"},{"start":738.97,"end":741.04,"text":"一点点可口啊"},{"start":741.04,"end":742.63,"text":"一点点而已啊"},{"start":742.63,"end":749.78,"text":"一点点的那个啊一西一点点的这个医药废除王"},{"start":749.78,"end":752.78,"text":"要废除魔咬合格的"},{"start":752.78,"end":753.76,"text":"正规的"},{"start":754.38,"end":756.62,"text":"当然什么莲花清瘟就别别送了啊"},{"start":756.62,"end":758.0,"text":"这个东西啊"},{"start":758.0,"end":760.88,"text":"一般人健康的时候吃那玩意也没用啊"},{"start":762.1,"end":763.02,"text":"不健康生"},{"start":763.02,"end":763.979,"text":"那我就不知道"},{"start":765.92,"end":769.57,"text":"啊我们只是送送一点这些东西"},{"start":769.57,"end":771.1,"text":"但是如果太冷了"},{"start":771.1,"end":775.56,"text":"那这个东西就也会在群众心中变得好大好大"},{"start":775.56,"end":776.34,"text":"那我不是"},{"start":776.34,"end":779.54,"text":"我想他的应该有更大的吗"},{"start":779.54,"end":780.32,"text":"应该有吧"},{"start":780.32,"end":781.82,"text":"跟天一样大的"},{"start":781.82,"end":782.96,"text":"比天还大的"},{"start":782.96,"end":783.98,"text":"哪有围着我"},{"start":783.98,"end":786.0,"text":"我这种蚊虫啊"},{"start":786.0,"end":788.52,"text":"这种啊一点点这种火光"},{"start":789.48,"end":791.78,"text":"我这萤火虫一点点微光"},{"start":791.78,"end":795.98,"text":"我那我凭什么与日月争辉啊"},{"start":797.06,"end":797.9,"text":"可以吗"},{"start":804.46,"end":806.97,"text":"就这个逻辑就是这个逻辑"},{"start":806.97,"end":808.26,"text":"我们的力量"},{"start":808.26,"end":811.74,"text":"我们的力量