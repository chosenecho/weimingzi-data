{"segments":[{"start":0.08,"end":1.49,"text":"冤有头债有主"},{"start":1.49,"end":5.03,"text":"犹太人就不应该居住在以色列"},{"start":5.03,"end":9.48,"text":"犹太人已经上千年是居住在欧洲"},{"start":14.56,"end":16.11,"text":"二战之后"},{"start":16.11,"end":20.52,"text":"英美帝国主义打着所谓犹太复国主义的幌子"},{"start":20.52,"end":22.56,"text":"让他们回到几千年前"},{"start":22.56,"end":26.85,"text":"宗教经典神话当中所赋予它的应许之地"},{"start":26.85,"end":29.88,"text":"实际上是英帝国主义的殖民地"},{"start":29.88,"end":32.22,"text":"巴勒斯坦划了一块"},{"start":32.22,"end":35.95,"text":"让这些欧洲人通通到那里去居住"},{"start":35.95,"end":38.08,"text":"因为在二战期间"},{"start":38.08,"end":40.45,"text":"这些欧这些欧洲人"},{"start":40.45,"end":45.62,"text":"犹太人被他自己的不仅是二战期间的"},{"start":45.62,"end":46.46,"text":"二战之前"},{"start":46.46,"end":52.59,"text":"这整个欧洲有长达上千年的反犹排犹史"},{"start":56.4,"end":61.9,"text":"把他的内在矛盾输出到中东地区"},{"start":61.9,"end":63.49,"text":"输出到阿拉伯世界"},{"start":63.49,"end":66.81,"text":"阿拉伯世界在那里定居已经上千年了"},{"start":66.81,"end":69.69,"text":"一下子让几百万人口挤到"},{"start":69.69,"end":73.89,"text":"它本来生存就非常困难的"},{"start":74.65,"end":75.51,"text":"巴勒斯坦"},{"start":77.61,"end":84.8,"text":"去了之后就像有点就像日寇入侵一样的"},{"start":84.8,"end":89.84,"text":"垦殖团就仰仗着他的宗主国"},{"start":89.84,"end":95.02,"text":"仰仗着英帝国主义和美帝国主义的武力支援"},{"start":95.6,"end":97.45,"text":"实际上就是殖民战争啊"},{"start":97.45,"end":100.48,"text":"只不过这一说殖民者不是说英国人"},{"start":100.48,"end":102.57,"text":"美国人是英国人"},{"start":102.57,"end":106.56,"text":"美国人把在欧洲没有立足之地的人"},{"start":106.56,"end":108.59,"text":"安排到那边去"},{"start":108.93,"end":112.84,"text":"那么事实上以色列的犹太人"},{"start":114.4,"end":120.52,"text":"他做的也是一个为英美帝国主义的利益啊"},{"start":120.52,"end":126.1,"text":"去介入压制控制"},{"start":126.1,"end":127.509,"text":"调拨离间"},{"start":127.509,"end":129.669,"text":"以及直接的这个武装"},{"start":129.669,"end":131.709,"text":"摧毁和打击阿拉伯势力"},{"start":131.709,"end":135.94,"text":"打击这个世界能源心脏的一枚棋子"},{"start":135.94,"end":137.14,"text":"一个桥头堡"},{"start":138.16,"end":141.82,"text":"它就英美帝国主义的一个工具"},{"start":143.9,"end":145.66,"text":"平民全民皆兵"},{"start":147.28,"end":149.16,"text":"武装垦殖团"},{"start":149.62,"end":153.3,"text":"就跟这个我国啊"},{"start":153.3,"end":159.94,"text":"这个黎寿的不幸的被这个日寇侵占"},{"start":159.94,"end":162.22,"text":"那肯之团一样的这种东西"},{"start":162.22,"end":165.81,"text":"到时候我说阿拉伯国家能够团结起来"},{"start":165.81,"end":168.67,"text":"统一起来啊"},{"start":168.67,"end":170.77,"text":"就像当年的中国一样"},{"start":170.77,"end":172.24,"text":"团结起来统一起来"},{"start":172.24,"end":176.46,"text":"到时候是不是垦殖团全都区全都遣送的"},{"start":176.46,"end":177.57,"text":"全都遣回去的"},{"start":177.57,"end":178.53,"text":"遣返回去的"},{"start":178.53,"end":181.23,"text":"不是说你在这里住了几十年"},{"start":183.74,"end":186.94,"text":"当时在我国的东北地区"},{"start":186.94,"end":191.01,"text":"在什么朝鲜垦殖的日本老百姓也有一代"},{"start":191.01,"end":191.55,"text":"两代人了"},{"start":191.55,"end":194.0,"text":"也好几十年呢"},{"start":196.58,"end":201.57,"text":"等到这个中华民族恢复独立自主了"},{"start":201.57,"end":203.25,"text":"那这些殖民者入侵者"},{"start":203.25,"end":205.53,"text":"我不管你几代"},{"start":206.86,"end":208.5,"text":"要把你遣送回去的"},{"start":208.5,"end":211.53,"text":"我认为阿拉伯世界的所有的老百姓"},{"start":211.53,"end":215.059,"text":"有识之士能够容忍他们在那边住着"},{"start":215.059,"end":217.069,"text":"其实已经是一个极大的容忍了"},{"start":217.069,"end":217.639,"text":"为什么"},{"start":217.639,"end":219.199,"text":"毕竟形势比人强啊"},{"start":219.199,"end":221.14,"text":"你看以色列空袭"},{"start":221.14,"end":223.18,"text":"今天说空袭伊朗"},{"start":223.18,"end":225.28,"text":"随便空袭的黎巴嫩"},{"start":225.28,"end":226.78,"text":"叙利亚"},{"start":227.0,"end":228.82,"text":"他这个都不需要什么宣战的"},{"start":228.82,"end":229.84,"text":"都不需要任何的"},{"start":229.84,"end":233.3,"text":"以色列就是惯常的不停的去袭击他们"},{"start":233.3,"end":235.52,"text":"国际新闻都出不了一点水花的"},{"start":235.52,"end":235.82,"text":"为什么"},{"start":235.82,"end":241.11,"text":"因为国际新闻被帝国主义势力控制着"},{"start":241.39,"end":242.73,"text":"他想炸就炸"},{"start":244.17,"end":245.79,"text":"今天炸死了多少平民"},{"start":245.79,"end":249.15,"text":"明天炸了死了什么的"},{"start":252.36,"end":254.0,"text":"所以我们说了"},{"start":254.0,"end":258.019,"text":"要停止一切占领"},{"start":259.32,"end":261.41,"text":"但是他有这个定居"},{"start":261.41,"end":263.15,"text":"以色列犹太人定居点"},{"start":263.15,"end":265.34,"text":"对于这个生存空间的侵占"},{"start":265.34,"end":267.799,"text":"约旦河西岸都已经开始"},{"start":268.919,"end":270.439,"text":"那阿拉伯人在约旦"},{"start":270.439,"end":272.839,"text":"约旦河西岸的那个定居点"},{"start":272.839,"end":274.759,"text":"都已经是离约旦河越来越远"},{"start":274.759,"end":277.289,"text":"越来越远越来越远了"},{"start":279.08,"end":284.45,"text":"全被啊全被逐步逐步蚕食"},{"start":284.45,"end":288.23,"text":"逐步侵占了这种所作所为"},{"start":288.23,"end":292.66,"text":"实事求是讲和日寇有什么区别"},{"start":292.66,"end":295.0,"text":"没多大区别"},{"start":298.68,"end":301.91,"text":"而且现在正在发生的事情"},{"start":301.91,"end":303.41,"text":"他们要对他们"},{"start":303.41,"end":307.1,"text":"这个有点像那个什么刘慈欣一个小说里面哦"},{"start":307.1,"end":308.84,"text":"就就是三体里面"},{"start":308.84,"end":313.49,"text":"三体星人把人类全部集中在澳大利亚"},{"start":314.94,"end":317.06,"text":"这以色列的他的右翼分子"},{"start":318.5,"end":321.76,"text":"把200多万阿拉伯人"},{"start":321.76,"end":326.03,"text":"集中在这300多平方公里的加沙地带"},{"start":326.03,"end":328.37,"text":"那么小的地方塞了200多万人"},{"start":328.37,"end":330.35,"text":"人口密度是上海的多少倍"},{"start":330.35,"end":332.4,"text":"东京的多少倍"},{"start":333.04,"end":334.68,"text":"是大号城中村"},{"start":334.68,"end":335.94,"text":"说的好听叫城中村"},{"start":335.94,"end":336.6,"text":"说难听点"},{"start":336.6,"end":341.22,"text":"那就是个监视居住的周围一圈给你强奸起来"},{"start":341.56,"end":342.72,"text":"就是个集中营"},{"start":344.82,"end":350.7,"text":"现在因为巴勒斯坦人的反抗"},{"start":354.06,"end":356.14,"text":"杀了他的平民"},{"start":358.2,"end":362.12,"text":"要求巴勒斯坦人就要求这个"},{"start":365.02,"end":367.86,"text":"所以他们说恐怖分子把人质交出来"},{"start":367.86,"end":368.7,"text":"不把人质交出来"},{"start":368.7,"end":370.2,"text":"他就断水断电"},{"start":370.2,"end":372.929,"text":"对加沙地带断水断电"},{"start":372.929,"end":376.889,"text":"那我请问这到底谁是恐怖分子"},{"start":380.64,"end":384.33,"text":"哈马斯抓了你可能几百号或者几10号人质"},{"start":384.33,"end":386.25,"text":"那我反过来问你"},{"start":386.25,"end":387.93,"text":"以色列右翼政府"},{"start":387.93,"end":392.9,"text":"把这200万加沙地带的老弱病残"},{"start":392.9,"end":394.4,"text":"或者就是他老百姓"},{"start":394.4,"end":396.71,"text":"200万老百姓里面不可能全是恐怖分子吧"},{"start":396.71,"end":399.799,"text":"那这200万人都是你的人质"},{"start":404.28,"end":405.14,"text":"不说了"},{"start":405.14,"end":406.4,"text":"哈马斯确实是恐怖分子"},{"start":406.4,"end":408.02,"text":"他抓了几百号人质"},{"start":408.02,"end":410.9,"text":"你以前抓了几百万号人质"},{"start":410.9,"end":412.83,"text":"你现在断水断电"},{"start":415.02,"end":418.22,"text":"而且还把它全面封锁一个定居点"},{"start":418.22,"end":420.32,"text":"一个定居点去扫"},{"start":420.98,"end":424.299,"text":"而且据国际媒体"},{"start":429.73,"end":431.77,"text":"已经开始有报复性的仇杀了"},{"start":431.77,"end":434.53,"text":"他是地面部队进去一个个扫荡了"},{"start":439.02,"end":441.8,"text":"已经开始在在加沙地带里面的清真寺"},{"start":441.8,"end":445.64,"text":"开始有这个种族屠杀"},{"start":446.23,"end":448.53,"text":"开始发声了"},{"start":450.58,"end":456.66,"text":"你把这几百万老百姓都当成人质攥在手里"},{"start":459.9,"end":462.2,"text":"谁是最大的恐怖分子"},{"start":462.2,"end":465.2,"text":"内塔尼亚胡政府是最大的恐怖分子"},{"start":465.2,"end":468.309,"text":"是全世界最大的恐怖分子"},{"start":469.96,"end":472.35,"text":"哪有这种说法的"},{"start":472.87,"end":475.89,"text":"因为抓了你这个都是完全不成比例的"},{"start":475.89,"end":478.669,"text":"你们都在玩什么电车游戏吗"},{"start":478.669,"end":483.409,"text":"电车游戏里面我们知不知道哪个是正确选项"},{"start":483.409,"end":487.04,"text":"但是电车电车难题里面"},{"start":487.04,"end":491.21,"text":"选压死人多的人明显多于那个好几十倍甚"},{"start":491.21,"end":494.29,"text":"我们这里说几万倍的压死一个人"},{"start":494.29,"end":495.31,"text":"还是压死1万个人"},{"start":495.31,"end":499.27,"text":"选压死1万个人的那个答案肯定不是正确答案"},{"start":502.94,"end":505.96,"text":"以色列右翼分子现在要做的"},{"start":505.96,"end":507.67,"text":"就是说要选这个答案"},{"start":507.67,"end":510.28,"text":"他认为这是正确答案"},{"start":512.02,"end":513.6,"text":"你不交还我几10号人"},{"start":513.6,"end":515.22,"text":"我要让你几百万人"},{"start":515.22,"end":516.36,"text":"人道主义灾难"},{"start":516.36,"end":518.38,"text":"饥饿断水断电"},{"start":518.38,"end":519.88,"text":"每天死上千号"},{"start":519.88,"end":520.75,"text":"上万号"},{"start":520.75,"end":522.65,"text":"你跟恐怖分子有什么区别"},{"start":522.65,"end":524.63,"text":"这些人这几百万号人"},{"start":524.63,"end":525.41,"text":"200万号人"},{"start":525.41,"end":529.399,"text":"不就是捏在你手里面的人质嘛"},{"start":532.399,"end":535.69,"text":"国就一整个巴勒斯坦民族"},{"start":535.69,"end":538.3,"text":"如果它内在的不满足你的要求"},{"start":538.3,"end":541.77,"text":"他就把这或者一整个阿拉伯世界"},{"start":541.93,"end":544.4,"text":"不满足你的要求"},{"start":545.74,"end":546.69,"text":"什么要求"},{"start":546.69,"end":548.52,"text":"你现在最希望的是什么呀"},{"start":548.52,"end":552.6,"text":"最希望就这200万人通过那个"},{"start":553.68,"end":557.18,"text":"埃及人在走廊有一小块是和埃及接壤的"},{"start":557.18,"end":558.41,"text":"全都逃到埃及去"},{"start":558.41,"end":562.0,"text":"这200万难民由阿拉伯世界自己消化"},{"start":562.0,"end":563.59,"text":"阿拉伯世界穷呀"},{"start":563.59,"end":566.13,"text":"埃及不是一个富裕的国家"},{"start":566.13,"end":569.47,"text":"以色列要求的就是这个拿着200"},{"start":569.47,"end":571.93,"text":"你不接收这200万难民"},{"start":571.93,"end":574.48,"text":"或者说你不把这块地盘给我"},{"start":574.48,"end":575.17,"text":"你懂吗"},{"start":575.17,"end":578.37,"text":"剩下的加湿地带就是阿拉伯人在以色列"},{"start":578.37,"end":581.01,"text":"剩下的可以说是一个比较成建制的"},{"start":581.01,"end":581.85,"text":"掌握了一个地盘"},{"start":581.85,"end":583.17,"text":"这就是侵略者"},{"start":583.17,"end":583.96,"text":"你知道吗"},{"start":583.96,"end":587.2,"text":"你你你要么把这块地给我"},{"start":587.2,"end":588.85,"text":"你这里面人全都滚蛋"},{"start":588.85,"end":590.26,"text":"不然我就断水断电"},{"start":590.26,"end":592.21,"text":"把他们全饿死"},{"start":592.61,"end":595.87,"text":"把他们全全渴死"},{"start":595.87,"end":597.1,"text":"缺医少药"},{"start":597.1,"end":599.26,"text":"我还一个点一个点去扫一"},{"start":599.26,"end":601.24,"text":"揪出里面恐怖分子为名"},{"start":601.24,"end":603.01,"text":"让你不能劳作"},{"start":603.01,"end":604.44,"text":"没饭吃"},{"start":604.44,"end":606.48,"text":"全部给你包围起来"},{"start":606.48,"end":610.74,"text":"这完全是这是侵略者行径"},{"start":612.3,"end":616.26,"text":"那些徒弟本来就不是他的那些土地"},{"start":616.26,"end":619.76,"text":"在英国殖民者殖民之前控制之前"},{"start":619.76,"end":620.9,"text":"入侵之前"},{"start":620.9,"end":623.54,"text":"那土地已经成百上千年的"},{"start":623.54,"end":625.33,"text":"是由本地的居民"},{"start":625.33,"end":627.73,"text":"阿拉伯人所占有的"},{"start":627.73,"end":630.43,"text":"当然你可以说再过几百年前是哪个民族"},{"start":630.43,"end":632.11,"text":"在几百年前是什么亚述人"},{"start":632.11,"end":633.07,"text":"在什么什么人"},{"start":633.07,"end":634.545,"text":"什么人"},{"start":636.1,"end":639.96,"text":"你有你们这些人活在几千年前吗"},{"start":639.96,"end":641.76,"text":"绝大部分人口是活在当下的"},{"start":641.76,"end":642.54,"text":"对不对"},{"start":642.54,"end":646.7,"text":"但是几十年前以两代人之前"},{"start":646.7,"end":648.819,"text":"他所制造的不易"},{"start":649.339,"end":651.129,"text":"前面一两代人知道"},{"start":651.129,"end":654.399,"text":"我们这代人还是可以去纠正的吧"},{"start":655.58,"end":658.18,"text":"如果是已经有数百年的历史渊源了"},{"start":658.18,"end":662.15,"text":"那么这个时候大家就是说谁都说服不了谁了吗"},{"start":662.15,"end":664.16,"text":"但是你如果只是一两代人"},{"start":664.16,"end":667.56,"text":"始作俑者还存在于世"},{"start":673.48,"end":677.43,"text":"速速纠正这样的巨大的悲剧"},{"start":677.43,"end":679.74,"text":"巨大的错误"},{"start":681.72,"end":682.97,"text":"在这件事情上"},{"start":682.97,"end":684.32,"text":"以色列右翼政府"},{"start":684.32,"end":687.68,"text":"以色列支持这个右翼政府这样做的"},{"start":687.68,"end":691.55,"text":"那些人口全部是邪恶的"},{"start":691.55,"end":693.59,"text":"通通都是邪恶的"},{"start":694.61,"end":696.99,"text":"200万人要给他断水断电"},{"start":697.21,"end":699.75,"text":"你过一个晚上就要死几千号人"},{"start":699.75,"end":703.01,"text":"过一个晚上大批量的要死几千号人"},{"start":703.29,"end":705.17,"text":"这是绝对的邪恶"},{"start":705.17,"end":706.85,"text":"这是绝对的无耻"},{"start":706.85,"end":707.69,"text":"绝对的肮脏"},{"start":707.69,"end":709.4,"text":"绝对的变态"},{"start":709.4,"end":712.22,"text":"这所有的有理智的现代人类"},{"start":712.22,"end":715.67,"text":"都要对这种行为进行全部的唾弃"},{"start":716.19,"end":717.65,"text":"我们反对恐怖"},{"start":718.31,"end":720.71,"text":"恐怖分子对没错"},{"start":721.68,"end":726.72,"text":"我们也谴责哈马斯虐杀平民"},{"start":726.72,"end":729.6,"text":"哈马斯掳走音乐节上的这些观众"},{"start":729.6,"end":731.14,"text":"我们当然也谴责"},{"start":731.14,"end":732.85,"text":"但是阻止这样的行为"},{"start":732.85,"end":736.42,"text":"真正如何从根源上停止这样的行为呢"},{"start":736.42,"end":739.079,"text":"停止一切殖民活动"},{"start":739.479,"end":746.27,"text":"取消殖民史上的这些不正义的"},{"start":746.27,"end":752.12,"text":"强加在被殖民民族身上的这些历史磨难"},{"start":753.86,"end":758.21,"text":"以色列人撤出中东地区"},{"start":758.21,"end":759.41,"text":"回你老家去"},{"start":759.41,"end":762.73,"text":"你们老家几千年都在欧洲的"},{"start":763.31,"end":765.01,"text":"上千年是在欧洲的"},{"start":765.01,"end":769.12,"text":"你说你流浪流浪在那怪阿拉伯人"},{"start":770.26,"end":771.54,"text":"你流量不应该是你"},{"start":771.54,"end":774.25,"text":"欧洲人有种族主义排外吗"},{"start":774.41,"end":777.64,"text":"欧洲人的这种虚伪"},{"start":777.64,"end":781.76,"text":"特别是这些西欧人的虚伪到了极致"},{"start":783.46,"end":785.79,"text":"他说我可以包容犹太人了"},{"start":785.79,"end":787.23,"text":"怎么包容犹太人呢"},{"start":787.23,"end":791.27,"text":"把他们忽悠他们到另外一个地方去建国"},{"start":791.27,"end":795.55,"text":"早就不属于他们上千年的土地"},{"start":797.57,"end":800.3,"text":"在现代民族史里面"},{"start":801.0,"end":807.13,"text":"再有民族国家的现代形式的人类版图当中"},{"start":807.13,"end":810.31,"text":"早就不是他的地盘上"},{"start":810.31,"end":812.15,"text":"给它硬划一块出来"},{"start":812.15,"end":814.31,"text":"一个帝国主义殖民帝国"},{"start":814.31,"end":815.98,"text":"硬拿一块殖民地"},{"start":815.98,"end":818.17,"text":"也知道他的殖民统治要崩塌了"},{"start":818.17,"end":822.069,"text":"全世界的民族独立运动在如火如荼地进行着"},{"start":822.069,"end":825.399,"text":"那就为这种民族独立运动撒一把盐"},{"start":825.399,"end":827.71,"text":"掺一颗沙子"},{"start":827.71,"end":828.79,"text":"弄个以色列"},{"start":828.79,"end":830.95,"text":"把他自己所不能容忍的"},{"start":830.95,"end":836.66,"text":"他自己西欧的内在的这些犹太人给他驱逐岛"},{"start":836.66,"end":840.23,"text":"忽悠到又骗到这块地土地上去"},{"start":840.23,"end":843.05,"text":"让他成为他自己最厌恶的样子"},{"start":843.05,"end":844.71,"text":"成为纳粹"},{"start":844.99,"end":847.08,"text":"让以色列人成为纳粹"},{"start":847.08,"end":850.35,"text":"只不过说不在欧洲做纳粹了"},{"start":851.02,"end":854.98,"text":"哼啊让犹太人成为纳粹"},{"start":854.98,"end":859.42,"text":"我觉得这是我觉得欧洲人对犹太人的报复"},{"start":859.42,"end":861.34,"text":"对犹太人的这个侮辱"},{"start":861.34,"end":867.309,"text":"歧视和奴役和这种丑化没有没有停止"},{"start":867.309,"end":872.469,"text":"欧洲人只不过说是以这样一种虚伪的方式"},{"start":874.4,"end":876.25,"text":"在丑化犹太人"},{"start":876.25,"end":878.62,"text":"让他们以以色列复国"},{"start":878.62,"end":881.98,"text":"犹太复国主义的形式成为新的纳粹"},{"start":883.44,"end":885.56,"text":"这是极为可耻的"},{"start":885.56,"end":888.56,"text":"西欧英美帝国主义做这种事情"},{"start":888.56,"end":889.85,"text":"这是人类之耻"},{"start":889.85,"end":891.44,"text":"最大的耻辱"},{"start":891.44,"end":893.69,"text":"现在正在进行着"},{"start":893.69,"end":897.37,"text":"每一分钟可能都有十几20个人在死"},{"start":897.83,"end":899.829,"text":"就这个瞬间"},{"start":900.409,"end":903.609,"text":"联合国说赶紧搞人道主义走廊"},{"start":903.609,"end":904.809,"text":"人道主义通通道"},{"start":904.809,"end":906.429,"text":"内塔尼亚胡的又一部队"},{"start":906.429,"end":908.25,"text":"把他封锁的更死了"},{"start":908.25,"end":911.64,"text":"清真寺里面开始屠杀了"},{"start":913.72,"end":918.71,"text":"他就是要那还说埃及为什么不放开口岸"},{"start":919.11,"end":921.47,"text":"埃及为什么不放开这个通道"},{"start":921.47,"end":923.75,"text":"埃及说"},{"start":926.02,"end":927.72,"text":"那就是以色列的目的啊"},{"start":927.72,"end":930.24,"text":"以色列的目的就是要这块土地啊"},{"start":930.24,"end":932.82,"text":"要把人口驱赶走啊"},{"start":933.85,"end":935.13,"text":"我如果是埃及"},{"start":935.13,"end":936.21,"text":"我还想我"},{"start":936.21,"end":937.71,"text":"我干嘛让他们进来"},{"start":937.71,"end":941.24,"text":"我他妈要派部队进去了才是的"},{"start":941.58,"end":942.98,"text":"我是阿拉伯世界"},{"start":942.98,"end":943.88,"text":"那我就说我靠"},{"start":943.88,"end":945.44,"text":"我还我凭"},{"start":945.44,"end":947.0,"text":"我要坚守这个城池"},{"start":947.0,"end":948.5,"text":"我要坚守我这块土地啊"},{"start":948.5,"end":950.56,"text":"我也不要退啊"},{"start":953.38,"end":955.35,"text":"他用200万人的命"},{"start":955.35,"end":961.46,"text":"生命要吞并占领一块不属于他的土地"},{"start":962.6,"end":966.78,"text":"而且他本来就占着一整块不属于他的土地"},{"start":967.42,"end":972.65,"text":"犹太民族bay英美帝国主义忽悠的走向"},{"start":972.65,"end":974.09,"text":"这种极右翼的纳粹主义"},{"start":974.09,"end":975.65,"text":"这是人类之耻"},{"start":975.65,"end":979.94,"text":"我只说二战的反犹主义的故事没有结束"},{"start":979.94,"end":982.94,"text":"它只是变了一种形式"},{"start":983.16,"end":987.23,"text":"资本主义的恶魔依然在舞蹈着"},{"start":987.57,"end":990.8,"text":"他只是让他的受害者变成了新的加害者"},{"start":990.8,"end":993.48,"text":"成为了新的魔鬼"},{"start":999.8,"end":1003.78,"text":"英美国英主要国际力量就是促成这样的"},{"start":1003.78,"end":1004.5,"text":"你看欧洲"},{"start":1004.5,"end":1006.78,"text":"现在欧洲现在就是说啊"},{"start":1006.78,"end":1008.79,"text":"敢谴责以色列拒不录用"},{"start":1008.79,"end":1010.5,"text":"就不雇佣你的学生"},{"start":1010.5,"end":1013.3,"text":"敢谴责以色列不准毕业"},{"start":1014.6,"end":1015.82,"text":"美国和英国"},{"start":1015.82,"end":1019.24,"text":"现在主要的政客都在支持以色列"},{"start":1019.24,"end":1022.36,"text":"做这种铁灭人性"},{"start":1023.26,"end":1026.22,"text":"已经完全失去人类的任何基本的道义"},{"start":1026.22,"end":1029.449,"text":"而且还搬弄是非"},{"start":1029.969,"end":1031.009,"text":"相当于什么"},{"start":1031.009,"end":1034.599,"text":"相当于你把别人全家"},{"start":1034.599,"end":1036.31,"text":"就像以色列做的这个事情"},{"start":1036.31,"end":1036.91,"text":"相当于什么"},{"start":1036.91,"end":1038.349,"text":"相当于把别人全家杀了"},{"start":1038.349,"end":1039.64,"text":"剩两个小孩"},{"start":1039.64,"end":1043.49,"text":"那两个小孩现在回过头去"},{"start":1043.49,"end":1047.48,"text":"把你家宠物狗给逮回来了"},{"start":1051.52,"end":1053.58,"text":"那家人说你敢碰我宠物狗"},{"start":1053.58,"end":1055.26,"text":"你不把我宠物狗叫回来"},{"start":1056.52,"end":1059.01,"text":"我把你兄弟姐妹全全饿死"},{"start":1059.01,"end":1061.14,"text":"你有些兄弟姐妹还住在我这里"},{"start":1063.0,"end":1064.5,"text":"但是你有些亲戚什么的"},{"start":1064.5,"end":1067.21,"text":"就是然后西方媒体报道"},{"start":1067.21,"end":1072.16,"text":"就就就反而就从这个那几个孩子的报复行为出"},{"start":1072.16,"end":1073.96,"text":"开始"},{"start":1074.36,"end":1075.31,"text":"我靠"},{"start":1075.31,"end":1077.92,"text":"我觉得这个东西真是充满了"},{"start":1077.92,"end":1081.09,"text":"西方帝国主义的极度的虚伪"},{"start":1081.09,"end":1085.11,"text":"那些受主流这些国际主流媒体所愚弄的"},{"start":1085.11,"end":1090.83,"text":"那些平民的头脑里面充满了无耻的谎言"},{"start":1090.83,"end":1094.16,"text":"卑劣的虚假的"},{"start":1094.16,"end":1096.02,"text":"关于平等啊"},{"start":1101.33,"end":1105.82,"text":"虚假的那些摇篮曲"},{"start":1118.2,"end":1121.28,"text":"人类第一个这样搞这种什么"},{"start":1123.38,"end":1125.159,"text":"他妈是以色列先搞的"},{"start":1125.159,"end":1130.379,"text":"以色列是人类第一个劫机劫平民的鸡"},{"start":1134.31,"end":1136.38,"text":"为了达成他的政治目的"},{"start":1136.38,"end":1137.87,"text":"完全不择手段的"},{"start":1137.885,"end":1141.05,"text":"后来在这个英美帝国主义的教导之下"},{"start":1141.05,"end":1143.27,"text":"开始慢慢慢慢的把脏帽子"},{"start":1143.27,"end":1145.54,"text":"把脏手段都扣到别人头上去了"},{"start":1145.54,"end":1147.52,"text":"那弱者想要反抗的时候"},{"start":1147.52,"end":1149.62,"text":"只能采取不对称的手段"},{"start":1149.62,"end":1152.14,"text":"他没有任何办法"},{"start":1155.44,"end":1158.16,"text":"这个世道充满了"},{"start":1159.42,"end":1161.12,"text":"由英美"},{"start":1164.54,"end":1168.0,"text":"充满了这样的赤裸裸的肮脏病态"},{"start":1168.0,"end":1175.06,"text":"可耻愚蠢到极致的谎言和悲剧"},{"start":1179.6,"end":1184.76,"text":"我们只能说有些自由主义者"},{"start":1185.1,"end":1189.49,"text":"你可以罔顾这种帝国主义的殖民史吗"},{"start":1189.49,"end":1193.83,"text":"一个罔顾这种帝国主义的刻意的战争输出史吗"},{"start":1193.83,"end":1199.11,"text":"你可以罔顾中东那么多老百姓的颠沛流离啊"},{"start":1199.11,"end":1200.55,"text":"当然你们这些人慕强"},{"start":1200.55,"end":1203.03,"text":"你们这种王八蛋"},{"start":1203.03,"end":1206.18,"text":"不要嘴巴上说的什么漂亮的漂亮话"},{"start":1207.89,"end":1209.45,"text":"平等和平这吊东西"},{"start":1209.45,"end":1210.659,"text":"博爱这种东西的"},{"start":1210.659,"end":1213.119,"text":"你们纯粹是幕墙而已"},{"start":1213.119,"end":1214.829,"text":"伊拉克啊"},{"start":1214.829,"end":1217.51,"text":"那个什么叙利亚啊"},{"start":1217.51,"end":1218.92,"text":"那个什么利比亚被炸的"},{"start":1218.92,"end":1222.1,"text":"那个几百万上千万老百姓流离失所"},{"start":1222.1,"end":1223.78,"text":"全家死的他妈颠沛流离的时候"},{"start":1223.78,"end":1225.53,"text":"你们在哪里"},{"start":1226.17,"end":1227.51,"text":"刽子手在行凶"},{"start":1227.51,"end":1228.71,"text":"滥杀无辜"},{"start":1228.71,"end":1231.23,"text":"他以前把这几百万人当人质"},{"start":1231.23,"end":1235.4,"text":"你木墙我靠赤裸裸的"},{"start":1235.4,"end":1237.8,"text":"所以我们对你知道"},{"start":1237.8,"end":1241.37,"text":"我对你们这种虚伪的自由主义者"},{"start":1241.37,"end":1244.43,"text":"清西方的这些货色"},{"start":1244.43,"end":1247.51,"text":"我们没有任何话可说"},{"start":1247.61,"end":1249.55,"text":"我们没有任何言语可说"},{"start":1250.87,"end":1253.46,"text":"没有任话可说"},{"start":1254.52,"end":1255.98,"text":"我也不想诅咒什么"},{"start":1255.98,"end":1259.28,"text":"跟你们跟你主子一块总归会完蛋什么的"},{"start":1259.28,"end":1261.54,"text":"没什么好说的"},{"start":1269.77,"end":1273.69,"text":"希望国际力量任何有建设性的"},{"start":1273.69,"end":1278.46,"text":"真正追求人类和平和解的无脊梁早日介入"},{"start":1278.46,"end":1281.139,"text":"也希望阿拉伯国家可以团结起来"},{"start":1281.139,"end":1282.639,"text":"一致抵抗"},{"start":1282.639,"end":1287.319,"text":"对外反对这样的垦殖团啊"},{"start":1287.319,"end":1291.63,"text":"这种武装垦殖团的这样的一种以色列人的殖民"},{"start":1291.63,"end":1295.94,"text":"以色列人的这种对于阿拉伯人的迫害啊"},{"start":1299.0,"end":1300.65,"text":"以色列的犹太复国主义者"},{"start":1310.2,"end":1312.08,"text":"只要你有基本的人类的"},{"start":1312.08,"end":1313.31,"text":"这个时候就说了"},{"start":1313.31,"end":1315.62,"text":"通常说这个人类的良知啊"},{"start":1315.62,"end":1317.06,"text":"什么都是虚伪的"},{"start":1317.06,"end":1321.33,"text":"因为英美在国际上兜售那套人类的良知"},{"start":1322.89,"end":1323.49,"text":"不要什么"},{"start":1323.49,"end":1326.01,"text":"他确实是虚伪的"},{"start":1327.68,"end":1329.98,"text":"因为真正的人类的良知"},{"start":1329.98,"end":1333.98,"text":"真正的人类族群的延续"},{"start":1333.98,"end":1336.32,"text":"人类的历史的矛盾的和解"},{"start":1336.32,"end":1340.67,"text":"化解人类的战争悲剧的消弭"},{"start":1344.1,"end":1347.78,"text":"绝对不是走那那那种虚伪的人道之路"},{"start":1349.76,"end":1350.36,"text":"反恐啊"},{"start":1350.36,"end":1353.23,"text":"和平是可以走出来的"},{"start":1353.23,"end":1356.7,"text":"一定一定我们要追求的是呃"},{"start":1356.7,"end":1359.22,"text":"我们要提倡和鼓励是阿拉伯世界"},{"start":1359.22,"end":1360.12,"text":"他的和解"},{"start":1360.12,"end":1362.31,"text":"也伊斯兰世界的和解"},{"start":1362.31,"end":1363.42,"text":"他的整合"},{"start":1363.42,"end":1364.53,"text":"他的统一"},{"start":1364.53,"end":1367.33,"text":"就像当年的中国一样啊"},{"start":1367.33,"end":1370.21,"text":"要和解省份之间啊"},{"start":1370.21,"end":1373.26,"text":"类似于省份之间和解统一"},{"start":1373.26,"end":1377.54,"text":"一起抵抗外部团结起来"},{"start":1379.79,"end":1382.01,"text":"将极右翼军国主义"},{"start":1382.01,"end":1384.449,"text":"帝国主义的势力驱逐出去"},{"start":1384.449,"end":1387.089,"text":"你不要以为欧洲是和平美好的"},{"start":1387.089,"end":1388.889,"text":"以色列的犹太"},{"start":1388.889,"end":1392.61,"text":"这种极右翼的犹太复国主义就是欧洲输出的"},{"start":1393.01,"end":1395.07,"text":"就是欧洲输出出来的"},{"start":1395.07,"end":1399.239,"text":"这是欧洲的某个欧洲之耻"},{"start":1399.239,"end":1400.169,"text":"你知道吗"},{"start":1400.169,"end":1402.5,"text":"欧洲之耻"},{"start":1403.32,"end":1405.5,"text":"这是西方文明"},{"start":1405.5,"end":1407.81,"text":"尤其是西欧文明之耻"},{"start":1408.21,"end":1409.85,"text":"是他的罪恶"},{"start":1409.85,"end":1411.9,"text":"最可悲的"},{"start":1411.9,"end":1414.54,"text":"所以说齐泽克当时吹欧盟那一套"},{"start":1414.54,"end":1415.86,"text":"吹捧欧盟那一套"},{"start":1415.86,"end":1418.2,"text":"这东西根本不是人类的未来"},{"start":1418.2,"end":1419.73,"text":"没有任何意义"},{"start":1419.73,"end":1421.83,"text":"欧洲代议制什么啊"},{"start":1423.42,"end":1427.35,"text":"它所掩盖的是他这样一个把他的内在矛盾"},{"start":1427.35,"end":1430.59,"text":"完全甩出去"},{"start":1430.59,"end":1431.13,"text":"甩出去"},{"start":1431.13,"end":1433.32,"text":"控制阿拉伯世界"},{"start":1433.32,"end":1435.63,"text":"控制他所谓的文明的敌手"},{"start":1435.63,"end":1438.05,"text":"控制国际油价了啊"},{"start":1438.05,"end":1440.87,"text":"滋养国际资本主义啊"},{"start":1442.28,"end":1444.37,"text":"这是极大的耻辱"},{"start":1444.37,"end":1447.4,"text":"这是彻底的耻辱"},{"start":1449.1,"end":1452.9,"text":"这是每一个人类个体的耻辱"},{"start":1453.84,"end":1457.34,"text":"欧洲人一天到晚活的那好像很温和平和的"},{"start":1457.34,"end":1461.17,"text":"安宁的代价是什么"},{"start":1461.93,"end":1463.57,"text":"代价是什么"},{"start":1463.57,"end":1467.71,"text":"代价是我靠当时打了一把什么利比亚的时候"},{"start":1467.71,"end":1469.69,"text":"以色列轰炸叙利"},{"start":1469.69,"end":1470.77,"text":"打叙利亚是要轰炸"},{"start":1470.77,"end":1471.25,"text":"我靠"},{"start":1471.25,"end":1474.13,"text":"你这么欧洲主要大国战斗机"},{"start":1474.13,"end":1476.74,"text":"导弹全对着人家平民区轰"},{"start":1477.14,"end":1481.97,"text":"把直接把城市轰成你妈的地狱了"},{"start":1482.37,"end":1487.9,"text":"这虚伪这种虚伪根本不值得被夸赞"},{"start":1487.9,"end":1489.76,"text":"没有任何优点可言"},{"start":1489.76,"end":1491.5,"text":"齐泽克为这种虚伪开脱"},{"start":1491.5,"end":1492.4,"text":"这是他的耻辱"},{"start":1492.4,"end":1494.17,"text":"是哲学的耻辱"},{"start":1494.17,"end":1497.02,"text":"我这里可能讲的太多的关于耻辱的东西"},{"start":1497.02,"end":1497.53,"text":"好吧"},{"start":1497.53,"end":1499.03,"text":"就讲到这里啊"},{"start":1499.03,"end":1500.08,"text":"就讲到这里"}],"source":"subtitle"}
