{"segments":[{"start":0.84,"end":4.0,"text":"模式的不可持续"},{"start":5.56,"end":8.38,"text":"实际上意味着是矛盾的不可调和"},{"start":9.54,"end":13.48,"text":"我非常乐见我的模式不可持续的"},{"start":15.08,"end":19.12,"text":"我们说的可复制性不是一种现实的"},{"start":19.12,"end":21.42,"text":"直接的凭空的可复制性"},{"start":26.02,"end":30.98,"text":"一个种子商人说它的种子可以孕育出新的植株"},{"start":31.72,"end":35.43,"text":"不代表你买了这粒种子"},{"start":35.43,"end":37.8,"text":"就买了一整颗蜘蛛"},{"start":41.86,"end":50.37,"text":"所以对于目前啊在市面上慈善的景观"},{"start":50.37,"end":53.5,"text":"或者说是校园的工艺"},{"start":57.53,"end":62.36,"text":"在这样的市场明面上来看"},{"start":62.72,"end":69.08,"text":"我给出来的行动路线确实不具有可复制性"},{"start":69.12,"end":73.48,"text":"因为它没有真正能够生根的土壤"},{"start":74.28,"end":79.619,"text":"但是我只负责复制种子"},{"start":80.96,"end":82.72,"text":"分发种子"},{"start":82.72,"end":84.92,"text":"我就像一个国王那样"},{"start":87.8,"end":89.56,"text":"有没有听过那个童话故事"},{"start":91.18,"end":94.24,"text":"给每一个孩子一颗花种"},{"start":95.5,"end":99.46,"text":"谁能够长出美丽的花朵"},{"start":101.74,"end":103.14,"text":"谁又可以做国王"},{"start":104.34,"end":104.88,"text":"是不是"},{"start":106.14,"end":107.58,"text":"那我偏偏要说了"},{"start":110.78,"end":112.32,"text":"我这个种子啊"},{"start":113.64,"end":118.01,"text":"就这在一般的土壤当中是无法发芽的"},{"start":118.01,"end":121.4,"text":"是不是你还记得吗"},{"start":121.4,"end":124.49,"text":"这个种子是煮过的"},{"start":124.49,"end":127.87,"text":"童话故事里啊"},{"start":127.87,"end":129.669,"text":"只有一个诚实的孩子"},{"start":129.669,"end":131.94,"text":"它的种子没有长出花来"},{"start":132.359,"end":136.46,"text":"那么这个花就是他的诚实之花"},{"start":137.6,"end":141.06,"text":"客观的现实地面对真相"},{"start":141.999,"end":146.76,"text":"这个花朵是长在行动者的心中的"},{"start":147.959,"end":150.46,"text":"自以为种出花来的"},{"start":151.44,"end":152.72,"text":"这个种子"},{"start":152.72,"end":154.64,"text":"在那样的土壤里面"},{"start":154.64,"end":160.16,"text":"在泥粪土构成的土壤当中"},{"start":160.779,"end":164.339,"text":"它是长不出心灵的诚实之花的"},{"start":164.339,"end":168.119,"text":"长不出行动的坚守之花的"},{"start":168.119,"end":172.76,"text":"长不出气节的忠诚之花的"},{"start":173.58,"end":174.56,"text":"长不出"},{"start":174.56,"end":177.78,"text":"在逆境中不弄虚作假"},{"start":179.38,"end":180.6,"text":"不尔虞我诈"},{"start":181.86,"end":182.52,"text":"不自欺"},{"start":182.52,"end":183.86,"text":"欺人之花的"},{"start":185.2,"end":187.5,"text":"那么很明显"},{"start":187.839,"end":190.749,"text":"我分发的种子是有效的"},{"start":190.749,"end":192.94,"text":"是可以长出花朵出来的"},{"start":195.76,"end":199.02,"text":"无非这朵花你们都看不见而已"},{"start":199.02,"end":202.35,"text":"按照工艺的逻辑啊"},{"start":202.35,"end":203.52,"text":"大公无私的功"},{"start":203.52,"end":205.14,"text":"按照慈善的逻辑"},{"start":205.14,"end":208.16,"text":"按照学生体验社会的逻辑"},{"start":208.959,"end":212.88,"text":"按照小三一改良的逻辑"},{"start":213.499,"end":216.02,"text":"按照市场景观的逻辑"},{"start":216.399,"end":219.219,"text":"我这里种子在这些土壤当中"},{"start":219.219,"end":221.54,"text":"统统长不出任何的花朵"},{"start":221.66,"end":226.52,"text":"它可以长出的花朵是需要特定的土壤的"},{"start":226.52,"end":228.32,"text":"而这个土壤的栽培"},{"start":228.579,"end":229.899,"text":"土壤的开垦"},{"start":230.919,"end":232.74,"text":"土地的选择"},{"start":234.3,"end":236.74,"text":"边境的防御"},{"start":239.72,"end":244.3,"text":"以及正当性的开拓进去"},{"start":244.3,"end":246.56,"text":"这下这些工作啊"},{"start":247.58,"end":252.73,"text":"不是我这个种子分发者要亲自给你们做的"},{"start":252.73,"end":255.06,"text":"我只负责做我的部分"},{"start":257.36,"end":259.69,"text":"我只负责做我的部分"},{"start":259.69,"end":263.48,"text":"我这里煮过的花种确实"},{"start":265.16,"end":270.04,"text":"在我的团队当中长出了它的幼苗"},{"start":271.0,"end":274.94,"text":"在我心中我品尝到了它的果实"},{"start":278.9,"end":287.08,"text":"在我所想要去接近了解合作的那部分群体当中"},{"start":288.1,"end":294.72,"text":"我也获得了适宜这些植株生长的气候湿度"},{"start":294.72,"end":297.52,"text":"温度环境"},{"start":301.8,"end":307.099,"text":"我希望你们都能做诚实的播种人"},{"start":307.099,"end":311.98,"text":"育种者要在正确的土壤当中"},{"start":311.98,"end":316.02,"text":"这个土壤甚至在现实当中都不存在"},{"start":317.04,"end":318.53,"text":"它当然不存在"},{"start":318.53,"end":319.86,"text":"组织工作"},{"start":320.12,"end":323.12,"text":"不是说让你套用现成的组织关系"},{"start":323.12,"end":324.08,"text":"组织模式"},{"start":324.08,"end":327.38,"text":"现成的共同体的利益关系"},{"start":327.38,"end":328.559,"text":"利益模式的"},{"start":328.559,"end":333.03,"text":"你需要去创造全新的崭新的共同体关系"},{"start":333.03,"end":336.72,"text":"全新的崭新的共同体的行动逻辑"},{"start":339.72,"end":342.26,"text":"我的种子虽然被煮过"},{"start":342.26,"end":344.8,"text":"被火炼过"},{"start":346.3,"end":351.66,"text":"我的种子被无数的自信的刀枪"},{"start":351.66,"end":354.359,"text":"斧钺家如其上"},{"start":356.639,"end":359.42,"text":"但它依然能够长出"},{"start":361.1,"end":362.8,"text":"最真实的植株"},{"start":364.0,"end":366.06,"text":"没有人可以否认它的存在"},{"start":366.42,"end":368.1,"text":"无非大家都会说"},{"start":368.1,"end":368.97,"text":"看不见"},{"start":368.97,"end":370.17,"text":"听不着"},{"start":370.17,"end":371.34,"text":"摸不到"},{"start":372.36,"end":375.5,"text":"我希望我们能够保持这种看不见"},{"start":375.5,"end":377.93,"text":"听不着摸不到的状况"},{"start":377.93,"end":379.25,"text":"足够的酒"},{"start":379.25,"end":382.159,"text":"让这这颗植株啊"},{"start":382.159,"end":386.56,"text":"不要仅仅作为一个幼苗啊"},{"start":386.56,"end":390.52,"text":"就被就被过度的把它拔高了"},{"start":390.52,"end":392.96,"text":"揠苗助长的故事你们都听过"},{"start":393.6,"end":396.2,"text":"希望它长得足够大啊"},{"start":396.2,"end":397.88,"text":"长得足够丰茂"},{"start":398.96,"end":401.2,"text":"那看不见的自然会被看见"},{"start":401.2,"end":403.36,"text":"摸不着的自然会被摸着"},{"start":403.36,"end":408.779,"text":"听不到的自然会听到他摇曳时震动的风声"},{"start":412.739,"end":415.54,"text":"啊行不通"},{"start":415.54,"end":416.68,"text":"没有可复制性"},{"start":417.82,"end":419.84,"text":"恰恰是它的可复制性"},{"start":420.2,"end":424.3,"text":"恰恰意味着矛盾的不可调和性"},{"start":425.74,"end":428.22,"text":"我们之前我说过了"},{"start":428.56,"end":433.66,"text":"我们这边模式就就光从一个钱的逻辑上来讲啊"},{"start":433.66,"end":435.82,"text":"钱的逻辑上当然它没有任何可复制性"},{"start":435.82,"end":439.68,"text":"除非它能够改变阶级力量对比"},{"start":441.24,"end":444.34,"text":"否则在钱上面他永远走不通"},{"start":447.02,"end":450.04,"text":"那么他现在目前在经济上还能够苟延残喘着"},{"start":450.04,"end":450.46,"text":"为什么呢"},{"start":450.46,"end":452.92,"text":"因为我们至少在意识形态层面"},{"start":452.92,"end":454.58,"text":"我们改变了这一对比"},{"start":455.259,"end":457.409,"text":"这个意识形态层面的力量对比"},{"start":457.409,"end":462.96,"text":"就变成啊现实的物质上的支持"},{"start":464.639,"end":466.429,"text":"啊你们要否认的话"},{"start":466.429,"end":468.36,"text":"我不介意你们否认啊"},{"start":468.78,"end":472.26,"text":"在我看来就是说遭遇创伤的第一步就是否认"},{"start":472.26,"end":477.0,"text":"那我作为一个创伤存在了啊"},{"start":477.0,"end":479.22,"text":"反而已经证明我的真实性了"},{"start":479.22,"end":481.8,"text":"绝大部分的分析家已经说是"},{"start":485.22,"end":487.2,"text":"但是这种沮丧也是一种虚伪的沮丧"},{"start":487.2,"end":489.66,"text":"我觉得这个东西还是不可复制啊"},{"start":489.66,"end":491.44,"text":"当然不可复制"},{"start":491.5,"end":493.39,"text":"因为矛盾不可调和"},{"start":493.39,"end":494.62,"text":"当然不可复制"},{"start":496.3,"end":500.31,"text":"当然对于这这粒种子"},{"start":500.31,"end":502.14,"text":"它各种说了"},{"start":502.14,"end":506.02,"text":"油煎火烹啊"},{"start":508.66,"end":511.49,"text":"刀切镇压啊"},{"start":511.49,"end":513.38,"text":"这个都是拉满的"},{"start":513.38,"end":515.359,"text":"当然是不可复制的"},{"start":517.08,"end":520.21,"text":"因为它能够长出植株"},{"start":520.21,"end":523.09,"text":"生长出来的条件和环境"},{"start":523.09,"end":524.98,"text":"是需要每一个个体"},{"start":524.98,"end":530.439,"text":"每一个团体拼尽全力在社会当中去创造的"},{"start":530.82,"end":533.939,"text":"我只是给出了蓝图"},{"start":535.32,"end":537.959,"text":"蓝图的每一个分支"},{"start":538.62,"end":541.46,"text":"每一个细节"},{"start":541.46,"end":544.86,"text":"每一个局部的环境"},{"start":544.86,"end":547.819,"text":"都需要每一个个体去努力去创造"},{"start":549.86,"end":554.89,"text":"我非常乐见你们在既定的一些市场的逻辑"},{"start":555.88,"end":556.78,"text":"景观的逻辑"},{"start":556.78,"end":558.68,"text":"慈善的逻辑啊"},{"start":558.68,"end":561.32,"text":"学生的那种啊"},{"start":561.32,"end":563.98,"text":"就是道德上啊"},{"start":563.98,"end":564.64,"text":"自我标榜"},{"start":564.64,"end":565.81,"text":"自我陶醉的逻辑"},{"start":565.81,"end":566.98,"text":"在这些逻辑当中"},{"start":566.98,"end":568.15,"text":"在这些土壤当中"},{"start":568.15,"end":570.979,"text":"这粒种子统统没有长出来"},{"start":571.7,"end":573.88,"text":"我希望你们诚实地面对这一点"},{"start":575.38,"end":576.819,"text":"在这个过程当中"},{"start":577.08,"end":579.12,"text":"某种东西已经长出来了"},{"start":579.12,"end":581.34,"text":"某种现实的精神"},{"start":581.34,"end":582.78,"text":"现实的力量"},{"start":582.78,"end":584.46,"text":"现实的联结"},{"start":584.46,"end":587.54,"text":"现实的团结"},{"start":587.54,"end":589.579,"text":"精神已经长出来了"},{"start":591.94,"end":594.48,"text":"没有你们想你们没有听过那个故事吗"},{"start":594.48,"end":596.91,"text":"那故事是三岁小孩都听过的故事"},{"start":596.91,"end":600.03,"text":"我非常我非常你们这些自以为智慧的人"},{"start":600.03,"end":602.99,"text":"自以为在那边好像提高我一招"},{"start":602.99,"end":605.78,"text":"比我跑快一步的那些货色"},{"start":606.46,"end":609.819,"text":"我没有看到你们有这样的头脑"},{"start":611.34,"end":614.45,"text":"有一个幼童的天真的诚实的头脑"},{"start":614.45,"end":616.74,"text":"就回忆起当年的那个故事"},{"start":618.62,"end":622.0,"text":"啊所有的自吹自擂的说他这个活动怎么样"},{"start":622.0,"end":622.6,"text":"怎么样怎么样"},{"start":622.6,"end":623.02,"text":"了不起"},{"start":623.02,"end":623.8,"text":"怎么样怎么样"},{"start":623.8,"end":624.53,"text":"有影响的"},{"start":624.53,"end":627.89,"text":"那么这个通通都是它一捧那个一盆花出来"},{"start":627.89,"end":629.78,"text":"长出各种花朵啊"},{"start":629.78,"end":632.57,"text":"我希望你们所有人都能够实事求是"},{"start":632.57,"end":636.79,"text":"在过程当中锻炼一个实事求是的"},{"start":636.79,"end":642.13,"text":"行动者的基本的认识论素养"},{"start":642.13,"end":645.14,"text":"以及说一不二"},{"start":645.14,"end":651.63,"text":"说到做到的基本的实践实践者的一个素养啊"},{"start":651.63,"end":654.979,"text":"历史的预备条件早已经成熟"},{"start":655.22,"end":660.67,"text":"迟迟未到的恰恰就是你们啊"},{"start":660.67,"end":662.65,"text":"历史的条件早已经成熟了"},{"start":662.65,"end":664.19,"text":"早就成熟了"},{"start":667.28,"end":668.63,"text":"从来都是成熟的"},{"start":668.63,"end":669.86,"text":"一直就是成熟的"},{"start":669.86,"end":671.339,"text":"不成熟的是你们"},{"start":672.94,"end":676.02,"text":"不成熟的是你们甚至都不是我"},{"start":676.02,"end":677.58,"text":"我都不包括在内"},{"start":677.58,"end":679.359,"text":"不成熟的是你们"},{"start":681.28,"end":685.46,"text":"啊说我分发的是种子啊"},{"start":685.46,"end":688.52,"text":"种子就是你你们就是这些种子"},{"start":688.52,"end":690.56,"text":"我从来没有分发过任何的种子"},{"start":690.56,"end":691.64,"text":"你甚至可以说"},{"start":692.02,"end":693.64,"text":"所以把我取消"},{"start":693.64,"end":695.26,"text":"取消我的存在没有意义的"},{"start":695.26,"end":697.579,"text":"因为这些家伙本身就是种子"},{"start":698.54,"end":702.58,"text":"如果有目的引导去浇灌这些花朵"},{"start":702.58,"end":704.62,"text":"还不至于说是野蛮生长"},{"start":704.62,"end":706.67,"text":"疯狂生长啊"},{"start":706.67,"end":709.67,"text":"不至于长成夺草啊"},{"start":709.67,"end":716.06,"text":"不至于长成杂乱丛生的藤蔓啊"},{"start":717.2,"end":719.0,"text":"但至少还可以修剪"},{"start":721.54,"end":722.939,"text":"我无语"},{"start":723.24,"end":725.1,"text":"过早的去修剪幼苗"},{"start":725.1,"end":727.56,"text":"幼苗是不需要修剪的啊"},{"start":727.56,"end":729.66,"text":"幼苗是不需要修剪的"},{"start":731.18,"end":732.43,"text":"在我看来啊"},{"start":732.43,"end":734.11,"text":"在我看来啊"},{"start":734.11,"end":740.23,"text":"某种意义上说的越多的人啊"},{"start":740.23,"end":746.339,"text":"嘴巴上越要把事情的意义捧到某种高点的人"},{"start":747.9,"end":750.56,"text":"尤其是在他什么都不做的情况之下"},{"start":750.56,"end":753.44,"text":"这些人呐越是善于勾兑"},{"start":753.44,"end":756.68,"text":"越是善于出卖啊"},{"start":756.68,"end":758.15,"text":"说的比较少的人"},{"start":758.15,"end":761.42,"text":"或者说他不得不去说一些事情"},{"start":761.42,"end":765.46,"text":"来波动现实运转的齿轮的时候"},{"start":766.84,"end":768.1,"text":"他的话语本身"},{"start":768.1,"end":774.2,"text":"立即就引来对立面的反击的时候啊"},{"start":774.2,"end":777.3,"text":"也就是说他说的话没有所谓正确的废话的时候"},{"start":780.0,"end":784.28,"text":"他始终要坚持的就是我了"},{"start":784.28,"end":785.72,"text":"我本人始终要坚持的一点"},{"start":785.72,"end":786.54,"text":"就是说"},{"start":788.4,"end":794.219,"text":"我们希望你们更多的是一个持久的行动者"},{"start":795.16,"end":797.439,"text":"坚持到底的行动者"},{"start":797.68,"end":800.86,"text":"我并不想鼓舞你们的决心"},{"start":800.86,"end":802.76,"text":"考察你们的勇气"},{"start":804.96,"end":808.12,"text":"我只是想反复跟你们确认一点"},{"start":810.36,"end":817.14,"text":"不要妄图通过零星片刻的融洽"},{"start":818.04,"end":821.39,"text":"就抵消掉你内在的痛苦"},{"start":821.39,"end":822.5,"text":"内在的病理化"},{"start":822.5,"end":823.94,"text":"这是不可能的啊"},{"start":823.94,"end":825.579,"text":"这是不可能的"},{"start":826.58,"end":827.95,"text":"现实而言"},{"start":827.95,"end":830.8,"text":"或者我们说你最抽离的观点来看"},{"start":832.0,"end":840.42,"text":"每个人都会不可避免地沉浸在群体运动趋势的"},{"start":840.72,"end":842