  "content_sha256": "c79ff1350effac1a5c3313c1b973c66b24ad9634f72037ecdf9e6e9b21acca9f",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 780,
      "end_ms": 3600,
      "text": "不是说什么等待时机论"
    },
    {
      "ordinal": 1,
      "start_ms": 3600,
      "end_ms": 5040,
      "text": "我靠大哥"
    },
    {
      "ordinal": 2,
      "start_ms": 5040,
      "end_ms": 5940,
      "text": "你没有力量"
    },
    {
      "ordinal": 3,
      "start_ms": 5940,
      "end_ms": 8640,
      "text": "怎么创造时机啊"
    },
    {
      "ordinal": 4,
      "start_ms": 8640,
      "end_ms": 11190,
      "text": "不断重复这个过程"
    },
    {
      "ordinal": 5,
      "start_ms": 11190,
      "end_ms": 12420,
      "text": "为什么变重复"
    },
    {
      "ordinal": 6,
      "start_ms": 12420,
      "end_ms": 13860,
      "text": "这个过程本来就是这样"
    },
    {
      "ordinal": 7,
      "start_ms": 13860,
      "end_ms": 17920,
      "text": "这个过程也是在发展在进步啊"
    },
    {
      "ordinal": 8,
      "start_ms": 19140,
      "end_ms": 22820,
      "text": "就格林那他妈天天忽悠一群他妈外卖骑手"
    },
    {
      "ordinal": 9,
      "start_ms": 22820,
      "end_ms": 23540,
      "text": "他妈上街"
    },
    {
      "ordinal": 10,
      "start_ms": 23540,
      "end_ms": 26750,
      "text": "这个就就就就就这这个就叫做"
    },
    {
      "ordinal": 11,
      "start_ms": 26750,
      "end_ms": 28670,
      "text": "这就叫这也是重复过程"
    },
    {
      "ordinal": 12,
      "start_ms": 28670,
      "end_ms": 30080,
      "text": "而且是在浪费力量"
    },
    {
      "ordinal": 13,
      "start_ms": 30080,
      "end_ms": 32369,
      "text": "哈哈不断重复这个过程"
    },
    {
      "ordinal": 14,
      "start_ms": 32369,
      "end_ms": 33450,
      "text": "浪费力量"
    },
    {
      "ordinal": 15,
      "start_ms": 33450,
      "end_ms": 35640,
      "text": "浪费时机论"
    },
    {
      "ordinal": 16,
      "start_ms": 35920,
      "end_ms": 37860,
      "text": "让那些浪费时间的人说"
    },
    {
      "ordinal": 17,
      "start_ms": 37860,
      "end_ms": 39210,
      "text": "我在等待时机"
    },
    {
      "ordinal": 18,
      "start_ms": 39210,
      "end_ms": 41040,
      "text": "我滴妈我真的服了"
    },
    {
      "ordinal": 19,
      "start_ms": 41040,
      "end_ms": 43200,
      "text": "你朝饭碗里拉屎的人说"
    },
    {
      "ordinal": 20,
      "start_ms": 43200,
      "end_ms": 44040,
      "text": "我在吃屎"
    },
    {
      "ordinal": 21,
      "start_ms": 44040,
      "end_ms": 45160,
      "text": "我靠"
    },
    {
      "ordinal": 22,
      "start_ms": 49260,
      "end_ms": 50750,
      "text": "确实是这样的啊"
    },
    {
      "ordinal": 23,
      "start_ms": 50750,
      "end_ms": 54140,
      "text": "你就让我想到杨和平的马仔"
    },
    {
      "ordinal": 24,
      "start_ms": 54140,
      "end_ms": 55340,
      "text": "那群那群马仔"
    },
    {
      "ordinal": 25,
      "start_ms": 55340,
      "end_ms": 57570,
      "text": "让我想到一群马仔"
    },
    {
      "ordinal": 26,
      "start_ms": 58460,
      "end_ms": 61060,
      "text": "天天给他开会开会批"
    },
    {
      "ordinal": 27,
      "start_ms": 61060,
      "end_ms": 64480,
      "text": "还有国内的什么这个派那个派那个派那个派"
    },
    {
      "ordinal": 28,
      "start_ms": 64480,
      "end_ms": 65349,
      "text": "天天开会"
    },
    {
      "ordinal": 29,
      "start_ms": 65349,
      "end_ms": 67720,
      "text": "早上开会就是为了下午开会"
    },
    {
      "ordinal": 30,
      "start_ms": 68290,
      "end_ms": 70920,
      "text": "昨天开会就是为了今天开会"
    },
    {
      "ordinal": 31,
      "start_ms": 70920,
      "end_ms": 73800,
      "text": "什么吊东西"
    },
    {
      "ordinal": 32,
      "start_ms": 76460,
      "end_ms": 79630,
      "text": "杨某人的马仔又让我想到这个了"
    },
    {
      "ordinal": 33,
      "start_ms": 79630,
      "end_ms": 81280,
      "text": "你确定你不是杨某人的马仔"
    },
    {
      "ordinal": 34,
      "start_ms": 81280,
      "end_ms": 84520,
      "text": "我来看一下他关注列表里面有没有杨某人"
    },
    {
      "ordinal": 35,
      "start_ms": 85100,
      "end_ms": 87280,
      "text": "MCC啊"
    },
    {
      "ordinal": 36,
      "start_ms": 98000,
      "end_ms": 98980,
      "text": "还真没有"
    },
    {
      "ordinal": 37,
      "start_ms": 98980,
      "end_ms": 99790,
      "text": "我靠"
    },
    {
      "ordinal": 38,
      "start_ms": 99790,
      "end_ms": 103000,
      "text": "根正苗红的不得了"
    },
    {
      "ordinal": 39,
      "start_ms": 103000,
      "end_ms": 104980,
      "text": "他不是原教旨主义者"
    }
  ],
  "text": "不是说什么等待时机论\n我靠大哥\n你没有力量\n怎么创造时机啊\n不断重复这个过程\n为什么变重复\n这个过程本来就是这样\n这个过程也是在发展在进步啊\n就格林那他妈天天忽悠一群他妈外卖骑手\n他妈上街\n这个就就就就就这这个就叫做\n这就叫这也是重复过程\n而且是在浪费力量\n哈哈不断重复这个过程\n浪费力量\n浪费时机论\n让那些浪费时间的人说\n我在等待时机\n我滴妈我真的服了\n你朝饭碗里拉屎的人说\n我在吃屎\n我靠\n确实是这样的啊\n你就让我想到杨和平的马仔\n那群那群马仔\n让我想到一群马仔\n天天给他开会开会批\n还有国内的什么这个派那个派那个派那个派\n天天开会\n早上开会就是为了下午开会\n昨天开会就是为了今天开会\n什么吊东西\n杨某人的马仔又让我想到这个了\n你确定你不是杨某人的马仔\n我来看一下他关注列表里面有没有杨某人\nMCC啊\n还真没有\n我靠\n根正苗红的不得了\n他不是原教旨主义者",
