{"segments":[{"start":0.34,"end":4.18,"text":"我通常都要说就是说要做到一个互保"},{"start":4.18,"end":6.319,"text":"做到互保的一个程度"},{"start":6.8,"end":10.62,"text":"台是第一步才是第一步"},{"start":13.78,"end":19.54,"text":"互保互保是一个非常重大的一个一个政治"},{"start":19.54,"end":21.85,"text":"经济甚至军事性的一个状况"},{"start":21.85,"end":27.7,"text":"他表现在军事层面就是实质性的同盟关系啊"},{"start":27.7,"end":33.32,"text":"同盟关系就是说在军事层面就说一国遭受攻击"},{"start":33.32,"end":36.62,"text":"另一国也要对攻击他的宣战"},{"start":36.62,"end":39.08,"text":"直至进行有就是共进退"},{"start":39.52,"end":41.05,"text":"这个是我的敌人"},{"start":41.05,"end":42.28,"text":"这个向我宣战了"},{"start":42.28,"end":47.94,"text":"那么我的盟友也就和我的敌人是一个敌对关系"},{"start":47.94,"end":49.86,"text":"在军事上就是同盟关系"},{"start":49.86,"end":53.66,"text":"互保是一个非常非常大的"},{"start":53.66,"end":58.2,"text":"而在政治上呢它是一个就是说同一阵营"},{"start":58.2,"end":59.22,"text":"同一战队啊"},{"start":59.22,"end":61.89,"text":"同一阵营的啊"},{"start":61.89,"end":65.76,"text":"同意赞同一个队的互保关系"},{"start":69.54,"end":72.119,"text":"它下面下属全都要杀头啊"},{"start":72.3,"end":73.32,"text":"全都完蛋"},{"start":73.32,"end":76.0,"text":"或者说全都政治生命终结啊"},{"start":76.0,"end":77.62,"text":"全都沦落成就错了"},{"start":77.62,"end":80.41,"text":"成情绪呢失败者啊"},{"start":80.41,"end":85.98,"text":"那么我们讲究的就是说互保是一个非常严格的"},{"start":85.98,"end":87.42,"text":"互保是很难做到的"},{"start":87.42,"end":89.86,"text":"互保是个高要求啊"},{"start":89.86,"end":90.52,"text":"高要求"},{"start":90.52,"end":92.26,"text":"但是他不是一个做不到的要求"},{"start":92.26,"end":94.98,"text":"但是他又是个切实的要求"},{"start":98.04,"end":99.38,"text":"啊他是个高要求"},{"start":99.38,"end":101.32,"text":"但他又是个切实的要求"},{"start":102.16,"end":104.28,"text":"它并不是互相保护"},{"start":104.28,"end":105.36,"text":"互相保障"},{"start":105.36,"end":109.56,"text":"而是互相结成保互保"},{"start":109.56,"end":113.78,"text":"互保就是相互之间结成那个保的关系"},{"start":114.26,"end":115.76,"text":"保人你知道吗"},{"start":115.76,"end":118.43,"text":"互保这个就是我给你做保人"},{"start":118.43,"end":123.08,"text":"相当于以前中国封建时代啊"},{"start":123.08,"end":124.16,"text":"封建时代的中国"},{"start":124.16,"end":127.91,"text":"甚至到民国时期也是的一个学生要出来读书"},{"start":127.91,"end":130.5,"text":"他乡里面要有一个人给他聚宝"},{"start":130.538,"end":132.339,"text":"互保就是互相拒保"},{"start":132.339,"end":133.2,"text":"你知道吗"},{"start":133.899,"end":136.019,"text":"它不仅是一个互相拒保的问题"},{"start":136.019,"end":139.44,"text":"还是互相就是切实的用行动去相互保护"},{"start":139.44,"end":141.54,"text":"用行动来相互保护"},{"start":141.54,"end":143.56,"text":"相互保护的一个问题"},{"start":143.619,"end":147.039,"text":"互保这个反过来念好像是保护啊"},{"start":147.039,"end":149.319,"text":"就是说古代也就是说"},{"start":149.319,"end":152.529,"text":"如果这个人你是做做他的保人"},{"start":152.529,"end":154.929,"text":"那这个人犯的罪你也要犯"},{"start":154.929,"end":156.819,"text":"你也要你也要受处罚"},{"start":156.819,"end":157.98,"text":"明白吗"},{"start":159.059,"end":162.379,"text":"所以互保反过来就是说如果这个人犯了罪"},{"start":162.379,"end":164.959,"text":"保他的那个人也要和他一块"},{"start":164.959,"end":168.23,"text":"甚至要和他一起去掩盖罪状都有可能的"},{"start":168.23,"end":169.01,"text":"你明白吗"},{"start":169.01,"end":174.63,"text":"这互保关系意味着你就是对面对面对法律啊"},{"start":174.63,"end":176.16,"text":"经济政治"},{"start":176.16,"end":177.45,"text":"社会关系"},{"start":177.45,"end":180.499,"text":"经济政治啊"},{"start":180.499,"end":180.919,"text":"力啊"},{"start":180.919,"end":184.42,"text":"各方面的利益都有一个共进退的"},{"start":185.42,"end":187.98,"text":"共进退的一个关系"},{"start":188.28,"end":189.54,"text":"劫在互保"},{"start":189.54,"end":190.26,"text":"你知道吗"},{"start":190.26,"end":195.44,"text":"贼人把这个把这个结在互保我"},{"start":195.44,"end":196.52,"text":"我保护你"},{"start":196.52,"end":197.48,"text":"你也保护我"},{"start":197.48,"end":200.96,"text":"就是古代那种相拥之间结代互保那个意义"},{"start":200.96,"end":202.96,"text":"互保是一个很高的要求"},{"start":203.079,"end":206.169,"text":"但是他又是个切实的月球是可以做的"},{"start":206.169,"end":207.57,"text":"你不是不能做"},{"start":207.57,"end":212.19,"text":"你一个人被那个随时随地痞流氓或者什么村霸"},{"start":212.19,"end":213.58,"text":"街霸打了"},{"start":214.959,"end":216.059,"text":"另外一个人"},{"start":216.059,"end":216.719,"text":"你敢打他"},{"start":216.719,"end":219.0,"text":"你就打我互保"},{"start":219.0,"end":219.42,"text":"你知道吗"},{"start":219.42,"end":221.37,"text":"他是个很很激烈的"},{"start":221.37,"end":223.17,"text":"这是很激烈的"},{"start":223.17,"end":226.64,"text":"很激烈的一个一个一个一个共进退啊"},{"start":228.94,"end":232.09,"text":"哈哈它能形成一个很强大的力量的"},{"start":232.09,"end":235.21,"text":"所以这样的力量不能就说完全让他"},{"start":235.21,"end":236.87,"text":"就是说自发的来产生"},{"start":236.87,"end":239.18,"text":"如果完全让他自发的产生"},{"start":239.18,"end":240.47,"text":"自发产生的话"},{"start":240.47,"end":243.58,"text":"他很容易成为有组织犯罪"},{"start":243.72,"end":246.84,"text":"有组织犯罪或自发产生的话"},{"start":246.84,"end":251.52,"text":"他就是说就是说一旦走投无路的啊"},{"start":251.52,"end":255.08,"text":"不产阶级他意识到有一个力量就是阶层"},{"start":255.08,"end":258.11,"text":"这种就是互保的"},{"start":258.11,"end":261.13,"text":"就男权共同体啊"},{"start":261.13,"end":262.72,"text":"他其实就是黑帮画"},{"start":262.72,"end":266.66,"text":"其实就是基层的黑帮画用的stand啊"},{"start":266.66,"end":269.48,"text":"那我的观点就是说我们要啊"},{"start":269.48,"end":272.72,"text":"对于这种互保状态要去"},{"start":273.68,"end":279.1,"text":"如果说社会无法提供就是兜底性的啊"},{"start":279.1,"end":280.99,"text":"兜底性的保障"},{"start":284.79,"end":286.23,"text":"生存的长远的一个"},{"start":286.23,"end":288.87,"text":"就是终身幸福的一个保障的话"},{"start":288.87,"end":291.78,"text":"那么民间的互保它会自发产生"},{"start":291.78,"end":293.64,"text":"不是说因为我说了一句话"},{"start":293.64,"end":294.24,"text":"他就产生了"},{"start":294.24,"end":296.04,"text":"也不是说我不说这话"},{"start":296.04,"end":297.07,"text":"他就不产生"},{"start":297.07,"end":298.54,"text":"它会自发产生"},{"start":298.54,"end":304.18,"text":"而且是在没有血缘关系或者血缘关系较弱的啊"},{"start":304.18,"end":307.34,"text":"它但它有共同的利益关系"},{"start":308.06,"end":309.82,"text":"共同利益关系他也会产生"},{"start":309.82,"end":314.28,"text":"但是关键问题现在就是说我们看到的现象"},{"start":314.28,"end":316.59,"text":"它只是一个初步的投机关系"},{"start":316.59,"end":318.75,"text":"它没有形成基本的互保"},{"start":318.75,"end":319.77,"text":"它只有一个"},{"start":319.77,"end":323.38,"text":"它它没有形成一个常设的"},{"start":323.38,"end":325.9,"text":"没有形成一个常设的互保关系"},{"start":325.9,"end":331.66,"text":"他只是说临时的临时的偶然的偶然的关系"},{"start":332.34,"end":334.04,"text":"拿到钱就散了"},{"start":334.04,"end":334.64,"text":"你知道吗"},{"start":334.64,"end":337.1,"text":"拿到钱就被分化瓦解掉就散掉了"},{"start":337.1,"end":339.1,"text":"而且拿到的钱都不一样的"},{"start":339.479,"end":342.599,"text":"所以很多人就是我觉得"},{"start":342.599,"end":345.659,"text":"就是说敢把互保这个东西提出来"},{"start":345.659,"end":349.37,"text":"其实是其实这是非常敏感的"},{"start":349.37,"end":351.22,"text":"这是极为敏感的"},{"start":351.64,"end":353.02,"text":"极为敏感"},{"start":353.02,"end":354.8,"text":"极为激进的啊"},{"start":356.48,"end":357.91,"text":"极为激进的"},{"start":357.91,"end":359.32,"text":"但是我要说的是"},{"start":359.32,"end":362.2,"text":"这个是这是客观使然"},{"start":362.2,"end":363.64,"text":"他是个必由之路"},{"start":365.38,"end":366.3,"text":"必由之路"},{"start":368.34,"end":369.6,"text":"他是个必由之路"},{"start":369.6,"end":370.68,"text":"他是没办法的"},{"start":370.68,"end":371.22,"text":"你"},{"start":373.319,"end":378.649,"text":"本来就是公共司法系统和这个行政力量"},{"start":378.649,"end":381.63,"text":"治安治安力量"},{"start":381.63,"end":384.84,"text":"他本来就是应该成为成为一个"},{"start":384.84,"end":388.95,"text":"就是说使得就是这个互保"},{"start":388.95,"end":392.4,"text":"对应的就是就是那个私情"},{"start":392.4,"end":393.28,"text":"你知道吗"},{"start":393.42,"end":397.14,"text":"互保的就你你如果理解互保"},{"start":397.14,"end":399.33,"text":"你就理解类似私刑这种东西"},{"start":399.33,"end":400.74,"text":"就法律帮不了我了"},{"start":400.74,"end":401.94,"text":"我我搞私刑的"},{"start":401.94,"end":402.57,"text":"你知道吗"},{"start":402.57,"end":406.32,"text":"就是这个自治安治安本身腐化"},{"start":406.32,"end":407.88,"text":"或者说黑帮画完了"},{"start":407.88,"end":409.86,"text":"不是我只能告诉互保"},{"start":409.86,"end":415.419,"text":"类似于就是说为了避免受到打着各自幌子"},{"start":415.419,"end":417.519,"text":"各自旗号的侵害啊"},{"start":417.519,"end":419.139,"text":"底层来进行的一种"},{"start":419.139,"end":423.36,"text":"就是说他甚至连血缘关系都不都不用不用管的"},{"start":423.36,"end":425.25,"text":"就是一些工人"},{"start":426.81,"end":428.52,"text":"你只要你敢打他"},{"start":428.52,"end":430.77,"text":"我们几百个人都记着这笔账"},{"start":430.77,"end":432.0,"text":"就这么个意思"},{"start":432.0,"end":432.98,"text":"明白吧"},{"start":432.98,"end":436.92,"text":"所以这个东西呢我实事求是讲啊"},{"start":439.36,"end":441.63,"text":"目前还没有出现"},{"start":441.63,"end":444.54,"tex