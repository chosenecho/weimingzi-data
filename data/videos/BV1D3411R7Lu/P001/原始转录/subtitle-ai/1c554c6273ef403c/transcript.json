  "content_sha256": "1c554c6273ef403c149e6707f5947d371ddb5b1ce94989beabf860ffd74bd725",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 1520,
      "end_ms": 5640,
      "text": "我们要讲一个就是公益活动的直接的"
    },
    {
      "ordinal": 1,
      "start_ms": 5640,
      "end_ms": 8850,
      "text": "公益活动的直接的革命意义啊"
    },
    {
      "ordinal": 2,
      "start_ms": 8850,
      "end_ms": 13500,
      "text": "它的直接的直接的一个革命意义在于"
    },
    {
      "ordinal": 3,
      "start_ms": 17340,
      "end_ms": 20360,
      "text": "它是一个直接夺取生产资料的一个活动"
    },
    {
      "ordinal": 4,
      "start_ms": 20360,
      "end_ms": 22430,
      "text": "直接夺取生产资料"
    },
    {
      "ordinal": 5,
      "start_ms": 22430,
      "end_ms": 24770,
      "text": "直接夺取生产资料"
    },
    {
      "ordinal": 6,
      "start_ms": 24770,
      "end_ms": 26980,
      "text": "size the means of production"
    },
    {
      "ordinal": 7,
      "start_ms": 27099,
      "end_ms": 29200,
      "text": "职业夺取生产资料"
    },
    {
      "ordinal": 8,
      "start_ms": 29439,
      "end_ms": 31299,
      "text": "那么这个生产资料是最直接的"
    },
    {
      "ordinal": 9,
      "start_ms": 31299,
      "end_ms": 33099,
      "text": "也是相对非常核心的"
    },
    {
      "ordinal": 10,
      "start_ms": 33099,
      "end_ms": 34419,
      "text": "生产资料是什么"
    },
    {
      "ordinal": 11,
      "start_ms": 35760,
      "end_ms": 36860,
      "text": "劳动者本身"
    },
    {
      "ordinal": 12,
      "start_ms": 36860,
      "end_ms": 39440,
      "text": "工人本身的什么啊"
    },
    {
      "ordinal": 13,
      "start_ms": 40880,
      "end_ms": 41779,
      "text": "体力"
    },
    {
      "ordinal": 14,
      "start_ms": 43780,
      "end_ms": 44700,
      "text": "组织度"
    },
    {
      "ordinal": 15,
      "start_ms": 47760,
      "end_ms": 48800,
      "text": "以及忠诚"
    },
    {
      "ordinal": 16,
      "start_ms": 51400,
      "end_ms": 52790,
      "text": "请客吃饭"
    },
    {
      "ordinal": 17,
      "start_ms": 52790,
      "end_ms": 58070,
      "text": "就是已经是在通过最直接最赤裸的方式夺取"
    },
    {
      "ordinal": 18,
      "start_ms": 58070,
      "end_ms": 59030,
      "text": "为社会主义阵营"
    },
    {
      "ordinal": 19,
      "start_ms": 59030,
      "end_ms": 61000,
      "text": "共产主义阵营夺取工人"
    },
    {
      "ordinal": 20,
      "start_ms": 62120,
      "end_ms": 64239,
      "text": "因为社会因为资本主义生产"
    },
    {
      "ordinal": 21,
      "start_ms": 64239,
      "end_ms": 67150,
      "text": "但是要把把工人异化成为生产资料了"
    },
    {
      "ordinal": 22,
      "start_ms": 67150,
      "end_ms": 70030,
      "text": "你不可能把它作为一个直接的主人翁的"
    },
    {
      "ordinal": 23,
      "start_ms": 70030,
      "end_ms": 70990,
      "text": "已经觉醒了的"
    },
    {
      "ordinal": 24,
      "start_ms": 70990,
      "end_ms": 72070,
      "text": "有阶级意识的"
    },
    {
      "ordinal": 25,
      "start_ms": 72070,
      "end_ms": 74660,
      "text": "有阶级解放性意志的工人"
    },
    {
      "ordinal": 26,
      "start_ms": 74660,
      "end_ms": 76950,
      "text": "那样不可能"
    },
    {
      "ordinal": 27,
      "start_ms": 76950,
      "end_ms": 80250,
      "text": "你首先是把它作为一种生产资料给争夺过来"
    },
    {
      "ordinal": 28,
      "start_ms": 80250,
      "end_ms": 84400,
      "text": "要把它作为他的体力劳动啊"
    },
    {
      "ordinal": 29,
      "start_ms": 84400,
      "end_ms": 85420,
      "text": "组织度和忠诚"
    },
    {
      "ordinal": 30,
      "start_ms": 85420,
      "end_ms": 89980,
      "text": "这些东西本来都是用在为大工业机器"
    },
    {
      "ordinal": 31,
      "start_ms": 89980,
      "end_ms": 92670,
      "text": "大工业生产服务的"
    },
    {
      "ordinal": 32,
      "start_ms": 92670,
      "end_ms": 94860,
      "text": "是大工业生产当中生产资料"
    },
    {
      "ordinal": 33,
      "start_ms": 95240,
      "end_ms": 98120,
      "text": "当然他不是经典意义上那种生产资料呢"
    },
    {
      "ordinal": 34,
      "start_ms": 98120,
      "end_ms": 102140,
      "text": "他就是说劳动力本身一化成了生产资料"
    },
    {
      "ordinal": 35,
      "start_ms": 102140,
      "end_ms": 104480,
      "text": "一化成了生产当中的材料"
    },
    {
      "ordinal": 36,
      "start_ms": 106420,
      "end_ms": 110980,
      "text": "啊他的体力劳动组织度以及他的这个自我认同"
    },
    {
      "ordinal": 37,
      "start_ms": 112380,
      "end_ms": 113750,
      "text": "自我认同"
    },
    {
      "ordinal": 38,
      "start_ms": 113750,
      "end_ms": 116120,
      "text": "他就需要第二部啊"
    },
    {
      "ordinal": 39,
      "start_ms": 116120,
      "end_ms": 117200,
      "text": "需要第二步"
    },
    {
      "ordinal": 40,
      "start_ms": 117200,
      "end_ms": 122380,
      "text": "这个要需要这个劳动者反哺劳动者"
    },
    {
      "ordinal": 41,
      "start_ms": 122380,
      "end_ms": 123940,
      "text": "这个反哺困难群众啊"
    },
    {
      "ordinal": 42,
      "start_ms": 123940,
      "end_ms": 125380,
      "text": "反哺困难群众"
    },
    {
      "ordinal": 43,
      "start_ms": 128340,
      "end_ms": 133579,
      "text": "劳动群众反哺困难群众过程当中啊"
    },
    {
      "ordinal": 44,
      "start_ms": 133579,
      "end_ms": 134239,
      "text": "过程当中"
    },
    {
      "ordinal": 45,
      "start_ms": 134239,
      "end_ms": 137060,
      "text": "劳动者自己获得他自己的啊"
    },
    {
      "ordinal": 46,
      "start_ms": 137060,
      "end_ms": 139190,
      "text": "自我独立的自我认同啊"
    },
    {
      "ordinal": 47,
      "start_ms": 139190,
      "end_ms": 139970,
      "text": "独立的自我认同"
    },
    {
      "ordinal": 48,
      "start_ms": 139970,
      "end_ms": 142310,
      "text": "同时也认同与我们志愿者团队哈"
    },
    {
      "ordinal": 49,
      "start_ms": 142310,
      "end_ms": 143360,
      "text": "志愿团队"
    },
    {
      "ordinal": 50,
      "start_ms": 144119,
      "end_ms": 147520,
      "text": "公益团队啊"
    },
    {
      "ordinal": 51,
      "start_ms": 150779,
      "end_ms": 154230,
      "text": "这个夺取他的体力劳动"
    },
    {
      "ordinal": 52,
      "start_ms": 154230,
      "end_ms": 155820,
      "text": "这个不叫提了"
    },
    {
      "ordinal": 53,
      "start_ms": 155820,
      "end_ms": 157200,
      "text": "这个甚至就不叫夺取了"
    },
    {
      "ordinal": 54,
      "start_ms": 157200,
      "end_ms": 160740,
      "text": "甚至是夺取一个可以一个身体"
    },
    {
      "ordinal": 55,
      "start_ms": 162240,
      "end_ms": 166880,
      "text": "这个身体是作为一个体力再生产的体力再生产"
    },
    {
      "ordinal": 56,
      "start_ms": 166880,
      "end_ms": 170210,
      "text": "体力本身的再生产也就体力恢复的一个工具"
    },
    {
      "ordinal": 57,
      "start_ms": 170210,
      "end_ms": 172590,
      "text": "身体可以使你的体力恢复"
    },
    {
      "ordinal": 58,
      "start_ms": 172590,
      "end_ms": 173010,
      "text": "对不对"
    },
    {
      "ordinal": 59,
      "start_ms": 173010,
      "end_ms": 175950,
      "text": "身体在这上它是个体力恢复的工具"
    },
    {
      "ordinal": 60,
      "start_ms": 175950,
      "end_ms": 177090,
      "text": "我们把它暂时多"
    },
    {
      "ordinal": 61,
      "start_ms": 177090,
      "end_ms": 178950,
      "text": "就你这个消化系统嘴巴了"
    },
    {
      "ordinal": 62,
      "start_ms": 178950,
      "end_ms": 179730,
      "text": "请他吃饭"
    },
    {
      "ordinal": 63,
      "start_ms": 179730,
      "end_ms": 183660,
      "text": "其实让它的消化系统嘴巴啊"
    },
    {
      "ordinal": 64,
      "start_ms": 183660,
      "end_ms": 184740,
      "text": "它的消化系统"
    },
    {
      "ordinal": 65,
      "start_ms": 184740,
      "end_ms": 186720,
      "text": "它的嘴巴把它勾取过来"
    },
    {
      "ordinal": 66,
      "start_ms": 186720,
      "end_ms": 187740,
      "text": "让他吃我们的饭"
    },
    {
      "ordinal": 67,
      "start_ms": 187740,
      "end_ms": 188850,
      "text": "免费吃我们的饭"
    },
    {
      "ordinal": 68,
      "start_ms": 188850,
      "end_ms": 194499,
      "text": "恢复的体力变成我们施加于他的恩惠嘛啊"
    },
    {
      "ordinal": 69,
      "start_ms": 194499,
      "end_ms": 197979,
      "text": "变成我们对他进行施加的一个笼络啊"
    },
    {
      "ordinal": 70,
      "start_ms": 197979,
      "end_ms": 201600,
      "text": "这样把工人笼络团结过来"
    },
    {
      "ordinal": 71,
      "start_ms": 202499,
      "end_ms": 204079,
      "text": "这个词带有贬义"
    },
    {
      "ordinal": 72,
      "start_ms": 204079,
      "end_ms": 204499,
      "text": "whatever"
    },
    {
      "ordinal": 73,
      "start_ms": 204499,
      "end_ms": 205279,
      "text": "我不管了"
    },
    {
      "ordinal": 74,
      "start_ms": 205279,
      "end_ms": 207260,
      "text": "用词带有贬义不算什么"
    },
    {
      "ordinal": 75,
      "start_ms": 207260,
      "end_ms": 211280,
      "text": "那么可以进一步引导他们去反哺困难群众"
    },
    {
      "ordinal": 76,
      "start_ms": 211280,
      "end_ms": 215670,
      "text": "这个时候我们就把它的组织度也从大工业生产"
    },
    {
      "ordinal": 77,
      "start_ms": 215670,
      "end_ms": 217350,
      "text": "被资本异化"
    },
    {
      "ordinal": 78,
      "start_ms": 217350,
      "end_ms": 220519,
      "text": "大工业生产那边啊拯救出来"
    },
    {
      "ordinal": 79,
      "start_ms": 220519,
      "end_ms": 221239,
      "text": "把他的忠诚"
    },
    {
      "ordinal": 80,
      "start_ms": 221239,
      "end_ms": 224239,
      "text": "把他自我认同以及他的群体认同啊"
    },
    {
      "ordinal": 81,
      "start_ms": 224239,
      "end_ms": 225019,
      "text": "都拯救出来"
    },
    {
      "ordinal": 82,
      "start_ms": 225019,
      "end_ms": 226459,
      "text": "这些东西它的组织度"
    },
    {
      "ordinal": 83,
      "start_ms": 226459,
      "end_ms": 227419,
      "text": "它的忠诚"
    },
    {
      "ordinal": 84,
      "start_ms": 227419,
      "end_ms": 228019,
      "text": "自我认同"
    },
    {
      "ordinal": 85,
      "start_ms": 228019,
      "end_ms": 230839,
      "text": "群体认同都是被大工业生产异化的"
    },
    {
      "ordinal": 86,
      "start_ms": 230839,
      "end_ms": 234950,
      "text": "本来都被大工业生产异化并且奴役"
    },
    {
      "ordinal": 87,
      "start_ms": 234950,
      "end_ms": 236660,
      "text": "并且作为它的组成部分的"
    },
    {
      "ordinal": 88,
      "start_ms": 236660,
      "end_ms": 238160,
      "text": "它里面有他的鄙视链"
    },
    {
      "ordinal": 89,
      "start_ms": 238160,
      "end_ms": 239990,
      "text": "有它的享乐模式"
    },
    {
      "ordinal": 90,
      "start_ms": 239990,
      "end_ms": 242709,
      "text": "有它的鄙视链啊"
    },
    {
      "ordinal": 91,
      "start_ms": 242709,
      "end_ms": 243980,
      "text": "有他的鄙视链"
    },
    {
      "ordinal": 92,
      "start_ms": 245439,
      "end_ms": 246479,
      "text": "这些东西冲冲"
    },
    {
      "ordinal": 93,
      "start_ms": 246479,
      "end_ms": 247979,
      "text": "我们要把它改做掉啊"
    },
    {
      "ordinal": 94,
      "start_ms": 247979,
      "end_ms": 251849,
      "text": "要把引导到让他来进入到我们的循环当中"
    },
    {
      "ordinal": 95,
      "start_ms": 251849,
      "end_ms": 253739,
      "text": "进入到我们的公益啊"
    },
    {
      "ordinal": 96,
      "start_ms": 253739,
      "end_ms": 256120,
      "text": "志愿服务社的一个循环当中"
    },
    {
      "ordinal": 97,
      "start_ms": 258600,
      "end_ms": 261209,
      "text": "啊明白吗"
    },
    {
      "ordinal": 98,
      "start_ms": 261209,
      "end_ms": 263159,
      "text": "所以直接来讲"
    },
    {
      "ordinal": 99,
      "start_ms": 263159,
      "end_ms": 266039,
      "text": "它是一个直接的一个具有革命意义的一个活动"
    },
    {
      "ordinal": 100,
      "start_ms": 266039,
      "end_ms": 267719,
      "text": "直接具有革命意义的活动"
    },
    {
      "ordinal": 101,
      "start_ms": 267719,
      "end_ms": 269339,
      "text": "直接就是夺取生产资料"
    },
    {
      "ordinal": 102,
      "start_ms": 269339,
      "end_ms": 271439,
      "text": "但是这个生产资料不是说机器"
    },
    {
      "ordinal": 103,
      "start_ms": 271439,
      "end_ms": 273640,
      "text": "不是说原材料是这种事"
    },
    {
      "ordinal": 104,
      "start_ms": 273640,
      "end_ms": 275410,
      "text": "我首先我要把工人"
    },
    {
      "ordinal": 105,
      "start_ms": 275410,
      "end_ms": 277140,
      "text": "我要把劳动者"
    },
    {
      "ordinal": 106,
      "start_ms": 277840,
      "end_ms": 279840,
      "text": "把劳动者的体力啊"
    },
    {
      "ordinal": 107,
      "start_ms": 279840,
      "end_ms": 282690,
      "text": "甚至他的脑力在这过程中也成为我们的一部分"
    },
    {
      "ordinal": 108,
      "start_ms": 282690,
      "end_ms": 283200,
      "text": "体力"
    },
    {
      "ordinal": 109,
      "start_ms": 283200,
      "end_ms": 284160,
      "text": "脑力创造力"
    },
    {
      "ordinal": 110,
      "start_ms": 284160,
      "end_ms": 284730,
      "text": "组织度"
    },
    {
      "ordinal": 111,
      "start_ms": 284730,
      "end_ms": 286320,
      "text": "忠诚度啊"
    },
    {
      "ordinal": 112,
      "start_ms": 286320,
      "end_ms": 287010,
      "text": "自我认同"
    },
    {
      "ordinal": 113,
      "start_ms": 287010,
      "end_ms": 288020,
      "text": "群体认同"
    },
    {
      "ordinal": 114,
      "start_ms": 288380,
      "end_ms": 291080,
      "text": "甚至他的文化发展的文化发展"
    },
    {
      "ordinal": 115,
      "start_ms": 291080,
      "end_ms": 294780,
      "text": "文化那种啊那种能力要把他们夺取过来"
    },
    {
      "ordinal": 116,
      "start_ms": 295000,
      "end_ms": 299220,
      "text": "这就是夺取生产资料的第一步"
    },
    {
      "ordinal": 117,
      "start_ms": 299560,
      "end_ms": 301390,
      "text": "第一步是什么"
    },
    {
      "ordinal": 118,
      "start_ms": 301390,
      "end_ms": 305580,
      "text": "夺取生产资料的夺取者叫夺取夺取者"
    },
    {
      "ordinal": 119,
      "start_ms": 308759,
      "end_ms": 311100,
      "text": "夺取生产资料的夺取者"
    },
    {
      "ordinal": 120,
      "start_ms": 311180,
      "end_ms": 312800,
      "text": "第一步不做不做"
    },
    {
      "ordinal": 121,
      "start_ms": 312800,
      "end_ms": 314870,
      "text": "这第一步你怎么夺取生产资料"
    },
    {
      "ordinal": 122,
      "start_ms": 314870,
      "end_ms": 317240,
      "text": "你凭什么多去凭借无政府主义者"
    },
    {
      "ordinal": 123,
      "start_ms": 317240,
      "end_ms": 318180,
      "text": "平均一点点"
    },
    {
      "ordinal": 124,
      "start_ms": 318180,
      "end_ms": 320820,
      "text": "知识分子密谋的恐怖主义的那种突袭的"
    },
    {
      "ordinal": 125,
      "start_ms": 320820,
      "end_ms": 322420,
      "text": "怎么可能夺取生产资料"
    },
    {
      "ordinal": 126,
      "start_ms": 322420,
      "end_ms": 326139,
      "text": "所以我们这一步叫多取多取者啊"
    },
    {
      "ordinal": 127,
      "start_ms": 326139,
      "end_ms": 328059,
      "text": "这就是公益活动的他的"
    },
    {
      "ordinal": 128,
      "start_ms": 328059,
      "end_ms": 329679,
      "text": "你要非要说它有革命意义"
    },
    {
      "ordinal": 129,
      "start_ms": 329679,
      "end_ms": 331269,
      "text": "这是他革命意义好吧"
    },
    {
      "ordinal": 130,
      "start_ms": 331269,
      "end_ms": 332060,
      "text": "就讲到这里"
