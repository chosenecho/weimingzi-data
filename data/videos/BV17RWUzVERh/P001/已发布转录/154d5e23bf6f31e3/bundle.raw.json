{"segments":[{"start":1.0,"end":2.42,"text":"要杜绝几个现象啊"},{"start":2.42,"end":4.8,"text":"一如果你要冒泡"},{"start":4.8,"end":10.43,"text":"不要就是说就是我觉得很多"},{"start":10.43,"end":12.51,"text":"我们这个一线基层的工作者"},{"start":12.51,"end":13.95,"text":"和这个中层管理之间"},{"start":13.95,"end":17.25,"text":"是有非常微妙的辩证的一个关系的"},{"start":17.25,"end":18.815,"text":"首先"},{"start":19.84,"end":21.36,"text":"啊这些中层管理呢"},{"start":21.36,"end":24.16,"text":"你也不要以为他们就是特别具有非常强的能力"},{"start":24.16,"end":24.72,"text":"或怎样"},{"start":24.72,"end":30.25,"text":"他只是有相对比较多的一些权利和工作经验吧"},{"start":30.25,"end":33.83,"text":"相当于他也比较啊"},{"start":33.83,"end":36.27,"text":"他懂得用什么方法来糊弄我吗"},{"start":36.27,"end":39.769,"text":"或者说啊懂得用什么方法能够让这个事情"},{"start":39.769,"end":41.889,"text":"搪塞的过去啊"},{"start":41.889,"end":43.31,"text":"另外一方面"},{"start":43.31,"end":48.05,"text":"这个中层管理和这个一线啊"},{"start":48.05,"end":49.53,"text":"基层员工之间的关系"},{"start":49.53,"end":53.39,"text":"还是在我们这个团队里面还是很微妙的微妙"},{"start":53.39,"end":56.05,"text":"体现在大家都想出头"},{"start":56.77,"end":58.55,"text":"大家都想出头"},{"start":58.55,"end":60.86,"text":"然后我会不停的巡视"},{"start":60.86,"end":64.58,"text":"所以你们不要以为就是过度的瞎逼做事情"},{"start":64.58,"end":66.1,"text":"然后可以被我看见"},{"start":66.1,"end":68.67,"text":"我就觉得你这个人好踏实啊"},{"start":68.67,"end":71.05,"text":"你这个人好怎么怎么样的啊"},{"start":71.05,"end":73.97,"text":"好好好好有这个革命斗争精神啊"},{"start":73.97,"end":76.16,"text":"我靠好勤奋啊"},{"start":76.16,"end":77.92,"text":"好有奉献精神啊"},{"start":77.92,"end":80.71,"text":"这个东西你当我是吗"},{"start":80.95,"end":81.67,"text":"明白吗"},{"start":82.79,"end":84.99,"text":"出你不知道有句话叫出工不出力吗"},{"start":84.99,"end":87.91,"text":"有的时候或者叫你出力不出脑筋啊"},{"start":89.26,"end":91.56,"text":"那么这些中层管理也都会利用啊"},{"start":91.56,"end":95.78,"text":"利用你们这些人这种小心思啊"},{"start":95.78,"end":99.17,"text":"让你们过度干活啊"},{"start":99.17,"end":101.84,"text":"或者说过度开会"},{"start":101.84,"end":103.12,"text":"不停的开会"},{"start":103.12,"end":105.12,"text":"显得自己都在不停的在调整"},{"start":105.12,"end":106.26,"text":"在在动脑筋"},{"start":106.26,"end":108.36,"text":"这些这都倒错"},{"start":108.36,"end":108.98,"text":"你知道吗"},{"start":108.98,"end":110.74,"text":"这个对于这个事业的发展"},{"start":110.74,"end":117.76,"text":"对于就是必要的沟通交流计划预案啊"},{"start":117.76,"end":122.92,"text":"必要的这个反馈总结是有好处的"},{"start":122.92,"end":124.38,"text":"你不能过度啊"},{"start":124.38,"end":125.42,"text":"动不动开个会"},{"start":125.42,"end":127.74,"text":"或者说不完全不开会"},{"start":127.74,"end":131.26,"text":"不停的闷头去干都不行啊"},{"start":131.26,"end":133.18,"text":"一定要就是形成一个均衡"},{"start":134.22,"end":137.8,"text":"叫你一个人不停的意识"},{"start":137.8,"end":142.58,"text":"都沉浸在这个外界信息的这个反馈上面"},{"start":142.58,"end":146.78,"text":"那就是站着大白天做白日梦啊"},{"start":146.9,"end":151.38,"text":"那你说完全不在意这个大脑接收到的信息反馈"},{"start":151.38,"end":157.44,"text":"只去应接不暇的去和外部事物做这个啊互动"},{"start":157.44,"end":159.24,"text":"那你就变成个动物"},{"start":159.24,"end":161.2,"text":"就完全没有内在世界了"},{"start":161.2,"end":163.519,"text":"那两者形成一个均衡"},{"start":163.519,"end":164.519,"text":"这是一方面"},{"start":164.519,"end":168.1,"text":"就是工作本身要要这个啊反思性的"},{"start":168.1,"end":168.88,"text":"议论性的"},{"start":168.88,"end":171.64,"text":"就是开会和干活要达成一个均衡"},{"start":171.64,"end":176.25,"text":"另外一方面呢咳咳工作和学习"},{"start":176.25,"end":182.06,"text":"工作和这个个人能力的提升发展啊"},{"start":182.06,"end":184.12,"text":"也要达成一个均衡"},{"start":185.49,"end":188.35,"text":"因为你们很多人就是说私人生活"},{"start":188.35,"end":190.38,"text":"占的比重比较小呀"},{"start":190.38,"end":192.9,"text":"啊都是很多是家庭出问题了"},{"start":192.9,"end":199.92,"text":"或者说个人嗯要在这里这个重新进行一个啊"},{"start":199.92,"end":202.28,"text":"生活情境的廉洁呀"},{"start":203.04,"end":206.5,"text":"所以一时半会儿你的这个生活这方面"},{"start":206.5,"end":209.64,"text":"好像不需要怎么去啊"},{"start":209.64,"end":213.04,"text":"你这个什么娘老子也不在身边啊"},{"start":213.04,"end":214.08,"text":"也没有谈恋爱"},{"start":214.08,"end":215.16,"text":"我就算谈恋爱了"},{"start":215.16,"end":216.91,"text":"也就是那些事"},{"start":216.91,"end":219.31,"text":"私人时间要求不是很高"},{"start":219.31,"end":223.03,"text":"那就是好像可以把所有时间都投入在工作上面"},{"start":223.03,"end":224.82,"text":"这是不对的"},{"start":224.82,"end":226.92,"text":"所以我就强行安排"},{"start":233.08,"end":234.74,"text":"不是说叫你开会的"},{"start":234.74,"end":237.56,"text":"又为他们变成开会了啊"},{"start":237.56,"end":239.54,"text":"又一次变成是个领导过来"},{"start":239.54,"end":241.88,"text":"卧槽讲话讲话讲话什么"},{"start":241.88,"end":242.76,"text":"学习学习学习"},{"start":242.76,"end":243.76,"text":"但不是这种东西"},{"start":243.76,"end":246.3,"text":"我说的是正儿八经的培训"},{"start":246.3,"end":248.54,"text":"这里面的培训者被培训者"},{"start":248.54,"end":251.9,"text":"这相当于是个有点劳动者互助性质的技能"},{"start":251.9,"end":253.269,"text":"的一个分享培训"},{"start":253.269,"end":256.269,"text":"但是但又不是一个松散的分享关系"},{"start":256.269,"end":261.04,"text":"而是说是有一定的计划和组织的"},{"start":262.539,"end":267.86,"text":"啊所以要做好一个工作和发展的关系啊"},{"start":267.86,"end":270.34,"text":"就是你像玩游戏一样练级"},{"start":270.34,"end":272.48,"text":"和这个做任务的一个关系"},{"start":272.48,"end":280.16,"text":"咳当然还有就是说啊休息权的一个保障"},{"start":280.44,"end":282.78,"text":"那人娱乐私人娱乐时间也会"},{"start":282.78,"end":286.54,"text":"你要去尽可能的保障好"},{"start":287.64,"end":288.64,"text":"这是一点啊"},{"start":288.64,"end":290.48,"text":"就是处理好这两项关系"},{"start":291.6,"end":294.24,"text":"然后还有就是心态要发生转化"},{"start":295.32,"end":299.38,"text":"是一定要摒除一种想法"},{"start":299.38,"end":303.68,"text":"觉得自己做这些工作哦"},{"start":303.68,"end":307.72,"text":"是一个什么人际意义上的啊"},{"start":307.72,"end":309.56,"text":"你做工作就是做工作"},{"start":309.56,"end":312.82,"text":"你不要觉得你做这工作是在给你的什么"},{"start":312.82,"end":314.08,"text":"手下恩情"},{"start":314.08,"end":316.97,"text":"在这个培养他们啊"},{"start":316.97,"end":319.07,"text":"在教他们做人"},{"start":319.78,"end":323.99,"text":"不要觉得自己做的这些工作有什么教育意义啊"},{"start":323.99,"end":326.49,"text":"或者说有什么这个额外的一些"},{"start":326.49,"end":329.65,"text":"人际情感价值在里面"},{"start":331.86,"end":336.72,"text":"也不要认为这些经营活动它有额外的政治意义"},{"start":337.16,"end":340.17,"text":"经营活动就是经营活动啊"},{"start":340.17,"end":342.15,"text":"你要讨论什么啊"},{"start":342.15,"end":345.57,"text":"咳咳这些人都是啊潜在的革命者"},{"start":345.57,"end":348.19,"text":"我他妈的让他干这些活的时候"},{"start":348.47,"end":351.05,"text":"我尼玛在洗盘子刷碗"},{"start":351.05,"end":354.2,"text":"还有是什么哎呀"},{"start":354.2,"end":356.76,"text":"这些东西还还激发的革命意义"},{"start":356.76,"end":360.64,"text":"我尼玛我真的是服了啊"},{"start":362.32,"end":366.44,"text":"就是不要上价值上到这种程度啊"},{"start":366.44,"end":367.82,"text":"就是"},{"start":369.52,"end":373.72,"text":"就是管理层不能用这种模式来"},{"start":373.72,"end":377.1,"text":"为自己的过度管理或者不良管理"},{"start":377.1,"end":380.329,"text":"无效管理来做辩护"},{"start":380.329,"end":383.189,"text":"说我这些管理是要启发他"},{"start":383.189,"end":386.85,"text":"是要把它锤断成可以是什么啊"},{"start":386.85,"end":391.77,"text":"就是神经敏锐啊啊能力更优秀的革命家"},{"start":391.77,"end":394.49,"text":"卧槽什么这东西的上价值上"},{"start":394.49,"end":399.01,"text":"上升到这个人际培养就变成你是他爹了"},{"start":399.01,"end":401.69,"text":"我这怎么弄弄他都是好的"},{"start":401.69,"end":402.63,"text":"都是对的"},{"start":402.63,"end":404.09,"text":"捉对开会"},{"start":404.09,"end":406.6,"text":"一开开几个小时就是对你好"},{"start":406.6,"end":408.22,"text":"这是不行啊"},{"start":408.22,"end":410.32,"text":"这一定要扭过来"},{"start":410.72,"end":411.94,"text":"什么样的岗位"},{"start":411.94,"end":413.56,"text":"什么样的职务"},{"start":413.56,"end":415.14,"text":"需要什么样的能力"},{"start":415.14,"end":416.47,"text":"适配就行"},{"start":416.47,"end":418.33,"text":"你要让他发展提升"},{"start":418.33,"end":420.05,"text":"有专门的课程"},{"start":420.05,"end":421.83,"text":"有专门的学习机会"},{"start":424.53,"end":429.43,"text":"不能让这些人觉得自己受这种风气的这个沾染"},{"start":429.43,"end":432.21,"text":"哎呀要过度表现啊"},{"start":432.21,"end":433.01,"text":"要过度"},{"start":433.01,"end":434.85,"text":"这个反正就是一生"},{"start":434.85,"end":436.49,"text":"只是叫你走两步路"},{"start":436.49,"end":438.85,"text":"你给我翻十个跟头干什么"},{"start":440.4,"end":442.28,"text":"那这种东西是什么"},{"start":442.28,"end":444.36,"text":"这种东西是这些所谓的管理层"},{"start":444.36,"end":446.42,"text":"他自己脑袋里面出问题了"},{"start":446.42,"end":447.59,"text":"脑袋秀逗了"},{"start":447.59,"end":449.55,"text":"他不知道他的一身劲往哪里"},{"start":449.55,"end":451.15,"text":"使他的一身力气"},{"start":451.15,"end":455.1,"text":"就往这些可怜兮兮的这些人身上带"},{"start":455.1,"end":456.26,"text":"他妈妈拼命开会"},{"start":456.26,"end":456.98,"text":"带他妈拼命"},{"start":456.98,"end":459.22,"text":"卧槽是什么哦"},{"start":459.22