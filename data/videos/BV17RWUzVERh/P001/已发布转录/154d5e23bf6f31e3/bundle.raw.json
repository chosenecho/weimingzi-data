2299.7,"end":2301.49,"text":"把事情做好"},{"start":2307.13,"end":2308.67,"text":"这是一种平衡"},{"start":2308.67,"end":2309.83,"text":"这是一种均衡"},{"start":2309.83,"end":2311.93,"text":"但并不是机械的平衡和均衡"},{"start":2311.93,"end":2313.93,"text":"这种有机的平衡和均衡"},{"start":2313.93,"end":2316.57,"text":"这是一种迸发出生机和活力"},{"start":2316.57,"end":2318.55,"text":"我要维持这个平衡和均衡的目的是"},{"start":2318.55,"end":2320.15,"text":"我要让大家的能力更强啊"},{"start":2321.35,"end":2325.359,"text":"我要让大家就是啊更能往前走"},{"start":2325.359,"end":2329.199,"text":"他是一个在行走当中步态的一个均衡"},{"start":2329.199,"end":2330.999,"text":"不停的失重失衡"},{"start":2330.999,"end":2333.9,"text":"又不停的去恢复重心啊"},{"start":2333.9,"end":2336.26,"text":"又是有目标有目的的"},{"start":2337.59,"end":2338.27,"text":"行吧"},{"start":2338.27,"end":2342.83,"text":"这个就是我对于目前这些工作的一个呃"},{"start":2342.83,"end":2347.19,"text":"我们看到的一个什么叫做真正的政治导向"},{"start":2349.03,"end":2352.88,"text":"什么能够让人获得真正的这个嗯"},{"start":2352.88,"end":2355.6,"text":"围绕着组织的战略目标方向"},{"start":2355.6,"end":2358.0,"text":"获得真正的一个能力上"},{"start":2358.0,"end":2359.83,"text":"眼界上啊"},{"start":2359.83,"end":2364.16,"text":"思思维上的一个提升和发展的"},{"start":2366.36,"end":2368.1,"text":"啊我说的难听点"},{"start":2368.1,"end":2369.52,"text":"每一个具体的工作人员"},{"start":2369.52,"end":2373.3,"text":"他都有一种内在的向上的生长的那个积极"},{"start":2373.3,"end":2374.92,"text":"积极的那个活力"},{"start":2374.92,"end":2379.68,"text":"很多工作开展不好是因为没有揭开盖子"},{"start":2379.68,"end":2381.18,"text":"没有解开枷锁"},{"start":2381.18,"end":2382.3,"text":"那么什么是盖子"},{"start":2382.3,"end":2383.35,"text":"什么是枷锁"},{"start":2383.35,"end":2386.49,"text":"有的时候用人用到的中层管理"},{"start":2386.49,"end":2388.529,"text":"他以为他自己在做好事"},{"start":2388.529,"end":2389.849,"text":"其实潜移默化的"},{"start":2389.849,"end":2395.09,"text":"已经把下面那些人的那个自发性当成敌人了啊"},{"start":2395.09,"end":2396.43,"text":"潜移默化的在"},{"start":2396.43,"end":2398.91,"text":"已经是按照自己的那一点小小的才智"},{"start":2398.91,"end":2400.23,"text":"小小的这个是什么"},{"start":2400.23,"end":2401.87,"text":"我们说的三个主义"},{"start":2404.8,"end":2408.28,"text":"再让这个事业的上限变得很低了"},{"start":2408.28,"end":2410.36,"text":"这是不行的"},{"start":2412.84,"end":2414.28,"text":"这这什么这什么"},{"start":2414.28,"end":2417.96,"text":"这是包税制啊"},{"start":2417.96,"end":2419.92,"text":"这种这种工作当中的"},{"start":2419.92,"end":2423.189,"text":"这种包税制的这种方式是不行的"},{"start":2423.589,"end":2425.869,"text":"我不是什么这个忽必烈"},{"start":2425.869,"end":2427.529,"text":"忽必烈也他妈的不"},{"start":2427.529,"end":2428.649,"text":"他的直辖的地方"},{"start":2428.649,"end":2430.89,"text":"难道是搞你妈的包税制的吗"},{"start":2430.89,"end":2434.33,"text":"我们更多的是要就是揭开盖子啊"},{"start":2434.33,"end":2436.62,"text":"但是要要引导好啊"},{"start":2436.62,"end":2442.85,"text":"竖好这个这个顺杆爬的这些这些标杆"},{"start":2443.25,"end":2448.91,"text":"让这个基层的或者说一线执行工作人员"},{"start":2448.91,"end":2452.41,"text":"他的那种内在的力量有一个明确的方向"},{"start":2452.41,"end":2454.319,"text":"能够顺杆爬"},{"start":2457.46,"end":2459.3,"text":"而不是说你盖子给它捂住"},{"start":2459.3,"end":2462.42,"text":"让它这个东西往四周去蔓延"},{"start":2469.98,"end":2470.58,"text":"行吧"},{"start":2470.58,"end":2472.64,"text":"你们也算是说一个阶段"},{"start":2472.64,"end":2477.24,"text":"就是这些人很多人啊"},{"start":2477.24,"end":2479.6,"text":"我靠自己没有啥工作经验的"},{"start":2479.6,"end":2483.64,"text":"就从自己的那个是什么自己的工作惯性"},{"start":2483.64,"end":2485.24,"text":"分工惯性"},{"start":2485.24,"end":2487.0,"text":"甚至个人的呃"},{"start":2487.0,"end":2490.43,"text":"这个某些是很单向度的一种"},{"start":2490.43,"end":2491.87,"text":"完全从自己出发"},{"start":2491.87,"end":2493.73,"text":"自己的狭隘的见解出发"},{"start":2493.73,"end":2495.81,"text":"要去压下面的人"},{"start":2495.81,"end":2498.21,"text":"炸下面的人啊"},{"start":2498.21,"end":2499.31,"text":"这是不对的"},{"start":2500.51,"end":2505.45,"text":"这个是整体的这个一个嗯一个一个歪斜"},{"start":2505.45,"end":2509.21,"text":"把这个东西扭过来啊"},{"start":2509.21,"end":2511.95,"text":"每一个这个管理岗的人啊"},{"start":2511.95,"end":2514.47,"text":"或者说这个有行政分工的"},{"start":2514.47,"end":2521.0,"text":"要善于去坚持这个真正的群众工作的"},{"start":2521.0,"end":2523.28,"text":"一个原则啊"},{"start":2524.52,"end":2526.47,"text":"闪开身去"},{"start":2534.06,"end":2536.06,"text":"咳咳铺好路"},{"start":2536.06,"end":2537.26,"text":"闪开身"},{"start":2537.26,"end":2538.14,"text":"对不对"},{"start":2539.34,"end":2540.98,"text":"带好头"},{"start":2543.32,"end":2544.34,"text":"你戴好头"},{"start":2544.34,"end":2546.36,"text":"把人接引到相应目的点了"},{"start":2546.36,"end":2548.56,"text":"你要折返回去"},{"start":2550.48,"end":2553.12,"text":"而且你只需要带一次就行了"},{"start":2553.12,"end":2554.98,"text":"人家这个拾的这个录了之后"},{"start":2554.98,"end":2556.02,"text":"次次要你带路吗"},{"start":2556.02,"end":2557.64,"text":"不可能的"},{"start":2558.31,"end":2559.05,"text":"好"},{"start":2559.05,"end":2560.41,"text":"我就不说了"},{"start":2560.41,"end":2561.21,"text":"不多说了"},{"start":2561.21,"end":2563.41,"text":"反正就是说这个东西额"},{"start":2563.41,"end":2566.86,"text":"要求这个你是做行政管理的"},{"start":2566.86,"end":2569.66,"text":"要去学习清楚啊"},{"start":2569.66,"end":2572.399,"text":"每一个人大家都是有觉悟的"},{"start":2572.399,"end":2574.439,"text":"只是分工暂时有所不同"},{"start":2574.439,"end":2576.959,"text":"弄得你好像就是说你变成是正常人"},{"start":2576.959,"end":2577.979,"text":"其他人都有问题"},{"start":2577.979,"end":2579.059,"text":"其他人都懒惰"},{"start":2579.059,"end":2580.439,"text":"都他妈脑子有问题"},{"start":2580.439,"end":2581.819,"text":"都他妈幼稚"},{"start":2581.819,"end":2583.339,"text":"会产生这种印象"},{"start":2583.339,"end":2584.419,"text":"产生这种想法"},{"start":2584.419,"end":2586.459,"text":"你自己才懒惰才幼稚"},{"start":2586.459,"end":2588.26,"text":"你自己才他妈有问题"},{"start":2588.26,"end":2592.64,"text":"自己才的想过一种安稳的嗯"},{"start":2592.64,"end":2596.779,"text":"是一种是什么机械增增长的那种"},{"start":2596.779,"end":2598.799,"text":"好以为这样就扩大规模了"},{"start":2598.799,"end":2601.68,"text":"这样就在发展战略上有所发展和进步"},{"start":2601.68,"end":2603.0,"text":"自己有问题"},{"start":2606.14,"end":2609.42,"text":"自己在战略上没有想清楚到底应该怎么发展"},{"start":2609.42,"end":2614.51,"text":"说明的战略眼光就是想保守怂逼"},{"start":2615.82,"end":2621.239,"text":"靠这东西就知道你也不停的要制造绝望感"},{"start":2621.239,"end":2621.359,"text":"受"},{"start":2621.359,"end":2623.459,"text":"下面的所谓的惰性啊"},{"start":2623.459,"end":2625.919,"text":"无可扭转的惯性"},{"start":2626.98,"end":2629.02,"text":"不相信人民"},{"start":2629.02,"end":2629.9,"text":"不相信群众"},{"start":2629.9,"end":2633.58,"text":"不相信这个劳动者本身所带有的"},{"start":2633.58,"end":2635.25,"text":"这种自我解放的力量"},{"start":2635.25,"end":2638.88,"text":"说明你这个逼你自己不想造啊"},{"start":2639.78,"end":2640.34,"text":"行吧"},{"start":2641.46,"end":2644.21,"text":"我把这个东西给你们讲清楚了啊"},{"start":2644.21,"end":2645.11,"text":"给你讲清楚"},{"start":2645.11,"end":2647.65,"text":"我具体的和一线的这些劳动者"},{"start":2647.65,"end":2648.41,"text":"我跟他们打交道"},{"start":2648.41,"end":2652.49,"text":"我发现每个人身上都有那样一种朝气活力"},{"start":2652.73,"end":2654.41,"text":"哎为什么你们感觉不到呢"},{"start":2654.41,"end":2657.72,"text":"因为人家的赵信火力在你这里哎"},{"start":2657.72,"end":2660.64,"text":"好显得让你啊出不了风头了"},{"start":2660.64,"end":2661.76,"text":"做不了人上人了"},{"start":2661.76,"end":2662.4,"text":"你"},{"start":2662.4,"end":2663.64,"text":"当然显这种朝气活力"},{"start":2663.64,"end":2664.779,"text":"对你不利的"},{"start":2664.779,"end":2668.04,"text":"当然想办法去压制他了"},{"start":2674.58,"end":2676.26,"text":"越是有高的层级"},{"start":2676.26,"end":2677.22,"text":"高的视野的人"},{"start":2677.22,"end":2680.02,"text":"越要真的要从高的层级视野去出发"},{"start":2680.02,"end":2682.53,"text":"去设计这些方案"},{"start":2682.53,"end":2684.01,"text":"设计这些管理制度"},{"start":2685.49,"end":2690.3,"text":"管理制度最重要的是对于管理者本身加以管理"},{"start":2693.0,"end":2698.76,"text":"去设想管理和被管理这种单向度的压制性的"},{"start":2698.76,"end":2699.9,"text":"灵活性的关系"},{"start":2699.9,"end":2702.01,"text":"能够被扬弃的可能"},{"start":2702.319,"end":2704.419,"text":"而不是纯粹做你妈管理"},{"start":2704.419,"end":2706.279,"text":"你以为是过来搓他妈奴隶主啊"},{"start":2706.279,"end":2710.46,"text":"我要骂一句了"},{"start":2710.46,"end":2712.9,"text":"装作他的人畜无害的"},{"start":2712.9,"end":2715.34,"text":"好像好像什么特别纯洁美好"},{"start":2715.34,"end":2716.1,"text":"有追求的"},{"start":2716.1,"end":2718.87,"text":"你妈个逼的打着这个名义"},{"start":2719.47,"end":2720.39,"text":"实际上是错"},{"start":2720.39,"end":2723.63,"text":"他妈的做你妈统治的"},{"start":2727.84,"end":2730.6,"text":"自我辩护到这种程度吗"},{"start":2731.64,"end":2734.5,"text":"要意识到这个这种政治幼稚"},{"start":2734.5,"end":2736.24,"text":"他不是幼稚"},{"start":2736.24,"end":2738.56,"text":"这种管理层的这样一种政治上的幼稚"},{"start":2738.56,"end":2739.74,"text":"他并不是幼稚"},{"start":2739.74,"end":2742.08,"text":"是他妈邪恶"},{"start":2745.2,"end":2746.08,"text":"是病态"},{"start":2746.08,"end":2747.72,"text":"是邪恶"},{"start":2753.3,"end":2757.2,"text":"是需要自己去像斩三尸一样去斩掉的"},{"start":2757.2,"end":2760.74,"text":"心头的鬼抓出来把捏死"},{"start":2766.0,"end":2768.36,"text":"是自己的心理缺陷"},{"start":2769.579,"end":2773.819,"text":"这种心理缺陷来自于成长环境"},{"start":2773.819,"end":2774.699,"text":"小资产界"},{"start":2774.699,"end":2775.979,"text":"劣根"},{"start":2776.7,"end":2781.42,"text":"资本主义的分工关系当中的病态的工作纪律"},{"start":2781.42,"end":2783.78,"text":"所谓的管理经验"},{"start":2787.44,"end":2790.46,"text":"应当去采取的一个思路"},{"start":2794.1,"end":2797.5,"text":"行吧这个反正这些东西我讲讲清楚"},{"start":2797.5,"end":2798.79,"text":"讲明白了"},{"start":2798.79,"end":2802.47,"text":"这不是一个简单的什么职场勾心斗角全斗的啊"},{"start":2802.47,"end":2803.99,"text":"你把下面人要出头"},{"start":2803.99,"end":2805.51,"text":"上面出头什么这些东西的"},{"start":2805.51,"end":2810.14,"text":"他更多的是一个在劳动当中要谋得解放和发展"},{"start":2810.14,"end":2815.44,"text":"而不是说在劳动当中奠定统治和压迫"},{"start":2820.64,"end":2823.32,"text":"而且我们在实践上已经看到这些事情"},{"start":2823.32,"end":2824.56,"text":"怎么来防备了"},{"start":2824.56,"end":2827.6,"text":"实践上也摸索出道路了"},{"start":2830.5,"end":2835.73,"text":"啊我不希望这里面啊是客观分工有差异"},{"start":2835.73,"end":2837.79,"text":"但是思维不能扭曲"},{"start":2837.79,"end":2839.95,"text":"不能被意识形态给蛊惑"},{"start":2839.95,"end":2843.27,"text":"不能自己成为错误的意识形态的生产者"},{"start":2843.27,"end":2846.26,"text":"还用这种错误的被生产出来的意识形态"},{"start":2846.26,"end":2848.72,"text":"想要去裹挟整体战略"},{"start":2852.159,"end":2853.159,"text":"其心可诛"},{"start":2856.359,"end":2859.84,"text":"好吧你们说清楚了啊"},{"start":2859.84,"end":2861.72,"text":"说清楚说明白了啊"},{"start":2861.72,"end":2862.7,"text":"先这样啊"}],"source":"subtitle"}
