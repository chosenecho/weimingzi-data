  "content_sha256": "70ad71b3dd1dd9618872c2358a25f4e899c52768a27b902095bcbbb6c71f65a0",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 300,
      "end_ms": 5020,
      "text": "对于这些学院当中的投机分子啊"
    },
    {
      "ordinal": 1,
      "start_ms": 7420,
      "end_ms": 10920,
      "text": "我们在实践当中不能够给予任何的信任"
    },
    {
      "ordinal": 2,
      "start_ms": 10920,
      "end_ms": 12760,
      "text": "任何新人都不行"
    },
    {
      "ordinal": 3,
      "start_ms": 15239,
      "end_ms": 17400,
      "text": "都不要都不要给"
    },
    {
      "ordinal": 4,
      "start_ms": 19500,
      "end_ms": 22220,
      "text": "因为他们可能很有可能是做课题"
    },
    {
      "ordinal": 5,
      "start_ms": 22220,
      "end_ms": 24110,
      "text": "做景观的炒作"
    },
    {
      "ordinal": 6,
      "start_ms": 24110,
      "end_ms": 27920,
      "text": "哎呀炒作炒作他自己的资历的"
    },
    {
      "ordinal": 7,
      "start_ms": 29140,
      "end_ms": 31200,
      "text": "然后归根结底这些是寄生性的"
    },
    {
      "ordinal": 8,
      "start_ms": 31200,
      "end_ms": 31920,
      "text": "被豢养的"
    },
    {
      "ordinal": 9,
      "start_ms": 31920,
      "end_ms": 33980,
      "text": "归根结底它是寄生性的"
    },
    {
      "ordinal": 10,
      "start_ms": 35100,
      "end_ms": 36540,
      "text": "被豢养的"
    },
    {
      "ordinal": 11,
      "start_ms": 40380,
      "end_ms": 42320,
      "text": "这些学院派投机分子"
    },
    {
      "ordinal": 12,
      "start_ms": 42320,
      "end_ms": 45820,
      "text": "他的钱他不是他的前主人"
    },
    {
      "ordinal": 13,
      "start_ms": 45820,
      "end_ms": 47590,
      "text": "相反他的钱是他的主人"
    },
    {
      "ordinal": 14,
      "start_ms": 47590,
      "end_ms": 48760,
      "text": "他们做什么事情"
    },
    {
      "ordinal": 15,
      "start_ms": 48760,
      "end_ms": 49630,
      "text": "说什么话"
    },
    {
      "ordinal": 16,
      "start_ms": 49630,
      "end_ms": 54059,
      "text": "他的裁员一掐就断的财路一掐就断"
    },
    {
      "ordinal": 17,
      "start_ms": 58600,
      "end_ms": 63960,
      "text": "他们的财路就是就是操纵这些人的木偶细线"
    },
    {
      "ordinal": 18,
      "start_ms": 63960,
      "end_ms": 64860,
      "text": "你知道吗"
    },
    {
      "ordinal": 19,
      "start_ms": 65619,
      "end_ms": 66719,
      "text": "靠津贴"
    },
    {
      "ordinal": 20,
      "start_ms": 66719,
      "end_ms": 67679,
      "text": "靠养老金"
    },
    {
      "ordinal": 21,
      "start_ms": 67679,
      "end_ms": 69269,
      "text": "靠课题经费"
    },
    {
      "ordinal": 22,
      "start_ms": 69269,
      "end_ms": 72640,
      "text": "靠你把津贴养老金"
    },
    {
      "ordinal": 23,
      "start_ms": 75220,
      "end_ms": 76300,
      "text": "克敌经费"
    },
    {
      "ordinal": 24,
      "start_ms": 79220,
      "end_ms": 81160,
      "text": "你指望津贴养老金"
    },
    {
      "ordinal": 25,
      "start_ms": 81160,
      "end_ms": 81760,
      "text": "客机经费"
    },
    {
      "ordinal": 26,
      "start_ms": 81760,
      "end_ms": 85390,
      "text": "这些钱能够去指导什么左翼社会运动"
    },
    {
      "ordinal": 27,
      "start_ms": 85390,
      "end_ms": 86920,
      "text": "做梦呢"
    },
    {
      "ordinal": 28,
      "start_ms": 87360,
      "end_ms": 88560,
      "text": "你在做梦"
    },
    {
      "ordinal": 29,
      "start_ms": 88560,
      "end_ms": 98119,
      "text": "诶啊这些投机分子除非除非退出教职"
    },
    {
      "ordinal": 30,
      "start_ms": 101660,
      "end_ms": 103510,
      "text": "真正到群众中来"
    },
    {
      "ordinal": 31,
      "start_ms": 103510,
      "end_ms": 105190,
      "text": "真正到群众中来"
    },
    {
      "ordinal": 32,
      "start_ms": 105190,
      "end_ms": 106120,
      "text": "退出教职"
    },
    {
      "ordinal": 33,
      "start_ms": 106120,
      "end_ms": 107380,
      "text": "丢掉铁饭碗"
    },
    {
      "ordinal": 34,
      "start_ms": 112200,
      "end_ms": 114140,
      "text": "我的要求就是退出教职"
    },
    {
      "ordinal": 35,
      "start_ms": 114140,
      "end_ms": 114860,
      "text": "丢掉铁饭碗"
    },
    {
      "ordinal": 36,
      "start_ms": 114860,
      "end_ms": 116300,
      "text": "否则你说的话就当放屁"
    },
    {
      "ordinal": 37,
      "start_ms": 116300,
      "end_ms": 117860,
      "text": "真正到群众中来"
    },
    {
      "ordinal": 38,
      "start_ms": 120640,
      "end_ms": 122420,
      "text": "得到群众的支持"
    },
    {
      "ordinal": 39,
      "start_ms": 123120,
      "end_ms": 123980,
      "text": "你说的话"
    },
    {
      "ordinal": 40,
      "start_ms": 123980,
      "end_ms": 124700,
      "text": "你给他道路"
    },
    {
      "ordinal": 41,
      "start_ms": 124700,
      "end_ms": 125840,
      "text": "给的路线真的是有作用"
    },
    {
      "ordinal": 42,
      "start_ms": 125840,
      "end_ms": 127910,
      "text": "那得到直接得到群众的支持"
    },
    {
      "ordinal": 43,
      "start_ms": 127910,
      "end_ms": 129380,
      "text": "你直接去去拿"
    },
    {
      "ordinal": 44,
      "start_ms": 129380,
      "end_ms": 130100,
      "text": "群众之前"
    },
    {
      "ordinal": 45,
      "start_ms": 130100,
      "end_ms": 131880,
      "text": "直接得到群众的支持"
    },
    {
      "ordinal": 46,
      "start_ms": 132899,
      "end_ms": 135280,
      "text": "不要从你主子那讨饭吃"
    },
    {
      "ordinal": 47,
      "start_ms": 135619,
      "end_ms": 137059,
      "text": "靠铁饭碗在那边"
    },
    {
      "ordinal": 48,
      "start_ms": 137059,
      "end_ms": 139789,
      "text": "一天到晚幺三忽悠的"
    },
    {
      "ordinal": 49,
      "start_ms": 139789,
      "end_ms": 141199,
      "text": "你靠一个铁饭碗"
    },
    {
      "ordinal": 50,
      "start_ms": 141199,
      "end_ms": 144140,
      "text": "幺三忽悠的还说你在骂你的主子"
    },
    {
      "ordinal": 51,
      "start_ms": 145980,
      "end_ms": 147920,
      "text": "你有本事真的到群众中来看"
    },
    {
      "ordinal": 52,
      "start_ms": 147920,
      "end_ms": 149540,
      "text": "群众给不给你一口饭吃"
    },
    {
      "ordinal": 53,
      "start_ms": 149540,
      "end_ms": 152240,
      "text": "说这个什么老头当年做过工人的"
    },
    {
      "ordinal": 54,
      "start_ms": 152240,
      "end_ms": 154120,
      "text": "他那工人也是铁饭碗呀"
    },
    {
      "ordinal": 55,
      "start_ms": 155040,
      "end_ms": 156300,
      "text": "在搞笑"
    },
    {
      "ordinal": 56,
      "start_ms": 159640,
      "end_ms": 160980,
      "text": "你有本事退出教职"
    },
    {
      "ordinal": 57,
      "start_ms": 160980,
      "end_ms": 161910,
      "text": "丢掉铁饭碗"
    },
    {
      "ordinal": 58,
      "start_ms": 161910,
      "end_ms": 163800,
      "text": "真正到群众中来"
    },
    {
      "ordinal": 59,
      "start_ms": 163800,
      "end_ms": 165210,
      "text": "看看群众会不会给你支持"
    },
    {
      "ordinal": 60,
      "start_ms": 165210,
      "end_ms": 166640,
      "text": "群众会不会给你支持"
    },
    {
      "ordinal": 61,
      "start_ms": 166799,
      "end_ms": 168119,
      "text": "无根脚的"
    },
    {
      "ordinal": 62,
      "start_ms": 168119,
      "end_ms": 169799,
      "text": "无官方背景的"
    },
    {
      "ordinal": 63,
      "start_ms": 169799,
      "end_ms": 173230,
      "text": "没有编制的普通群众"
    },
    {
      "ordinal": 64,
      "start_ms": 173230,
      "end_ms": 174400,
      "text": "你说的话"
    },
    {
      "ordinal": 65,
      "start_ms": 174400,
      "end_ms": 177580,
      "text": "你主张的路线是不是符合他们的长远利益"
    },
    {
      "ordinal": 66,
      "start_ms": 178480,
      "end_ms": 182200,
      "text": "你那句古语就是一定要去鼓吹"
    },
    {
      "ordinal": 67,
      "start_ms": 182200,
      "end_ms": 183430,
      "text": "要去吆喝"
    },
    {
      "ordinal": 68,
      "start_ms": 183430,
      "end_ms": 185560,
      "text": "能不能把社会舆论"
    },
    {
      "ordinal": 69,
      "start_ms": 185560,
      "end_ms": 187540,
      "text": "把社会文化往那方向去迁移"
    },
    {
      "ordinal": 70,
      "start_ms": 187579,
      "end_ms": 189199,
      "text": "你这你拿人"
    },
    {
      "ordinal": 71,
      "start_ms": 189199,
      "end_ms": 192499,
      "text": "我真的是真的是我真的是这种东西可信吗"
    },
    {
      "ordinal": 72,
      "start_ms": 192499,
      "end_ms": 194040,
      "text": "这些人可信吗"
    },
    {
      "ordinal": 73,
      "start_ms": 194500,
      "end_ms": 197080,
      "text": "这些人永远要打个问号"
    },
    {
      "ordinal": 74,
      "start_ms": 197080,
      "end_ms": 201040,
      "text": "他最后诶他的教职拿来做要挟的时候"
    },
    {
      "ordinal": 75,
      "start_ms": 201040,
      "end_ms": 203930,
      "text": "他的那个工资性收入拿来做要挟的时候"
    },
    {
      "ordinal": 76,
      "start_ms": 203930,
      "end_ms": 205910,
      "text": "他的铁饭碗拿来做要挟的时候"
    },
    {
      "ordinal": 77,
      "start_ms": 205910,
      "end_ms": 206990,
      "text": "他会选哪一个"
    },
    {
      "ordinal": 78,
      "start_ms": 206990,
      "end_ms": 207650,
      "text": "这些人"
    },
    {
      "ordinal": 79,
      "start_ms": 207650,
      "end_ms": 208360,
      "text": "卧槽"
    },
    {
      "ordinal": 80,
      "start_ms": 208480,
      "end_ms": 210280,
      "text": "就在这些东西面前"
    },
    {
      "ordinal": 81,
      "start_ms": 210280,
      "end_ms": 212480,
      "text": "他都有可能做叛徒的"
    },
    {
      "ordinal": 82,
      "start_ms": 212619,
      "end_ms": 214119,
      "text": "都有可能做叛徒的"
    },
    {
      "ordinal": 83,
      "start_ms": 214119,
      "end_ms": 215619,
      "text": "都有可能直接就怂了"
    },
    {
      "ordinal": 84,
      "start_ms": 215619,
      "end_ms": 217300,
      "text": "直接就就出卖人了"
    },
    {
      "ordinal": 85,
      "start_ms": 218200,
      "end_ms": 219990,
      "text": "你有本事真正到群众中来吗"
    },
    {
      "ordinal": 86,
      "start_ms": 219990,
      "end_ms": 221880,
      "text": "我的要求就是你有本事退出教职"
    },
    {
      "ordinal": 87,
      "start_ms": 221880,
      "end_ms": 223160,
      "text": "丢掉铁饭碗吗"
    },
    {
      "ordinal": 88,
      "start_ms": 223299,
      "end_ms": 227679,
      "text": "你教职还是捧着每个月工资照发领着"
    },
    {
      "ordinal": 89,
      "start_ms": 227679,
      "end_ms": 230620,
      "text": "你好意思说你是好意思说"
    },
    {
      "ordinal": 90,
      "start_ms": 230620,
      "end_ms": 233260,
      "text": "你能够进行一个彻底根本性的一个批判"
    },
    {
      "ordinal": 91,
      "start_ms": 233260,
      "end_ms": 236649,
      "text": "会有根本性的激进的行动"
    },
    {
      "ordinal": 92,
      "start_ms": 236649,
      "end_ms": 237879,
      "text": "都是在做梦"
    },
    {
      "ordinal": 93,
      "start_ms": 237879,
      "end_ms": 238599,
      "text": "都在放屁"
    },
    {
      "ordinal": 94,
      "start_ms": 238599,
      "end_ms": 239139,
      "text": "在做梦"
    },
    {
      "ordinal": 95,
      "start_ms": 239139,
      "end_ms": 240219,
      "text": "实际上都在做梦"
    },
    {
      "ordinal": 96,
      "start_ms": 240219,
      "end_ms": 241080,
      "text": "你知道吗"
    },
    {
      "ordinal": 97,
      "start_ms": 242200,
      "end_ms": 243660,
      "text": "真的是太恶心了"
    },
    {
      "ordinal": 98,
      "start_ms": 243660,
      "end_ms": 245190,
      "text": "我觉得这太恶心了"
    },
    {
      "ordinal": 99,
      "start_ms": 245190,
      "end_ms": 246500,
      "text": "太恶心了"
    },
    {
      "ordinal": 100,
      "start_ms": 246600,
      "end_ms": 249030,
      "text": "尤其在一些京圈的"
    },
    {
      "ordinal": 101,
      "start_ms": 249030,
      "end_ms": 252790,
      "text": "京圈的一些学学学院派的投机分子里面"
    },
    {
      "ordinal": 102,
      "start_ms": 252790,
      "end_ms": 254350,
      "text": "学院派投机分子里面"
    },
    {
      "ordinal": 103,
      "start_ms": 254350,
      "end_ms": 256510,
      "text": "你们这个太恶心了"
    },
    {
      "ordinal": 104,
      "start_ms": 256510,
      "end_ms": 257360,
      "text": "你知道吗"
    },
    {
      "ordinal": 105,
      "start_ms": 258319,
      "end_ms": 260019,
      "text": "你叫这叫撕掉"
    },
    {
      "ordinal": 106,
      "start_ms": 260019,
      "end_ms": 260379,
      "text": "很简单"
    },
    {
      "ordinal": 107,
      "start_ms": 260379,
      "end_ms": 261459,
      "text": "你有本事退掉"
    },
    {
      "ordinal": 108,
      "start_ms": 262079,
      "end_ms": 265459,
      "text": "但我没有说叫你退出政治关系"
    },
    {
      "ordinal": 109,
      "start_ms": 265459,
      "end_ms": 266149,
      "text": "叫你退掉"
    },
    {
      "ordinal": 110,
      "start_ms": 266149,
      "end_ms": 268549,
      "text": "你有本事把这个你的钱的来路"
    },
    {
      "ordinal": 111,
      "start_ms": 268549,
      "end_ms": 269860,
      "text": "钱的来路"
    },
    {
      "ordinal": 112,
      "start_ms": 273460,
      "end_ms": 276660,
      "text": "你这铁饭碗也不是不要就是搞笑"
    },
    {
      "ordinal": 113,
      "start_ms": 276660,
      "end_ms": 278620,
      "text": "真的是我受不了了"
