{
  "segments": [
    {
      "start": 0.16,
      "end": 1.76,
      "text": "我们今天要讲的就是说，"
    },
    {
      "start": 2.8,
      "end": 6.96,
      "text": "有大的智慧，必然会有大的勇敢，"
    },
    {
      "start": 8.48,
      "end": 11.84,
      "text": "因为大智者，有大智者"
    },
    {
      "start": 12.88,
      "end": 19.12,
      "text": "可以看到世间各种挑战当中被人忽视的规则，"
    },
    {
      "start": 21.6,
      "end": 25.68,
      "text": "以及被淹没、遮蔽了很久的机会，"
    },
    {
      "start": 27.36,
      "end": 33.68,
      "text": "那么他就会有大的勇气去尝试，去切入现实，去做出"
    },
    {
      "start": 34.8,
      "end": 36.08,
      "text": "非常显著的改变，"
    },
    {
      "start": 37.44,
      "end": 39.92,
      "text": "而且他可以单枪匹马就做到这一点。"
    },
    {
      "start": 41.92,
      "end": 45.04,
      "text": "当他做到这一点的时候，他一定会产生大的勇气，"
    },
    {
      "start": 47.76,
      "end": 49.36,
      "text": "并且让周围的人感受到，"
    },
    {
      "start": 52.24,
      "end": 54.24,
      "text": "那么他就会获得很多追随者，"
    },
    {
      "start": 56.0,
      "end": 57.84,
      "text": "在他的勇气的感召、"
    },
    {
      "start": 58.88,
      "end": 67.28,
      "text": "激励之下，也获得行动的决心。"
    },
    {
      "start": 67.92,
      "end": 79.6,
      "text": "但是呢，大勇者必有大怯，"
    },
    {
      "start": 82.88,
      "end": 85.2,
      "text": "有大的勇气的人一定会有大的怯懦，"
    },
    {
      "start": 87.36,
      "end": 94.24,
      "text": "他的勇敢可以来自于他的智慧，"
    },
    {
      "start": 96.24,
      "end": 101.6,
      "text": "也来自于他对于身边人、亲人的长久的安顿。"
    },
    {
      "start": 105.36,
      "end": 114.4,
      "text": "但是他的追随者，被他的勇气感召、激励的产生了投入、牺牲的决心的人，"
    },
    {
      "start": 116.08,
      "end": 117.12,
      "text": "他们很容易忽视，"
    },
    {
      "start": 118.56,
      "end": 120.48,
      "text": "他们不一定具备完备的智慧，"
    },
    {
      "start": 122.08,
      "end": 123.52,
      "text": "不一定做好了准备，"
    },
    {
      "start": 130.96,
      "end": 133.68,
      "text": "他们或许做出了选择，但是他们的亲人、"
    },
    {
      "start": 134.8,
      "end": 137.68,
      "text": "他们的家人总要承受"
    },
    {
      "start": 142.24,
      "end": 145.28,
      "text": "不安、焦虑乃至痛苦。"
    },
    {
      "start": 147.84,
      "end": 151.76,
      "text": "那么对于有大的勇敢的人，由于他也有大的智慧，"
    },
    {
      "start": 154.0,
      "end": 159.52,
      "text": "他一定能够预料到这些，他也能够感受到这些，他也不得不"
    },
    {
      "start": 164.24,
      "end": 168.88,
      "text": "为这些感到悲伤、痛苦和怯懦。"
    },
    {
      "start": 174.88,
      "end": 177.2,
      "text": "一个人的生生死很容易抛掷的。"
    },
    {
      "start": 180.198,
      "end": 185.158,
      "text": "哪怕是他的周围人，"
    },
    {
      "start": 187.158,
      "end": 189.398,
      "text": "对于他的怜惜和疼爱，"
    },
    {
      "start": 192.118,
      "end": 198.518,
      "text": "在思想上、在精神上，做好了足够的、充分的准备，坚定的选择，"
    },
    {
      "start": 199.638,
      "end": 202.518,
      "text": "大的智慧可以带来大的勇气，"
    },
    {
      "start": 204.758,
      "end": 206.998,
      "text": "可以消化掉这些内疚、歉疚。"
    },
    {
      "start": 210.358,
      "end": 214.838,
      "text": "那是别人的呢，但是千千万万的"
    },
    {
      "start": 215.958,
      "end": 216.998,
      "text": "追随你的脚步的人呢？"
    },
    {
      "start": 227.798,
      "end": 229.478,
      "text": "他们或许原本可以"
    },
    {
      "start": 230.918,
      "end": 234.438,
      "text": "保有天年，获得善终，"
    },
    {
      "start": 236.838,
      "end": 238.038,
      "text": "或者有长久的安定，"
    },
    {
      "start": 240.278,
      "end": 244.438,
      "text": "些许的不安，但是不至于说"
    },
    {
      "start": 245.798,
      "end": 247.398,
      "text": "承受那么剧烈的痛苦，"
    },
    {
      "start": 248.518,
      "end": 253.478,
      "text": "或者说变得毫无机会"
    },
    {
      "start": 254.678,
      "end": 260.918,
      "text": "再去过上那样轻松的生活。"
    },
    {
      "start": 265.798,
      "end": 275.878,
      "text": "这些顾虑，尤其是他们背后的亲人家属的、"
    },
    {
      "start": 277.718,
      "end": 279.078,
      "text": "月亮的痛苦不安，"
    },
    {
      "start": 282.758,
      "end": 286.038,
      "text": "他会给有大的勇气的人带来大的怯懦，"
    },
    {
      "start": 287.158,
      "end": 290.038,
      "text": "逼迫他无限的慎重，"
    },
    {
      "start": 291.878,
      "end": 299.318,
      "text": "无比的慎重，逼迫他反复的锤锻自己的智慧，"
    },
    {
      "start": 302.278,
      "end": 303.878,
      "text": "去制定稳妥的方案，"
    },
    {
      "start": 307.718,
      "end": 308.998,
      "text": "寻找恰当的路径。"
    },
    {
      "start": 313.158,
      "end": 317.158,
      "text": "所以大智必有大勇，大勇必有大怯，"
    },
    {
      "start": 318.518,
      "end": 322.438,
      "text": "怯懦不一定是错误的东西，只要怯懦"
    },
    {
      "start": 323.478,
      "end": 327.398,
      "text": "来自于勇气本身，怯懦能够导向智慧，"
    },
    {
      "start": 339.318,
      "end": 340.918,
      "text": "怯懦是负责任的体现，"
    },
    {
      "start": 342.438,
      "end": 348.278,
      "text": "只要怯懦不指向自己，而是指向别人的得失、别人的生死。"
    },
    {
      "start": 366.688,
      "end": 371.808,
      "text": "就这样怯懦着吧，我是无可奈何的。"
    }
  ],
  "source": "asr",
