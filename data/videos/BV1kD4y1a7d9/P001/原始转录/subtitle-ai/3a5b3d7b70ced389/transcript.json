  "segments": [
    {
      "ordinal": 0,
      "start_ms": 2760,
      "end_ms": 4019,
      "text": "还有一首老歌啊"
    },
    {
      "ordinal": 1,
      "start_ms": 4019,
      "end_ms": 4980,
      "text": "唱一下啊"
    },
    {
      "ordinal": 2,
      "start_ms": 4980,
      "end_ms": 6180,
      "text": "也比较有价值"
    },
    {
      "ordinal": 3,
      "start_ms": 6180,
      "end_ms": 27680,
      "text": "啊啊啊啊啊呜呜呜"
    },
    {
      "ordinal": 4,
      "start_ms": 50960,
      "end_ms": 56740,
      "text": "啊啊啊"
    },
    {
      "ordinal": 5,
      "start_ms": 59180,
      "end_ms": 63080,
      "text": "心儿的影"
    },
    {
      "ordinal": 6,
      "start_ms": 63600,
      "end_ms": 72240,
      "text": "月亮的心映在水中"
    },
    {
      "ordinal": 7,
      "start_ms": 72640,
      "end_ms": 76620,
      "text": "嘴唇如玉"
    },
    {
      "ordinal": 8,
      "start_ms": 77120,
      "end_ms": 79780,
      "text": "云海的冰"
    },
    {
      "ordinal": 9,
      "start_ms": 81760,
      "end_ms": 88800,
      "text": "风儿的花映在眼中"
    },
    {
      "ordinal": 10,
      "start_ms": 90720,
      "end_ms": 94140,
      "text": "去向何方"
    },
    {
      "ordinal": 11,
      "start_ms": 94780,
      "end_ms": 97680,
      "text": "你曾说"
    },
    {
      "ordinal": 12,
      "start_ms": 98780,
      "end_ms": 105340,
      "text": "天上有一颗这样一颗"
    },
    {
      "ordinal": 13,
      "start_ms": 107980,
      "end_ms": 110320,
      "text": "一颗大树"
    },
    {
      "ordinal": 14,
      "start_ms": 113480,
      "end_ms": 115660,
      "text": "他落下"
    },
    {
      "ordinal": 15,
      "start_ms": 117400,
      "end_ms": 120300,
      "text": "冰雪般落叶"
    },
    {
      "ordinal": 16,
      "start_ms": 121860,
      "end_ms": 123840,
      "text": "随着秋风"
    },
    {
      "ordinal": 17,
      "start_ms": 125680,
      "end_ms": 128639,
      "text": "洒满天船"
    },
    {
      "ordinal": 18,
      "start_ms": 131160,
      "end_ms": 134970,
      "text": "想着夜晚月摇寒"
    },
    {
      "ordinal": 19,
      "start_ms": 134970,
      "end_ms": 143970,
      "text": "富庶苍茫与外双叶洒天窗"
    },
    {
      "ordinal": 20,
      "start_ms": 143970,
      "end_ms": 148660,
      "text": "跳舞自风声凛冽"
    },
    {
      "ordinal": 21,
      "start_ms": 148660,
      "end_ms": 150340,
      "text": "灯火灿烂"
    },
    {
      "ordinal": 22,
      "start_ms": 151480,
      "end_ms": 153280,
      "text": "青与关"
    },
    {
      "ordinal": 23,
      "start_ms": 153280,
      "end_ms": 155050,
      "text": "萤火灿烂"
    },
    {
      "ordinal": 24,
      "start_ms": 155050,
      "end_ms": 158930,
      "text": "青玉关心中"
    },
    {
      "ordinal": 25,
      "start_ms": 158930,
      "end_ms": 161980,
      "text": "1月牙寒"
    },
    {
      "ordinal": 26,
      "start_ms": 161980,
      "end_ms": 166940,
      "text": "浮世无常与外"
    },
    {
      "ordinal": 27,
      "start_ms": 167040,
      "end_ms": 168380,
      "text": "你还说"
    },
    {
      "ordinal": 28,
      "start_ms": 171020,
      "end_ms": 177860,
      "text": "树上有一只这样一只"
    },
    {
      "ordinal": 29,
      "start_ms": 179900,
      "end_ms": 182360,
      "text": "一只蜂乱"
    },
    {
      "ordinal": 30,
      "start_ms": 184660,
      "end_ms": 190880,
      "text": "他不带你去离去到远方"
    },
    {
      "ordinal": 31,
      "start_ms": 193820,
      "end_ms": 199180,
      "text": "他的身影明灭"
    },
    {
      "ordinal": 32,
      "start_ms": 200740,
      "end_ms": 201700,
      "text": "可歌可白啊"
    },
    {
      "ordinal": 33,
      "start_ms": 201700,
      "end_ms": 202690,
      "text": "那随意啊"
    },
    {
      "ordinal": 34,
      "start_ms": 202690,
      "end_ms": 205780,
      "text": "天边那一刻"
    },
    {
      "ordinal": 35,
      "start_ms": 206720,
      "end_ms": 208810,
      "text": "离离星火之中"
    },
    {
      "ordinal": 36,
      "start_ms": 208810,
      "end_ms": 215920,
      "text": "一颗萤火在风波中不停留"
    },
    {
      "ordinal": 37,
      "start_ms": 215920,
      "end_ms": 217780,
      "text": "青骓与关"
    },
    {
      "ordinal": 38,
      "start_ms": 217780,
      "end_ms": 221660,
      "text": "青春与关心"
    },
    {
      "ordinal": 39,
      "start_ms": 221660,
      "end_ms": 225500,
      "text": "戳眼月摇寒"
    },
    {
      "ordinal": 40,
      "start_ms": 225660,
      "end_ms": 227810,
      "text": "浮世草"
    },
    {
      "ordinal": 41,
      "start_ms": 227810,
      "end_ms": 229960,
      "text": "绿花"
    },
    {
      "ordinal": 42,
      "start_ms": 230000,
      "end_ms": 234200,
      "text": "山河有卫星"
    },
    {
      "ordinal": 43,
      "start_ms": 234200,
      "end_ms": 236930,
      "text": "簌簌飘零人间"
    },
    {
      "ordinal": 44,
      "start_ms": 236930,
      "end_ms": 242760,
      "text": "如今好梦佳期难寻"
    },
    {
      "ordinal": 45,
      "start_ms": 242760,
      "end_ms": 248840,
      "text": "谁不知我此心独身者"
    },
    {
      "ordinal": 46,
      "start_ms": 248840,
      "end_ms": 259540,
      "text": "冥冥长夜啊"
    }
  ],
  "text": "还有一首老歌啊\n唱一下啊\n也比较有价值\n啊啊啊啊啊呜呜呜\n啊啊啊\n心儿的影\n月亮的心映在水中\n嘴唇如玉\n云海的冰\n风儿的花映在眼中\n去向何方\n你曾说\n天上有一颗这样一颗\n一颗大树\n他落下\n冰雪般落叶\n随着秋风\n洒满天船\n想着夜晚月摇寒\n富庶苍茫与外双叶洒天窗\n跳舞自风声凛冽\n灯火灿烂\n青与关\n萤火灿烂\n青玉关心中\n1月牙寒\n浮世无常与外\n你还说\n树上有一只这样一只\n一只蜂乱\n他不带你去离去到远方\n他的身影明灭\n可歌可白啊\n那随意啊\n天边那一刻\n离离星火之中\n一颗萤火在风波中不停留\n青骓与关\n青春与关心\n戳眼月摇寒\n浮世草\n绿花\n山河有卫星\n簌簌飘零人间\n如今好梦佳期难寻\n谁不知我此心独身者\n冥冥长夜啊",
  "timing_issue": null
}
