{
  "bvid": "BV1RM4y147Y2",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "0a6045d1459e0fc5796e7187e9154f701101c9d79bfc1bea202e086943298186",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 5340,
      "end_ms": 6500,
      "text": "大家好"
    },
    {
      "ordinal": 1,
      "start_ms": 7720,
      "end_ms": 9900,
      "text": "我叫刘思墨"
    },
    {
      "ordinal": 2,
      "start_ms": 9900,
      "end_ms": 12980,
      "text": "文刀刘司机的思墨水墨"
    },
    {
      "ordinal": 3,
      "start_ms": 15300,
      "end_ms": 22139,
      "text": "那么我是这个全国各地的这个呃"
    },
    {
      "ordinal": 4,
      "start_ms": 22139,
      "end_ms": 27200,
      "text": "公益活动的一个一个提倡者啊"
    },
    {
      "ordinal": 5,
      "start_ms": 27200,
      "end_ms": 28940,
      "text": "这个理念的提出者"
    },
    {
      "ordinal": 6,
      "start_ms": 31140,
      "end_ms": 35120,
      "text": "那么公益活动呢它是一项群众运动"
    },
    {
      "ordinal": 7,
      "start_ms": 35120,
      "end_ms": 37400,
      "text": "不具有政治性啊"
    },
    {
      "ordinal": 8,
      "start_ms": 43820,
      "end_ms": 46460,
      "text": "年轻的无产者"
    },
    {
      "ordinal": 9,
      "start_ms": 46460,
      "end_ms": 50150,
      "text": "也包括一些小等阶级的啊"
    },
    {
      "ordinal": 10,
      "start_ms": 50150,
      "end_ms": 51760,
      "text": "脑力劳动者"
    },
    {
      "ordinal": 11,
      "start_ms": 52640,
      "end_ms": 53620,
      "text": "城市白领"
    },
    {
      "ordinal": 12,
      "start_ms": 54640,
      "end_ms": 62220,
      "text": "他们自发的以一个不超出现实必要性的方式"
    },
    {
      "ordinal": 13,
      "start_ms": 62220,
      "end_ms": 67500,
      "text": "一个程度啊团结在一起去抱团啊"
    },
    {
      "ordinal": 14,
      "start_ms": 67500,
      "end_ms": 68760,
      "text": "抱团不是他主要目的"
    },
    {
      "ordinal": 15,
      "start_ms": 68760,
      "end_ms": 75700,
      "text": "是它的副产品去啊学了一封献爱心送温暖"
    },
    {
      "ordinal": 16,
      "start_ms": 77980,
      "end_ms": 78880,
      "text": "那么"
    },
    {
      "ordinal": 17,
      "start_ms": 80540,
      "end_ms": 85300,
      "text": "和我的伙伴啊也是每天啊"
    },
    {
      "ordinal": 18,
      "start_ms": 85300,
      "end_ms": 87880,
      "text": "就在我的那个个体户的那个面馆"
    },
    {
      "ordinal": 19,
      "start_ms": 88060,
      "end_ms": 91780,
      "text": "在粤西街道啊"
    },
    {
      "ordinal": 20,
      "start_ms": 91780,
      "end_ms": 97840,
      "text": "男生活广场七幢103盖斯特餐饮店"
    },
    {
      "ordinal": 21,
      "start_ms": 97840,
      "end_ms": 100840,
      "text": "我们每天都进行公益活动"
    },
    {
      "ordinal": 22,
      "start_ms": 100840,
      "end_ms": 103840,
      "text": "那么这个公益活动的利润啊"
    },
    {
      "ordinal": 23,
      "start_ms": 103840,
      "end_ms": 105220,
      "text": "这公益活动的开支啊"
    },
    {
      "ordinal": 24,
      "start_ms": 105220,
      "end_ms": 108340,
      "text": "来自于我的淘宝店里面啊"
    },
    {
      "ordinal": 25,
      "start_ms": 108340,
      "end_ms": 111140,
      "text": "售卖的文创产品的利润好"
    },
    {
      "ordinal": 26,
      "start_ms": 111660,
      "end_ms": 114060,
      "text": "这是我的情况啊"
    },
    {
      "ordinal": 27,
      "start_ms": 114060,
      "end_ms": 115440,
      "text": "我其他情况就不说了"
    },
    {
      "ordinal": 28,
      "start_ms": 115440,
      "end_ms": 116280,
      "text": "那我也说了"
    },
    {
      "ordinal": 29,
      "start_ms": 116280,
      "end_ms": 121620,
      "text": "就是说我号召提议啊"
    },
    {
      "ordinal": 30,
      "start_ms": 123360,
      "end_ms": 127340,
      "text": "公益事业这个工是工人的工啊"
    },
    {
      "ordinal": 31,
      "start_ms": 127340,
      "end_ms": 129169,
      "text": "公益事业的支持者"
    },
    {
      "ordinal": 32,
      "start_ms": 129169,
      "end_ms": 130539,
      "text": "关注者"
    },
    {
      "ordinal": 33,
      "start_ms": 132239,
      "end_ms": 134740,
      "text": "啊认同者"
    },
    {
      "ordinal": 34,
      "start_ms": 138519,
      "end_ms": 141660,
      "text": "大家一同将"
    },
    {
      "ordinal": 35,
      "start_ms": 150680,
      "end_ms": 153220,
      "text": "是剥夺否定这种历史必然性"
    },
    {
      "ordinal": 36,
      "start_ms": 157559,
      "end_ms": 159900,
      "text": "歪曲扭曲"
    },
    {
      "ordinal": 37,
      "start_ms": 164019,
      "end_ms": 166619,
      "text": "民族国家啊"
    },
    {
      "ordinal": 38,
      "start_ms": 166619,
      "end_ms": 171650,
      "text": "它真正的代表性的来源啊"
    },
    {
      "ordinal": 39,
      "start_ms": 171650,
      "end_ms": 175230,
      "text": "或者说你可以详情见我前两个视频啊"
    },
    {
      "ordinal": 40,
      "start_ms": 175230,
      "end_ms": 179790,
      "text": "已经完全鼓吹一种纳粹同路人的历史观"
    },
    {
      "ordinal": 41,
      "start_ms": 179790,
      "end_ms": 181830,
      "text": "甚至就只是一种纳粹史官"
    },
    {
      "ordinal": 42,
      "start_ms": 181830,
      "end_ms": 183990,
      "text": "小自然阶级的纳粹史观"
    },
    {
      "ordinal": 43,
      "start_ms": 183990,
      "end_ms": 187250,
      "text": "的这样的一些自媒体从业人员"
    },
    {
      "ordinal": 44,
      "start_ms": 187250,
      "end_ms": 191260,
      "text": "我建议将其纳入啊"
    },
    {
      "ordinal": 45,
      "start_ms": 191660,
      "end_ms": 195020,
      "text": "你说不受欢迎人士公益的黑名单"
    },
    {
      "ordinal": 46,
      "start_ms": 197020,
      "end_ms": 198660,
      "text": "这是我的倡议啊"
    },
    {
      "ordinal": 47,
      "start_ms": 199519,
      "end_ms": 205460,
      "text": "竟然可以无耻到在互联网上公开吹捧一个"
    },
    {
      "ordinal": 48,
      "start_ms": 207160,
      "end_ms": 215279,
      "text": "公开吹捧一个啊和纳粹进行军事合作的啊"
    },
    {
      "ordinal": 49,
      "start_ms": 215279,
      "end_ms": 217019,
      "text": "一个曾经的沙俄军官"
    },
    {
      "ordinal": 50,
      "start_ms": 217019,
      "end_ms": 219559,
      "text": "白军头领啊"
    },
    {
      "ordinal": 51,
      "start_ms": 223260,
      "end_ms": 225920,
      "text": "公开吹捧叫曼纳海姆"
    },
    {
      "ordinal": 52,
      "start_ms": 225920,
      "end_ms": 228680,
      "text": "这个人为他洗地"
    },
    {
      "ordinal": 53,
      "start_ms": 230279,
      "end_ms": 235039,
      "text": "那么做出这一件事情的这个人的姓氏名谁"
    },
    {
      "ordinal": 54,
      "start_ms": 235039,
      "end_ms": 235519,
      "text": "我不知道"
    },
    {
      "ordinal": 55,
      "start_ms": 235519,
      "end_ms": 237420,
      "text": "但是他在b站的账号"
    },
    {
      "ordinal": 56,
      "start_ms": 238920,
      "end_ms": 240500,
      "text": "啊叫做历史"
    },
    {
      "ordinal": 57,
      "start_ms": 240500,
      "end_ms": 243860,
      "text": "什么历史调研室还是什么历史研究室还是什么"
    },
    {
      "ordinal": 58,
      "start_ms": 243860,
      "end_ms": 244700,
      "text": "我不记啊"
    },
    {
      "ordinal": 59,
      "start_ms": 244700,
      "end_ms": 247040,
      "text": "这些小人物的名字啊"
    },
    {
      "ordinal": 60,
      "start_ms": 247040,
      "end_ms": 247880,
      "text": "历史调研室"
    },
    {
      "ordinal": 61,
      "start_ms": 249020,
      "end_ms": 254059,
      "text": "那么这个个体呢我了解的是非常少的一个信息"
    },
    {
      "ordinal": 62,
      "start_ms": 254059,
      "end_ms": 257820,
      "text": "是他是在大学当中还在念本科"
    },
    {
      "ordinal": 63,
      "start_ms": 258939,
      "end_ms": 261160,
      "text": "那我的倡议就是说"
    },
    {
      "ordinal": 64,
      "start_ms": 261920,
      "end_ms": 266110,
      "text": "我们全国各地的公益团体和公益志愿者"
    },
    {
      "ordinal": 65,
      "start_ms": 266110,
      "end_ms": 268140,
      "text": "热心公益的志愿者"
    },
    {
      "ordinal": 66,
      "start_ms": 268800,
      "end_ms": 271760,
      "text": "不允许该人参加公益活动"
    },
    {
      "ordinal": 67,
      "start_ms": 271760,
      "end_ms": 272720,
      "text": "不欢迎他"
    },
    {
      "ordinal": 68,
      "start_ms": 272720,
      "end_ms": 275940,
      "text": "也不欢迎他的支持者参与公益活动"
    },
    {
      "ordinal": 69,
      "start_ms": 278579,
      "end_ms": 282790,
      "text": "明白吗啊然后但是我要说清楚"
    },
    {
      "ordinal": 70,
      "start_ms": 282790,
      "end_ms": 284710,
      "text": "就说我们不去人肉他"
    },
    {
      "ordinal": 71,
      "start_ms": 284710,
      "end_ms": 286750,
      "text": "你如果是在和他在同一个学校的"
    },
    {
      "ordinal": 72,
      "start_ms": 286750,
      "end_ms": 288370,
      "text": "大致知道他是哪个学校的"
    },
    {
      "ordinal": 73,
      "start_ms": 288370,
      "end_ms": 291540,
      "text": "我们也不去传播他的哪个学校不去传播的"
    },
    {
      "ordinal": 74,
      "start_ms": 291540,
      "end_ms": 294380,
      "text": "不影响他现实的利益啊"
    },
    {
      "ordinal": 75,
      "start_ms": 294380,
      "end_ms": 296060,
      "text": "我们也不给他现实的施压什么的"
    },
    {
      "ordinal": 76,
      "start_ms": 296060,
      "end_ms": 298000,
      "text": "我们只是说对于这样的人"
    },
    {
      "ordinal": 77,
      "start_ms": 298240,
      "end_ms": 300220,
      "text": "我们绝不和他合作"
    },
    {
      "ordinal": 78,
      "start_ms": 300220,
      "end_ms": 301570,
      "text": "就是这样的人"
    },
    {
      "ordinal": 79,
      "start_ms": 301570,
      "end_ms": 303970,
      "text": "我们绝不和他站在一起"
    },
    {
      "ordinal": 80,
      "start_ms": 303970,
      "end_ms": 305290,
      "text": "就是这样的人"
    },
    {
      "ordinal": 81,
      "start_ms": 305290,
      "end_ms": 309330,
      "text": "我们绝不容许他成为我们的一部分"
    },
    {
      "ordinal": 82,
      "start_ms": 312240,
      "end_ms": 313710,
      "text": "有公民的合法身份"
    },
    {
      "ordinal": 83,
      "start_ms": 313710,
      "end_ms": 317220,
      "text": "但是作为我们这些明确的现实的直接站出来的"
    },
    {
      "ordinal": 84,
      "start_ms": 317220,
      "end_ms": 318180,
      "text": "实名的"
    },
    {
      "ordinal": 85,
      "start_ms": 319830,
      "end_ms": 321520,
      "text": "我们不认同这个人"
    },
    {
      "ordinal": 86,
      "start_ms": 322900,
      "end_ms": 327120,
      "text": "他是不受欢迎的人士啊"
    },
    {
      "ordinal": 87,
      "start_ms": 327120,
      "end_ms": 327840,
      "text": "他在哪个学校"
    },
    {
      "ordinal": 88,
      "start_ms": 327840,
      "end_ms": 330240,
      "text": "如果在那个学校有公益小组的话"
    },
    {
      "ordinal": 89,
      "start_ms": 330240,
      "end_ms": 335430,
      "text": "公益团体的话就不允许他加入啊"
    },
    {
      "ordinal": 90,
      "start_ms": 335430,
      "end_ms": 336570,
      "text": "就不允许他加入"
    },
    {
      "ordinal": 91,
      "start_ms": 336570,
      "end_ms": 337680,
      "text": "他在哪个城市"
    },
    {
      "ordinal": 92,
      "start_ms": 337680,
      "end_ms": 339060,
      "text": "那么那个城市的公益小组"
    },
    {
      "ordinal": 93,
      "start_ms": 339060,
      "end_ms": 341340,
      "text": "公主团体就不允许他加入"
    },
    {
      "ordinal": 94,
      "start_ms": 341340,
      "end_ms": 343620,
      "text": "我们不愿意他加入"
    },
    {
      "ordinal": 95,
      "start_ms": 344360,
      "end_ms": 345130,
      "text": "了解吧"
    },
    {
      "ordinal": 96,
      "start_ms": 345130,
      "end_ms": 348099,
      "text": "一个鼓吹纳粹同路人"
    },
    {
      "ordinal": 97,
      "start_ms": 348099,
      "end_ms": 351519,
      "text": "鼓吹鼓吹这个纳粹史官的这么一个啊"
    },
    {
      "ordinal": 98,
      "start_ms": 351519,
      "end_ms": 353540,
      "text": "这么一个人啊"
    },
    {
      "ordinal": 99,
      "start_ms": 353960,
      "end_ms": 357000,
      "text": "了解吗啊"
    },
    {
      "ordinal": 100,
      "start_ms": 357000,
      "end_ms": 358860,
      "text": "这就是我的一个倡议"
    },
    {
      "ordinal": 101,
      "start_ms": 360719,
      "end_ms": 364379,
      "text": "你们不不是说百分百要执行我的倡议"
    },
    {
      "ordinal": 102,
      "start_ms": 364379,
      "end_ms": 364799,
      "text": "我的号召"
    },
    {
      "ordinal": 103,
      "start_ms": 364799,
      "end_ms": 366299,
      "text": "我们没有资格给你们下命令"
    },
    {
      "ordinal": 104,
      "start_ms": 366299,
      "end_ms": 370500,
      "text": "因为你们都是这个各地的自发的活动的"
    },
    {
      "ordinal": 105,
      "start_ms": 371139,
      "end_ms": 372779,
      "text": "我也不建议"
    },
    {
      "ordinal": 106,
      "start_ms": 372779,
      "end_ms": 375359,
      "text": "就是说由于我们这些人都是现实的"
    },
    {
      "ordinal": 107,
      "start_ms": 375359,
      "end_ms": 376680,
      "text": "在线下活动的"
    },
    {
      "ordinal": 108,
      "start_ms": 377020,
      "end_ms": 379960,
      "text": "所以在互联网上也没有必要跟他跑到"
    },
    {
      "ordinal": 109,
      "start_ms": 379960,
      "end_ms": 384380,
      "text": "他那种什么给举报他的视频啊啊去"
    },
    {
      "ordinal": 110,
      "start_ms": 385120,
      "end_ms": 387180,
      "text": "就是说不要去人肉他"
    },
    {
      "ordinal": 111,
      "start_ms": 387180,
      "end_ms": 390060,
      "text": "也不要跑到跑到他视频下面去举报啊"
    },
    {
      "ordinal": 112,
      "start_ms": 390060,
      "end_ms": 391200,
      "text": "去什么什么投诉啊"
    },
    {
      "ordinal": 113,
      "start_ms": 391200,
      "end_ms": 393100,
      "text": "这东西不做这种事情"
    },
    {
      "ordinal": 114,
      "start_ms": 393100,
      "end_ms": 395320,
      "text": "历史会给出正确的答案"
    },
    {
      "ordinal": 115,
      "start_ms": 395320,
      "end_ms": 396400,
      "text": "历史必然性"
    },
    {
      "ordinal": 116,
      "start_ms": 396400,
      "end_ms": 398040,
      "text": "或者说人民群众"
    },
    {
      "ordinal": 117,
      "start_ms": 402239,
      "end_ms": 404240,
      "text": "一定会给出一个正确的答案"
    },
    {
      "ordinal": 118,
      "start_ms": 405020,
      "end_ms": 407500,
      "text": "像这样的货色"
    },
    {
      "ordinal": 119,
      "start_ms": 409180,
      "end_ms": 411060,
      "text": "那就让它啊"
    },
    {
      "ordinal": 120,
      "start_ms": 411060,
      "end_ms": 413070,
      "text": "你确实走错了道路"
    },
    {
      "ordinal": 121,
      "start_ms": 413070,
      "end_ms": 415410,
      "text": "头脑当中产生了错误的想法"
    },
    {
      "ordinal": 122,
      "start_ms": 415410,
      "end_ms": 417240,
      "text": "当然我们希望他改正"
    },
    {
      "ordinal": 123,
      "start_ms": 417240,
      "end_ms": 418920,
      "text": "希望他痛改前非"
    },
    {
      "ordinal": 124,
      "start_ms": 419020,
      "end_ms": 421300,
      "text": "但是呢他尝到了甜头嘛"
    },
    {
      "ordinal": 125,
      "start_ms": 421300,
      "end_ms": 422980,
      "text": "我们不抱有希望啊"
    },
    {
      "ordinal": 126,
      "start_ms": 422980,
      "end_ms": 426040,
      "text": "我们不说对他抱有什么良好的希望什么"
    },
    {
      "ordinal": 127,
      "start_ms": 426040,
      "end_ms": 427030,
      "text": "我们不期待"
    },
    {
      "ordinal": 128,
      "start_ms": 427030,
      "end_ms": 428450,
      "text": "我根本不期待"
    },
    {
      "ordinal": 129,
      "start_ms": 428450,
      "end_ms": 431960,
      "text": "我们目前能做的就是说这个人这个体"
    },
    {
      "ordinal": 130,
      "start_ms": 431960,
      "end_ms": 433940,
      "text": "或者说公开支持"
    },
    {
      "ordinal": 131,
      "start_ms": 433940,
      "end_ms": 434840,
      "text": "公开鼓吹"
    },
    {
      "ordinal": 132,
      "start_ms": 434840,
      "end_ms": 436040,
      "text": "公开认为他做得对"
    },
    {
      "ordinal": 133,
      "start_ms": 436040,
      "end_ms": 438040,
      "text": "说得好的那些人"
    },
    {
      "ordinal": 134,
      "start_ms": 438440,
      "end_ms": 443000,
      "text": "我们不欢迎他们参与我们所倡导的"
    },
    {
      "ordinal": 135,
      "start_ms": 443000,
      "end_ms": 445400,
      "text": "我们所发起的公益活动"
    },
    {
      "ordinal": 136,
      "start_ms": 446300,
      "end_ms": 450259,
      "text": "我们不想它们污染啊"
    },
    {
      "ordinal": 137,
      "start_ms": 453559,
      "end_ms": 454039,
      "text": "一个资格"
    },
    {
      "ordinal": 138,
      "start_ms": 454039,
      "end_ms": 454960,
      "text": "一个身份"
    },
    {
      "ordinal": 139,
      "start_ms": 456259,
      "end_ms": 461980,
      "text": "这就是我们能做的现实的一种回应"
    },
    {
      "ordinal": 140,
      "start_ms": 461980,
      "end_ms": 467170,
      "text": "我们不做虚头巴脑的嘴巴上的"
    },
    {
      "ordinal": 141,
      "start_ms": 467170,
      "end_ms": 468700,
      "text": "我们做的是现实社会"
    },
    {
      "ordinal": 142,
      "start_ms": 468700,
      "end_ms": 471370,
      "text": "我没有想要降低他的社会评价"
    },
    {
      "ordinal": 143,
      "start_ms": 471370,
      "end_ms": 473260,
      "text": "他就是他做的事情"
    },
    {
      "ordinal": 144,
      "start_ms": 473380,
      "end_ms": 476440,
      "text": "然后我也没有说要让任何人去对他进行"
    },
    {
      "ordinal": 145,
      "start_ms": 476440,
      "end_ms": 477220,
      "text": "违法犯罪"
    },
    {
      "ordinal": 146,
      "start_ms": 477220,
      "end_ms": 479720,
      "text": "去了去人肉搜索他去怎么样"
    },
    {
      "ordinal": 147,
      "start_ms": 479720,
      "end_ms": 480920,
      "text": "不要去做这样的事情"
    },
    {
      "ordinal": 148,
      "start_ms": 480920,
      "end_ms": 482000,
      "text": "你做这样的事情的话"
    },
    {
      "ordinal": 149,
      "start_ms": 482000,
      "end_ms": 484600,
      "text": "你的法律和法律责任你自己去承担"
    },
    {
      "ordinal": 150,
      "start_ms": 484820,
      "end_ms": 486020,
      "text": "如果违法犯罪"
    },
    {
      "ordinal": 151,
      "start_ms": 486020,
      "end_ms": 487880,
      "text": "我从来就不要做违法犯罪"
    },
    {
      "ordinal": 152,
      "start_ms": 487880,
      "end_ms": 490430,
      "text": "但是如果说你知道啊"
    },
    {
      "ordinal": 153,
      "start_ms": 490430,
      "end_ms": 491660,
      "text": "他在那个学校里面"
    },
    {
      "ordinal": 154,
      "start_ms": 491660,
      "end_ms": 493160,
      "text": "他在他在那个寝室里面"
    },
    {
      "ordinal": 155,
      "start_ms": 493160,
      "end_ms": 495650,
      "text": "或者你这你也不要公开传播"
    },
    {
      "ordinal": 156,
      "start_ms": 495650,
      "end_ms": 498580,
      "text": "不要侵犯他的这个隐私"
    },
    {
      "ordinal": 157,
      "start_ms": 498599,
      "end_ms": 501729,
      "text": "也不要骚扰他的家人啊"
    },
    {
      "ordinal": 158,
      "start_ms": 501729,
      "end_ms": 503259,
      "text": "我一直是被很多人骚扰"
    },
    {
      "ordinal": 159,
      "start_ms": 503259,
      "end_ms": 504399,
      "text": "被很多人匿名举报"
    },
    {
      "ordinal": 160,
      "start_ms": 504399,
      "end_ms": 505179,
      "text": "被怎么样的"
    },
    {
      "ordinal": 161,
      "start_ms": 505179,
      "end_ms": 507360,
      "text": "我知道这个很痛苦啊"
    },
    {
      "ordinal": 162,
      "start_ms": 507360,
      "end_ms": 508650,
      "text": "但是我不怕啊"
    },
    {
      "ordinal": 163,
      "start_ms": 508650,
      "end_ms": 510210,
      "text": "因为我走的路是正确的"
    },
    {
      "ordinal": 164,
      "start_ms": 510210,
      "end_ms": 511240,
      "text": "是正路"
    },
    {
      "ordinal": 165,
      "start_ms": 511340,
      "end_ms": 514359,
      "text": "那么对于这个小孩儿这个学生"
    },
    {
      "ordinal": 166,
      "start_ms": 514600,
      "end_ms": 515919,
      "text": "他说这种话"
    },
    {
      "ordinal": 167,
      "start_ms": 515919,
      "end_ms": 518380,
      "text": "做出这样错误的这个立场的表态"
    },
    {
      "ordinal": 168,
      "start_ms": 518380,
      "end_ms": 519700,
      "text": "产生这样错误的影响"
    },
    {
      "ordinal": 169,
      "start_ms": 519700,
      "end_ms": 523890,
      "text": "糟糕的影响我们没有给他任何的惩罚"
    },
    {
      "ordinal": 170,
      "start_ms": 523890,
      "end_ms": 525870,
      "text": "我们只说和他划清界限"
    },
    {
      "ordinal": 171,
      "start_ms": 525870,
      "end_ms": 527130,
      "text": "不要让他加入"
    },
    {
      "ordinal": 172,
      "start_ms": 527130,
      "end_ms": 530930,
      "text": "不要让他的关注着支持他的支持者加入啊"
    },
    {
      "ordinal": 173,
      "start_ms": 530930,
      "end_ms": 531710,
      "text": "他关注的话"
    },
    {
      "ordinal": 174,
      "start_ms": 531710,
      "end_ms": 533090,
      "text": "你就了解一下"
    },
    {
      "ordinal": 175,
      "start_ms": 533090,
      "end_ms": 534230,
      "text": "并不代表支持他"
    },
    {
      "ordinal": 176,
      "start_ms": 534230,
      "end_ms": 537420,
      "text": "你说那个什么这个老易啊"
    },
    {
      "ordinal": 177,
      "start_ms": 537420,
      "end_ms": 539280,
      "text": "就我们我们圈子里面那个老易啊"
    },
    {
      "ordinal": 178,
      "start_ms": 539280,
      "end_ms": 542340,
      "text": "就是说那个路边老易还关注他呢啊"
    },
    {
      "ordinal": 179,
      "start_ms": 542340,
      "end_ms": 543420,
      "text": "只是关注而已"
    },
    {
      "ordinal": 180,
      "start_ms": 543420,
      "end_ms": 544819,
      "text": "并不代表支持"
    },
    {
      "ordinal": 181,
      "start_ms": 544880,
      "end_ms": 548180,
      "text": "但是他的支持者同样的啊"
    },
    {
      "ordinal": 182,
      "start_ms": 548180,
      "end_ms": 549980,
      "text": "希望不允许"
    },
    {
      "ordinal": 183,
      "start_ms": 549980,
      "end_ms": 555780,
      "text": "不要纳入这个公益活动的一个团体当中学啊"
    },
    {
      "ordinal": 184,
      "start_ms": 555780,
      "end_ms": 556620,
      "text": "这是我的倡议啊"
    },
    {
      "ordinal": 185,
      "start_ms": 556620,
      "end_ms": 558060,
      "text": "我的倡议我倡议就很简单"
    },
    {
      "ordinal": 186,
      "start_ms": 558060,
      "end_ms": 559500,
      "text": "我们的力量非常弱小"
    },
    {
      "ordinal": 187,
      "start_ms": 559500,
      "end_ms": 560520,
      "text": "我们很弱小"
    },
    {
      "ordinal": 188,
      "start_ms": 560520,
      "end_ms": 564380,
      "text": "我们顶多是你别别跑过来和我们一块玩"
    },
    {
      "ordinal": 189,
      "start_ms": 564680,
      "end_ms": 568070,
      "text": "当然绝大部分这个人和这个人的受众"
    },
    {
      "ordinal": 190,
      "start_ms": 568070,
      "end_ms": 569690,
      "text": "都是行动的矮子"
    },
    {
      "ordinal": 191,
      "start_ms": 569690,
      "end_ms": 572450,
      "text": "那嘴巴上口嗨的都是行动的矮子"
    },
    {
      "ordinal": 192,
      "start_ms": 572450,
      "end_ms": 574180,
      "text": "都是毫无行动力的人"
    },
    {
      "ordinal": 193,
      "start_ms": 574200,
      "end_ms": 577230,
      "text": "那我我还是有必要要这样说的啊"
    },
    {
      "ordinal": 194,
      "start_ms": 577230,
      "end_ms": 580140,
      "text": "就说这个人是一个在公益事业当中"
    },
    {
      "ordinal": 195,
      "start_ms": 580140,
      "end_ms": 581970,
      "text": "他是个不受欢迎的人啊"
    },
    {
      "ordinal": 196,
      "start_ms": 581970,
      "end_ms": 583110,
      "text": "他是个不受欢迎的人"
    },
    {
      "ordinal": 197,
      "start_ms": 583110,
      "end_ms": 584170,
      "text": "我们不欢迎他"
    },
    {
      "ordinal": 198,
      "start_ms": 584170,
      "end_ms": 585850,
      "text": "我们不欢迎他啊"
    },
    {
      "ordinal": 199,
      "start_ms": 585850,
      "end_ms": 588910,
      "text": "参加目前啊就他的这些立场表态"
    },
    {
      "ordinal": 200,
      "start_ms": 588910,
      "end_ms": 592080,
      "text": "他所造成的这个啊这些话语的影响"
    },
    {
      "ordinal": 201,
      "start_ms": 592080,
      "end_ms": 593070,
      "text": "不怀疑他"
    },
    {
      "ordinal": 202,
      "start_ms": 593070,
      "end_ms": 594480,
      "text": "那这是我的倡议啊"
    },
    {
      "ordinal": 203,
      "start_ms": 594480,
      "end_ms": 596380,
      "text": "这是我的倡议不"
    },
    {
      "ordinal": 204,
      "start_ms": 596380,
      "end_ms": 597520,
      "text": "你们不一定要执行"
    },
    {
      "ordinal": 205,
      "start_ms": 597520,
      "end_ms": 600160,
      "text": "那么各地的这个公益团体的公益志愿者"
    },
    {
      "ordinal": 206,
      "start_ms": 600160,
      "end_ms": 604490,
      "text": "你们有自己的完全的自主的权利去决定啊"
    },
    {
      "ordinal": 207,
      "start_ms": 604490,
      "end_ms": 607040,
      "text": "自主权利去决定好吧"
    },
    {
      "ordinal": 208,
      "start_ms": 607040,
      "end_ms": 611500,
      "text": "那么这个这个月啊"
    },
    {
      "ordinal": 209,
      "start_ms": 611500,
      "end_ms": 612640,
      "text": "5月30号之前"
    },
    {
      "ordinal": 210,
      "start_ms": 612640,
      "end_ms": 616620,
      "text": "你们啊还希望大家可以就是说用心一点啊"
    },
    {
      "ordinal": 211,
      "start_ms": 616620,
      "end_ms": 618000,
      "text": "用心一点啊"
    },
    {
      "ordinal": 212,
      "start_ms": 618000,
      "end_ms": 621199,
      "text": "去把这个我们公益活动的这个设计"
    },
    {
      "ordinal": 213,
      "start_ms": 621260,
      "end_ms": 624620,
      "text": "就是这个一些外观"
    },
    {
      "ordinal": 214,
      "start_ms": 624620,
      "end_ms": 626540,
      "text": "让审美上面的一些设计大赛啊"
    },
    {
      "ordinal": 215,
      "start_ms": 626540,
      "end_ms": 629599,
      "text": "你们自己好好的去研究一下啊"
    },
    {
      "ordinal": 216,
      "start_ms": 629640,
      "end_ms": 631710,
      "text": "多观察观察现实啊"
    },
    {
      "ordinal": 217,
      "start_ms": 631710,
      "end_ms": 633170,
      "text": "大胆的去创造"
    },
    {
      "ordinal": 218,
      "start_ms": 633170,
      "end_ms": 635810,
      "text": "不要不要跟我们要那个美工啊"
    },
    {
      "ordinal": 219,
      "start_ms": 635810,
      "end_ms": 637730,
      "text": "我们美术组里面没几个人"
    },
    {
      "ordinal": 220,
      "start_ms": 637730,
      "end_ms": 639270,
      "text": "你们自己有能力的"
    },
    {
      "ordinal": 221,
      "start_ms": 639270,
      "end_ms": 640830,
      "text": "自己要发挥这个创造力"
    },
    {
      "ordinal": 222,
      "start_ms": 640830,
      "end_ms": 642210,
      "text": "想象力应该还有十几天"
    },
    {
      "ordinal": 223,
      "start_ms": 642210,
      "end_ms": 642690,
      "text": "20天的"
    },
    {
      "ordinal": 224,
      "start_ms": 642690,
      "end_ms": 646110,
      "text": "你们自己哪怕是对不对啊"
    },
    {
      "ordinal": 225,
      "start_ms": 646110,
      "end_ms": 647910,
      "text": "我这顺便说一嘴啊"
    },
    {
      "ordinal": 226,
      "start_ms": 647910,
      "end_ms": 649830,
      "text": "你自己哪怕是半路出家的"
    },
    {
      "ordinal": 227,
      "start_ms": 649830,
      "end_ms": 651990,
      "text": "现在学现在练也也能做成"
    },
    {
      "ordinal": 228,
      "start_ms": 651990,
      "end_ms": 653130,
      "text": "而且现在有人工智能"
    },
    {
      "ordinal": 229,
      "start_ms": 653130,
      "end_ms": 654490,
      "text": "有那种自动生成的"
    },
    {
      "ordinal": 230,
      "start_ms": 654490,
      "end_ms": 655990,
      "text": "到底这个logo怎么设计啊"
    },
    {
      "ordinal": 231,
      "start_ms": 655990,
      "end_ms": 657190,
      "text": "到底这个服装怎么设计啊"
    },
    {
      "ordinal": 232,
      "start_ms": 657190,
      "end_ms": 659650,
      "text": "你自己可以去想办法"
    },
    {
      "ordinal": 233,
      "start_ms": 660760,
      "end_ms": 666890,
      "text": "那么目前呢就是啊这个小站阶级这些青年啊"
    },
    {
      "ordinal": 234,
      "start_ms": 666890,
      "end_ms": 667520,
      "text": "很明确"
    },
    {
      "ordinal": 235,
      "start_ms": 667520,
      "end_ms": 668420,
      "text": "他有他的"
    },
    {
      "ordinal": 236,
      "start_ms": 668420,
      "end_ms": 670130,
      "text": "他们有他的认同"
    },
    {
      "ordinal": 237,
      "start_ms": 670130,
      "end_ms": 671240,
      "text": "他们有他的认识"
    },
    {
      "ordinal": 238,
      "start_ms": 671240,
      "end_ms": 673560,
      "text": "有错误的史观价值观啊"
    },
    {
      "ordinal": 239,
      "start_ms": 673560,
      "end_ms": 675120,
      "text": "那我们要说他的始作俑者"
    },
    {
      "ordinal": 240,
      "start_ms": 675120,
      "end_ms": 676140,
      "text": "他的炮制者"
    },
    {
      "ordinal": 241,
      "start_ms": 676140,
      "end_ms": 678240,
      "text": "我们要非常直截了当"
    },
    {
      "ordinal": 242,
      "start_ms": 678240,
      "end_ms": 680850,
      "text": "地纳入不受欢迎的一个名录"
    },
    {
      "ordinal": 243,
      "start_ms": 680850,
      "end_ms": 682200,
      "text": "但是我不知道他是谁啊"
    },
    {
      "ordinal": 244,
      "start_ms": 682200,
      "end_ms": 683100,
      "text": "我不知道他是谁"
    },
    {
      "ordinal": 245,
      "start_ms": 683100,
      "end_ms": 684910,
      "text": "我们不知道他姓甚名谁"
    },
    {
      "ordinal": 246,
      "start_ms": 684910,
      "end_ms": 686770,
      "text": "我们也不是降低它社会评价"
    },
    {
      "ordinal": 247,
      "start_ms": 686770,
      "end_ms": 688390,
      "text": "我们就不不想和他玩儿"
    },
    {
      "ordinal": 248,
      "start_ms": 688390,
      "end_ms": 690680,
      "text": "仅此而已啊"
    },
    {
      "ordinal": 249,
      "start_ms": 690680,
      "end_ms": 691580,
      "text": "他说的那些话"
    },
    {
      "ordinal": 250,
      "start_ms": 691580,
      "end_ms": 692850,
      "text": "他做的这种事"
    },
    {
      "ordinal": 251,
      "start_ms": 692850,
      "end_ms": 695310,
      "text": "这种人我们不想和他玩啊"
    },
    {
      "ordinal": 252,
      "start_ms": 695310,
      "end_ms": 696810,
      "text": "我们不在他啊"
    },
    {
      "ordinal": 253,
      "start_ms": 696810,
      "end_ms": 698490,
      "text": "我们也不做其他的事情"
    },
    {
      "ordinal": 254,
      "start_ms": 698490,
      "end_ms": 698970,
      "text": "叫人肉"
    },
    {
      "ordinal": 255,
      "start_ms": 698970,
      "end_ms": 699870,
      "text": "他他叫姓之名"
    },
    {
      "ordinal": 256,
      "start_ms": 699870,
      "end_ms": 700710,
      "text": "谁家住哪里"
    },
    {
      "ordinal": 257,
      "start_ms": 700710,
      "end_ms": 701310,
      "text": "我们不做"
    },
    {
      "ordinal": 258,
      "start_ms": 701310,
      "end_ms": 702319,
      "text": "绝对不做"
    },
    {
      "ordinal": 259,
      "start_ms": 702560,
      "end_ms": 704720,
      "text": "这不是说我就是反过来"
    },
    {
      "ordinal": 260,
      "start_ms": 704720,
      "end_ms": 706750,
      "text": "你不能说我这正话反说"
    },
    {
      "ordinal": 261,
      "start_ms": 706750,
      "end_ms": 709870,
      "text": "这个说到时候什么说公安机关举报"
    },
    {
      "ordinal": 262,
      "start_ms": 709870,
      "end_ms": 711130,
      "text": "我说我要人肉他"
    },
    {
      "ordinal": 263,
      "start_ms": 711130,
      "end_ms": 712730,
      "text": "我没有这样说啊"
    },
    {
      "ordinal": 264,
      "start_ms": 712730,
      "end_ms": 713630,
      "text": "我们不做这种事情"
    },
    {
      "ordinal": 265,
      "start_ms": 713630,
      "end_ms": 714800,
      "text": "这种事情没意义"
    },
    {
      "ordinal": 266,
      "start_ms": 715060,
      "end_ms": 716380,
      "text": "我们是现实的"
    },
    {
      "ordinal": 267,
      "start_ms": 716380,
      "end_ms": 719800,
      "text": "我们是在现实的生活当中去和人民群众"
