    {
      "ordinal": 115,
      "start_ms": 338880,
      "end_ms": 340380,
      "text": "得不到的是鱼爷的亚一样"
    },
    {
      "ordinal": 116,
      "start_ms": 340380,
      "end_ms": 343320,
      "text": "或者说是我不追求他"
