    {
      "ordinal": 117,
      "start_ms": 343320,
      "end_ms": 345570,
      "text": "我只是和他产生共情"
    },
    {
      "ordinal": 118,
      "start_ms": 345570,
      "end_ms": 348180,
      "text": "共同的怜悯你自己"
    },
    {
      "ordinal": 119,
      "start_ms": 348180,
      "end_ms": 350280,
      "text": "或者说就是可怜自己"
