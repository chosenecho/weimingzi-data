  "content_sha256": "4cd7a3034d94fbfdfc417c826c87b28e1deca00caaae00d29a2fb749078e555b",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 11520,
      "end_ms": 15360,
      "text": "欲翩跹，此秋雁归南天。"
    },
    {
      "ordinal": 1,
      "start_ms": 17600,
      "end_ms": 22400,
      "text": "已不见，满春花似云烟。"
    },
    {
      "ordinal": 2,
      "start_ms": 24080,
      "end_ms": 34880,
      "text": "与秋月诉不尽千载的沉默，水云间倾泻心的无眠。"
    },
    {
      "ordinal": 3,
      "start_ms": 36480,
      "end_ms": 44480,
      "text": "时再见，今人枯朽。"
    },
    {
      "ordinal": 4,
      "start_ms": 46800,
      "end_ms": 50960,
      "text": "来去风是无痕的冷却，"
    },
    {
      "ordinal": 5,
      "start_ms": 53200,
      "end_ms": 58240,
      "text": "水与心是同光的曲折。"
    },
    {
      "ordinal": 6,
      "start_ms": 59760,
      "end_ms": 65840,
      "text": "一孤舟，安纳这半生的如果。"
    },
    {
      "ordinal": 7,
      "start_ms": 66240,
      "end_ms": 72000,
      "text": "玉林仙，又笑将心斟酌。"
    },
    {
      "ordinal": 8,
      "start_ms": 76800,
      "end_ms": 85120,
      "text": "在倏然间，这份宁静若加一段语言。"
    },
    {
      "ordinal": 9,
      "start_ms": 87280,
      "end_ms": 91520,
      "text": "暗说秋天不过是故作镇"
    },
    {
      "ordinal": 10,
      "start_ms": 92560,
      "end_ms": 100480,
      "text": "静的匆忙，是纸与笔的衰亡。"
    },
    {
      "ordinal": 11,
      "start_ms": 108320,
      "end_ms": 112560,
      "text": "自在风华装饰了雨朵，"
    },
    {
      "ordinal": 12,
      "start_ms": 114880,
      "end_ms": 119200,
      "text": "纵容波纹涂鸦了时空。"
    },
    {
      "ordinal": 13,
      "start_ms": 121440,
      "end_ms": 125600,
      "text": "欲翩跹，命似西汉如愿。"
    },
    {
      "ordinal": 14,
      "start_ms": 127920,
      "end_ms": 132160,
      "text": "已不见，归路豁然如烟。"
    },
    {
      "ordinal": 15,
      "start_ms": 134400,
      "end_ms": 145360,
      "text": "与秋月临别这沿途的灯火，水云间乱方寸的愁眠。"
    },
    {
      "ordinal": 16,
      "start_ms": 148080,
      "end_ms": 158160,
      "text": "时日偏自减，去永不能还原。"
    },
    {
      "ordinal": 17,
      "start_ms": 161040,
      "end_ms": 170880,
      "text": "今人芳华枯朽，死的春又来。"
    },
    {
      "ordinal": 18,
      "start_ms": 174080,
      "end_ms": 179040,
      "text": "吞没一颗石子。"
    },
    {
      "ordinal": 19,
      "start_ms": 180510,
      "end_ms": 190510,
      "text": "予忧郁的心，予翩跹，此秋雁归丹田。"
    },
    {
      "ordinal": 20,
      "start_ms": 192750,
      "end_ms": 197630,
      "text": "已不见，满城花似云烟。"
    },
    {
      "ordinal": 21,
      "start_ms": 199230,
      "end_ms": 210110,
      "text": "予秋月诉不尽千载的沉默，水云间是一平人间。"
    },
    {
      "ordinal": 22,
      "start_ms": 212190,
      "end_ms": 216270,
      "text": "来去风是无痕的冷却，"
    },
    {
      "ordinal": 23,
      "start_ms": 218590,
      "end_ms": 223710,
      "text": "水与心是同光的曲折。"
    },
    {
      "ordinal": 24,
      "start_ms": 225150,
      "end_ms": 237630,
      "text": "一孤舟，这暗箭难明的疏阔，欲领先谋一幅苍凉。"
    },
    {
      "ordinal": 25,
      "start_ms": 239790,
      "end_ms": 245470,
      "text": "予无言处观秋"
    },
    {
      "ordinal": 26,
      "start_ms": 246990,
      "end_ms": 265390,
      "text": "枝来去，看此方世界来去秋雨息。"
    }
  ],
  "text": "欲翩跹，此秋雁归南天。\n已不见，满春花似云烟。\n与秋月诉不尽千载的沉默，水云间倾泻心的无眠。\n时再见，今人枯朽。\n来去风是无痕的冷却，\n水与心是同光的曲折。\n一孤舟，安纳这半生的如果。\n玉林仙，又笑将心斟酌。\n在倏然间，这份宁静若加一段语言。\n暗说秋天不过是故作镇\n静的匆忙，是纸与笔的衰亡。\n自在风华装饰了雨朵，\n纵容波纹涂鸦了时空。\n欲翩跹，命似西汉如愿。\n已不见，归路豁然如烟。\n与秋月临别这沿途的灯火，水云间乱方寸的愁眠。\n时日偏自减，去永不能还原。\n今人芳华枯朽，死的春又来。\n吞没一颗石子。\n予忧郁的心，予翩跹，此秋雁归丹田。\n已不见，满城花似云烟。\n予秋月诉不尽千载的沉默，水云间是一平人间。\n来去风是无痕的冷却，\n水与心是同光的曲折。\n一孤舟，这暗箭难明的疏阔，欲领先谋一幅苍凉。\n予无言处观秋\n枝来去，看此方世界来去秋雨息。",
