  "content_sha256": "9830111156a7f80005185c92f0a0a195de1049a0bc2dd75159eae2f9c0fcdeb4",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 11240,
      "end_ms": 16780,
      "text": "♪ 羽翩跹似秋燕归南天 ♪"
    },
    {
      "ordinal": 1,
      "start_ms": 17360,
      "end_ms": 22920,
      "text": "♪ 已不见满春花似云烟 ♪"
    },
    {
      "ordinal": 2,
      "start_ms": 23839,
      "end_ms": 30380,
      "text": "♪ 语秋月诉不尽千载的沉默 ♪"
    },
    {
      "ordinal": 3,
      "start_ms": 30380,
      "end_ms": 37560,
      "text": "♪ 水云间倾斜行的无眠时日 ♪"
    },
    {
      "ordinal": 4,
      "start_ms": 37560,
      "end_ms": 45620,
      "text": "♪ 再剪尽人苦笑 ♪"
    },
    {
      "ordinal": 5,
      "start_ms": 46560,
      "end_ms": 52460,
      "text": "♪ 来曲风是无痕的冷却 ♪"
    },
    {
      "ordinal": 6,
      "start_ms": 53020,
      "end_ms": 58860,
      "text": "♪ 水星是同光的曲折 ♪"
    },
    {
      "ordinal": 7,
      "start_ms": 59500,
      "end_ms": 64360,
      "text": "♪ 倚孤舟安娜这半生的 ♪"
    },
    {
      "ordinal": 8,
      "start_ms": 64360,
      "end_ms": 68940,
      "text": "♪ 如果羽鳞仙有效 ♪"
    },
    {
      "ordinal": 9,
      "start_ms": 68940,
      "end_ms": 71940,
      "text": "♪ 将星辰捉 ♪"
    },
    {
      "ordinal": 10,
      "start_ms": 76540,
      "end_ms": 86420,
      "text": "在倏然间这份宁静若加一段语言"
    },
    {
      "ordinal": 11,
      "start_ms": 87040,
      "end_ms": 92020,
      "text": "按说秋天不过是故作镇"
    },
    {
      "ordinal": 12,
      "start_ms": 92020,
      "end_ms": 101960,
      "text": "曾经的匆忙是指育碧的衰亡"
    },
    {
      "ordinal": 13,
      "start_ms": 108120,
      "end_ms": 115620,
      "text": "自在风华装饰了一朵纵容"
    },
    {
      "ordinal": 14,
      "start_ms": 115620,
      "end_ms": 122910,
      "text": "♪ 不问涂鸦了时空羽翩跹 ♪"
    },
    {
      "ordinal": 15,
      "start_ms": 122910,
      "end_ms": 126860,
      "text": "♪ 名词喜欢如愿 ♪"
    },
    {
      "ordinal": 16,
      "start_ms": 127620,
      "end_ms": 130580,
      "text": "♪ 已不见归路 ♪"
    },
    {
      "ordinal": 17,
      "start_ms": 130580,
      "end_ms": 132980,
      "text": "♪ 豁然如烟 ♪"
    },
    {
      "ordinal": 18,
      "start_ms": 134100,
      "end_ms": 142540,
      "text": "♪ 语秋月临别着沿途的灯火水云间 ♪"
    },
    {
      "ordinal": 19,
      "start_ms": 142540,
      "end_ms": 146560,
      "text": "♪ 乱方寸的愁眠 ♪"
    },
    {
      "ordinal": 20,
      "start_ms": 147900,
      "end_ms": 148460,
      "text": "♪ 是 ♪"
    },
    {
      "ordinal": 21,
      "start_ms": 150560,
      "end_ms": 159520,
      "text": "♪ 骗子前去游总不能还原 ♪"
    },
    {
      "ordinal": 22,
      "start_ms": 160820,
      "end_ms": 167360,
      "text": "♪ 惊人芳华不朽 ♪"
    },
    {
      "ordinal": 23,
      "start_ms": 167360,
      "end_ms": 172520,
      "text": "♪ 死得春又来 ♪"
    },
    {
      "ordinal": 24,
      "start_ms": 173800,
      "end_ms": 178480,
      "text": "♪ 吞我一颗石 ♪"
    },
    {
      "ordinal": 25,
      "start_ms": 178480,
      "end_ms": 187760,
      "text": "♪ 日子与忧郁的心羽翩跹 ♪"
    },
    {
      "ordinal": 26,
      "start_ms": 187760,
      "end_ms": 190460,
      "text": "♪ 似秋燕归丹田 ♪"
    },
    {
      "ordinal": 27,
      "start_ms": 192680,
      "end_ms": 198380,
      "text": "♪ 已不见满城花似云烟 ♪"
    },
    {
      "ordinal": 28,
      "start_ms": 199000,
      "end_ms": 205360,
      "text": "♪ 语秋月诉不尽千载的沉默 ♪"
    },
    {
      "ordinal": 29,
      "start_ms": 205360,
      "end_ms": 211380,
      "text": "♪ 水云间是一品人间 ♪"
    },
    {
      "ordinal": 30,
      "start_ms": 211960,
      "end_ms": 217500,
      "text": "♪ 来曲风是无痕的冷却 ♪"
    },
    {
      "ordinal": 31,
      "start_ms": 218400,
      "end_ms": 224360,
      "text": "♪ 水与心是同光的曲折 ♪"
    },
    {
      "ordinal": 32,
      "start_ms": 224900,
      "end_ms": 226690,
      "text": "♪ 倚孤舟 ♪"
    },
    {
      "ordinal": 33,
      "start_ms": 226690,
      "end_ms": 231360,
      "text": "♪ 这罕见那明的曙光 ♪"
    },
    {
      "ordinal": 34,
      "start_ms": 231360,
      "end_ms": 233190,
      "text": "♪ 羽鳞仙 ♪"
    },
    {
      "ordinal": 35,
      "start_ms": 233190,
      "end_ms": 236040,
      "text": "♪ 某一幅残留 ♪"
    },
    {
      "ordinal": 36,
      "start_ms": 239640,
      "end_ms": 251900,
      "text": "♪ 与不远处观秋之来去 ♪"
    },
    {
      "ordinal": 37,
      "start_ms": 252540,
      "end_ms": 264499,
      "text": "♪ 看此方世界来去秋雨 ♪"
    }
  ],
  "text": "♪ 羽翩跹似秋燕归南天 ♪\n♪ 已不见满春花似云烟 ♪\n♪ 语秋月诉不尽千载的沉默 ♪\n♪ 水云间倾斜行的无眠时日 ♪\n♪ 再剪尽人苦笑 ♪\n♪ 来曲风是无痕的冷却 ♪\n♪ 水星是同光的曲折 ♪\n♪ 倚孤舟安娜这半生的 ♪\n♪ 如果羽鳞仙有效 ♪\n♪ 将星辰捉 ♪\n在倏然间这份宁静若加一段语言\n按说秋天不过是故作镇\n曾经的匆忙是指育碧的衰亡\n自在风华装饰了一朵纵容\n♪ 不问涂鸦了时空羽翩跹 ♪\n♪ 名词喜欢如愿 ♪\n♪ 已不见归路 ♪\n♪ 豁然如烟 ♪\n♪ 语秋月临别着沿途的灯火水云间 ♪\n♪ 乱方寸的愁眠 ♪\n♪ 是 ♪\n♪ 骗子前去游总不能还原 ♪\n♪ 惊人芳华不朽 ♪\n♪ 死得春又来 ♪\n♪ 吞我一颗石 ♪\n♪ 日子与忧郁的心羽翩跹 ♪\n♪ 似秋燕归丹田 ♪\n♪ 已不见满城花似云烟 ♪\n♪ 语秋月诉不尽千载的沉默 ♪\n♪ 水云间是一品人间 ♪\n♪ 来曲风是无痕的冷却 ♪\n♪ 水与心是同光的曲折 ♪\n♪ 倚孤舟 ♪\n♪ 这罕见那明的曙光 ♪\n♪ 羽鳞仙 ♪\n♪ 某一幅残留 ♪\n♪ 与不远处观秋之来去 ♪\n♪ 看此方世界来去秋雨 ♪",
