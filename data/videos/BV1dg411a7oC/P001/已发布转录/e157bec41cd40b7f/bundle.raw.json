{"segments":[{"start":0.6,"end":2.82,"text":"我们做一个简短的例行的批判"},{"start":8.138,"end":9.659,"text":"当然他的他的伴侣"},{"start":9.659,"end":12.239,"text":"他的妻子也是个臭名昭的自然级人物"},{"start":13.439,"end":15.84,"text":"他们说什么人生总有风雨"},{"start":17.199,"end":20.279,"text":"那个时间总要向前"},{"start":20.279,"end":21.88,"text":"这两句话都是错的"},{"start":21.88,"end":23.53,"text":"不是人生有风雨"},{"start":23.53,"end":26.95,"text":"而是风雨就是历史的不稳定的变动"},{"start":26.95,"end":29.44,"text":"它产生了人生风雨"},{"start":29.44,"end":30.31,"text":"总有人生"},{"start":33.519,"end":36.819,"text":"把人生看成是一个安宁安稳的一个持续状态"},{"start":36.819,"end":37.479,"text":"稳定状态"},{"start":37.479,"end":39.59,"text":"然后它会有扰动波动"},{"start":39.59,"end":41.69,"text":"但实际上对于辩证唯物主义者"},{"start":41.69,"end":43.17,"text":"对于我们来说"},{"start":44.91,"end":46.83,"text":"不是是反过来是风雨"},{"start":46.83,"end":49.559,"text":"有人生不稳定不安宁"},{"start":49.84,"end":52.57,"text":"这种这种斗争冲突状态"},{"start":52.57,"end":53.98,"text":"它是首要的"},{"start":54.24,"end":57.09,"text":"它生产出来一个人生"},{"start":57.09,"end":58.92,"text":"人生就是两方面"},{"start":58.92,"end":62.12,"text":"一方面内在性内在自我中介体验过程"},{"start":62.12,"end":63.92,"text":"剧烈的物质运动"},{"start":67.64,"end":72.19,"text":"它产生出精神这种内在中介的啊自我意识"},{"start":72.19,"end":73.81,"text":"人还有一个人生"},{"start":73.81,"end":75.85,"text":"它是生活在人间的"},{"start":75.85,"end":78.56,"text":"它产生出这个共同体"},{"start":78.56,"end":80.47,"text":"相互之间的一种关联"},{"start":80.47,"end":82.48,"text":"人与人之间的一种冲突纠葛"},{"start":82.48,"end":85.27,"text":"他把那个宇宙物质位面"},{"start":85.27,"end":86.08,"text":"不同位面"},{"start":86.08,"end":88.56,"text":"不同位面的物质性力量的冲突"},{"start":88.56,"end":90.45,"text":"经由内在性的中介"},{"start":90.45,"end":93.44,"text":"他有个内在的一个自我意识的人"},{"start":93.44,"end":96.94,"text":"它然后它变成人与人之间冲突"},{"start":96.94,"end":98.2,"text":"变成社会冲突"},{"start":98.2,"end":102.79,"text":"社会冲突是宇宙冲突的一个一个转化"},{"start":102.79,"end":105.6,"text":"一个一个再呈现的啊"},{"start":105.6,"end":110.16,"text":"社会冲突是这么一种宇宙冲突的一种呈现方式"},{"start":110.16,"end":112.38,"text":"或者说是一个进一步的实现"},{"start":112.38,"end":114.24,"text":"进一步的一个运转的一