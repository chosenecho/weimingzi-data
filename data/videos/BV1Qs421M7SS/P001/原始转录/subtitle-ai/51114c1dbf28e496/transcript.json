{
  "bvid": "BV1Qs421M7SS",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "51114c1dbf28e4961086ce1c7b7f734292ff9b5e8df31433513fee749dab1939",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 700,
      "end_ms": 6029,
      "text": "我们要讲的就是说今年啊毕业了嗯"
    },
    {
      "ordinal": 1,
      "start_ms": 6029,
      "end_ms": 9309,
      "text": "呃无产阶级化去厂里面打工"
    },
    {
      "ordinal": 2,
      "start_ms": 14420,
      "end_ms": 15540,
      "text": "送外卖啊"
    },
    {
      "ordinal": 3,
      "start_ms": 15540,
      "end_ms": 16900,
      "text": "送快递啊"
    },
    {
      "ordinal": 4,
      "start_ms": 16900,
      "end_ms": 19360,
      "text": "做日结啊"
    },
    {
      "ordinal": 5,
      "start_ms": 20260,
      "end_ms": 23500,
      "text": "不要盲目的参加激进团体"
    },
    {
      "ordinal": 6,
      "start_ms": 23500,
      "end_ms": 25220,
      "text": "也不要被他们煽动起来"
    },
    {
      "ordinal": 7,
      "start_ms": 25220,
      "end_ms": 27460,
      "text": "去搞什么荣工什么的"
    },
    {
      "ordinal": 8,
      "start_ms": 29160,
      "end_ms": 33280,
      "text": "你们第一步要做好的很简单"
    },
    {
      "ordinal": 9,
      "start_ms": 34630,
      "end_ms": 35750,
      "text": "恪守四点"
    },
    {
      "ordinal": 10,
      "start_ms": 37310,
      "end_ms": 41230,
      "text": "恪守四点就是戒烟"
    },
    {
      "ordinal": 11,
      "start_ms": 42560,
      "end_ms": 46440,
      "text": "戒酒戒嫖戒赌"
    },
    {
      "ordinal": 12,
      "start_ms": 47250,
      "end_ms": 51930,
      "text": "然后呢我们讲的简单一点啊"
    },
    {
      "ordinal": 13,
      "start_ms": 53230,
      "end_ms": 53950,
      "text": "戒了烟"
    },
    {
      "ordinal": 14,
      "start_ms": 55950,
      "end_ms": 57170,
      "text": "为什么会抽烟"
    },
    {
      "ordinal": 15,
      "start_ms": 57170,
      "end_ms": 59310,
      "text": "嘴巴有瘾啊"
    },
    {
      "ordinal": 16,
      "start_ms": 59950,
      "end_ms": 60990,
      "text": "身体难受啊"
    },
    {
      "ordinal": 17,
      "start_ms": 62270,
      "end_ms": 65330,
      "text": "那么要用个东西来替代他"
    },
    {
      "ordinal": 18,
      "start_ms": 65330,
      "end_ms": 70150,
      "text": "抽烟的问题就在于抽烟花钱"
    },
    {
      "ordinal": 19,
      "start_ms": 70150,
      "end_ms": 73710,
      "text": "抽烟也会损害你的健康啊"
    },
    {
      "ordinal": 20,
      "start_ms": 73710,
      "end_ms": 74930,
      "text": "抽烟也是"
    },
    {
      "ordinal": 21,
      "start_ms": 74930,
      "end_ms": 79680,
      "text": "当然这这里面这个程度轻重啊"
    },
    {
      "ordinal": 22,
      "start_ms": 80160,
      "end_ms": 81440,
      "text": "烟是最轻的"
    },
    {
      "ordinal": 23,
      "start_ms": 82440,
      "end_ms": 84320,
      "text": "那酒其次嫖"
    },
    {
      "ordinal": 24,
      "start_ms": 84320,
      "end_ms": 88009,
      "text": "第三堵是最重的危害程度"
    },
    {
      "ordinal": 25,
      "start_ms": 88009,
      "end_ms": 91220,
      "text": "烟酒嫖赌啊"
    },
    {
      "ordinal": 26,
      "start_ms": 91220,
      "end_ms": 93320,
      "text": "烟的程度是最低的"
    },
    {
      "ordinal": 27,
      "start_ms": 93320,
      "end_ms": 95860,
      "text": "但是说还是要戒烟戒烟"
    },
    {
      "ordinal": 28,
      "start_ms": 95860,
      "end_ms": 96860,
      "text": "省下的钱"
    },
    {
      "ordinal": 29,
      "start_ms": 96860,
      "end_ms": 99450,
      "text": "或者说戒烟休息的时间"
    },
    {
      "ordinal": 30,
      "start_ms": 101400,
      "end_ms": 107810,
      "text": "我们建议把你的烟钱换成一些饮料"
    },
    {
      "ordinal": 31,
      "start_ms": 108170,
      "end_ms": 110530,
      "text": "小零食啊"
    },
    {
      "ordinal": 32,
      "start_ms": 110530,
      "end_ms": 111170,
      "text": "换成这种"
    },
    {
      "ordinal": 33,
      "start_ms": 111170,
      "end_ms": 112930,
      "text": "换成换成口香糖"
    },
    {
      "ordinal": 34,
      "start_ms": 113330,
      "end_ms": 118970,
      "text": "然后呢和你的工友分享这些小零食啊"
    },
    {
      "ordinal": 35,
      "start_ms": 118970,
      "end_ms": 119570,
      "text": "口香糖啊"
    },
    {
      "ordinal": 36,
      "start_ms": 119570,
      "end_ms": 122510,
      "text": "或者说喝的水啊"
    },
    {
      "ordinal": 37,
      "start_ms": 122510,
      "end_ms": 124330,
      "text": "有这么一个打招呼的"
    },
    {
      "ordinal": 38,
      "start_ms": 124330,
      "end_ms": 126230,
      "text": "最好是用口香糖了啊"
    },
    {
      "ordinal": 39,
      "start_ms": 126230,
      "end_ms": 127710,
      "text": "不要乱吐了"
    },
    {
      "ordinal": 40,
      "start_ms": 129070,
      "end_ms": 130710,
      "text": "抽烟会损害健康啊"
    },
    {
      "ordinal": 41,
      "start_ms": 130710,
      "end_ms": 132170,
      "text": "抽烟会损害健康"
    },
    {
      "ordinal": 42,
      "start_ms": 132170,
      "end_ms": 134390,
      "text": "而且更不要嚼槟榔什么的"
    },
    {
      "ordinal": 43,
      "start_ms": 134390,
      "end_ms": 136390,
      "text": "它是更严重损害健康的"
    },
    {
      "ordinal": 44,
      "start_ms": 136390,
      "end_ms": 138950,
      "text": "而而且是让你的身体"
    },
    {
      "ordinal": 45,
      "start_ms": 138950,
      "end_ms": 142950,
      "text": "对自己的状态的判断会失真失准"
    },
    {
      "ordinal": 46,
      "start_ms": 142950,
      "end_ms": 144010,
      "text": "你已经累了"
    },
    {
      "ordinal": 47,
      "start_ms": 144010,
      "end_ms": 145150,
      "text": "你已经有损害了"
    },
    {
      "ordinal": 48,
      "start_ms": 145150,
      "end_ms": 145790,
      "text": "有损伤了"
    },
    {
      "ordinal": 49,
      "start_ms": 145790,
      "end_ms": 146610,
      "text": "但是你抽了烟"
    },
    {
      "ordinal": 50,
      "start_ms": 146610,
      "end_ms": 147630,
      "text": "那兴奋了"
    },
    {
      "ordinal": 51,
      "start_ms": 147630,
      "end_ms": 149420,
      "text": "感受不出来啊"
    },
    {
      "ordinal": 52,
      "start_ms": 149420,
      "end_ms": 152140,
      "text": "你对自己健康状态判断出问题的话"
    },
    {
      "ordinal": 53,
      "start_ms": 152140,
      "end_ms": 154640,
      "text": "那可能小病会拖成大病"
    },
    {
      "ordinal": 54,
      "start_ms": 154920,
      "end_ms": 156780,
      "text": "没病会拖成有病了"
    },
    {
      "ordinal": 55,
      "start_ms": 156780,
      "end_ms": 158380,
      "text": "整个免疫力会降低"
    },
    {
      "ordinal": 56,
      "start_ms": 158380,
      "end_ms": 161240,
      "text": "这不都不利于你的这个长远利益的"
    },
    {
      "ordinal": 57,
      "start_ms": 161240,
      "end_ms": 164970,
      "text": "所以说戒烟或尽量少抽烟"
    },
    {
      "ordinal": 58,
      "start_ms": 164970,
      "end_ms": 167570,
      "text": "把钱省下来啊"
    },
    {
      "ordinal": 59,
      "start_ms": 167570,
      "end_ms": 169170,
      "text": "和别人交际的时候"
    },
    {
      "ordinal": 60,
      "start_ms": 169170,
      "end_ms": 170190,
      "text": "用口香糖"
    },
    {
      "ordinal": 61,
      "start_ms": 170190,
      "end_ms": 171290,
      "text": "用点小饮料"
    },
    {
      "ordinal": 62,
      "start_ms": 171290,
      "end_ms": 172880,
      "text": "这样来交际"
    },
    {
      "ordinal": 63,
      "start_ms": 173200,
      "end_ms": 174400,
      "text": "这一点啊"
    },
    {
      "ordinal": 64,
      "start_ms": 174400,
      "end_ms": 175240,
      "text": "第二点"
    },
    {
      "ordinal": 65,
      "start_ms": 175240,
      "end_ms": 177600,
      "text": "戒酒酗酒很严重"
    },
    {
      "ordinal": 66,
      "start_ms": 177600,
      "end_ms": 179960,
      "text": "你的体力体力活动结束之后"
    },
    {
      "ordinal": 67,
      "start_ms": 179960,
      "end_ms": 182320,
      "text": "要通过酒才能睡得着"
    },
    {
      "ordinal": 68,
      "start_ms": 184220,
      "end_ms": 187100,
      "text": "俺要用这个精神麻醉品麻木自己"
    },
    {
      "ordinal": 69,
      "start_ms": 188260,
      "end_ms": 191410,
      "text": "有的是体力劳动结束了之后呢"
    },
    {
      "ordinal": 70,
      "start_ms": 191770,
      "end_ms": 193970,
      "text": "喝酒才睡得着嘛"
    },
    {
      "ordinal": 71,
      "start_ms": 193970,
      "end_ms": 196370,
      "text": "然后感觉比较爽啊"
    },
    {
      "ordinal": 72,
      "start_ms": 196370,
      "end_ms": 200250,
      "text": "这个实际上酗酒之后睡着的那个东西是这样的"
    },
    {
      "ordinal": 73,
      "start_ms": 200250,
      "end_ms": 205050,
      "text": "精神麻醉了你那个沉昏昏沉状态"
    },
    {
      "ordinal": 74,
      "start_ms": 205050,
      "end_ms": 207470,
      "text": "身体其实并没有"
    },
    {
      "ordinal": 75,
      "start_ms": 207470,
      "end_ms": 209070,
      "text": "身体也是受损的"
    },
    {
      "ordinal": 76,
      "start_ms": 209070,
      "end_ms": 211520,
      "text": "因为酒精是蛋白质溶解剂"
    },
    {
      "ordinal": 77,
      "start_ms": 211520,
      "end_ms": 213520,
      "text": "然后酒精是弥散在整个身体"
    },
    {
      "ordinal": 78,
      "start_ms": 213520,
      "end_ms": 215580,
      "text": "而且酒精还穿过血脑屏障"
    },
    {
      "ordinal": 79,
      "start_ms": 215580,
      "end_ms": 218840,
      "text": "是损害你的大脑的啊"
    },
    {
      "ordinal": 80,
      "start_ms": 218840,
      "end_ms": 221980,
      "text": "损害你大脑的整个人实际上是一个麻木状态"
    },
    {
      "ordinal": 81,
      "start_ms": 221980,
      "end_ms": 223060,
      "text": "而不是睡着了"
    },
    {
      "ordinal": 82,
      "start_ms": 223060,
      "end_ms": 223640,
      "text": "是麻木"
    },
    {
      "ordinal": 83,
      "start_ms": 223640,
      "end_ms": 224640,
      "text": "而不是睡着了"
    },
    {
      "ordinal": 84,
      "start_ms": 224640,
      "end_ms": 227080,
      "text": "但酒精有某种依赖成瘾机制"
    },
    {
      "ordinal": 85,
      "start_ms": 227080,
      "end_ms": 228460,
      "text": "它也会成瘾的"
    },
    {
      "ordinal": 86,
      "start_ms": 228460,
      "end_ms": 230490,
      "text": "所以我们就说要戒酒"
    },
    {
      "ordinal": 87,
      "start_ms": 230490,
      "end_ms": 232610,
      "text": "戒酒代之以什么"
    },
    {
      "ordinal": 88,
      "start_ms": 232610,
      "end_ms": 236290,
      "text": "戒酒多之后就可以有个东西来取代他"
    },
    {
      "ordinal": 89,
      "start_ms": 236620,
      "end_ms": 238200,
      "text": "可以有个东西来取代它"
    },
    {
      "ordinal": 90,
      "start_ms": 238200,
      "end_ms": 242180,
      "text": "我建议你可以喝就是喝饮料啊"
    },
    {
      "ordinal": 91,
      "start_ms": 242180,
      "end_ms": 245600,
      "text": "无糖饮料得是无糖的"
    },
    {
      "ordinal": 92,
      "start_ms": 245760,
      "end_ms": 248320,
      "text": "因为糖分摄入过多对身体有害"
    },
    {
      "ordinal": 93,
      "start_ms": 248320,
      "end_ms": 253179,
      "text": "然后酒精不要用脚酒精麻木自己"
    },
    {
      "ordinal": 94,
      "start_ms": 253179,
      "end_ms": 256839,
      "text": "而应当在你上班结束了之后"
    },
    {
      "ordinal": 95,
      "start_ms": 256839,
      "end_ms": 259440,
      "text": "用什么东西来麻木你自己啊"
    },
    {
      "ordinal": 96,
      "start_ms": 259440,
      "end_ms": 260620,
      "text": "学习知识"
    },
    {
      "ordinal": 97,
      "start_ms": 260620,
      "end_ms": 261459,
      "text": "学习技术"
    },
    {
      "ordinal": 98,
      "start_ms": 261459,
      "end_ms": 266620,
      "text": "把你喝酒之后昏沉的那个时间代之以学习技术"
    },
    {
      "ordinal": 99,
      "start_ms": 266780,
      "end_ms": 268940,
      "text": "代日语学习知识"
    },
    {
      "ordinal": 100,
      "start_ms": 269640,
      "end_ms": 271900,
      "text": "那人文历史的哲学"
    },
    {
      "ordinal": 101,
      "start_ms": 271900,
      "end_ms": 273760,
      "text": "军事的啊"
    },
    {
      "ordinal": 102,
      "start_ms": 273760,
      "end_ms": 275180,
      "text": "这些比较通用的"
    },
    {
      "ordinal": 103,
      "start_ms": 275180,
      "end_ms": 276740,
      "text": "或者说是你专门的"
    },
    {
      "ordinal": 104,
      "start_ms": 276740,
      "end_ms": 278809,
      "text": "你是研究什么啊"
    },
    {
      "ordinal": 105,
      "start_ms": 278809,
      "end_ms": 280269,
      "text": "相应的一些工程的"
    },
    {
      "ordinal": 106,
      "start_ms": 280269,
      "end_ms": 280929,
      "text": "力学的"
    },
    {
      "ordinal": 107,
      "start_ms": 280929,
      "end_ms": 282549,
      "text": "物理的啊"
    },
    {
      "ordinal": 108,
      "start_ms": 282549,
      "end_ms": 285300,
      "text": "材料的啊"
    },
    {
      "ordinal": 109,
      "start_ms": 285300,
      "end_ms": 287260,
      "text": "还有一些什么工艺啊"
    },
    {
      "ordinal": 110,
      "start_ms": 287260,
      "end_ms": 288580,
      "text": "专门的技术啊"
    },
    {
      "ordinal": 111,
      "start_ms": 288580,
      "end_ms": 290040,
      "text": "学习知识"
    },
    {
      "ordinal": 112,
      "start_ms": 290040,
      "end_ms": 292000,
      "text": "把时间用在这个上面"
    },
    {
      "ordinal": 113,
      "start_ms": 292000,
      "end_ms": 294409,
      "text": "来让自己感到疲倦"
    },
    {
      "ordinal": 114,
      "start_ms": 295240,
      "end_ms": 298360,
      "text": "累了之后就去睡觉学知识"
    },
    {
      "ordinal": 115,
      "start_ms": 298360,
      "end_ms": 299520,
      "text": "学着学着自己就困了"
    },
    {
      "ordinal": 116,
      "start_ms": 299520,
      "end_ms": 300320,
      "text": "学着学着就累了"
    },
    {
      "ordinal": 117,
      "start_ms": 300320,
      "end_ms": 301240,
      "text": "然后睡觉入睡"
    },
    {
      "ordinal": 118,
      "start_ms": 301240,
      "end_ms": 302840,
      "text": "不要用酒来助眠"
    },
    {
      "ordinal": 119,
      "start_ms": 302840,
      "end_ms": 304420,
      "text": "久不助眠呐"
    },
    {
      "ordinal": 120,
      "start_ms": 304420,
      "end_ms": 307760,
      "text": "酒是让你处在麻痹状态啊"
    },
    {
      "ordinal": 121,
      "start_ms": 307760,
      "end_ms": 309120,
      "text": "是锁死在麻痹状态"
    },
    {
      "ordinal": 122,
      "start_ms": 310240,
      "end_ms": 312880,
      "text": "第三点戒瓢"
    },
    {
      "ordinal": 123,
      "start_ms": 313500,
      "end_ms": 314460,
      "text": "第三人借嫖"
    },
    {
      "ordinal": 124,
      "start_ms": 315540,
      "end_ms": 322110,
      "text": "身体在反复的麻木的劳动状状态压抑呀"
    },
    {
      "ordinal": 125,
      "start_ms": 322110,
      "end_ms": 324970,
      "text": "然后就是说重复的无聊的劳动之后"
    },
    {
      "ordinal": 126,
      "start_ms": 324970,
      "end_ms": 327590,
      "text": "身体是要需要有东西刺激他的"
    },
    {
      "ordinal": 127,
      "start_ms": 327590,
      "end_ms": 328190,
      "text": "没错的"
    },
    {
      "ordinal": 128,
      "start_ms": 328190,
      "end_ms": 329990,
      "text": "肌肉反复的啊"
    },
    {
      "ordinal": 129,
      "start_ms": 329990,
      "end_ms": 331150,
      "text": "这个是格式化的"
    },
    {
      "ordinal": 130,
      "start_ms": 331150,
      "end_ms": 334240,
      "text": "这样不停的这样重复的去做一些动作啊"
    },
    {
      "ordinal": 131,
      "start_ms": 334240,
      "end_ms": 338300,
      "text": "他的剩余当然是通过这个爱欲享乐的"
    },
    {
      "ordinal": 132,
      "start_ms": 338300,
      "end_ms": 339480,
      "text": "但是我们讲的是"
    },
    {
      "ordinal": 133,
      "start_ms": 340520,
      "end_ms": 342280,
      "text": "首先他很不健康"
    },
    {
      "ordinal": 134,
      "start_ms": 342619,
      "end_ms": 346689,
      "text": "因为劳动劳动群众无产青年才挣几个钱"
    },
    {
      "ordinal": 135,
      "start_ms": 346689,
      "end_ms": 349049,
      "text": "一般价格几百块钱了不得的"
    },
    {
      "ordinal": 136,
      "start_ms": 349049,
      "end_ms": 350209,
      "text": "那么这个都很不健康"
    },
    {
      "ordinal": 137,
      "start_ms": 350209,
      "end_ms": 350889,
      "text": "你知道吗"
    },
    {
      "ordinal": 138,
      "start_ms": 350889,
      "end_ms": 353240,
      "text": "都会染上各式各样疾病"
    },
    {
      "ordinal": 139,
      "start_ms": 353240,
      "end_ms": 354940,
      "text": "会染上各式样疾病的"
    },
    {
      "ordinal": 140,
      "start_ms": 354940,
      "end_ms": 357120,
      "text": "你接触你不直接接触"
    },
    {
      "ordinal": 141,
      "start_ms": 357120,
      "end_ms": 358460,
      "text": "也会有粘液啊"
    },
    {
      "ordinal": 142,
      "start_ms": 358460,
      "end_ms": 360740,
      "text": "体液接触啊也会有"
    },
    {
      "ordinal": 143,
      "start_ms": 360740,
      "end_ms": 362720,
      "text": "他是用了一些什么浴浴"
    },
    {
      "ordinal": 144,
      "start_ms": 362720,
      "end_ms": 363660,
      "text": "浴巾啊"
    },
    {
      "ordinal": 145,
      "start_ms": 363660,
      "end_ms": 364860,
      "text": "床单啊"
    },
    {
      "ordinal": 146,
      "start_ms": 364860,
      "end_ms": 367169,
      "text": "这都有可能染病的"
    },
    {
      "ordinal": 147,
      "start_ms": 367169,
      "end_ms": 370130,
      "text": "其次呢物化女性"
    },
    {
      "ordinal": 148,
      "start_ms": 370130,
      "end_ms": 371950,
      "text": "他是一个很糟糕的一个文化"
    },
    {
      "ordinal": 149,
      "start_ms": 371950,
      "end_ms": 375010,
      "text": "就把女女人当成是器具去享用"
    },
    {
      "ordinal": 150,
      "start_ms": 375010,
      "end_ms": 377370,
      "text": "就是这个就是男女平等就不要想了"
    },
    {
      "ordinal": 151,
      "start_ms": 377370,
      "end_ms": 381030,
      "text": "然后男权主义会陷入一种怨恨当中"
    },
    {
      "ordinal": 152,
      "start_ms": 381030,
      "end_ms": 382250,
      "text": "怨恨为什么我穷"
    },
    {
      "ordinal": 153,
      "start_ms": 382250,
      "end_ms": 382770,
      "text": "我没钱"
    },
    {
      "ordinal": 154,
      "start_ms": 382770,
      "end_ms": 384299,
      "text": "我不能支配女人"
    },
    {
      "ordinal": 155,
      "start_ms": 384299,
      "end_ms": 385959,
      "text": "那你这女人是想支配啊"
    },
    {
      "ordinal": 156,
      "start_ms": 385959,
      "end_ms": 392229,
      "text": "购买啊啊那就是说为了为了嫖啊"
    },
    {
      "ordinal": 157,
      "start_ms": 392229,
      "end_ms": 393309,
      "text": "嫖到更漂亮的女人"
    },
    {
      "ordinal": 158,
      "start_ms": 393309,
      "end_ms": 394349,
      "text": "然后要赚更多的钱"
    },
    {
      "ordinal": 159,
      "start_ms": 394349,
      "end_ms": 398250,
      "text": "那整个就陷入到一个啊资产阶级腐化堕落了"
    },
    {
      "ordinal": 160,
      "start_ms": 398250,
      "end_ms": 399210,
      "text": "要赚大钱"
    },
    {
      "ordinal": 161,
      "start_ms": 399210,
      "end_ms": 400610,
      "text": "是为了要日漂亮女人"
    },
    {
      "ordinal": 162,
      "start_ms": 400610,
      "end_ms": 402710,
      "text": "这么一种人生追求上面去了"
    },
    {
      "ordinal": 163,
      "start_ms": 402710,
      "end_ms": 406530,
      "text": "整个人就就是这个枣核就烂了"
    },
    {
      "ordinal": 164,
      "start_ms": 406530,
      "end_ms": 406850,
      "text": "对不对"
    },
    {
      "ordinal": 165,
      "start_ms": 406850,
      "end_ms": 409250,
      "text": "就枣根本不可能啊"
    },
    {
      "ordinal": 166,
      "start_ms": 409250,
      "end_ms": 412350,
      "text": "根本不可能种种成枣树了"
    },
    {
      "ordinal": 167,
      "start_ms": 413110,
      "end_ms": 415270,
      "text": "那我们讲用这个东西要代"
    },
    {
      "ordinal": 168,
      "start_ms": 415270,
      "end_ms": 416390,
      "text": "用什么东西来代替它呢"
    },
    {
      "ordinal": 169,
      "start_ms": 416390,
      "end_ms": 417950,
      "text": "用体育锻炼来代替它"
    },
    {
      "ordinal": 170,
      "start_ms": 418990,
      "end_ms": 422090,
      "text": "身体有这种在工厂里面"
    },
    {
      "ordinal": 171,
      "start_ms": 422090,
      "end_ms": 426630,
      "text": "或者说在这劳动岗位上反复重复的很局域的"
    },
    {
      "ordinal": 172,
      "start_ms": 426630,
      "end_ms": 430130,
      "text": "很狭隘的那种重复的繁琐的动作"
    },
    {
      "ordinal": 173,
      "start_ms": 430130,
      "end_ms": 432850,
      "text": "身体要释放到自己啊"
    },
    {
      "ordinal": 174,
      "start_ms": 432850,
      "end_ms": 436770,
      "text": "那么什么可以好好的释放一下体育锻炼"
    },
    {
      "ordinal": 175,
      "start_ms": 436770,
      "end_ms": 439490,
      "text": "跑步啊啊打球啊"
    },
    {
      "ordinal": 176,
      "start_ms": 439490,
      "end_ms": 441790,
      "text": "踢球啊啊"
    },
    {
      "ordinal": 177,
      "start_ms": 441790,
      "end_ms": 443870,
      "text": "一周一次或者一周两次的"
    },
    {
      "ordinal": 178,
      "start_ms": 443870,
      "end_ms": 446910,
      "text": "抽空去到公园广场"
    },
    {
      "ordinal": 179,
      "start_ms": 446910,
      "end_ms": 449770,
      "text": "或者一些什么体育场去锻炼自己"
    },
    {
      "ordinal": 180,
      "start_ms": 449770,
      "end_ms": 453140,
      "text": "训练自己挥汗淋漓啊"
    },
    {
      "ordinal": 181,
      "start_ms": 453140,
      "end_ms": 454500,
      "text": "你平时有信誉的话"
    },
    {
      "ordinal": 182,
      "start_ms": 454500,
      "end_ms": 456700,
      "text": "你可以通过私人的一些方式来解决"
    },
    {
      "ordinal": 183,
      "start_ms": 456700,
      "end_ms": 458720,
      "text": "不花钱的方式来解决"
    },
    {
      "ordinal": 184,
      "start_ms": 458720,
      "end_ms": 461560,
      "text": "那自己就是手艺活了啊"
    },
    {
      "ordinal": 185,
      "start_ms": 461560,
      "end_ms": 463600,
      "text": "如果又需要一个身体的一个那种"
    },
    {
      "ordinal": 186,
      "start_ms": 463600,
      "end_ms": 466360,
      "text": "全方位的那种畅快淋漓的啊"
    },
    {
      "ordinal": 187,
      "start_ms": 466360,
      "end_ms": 469980,
      "text": "通过打球踢球跑步"
    },
    {
      "ordinal": 188,
      "start_ms": 469980,
      "end_ms": 472240,
      "text": "通过运动的方式健身"
    },
    {
      "ordinal": 189,
      "start_ms": 472240,
      "end_ms": 476880,
      "text": "运动的方式来发泄你身体当中啊"
    },
    {
      "ordinal": 190,
      "start_ms": 476880,
      "end_ms": 479560,
      "text": "郁结的这些就是不得劲"
    },
    {
      "ordinal": 191,
      "start_ms": 479560,
      "end_ms": 482110,
      "text": "难受不畅快啊"
    },
    {
      "ordinal": 192,
      "start_ms": 482110,
      "end_ms": 483690,
      "text": "通过体育锻炼"
    },
    {
      "ordinal": 193,
      "start_ms": 483690,
      "end_ms": 485450,
      "text": "通过体育锻炼啊"
    },
    {
      "ordinal": 194,
      "start_ms": 485450,
      "end_ms": 488150,
      "text": "这不花很多钱啊"
    },
    {
      "ordinal": 195,
      "start_ms": 488150,
      "end_ms": 490030,
      "text": "你再说那一次三五百"
    },
    {
      "ordinal": 196,
      "start_ms": 490030,
      "end_ms": 491550,
      "text": "这个只要三五十"
    },
    {
      "ordinal": 197,
      "start_ms": 491550,
      "end_ms": 492870,
      "text": "二三十就行了"
    },
    {
      "ordinal": 198,
      "start_ms": 492870,
      "end_ms": 494659,
      "text": "而且更健康"
    },
    {
      "ordinal": 199,
      "start_ms": 494659,
      "end_ms": 496659,
      "text": "身体会整个人的形象"
    },
    {
      "ordinal": 200,
      "start_ms": 496659,
      "end_ms": 498139,
      "text": "人的状态会越来越好"
    },
    {
      "ordinal": 201,
      "start_ms": 498139,
      "end_ms": 500470,
      "text": "那你还怕找不到女朋友吗"
    },
    {
      "ordinal": 202,
      "start_ms": 500470,
      "end_ms": 502150,
      "text": "对对你的肌肉锻炼"
    },
    {
      "ordinal": 203,
      "start_ms": 502150,
      "end_ms": 505159,
      "text": "健康都成整个面貌呈现出来的"
    },
    {
      "ordinal": 204,
      "start_ms": 505159,
      "end_ms": 506499,
      "text": "你总能找到性伴侣的"
    },
    {
      "ordinal": 205,
      "start_ms": 506499,
      "end_ms": 509919,
      "text": "那合法的正当的安全的性伴侣"
    },
    {
      "ordinal": 206,
      "start_ms": 510390,
      "end_ms": 511310,
      "text": "对要戒嫖"
    },
    {
      "ordinal": 207,
      "start_ms": 512350,
      "end_ms": 512789,
      "text": "第四点"
    },
    {
      "ordinal": 208,
      "start_ms": 512789,
      "end_ms": 515250,
      "text": "戒赌赌会上瘾的"
    },
    {
      "ordinal": 209,
      "start_ms": 515250,
      "end_ms": 518190,
      "text": "赌赌钱变成赌狗"
    },
    {
      "ordinal": 210,
      "start_ms": 518190,
      "end_ms": 521429,
      "text": "最后就是想通过呃骗取别人的"
    },
    {
      "ordinal": 211,
      "start_ms": 521429,
      "end_ms": 522870,
      "text": "榨取别人的利益"
    },
    {
      "ordinal": 212,
      "start_ms": 522870,
      "end_ms": 523950,
      "text": "好像是赌嘛"
    },
    {
      "ordinal": 213,
      "start_ms": 523950,
      "end_ms": 524750,
      "text": "不是天经地义嘛"
    },
    {
      "ordinal": 214,
      "start_ms": 524750,
      "end_ms": 527460,
      "text": "不这其实就是算谁是倒霉鬼"
    },
    {
      "ordinal": 215,
      "start_ms": 527460,
      "end_ms": 528100,
      "text": "是倒霉了"
    },
    {
      "ordinal": 216,
      "start_ms": 528100,
      "end_ms": 530000,
      "text": "然后其他人踩着他往上爬"
    },
    {
      "ordinal": 217,
      "start_ms": 530000,
      "end_ms": 531680,
      "text": "这种叫底层互害"
    },
    {
      "ordinal": 218,
      "start_ms": 531680,
      "end_ms": 533490,
      "text": "相互倾轧"
    },
    {
      "ordinal": 219,
      "start_ms": 536410,
      "end_ms": 538170,
      "text": "是互害的"
    },
    {
      "ordinal": 220,
      "start_ms": 538450,
      "end_ms": 540030,
      "text": "得利的只有资产阶级"
    },
    {
      "ordinal": 221,
      "start_ms": 540030,
      "end_ms": 541370,
      "text": "看你们这互相掐了"
    },
    {
      "ordinal": 222,
      "start_ms": 541370,
      "end_ms": 542690,
      "text": "越来越弱小了"
    },
    {
      "ordinal": 223,
      "start_ms": 542690,
      "end_ms": 543910,
      "text": "变成赌狗了"
    },
    {
      "ordinal": 224,
      "start_ms": 543910,
      "end_ms": 545330,
      "text": "只能成为副产阶级"
    },
    {
      "ordinal": 225,
      "start_ms": 545330,
      "end_ms": 546170,
      "text": "不是无产阶级"
    },
    {
      "ordinal": 226,
      "start_ms": 551020,
      "end_ms": 555510,
      "text": "啊所以赌博是严禁的"
    },
    {
      "ordinal": 227,
      "start_ms": 555510,
      "end_ms": 558190,
      "text": "那在我们的团体里面赌博都是严禁的"
    },
    {
      "ordinal": 228,
      "start_ms": 558190,
      "end_ms": 559410,
      "text": "一定要戒赌"
    },
    {
      "ordinal": 229,
      "start_ms": 559410,
      "end_ms": 561610,
      "text": "那么代之以什么呢"
    },
    {
      "ordinal": 230,
      "start_ms": 562470,
      "end_ms": 565230,
      "text": "待之以不赌博"
    },
    {
      "ordinal": 231,
      "start_ms": 565230,
      "end_ms": 567510,
      "text": "但是大家要聚起来会玩玩游戏"
    },
    {
      "ordinal": 232,
      "start_ms": 567510,
      "end_ms": 568770,
      "text": "会什么会什么"
    },
    {
      "ordinal": 233,
      "start_ms": 568770,
      "end_ms": 570030,
      "text": "聊一聊什么的东西"
    },
    {
      "ordinal": 234,
      "start_ms": 570030,
      "end_ms": 573740,
      "text": "你可以用玩玩手游来替代他"
    },
    {
      "ordinal": 235,
      "start_ms": 573740,
      "end_ms": 575980,
      "text": "两个几个朋友一起聚在一块"
    },
    {
      "ordinal": 236,
      "start_ms": 575980,
      "end_ms": 577040,
      "text": "不赌钱"
    },
    {
      "ordinal": 237,
      "start_ms": 577040,
      "end_ms": 579900,
      "text": "不赌前可以聊聊些什么"
    },
    {
      "ordinal": 238,
      "start_ms": 579900,
      "end_ms": 583370,
      "text": "如何改善你的工作待遇"
    },
    {
      "ordinal": 239,
      "start_ms": 583370,
      "end_ms": 587990,
      "text": "聊一聊一些这个啊管理层老板丑闻"
    },
    {
      "ordinal": 240,
      "start_ms": 587990,
      "end_ms": 591210,
      "text": "聊一条他段子影像慢慢影像"
    },
    {
      "ordinal": 241,
      "start_ms": 591210,
      "end_ms": 593390,
      "text": "大家一起想办法啊"
    },
    {
      "ordinal": 242,
      "start_ms": 593390,
      "end_ms": 596070,
      "text": "如何去改善自己的工作待遇"
    },
    {
      "ordinal": 243,
      "start_ms": 596070,
      "end_ms": 600070,
      "text": "如何去提高劳动者这一方的啊"
    },
    {
      "ordinal": 244,
      "start_ms": 600070,
      "end_ms": 602970,
      "text": "这个影响力"
    },
    {
      "ordinal": 245,
      "start_ms": 602970,
      "end_ms": 607060,
      "text": "话语权对于这个事物的决决定"
    },
    {
      "ordinal": 246,
      "start_ms": 607060,
      "end_ms": 608580,
      "text": "那比如说这个厂里面"
    },
    {
      "ordinal": 247,
      "start_ms": 608580,
      "end_ms": 610520,
      "text": "有一些很多规则是不合理的"
    },
    {
      "ordinal": 248,
      "start_ms": 610520,
      "end_ms": 611360,
      "text": "大家聊一聊"
    },
    {
      "ordinal": 249,
      "start_ms": 611360,
      "end_ms": 613480,
      "text": "怎么让这个不合理凸显出来"
    },
    {
      "ordinal": 250,
      "start_ms": 613480,
      "end_ms": 614980,
      "text": "靠一个什么契机"
    },
    {
      "ordinal": 251,
      "start_ms": 614980,
      "end_ms": 617140,
      "text": "一个两个的聊一聊"
    },
    {
      "ordinal": 252,
      "start_ms": 617140,
      "end_ms": 618380,
      "text": "怎么对付自己的主管"
    },
    {
      "ordinal": 253,
      "start_ms": 618380,
      "end_ms": 620580,
      "text": "怎么对付自己的车间主任啊"
    },
    {
      "ordinal": 254,
      "start_ms": 624940,
      "end_ms": 627760,
      "text": "要去把赌博的时间"
    },
    {
      "ordinal": 255,
      "start_ms": 627760,
      "end_ms": 633000,
      "text": "把底层互害的互相之间倾轧的彼此互相伤害"
    },
    {
      "ordinal": 256,
      "start_ms": 633000,
      "end_ms": 636400,
      "text": "要互相踩着别人往上爬的这种活动"
    },
    {
      "ordinal": 257,
      "start_ms": 636400,
      "end_ms": 642770,
      "text": "要代替替换成大家一块商量着如何去对付啊"
    },
    {
      "ordinal": 258,
      "start_ms": 642770,
      "end_ms": 644650,
      "text": "对付自己的对手"
    },
    {
      "ordinal": 259,
      "start_ms": 644810,
      "end_ms": 646650,
      "text": "如何去对付啊"
    },
    {
      "ordinal": 260,
      "start_ms": 646650,
      "end_ms": 649290,
      "text": "资方当然说这是小规模的"
    },
    {
      "ordinal": 261,
      "start_ms": 649290,
      "end_ms": 651530,
      "text": "而且是用小的技巧就积累的"
    },
    {
      "ordinal": 262,
      "start_ms": 651530,
      "end_ms": 652750,
      "text": "在这些啊"
    },
    {
      "ordinal": 263,
      "start_ms": 652750,
      "end_ms": 658040,
      "text": "如果去啊能够在高强度的这个管理啊"
    },
    {
      "ordinal": 264,
      "start_ms": 658040,
      "end_ms": 659860,
      "text": "工时制度下能够喘气"
    },
    {
      "ordinal": 265,
      "start_ms": 659860,
      "end_ms": 662250,
      "text": "能够喘息啊"
    },
    {
      "ordinal": 266,
      "start_ms": 662770,
      "end_ms": 664090,
      "text": "互相交流心得"
    },
    {
      "ordinal": 267,
      "start_ms": 664090,
      "end_ms": 664650,
      "text": "出主意"
    },
    {
      "ordinal": 268,
      "start_ms": 665850,
      "end_ms": 667750,
      "text": "要做好这四点"
    },
    {
      "ordinal": 269,
      "start_ms": 667750,
      "end_ms": 669210,
      "text": "首先做好这四点"
    },
    {
      "ordinal": 270,
      "start_ms": 669210,
      "end_ms": 671230,
      "text": "你才能够成为一个有余力的人"
    },
    {
      "ordinal": 271,
      "start_ms": 671230,
      "end_ms": 675920,
      "text": "才能在你这个无产青年的工作当中"
    },
    {
      "ordinal": 272,
      "start_ms": 675920,
      "end_ms": 680270,
      "text": "才能第一步站稳脚跟啊"
    },
    {
      "ordinal": 273,
      "start_ms": 680270,
      "end_ms": 682210,
      "text": "整个人的精神面貌为之一振"
    },
    {
      "ordinal": 274,
      "start_ms": 682210,
      "end_ms": 683850,
      "text": "整个人的这个事业"
    },
    {
      "ordinal": 275,
      "start_ms": 683850,
      "end_ms": 689960,
      "text": "整个人的心理情感状态都摆正了啊"
    },
    {
      "ordinal": 276,
      "start_ms": 689960,
      "end_ms": 691040,
      "text": "都扎根扎好"
    },
    {
      "ordinal": 277,
      "start_ms": 692360,
      "end_ms": 692920,
      "text": "要做好"
    },
    {
      "ordinal": 278,
      "start_ms": 692920,
      "end_ms": 694770,
      "text": "首先做好这四点"
    },
    {
      "ordinal": 279,
      "start_ms": 694770,
      "end_ms": 696170,
      "text": "然后当然还有第五点"
    },
    {
      "ordinal": 280,
      "start_ms": 696170,
      "end_ms": 701340,
      "text": "就是远离那些虚无缥缈的悲剧性的啊"
    },
    {
      "ordinal": 281,
      "start_ms": 701340,
      "end_ms": 704890,
      "text": "自我陶醉的激进花的幻想"
    },
    {
      "ordinal": 282,
      "start_ms": 705050,
      "end_ms": 707470,
      "text": "它会让你离群众越来越远"
    },
    {
      "ordinal": 283,
      "start_ms": 707470,
      "end_ms": 710140,
      "text": "离你的工友越来越远啊"
    },
    {
      "ordinal": 284,
      "start_ms": 714140,
      "end_ms": 717530,
      "text": "没有任何意义好吧"
    },
    {
      "ordinal": 285,
      "start_ms": 717530,
      "end_ms": 719030,
      "text": "那我们就讲到这边"
    },
    {
      "ordinal": 286,
      "start_ms": 719030,
      "end_ms": 720610,
      "text": "一定要做好这四点"
    },
    {
      "ordinal": 287,
      "start_ms": 720610,
      "end_ms": 723090,
      "text": "戒赌戒酒"
    },
    {
      "ordinal": 288,
      "start_ms": 723090,
      "end_ms": 724670,
      "text": "戒嫖啊"
    },
    {
      "ordinal": 289,
      "start_ms": 724670,
      "end_ms": 727230,
      "text": "戒戒这个烟啊"
    },
    {
      "ordinal": 290,
      "start_ms": 727230,
      "end_ms": 730870,
      "text": "戒抽烟就直接吸取了一些精神成品"
    },
    {
      "ordinal": 291,
      "start_ms": 731230,
      "end_ms": 733910,
      "text": "戒酒喝的精神成瘾品"
    },
    {
      "ordinal": 292,
      "start_ms": 733910,
      "end_ms": 735310,
      "text": "戒毒啊"
    },
    {
      "ordinal": 293,
      "start_ms": 735310,
      "end_ms": 736350,
      "text": "戒瓢啊"
    },
    {
      "ordinal": 294,
      "start_ms": 736350,
      "end_ms": 738110,
      "text": "这个是身体交互的啊"
    },
    {
      "ordinal": 295,
      "start_ms": 738110,
      "end_ms": 739760,
      "text": "也精神成瘾品啊"
    },
    {
      "ordinal": 296,
      "start_ms": 739760,
      "end_ms": 740560,
      "text": "还有戒赌"
    },
    {
      "ordinal": 297,
      "start_ms": 740560,
      "end_ms": 742600,
      "text": "那就是精神交互的啊"
    },
    {
      "ordinal": 298,
      "start_ms": 742600,
      "end_ms": 746060,
      "text": "或者说我们就是社交性质的精神成瘾的活动"
    },
    {
      "ordinal": 299,
      "start_ms": 746060,
      "end_ms": 749189,
      "text": "把这四个呢置换成更好的"
    },
    {
      "ordinal": 300,
      "start_ms": 749189,
      "end_ms": 750449,
      "text": "更有价值的"
    },
    {
      "ordinal": 301,
      "start_ms": 750449,
      "end_ms": 751449,
      "text": "对身体有益的"
    },
    {
      "ordinal": 302,
      "start_ms": 751449,
      "end_ms": 752929,
      "text": "包括你第一项买零食"
    },
    {
      "ordinal": 303,
      "start_ms": 752929,
      "end_ms": 754289,
      "text": "请你们买点健康一点的啊"
    },
    {
      "ordinal": 304,
      "start_ms": 754289,
      "end_ms": 756700,
      "text": "饮料买健康一点的啊"
    },
    {
      "ordinal": 305,
      "start_ms": 756700,
      "end_ms": 759180,
      "text": "大家要要走长远的路"
    },
    {
      "ordinal": 306,
      "start_ms": 759180,
      "end_ms": 761070,
      "text": "算长远的账"
    },
    {
      "ordinal": 307,
      "start_ms": 761230,
      "end_ms": 764610,
      "text": "要不停的要增强自己的精神身体"
    },
    {
      "ordinal": 308,
      "start_ms": 764610,
      "end_ms": 768360,
      "text": "还有社交的啊种种能力"
    },
    {
      "ordinal": 309,
      "start_ms": 768360,
      "end_ms": 771400,
      "text": "我们促进的是长远的力量对比的扭转"
    },
    {
      "ordinal": 310,
      "start_ms": 771400,
      "end_ms": 773460,
      "text": "而不是想要一蹴而就"
    },
    {
      "ordinal": 311,
      "start_ms": 773460,
      "end_ms": 776340,
      "text": "而不是想要这个走捷径啊"
    },
    {
      "ordinal": 312,
      "start_ms": 776340,
      "end_ms": 778180,
      "text": "你就是不能搞赌狗"
    },
    {
      "ordinal": 313,
      "start_ms": 778180,
      "end_ms": 781980,
      "text": "或者说这瓢虫心理花钱就能搞定的瓢虫心理"
    },
    {
      "ordinal": 314,
      "start_ms": 781980,
      "end_ms": 785069,
      "text": "或者就是说碰运气的就是赌狗心理"
    },
    {
      "ordinal": 315,
      "start_ms": 785069,
      "end_ms": 788989,
      "text": "或者就是说啊就九图心理呢"
    },
    {
      "ordinal": 316,
      "start_ms": 788989,
      "end_ms": 791609,
      "text": "就是说埋头不去面对的九图心理"
    },
    {
      "ordinal": 317,
      "start_ms": 791609,
      "end_ms": 796460,
      "text": "或者说就是装潇洒的这个烟鬼心理"
    },
    {
      "ordinal": 318,
      "start_ms": 796460,
      "end_ms": 797560,
      "text": "假装自己潇洒"
    },
    {
      "ordinal": 319,
      "start_ms": 797560,
      "end_ms": 798820,
      "text": "假装自己置身事外"
    },
    {
      "ordinal": 320,
      "start_ms": 798820,
      "end_ms": 800580,
      "text": "跟自己没关系的烟鬼心理"
    },
    {
      "ordinal": 321,
      "start_ms": 800580,
      "end_ms": 803740,
      "text": "假装置身事外没关系的烟鬼行李啊"
    },
    {
      "ordinal": 322,
      "start_ms": 803740,
      "end_ms": 805040,
      "text": "轻微麻醉麻痹"
    },
    {
      "ordinal": 323,
      "start_ms": 805040,
      "end_ms": 809589,
      "text": "假装这个逃遁到另外一个世界当中去啊"
    },
    {
      "ordinal": 324,
      "start_ms": 809589,
      "end_ms": 811069,
      "text": "逃遁到这个反正昏睡"
    },
    {
      "ordinal": 325,
      "start_ms": 811069,
      "end_ms": 814540,
      "text": "不面对他鸵鸟心理的这种酒鬼心理啊"
    },
    {
      "ordinal": 326,
      "start_ms": 814540,
      "end_ms": 818960,
      "text": "还有就是假装花钱就能搞定的那种瓢虫心理呃"
    },
    {
      "ordinal": 327,
      "start_ms": 818960,
      "end_ms": 822240,
      "text": "或者说靠女女女女体享乐就能满足的"
    },
    {
      "ordinal": 328,
      "start_ms": 822240,
      "end_ms": 823580,
      "text": "女这种瓢虫心理"
    },
    {
      "ordinal": 329,
      "start_ms": 823580,
      "end_ms": 826750,
      "text": "享乐主义的花钱拜金主义的瓢虫心理"
    },
    {
      "ordinal": 330,
      "start_ms": 826750,
      "end_ms": 831200,
      "text": "或者最后这样一种假装碰运气投机啊"
    },
    {
      "ordinal": 331,
      "start_ms": 831200,
      "end_ms": 832880,
      "text": "然后互相伤害"
    },
    {
      "ordinal": 332,
      "start_ms": 832880,
      "end_ms": 836480,
      "text": "互害就能搞定问题的这种赌徒心理"
    },
    {
      "ordinal": 333,
      "start_ms": 840380,
      "end_ms": 843740,
      "text": "而且都是对无产阶级的这个阶级力量的扭转"
    },
    {
      "ordinal": 334,
      "start_ms": 843740,
      "end_ms": 844770,
      "text": "提高"
    },
    {
      "ordinal": 335,
      "start_ms": 844770,
      "end_ms": 846370,
      "text": "这量对比的扭转哈"
    },
    {
      "ordinal": 336,
      "start_ms": 846370,
      "end_ms": 849140,
      "text": "整个阶级量提高都是非常不利的"
    },
    {
      "ordinal": 337,
      "start_ms": 849140,
      "end_ms": 851060,
      "text": "还有代之以更健康的"
    },
    {
      "ordinal": 338,
      "start_ms": 851060,
      "end_ms": 854480,
      "text": "代之以更积极向上的这个工作"
    },
    {
      "ordinal": 339,
      "start_ms": 854480,
      "end_ms": 856880,
      "text": "时时做日日做啊"
    },
    {
      "ordinal": 340,
      "start_ms": 856880,
      "end_ms": 858530,
      "text": "经年累月"
    },
    {
      "ordinal": 341,
      "start_ms": 858530,
      "end_ms": 859590,
      "text": "对不对"
    },
    {
      "ordinal": 342,
      "start_ms": 859590,
      "end_ms": 861930,
      "text": "也就是说自己这样去转变"
    },
    {
      "ordinal": 343,
      "start_ms": 861930,
      "end_ms": 862830,
      "text": "往好的方向转变"
    },
    {
      "ordinal": 344,
      "start_ms": 862830,
      "end_ms": 865330,
      "text": "去带动的去往好的方向转变"
    },
    {
      "ordinal": 345,
      "start_ms": 865330,
      "end_ms": 867070,
      "text": "成为这样一种的四好青年"
    },
    {
      "ordinal": 346,
      "start_ms": 867070,
      "end_ms": 872310,
      "text": "我们就明白吗啊这四四点只要能做好啊"
    },
    {
      "ordinal": 347,
      "start_ms": 872310,
      "end_ms": 876790,
      "text": "然后还有一点就是工作当中要啊要敢于担当"
    },
    {
      "ordinal": 348,
      "start_ms": 876790,
      "end_ms": 879990,
      "text": "最后一点就是你把这四条都做到了之后"
    },
    {
      "ordinal": 349,
      "start_ms": 879990,
      "end_ms": 882069,
      "text": "如果你工作当中不好好干"
    },
    {
      "ordinal": 350,
      "start_ms": 882069,
      "end_ms": 885029,
      "text": "工作当中不敢去承担这个生产任务"
    },
    {
      "ordinal": 351,
      "start_ms": 885029,
      "end_ms": 887229,
      "text": "危急时的一些重要的任务"
    },
    {
      "ordinal": 352,
      "start_ms": 887229,
      "end_ms": 887689,
      "text": "使命"
    },
    {
      "ordinal": 353,
      "start_ms": 887689,
      "end_ms": 888829,
      "text": "不勇敢的去面对"
    },
    {
      "ordinal": 354,
      "start_ms": 888829,
      "end_ms": 890500,
      "text": "还是要遵循"
    },
    {
      "ordinal": 355,
      "start_ms": 890500,
      "end_ms": 894400,
      "text": "比如说出了有可能会出安全事故啊"
    },
    {
      "ordinal": 356,
      "start_ms": 894400,
      "end_ms": 896020,
      "text": "你就要勇敢的去提出"
    },
    {
      "ordinal": 357,
      "start_ms": 896020,
      "end_ms": 897190,
      "text": "勇敢去改正"
    },
    {
      "ordinal": 358,
      "start_ms": 897190,
      "end_ms": 899110,
      "text": "要对大家的长远利益"
    },
    {
      "ordinal": 359,
      "start_ms": 899110,
      "end_ms": 902750,
      "text": "健康生命要负起重要的责任啊"
    },
    {
      "ordinal": 360,
      "start_ms": 902750,
      "end_ms": 904410,
      "text": "这也是很重要的啊"
    },
    {
      "ordinal": 361,
      "start_ms": 904410,
      "end_ms": 906230,
      "text": "那所以说我们这个标准"
    },
    {
      "ordinal": 362,
      "start_ms": 906230,
      "end_ms": 908350,
      "text": "不是说前面那四个东西你满足了"
    },
    {
      "ordinal": 363,
      "start_ms": 908350,
      "end_ms": 910410,
      "text": "你就是一个非常好的无产青年的"
    },
    {
      "ordinal": 364,
      "start_ms": 910410,
      "end_ms": 912390,
      "text": "你还要在劳动生产中生产"
    },
    {
      "ordinal": 365,
      "start_ms": 912390,
      "end_ms": 918020,
      "text": "实际当中要敢于去way这个厂"
    },
    {
      "ordinal": 366,
      "start_ms": 918020,
      "end_ms": 919540,
      "text": "这个劳动环境"
    },
    {
      "ordinal": 367,
      "start_ms": 919540,
      "end_ms": 922820,
      "text": "还走消费者当中的绝大部分的人民群众"
    },
    {
      "ordinal": 368,
      "start_ms": 922820,
      "end_ms": 927560,
      "text": "无产群众要为他们的利益要敢于去献身啊"
    },
    {
      "ordinal": 369,
      "start_ms": 927560,
      "end_ms": 930260,
      "text": "要执着的去努力啊"
    },
    {
      "ordinal": 370,
      "start_ms": 930260,
      "end_ms": 933740,
      "text": "那你就是一个非常了不起的无产青年"
    },
    {
      "ordinal": 371,
      "start_ms": 933740,
      "end_ms": 935860,
      "text": "那你一直这样去做下去"
    },
    {
      "ordinal": 372,
      "start_ms": 935860,
      "end_ms": 938480,
      "text": "你天然的就有你天然的"
    },
    {
      "ordinal": 373,
      "start_ms": 938480,
      "end_ms": 940490,
      "text": "而且你是真实的现实的"
    },
    {
      "ordinal": 374,
      "start_ms": 940490,
      "end_ms": 942130,
      "text": "不是说什么天兵天将"
    },
    {
      "ordinal": 375,
      "start_ms": 942130,
      "end_ms": 944290,
      "text": "天兵天将下凡不是什么"
    },
    {
      "ordinal": 376,
      "start_ms": 944290,
      "end_ms": 946330,
      "text": "你从哪哪个小组里面什么派下来"
    },
    {
      "ordinal": 377,
      "start_ms": 946330,
      "end_ms": 947840,
      "text": "荣公啊"
    },
    {
      "ordinal": 378,
      "start_ms": 950200,
      "end_ms": 954000,
      "text": "按说你是真的是实地实事求是的"
    },
    {
      "ordinal": 379,
      "start_ms": 954000,
      "end_ms": 955800,
      "text": "从这土壤当中汲取的养分"
    },
    {
      "ordinal": 380,
      "start_ms": 955800,
      "end_ms": 959820,
      "text": "长出来的参天大树啊"
    },
    {
      "ordinal": 381,
      "start_ms": 959820,
      "end_ms": 960840,
      "text": "桃李不言"
    },
    {
      "ordinal": 382,
      "start_ms": 960840,
      "end_ms": 961920,
      "text": "下自成蹊"
    },
    {
      "ordinal": 383,
      "start_ms": 961920,
      "end_ms": 963180,
      "text": "就做好这一步"
    },
    {
      "ordinal": 384,
      "start_ms": 963180,
      "end_ms": 964000,
      "text": "好吧"
    },
    {
      "ordinal": 385,
      "start_ms": 964000,
      "end_ms": 965460,
      "text": "讲到这里啊"
