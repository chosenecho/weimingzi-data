{"segments":[{"start":0.08,"end":2.24,"text":"呃我们今天要来讲一件事情"},{"start":2.24,"end":5.68,"text":"就是当然昨天发生的事情"},{"start":5.68,"end":9.84,"text":"也表明了一个目前官方的立场啊"},{"start":10.96,"end":14.68,"text":"但是75周年和60周年"},{"start":14.68,"end":17.48,"text":"我认为是并行不悖的"},{"start":18.01,"end":21.09,"text":"有句老话叫做60年河东"},{"start":21.09,"end":23.09,"text":"60年河西"},{"start":29.57,"end":34.57,"text":"嗯我们大家耳熟能详的有一首卜算子"},{"start":34.57,"end":36.89,"text":"他最后有一句叫做"},{"start":38.19,"end":39.91,"text":"花落自有花开"},{"start":39.91,"end":43.95,"text":"日蓄芳待来年"},{"start":44.59,"end":45.95,"text":"我说了这种事呢"},{"start":45.95,"end":48.149,"text":"就60年前啊"},{"start":48.149,"end":49.449,"text":"在我们的版本当中"},{"start":49.449,"end":55.409,"text":"当然认为就是是苏哈托指使翁东"},{"start":56.35,"end":62.43,"text":"啊好像是故意那七个将领杀的时候"},{"start":62.43,"end":66.27,"text":"故意漏了一个他的军方的总司令"},{"start":67.15,"end":68.63,"text":"没杀啊"},{"start":68.95,"end":75.73,"text":"然后苏华托很快就啊苏华托也不在名单上啊"},{"start":75.73,"end":79.89,"text":"所以在这个意义上讲的这个事件呢"},{"start":79.89,"end":84.13,"text":"是在1965年发生了这个事件"},{"start":89.13,"end":93.77,"text":"或者说是甚至说是人类嗯第三大的"},{"start":93.77,"end":97.51,"text":"并且他通过议会斗争嗯"},{"start":98.51,"end":99.29,"text":"基本上啊"},{"start":99.29,"end":102.82,"text":"然后苏加诺也比较哈"},{"start":112.109,"end":114.889,"text":"本来都已经认为是劳了的"},{"start":114.889,"end":117.289,"text":"大量的部长啊"},{"start":130.259,"end":130.56,"text":"就"},{"start":132.92,"end":134.64,"text":"轰然而倒"},{"start":135.2,"end":137.24,"text":"这个65年的这个事情呢"},{"start":137.24,"end":142.8,"text":"实际上是引起了一系列的连锁反应啊"},{"start":142.8,"end":145.5,"text":"非常重大的一系列的连锁反应"},{"start":145.5,"end":152.04,"text":"直接导致了嗯很多关键性的决策产生了误判"},{"start":152.04,"end":157.2,"text":"把内部矛盾理解成为了敌我矛盾"},{"start":157.6,"end":163.73,"text":"我认为苏哈托这种完全啊投靠西方势力的"},{"start":163.73,"end":164.57,"text":"这种阴权"},{"start":165.65,"end":166.89,"text":"最后还善终啊"},{"start":166.89,"end":171.869,"text":"哈哈那我们这种就是历史的旧账"},{"start":171.869,"end":173.509,"text":"没什么好算的了"},{"start":173.509,"end":179.84,"text":"而且我觉得目前不迁延到下一代吧"},{"start":180.84,"end":183.62,"text":"或者说博弈竞争的方式"},{"start":183.62,"end":189.51,"text":"已经不仅仅是那种残酷的这个白色恐怖"},{"start":191.73,"end":192.93,"text":"颠来倒去了"},{"start":192.93,"end":194.83,"text":"现在竞争的方式啊"},{"start":194.83,"end":195.91,"text":"经济发展"},{"start":195.91,"end":198.33,"text":"人民幸福啊"},{"start":198.33,"end":202.19,"text":"以及这个国际声望啊"},{"start":202.19,"end":208.59,"text":"是以这样一种柔性的温和的方式在进行着竞争"},{"start":210.12,"end":212.28,"text":"所以在这个意义上讲啊"},{"start":212.28,"end":217.26,"text":"在这个时代议会斗争的方式反而就可以了嘛"},{"start":217.26,"end":221.0,"text":"那普拉昌达他那个"},{"start":233.86,"end":236.26,"text":"那我们要说的是嗯"},{"start":237.9,"end":242.269,"text":"我们不会忘记60年前发生的事情啊"},{"start":246.68,"end":250.14,"text":"我们也会尽我们的努力"},{"start":250.14,"end":253.96,"text":"尽我们的绵薄之力"},{"start":256.079,"end":262.88,"text":"啊永远希望包括这个印尼的"},{"start":265.62,"end":267.2,"text":"数亿啊"},{"start":267.2,"end":270.14,"text":"底层无产阶群众在内的"},{"start":271.96,"end":276.6,"text":"全世界的啊底层的困苦的生活"},{"start":276.6,"end":278.82,"text":"困顿的无产阶级人民群众"},{"start":280.14,"end":282.02,"text":"可以"},{"start":282.9,"end":288.519,"text":"得到足够的支持和帮助啊"},{"start":292.259,"end":296.659,"text":"在第三世界能够立竿见影啊"},{"start":296.659,"end":301.459,"text":"见影的起到一个驱逐西方殖民势力啊"},{"start":301.459,"end":303.989,"text":"反对这个也反对啊"},{"start":303.989,"end":305.909,"text":"他的资本主义肆意增长"},{"start":307.429,"end":312.5,"text":"践踏第三世界底层老百姓的尊严"},{"start":312.5,"end":313.76,"text":"这样的事情啊"},{"start":313.76,"end":316.06,"text":"我们要反对它的发生"},{"start":322.06,"end":324.22,"text":"印尼呀他是一个"},{"start":325.7,"end":332.65,"text":"但他是一个通过这个殖民史和对殖民的反抗"},{"start":336.97,"end":344.29,"text":"嗯很快的嗯凝聚出了一个他的现代民族认同啊"},{"start":344.29,"end":349.09,"text":"他现在他的那些党都自称叫什么大印尼主义啊"},{"start":349.45,"end":349.85,"text":"啊"},{"start":349.85,"end":356.909,"text":"这种民族主义凝结核好像是被看成了是这个呃"},{"start":358.909,"end":362.71,"text":"民族独立解放运动当中嗯"},{"start":368.36,"end":373.13,"text":"啊通常比较温和的就成为一个民族复兴"},{"start":373.13,"end":377.69,"text":"那比较激进的就是变成某种大民族主义啊"},{"start":377.69,"end":379.375,"text":"大民族主义"},{"start":380.48,"end":382.52,"text":"当然这个大民族主义啊"},{"start":382.52,"end":387.04,"text":"他的这个邪恶的触角伸到东帝汶的时候"},{"start":387.04,"end":389.67,"text":"也是被狗爪子被打断了"},{"start":389.67,"end":390.85,"text":"也学乖了啊"},{"start":392.09,"end":396.35,"text":"嗯我们始终认为在这个意义上讲"},{"start":396.35,"end":396.71,"text":"呃"},{"start":396.71,"end":402.07,"text":"印尼肯定是找对了他的发展方向的啊"},{"start":402.07,"end":404.8,"text":"也算是"},{"start":406.78,"end":415.58,"text":"明白最终啊是始终是要和这个代表人类啊"},{"start":415.58,"end":417.98,"text":"最底层的苦难中的"},{"start":422.75,"end":425.21,"text":"我们国家首先打好交道"},{"start":425.21,"end":429.32,"text":"所以斯这个苏哈托的女婿"},{"start":430.92,"end":433.92,"text":"真的是相逢一笑泯恩仇啊"},{"start":435.08,"end":439.02,"text":"他当选之后是首先是来我们国家来访问的"},{"start":439.02,"end":444.169,"text":"这历史的旧账呢现在也不再翻了"},{"start":444.49,"end":446.77,"text":"呃我作为一个民间人士呢"},{"start":446.77,"end":449.63,"text":"我们略带回忆一下"},{"start":449.63,"end":452.71,"text":"所以叫做续芳待来年"},{"start":452.71,"end":457.71,"text":"这个来年那也是打开新的篇章的一年"},{"start":458.95,"end":463.18,"text":"新的花朵从里面长出来了"},{"start":463.94,"end":469.97,"text":"呃这个我们对于印尼的这个长远发展"},{"start":469.97,"end":471.55,"text":"我们是饱含期待的"},{"start":471.55,"end":473.49,"text":"因为他有好几亿"},{"start":473.49,"end":475.91,"text":"而且他的那个生育率很高啊"},{"start":475.91,"end":478.03,"text":"不停的这街道上"},{"start":478.03,"end":479.89,"text":"街面上全是学校啊"},{"start":479.89,"end":481.83,"text":"都是小小子儿哈"},{"start":481.83,"end":483.83,"text":"小朋友啊"},{"start":483.83,"end":488.0,"text":"光屁股小孩跑来跑去的额"},{"start":488.0,"end":492.07,"text":"它代表了一个第三世界啊"},{"start":492.07,"end":493.95,"text":"落后国家啊"},{"start":493.95,"end":495.41,"text":"急于发展啊"},{"start":495.41,"end":498.61,"text":"满足人民群众幸福生活需求"},{"start":498.61,"end":502.22,"text":"的一个热烈的一个景象"},{"start":502.56,"end":505.44,"text":"那么在这么一个热烈景象当中呢"},{"start":505.44,"end":506.64,"text":"你说有没有矛盾"},{"start":506.64,"end":507.9,"text":"当然会有矛盾"},{"start":507.9,"end":511.64,"text":"他啊地域广大"},{"start":511.64,"end":515.448,"text":"但是呢有很多湿地人口"},{"start":515.448,"end":518.948,"text":"然后他人口本身也很多很多啊"},{"start":518.948,"end":520.708,"text":"他的交通不便"},{"start":521.96,"end":523.919,"text":"物流也不是很便利"},{"start":523.919,"end":526.0,"text":"所有的这个外贸往来"},{"start":526.0,"end":529.84,"text":"都只能从一个两个口岸来走"},{"start":530.72,"end":533.76,"text":"他如果经济要得到一个长足的发展的话"},{"start":533.76,"end":536.32,"text":"还要摆脱西方势力"},{"start":536.32,"end":539.18,"text":"在地缘啊层面啊"},{"start":539.18,"end":542.94,"text":"对他以及这个政治层面对他进行了干涉"},{"start":543.68,"end":546.38,"text":"走上一条独立自主的一条道路"},{"start":546.38,"end":551.4,"text":"它是东盟当中最大的国家啊"},{"start":551.53,"end":557.51,"text":"也是能够选出一位曾经选出这个女性啊"},{"start":557.51,"end":563.59,"text":"这个这个总统的一个穆斯林国家"},{"start":563.59,"end":569.089,"text":"那其实呢他的这个社会从意识形态上来讲呢"},{"start":569.089,"end":571.029,"text":"其实还是比较开明的啊"},{"start":571.029,"end":572.76,"text":"比较包容的"},{"start":572.76,"end":578.42,"text":"他曾经走过的历史的那些歪路错路啊"},{"start":578.42,"end":582.64,"text":"我希望大家要相信"},{"start":582.64,"end":587.12,"text":"但是也是要确保他不再走上那样的错路"},{"start":588.29,"end":590.47,"text":"然后对于我们自己来讲呢"},{"start":595.62,"end":601.769,"text":"他的一些他完全是被这个啊完全是被冤杀了"},{"start":601.769,"end":603.009,"text":"实事求是讲啊"},{"start":603.009,"end":607.52,"text":"因为当时的这个他本身事实上已经执政了啊"},{"start":607.52,"end":609.78,"text":"然后他的总统也是所谓的"},{"start":612.12,"end":614.37,"text":"基本上都放权了啊"},{"start":614.37,"end":616.53,"text":"这个事情是啊"},{"start":616.53,"end":619.58,"text":"有部分史家说是就是"},{"start":622.09,"end":623.77,"text":"西方指使的"},{"start":633.63,"end":635.96,"text":"加以大规模镇压"},{"start":636.08,"end":640.68,"text":"同时迎合他的一些啊民族主义情绪"},{"start":642.44,"end":646.13,"text":"当时对待这个哎呀"},{"start":646.13,"end":647.73,"text":"这个都讲太多了"},{"start":647.73,"end":649.33,"text":"不想讲了啊"},{"start":649.33,"end":653.55,"text":"始终要意识到就是西方敌人啊"},{"start":653.55,"end":656.85,"text":"他所煽起的白色恐怖啊"},{"start":656.85,"end":658.91,"text":"它实际上是不择手段的"},{"start":658.91,"end":662.27,"text":"他对于一个政治实体当中的所有人口"},{"start":662.27,"end":667.27,"text":"以及这个政治实体所捆绑的这个主体民族人口"},{"start":667.27,"end":669.55,"text":"他们是没有任何的联名的"},{"start":669.55,"end":673.12,"text":"没有任何的联名的啊"},{"start":673.12,"end":676.91,"text":"一个强大的强而有力的这个祖国啊"},{"start":676.91,"end":683.35,"text":"才能够确保这个世界各地的这个华人"},{"start":684.11,"end":686.87,"text":"不受到这样的肆意的侵害啊"},{"start":688.23,"end":693.36,"text":"所以75周年啊是建交的这个年份啊"},{"start":693.36,"end":694.64,"text":"固然要纪念"},{"start":694.64,"end":696.28,"text":"我觉得我们更重要的"},{"start":696.28,"end":699.06,"text":"还是不要忘记这个60周年啊"},{"start":699.06,"end":705.89,"text":"这个60周年它所包含的历史的这个辛酸啊"},{"start":705.89,"end":707.75,"text":"屈辱啊"},{"start":707.75,"end":710.13,"text":"以及这个悲愤"},{"start":716.39,"end":718.45,"text":"一刻也不能遗忘"},{"start":719.53,"end":720.01,"text":"啊"},{"start":720.01,"end":724.5,"text":"当然现实有现实的这个合作和这个博弈的策略"},{"start":724.5,"end":727.54,"text":"但是理想信念是永远不能磨灭的"},{"start":727.54,"end":729.74,"text":"理想信念的追求"},{"start":729.74,"end":733.73,"text":"也是需要用现实的行动来支持的啊"},{"start":733.73,"end":736.23,"text":"所以呃"},{"start":737.36,"end":738.92,"text":"这是我们的观点啊"},{"start":738.92,"end":739.92,"text":"这是我们的观点"},{"start":739.92,"end":744.59,"text":"印尼是一个呃蓬勃发展的一个市场"},{"start":744.59,"end":746.79,"text":"他的人口出生率啊"},{"start":746.79,"end":750.875,"text":"就好多这个青壮年的比例都很高啊"},{"start":751.29,"end":752.81,"text":"他是大有可为的"},{"start":752.81,"end":756.35,"text":"但是他也有一些内部的一些固有的一些矛盾啊"},{"start":756.35,"end":757.66,"text":"以阶级矛盾"},{"start":757.66,"end":759.02,"text":"而且还是被美资"},{"start":759.02,"end":764.17,"text":"日资还这个欧洲资本是啊很严重的被控制着的"},{"start":764.17,"end":767.47,"text":"然后他国内的很多这个产出的资源矿"},{"start":767.47,"end":770.11,"text":"矿藏和这个农产品啊"},{"start":770.11,"end":774.26,"text":"也很大部分是被这个西方资本给掠夺走的啊"},{"start":774.26,"end":775.38,"text":"他的失地农民啊"},{"start":775.38,"end":776.36,"text":"失业工人啊"},{"start":776.36,"end":778.99,"text":"这个人数是不少的"},{"start":778.99,"end":783.97,"text":"那么它有很多这个人口是在全世界对外输出"},{"start":783.97,"end":787.23,"text":"去进行跨国劳务的"},{"start":788.07,"end":789.67,"text":"因为他的人口是很多的呀"},{"start":789.67,"end":791.15,"text":"他有好几亿人啊"},{"start":791.15,"end":794.17,"text":"那么总体来讲嗯"},{"start":797.37,"end":800.17,"text":"但是目前来讲的话"},{"start":801.5,"end":807.34,"text":"啊目前来讲这个还是任重而道远的啊"},{"start":807.34,"end":809.18,"text":"任重而道远的"},{"start":809.18,"end":811.78,"text":"这是非常可惜的啊"},{"start":811.78,"end":812.96,"text":"非常可惜的"},{"start":812.96,"end":817.61,"text":"当年的这个全世界第三大啊"},{"start":821.969,"end":823.989,"text":"是非常令人惋惜的"},{"start":823.989,"end":827.64,"text":"所以我们有哈哈"},{"start":827.64,"end":829.4,"text":"所以更多的我就不能直接说了哈"},{"start":829.4,"end":830.28,"text":"那就讲到这里啊"},{"start":830.28,"end":831.4,"text":"goodbye拜拜"}],"source":"subtitle"}
