    {
      "ordinal": 239,
      "start_ms": 598080,
      "end_ms": 601080,
      "text": "看明白啊"
    },
    {
      "ordinal": 240,
      "start_ms": 601080,
      "end_ms": 602500,
      "text": "那你实在不交"
    },
