    {
      "ordinal": 302,
      "start_ms": 745650,
      "end_ms": 747780,
      "text": "用完了就丢弃"
    },
    {
      "ordinal": 303,
      "start_ms": 747780,
      "end_ms": 750380,
      "text": "把代价成本甩到别人身上的这种态度"
    },
    {
      "ordinal": 304,
      "start_ms": 750380,
      "end_ms": 751620,
      "text": "结合起来考量"
