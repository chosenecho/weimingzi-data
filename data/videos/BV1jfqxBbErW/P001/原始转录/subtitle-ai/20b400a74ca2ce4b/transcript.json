    {
      "ordinal": 189,
      "start_ms": 497130,
      "end_ms": 498780,
      "text": "你实在没钱"
    },
    {
      "ordinal": 190,
      "start_ms": 498780,
      "end_ms": 499840,
      "text": "那我们可以体谅"
