      "start_ms": 524440,
      "end_ms": 526360,
      "text": "我假装自己是个道德圣人的事"
    },
    {
      "ordinal": 206,
      "start_ms": 526360,
      "end_ms": 527860,
      "text": "这个不是我们要的"
