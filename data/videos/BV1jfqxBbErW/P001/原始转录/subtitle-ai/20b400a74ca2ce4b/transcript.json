      "ordinal": 241,
      "start_ms": 602500,
      "end_ms": 603980,
      "text": "我也不会很失望"
    },
    {
      "ordinal": 242,
      "start_ms": 603980,
      "end_ms": 605480,
      "text": "那你顶多goodbye了啊"
    },
    {
      "ordinal": 243,
      "start_ms": 605480,
