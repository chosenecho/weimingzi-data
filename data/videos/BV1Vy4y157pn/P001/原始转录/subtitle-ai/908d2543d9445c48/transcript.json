    {
      "ordinal": 140,
      "start_ms": 681260,
      "end_ms": 682760,
      "text": "反正他自己也删掉了呀"
    },
    {
      "ordinal": 141,
      "start_ms": 682760,
      "end_ms": 684740,
      "text": "然后至少张代树是清白的"
    },
    {
      "ordinal": 142,
      "start_ms": 684740,
      "end_ms": 685760,
      "text": "刚好"
    },
    {
      "ordinal": 143,
      "start_ms": 689300,
      "end_ms": 691700,
      "text": "张载树至少这里是清白的"
    },
    {
      "ordinal": 144,
      "start_ms": 691700,
      "end_ms": 692180,
      "text": "没有恶俗"
    },
    {
      "ordinal": 145,
      "start_ms": 692180,
      "end_ms": 693950,
      "text": "他这一点要弄清楚啊"
    },
    {
      "ordinal": 146,
      "start_ms": 693950,
      "end_ms": 696860,
      "text": "他自己里面说说他张代处在商量"
    },
    {
      "ordinal": 147,
      "start_ms": 696860,
      "end_ms": 699170,
      "text": "要要要要饿死他"
    },
    {
      "ordinal": 148,
      "start_ms": 699170,
      "end_ms": 702719,
      "text": "这一点要确定自己不是他删的"
    },
    {
      "ordinal": 149,
      "start_ms": 714260,
      "end_ms": 715930,
      "text": "还有我要确定一点"
    },
    {
      "ordinal": 150,
      "start_ms": 715930,
      "end_ms": 718920,
      "text": "还有我要确确认一下"
    },
    {
      "ordinal": 151,
      "start_ms": 718940,
      "end_ms": 721040,
      "text": "就是还就那句话"
    },
    {
      "ordinal": 152,
      "start_ms": 721040,
      "end_ms": 723560,
      "text": "就很就是非常直接的那句话"
    },
    {
      "ordinal": 153,
      "start_ms": 724580,
      "end_ms": 726660,
      "text": "就是这个"
    },
    {
      "ordinal": 154,
      "start_ms": 729960,
      "end_ms": 730620,
      "text": "因为"
    },
    {
      "ordinal": 155,
      "start_ms": 734640,
      "end_ms": 736140,
      "text": "非常直接的一句话"
    },
    {
      "ordinal": 156,
      "start_ms": 737160,
      "end_ms": 738829,
      "text": "最新发布"
    },
    {
      "ordinal": 157,
      "start_ms": 743960,
      "end_ms": 748580,
      "text": "嘶就是说滑坡什么的"
    },
    {
      "ordinal": 158,
      "start_ms": 748580,
      "end_ms": 760350,
      "text": "滑坡的那个滑坡的那个还有嗯"
    },
    {
      "ordinal": 159,
      "start_ms": 762270,
      "end_ms": 763410,
      "text": "总之他没有删"
    },
    {
      "ordinal": 160,
      "start_ms": 763410,
      "end_ms": 765330,
      "text": "要啊好"
    },
    {
      "ordinal": 161,
      "start_ms": 765330,
      "end_ms": 765990,
      "text": "那你澄清了"
    },
    {
      "ordinal": 162,
      "start_ms": 765990,
      "end_ms": 767070,
      "text": "反正他已经没了啊"
    },
    {
      "ordinal": 163,
      "start_ms": 767070,
      "end_ms": 770070,
      "text": "反反反正已经也没了啊"
    },
    {
      "ordinal": 164,
      "start_ms": 770070,
      "end_ms": 771360,
      "text": "发现已经没了狗子"
    },
    {
      "ordinal": 165,
      "start_ms": 771360,
      "end_ms": 772860,
      "text": "他没有杀我"
    },
    {
      "ordinal": 166,
      "start_ms": 772860,
      "end_ms": 773520,
      "text": "就是想知道"
    },
    {
      "ordinal": 167,
      "start_ms": 773520,
      "end_ms": 774230,
      "text": "就是说"
    },
    {
      "ordinal": 168,
      "start_ms": 780820,
      "end_ms": 782730,
      "text": "还有这个第二外语的事情"
    },
    {
      "ordinal": 169,
      "start_ms": 782730,
      "end_ms": 785040,
      "text": "就是"
    },
    {
      "ordinal": 170,
      "start_ms": 786840,
      "end_ms": 790940,
      "text": "说学哲学的第二外语都掌握不了"
    },
    {
      "ordinal": 171,
      "start_ms": 790940,
      "end_ms": 791900,
      "text": "是真的弱"
    },
    {
      "ordinal": 172,
      "start_ms": 791900,
      "end_ms": 793740,
      "text": "我觉得非常搞笑"
    },
    {
      "ordinal": 173,
      "start_ms": 814240,
      "end_ms": 820420,
      "text": "我就还有这这句话的大部分呃"
    },
    {
      "ordinal": 174,
      "start_ms": 820420,
      "end_ms": 827640,
      "text": "哲学爱好者和使用哲学来指导"
    },
    {
      "ordinal": 175,
      "start_ms": 828640,
      "end_ms": 834020,
      "text": "面对生活的普通人"
    },
    {
      "ordinal": 176,
      "start_ms": 834320,
      "end_ms": 842430,
      "text": "是没有特别多的教育资源来实现"
    },
    {
      "ordinal": 177,
      "start_ms": 842430,
      "end_ms": 845900,
      "text": "来来来学习第二外语的"
    },
    {
      "ordinal": 178,
      "start_ms": 846980,
      "end_ms": 857360,
      "text": "但是他们还是可以凭借一本或者比较局促的英"
    },
    {
      "ordinal": 179,
      "start_ms": 857360,
      "end_ms": 864680,
      "text": "语来实现准一手文本的理解"
    },
    {
      "ordinal": 180,
      "start_ms": 864680,
      "end_ms": 869829,
      "text": "切入哲学的深层次的问题"
    },
    {
      "ordinal": 181,
      "start_ms": 869829,
      "end_ms": 878319,
      "text": "他们的问题意识和学术界问题意识是平等的"
    },
    {
      "ordinal": 182,
      "start_ms": 879240,
      "end_ms": 882410,
      "text": "都是本真的"
    },
    {
      "ordinal": 183,
      "start_ms": 882410,
      "end_ms": 883500,
      "text": "这一点"
    },
    {
      "ordinal": 184,
      "start_ms": 885260,
      "end_ms": 894140,
      "text": "我觉得没有什么强弱固定的强弱标准可以设定"
    },
    {
      "ordinal": 185,
      "start_ms": 895460,
      "end_ms": 899160,
      "text": "也没有非常搞笑"
    },
    {
      "ordinal": 186,
      "start_ms": 900800,
      "end_ms": 902640,
      "text": "我要说清楚这一点"
    },
    {
      "ordinal": 187,
      "start_ms": 904700,
      "end_ms": 908140,
      "text": "我个人觉得其实没什么"
    },
    {
      "ordinal": 188,
      "start_ms": 908140,
      "end_ms": 911860,
      "text": "我要说的就是他他是在手机上"
    },
    {
      "ordinal": 189,
      "start_ms": 911860,
      "end_ms": 913570,
      "text": "手机上可以慢慢手机"
    },
    {
      "ordinal": 190,
      "start_ms": 913570,
      "end_ms": 920979,
      "text": "手机上慢的话可以发语音转"
    },
    {
      "ordinal": 191,
      "start_ms": 925360,
      "end_ms": 926440,
      "text": "啊"
    },
    {
      "ordinal": 192,
      "start_ms": 930100,
      "end_ms": 931540,
      "text": "你说的很对"
    },
    {
      "ordinal": 193,
      "start_ms": 931700,
      "end_ms": 932960,
      "text": "说的很对呀"
    },
    {
      "ordinal": 194,
      "start_ms": 932960,
      "end_ms": 934460,
      "text": "改变成我说的很对呀"
    },
    {
      "ordinal": 195,
      "start_ms": 934460,
      "end_ms": 935600,
      "text": "我醉了"
    },
    {
      "ordinal": 196,
      "start_ms": 937220,
      "end_ms": 937580,
      "text": "I'm"
    },
    {
      "ordinal": 197,
      "start_ms": 937580,
      "end_ms": 939560,
      "text": "I'm a great"
    },
    {
      "ordinal": 198,
      "start_ms": 943720,
      "end_ms": 945780,
      "text": "还有"
    },
    {
      "ordinal": 199,
      "start_ms": 947200,
      "end_ms": 949500,
      "text": "还有一个一个正统性的问题"
    },
    {
      "ordinal": 200,
      "start_ms": 951060,
      "end_ms": 953160,
      "text": "我身处国内"
    },
    {
      "ordinal": 201,
      "start_ms": 957000,
      "end_ms": 960500,
      "text": "我需要面对的是一个呃"
    },
    {
      "ordinal": 202,
      "start_ms": 960500,
      "end_ms": 964979,
      "text": "非常非常复杂的社会形态"
    },
    {
      "ordinal": 203,
      "start_ms": 966840,
      "end_ms": 971090,
      "text": "所以在很多方向上"
    },
    {
      "ordinal": 204,
      "start_ms": 971090,
      "end_ms": 972440,
      "text": "我必须"
    },
    {
      "ordinal": 205,
      "start_ms": 974780,
      "end_ms": 979680,
      "text": "坚持也必须妥协"
    },
    {
      "ordinal": 206,
      "start_ms": 984040,
      "end_ms": 994230,
      "text": "在普遍面对生存困境和思想焦虑"
    },
    {
      "ordinal": 207,
      "start_ms": 994230,
      "end_ms": 999699,
      "text": "乃至尤其是知识焦虑的情况下"
    },
    {
      "ordinal": 208,
      "start_ms": 1001600,
      "end_ms": 1008280,
      "text": "用先验观念论切入哲学论语"
    },
    {
      "ordinal": 209,
      "start_ms": 1010600,
      "end_ms": 1011760,
      "text": "先主理性啊"
    },
    {
      "ordinal": 210,
      "start_ms": 1011760,
      "end_ms": 1015840,
      "text": "主理性就是纯粹虚无的主体性"
    },
    {
      "ordinal": 211,
      "start_ms": 1015840,
      "end_ms": 1017160,
      "text": "切入哲学的东西"
    },
    {
      "ordinal": 212,
      "start_ms": 1017160,
      "end_ms": 1021720,
      "text": "可以比较比较良好的"
    },
    {
      "ordinal": 213,
      "start_ms": 1023040,
      "end_ms": 1030118,
      "text": "有一个很很好的翻译文库可以借鉴"
    },
    {
      "ordinal": 214,
      "start_ms": 1031520,
      "end_ms": 1035740,
      "text": "也可以接上呃"
    },
    {
      "ordinal": 215,
      "start_ms": 1035740,
      "end_ms": 1037819,
      "text": "马克思主义的"
    },
    {
      "ordinal": 216,
      "start_ms": 1041000,
      "end_ms": 1042700,
      "text": "哲学水平我非常高了"
    },
    {
      "ordinal": 217,
      "start_ms": 1042700,
      "end_ms": 1045880,
      "text": "你在复旦能够接触很好的第二外语环境"
    },
    {
      "ordinal": 218,
      "start_ms": 1045880,
      "end_ms": 1046540,
      "text": "不好意思"
    },
    {
      "ordinal": 219,
      "start_ms": 1046540,
      "end_ms": 1048920,
      "text": "我们复旦没有特别好的第二外语环境"
    },
    {
      "ordinal": 220,
      "start_ms": 1048920,
      "end_ms": 1052480,
      "text": "复旦人学德语要跑到同济去学"
    },
    {
      "ordinal": 221,
      "start_ms": 1053640,
      "end_ms": 1056060,
      "text": "没时间再强调表"
    },
    {
      "ordinal": 222,
      "start_ms": 1057820,
      "end_ms": 1063139,
      "text": "没时间也可以接上马克思的正统哲学"
    },
    {
      "ordinal": 223,
      "start_ms": 1063720,
      "end_ms": 1065740,
      "text": "加以继承和利用"
    },
    {
      "ordinal": 224,
      "start_ms": 1069280,
      "end_ms": 1075320,
      "text": "更可以直接导向生存论面"
    },
    {
      "ordinal": 225,
      "start_ms": 1076400,
      "end_ms": 1078879,
      "text": "还有的经济政治学"
    },
    {
      "ordinal": 226,
      "start_ms": 1086700,
      "end_ms": 1092180,
      "text": "本体论存在论生存"
    },
    {
      "ordinal": 227,
      "start_ms": 1094120,
      "end_ms": 1095460,
      "text": "速度金"
    },
    {
      "ordinal": 228,
      "start_ms": 1095460,
      "end_ms": 1097860,
      "text": "还有政治经济学啊"
    },
    {
      "ordinal": 229,
      "start_ms": 1097860,
      "end_ms": 1100060,
      "text": "就是政治经济学"
    },
    {
      "ordinal": 230,
      "start_ms": 1101920,
      "end_ms": 1103580,
      "text": "叫什么名字啊"
    },
    {
      "ordinal": 231,
      "start_ms": 1104440,
      "end_ms": 1108639,
      "text": "这暴雪验证法准备"
    },
    {
      "ordinal": 232,
      "start_ms": 1109620,
      "end_ms": 1116840,
      "text": "所以我采取一套自封为当然是自封为"
    },
    {
      "ordinal": 233,
      "start_ms": 1117560,
      "end_ms": 1123220,
      "text": "正统的哲学学习计划"
    },
    {
      "ordinal": 234,
      "start_ms": 1126100,
      "end_ms": 1129720,
      "text": "这是经过深远的考虑的"
    },
    {
      "ordinal": 235,
      "start_ms": 1136540,
      "end_ms": 1145460,
      "text": "并不代表这种正统线是我们左翼团结"
    },
    {
      "ordinal": 236,
      "start_ms": 1145460,
      "end_ms": 1148700,
      "text": "左翼爱好者爱好者"
    },
    {
      "ordinal": 237,
      "start_ms": 1151440,
      "end_ms": 1153500,
      "text": "是我为左"
    },
    {
      "ordinal": 238,
      "start_ms": 1153500,
      "end_ms": 1158590,
      "text": "然后这探索的一条成长为理论家"
    },
    {
      "ordinal": 239,
      "start_ms": 1158590,
      "end_ms": 1161470,
      "text": "社会批判观察家"
    },
    {
      "ordinal": 240,
      "start_ms": 1161470,
      "end_ms": 1163379,
      "text": "观察批判家了好吧"
    },
    {
      "ordinal": 241,
      "start_ms": 1165020,
      "end_ms": 1168340,
      "text": "的独到路径"
    },
    {
      "ordinal": 242,
      "start_ms": 1170720,
      "end_ms": 1176000,
      "text": "我的正统性还不是学术性"
    },
    {
      "ordinal": 243,
      "start_ms": 1177440,
      "end_ms": 1179399,
      "text": "而是生活性"
    },
    {
      "ordinal": 244,
      "start_ms": 1180980,
      "end_ms": 1182740,
      "text": "所以我并不是"
    },
    {
      "ordinal": 245,
      "start_ms": 1182740,
      "end_ms": 1191980,
      "text": "并不是盲目遵循权威架构的前现代人格"
    },
    {
      "ordinal": 246,
      "start_ms": 1192200,
      "end_ms": 1195320,
      "text": "这点你同意吧"
    },
    {
      "ordinal": 247,
      "start_ms": 1203780,
      "end_ms": 1206900,
      "text": "我哲学水平不高"
    },
    {
      "ordinal": 248,
      "start_ms": 1206900,
      "end_ms": 1210590,
      "text": "我哲学哲学水平水平水平不高"
    },
    {
      "ordinal": 249,
      "start_ms": 1210590,
      "end_ms": 1211620,
      "text": "很一般"
    },
    {
      "ordinal": 250,
      "start_ms": 1213300,
      "end_ms": 1215919,
      "text": "我的朋友比我强的多得多"
    },
    {
      "ordinal": 251,
      "start_ms": 1234220,
      "end_ms": 1237040,
      "text": "好"
    },
    {
      "ordinal": 252,
      "start_ms": 1240100,
      "end_ms": 1241480,
      "text": "的那我"
    },
    {
      "ordinal": 253,
      "start_ms": 1243520,
      "end_ms": 1249960,
      "text": "厉害我也不是个后现代人"
    },
    {
      "ordinal": 254,
      "start_ms": 1249960,
      "end_ms": 1251320,
      "text": "我要强调"
    },
    {
      "ordinal": 255,
      "start_ms": 1256180,
      "end_ms": 1266400,
      "text": "我的立场永远是以经典马克思主义的社会啊"
    },
    {
      "ordinal": 256,
      "start_ms": 1266400,
      "end_ms": 1270399,
      "text": "就是唯物辩证法"
    },
    {
      "ordinal": 257,
      "start_ms": 1275520,
      "end_ms": 1279800,
      "text": "机器哎呀机器机器正统"
    },
    {
      "ordinal": 258,
      "start_ms": 1294500,
      "end_ms": 1302480,
      "text": "所以后现代的啊差异主义啊"
    },
    {
      "ordinal": 259,
      "start_ms": 1303920,
      "end_ms": 1306290,
      "text": "还有那个后结构主义"
    },
    {
      "ordinal": 260,
      "start_ms": 1306290,
      "end_ms": 1307960,
      "text": "结构主义"
    },
    {
      "ordinal": 261,
      "start_ms": 1311320,
      "end_ms": 1320640,
      "text": "乃至绝大部分的批判实在论"
    },
    {
      "ordinal": 262,
      "start_ms": 1324200,
      "end_ms": 1327480,
      "text": "都不是"
    },
    {
      "ordinal": 263,
      "start_ms": 1329140,
      "end_ms": 1332640,
      "text": "我要记下"
    },
    {
      "ordinal": 264,
      "start_ms": 1335340,
      "end_ms": 1339320,
      "text": "德勒兹瓜塔里"
    },
    {
      "ordinal": 265,
      "start_ms": 1342460,
      "end_ms": 1343740,
      "text": "我都记不得名字"
    },
    {
      "ordinal": 266,
      "start_ms": 1343740,
      "end_ms": 1347340,
      "text": "德勒兹德里达晚期"
    },
    {
      "ordinal": 267,
      "start_ms": 1347340,
      "end_ms": 1353500,
      "text": "德里达等人的论语都不是我"
    },
    {
      "ordinal": 268,
      "start_ms": 1354620,
      "end_ms": 1360600,
      "text": "我本人也是一个激进的现代主义者"
    },
    {
      "ordinal": 269,
      "start_ms": 1362040,
      "end_ms": 1365560,
      "text": "我的目的就是推进"
    },
    {
      "ordinal": 270,
      "start_ms": 1367120,
      "end_ms": 1369780,
      "text": "社会话语的现代化"
    },
    {
      "ordinal": 271,
      "start_ms": 1372700,
      "end_ms": 1385139,
      "text": "却要避免陷入一种新自由主义的虚假包容和"
    },
    {
      "ordinal": 272,
      "start_ms": 1392920,
      "end_ms": 1397300,
      "text": "啊那应该是这不是可笑的"
    },
    {
      "ordinal": 273,
      "start_ms": 1397300,
      "end_ms": 1398200,
      "text": "不是太弱的"
    },
    {
      "ordinal": 274,
      "start_ms": 1399220,
      "end_ms": 1402310,
      "text": "如果你的轮次吧"
    },
    {
      "ordinal": 275,
      "start_ms": 1409720,
      "end_ms": 1411240,
      "text": "后现代的差异"
    },
    {
      "ordinal": 276,
      "start_ms": 1411240,
      "end_ms": 1412980,
      "text": "所以就"
    },
    {
      "ordinal": 277,
      "start_ms": 1419880,
      "end_ms": 1421190,
      "text": "啊没错"
    },
    {
      "ordinal": 278,
      "start_ms": 1421190,
      "end_ms": 1426370,
      "text": "我确实没有时间学二外"
    },
    {
      "ordinal": 279,
      "start_ms": 1426370,
      "end_ms": 1434159,
      "text": "我今天呃那个猫头鹰上面的20分钟德语"
    },
    {
      "ordinal": 280,
      "start_ms": 1436640,
      "end_ms": 1438910,
      "text": "There for one"
    },
    {
      "ordinal": 281,
      "start_ms": 1438910,
      "end_ms": 1441820,
      "text": "都来不及去"
    },
    {
      "ordinal": 282,
      "start_ms": 1443180,
      "end_ms": 1444200,
      "text": "生存随机"
    },
    {
      "ordinal": 283,
      "start_ms": 1459860,
      "end_ms": 1462460,
      "text": "你们要理解这已经是战斗了"
    },
    {
      "ordinal": 284,
      "start_ms": 1466620,
      "end_ms": 1472480,
      "text": "You just don t know this is already fighting"
    },
    {
      "ordinal": 285,
      "start_ms": 1480360,
      "end_ms": 1484800,
      "text": "好了"
    },
    {
      "ordinal": 286,
      "start_ms": 1488420,
      "end_ms": 1493780,
      "text": "哲学方面的开销啊"
    },
    {
      "ordinal": 287,
      "start_ms": 1493780,
      "end_ms": 1498940,
      "text": "哲学方面的近况我确实不了解"
    },
    {
      "ordinal": 288,
      "start_ms": 1498940,
      "end_ms": 1508600,
      "text": "很多是从我那三四个朋友那里了解的"
    },
    {
      "ordinal": 289,
      "start_ms": 1509120,
      "end_ms": 1519040,
      "text": "我很多话是说给一些对哲学抱有乌托邦幻想的"
    },
    {
      "ordinal": 290,
      "start_ms": 1519040,
      "end_ms": 1519940,
      "text": "小朋友"
    },
    {
      "ordinal": 291,
      "start_ms": 1530100,
      "end_ms": 1533139,
      "text": "个人有个人的活法"
    },
    {
      "ordinal": 292,
      "start_ms": 1536800,
      "end_ms": 1538600,
      "text": "我是一个"
    },
    {
      "ordinal": 293,
      "start_ms": 1540480,
      "end_ms": 1548520,
      "text": "为了局部的影响无不及啊"
    },
    {
      "ordinal": 294,
      "start_ms": 1550100,
      "end_ms": 1552910,
      "text": "整体的活动的人"
    },
    {
      "ordinal": 295,
      "start_ms": 1552910,
      "end_ms": 1556480,
      "text": "这点上我确实"
    },
    {
      "ordinal": 296,
      "start_ms": 1558640,
      "end_ms": 1561680,
      "text": "啊叫做什么"
    },
    {
      "ordinal": 297,
      "start_ms": 1562940,
      "end_ms": 1571460,
      "text": "刻意夸大了在日生活的某些方面"
    },
    {
      "ordinal": 298,
      "start_ms": 1573280,
      "end_ms": 1576300,
      "text": "And understand you have to know"
    },
    {
      "ordinal": 299,
      "start_ms": 1582660,
      "end_ms": 1587520,
      "text": "但是据我所知嗯"
    },
    {
      "ordinal": 300,
      "start_ms": 1587520,
      "end_ms": 1589290,
      "text": "青年哲学"
    },
    {
      "ordinal": 301,
      "start_ms": 1589290,
      "end_ms": 1596250,
      "text": "青年学者的生存确实始终是一个大问题"
    },
    {
      "ordinal": 302,
      "start_ms": 1596250,
      "end_ms": 1603680,
      "text": "如何在学术建制之外寻找"
    },
    {
      "ordinal": 303,
      "start_ms": 1612260,
      "end_ms": 1616030,
      "text": "关注的焦点就是怎么赚钱的"
    },
    {
      "ordinal": 304,
      "start_ms": 1616030,
      "end_ms": 1617740,
      "text": "赚钱的是吧"
    },
    {
      "ordinal": 305,
      "start_ms": 1620100,
      "end_ms": 1621620,
      "text": "小布尔乔亚好的"
    },
    {
      "ordinal": 306,
      "start_ms": 1621620,
      "end_ms": 1622370,
      "text": "我明白"
    },
    {
      "ordinal": 307,
      "start_ms": 1622370,
      "end_ms": 1624580,
      "text": "小布尔乔亚"
    },
    {
      "ordinal": 308,
      "start_ms": 1630140,
      "end_ms": 1631980,
      "text": "小布尔乔亚"
    },
    {
      "ordinal": 309,
      "start_ms": 1634120,
      "end_ms": 1641360,
      "text": "更多的是对一种文化和意识形态的批判"
    },
    {
      "ordinal": 310,
      "start_ms": 1641360,
      "end_ms": 1644540,
      "text": "在国家的根本性质上"
    },
    {
      "ordinal": 311,
      "start_ms": 1645100,
      "end_ms": 1651700,
      "text": "我们每个人都是人民的部分"
    },
    {
      "ordinal": 312,
      "start_ms": 1651700,
      "end_ms": 1657040,
      "text": "不会因为身居国外"
    },
    {
      "ordinal": 313,
      "start_ms": 1657900,
      "end_ms": 1661580,
      "text": "国内受什么教育"
    },
    {
      "ordinal": 314,
      "start_ms": 1662900,
      "end_ms": 1667240,
      "text": "如何得到供养而被改变"
    },
    {
      "ordinal": 315,
      "start_ms": 1668000,
      "end_ms": 1670940,
      "text": "所以在这个意义上"
    },
    {
      "ordinal": 316,
      "start_ms": 1671480,
      "end_ms": 1672640,
      "text": "你能够"
    },
    {
      "ordinal": 317,
      "start_ms": 1674920,
      "end_ms": 1682500,
      "text": "承认你户口门一样都是普通的学习者"
    },
    {
      "ordinal": 318,
      "start_ms": 1683120,
      "end_ms": 1684639,
      "text": "劳动者"
    },
    {
      "ordinal": 319,
      "start_ms": 1685400,
      "end_ms": 1686770,
      "text": "发展者"
    },
    {
      "ordinal": 320,
      "start_ms": 1686770,
      "end_ms": 1691570,
      "text": "国家发展的建设者的角色"
    },
    {
      "ordinal": 321,
      "start_ms": 1691570,
      "end_ms": 1695960,
      "text": "那么我们就属于一个共同体"
    },
    {
      "ordinal": 322,
      "start_ms": 1697220,
      "end_ms": 1698200,
      "text": "反过来"
    },
    {
      "ordinal": 323,
      "start_ms": 1700880,
      "end_ms": 1706520,
      "text": "如果以某种人为设立"
    },
    {
      "ordinal": 324,
      "start_ms": 1708640,
      "end_ms": 1710070,
      "text": "的秩序"
    },
    {
      "ordinal": 325,
      "start_ms": 1710070,
      "end_ms": 1716960,
      "text": "某种域外的价值观或者某种自视"
    },
    {
      "ordinal": 326,
      "start_ms": 1719900,
      "end_ms": 1727780,
      "text": "为股市的说词体系就"
    },
    {
      "ordinal": 327,
      "start_ms": 1730940,
      "end_ms": 1733900,
      "text": "假设我们这里"
    },
    {
      "ordinal": 328,
      "start_ms": 1733900,
      "end_ms": 1737000,
      "text": "我们这些一无"
    },
    {
      "ordinal": 329,
      "start_ms": 1744740,
      "end_ms": 1749200,
      "text": "平时是战士这个词我都不会写"
    },
    {
      "ordinal": 330,
      "start_ms": 1785300,
      "end_ms": 1786430,
      "text": "爱国"
    },
    {
      "ordinal": 331,
      "start_ms": 1793820,
      "end_ms": 1797060,
      "text": "我想在这点上"
    },
    {
      "ordinal": 332,
      "start_ms": 1798960,
      "end_ms": 1802640,
      "text": "达成的损失"
    },
    {
      "ordinal": 333,
      "start_ms": 1810360,
      "end_ms": 1812600,
      "text": "右边小剧场"
    },
    {
      "ordinal": 334,
      "start_ms": 1825539,
      "end_ms": 1828199,
      "text": "主旋律是我们要守的阵线"
    },
    {
      "ordinal": 335,
      "start_ms": 1829339,
      "end_ms": 1833600,
      "text": "朋友们有的主旋律虽然它是主旋律"
    },
    {
      "ordinal": 336,
      "start_ms": 1833600,
      "end_ms": 1835520,
      "text": "是某种说辞"
    },
    {
      "ordinal": 337,
      "start_ms": 1835520,
      "end_ms": 1839380,
      "text": "但是但凡他在话语空间里面出现的话"
    },
    {
      "ordinal": 338,
      "start_ms": 1839380,
      "end_ms": 1842800,
      "text": "它就是我们要值守的一个阵地"
    },
    {
      "ordinal": 339,
      "start_ms": 1848280,
      "end_ms": 1850160,
      "text": "好吧"
    },
    {
      "ordinal": 340,
      "start_ms": 1852140,
      "end_ms": 1853480,
      "text": "我的话已经说完了"
    },
    {
      "ordinal": 341,
      "start_ms": 1853480,
      "end_ms": 1855520,
      "text": "我不是一个什么"
    },
    {
      "ordinal": 342,
      "start_ms": 1855520,
      "end_ms": 1859490,
      "text": "至少我不是一个后现代"
    },
    {
      "ordinal": 343,
      "start_ms": 1859490,
      "end_ms": 1862160,
      "text": "披着后现代皮的前现代人啊"
    },
    {
      "ordinal": 344,
      "start_ms": 1863360,
      "end_ms": 1865940,
      "text": "Alex i am not"
    },
    {
      "ordinal": 345,
      "start_ms": 1867359,
      "end_ms": 1869299,
      "text": "好的"
    },
    {
      "ordinal": 346,
      "start_ms": 1886620,
      "end_ms": 1889280,
      "text": "你们来得及拷贝吗"
    },
    {
      "ordinal": 347,
      "start_ms": 1892580,
      "end_ms": 1894380,
      "text": "等等等等"
    },
    {
      "ordinal": 348,
      "start_ms": 1894380,
      "end_ms": 1899850,
      "text": "噔噔噔噔噔"
    },
    {
      "ordinal": 349,
      "start_ms": 1907340,
      "end_ms": 1910000,
      "text": "I don't care about"
    },
    {
      "ordinal": 350,
      "start_ms": 2021300,
      "end_ms": 2023600,
      "text": "我认识的人我会称他为同志"
    },
    {
      "ordinal": 351,
      "start_ms": 2023600,
      "end_ms": 2026120,
      "text": "我不会叫他朋友好了"
    },
    {
      "ordinal": 352,
      "start_ms": 2026120,
      "end_ms": 2029180,
      "text": "至少朋友也是最低限度的认同"
    },
    {
      "ordinal": 353,
      "start_ms": 2030530,
      "end_ms": 2031390,
      "text": "I care"
    },
    {
      "ordinal": 354,
      "start_ms": 2031390,
      "end_ms": 2033550,
      "text": "I don t care about it"
    },
    {
      "ordinal": 355,
      "start_ms": 2061520,
      "end_ms": 2067520,
      "text": "反正就没证据这事结果吧"
    },
    {
      "ordinal": 356,
      "start_ms": 2069918,
      "end_ms": 2073920,
      "text": "然后在群里和一帮一帮拱火小"
    },
    {
      "ordinal": 357,
      "start_ms": 2077018,
      "end_ms": 2080498,
      "text": "废话头有多少"
    },
    {
      "ordinal": 358,
      "start_ms": 2080498,
      "end_ms": 2091360,
      "text": "不知道不知道多少双眼睛盯着这个"
    },
    {
      "ordinal": 359,
      "start_ms": 2094739,
      "end_ms": 2096018,
      "text": "徐泽是谁"
    },
    {
      "ordinal": 360,
      "start_ms": 2096018,
      "end_ms": 2097399,
      "text": "我都不知道是徐泽"
    },
    {
      "ordinal": 361,
      "start_ms": 2097399,
      "end_ms": 2099280,
      "text": "徐YJ是谁"
    },
    {
      "ordinal": 362,
      "start_ms": 2105460,
      "end_ms": 2113479,
      "text": "如果如果有粉丝发发私信骚扰你"
    },
    {
      "ordinal": 363,
      "start_ms": 2113479,
      "end_ms": 2116299,
      "text": "你可以截图截图给我"
    },
    {
      "ordinal": 364,
      "start_ms": 2116299,
      "end_ms": 2118420,
      "text": "我会急了呀"
    },
    {
      "ordinal": 365,
      "start_ms": 2121800,
      "end_ms": 2123380,
      "text": "你就可以的到30万粉"
    },
    {
      "ordinal": 366,
      "start_ms": 2123380,
      "end_ms": 2124940,
      "text": "那你赶紧去撤回啊"
    },
    {
      "ordinal": 367,
      "start_ms": 2124940,
      "end_ms": 2126500,
      "text": "撤回还来得及吧"
    },
    {
      "ordinal": 368,
      "start_ms": 2126500,
      "end_ms": 2130100,
      "text": "当然看着这个视频道歉了就算了"
    },
    {
      "ordinal": 369,
      "start_ms": 2133340,
      "end_ms": 2135220,
      "text": "哎呀算了算了算了算了"
    },
    {
      "ordinal": 370,
      "start_ms": 2136680,
      "end_ms": 2138270,
      "text": "早点早点早点修"
    },
    {
      "ordinal": 371,
      "start_ms": 2138270,
      "end_ms": 2140430,
      "text": "早点休息吧"
    },
    {
      "ordinal": 372,
      "start_ms": 2140430,
      "end_ms": 2144660,
      "text": "装修生存不易啊"
    },
    {
      "ordinal": 373,
      "start_ms": 2144660,
      "end_ms": 2149020,
      "text": "光是生活可以随便搞搞"
    },
    {
      "ordinal": 374,
      "start_ms": 2152660,
      "end_ms": 2155240,
      "text": "可以的签签签签"
    },
    {
      "ordinal": 375,
      "start_ms": 2167499,
      "end_ms": 2169079,
      "text": "我身体好着呢"
    },
    {
      "ordinal": 376,
      "start_ms": 2169079,
      "end_ms": 2172739,
      "text": "身体好的人意志力强就行了"
    },
    {
      "ordinal": 377,
      "start_ms": 2181420,
      "end_ms": 2183000,
      "text": "意志力强就可以的哦"
    },
    {
      "ordinal": 378,
      "start_ms": 2183000,
      "end_ms": 2185450,
      "text": "还有那个动态没删是吧"
    },
    {
      "ordinal": 379,
      "start_ms": 2205130,
      "end_ms": 2209680,
      "text": "我的动态在哪里看"
    },
    {
      "ordinal": 380,
      "start_ms": 2214540,
      "end_ms": 2215760,
      "text": "全没了"
    },
    {
      "ordinal": 381,
      "start_ms": 2215760,
      "end_ms": 2218190,
      "text": "删除在哪里删"
    },
    {
      "ordinal": 382,
      "start_ms": 2218470,
      "end_ms": 2221370,
      "text": "只能置顶是吧"
    },
    {
      "ordinal": 383,
      "start_ms": 2223320,
      "end_ms": 2225060,
      "text": "哦可以删除"
    },
    {
      "ordinal": 384,
      "start_ms": 2230660,
      "end_ms": 2242460,
      "text": "这个讨论没有必要存在"
    },
    {
      "ordinal": 385,
      "start_ms": 2245240,
      "end_ms": 2249940,
      "text": "哦这个只要把那个删了就行了"
    },
    {
      "ordinal": 386,
      "start_ms": 2256080,
      "end_ms": 2260060,
      "text": "叫做专栏的观点"
    },
    {
      "ordinal": 387,
      "start_ms": 2260710,
      "end_ms": 2264430,
      "text": "我想这个过程被录下来"
    },
    {
      "ordinal": 388,
      "start_ms": 2264430,
      "end_ms": 2266750,
      "text": "你们也应该快明白了吧"
