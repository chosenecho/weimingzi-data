  "content_sha256": "3ee12fd4d37886712087eb60dbf733ddce64bfc519500a96e1ebfc58f50652d1",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 28440,
      "end_ms": 30300,
      "text": "夜风凛凛"
    },
    {
      "ordinal": 1,
      "start_ms": 30300,
      "end_ms": 32340,
      "text": "独回望旧事"
    },
    {
      "ordinal": 2,
      "start_ms": 32340,
      "end_ms": 37779,
      "text": "前尘是以往的我充满怒愤"
    },
    {
      "ordinal": 3,
      "start_ms": 39640,
      "end_ms": 41730,
      "text": "无垢与自责"
    },
    {
      "ordinal": 4,
      "start_ms": 41730,
      "end_ms": 44580,
      "text": "惊讶尽满都去不分"
    },
    {
      "ordinal": 5,
      "start_ms": 44580,
      "end_ms": 47580,
      "text": "对谣言反映"
    },
    {
      "ordinal": 6,
      "start_ms": 47580,
      "end_ms": 49279,
      "text": "深海作假"
    },
    {
      "ordinal": 7,
      "start_ms": 51100,
      "end_ms": 53160,
      "text": "受了加分"
    },
    {
      "ordinal": 8,
      "start_ms": 53160,
      "end_ms": 56360,
      "text": "得了书经的指引"
    },
    {
      "ordinal": 9,
      "start_ms": 56780,
      "end_ms": 58870,
      "text": "人已看得透"
    },
    {
      "ordinal": 10,
      "start_ms": 58870,
      "end_ms": 60620,
      "text": "不再自困"
    },
    {
      "ordinal": 11,
      "start_ms": 62460,
      "end_ms": 67460,
      "text": "但觉有分数不再像以往那般迷"
    },
    {
      "ordinal": 12,
      "start_ms": 67460,
      "end_ms": 72000,
      "text": "没力气轻快笑着行"
    },
    {
      "ordinal": 13,
      "start_ms": 74000,
      "end_ms": 80610,
      "text": "冥冥中都早注定你富或是错"
    },
    {
      "ordinal": 14,
      "start_ms": 80610,
      "end_ms": 81750,
      "text": "永不对"
    },
    {
      "ordinal": 15,
      "start_ms": 81750,
      "end_ms": 83539,
      "text": "真永是真"
    },
    {
      "ordinal": 16,
      "start_ms": 85420,
      "end_ms": 88780,
      "text": "有你真说问"
    },
    {
      "ordinal": 17,
      "start_ms": 88780,
      "end_ms": 90370,
      "text": "守我本分"
    },
    {
      "ordinal": 18,
      "start_ms": 90370,
      "end_ms": 97730,
      "text": "始终相信沉默是今是非"
    },
    {
      "ordinal": 19,
      "start_ms": 97730,
      "end_ms": 98900,
      "text": "有公理"
    },
    {
      "ordinal": 20,
      "start_ms": 98900,
      "end_ms": 100910,
      "text": "慎言莫冒犯"
    },
    {
      "ordinal": 21,
      "start_ms": 100910,
      "end_ms": 104640,
      "text": "别人遇上冷风雨"
    },
    {
      "ordinal": 22,
      "start_ms": 104640,
      "end_ms": 106399,
      "text": "有太阳照"
    },
    {
      "ordinal": 23,
      "start_ms": 108220,
      "end_ms": 111180,
      "text": "自信满心里有你"
    },
    {
      "ordinal": 24,
      "start_ms": 111180,
      "end_ms": 113250,
      "text": "为讽刺雨之吻"
    },
    {
      "ordinal": 25,
      "start_ms": 113250,
      "end_ms": 117960,
      "text": "笑马游刃洒脱的做人"
    },
    {
      "ordinal": 26,
      "start_ms": 153999,
      "end_ms": 156059,
      "text": "受了几分"
    },
    {
      "ordinal": 27,
      "start_ms": 156059,
      "end_ms": 159420,
      "text": "得了数经的指引"
    },
    {
      "ordinal": 28,
      "start_ms": 159779,
      "end_ms": 161809,
      "text": "人已看得透"
    },
    {
      "ordinal": 29,
      "start_ms": 161809,
      "end_ms": 163580,
      "text": "不再自困"
    },
    {
      "ordinal": 30,
      "start_ms": 165480,
      "end_ms": 172070,
      "text": "但觉有分数不再像以往那般迷雾里痕"
    },
    {
      "ordinal": 31,
      "start_ms": 172070,
      "end_ms": 174880,
      "text": "轻快笑着行"
    },
    {
      "ordinal": 32,
      "start_ms": 176920,
      "end_ms": 183539,
      "text": "冥冥中都早注定你复盘是错"
    },
    {
      "ordinal": 33,
      "start_ms": 183539,
      "end_ms": 184679,
      "text": "永不对"
    },
    {
      "ordinal": 34,
      "start_ms": 184679,
      "end_ms": 186600,
      "text": "真永是真"
    },
    {
      "ordinal": 35,
      "start_ms": 188339,
      "end_ms": 193300,
      "text": "任你怎说安守我本分"
    },
    {
      "ordinal": 36,
      "start_ms": 193300,
      "end_ms": 196300,
      "text": "此去中伤心"
    },
    {
      "ordinal": 37,
      "start_ms": 196300,
      "end_ms": 200710,
      "text": "什么时间是非"
    },
    {
      "ordinal": 38,
      "start_ms": 200710,
      "end_ms": 203890,
      "text": "有公理心情默默翻"
    },
    {
      "ordinal": 39,
      "start_ms": 203890,
      "end_ms": 207559,
      "text": "别人遇上冷风雨"
    },
    {
      "ordinal": 40,
      "start_ms": 207559,
      "end_ms": 208699,
      "text": "有太阳"
    },
    {
      "ordinal": 41,
      "start_ms": 208699,
      "end_ms": 209800,
      "text": "真"
    },
    {
      "ordinal": 42,
      "start_ms": 211219,
      "end_ms": 214179,
      "text": "自信满心里有你"
    },
    {
      "ordinal": 43,
      "start_ms": 214179,
      "end_ms": 217149,
      "text": "为讽刺与之吻笑马"
    },
    {
      "ordinal": 44,
      "start_ms": 217149,
      "end_ms": 220700,
      "text": "有人洒脱地做人"
    },
    {
      "ordinal": 45,
      "start_ms": 221959,
      "end_ms": 231900,
      "text": "少年人洒去的昨日记住恨洒脱地做"
    }
  ],
  "text": "夜风凛凛\n独回望旧事\n前尘是以往的我充满怒愤\n无垢与自责\n惊讶尽满都去不分\n对谣言反映\n深海作假\n受了加分\n得了书经的指引\n人已看得透\n不再自困\n但觉有分数不再像以往那般迷\n没力气轻快笑着行\n冥冥中都早注定你富或是错\n永不对\n真永是真\n有你真说问\n守我本分\n始终相信沉默是今是非\n有公理\n慎言莫冒犯\n别人遇上冷风雨\n有太阳照\n自信满心里有你\n为讽刺雨之吻\n笑马游刃洒脱的做人\n受了几分\n得了数经的指引\n人已看得透\n不再自困\n但觉有分数不再像以往那般迷雾里痕\n轻快笑着行\n冥冥中都早注定你复盘是错\n永不对\n真永是真\n任你怎说安守我本分\n此去中伤心\n什么时间是非\n有公理心情默默翻\n别人遇上冷风雨\n有太阳\n真\n自信满心里有你\n为讽刺与之吻笑马\n有人洒脱地做人\n少年人洒去的昨日记住恨洒脱地做",
