  "segments": [
    {
      "ordinal": 0,
      "start_ms": 26020,
      "end_ms": 27670,
      "text": "抬头望星空"
    },
    {
      "ordinal": 1,
      "start_ms": 27670,
      "end_ms": 29060,
      "text": "一片静"
    },
    {
      "ordinal": 2,
      "start_ms": 29920,
      "end_ms": 31080,
      "text": "我独行"
    },
    {
      "ordinal": 3,
      "start_ms": 32400,
      "end_ms": 34120,
      "text": "夜雨声甜"
    },
    {
      "ordinal": 4,
      "start_ms": 36000,
      "end_ms": 39199,
      "text": "无情是指刻的冷静"
    },
    {
      "ordinal": 5,
      "start_ms": 40180,
      "end_ms": 41280,
      "text": "笑问岁"
    },
    {
      "ordinal": 6,
      "start_ms": 42600,
      "end_ms": 44540,
      "text": "感叹笑颜"
    },
    {
      "ordinal": 7,
      "start_ms": 45840,
      "end_ms": 48320,
      "text": "风家风也迁就"
    },
    {
      "ordinal": 8,
      "start_ms": 48320,
      "end_ms": 51840,
      "text": "知病患是某地未名"
    },
    {
      "ordinal": 9,
      "start_ms": 51840,
      "end_ms": 53070,
      "text": "是我苦笑"
    },
    {
      "ordinal": 10,
      "start_ms": 53070,
      "end_ms": 57000,
      "text": "却每天不是明"
    },
    {
      "ordinal": 11,
      "start_ms": 57640,
      "end_ms": 62290,
      "text": "只信双手去抚平矛盾"
    },
    {
      "ordinal": 12,
      "start_ms": 62290,
      "end_ms": 65340,
      "text": "是无力去暂停"
    },
    {
      "ordinal": 13,
      "start_ms": 65640,
      "end_ms": 69680,
      "text": "何谓知我心里困倦"
    },
    {
      "ordinal": 14,
      "start_ms": 69680,
      "end_ms": 72230,
      "text": "满清夜阑静"
    },
    {
      "ordinal": 15,
      "start_ms": 72230,
      "end_ms": 74920,
      "text": "问有谁共鸣"
    },
    {
      "ordinal": 16,
      "start_ms": 97220,
      "end_ms": 98980,
      "text": "重庆市挺进"
    },
    {
      "ordinal": 17,
      "start_ms": 98980,
      "end_ms": 100360,
      "text": "不冷静"
    },
    {
      "ordinal": 18,
      "start_ms": 101320,
      "end_ms": 102480,
      "text": "爱自由"
    },
    {
      "ordinal": 19,
      "start_ms": 103740,
      "end_ms": 105380,
      "text": "或许梦莹"
    },
    {
      "ordinal": 20,
      "start_ms": 107400,
      "end_ms": 112680,
      "text": "明白是得失总有点去或留"
    },
    {
      "ordinal": 21,
      "start_ms": 114000,
      "end_ms": 115679,
      "text": "轻松对线"
    },
    {
      "ordinal": 22,
      "start_ms": 117320,
      "end_ms": 119170,
      "text": "孤单中战斗"
    },
    {
      "ordinal": 23,
      "start_ms": 119170,
      "end_ms": 122080,
      "text": "可知我实在难受"
    },
    {
      "ordinal": 24,
      "start_ms": 122300,
      "end_ms": 128300,
      "text": "梦谁愿意失去了自由后想退后"
    },
    {
      "ordinal": 25,
      "start_ms": 129100,
      "end_ms": 130710,
      "text": "心理之中"
    },
    {
      "ordinal": 26,
      "start_ms": 130710,
      "end_ms": 133650,
      "text": "我拥有情绪"
    },
    {
      "ordinal": 27,
      "start_ms": 133650,
      "end_ms": 134880,
      "text": "亦全力去"
    },
    {
      "ordinal": 28,
      "start_ms": 134880,
      "end_ms": 138549,
      "text": "春秋风也清"
    },
    {
      "ordinal": 29,
      "start_ms": 138549,
      "end_ms": 140289,
      "text": "晚空中"
    },
    {
      "ordinal": 30,
      "start_ms": 140289,
      "end_ms": 142059,
      "text": "我问句星"
    },
    {
      "ordinal": 31,
      "start_ms": 142059,
      "end_ms": 143619,
      "text": "夜阑静"
    },
    {
      "ordinal": 32,
      "start_ms": 143619,
      "end_ms": 146540,
      "text": "问有谁共鸣"
    },
    {
      "ordinal": 33,
      "start_ms": 168320,
      "end_ms": 170200,
      "text": "孤单中战斗"
    },
    {
      "ordinal": 34,
      "start_ms": 170200,
      "end_ms": 173170,
      "text": "可知我实在难受"
    },
    {
      "ordinal": 35,
      "start_ms": 173170,
      "end_ms": 176860,
      "text": "问谁愿意失去了自由"
    },
    {
      "ordinal": 36,
      "start_ms": 177860,
      "end_ms": 179420,
      "text": "想退后"
    },
    {
      "ordinal": 37,
      "start_ms": 180080,
      "end_ms": 181780,
      "text": "心里自作"
    },
    {
      "ordinal": 38,
      "start_ms": 181780,
      "end_ms": 184690,
      "text": "我拥有情绪"
    },
    {
      "ordinal": 39,
      "start_ms": 184690,
      "end_ms": 188930,
      "text": "亦全力去春游风雅"
    },
    {
      "ordinal": 40,
      "start_ms": 188930,
      "end_ms": 198020,
      "text": "前晚空中我问句星夜阑静问有谁共鸣"
    },
    {
      "ordinal": 41,
      "start_ms": 198300,
      "end_ms": 199790,
      "text": "风也清"
    },
    {
      "ordinal": 42,
      "start_ms": 199790,
      "end_ms": 207880,
      "text": "晚空中我问句星夜阑静问有谁共鸣"
    }
  ],
  "text": "抬头望星空\n一片静\n我独行\n夜雨声甜\n无情是指刻的冷静\n笑问岁\n感叹笑颜\n风家风也迁就\n知病患是某地未名\n是我苦笑\n却每天不是明\n只信双手去抚平矛盾\n是无力去暂停\n何谓知我心里困倦\n满清夜阑静\n问有谁共鸣\n重庆市挺进\n不冷静\n爱自由\n或许梦莹\n明白是得失总有点去或留\n轻松对线\n孤单中战斗\n可知我实在难受\n梦谁愿意失去了自由后想退后\n心理之中\n我拥有情绪\n亦全力去\n春秋风也清\n晚空中\n我问句星\n夜阑静\n问有谁共鸣\n孤单中战斗\n可知我实在难受\n问谁愿意失去了自由\n想退后\n心里自作\n我拥有情绪\n亦全力去春游风雅\n前晚空中我问句星夜阑静问有谁共鸣\n风也清\n晚空中我问句星夜阑静问有谁共鸣",
