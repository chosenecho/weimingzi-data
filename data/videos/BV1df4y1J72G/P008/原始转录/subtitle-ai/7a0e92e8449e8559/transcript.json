  "segments": [
    {
      "ordinal": 0,
      "start_ms": 31620,
      "end_ms": 36879,
      "text": "轻轻笑声在为我送温暖"
    },
    {
      "ordinal": 1,
      "start_ms": 37140,
      "end_ms": 41459,
      "text": "你为我注入快乐强电"
    },
    {
      "ordinal": 2,
      "start_ms": 43640,
      "end_ms": 46900,
      "text": "轻轻笑声漫长"
    },
    {
      "ordinal": 3,
      "start_ms": 46900,
      "end_ms": 48940,
      "text": "路快要走过"
    },
    {
      "ordinal": 4,
      "start_ms": 49160,
      "end_ms": 53620,
      "text": "终于走到明媚晴天"
    },
    {
      "ordinal": 5,
      "start_ms": 54580,
      "end_ms": 58110,
      "text": "声声欢呼跃起"
    },
    {
      "ordinal": 6,
      "start_ms": 58110,
      "end_ms": 60860,
      "text": "像红日发放金正"
    },
    {
      "ordinal": 7,
      "start_ms": 61260,
      "end_ms": 65580,
      "text": "我伴你往日笑面重现"
    },
    {
      "ordinal": 8,
      "start_ms": 67740,
      "end_ms": 71300,
      "text": "轻轻叫声共抬望"
    },
    {
      "ordinal": 9,
      "start_ms": 71300,
      "end_ms": 75400,
      "text": "眼看高考终于晴"
    },
    {
      "ordinal": 10,
      "start_ms": 75400,
      "end_ms": 75580,
      "text": "天"
    },
    {
      "ordinal": 11,
      "start_ms": 75580,
      "end_ms": 76630,
      "text": "有美味"
    },
    {
      "ordinal": 12,
      "start_ms": 76630,
      "end_ms": 77460,
      "text": "你应"
    },
    {
      "ordinal": 13,
      "start_ms": 79800,
      "end_ms": 85000,
      "text": "拥着你当初温馨再涌现"
    },
    {
      "ordinal": 14,
      "start_ms": 85820,
      "end_ms": 90160,
      "text": "心里变童年失去梦"
    },
    {
      "ordinal": 15,
      "start_ms": 90160,
      "end_ms": 100179,
      "text": "唯物也更让我与你有时间平静多年情"
    },
    {
      "ordinal": 16,
      "start_ms": 101320,
      "end_ms": 105520,
      "text": "此刻似天上行心事"
    },
    {
      "ordinal": 17,
      "start_ms": 109960,
      "end_ms": 113880,
      "text": "一望你眼里温馨"
    },
    {
      "ordinal": 18,
      "start_ms": 113880,
      "end_ms": 118420,
      "text": "已通知松来边"
    },
    {
      "ordinal": 19,
      "start_ms": 118420,
      "end_ms": 121870,
      "text": "从前梦一点未改变"
    },
    {
      "ordinal": 20,
      "start_ms": 121870,
      "end_ms": 127100,
      "text": "更让我与你有时间并肩"
    },
    {
      "ordinal": 21,
      "start_ms": 128240,
      "end_ms": 136319,
      "text": "当年情再度添上新鲜"
    },
    {
      "ordinal": 22,
      "start_ms": 137999,
      "end_ms": 139480,
      "text": "嗯"
    },
    {
      "ordinal": 23,
      "start_ms": 164240,
      "end_ms": 166660,
      "text": "欢呼一起"
    },
    {
      "ordinal": 24,
      "start_ms": 166660,
      "end_ms": 169560,
      "text": "昨日发放金正"
    },
    {
      "ordinal": 25,
      "start_ms": 169839,
      "end_ms": 175020,
      "text": "我伴你往日笑面重现"
    },
    {
      "ordinal": 26,
      "start_ms": 176339,
      "end_ms": 179899,
      "text": "轻轻笑声共抬望"
    },
    {
      "ordinal": 27,
      "start_ms": 179899,
      "end_ms": 181720,
      "text": "眼看高空"
    },
    {
      "ordinal": 28,
      "start_ms": 181940,
      "end_ms": 184160,
      "text": "终于晴天"
    },
    {
      "ordinal": 29,
      "start_ms": 184160,
      "end_ms": 186980,
      "text": "优美为你喜"
    },
    {
      "ordinal": 30,
      "start_ms": 188339,
      "end_ms": 193580,
      "text": "拥着你当初温馨再涌现"
    },
    {
      "ordinal": 31,
      "start_ms": 194380,
      "end_ms": 198330,
      "text": "心里边童年稚气"
    },
    {
      "ordinal": 32,
      "start_ms": 198330,
      "end_ms": 200220,
      "text": "梦未污染"
    },
    {
      "ordinal": 33,
      "start_ms": 200220,
      "end_ms": 206080,
      "text": "更让我与你有时间变迁"
    },
    {
      "ordinal": 34,
      "start_ms": 206459,
      "end_ms": 214999,
      "text": "当年情此刻是添上行心事"
    },
    {
      "ordinal": 35,
      "start_ms": 218520,
      "end_ms": 224020,
      "text": "一望你眼里温馨已通电"
    },
    {
      "ordinal": 36,
      "start_ms": 224600,
      "end_ms": 230409,
      "text": "心里的从前梦一点未改变"
    },
    {
      "ordinal": 37,
      "start_ms": 230409,
      "end_ms": 235459,
      "text": "今日我与你有时间变迁"
    },
    {
      "ordinal": 38,
      "start_ms": 236779,
      "end_ms": 243780,
      "text": "当年情再度添上新鲜"
    }
