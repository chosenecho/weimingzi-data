  "segments": [
    {
      "ordinal": 0,
      "start_ms": 17940,
      "end_ms": 21360,
      "text": "这夜阑尽处"
    },
    {
      "ordinal": 1,
      "start_ms": 22580,
      "end_ms": 25560,
      "text": "独看天来生"
    },
    {
      "ordinal": 2,
      "start_ms": 27000,
      "end_ms": 30360,
      "text": "每夜繁星不变"
    },
    {
      "ordinal": 3,
      "start_ms": 31340,
      "end_ms": 34279,
      "text": "每日常照耀"
    },
    {
      "ordinal": 4,
      "start_ms": 35180,
      "end_ms": 37900,
      "text": "但愿人没变"
    },
    {
      "ordinal": 5,
      "start_ms": 40020,
      "end_ms": 48059,
      "text": "因此生长久来日与星星照"
    },
    {
      "ordinal": 6,
      "start_ms": 48800,
      "end_ms": 52780,
      "text": "我也曾想在"
    },
    {
      "ordinal": 7,
      "start_ms": 53940,
      "end_ms": 55220,
      "text": "漫长夜晚"
    },
    {
      "ordinal": 8,
      "start_ms": 55220,
      "end_ms": 56750,
      "text": "星又可怕"
    },
    {
      "ordinal": 9,
      "start_ms": 56750,
      "end_ms": 61959,
      "text": "又问人怎么却不会温柔"
    },
    {
      "ordinal": 10,
      "start_ms": 62700,
      "end_ms": 65600,
      "text": "但愿留下时光辉成星"
    },
    {
      "ordinal": 11,
      "start_ms": 65600,
      "end_ms": 68800,
      "text": "星照刹下"
    },
    {
      "ordinal": 12,
      "start_ms": 71200,
      "end_ms": 73600,
      "text": "满城烟"
    },
    {
      "ordinal": 13,
      "start_ms": 76540,
      "end_ms": 80340,
      "text": "但愿人没必"
    },
    {
      "ordinal": 14,
      "start_ms": 81480,
      "end_ms": 84840,
      "text": "愿似星长久"
    },
    {
      "ordinal": 15,
      "start_ms": 85900,
      "end_ms": 89320,
      "text": "每日与星星照"
    },
    {
      "ordinal": 16,
      "start_ms": 90180,
      "end_ms": 94280,
      "text": "每日常很在"
    },
    {
      "ordinal": 17,
      "start_ms": 128939,
      "end_ms": 132320,
      "text": "这夜阑静处"
    },
    {
      "ordinal": 18,
      "start_ms": 133800,
      "end_ms": 136960,
      "text": "独看天来兮"
    },
    {
      "ordinal": 19,
      "start_ms": 138200,
      "end_ms": 140860,
      "text": "午夜繁星不变"
    },
    {
      "ordinal": 20,
      "start_ms": 142559,
      "end_ms": 145500,
      "text": "白夜场交易"
    },
    {
      "ordinal": 21,
      "start_ms": 146360,
      "end_ms": 149100,
      "text": "但愿人没变"
    },
    {
      "ordinal": 22,
      "start_ms": 151240,
      "end_ms": 155120,
      "text": "愿似星长久"
    },
    {
      "ordinal": 23,
      "start_ms": 155640,
      "end_ms": 158600,
      "text": "白夜如星闪照"
    },
    {
      "ordinal": 24,
      "start_ms": 159980,
      "end_ms": 163060,
      "text": "我也曾认真"
    },
    {
      "ordinal": 25,
      "start_ms": 165179,
      "end_ms": 166459,
      "text": "漫长夜晚"
    },
    {
      "ordinal": 26,
      "start_ms": 166459,
      "end_ms": 167989,
      "text": "星有可不"
    },
    {
      "ordinal": 27,
      "start_ms": 167989,
      "end_ms": 168800,
      "text": "有"
    },
    {
      "ordinal": 28,
      "start_ms": 169559,
      "end_ms": 171379,
      "text": "问人怎么学"
    },
    {
      "ordinal": 29,
      "start_ms": 171379,
      "end_ms": 173200,
      "text": "不会挽救"
    },
    {
      "ordinal": 30,
      "start_ms": 173879,
      "end_ms": 176119,
      "text": "但愿留下时光杯"
    },
    {
      "ordinal": 31,
      "start_ms": 176119,
      "end_ms": 179960,
      "text": "正正正照查"
    },
    {
      "ordinal": 32,
      "start_ms": 182339,
      "end_ms": 185180,
      "text": "满城烟"
    },
    {
      "ordinal": 33,
      "start_ms": 187800,
      "end_ms": 190540,
      "text": "但愿人没变"
    },
    {
      "ordinal": 34,
      "start_ms": 192719,
      "end_ms": 195560,
      "text": "愿似星长久"
    },
    {
      "ordinal": 35,
      "start_ms": 197040,
      "end_ms": 200000,
      "text": "每日如星星之"
    },
    {
      "ordinal": 36,
      "start_ms": 201439,
      "end_ms": 205179,
      "text": "我也曾想在"
    }
  ],
  "text": "这夜阑尽处\n独看天来生\n每夜繁星不变\n每日常照耀\n但愿人没变\n因此生长久来日与星星照\n我也曾想在\n漫长夜晚\n星又可怕\n又问人怎么却不会温柔\n但愿留下时光辉成星\n星照刹下\n满城烟\n但愿人没必\n愿似星长久\n每日与星星照\n每日常很在\n这夜阑静处\n独看天来兮\n午夜繁星不变\n白夜场交易\n但愿人没变\n愿似星长久\n白夜如星闪照\n我也曾认真\n漫长夜晚\n星有可不\n有\n问人怎么学\n不会挽救\n但愿留下时光杯\n正正正照查\n满城烟\n但愿人没变\n愿似星长久\n每日如星星之\n我也曾想在",
  "timing_issue": null
}
