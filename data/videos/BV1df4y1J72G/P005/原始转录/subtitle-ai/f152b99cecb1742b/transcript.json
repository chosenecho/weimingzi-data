  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "f152b99cecb1742bcc0444a4109b54e6886e44e7eec91524dde09cbab0ca4a9a",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 6560,
      "end_ms": 7120,
      "text": "嗯"
    },
    {
      "ordinal": 1,
      "start_ms": 17760,
      "end_ms": 24080,
      "text": "谁去回望曾属于彼此的晚上"
    },
    {
      "ordinal": 2,
      "start_ms": 24959,
      "end_ms": 31160,
      "text": "红红仍是你赠我的心中一样"
    },
    {
      "ordinal": 3,
      "start_ms": 32980,
      "end_ms": 39660,
      "text": "流沙里奇望可体恤晶晶亮明"
    },
    {
      "ordinal": 4,
      "start_ms": 39660,
      "end_ms": 40980,
      "text": "神里边"
    },
    {
      "ordinal": 5,
      "start_ms": 40980,
      "end_ms": 45419,
      "text": "你留也许孤单得漫长"
    },
    {
      "ordinal": 6,
      "start_ms": 46240,
      "end_ms": 47610,
      "text": "一瞬间"
    },
    {
      "ordinal": 7,
      "start_ms": 47610,
      "end_ms": 49540,
      "text": "太多东西要讲"
    },
    {
      "ordinal": 8,
      "start_ms": 49680,
      "end_ms": 52890,
      "text": "可惜即将在各一方"
    },
    {
      "ordinal": 9,
      "start_ms": 52890,
      "end_ms": 57620,
      "text": "只好深深把这刻真明我"
    },
    {
      "ordinal": 10,
      "start_ms": 59620,
      "end_ms": 62940,
      "text": "来日纵是千千阙歌"
    },
    {
      "ordinal": 11,
      "start_ms": 62940,
      "end_ms": 64319,
      "text": "飘于远方"
    },
    {
      "ordinal": 12,
      "start_ms": 64319,
      "end_ms": 65700,
      "text": "我路上"
    },
    {
      "ordinal": 13,
      "start_ms": 66740,
      "end_ms": 70090,
      "text": "来日纵是千千晚星"
    },
    {
      "ordinal": 14,
      "start_ms": 70090,
      "end_ms": 72780,
      "text": "亮过今晚月亮"
    },
    {
      "ordinal": 15,
      "start_ms": 74300,
      "end_ms": 76210,
      "text": "都被拔起"
    },
    {
      "ordinal": 16,
      "start_ms": 76210,
      "end_ms": 82660,
      "text": "这宵美丽亦绝不可使我更欣赏啊"
    },
    {
      "ordinal": 17,
      "start_ms": 82660,
      "end_ms": 86280,
      "text": "因你今晚共我唱"
    },
    {
      "ordinal": 18,
      "start_ms": 99580,
      "end_ms": 100399,
      "text": "啊"
    },
    {
      "ordinal": 19,
      "start_ms": 103400,
      "end_ms": 104620,
      "text": "太他妈折了"
    },
    {
      "ordinal": 20,
      "start_ms": 104620,
      "end_ms": 106930,
      "text": "我靠哈哈哈"
    },
    {
      "ordinal": 21,
      "start_ms": 106930,
      "end_ms": 109120,
      "text": "他妈的非要咋呼咋呼"
    },
    {
      "ordinal": 22,
      "start_ms": 109120,
      "end_ms": 112900,
      "text": "这一句他在演唱会版本也要他妈咋呼咋呼"
    },
    {
      "ordinal": 23,
      "start_ms": 112900,
      "end_ms": 114220,
      "text": "掉下去啊啊啊"
    },
    {
      "ordinal": 24,
      "start_ms": 114220,
      "end_ms": 115600,
      "text": "我也不知道为什么"
    },
    {
      "ordinal": 25,
      "start_ms": 120960,
      "end_ms": 127460,
      "text": "人行脸皮才能讲爱心的漂亮"
    },
    {
      "ordinal": 26,
      "start_ms": 128020,
      "end_ms": 134720,
      "text": "原来全是你令我的思忆漫长"
    },
    {
      "ordinal": 27,
      "start_ms": 135619,
      "end_ms": 144609,
      "text": "我宁可月才又可今宵一样停留凝望里"
    },
    {
      "ordinal": 28,
      "start_ms": 144609,
      "end_ms": 148860,
      "text": "让眼睛讲彼此路上"
    },
    {
      "ordinal": 29,
      "start_ms": 149339,
      "end_ms": 151819,
      "text": "当某天雨点轻后"
    },
    {
      "ordinal": 30,
      "start_ms": 151819,
      "end_ms": 155929,
      "text": "你装当风声吹乱你构想"
    },
    {
      "ordinal": 31,
      "start_ms": 155929,
      "end_ms": 160840,
      "text": "可否抽空想这张旧模样"
    },
    {
      "ordinal": 32,
      "start_ms": 162619,
      "end_ms": 165999,
      "text": "来日纵是千千阙歌"
    },
    {
      "ordinal": 33,
      "start_ms": 165999,
      "end_ms": 167379,
      "text": "飘于远方"
    },
    {
      "ordinal": 34,
      "start_ms": 167379,
      "end_ms": 168760,
      "text": "我路上"
    },
    {
      "ordinal": 35,
      "start_ms": 169839,
      "end_ms": 173189,
      "text": "来日纵是千千晚星"
    },
    {
      "ordinal": 36,
      "start_ms": 173189,
      "end_ms": 175840,
      "text": "亮过今晚月亮"
    },
    {
      "ordinal": 37,
      "start_ms": 177380,
      "end_ms": 180850,
      "text": "都比不起这宵美丽"
    },
    {
      "ordinal": 38,
      "start_ms": 180850,
      "end_ms": 185740,
      "text": "亦绝不可使我更欣赏啊"
    },
    {
      "ordinal": 39,
      "start_ms": 185740,
      "end_ms": 189360,
      "text": "因你今晚共我唱"
    },
    {
      "ordinal": 40,
      "start_ms": 196540,
      "end_ms": 198760,
      "text": "真的真的很"
    },
    {
      "ordinal": 41,
      "start_ms": 204360,
      "end_ms": 209230,
      "text": "啊枕都比不起这宵美丽"
    },
    {
      "ordinal": 42,
      "start_ms": 209230,
      "end_ms": 212820,
      "text": "亦绝不可使我更欣赏"
    },
    {
      "ordinal": 43,
      "start_ms": 212820,
      "end_ms": 217800,
      "text": "因今宵的我可共你唱"
    },
    {
      "ordinal": 44,
      "start_ms": 219559,
      "end_ms": 222909,
      "text": "来日纵是千千阙歌"
    },
    {
      "ordinal": 45,
      "start_ms": 222909,
      "end_ms": 224259,
      "text": "飘远方"
    },
    {
      "ordinal": 46,
      "start_ms": 224259,
      "end_ms": 225640,
      "text": "我路上"
    },
    {
      "ordinal": 47,
      "start_ms": 226679,
      "end_ms": 230029,
      "text": "来日纵是千千晚星"
    },
    {
      "ordinal": 48,
      "start_ms": 230029,
      "end_ms": 232660,
      "text": "亮过今晚月亮"
    },
    {
      "ordinal": 49,
      "start_ms": 234200,
      "end_ms": 236140,
      "text": "都被拔起"
    },
    {
      "ordinal": 50,
      "start_ms": 236140,
      "end_ms": 242709,
      "text": "这宵美丽亦绝不可使我更欣赏啊"
    },
    {
      "ordinal": 51,
      "start_ms": 242709,
      "end_ms": 246200,
      "text": "因我今晚共你唱"
    },
    {
      "ordinal": 52,
      "start_ms": 247100,
      "end_ms": 248140,
      "text": "他上去了"
    },
    {
      "ordinal": 53,
      "start_ms": 248140,
      "end_ms": 249700,
      "text": "来一下送四车"
    },
    {
      "ordinal": 54,
      "start_ms": 249720,
      "end_ms": 251340,
      "text": "心情会歌"
    },
    {
      "ordinal": 55,
      "start_ms": 251340,
      "end_ms": 252720,
      "text": "飘远方"
    },
    {
      "ordinal": 56,
      "start_ms": 252720,
      "end_ms": 255630,
      "text": "我路上来"
    },
    {
      "ordinal": 57,
      "start_ms": 255630,
      "end_ms": 259560,
      "text": "日纵是千千晚星亮过"
    },
    {
      "ordinal": 58,
      "start_ms": 259560,
      "end_ms": 264560,
      "text": "今晚月亮都被拔起"
    },
    {
      "ordinal": 59,
      "start_ms": 264560,
      "end_ms": 267680,
      "text": "这宵美丽倒是不清"
    },
    {
      "ordinal": 60,
      "start_ms": 267680,
      "end_ms": 274740,
      "text": "今晚我所想拥抱自那天再共你唱"
    },
    {
      "ordinal": 61,
      "start_ms": 277840,
      "end_ms": 280260,
      "text": "啊中间那个是往上唱的啊"
    },
    {
      "ordinal": 62,
      "start_ms": 280260,
      "end_ms": 281520,
      "text": "我们唱到中间去了"
    },
    {
      "ordinal": 63,
      "start_ms": 281520,
      "end_ms": 282540,
      "text": "不好意思啊"
    },
    {
      "ordinal": 64,
      "start_ms": 282740,
      "end_ms": 283940,
      "text": "啊失误啊"
    },
    {
      "ordinal": 65,
      "start_ms": 283940,
      "end_ms": 289300,
      "text": "小失误说明我张国荣的演唱会版本听得不够多啊"
    },
    {
      "ordinal": 66,
      "start_ms": 290660,
      "end_ms": 293080,
      "text": "哦我平时听都听陈淑桦版啊"
    },
    {
      "ordinal": 67,
      "start_ms": 293080,
      "end_ms": 294460,
      "text": "这不是陈慧娴版本的"
    },
    {
      "ordinal": 68,
      "start_ms": 294460,
      "end_ms": 295480,
      "text": "然后我基本上听不完"
    },
    {
      "ordinal": 69,
      "start_ms": 295480,
      "end_ms": 296360,
      "text": "我就切歌了"
    }
  ],
  "text": "嗯\n谁去回望曾属于彼此的晚上\n红红仍是你赠我的心中一样\n流沙里奇望可体恤晶晶亮明\n神里边\n你留也许孤单得漫长\n一瞬间\n太多东西要讲\n可惜即将在各一方\n只好深深把这刻真明我\n来日纵是千千阙歌\n飘于远方\n我路上\n来日纵是千千晚星\n亮过今晚月亮\n都被拔起\n这宵美丽亦绝不可使我更欣赏啊\n因你今晚共我唱\n啊\n太他妈折了\n我靠哈哈哈\n他妈的非要咋呼咋呼\n这一句他在演唱会版本也要他妈咋呼咋呼\n掉下去啊啊啊\n我也不知道为什么\n人行脸皮才能讲爱心的漂亮\n原来全是你令我的思忆漫长\n我宁可月才又可今宵一样停留凝望里\n让眼睛讲彼此路上\n当某天雨点轻后\n你装当风声吹乱你构想\n可否抽空想这张旧模样\n来日纵是千千阙歌\n飘于远方\n我路上\n来日纵是千千晚星\n亮过今晚月亮\n都比不起这宵美丽\n亦绝不可使我更欣赏啊\n因你今晚共我唱\n真的真的很\n啊枕都比不起这宵美丽\n亦绝不可使我更欣赏\n因今宵的我可共你唱\n来日纵是千千阙歌\n飘远方\n我路上\n来日纵是千千晚星\n亮过今晚月亮\n都被拔起\n这宵美丽亦绝不可使我更欣赏啊\n因我今晚共你唱\n他上去了\n来一下送四车\n心情会歌\n飘远方\n我路上来\n日纵是千千晚星亮过\n今晚月亮都被拔起\n这宵美丽倒是不清\n今晚我所想拥抱自那天再共你唱\n啊中间那个是往上唱的啊\n我们唱到中间去了\n不好意思啊\n啊失误啊\n小失误说明我张国荣的演唱会版本听得不够多啊\n哦我平时听都听陈淑桦版啊\n这不是陈慧娴版本的\n然后我基本上听不完\n我就切歌了",
  "timing_issue": null
}
