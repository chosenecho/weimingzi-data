{"segments":[{"start":0.08,"end":3.32,"text":"首先要做的不是群众工作"},{"start":3.96,"end":9.04,"text":"或者说首先你没有足够的合格的人手"},{"start":9.04,"end":11.44,"text":"做所谓的群众工作"},{"start":13.02,"end":15.18,"text":"首先要做的是职业革命家的工作"},{"start":16.74,"end":21.55,"text":"或者或者说我们一直说的那个词叫sees the car"},{"start":21.55,"end":27.01,"text":"首先要做的是那些不合格的活动者的工作"},{"start":27.01,"end":28.66,"text":"他们不合格"},{"start":28.66,"end":30.1,"text":"要让他们合格"},{"start":30.1,"end":31.38,"text":"勉强让他们合格"},{"start":31.38,"end":36.05,"text":"但是呢他可能在其他方面已经合格"},{"start":36.05,"end":38.13,"text":"就差一两门不合格"},{"start":38.13,"end":41.8,"text":"这个工作容易得多"},{"start":42.12,"end":45.48,"text":"所以首先要做的是找那些"},{"start":46.57,"end":49.37,"text":"其他很多方面已经合格了的"},{"start":49.539,"end":52.459,"text":"就剩一两个方面不太合格的"},{"start":52.459,"end":54.779,"text":"而这一两个方面不合格的方面"},{"start":54.779,"end":62.09,"text":"可以在短时间之内一次两次三次四次比较呃"},{"start":62.09,"end":67.83,"text":"慎重的正式的活动下就能给他把短板补齐的人"},{"start":68.83,"end":70.21,"text":"要做这些人的工作"},{"start":70.21,"end":74.44,"text":"那么他主要的那些合格的部分是什么"},{"start":74.44,"end":77.06,"text":"他受教育水平是什么"},{"start":77.06,"end":82.39,"text":"是他的一定程度的啊否定性啊"},{"start":82.39,"end":84.43,"text":"一定程度的这种否定性啊"},{"start":84.43,"end":86.669,"text":"内在内核的否定性"},{"start":86.669,"end":88.589,"text":"那么那个短板是什么"},{"start":88.589,"end":89.909,"text":"短板是他的右肢"},{"start":89.909,"end":94.95,"text":"短板是他的对于一些客观状况的无知"},{"start":94.95,"end":99.94,"text":"短板是他的一些还没有幻想没有掐掉啊"},{"start":99.94,"end":101.68,"text":"这些幻想是容易掐灭的"},{"start":101.68,"end":104.52,"text":"在现实的这个火花下"},{"start":104.52,"end":107.04,"text":"这个冰水一下子就会啊"},{"start":107.04,"end":108.44,"text":"不是啊"},{"start":108.44,"end":111.32,"text":"在这雪花一下子就会被融化掉啊"},{"start":111.32,"end":113.84,"text":"这种幻想唉"},{"start":113.84,"end":115.96,"text":"很多人说我们不近人情啊"},{"start":115.96,"end":118.15,"text":"门槛高啊"},{"start":118.15,"end":120.35,"text":"我们门槛不高"},{"start":120.35,"end":122.47,"text":"但我们正儿八经做事情的时候"},{"start":122.47,"end":125.059,"text":"门槛我们不会对大众啊"},{"start":125.059,"end":127.299,"text":"对所谓群众有什么偏见"},{"start":127.299,"end":129.5,"text":"或者有什么瞧不起的地方"},{"start":129.78,"end":133.88,"text":"但是是很客观审慎冷静的看待这个事情"},{"start":133.88,"end":136.26,"text":"我们首要做的工作呢"},{"start":139.78,"end":141.38,"text":"不是泛滥"},{"start":141.38,"end":142.36,"text":"我们的爱心"},{"start":142.36,"end":147.459,"text":"把群众当成一个道德欲拯救欲发泄的对象"},{"start":147.539,"end":149.299,"text":"没有任何意义的"},{"start":149.299,"end":152.36,"text":"首先就是要有门槛"},{"start":152.36,"end":156.72,"text":"这个门槛是智性的门槛"},{"start":156.72,"end":161.14,"text":"是情感关怀的门槛是什么"},{"start":161.14,"end":170.39,"text":"基本的学养和基本的学习习惯能力的一个门槛"},{"start":170.73,"end":174.15,"text":"你这个门槛不是说都是小资"},{"start":174.15,"end":176.05,"text":"之前有一个跟我们连麦的"},{"start":176.05,"end":178.59,"text":"在地下室里面住了好几年"},{"start":178.59,"end":181.189,"text":"咳咳他也是个打工的"},{"start":181.189,"end":181.949,"text":"无产者"},{"start":181.949,"end":183.669,"text":"后厨帮工的"},{"start":183.669,"end":186.83,"text":"但他自己靠自学啊"},{"start":186.83,"end":187.73,"text":"靠努力"},{"start":187.73,"end":192.31,"text":"他被我说是不是类似斯大林这么一个人啊"},{"start":194.18,"end":195.72,"text":"他不也过来了"},{"start":195.72,"end":197.3,"text":"他不也合格了吗"},{"start":197.3,"end":199.819,"text":"甚至在我眼里是啊"},{"start":199.819,"end":201.639,"text":"有一定概率可能是优秀啊"},{"start":201.639,"end":204.039,"text":"到底怎样就要考察一下"},{"start":204.64,"end":207.56,"text":"直接做所谓的群众工作有用吗"},{"start":207.56,"end":208.44,"text":"有意义吗"},{"start":208.44,"end":211.36,"text":"都是全都是短板的人"},{"start":211.36,"end":213.64,"text":"没有任何用吗"},{"start":213.889,"end":216.449,"text":"啊首先你做工作"},{"start":216.449,"end":218.849,"text":"首先你要做他短板少"},{"start":218.849,"end":220.149,"text":"只有一两个短板"},{"start":220.149,"end":223.56,"text":"绝大部分是还有一些长处的"},{"start":223.56,"end":227.27,"text":"这些人的工作完全平庸的"},{"start":227.27,"end":228.15,"text":"无知的"},{"start":228.15,"end":229.13,"text":"懦弱的"},{"start":229.13,"end":230.09,"text":"愚蠢的"},{"start":230.09,"end":231.41,"text":"卑劣的"},{"start":231.41,"end":233.34,"text":"充满了问题的人"},{"start":233.34,"end":234.46,"text":"帮了也没用啊"},{"start":235.58,"end":237.36,"text":"帮了自己陷在泥潭里面"},{"start":237.36,"end":238.82,"text":"浪费自己的资源"},{"start":238.82,"end":240.87,"text":"时间精力活动空间"},{"start":240.87,"end":242.45,"text":"弄一堆这种魔怔人"},{"start":242.45,"end":243.73,"text":"病理化的"},{"start":243.73,"end":245.39,"text":"毫无能力的"},{"start":245.39,"end":248.11,"text":"毫无提供不了任何帮助"},{"start":248.11,"end":252.07,"text":"还需要不停地吸取你的帮助的这些人"},{"start":253.32,"end":255.32,"text":"你弄一个两个千金市马骨"},{"start":255.32,"end":257.959,"text":"我倒是可以理解啊"},{"start":257.959,"end":261.279,"text":"啊人望之却为震朔所在啊"},{"start":261.279,"end":264.699,"text":"呵呵弄多了有啥意思"},{"start":265.14,"end":266.96,"text":"一个两个弄得装逼啊"},{"start":266.96,"end":269.34,"text":"正朔朔所在也是搞笑"},{"start":269.34,"end":272.18,"text":"我靠这说这那这有傻子大"},{"start":272.18,"end":273.96,"text":"大家赶紧过来薅他羊毛"},{"start":273.96,"end":274.88,"text":"这个意思"},{"start":276.08,"end":278.26,"text":"如果短板太多的人"},{"start":278.62,"end":280.22,"text":"实事求是讲啊"},{"start":280.22,"end":282.409,"text":"他这个德不配位啊"},{"start":282.409,"end":285.009,"text":"在这里应当是一个发展的"},{"start":285.009,"end":288.53,"text":"应当是一个进步的一些空间"},{"start":288.53,"end":290.53,"text":"竟然被很明显"},{"start":290.53,"end":294.55,"text":"要把自己历史的最为宝贵的资源给浪费的"},{"start":294.55,"end":298.26,"text":"耗尽的不应当如此"},{"start":298.26,"end":302.1,"text":"而机体的新陈代谢是一直要去维持的"},{"start":302.1,"end":303.04,"text":"你不能说哦"},{"start":303.04,"end":304.7,"text":"他是老兄弟"},{"start":304.7,"end":305.56,"text":"认识的比较早"},{"start":305.56,"end":307.7,"text":"什么什么东西的要淘汰的呀"},{"start":307.7,"end":309.22,"text":"该淘汰的要淘汰"},{"start":309.22,"end":311.78,"text":"否则就是对历史不负责任"},{"start":312.59,"end":314.41,"text":"怎么能对历史不负责任呢"},{"start":314.41,"end":317.07,"text":"历史给予的机会是非常有限的"},{"start":317.07,"end":318.74,"text":"这很魔怔"},{"start":318.74,"end":319.74,"text":"去基进化的"},{"start":319.74,"end":322.1,"text":"做不到正儿八经的干活"},{"start":322.1,"end":323.0,"text":"干不了几天"},{"start":323.0,"end":325.14,"text":"不停的去撂挑子"},{"start":325.14,"end":327.5,"text":"不停的去发病的"},{"start":328.269,"end":329.949,"text":"历史给予我们的"},{"start":329.949,"end":333.749,"text":"或者是说很宝贵的这些点点滴滴"},{"start":333.749,"end":334.769,"text":"所有人的努力"},{"start":334.769,"end":342.98,"text":"整个国家民族还有这个特定的穷苦阶级啊"},{"start":342.98,"end":345.2,"text":"这积攒下来的这些希望"},{"start":345.2,"end":347.54,"text":"难道就被你白白浪费了吧"},{"start":347.54,"end":349.21,"text":"凭什么呀"},{"start":349.57,"end":351.69,"text":"所以该清退的要清退"},{"start":351.69,"end":356.08,"text":"然后呢该寻找嗯"},{"start":356.08,"end":358.96,"text":"就是它本身很好改造"},{"start":359.86,"end":361.1,"text":"一定的锻炼"},{"start":361.1,"end":363.98,"text":"有限的锻炼就能够获得十足的成长的"},{"start":363.98,"end":367.83,"text":"这些人要首先做他们的工作"},{"start":368.07,"end":370.33,"text":"也就是说首先做自己人的工作"},{"start":370.33,"end":372.11,"text":"首先做合格的"},{"start":372.11,"end":373.39,"text":"容易合格的"},{"start":373.39,"end":376.56,"text":"有待成为自己人的自己人的工作"},{"start":376.8,"end":379.84,"text":"那么群众工作这种情况下"},{"start":379.84,"end":383.87,"text":"群众工作是一个是一个中介"},{"start":384.26,"end":386.1,"text":"群众工作只是一个锻炼的机会"},{"start":386.1,"end":387.68,"text":"你一下子能做多少群众啊"},{"start":387.68,"end":389.92,"text":"14亿群众"},{"start":389.92,"end":391.56,"text":"你能做多少群众"},{"start":391.56,"end":393.7,"text":"13亿多群众"},{"start":396.36,"end":399.58,"text":"谁又和你又没有非常直接的利益关联"},{"start":399.58,"end":400.92,"text":"做了做来做去"},{"start":400.92,"end":402.43,"text":"这就花钱了事"},{"start":402.43,"end":405.39,"text":"花点说的是不是个赚点"},{"start":405.39,"end":408.57,"text":"说的事是可以锻炼他们的经经验啊"},{"start":408.57,"end":412.749,"text":"是可以让这些人成长提高啊"},{"start":412.749,"end":416.169,"text":"或者说内心更加坚定啊"},{"start":416.169,"end":418.349,"text":"做事情更讲究方法和策略"},{"start":418.349,"end":424.21,"text":"但是呢首先要做的不是说要练这些人啊"},{"start":424.21,"end":425.77,"text":"锻炼自己的人"},{"start":425.77,"end":427.99,"text":"首先你要说要有自己的人"},{"start":427.99,"end":431.03,"text":"要有本来不太合格"},{"start":431.03,"end":432.47,"text":"差一点点合格的人"},{"start":432.47,"end":435.35,"text":"让他变成合格的自己人"},{"start":436.04,"end":436.72,"text":"明白吗"},{"start":436.72,"end":439.08,"text":"所以首要的不是做所谓的群众工作"},{"start":439.08,"end":440.58,"text":"做来做去啊"},{"start":440.58,"end":443.12,"text":"然后打这个群众工作的幌子是谁"},{"start":443.12,"end":444.78,"text":"但凡只要做了点群众工作"},{"start":444.78,"end":446.78,"text":"你就要拉他入伙吗"},{"start":446.919,"end":448.439,"text":"你要带她玩吗"},{"start":448.439,"end":451.239,"text":"你不被道德绑架了吗"},{"start":451.48,"end":453.26,"text":"你还有你自己的门槛吗"},{"start":453.26,"end":456.76,"text":"你还想不想就是说在能力适配啊"},{"start":456.76,"end":460.3,"text":"在意识形态适配在这个正儿八经啊"},{"start":460.3,"end":463.26,"text":"就是分工协作的前提条件下"},{"start":463.26,"end":464.26,"text":"把你的事情做成"},{"start":464.26,"end":466.73,"text":"还是就是任由这些人胡作非为"},{"start":466.73,"end":468.15,"text":"不叫胡作非为"},{"start":468.15,"end":471.77,"text":"他就是用他的一点点所作所为就可以绑架你"},{"start":471.77,"end":473.33,"text":"无无纪律"},{"start":474.42,"end":476.42,"text":"你们到底想不想把事情做成"},{"start":477.62,"end":479.02,"text":"如果是想把事情做成"},{"start":479.02,"end":481.4,"text":"那就要讲组织学"},{"start":481.4,"end":484.0,"text":"那就要讲实事求是讲"},{"start":484.0,"end":487.38,"text":"就要讲要德位相符"},{"start":488.72,"end":491.48,"text":"能者居上啊"},{"start":491.8,"end":495.08,"text":"但是是在平等的大前提下的"},{"start":495.08,"end":496.04,"text":"能者居上"},{"start":496.04,"end":499.629,"text":"这个上就是说优先去承担更重要的工作"},{"start":499.629,"end":502.849,"text":"优先去承担能力更适配的工作"},{"start":503.56,"end":506.72,"text":"这天然就会啊在不同的岗位上"},{"start":506.72,"end":512.24,"text":"在不同的这个负责的这个方向上区分开来"},{"start":513.6,"end":518.489,"text":"可能局部一些小的概率的情况之下呃"},{"start":518.489,"end":521.009,"text":"比如说像我我有的时候像啊"},{"start":521.009,"end":522.609,"text":"不能就是太特异化"},{"start":522.609,"end":525.15,"text":"不能就是太我去均衡一下"},{"start":525.15,"end":525.89,"text":"稍微均衡一下"},{"start":525.89,"end":529.29,"text":"但是大的方向上我不会改变它的趋势"},{"start":529.61,"end":532.35,"text":"大的方向上我是不会改变这一趋势的"},{"start":532.35,"end":533.55,"text":"那绝大部分人呢"},{"start":533.55,"end":536.61,"text":"就是其他能力都只能勉勉强合格"},{"start":536.61,"end":537.87,"text":"有两三项能力"},{"start":537.87,"end":539.57,"text":"我这是我可以容忍的"},{"start":539.57,"end":542.05,"text":"那我可以把短板补齐啊"},{"start":542.05,"end":543.33,"text":"只要稍微有点耐心"},{"start":543.33,"end":546.37,"text":"但是你如果说一半的能力都是短板"},{"start":546.37,"end":548.37,"text":"一半的心性素养方面"},{"start":548.37,"end":549.69,"text":"一半的这个生活习惯"},{"start":549.69,"end":551.5,"text":"心理习惯方面全是坑"},{"start":551.5,"end":553.78,"text":"那是没有办法的"},{"start":554.33,"end":556.19,"text":"那是没有办法的好吧"},{"start":556.19,"end":557.77,"text":"所以我再强调一遍"},{"start":557.77,"end":560.37,"text":"首先不是做群众工作"},{"start":561.81,"end":564.25,"text":"啊首先做的是什么工作"},{"start":564.25,"end":569.53,"text":"是你这个群体内部的人才的权重的工作"},{"start":570.05,"end":572.05,"text":"要协调好人才的权重"},{"start":572.05,"end":576.31,"text":"各方面都能够有相应的合适的人去负责"},{"start":576.89,"end":579.19,"text":"然后做这个工作的一个最重要的内核"},{"start":579.19,"end":581.39,"text":"是要有足够的合格的人手"},{"start":581.39,"end":582.21,"text":"合格的人手"},{"start":582.21,"end":584.61,"text":"那就是说你直接完全合格的"},{"start":584.61,"end":585.09,"text":"不可能啊"},{"start":585.09,"end":586.17,"text":"他直接去职场了"},{"start":586.17,"end":586.87,"text":"对不对"},{"start":586.87,"end":591.32,"text":"相对合格的这些人那个有这么个简单方法给它"},{"start":591.32,"end":592.18,"text":"像是这样"},{"start":592.18,"end":594.32,"text":"就像我们卖的M250显卡一样"},{"start":594.32,"end":595.42,"text":"稍微给他调一调"},{"start":595.42,"end":596.6,"text":"它就能用了"},{"start":596.6,"end":597.7,"text":"性能还很好"},{"start":597.7,"end":599.22,"text":"其他还有很大的长处"},{"start":599.22,"end":603.569,"text":"这么一个比较朴素的思路行吧"},{"start":603.569,"end":607.289,"text":"你说哈第一步就要做群众工作"},{"start":608.21,"end":611.53,"text":"你把现在这个泥泞中汪洋大海里"},{"start":611.53,"end":612.51,"text":"把自己献没了"},{"start":612.51,"end":615.76,"text":"溶解掉了好吧"},{"start":616.08,"end":617.96,"text":"什么什么准备都没有"},{"start":617.96,"end":622.04,"text":"什么样的就是不可溶解性都没有的情况之下"},{"start":622.89,"end":624.09,"text":"都去做群众工作"},{"start":624.09,"end":625.21,"text":"那你回回老家"},{"start":625.21,"end":626.65,"text":"回高老庄一样有什么区别"},{"start":626.65,"end":627.41,"text":"这是逃避"},{"start":627.41,"end":630.13,"text":"这实际上是在逃避工作呃"},{"start":630.13,"end":633.79,"text":"逃避这个专门的职业的"},{"start":633.79,"end":636.17,"text":"然后协作的分工的"},{"start":636.17,"end":637.45,"text":"彼此信任的"},{"start":637.45,"end":640.78,"text":"有纪律的工作啊"},{"start":640.78,"end":643.42,"text":"去用用所谓的浪漫主义的"},{"start":643.42,"end":644.92,"text":"道德主义的哈"},{"start":644.92,"end":649.19,"text":"奉献自我感动的所谓的群群众工作来逃避"},{"start":649.19,"end":650.79,"text":"刚刚更为繁重的"},{"start":650.79,"end":654.57,"text":"其实更为有利于群众长远利益的工作"},{"start":654.57,"end":656.16,"text":"逃避这些东西"},{"start":656.16,"end":658.82,"text":"那这样是一种投降主义啊"},{"start":658.82,"end":659.92,"text":"是一种投降主义"},{"start":659.92,"end":665.09,"text":"投降在内心的道德情感层面的些微的安定当中"},{"start":665.09,"end":668.71,"text":"那么这是被小三爷里的文化啊给收买"},{"start":668.71,"end":670.77,"text":"道德主义文化给收买了的"},{"start":670.77,"end":673.43,"text":"那么从精神层面就可以说是某种叛徒"},{"start":673.43,"end":675.37,"text":"虽然他看上去好像他最没有背叛"},{"start":675.37,"end":677.44,"text":"实际上他已经是叛徒了啊"},{"start":677.72,"end":678.86,"text":"那就讲到这边"},{"start":678.86,"end":681.26,"text":"不要盲目的做所谓的群众工作"},{"start":681.26,"end":684.54,"text":"群众工作是在你的团队是相对已经比较成熟的"},{"start":684.54,"end":687.0,"text":"通过群众工作是让你的能力是提升的"},{"start":687.0,"end":688.94,"text":"但是能力提升的前提是"},{"start":688.94,"end":691.58,"text":"你这些人本身能力是合格的"},{"start":691.58,"end":692.46,"text":"能力不合格"},{"start":692.46,"end":693.34,"text":"我让你提升干什么"},{"start":693.34,"end":695.89,"text":"你滚能力不合格"},{"start":695.89,"end":697.74,"text":"不适配不匹配"},{"start":698.18,"end":699.82,"text":"还让你提升能力"},{"start":699.82,"end":701.62,"text":"这不浪费历史的机会"},{"start":701.62,"end":705.84,"text":"浪费这个团队的坑位啊行吧"},{"start":705.84,"end":707.06,"text":"那讲到这里啊"},{"start":707.06,"end":710.04,"text":"这个是很容易理解的一个道理"},{"start":710.04,"end":713.24,"text":"绝大部分小屁孩还想用这些东西来绑架我"},{"start":713.24,"end":714.78,"text":"来来批评我"},{"start":714.78,"end":716.26,"text":"多想一想吧好吧"},{"start":716.26,"end":717.2,"text":"那就讲到这里啊"}],"source":"subtitle"}
