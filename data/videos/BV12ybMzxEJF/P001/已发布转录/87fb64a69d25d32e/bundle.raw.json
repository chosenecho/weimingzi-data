{"segments":[{"start":1.04,"end":3.6,"text":"这个我们今天老师一直讲班第五"},{"start":3.6,"end":4.78,"text":"第五讲完是吧"},{"start":4.78,"end":9.91,"text":"扣五哲学基础的评价"},{"start":14.18,"end":16.059,"text":"你有四个"},{"start":16.059,"end":17.28,"text":"你没有四"},{"start":19.84,"end":21.76,"text":"今天讲的主题是"},{"start":21.76,"end":24.72,"text":"首先告诉你们今天主题是这个"},{"start":28.02,"end":30.36,"text":"意识形态啊"},{"start":47.82,"end":49.42,"text":"他们这个词的构词法啊"},{"start":49.42,"end":51.86,"text":"就是什么理念理学啊"},{"start":53.1,"end":55.58,"text":"就是理念的罗格斯"},{"start":55.58,"end":56.83,"text":"理念的逻辑"},{"start":69.06,"end":72.84,"text":"但其实他不是理念的内在逻辑"},{"start":73.96,"end":74.94,"text":"而是理念"},{"start":74.94,"end":76.56,"text":"按照某种逻辑"},{"start":76.56,"end":79.99,"text":"他可以把自己"},{"start":81.38,"end":86.1,"text":"就这个你可以把它理解成就类似于他的病毒了"},{"start":86.78,"end":89.98,"text":"但是他不是就像电子病毒"},{"start":89.98,"end":91.25,"text":"电脑病毒"},{"start":91.25,"end":94.73,"text":"他就是idea一定要漏嘴"},{"start":94.73,"end":95.89,"text":"他是这样的"},{"start":95.89,"end":97.07,"text":"有关记得啊"},{"start":97.07,"end":101.2,"text":"他一定那你说黑格尔主义是黑格尔主义"},{"start":101.2,"end":106.1,"text":"是不是某种意识形态完整的黑格尔"},{"start":106.66,"end":110.84,"text":"黑格尔他编制了整个理念的这个转变史"},{"start":110.84,"end":112.38,"text":"变化史"},{"start":113.17,"end":116.37,"text":"甚至说把整个这个罗格斯的这个冒险"},{"start":116.37,"end":118.66,"text":"全都呈现出来了"},{"start":119.26,"end":121.1,"text":"那么黑格尔有没有他的意识形态"},{"start":122.1,"end":127.49,"text":"有啊有黑格尔主义的意识形态就是无动于衷"},{"start":127.49,"end":129.05,"text":"不干事"},{"start":129.05,"end":132.65,"text":"或者就是这个知识分子的学院化"},{"start":132.65,"end":136.64,"text":"对黑格尔的哲学对应的意识形态是这种东西"},{"start":136.64,"end":142.149,"text":"那么这个词它的意味实际上是呃"},{"start":142.149,"end":148.72,"text":"思想家围绕着片面的局部的一个两个的理念"},{"start":148.72,"end":152.25,"text":"然后去衍生出一道化学"},{"start":152.61,"end":156.959,"text":"就好像就是说用一小段DNA或者RNA"},{"start":157.199,"end":162.539,"text":"然后去转译出翻译出一堆蛋白质外壳"},{"start":162.539,"end":166.9,"text":"然后这些蛋白质外壳可以欺骗细胞"},{"start":167.18,"end":169.18,"text":"就进入到这个细胞里面去"},{"start":169.18,"end":172.67,"text":"欺骗细胞表面的那个受体"},{"start":172.95,"end":174.63,"text":"可能就是欺骗你的大脑"},{"start":174.63,"end":175.87,"text":"欺骗你的常识"},{"start":175.87,"end":177.27,"text":"欺骗你的思维"},{"start":177.27,"end":182.42,"text":"让你去接受这种意识形态当中所包含的"},{"start":182.42,"end":183.94,"text":"这个理念的片面性"},{"start":183.94,"end":186.079,"text":"刻意性孤立性"},{"start":186.439,"end":193.35,"text":"为什么说他就是听说是用一种特殊的话术话语"},{"start":193.35,"end":195.09,"text":"编织起来的"},{"start":195.09,"end":197.87,"text":"偏狭的局部的理念"},{"start":197.87,"end":199.65,"text":"就是意识形态一般的"},{"start":199.65,"end":202.53,"text":"我们理解就是这样的这个话术包裹起来的"},{"start":202.53,"end":205.37,"text":"一个里面有一个有个点子"},{"start":205.37,"end":206.23,"text":"有个想法"},{"start":206.23,"end":207.91,"text":"但这个是有毒的"},{"start":207.91,"end":210.71,"text":"病毒一样侵入到你的机体当中"},{"start":210.71,"end":214.81,"text":"这个词的构词法一样高的啊"},{"start":214.81,"end":217.09,"text":"我上一次讲完了"},{"start":217.09,"end":219.27,"text":"叫你们去读了那个小说"},{"start":219.27,"end":219.89,"text":"是香水"},{"start":219.89,"end":221.6,"text":"对不对"},{"start":223.58,"end":229.75,"text":"那么现在你们知道为什么叫你们读这个小说了"},{"start":230.27,"end":235.53,"text":"那个主人公从女人的尸体上面用什么油啊"},{"start":235.53,"end":237.35,"text":"给它淹死是吧"},{"start":237.35,"end":242.8,"text":"嗯浸泡出来的这个香水很香的气味"},{"start":242.8,"end":244.25,"text":"这是什么东西"},{"start":244.69,"end":246.09,"text":"对应在那个时代"},{"start":246.09,"end":249.59,"text":"那个时代的这个作家为什么会写出这样的作品"},{"start":249.59,"end":252.26,"text":"实际上他就对应的就是历史惨"},{"start":252.26,"end":255.12,"text":"那么哲学家在那个时代扮演的角色"},{"start":255.12,"end":260.279,"text":"就是从生活当中去蒸馏出历史形象"},{"start":261.2,"end":266.3,"text":"意识形态弥散在20世纪的人类社会当中"},{"start":266.3,"end":269.04,"text":"它就产生了非常恐怖的作用"},{"start":269.04,"end":271.09,"text":"它的作用是什么"},{"start":271.37,"end":273.73,"text":"他最后打翻了那个蒸馏出来的东西"},{"start":273.73,"end":275.81,"text":"整个广场的人全都迷醉了"},{"start":275.81,"end":276.17,"text":"疯狂"},{"start":276.17,"end":277.61,"text":"最后去把他尸体给吃掉了"},{"start":277.61,"end":278.49,"text":"对不对"},{"start":278.49,"end":281.78,"text":"完了直接下尸体全都吃掉了啊"},{"start":281.815,"end":287.66,"text":"他的导致的结果就是总体化的恐怖啊"},{"start":305.82,"end":308.26,"text":"总体化的恐怖哲学"},{"start":308.26,"end":310.66,"text":"融为一个意识形态和意识形态驱动"},{"start":310.66,"end":315.61,"text":"去构造一个对于一切的无所不包的一种解释"},{"start":315.61,"end":320.78,"text":"就好像这个香水弥散在空气当中"},{"start":320.78,"end":322.72,"text":"侵入到广场上"},{"start":322.72,"end":325.62,"text":"每一个人的这个神经系统"},{"start":325.62,"end":328.66,"text":"对他进行一个爱欲上的极化"},{"start":329.48,"end":331.1,"text":"哲学家在这个过程当中"},{"start":331.1,"end":332.48,"text":"最后被啃食啊"},{"start":332.48,"end":333.46,"text":"被吃掉了"},{"start":333.46,"end":336.44,"text":"意味着哲学的死亡"},{"start":339.32,"end":341.12,"text":"哲学死在意识态当中"},{"start":342.44,"end":345.69,"text":"哲学死在他专门就是说啊"},{"start":345.69,"end":348.33,"text":"就是我们把20世纪的历史看成"},{"start":348.33,"end":352.19,"text":"就是由哲学家啊亲手"},{"start":352.19,"end":353.01,"text":"但你不要看"},{"start":353.01,"end":356.33,"text":"好像好像没有单个的具体哲学家实验理解他"},{"start":356.33,"end":356.83,"text":"有啊"},{"start":356.83,"end":358.599,"text":"列宁对不对啊"},{"start":358.599,"end":360.679,"text":"由哲学家亲手炮制的意识形态"},{"start":360.679,"end":363.779,"text":"驱动大众进行一个大规模的社会运动"},{"start":363.779,"end":365.11,"text":"获得政权"},{"start":365.11,"end":368.97,"text":"然后再用意时态驾驭这个巨大的工业机器"},{"start":368.97,"end":370.78,"text":"民族人口"},{"start":371.1,"end":375.6,"text":"最终呢由于本身被矮化"},{"start":381.54,"end":384.22,"text":"哲学话语就变成了一个分赃的"},{"start":384.22,"end":386.58,"text":"一个分论的分赃的一个体系"},{"start":386.58,"end":390.96,"text":"哲学的死亡是在疫形态当中死亡的"},{"start":390.96,"end":393.26,"text":"那我们这个时候就要说了"},{"start":393.26,"end":396.049,"text":"上次家人们讲的那个由爱"},{"start":396.049,"end":399.86,"text":"像这个智慧的一个过渡吧"},{"start":413.58,"end":417.78,"text":"我们上一讲讲了很多这个社会革命方案当中"},{"start":417.78,"end":420.74,"text":"爱向社会的过渡是通过什么来实现的"},{"start":420.74,"end":421.94,"text":"各式各样的"},{"start":421.94,"end":423.28,"text":"而是一个过渡"},{"start":423.28,"end":424.62,"text":"所以"},{"start":425.829,"end":428.029,"text":"主要的它是由什么"},{"start":428.029,"end":429.109,"text":"什非爱"},{"start":429.109,"end":429.989,"text":"对对对"},{"start":429.989,"end":430.909,"text":"爱的狗屁"},{"start":430.909,"end":433.39,"text":"我们讲了几种运动啊"},{"start":433.39,"end":440.3,"text":"要革命中间过度的爱的否定理性主义"},{"start":441.14,"end":444.4,"text":"但是的理性主义发展了20世纪"},{"start":445.0,"end":447.6,"text":"他进入了一种总体化的恐怖了"},{"start":447.6,"end":451.81,"text":"那么中间充当过度的东西"},{"start":451.81,"end":455.59,"text":"是比单纯的冰冷的算计性的理性"},{"start":455.59,"end":457.43,"text":"更为糟糕的东西"},{"start":458.34,"end":459.44,"text":"What is this"},{"start":459.44,"end":461.18,"text":"这是什么"},{"start":466.38,"end":469.88,"text":"通过死亡来过渡打架死"},{"start":475.2,"end":478.6,"text":"我们当然这个是不是那个样死亡"},{"start":478.6,"end":481.52,"text":"我们通常说这个这个加上两个字"},{"start":481.52,"end":483.56,"text":"然死亡区域"},{"start":487.0,"end":487.94,"text":"That's right"},{"start":487.94,"end":489.92,"text":"通过死亡区域来过渡"},{"start":489.92,"end":492.35,"text":"过渡到智慧啊"},{"start":493.07,"end":495.07,"text":"因为总体化的恐怖意味着"},{"start":496.39,"end":498.27,"text":"而且是被意识形态所驱动的"},{"start":498.27,"end":499.549,"text":"总体化的恐怖"},{"start":499.549,"end":502.949,"text":"这个时候我们就要区区分两种同体主义"},{"start":502.949,"end":505.849,"text":"我觉得有必要区分两种同体主义"},{"start":505.849,"end":510.18,"text":"当一个革命党两类零式的这种大"},{"start":510.18,"end":514.08,"text":"当他还处在一个贪婪性集结的过程当中"},{"start":514.08,"end":515.799,"text":"在自我动员的过程当中"},{"start":515.799,"end":520.859,"text":"他的总体属性是被哲学驱动的呃"},{"start":520.859,"end":525.06,"text":"是被具体的现实的判断计划所驱动的"},{"start":525.06,"end":528.04,"text":"是为了明确的斗争目标"},{"start":528.04,"end":531.5,"text":"明确的幸存策略所驱动的"},{"start":531.5,"end":532.46,"text":"所以这个时候"},{"start":532.46,"end":537.31,"text":"总体主义实际上是只是总体主义的暴力"},{"start":537.31,"end":540.69,"text":"而不是总体主义的宠物啊"},{"start":542.18,"end":544.02,"text":"他是中心放在一个暴雨"},{"start":545.74,"end":549.8,"text":"当这样的一个政党获得了政权"},{"start":551.0,"end":555.73,"text":"掌控了他本来所要去阳气的对面"},{"start":555.73,"end":561.89,"text":"把这对面同化为他自身维持统治的一部分"},{"start":561.89,"end":562.61,"text":"一个基础"},{"start":562.61,"end":563.71,"text":"一个依托的时候"},{"start":563.71,"end":565.73,"text":"他又从同体服的暴力来"},{"start":565.73,"end":568.03,"text":"转化成一种同体发的恐怖"},{"start":568.03,"end":571.85,"text":"恐怖之于暴力的差别是什么"},{"start":571.85,"end":575.53,"text":"我不意味着不知道暴力朝向什么"},{"start":576.57,"end":580.06,"text":"不意味着暴力的尺度的"},{"start":580.06,"end":583.45,"text":"届时暴力再怎么样"},{"start":583.69,"end":584.97,"text":"它是有对照的啊"},{"start":584.97,"end":585.95,"text":"什么是宁静的"},{"start":585.95,"end":586.81,"text":"相对宁静"},{"start":586.81,"end":587.63,"text":"它是有报复"},{"start":587.63,"end":590.819,"text":"那么恐怖呢是越临近越恐怖啊"},{"start":591.219,"end":594.66,"text":"也不知道这个尺度在哪里"},{"start":594.66,"end":596.18,"text":"总觉得暴力已经集结了"},{"start":596.18,"end":597.14,"text":"已经发生了"},{"start":597.14,"end":598.42,"text":"但是在恐怖当中"},{"start":598.42,"end":599.48,"text":"在宁静当中"},{"start":599.48,"end":601.38,"text":"你始终感受到他的再场"},{"start":601.38,"end":603.69,"text":"他不止这样一个明确的目标"},{"start":603.69,"end":607.13,"text":"他甚至都没有激发的迹象"},{"start":607.13,"end":611.039,"text":"红米化的恐怖就会呈现为还有好多种恐怖"},{"start":611.039,"end":611.639,"text":"白色恐怖"},{"start":612.499,"end":616.9,"text":"但意识形态的证明对了一下啊对吧"},{"start":618.48,"end":619.76,"text":"我们把它划掉"},{"start":620.88,"end":621.8,"text":"心情会划掉"},{"start":623.08,"end":627.25,"text":"那么在这里爱像智慧的一个过渡啊"},{"start":627.25,"end":629.51,"text":"他是经由这个死亡区域有过度"},{"start":629.51,"end":633.85,"text":"那么这个时候的这种哲学被叫做什么哲学呢"},{"start":633.85,"end":638.34,"text":"这种这个哲学是什么哲学"},{"start":640.17,"end":643.57,"text":"人本主义对比这狂野多"},{"start":643.57,"end":646.12,"text":"这个哲学就是这个"},{"start":649.58,"end":651.9,"text":"革命技术王"},{"start":653.56,"end":659.4,"text":"这所谓的这个所有的后现代哲学"},{"start":659.4,"end":664.97,"text":"都是伪装成哲学的革命技术判断术啊"},{"start":664.97,"end":665.85,"text":"还有这种技术"},{"start":666.89,"end":668.63,"text":"那么哲学沦为一种技术"},{"start":668.63,"end":673.349,"text":"是啊是哲学本上的死亡啊"},{"start":673.349,"end":675.809,"text":"作为革命技术的哲学"},{"start":675.809,"end":678.509,"text":"它是高于意识形态的哲学"},{"start":678.509,"end":684.03,"text":"要通过将自己降阶次跌落到革命技术的层次"},{"start":685.19,"end":688.35,"text":"从而维持他对意识形态的控制啊"},{"start":688.35,"end":693.11,"text":"意识形态意味着大众车"},{"start":694.1,"end":696.6,"text":"大众是被意识形态浸润的"},{"start":696.6,"end":702.51,"text":"而哲学呢哲学是被是被就是死死亡包裹"},{"start":702.51,"end":704.79,"text":"直接就是那个那个那个小说里面"},{"start":704.79,"end":706.61,"text":"被分尸的吃光了"},{"start":706.61,"end":708.25,"text":"那就是这样"},{"start":708.25,"end":710.25,"text":"绝对是这样骨架"},{"start":710.839,"end":713.239,"text":"尤其是只剩下他的骨架"},{"start":720.26,"end":725.43,"text":"你看看这说20世纪作为显学的哲学"},{"start":725.43,"end":727.53,"text":"剩下两个东西"},{"start":729.38,"end":730.14,"text":"现象学"},{"start":730.14,"end":732.9,"text":"现象学啊和这个分析哲学"},{"start":732.9,"end":735.63,"text":"他们的特点就都是骨架性"},{"start":735.63,"end":738.73,"text":"我方吧他只是骨头的对应"},{"start":738.73,"end":741.12,"text":"他没有肉啊"},{"start":741.12,"end":742.86,"text":"没有明确的技术性"},{"start":742.86,"end":745.52,"text":"诶你说为什么他们是革命技术呢"},{"start":745.52,"end":747.78,"text":"而你从基础上面"},{"start":747.78,"end":751.12,"text":"主体性的发生到这个语言交往范式"},{"start":751.12,"end":752.92,"text":"再到什么身体意象"},{"start":752.92,"end":754.33,"text":"什么专业"},{"start":754.33,"end":758.23,"text":"再到具体的一些社群里面的一些初步的规则"},{"start":758.23,"end":761.069,"text":"哲学可以经由社会学"},{"start":761.069,"end":763.109,"text":"经由心呃现象学"},{"start":763.109,"end":763.709,"text":"心理学进行"},{"start":763.709,"end":766.73,"text":"心理学可以演进到一个有计划"},{"start":766.73,"end":768.31,"text":"有完整计划"},{"start":768.31,"end":771.53,"text":"深刻预谋的革命技术"},{"start":773.38,"end":777.97,"text":"知识分子沿袭这些哲学的目的是非常明确的"},{"start":778.61,"end":780.61,"text":"随时准备判断"},{"start":781.55,"end":783.51,"text":"就是你在这意义上讲"},{"start":783.51,"end":785.95,"text":"这个西欧的哲学知识分子呢"},{"start":785.95,"end":790.73,"text":"他是高昂的头颅在堕落"},{"start":791.52,"end":794.5,"text":"这东西在学院上他肯定不会这样承认嘛"},{"start":794.5,"end":796.79,"text":"因为他要继续评论"},{"start":797.59,"end":803.19,"text":"还有这个虚弱知识分子的威人协助啊"},{"start":803.78,"end":806.18,"text":"那么伴行的这个过程"},{"start":806.18,"end":809.12,"text":"我们要讲述的是"},{"start":810.5,"end":813.26,"text":"啊我们用类比来讲述这个过程"},{"start":814.94,"end":817.92,"text":"不能说是灵感来"},{"start":822.7,"end":825.8,"text":"这个时候的爱哲学的爱"},{"start":825.8,"end":828.31,"text":"爱的对象是什么"},{"start":829.07,"end":830.95,"text":"这是爱情吧"},{"start":832.2,"end":833.72,"text":"由于它导向的是死亡"},{"start":833.72,"end":836.74,"text":"他中介的是由死亡驱力在中介"},{"start":836.74,"end":839.42,"text":"这个时候的哲学的爱是一种自恋性的爱"},{"start":839.42,"end":841.17,"text":"来明确告诉你们"},{"start":846.56,"end":847.86,"text":"是一种自恋型的爱"},{"start":847.86,"end":850.28,"text":"也是一种自毁性的爱"},{"start":854.78,"end":857.7,"text":"这个时候的哲学的主要工作就是干什么"},{"start":858.7,"end":861.34,"text":"蒸馏和炮制意识形态"},{"start":870.82,"end":872.7,"text":"蒸馏和那个桃子一形态啊"},{"start":872.7,"end":876.16,"text":"我们用调制调制毛背一形态"},{"start":876.28,"end":881.36,"text":"获得百分96378282"},{"start":890.44,"end":894.92,"text":"所以这样的爱会以死亡为驱离"},{"start":896.32,"end":897.38,"text":"来过度"},{"start":897.38,"end":900.78,"text":"因为是一种自恋的自毁性的爱"},{"start":900.78,"end":902.9,"text":"哲学家在这个过程当中"},{"start":902.9,"end":910.129,"text":"实际上是从根本上是把对于终极理想"},{"start":911.209,"end":916.569,"text":"终极的安定的想象是抛掷出去了"},{"start":916.9,"end":919.7,"text":"他不再经由自己的思维的官能"},{"start":919.7,"end":921.829,"text":"去试图回答这个问题"},{"start":922.429,"end":923.809,"text":"而期待着历史"},{"start":923.809,"end":925.549,"text":"期待着命运给他一个答案"},{"start":925.549,"end":928.169,"text":"所以这种自恋性的自毁的爱的背后"},{"start":928.169,"end":929.969,"text":"实际上是什么"},{"start":929.969,"end":931.555,"text":"是一种期待啊"},{"start":932.09,"end":933.33,"text":"那不是爱命运"},{"start":933.33,"end":935.81,"text":"是期待着命运爱他"},{"start":937.38,"end":939.54,"text":"不知道我怕冷"},{"start":939.54,"end":941.5,"text":"不会太吃完了"},{"start":944.82,"end":945.82,"text":"好期待人"},{"start":945.82,"end":947.54,"text":"另一个爱他"},{"start":949.78,"end":953.38,"text":"那么还是结合那个小说里面评价过这个形象"},{"start":954.76,"end":959.41,"text":"他不知道他调味这些东西有没用"},{"start":960.01,"end":961.79,"text":"那明显不是生命的气息"},{"start":961.79,"end":963.15,"text":"还是死亡的气息"},{"start":963.15,"end":966.539,"text":"因为那个那个气息是那个女人"},{"start":966.539,"end":969.539,"text":"在这个是那个什么油是吧"},{"start":969.539,"end":971.339,"text":"油脂浸泡的时候"},{"start":971.339,"end":974.05,"text":"恐惧濒死的之后"},{"start":974.05,"end":976.89,"text":"濒死的瞬间散发出来那个气味"},{"start":976.89,"end":979.66,"text":"不是他常态的一个气味"},{"start":981.36,"end":983.02,"text":"但期待着命运之爱"},{"start":983.02,"end":989.069,"text":"是在一种放弃了自身的自信尊严"},{"start":991.18,"end":993.86,"text":"放弃了自信尊严"},{"start":1002.12,"end":1005.0,"text":"嗯然后蒸馏调配意识形态"},{"start":1005.0,"end":1010.02,"text":"把哲学作为意识形态的蒸馏术和调配数"},{"start":1010.74,"end":1012.46,"text":"量子操作"},{"start":1015.68,"end":1021.56,"text":"那么典型人物是谁嗯"},{"start":1021.56,"end":1026.369,"text":"就是那个top four里面最后受审的时候"},{"start":1026.369,"end":1027.25,"text":"一句话不说的"},{"start":1028.29,"end":1031.339,"text":"一句话不说的那一位典型人物啊"},{"start":1031.339,"end":1036.098,"text":"就是the the four那四个里面受审判的时候"},{"start":1036.098,"end":1038.279,"text":"一句话都不说的那个那个逼"},{"start":1038.279,"end":1040.138,"text":"而他也是活的最久的"},{"start":1040.138,"end":1041.3,"text":"都是九"},{"start":1041.3,"end":1043.54,"text":"我也就在在这"},{"start":1043.54,"end":1045.098,"text":"生命是活的最久"},{"start":1045.499,"end":1048.378,"text":"他的理论基础也是最好的"},{"start":1050.419,"end":1051.8,"text":"他"},{"start":1055.36,"end":1058.54,"text":"那么他抵达这个智慧"},{"start":1059.1,"end":1061.66,"text":"首先我们这个时候要来研究一下这个制度"},{"start":1061.66,"end":1063.88,"text":"这个制度是他本人获取的吗"},{"start":1064.2,"end":1065.06,"text":"爱智慧"},{"start":1065.06,"end":1065.92,"text":"爱智慧"},{"start":1065.92,"end":1069.98,"text":"这个时候才产展现出哲学的真相"},{"start":1069.98,"end":1072.83,"text":"哲学只是爱智慧"},{"start":1072.83,"end":1075.01,"text":"他不想获得什么"},{"start":1075.01,"end":1077.08,"text":"甚至说"},{"start":1078.9,"end":1079.96,"text":"在这里"},{"start":1079.96,"end":1088.82,"text":"哲学对于智慧的爱是一种是一种都这样子啊"},{"start":1091.48,"end":1098.29,"text":"召唤这些召唤智慧哲学"},{"start":1098.29,"end":1099.45,"text":"通过什么来召唤"},{"start":1100.73,"end":1103.03,"text":"那为什么要把意识形态普及开来"},{"start":1103.03,"end":1105.13,"text":"散发出去"},{"start":1106.46,"end":1109.94,"text":"也就是说他并不试图去占有自己"},{"start":1109.94,"end":1111.58,"text":"他不再占有智慧了"},{"start":1111.58,"end":1113.46,"text":"不要智慧了"},{"start":1113.62,"end":1116.3,"text":"但是我要智慧听懂这个意思吗"},{"start":1116.3,"end":1117.38,"text":"我不要智慧了"},{"start":1117.38,"end":1120.38,"text":"我要智慧意味着什么"},{"start":1120.38,"end":1122.02,"text":"我要你存在"},{"start":1122.02,"end":1123.28,"text":"要你现身"},{"start":1123.28,"end":1124.42,"text":"要你出现"},{"start":1124.42,"end":1126.35,"text":"让你出来"},{"start":1126.91,"end":1127.79,"text":"他在呼唤"},{"start":1127.79,"end":1129.11,"text":"有什么"},{"start":1132.4,"end":1134.32,"text":"自然的智慧"},{"start":1136.6,"end":1138.6,"text":"自然的均衡性"},{"start":1138.6,"end":1139.72,"text":"本"},{"start":1147.4,"end":1149.96,"text":"我们的脑袋里没有想起"},{"start":1152.28,"end":1155.23,"text":"大乱才有大治嗯"},{"start":1155.23,"end":1160.39,"text":"就是大致就是去追求一种自然智慧"},{"start":1160.39,"end":1164.12,"text":"在人类社会当中的自动的显现"},{"start":1164.12,"end":1168.24,"text":"但是不是自动显现是被逼迫的"},{"start":1169.04,"end":1173.02,"text":"相当于说人为的去混乱"},{"start":1173.02,"end":1176.82,"text":"施加在这个人类的社群的社会话语当中"},{"start":1176.82,"end":1177.84,"text":"施加混乱"},{"start":1177.84,"end":1183.36,"text":"施加一种必然使得自然的生活方式失衡的混乱"},{"start":1184.58,"end":1188.3,"text":"生产啊这种混乱"},{"start":1190.88,"end":1194.64,"text":"这种混乱使得生活失衡了"},{"start":1201.52,"end":1204.92,"text":"然后逼迫着生活重新恢复他的健康"},{"start":1206.0,"end":1208.97,"text":"因为像你妈就是需要锻炼身体"},{"start":1208.97,"end":1211.61,"text":"那么这样一种哲学努力"},{"start":1211.61,"end":1215.11,"text":"哲学尝试是把人类机体看成一具身体"},{"start":1215.11,"end":1218.01,"text":"却操练它机械的方式"},{"start":1218.01,"end":1218.57,"text":"操练它"},{"start":1218.57,"end":1219.13,"text":"神毁它"},{"start":1220.13,"end":1223.47,"text":"然后去期待他的代偿"},{"start":1223.47,"end":1226.51,"text":"或者说更为强健的恢复"},{"start":1226.51,"end":1229.13,"text":"更为强健的一个增长"},{"start":1229.29,"end":1230.79,"text":"这样一种智慧啊"},{"start":1230.79,"end":1234.53,"text":"这样增长过的智慧就被看成是什么政治"},{"start":1234.53,"end":1236.03,"text":"文明的进步"},{"start":1236.03,"end":1237.53,"text":"政治的发展"},{"start":1237.53,"end":1240.07,"text":"这是一种反向的"},{"start":1240.07,"end":1241.69,"text":"什么助产术"},{"start":1241.69,"end":1243.27,"text":"而不是助产术"},{"start":1243.27,"end":1245.315,"text":"是锻炼术"},{"start":1246.18,"end":1247.62,"text":"在这个过程当中"},{"start":1247.62,"end":1254.82,"text":"哲学家的实验是怎么样悲剧性的处在自恋当中"},{"start":1255.52,"end":1257.68,"text":"自毁性的字典当中"},{"start":1258.31,"end":1261.17,"text":"哲学家是作为革命家"},{"start":1261.17,"end":1265.64,"text":"革命理论家以及不负责任的"},{"start":1265.64,"end":1268.2,"text":"大众意识形态的散播者"},{"start":1268.2,"end":1271.82,"text":"和甚至说把人类变成动物"},{"start":1271.82,"end":1275.84,"text":"动物园里面动物去制造刻板行为"},{"start":1277.24,"end":1279.22,"text":"让他们的生活一塌糊涂"},{"start":1279.22,"end":1280.9,"text":"陷于混乱"},{"start":1281.06,"end":1282.6,"text":"就这样去实践"},{"start":1282.6,"end":1285.5,"text":"然后期待着等他死了之后"},{"start":1285.5,"end":1288.22,"text":"如在他的政治权利被剥夺"},{"start":1288.22,"end":1289.1,"text":"剥削了之后"},{"start":1289.1,"end":1290.51,"text":"剥夺之"},{"start":1292.68,"end":1296.63,"text":"命运能够重新展示对于人类的爱"},{"start":1296.99,"end":1299.88,"text":"我说人类以某种方式恢复自身的平衡"},{"start":1299.88,"end":1301.68,"text":"这种哲学"},{"start":1301.68,"end":1307.44,"text":"它背后其实隐含着非常深重的人类中心主义"},{"start":1317.12,"end":1319.14,"text":"极为深重的人类中心主义"},{"start":1319.14,"end":1320.76,"text":"但是这种人类中心主义"},{"start":1320.76,"end":1323.98,"text":"它掩藏在对于人类命运的不屑一顾"},{"start":1323.98,"end":1326.06,"text":"作嘛有一个字"},{"start":1328.84,"end":1330.6,"text":"桌子"},{"start":1332.12,"end":1334.92,"text":"他用很多字来来说这个缩是什么"},{"start":1337.32,"end":1341.07,"text":"与天道道奇到无穷"},{"start":1341.07,"end":1342.39,"text":"与地道奇到无穷"},{"start":1342.39,"end":1344.25,"text":"与人都齐"},{"start":1345.28,"end":1347.36,"text":"小霸王其乐无穷"},{"start":1353.54,"end":1356.56,"text":"那么所以我们说这样的哲学"},{"start":1356.56,"end":1360.74,"text":"他并没有看上去像这个20世纪的哲学"},{"start":1360.74,"end":1365.16,"text":"学科分类那样裂解的那么彻底"},{"start":1365.16,"end":1368.46,"text":"他甚至说并没有列举"},{"start":1368.46,"end":1370.26,"text":"而作为一个计划"},{"start":1370.26,"end":1372.1,"text":"就是在酝酿你"},{"start":1376.58,"end":1381.52,"text":"看上去人类的哲学在这时候变成了三种模式"},{"start":1381.52,"end":1382.96,"text":"中间的是革命"},{"start":1382.96,"end":1385.27,"text":"我们已经讲过了"},{"start":1386.06,"end":1388.7,"text":"上面的是现象学"},{"start":1393.88,"end":1396.4,"text":"然后是分析哲学"},{"start":1401.16,"end":1403.96,"text":"他们分别指向革命"},{"start":1403.96,"end":1407.08,"text":"当然我刚才说的指向生活"},{"start":1411.18,"end":1414.34,"text":"教学指向意识"},{"start":1416.26,"end":1419.02,"text":"把分哲学指向语言"},{"start":1424.16,"end":1428.16,"text":"在这里形成了一个哲学的前行公式"},{"start":1433.58,"end":1435.5,"text":"分析哲学对于语言"},{"start":1435.5,"end":1439.02,"text":"尤其是后面的日常语言的精密分析"},{"start":1439.02,"end":1442.94,"text":"为意识形态的炮制提供了方法"},{"start":1442.94,"end":1445.22,"text":"计量学对于意识"},{"start":1445.22,"end":1448.18,"text":"对于身体性啊"},{"start":1448.18,"end":1450.9,"text":"这对于是文化社会学的经济分析"},{"start":1450.9,"end":1454.3,"text":"为一时一代的炮制提供了材料"},{"start":1454.3,"end":1456.26,"text":"哲学啊作为革命"},{"start":1456.26,"end":1460.06,"text":"它直接就是意识形态的运用侵入到生活当中去"},{"start":1460.06,"end":1462.34,"text":"所以这是哲学的一个什么啊"},{"start":1462.34,"end":1468.86,"text":"嗯我来说一个生化计划"},{"start":1470.88,"end":1473.68,"text":"生化性质的一个计划"},{"start":1473.7,"end":1476.28,"text":"这是他的基因剪刀"},{"start":1476.28,"end":1478.82,"text":"他的那个性原体"},{"start":1480.14,"end":1485.57,"text":"这个就是他的这个一起啊"},{"start":1485.57,"end":1489.6,"text":"就是他的那个啊啊传传传传传播学"},{"start":1489.6,"end":1493.42,"text":"然后传过去是那个意向传播性病毒传播学"},{"start":1493.42,"end":1496.47,"text":"而且并没有消失"},{"start":1496.47,"end":1499.18,"text":"它的重要性呢是"},{"start":1500.52,"end":1502.6,"text":"不减反增的"},{"start":1512.82,"end":1516.54,"text":"实际上它对应的就是当时人类的三大阵营"},{"start":1516.54,"end":1520.7,"text":"分别就是说是这个苏东"},{"start":1522.84,"end":1523.88,"text":"就是革命"},{"start":1526.56,"end":1527.88,"text":"美国"},{"start":1530.52,"end":1533.4,"text":"啊为了这个语言啊"},{"start":1533.4,"end":1534.52,"text":"或者说是分析哲学"},{"start":1536.04,"end":1539.24,"text":"然后西欧的话又抱到线上学"},{"start":1544.92,"end":1548.48,"text":"哲学和大型的政治集群"},{"start":1549.48,"end":1557.67,"text":"政治实体结合来对人类进行精密手术啊"},{"start":1557.67,"end":1560.31,"text":"那么哲学这个时候就从革命技术在进步发展"},{"start":1560.31,"end":1566.03,"text":"变成了什么人口的控制数啊"},{"start":1567.03,"end":1568.99,"text":"人口控制论大"},{"start":1570.52,"end":1572.8,"text":"针对人口的控制论"},{"start":1581.14,"end":1585.6,"text":"像这样一种哲学的发端实际上是谁呢"},{"start":1588.88,"end":1591.32,"text":"这样一种哲学的发端"},{"start":1591.32,"end":1598.269,"text":"作以死亡作为爱到智慧的一个过度的"},{"start":1598.269,"end":1599.169,"text":"实际上是谁啊"},{"start":1600.369,"end":1601.089,"text":"博尔盖啊"},{"start":1602.329,"end":1603.789,"text":"小或者叫杜尔凯姆啊"},{"start":1603.789,"end":1605.054,"text":"博尔盖"},{"start":1607.18,"end":1609.0,"text":"是一个社社会学家"},{"start":1609.0,"end":1613.94,"text":"他的经典就叫论自杀啊"},{"start":1615.26,"end":1620.99,"text":"啊金牛这个对于自杀和犯罪社会性"},{"start":1620.99,"end":1624.15,"text":"社会性的取消自我存在的现象"},{"start":1624.15,"end":1627.23,"text":"去把握这个社会运行的机遇"},{"start":1627.23,"end":1631.67,"text":"像这种反向的否定性的去思考"},{"start":1631.67,"end":1633.87,"text":"去追寻智慧"},{"start":1634.41,"end":1638.08,"text":"这是理性主义的一个机制啊"},{"start":1638.08,"end":1640.2,"text":"林是走到一个极点"},{"start":1640.2,"end":1645.3,"text":"那我们感谢半个小时"},{"start":1645.3,"end":1648.22,"text":"我们这个时候要详细的讨论一下"},{"start":1648.22,"end":1652.1,"text":"这个王区域的问题"},{"start":1657.68,"end":1660.94,"text":"这个时候哲学的发展显然受到什么的束缚"},{"start":1660.94,"end":1662.08,"text":"什么叫约束"},{"start":1663.36,"end":1665.82,"text":"受到人类的自然寿命约束"},{"start":1673.18,"end":1675.82,"text":"人类有没有可能在这样的哲学探索当中"},{"start":1675.82,"end":1677.68,"text":"获得些什么"},{"start":1679.56,"end":1681.44,"text":"获得智慧有没有可能"},{"start":1683.16,"end":1687.89,"text":"当然有可能从社会恢复稳态"},{"start":1687.89,"end":1689.31,"text":"从意识形态混乱"},{"start":1689.31,"end":1694.55,"text":"或者说从刻意的人工的全局的思想"},{"start":1694.55,"end":1697.96,"text":"交往方式的操纵和介入当中"},{"start":1697.96,"end":1700.72,"text":"重新恢复它的自然形态"},{"start":1700.72,"end":1703.44,"text":"或者说生成一种新的规范性"},{"start":1703.76,"end":1708.08,"text":"身心的一种人类的这个自我循环"},{"start":1708.08,"end":1709.53,"text":"自我控制的方式"},{"start":1709.53,"end":1711.07,"text":"观察这个过程"},{"start":1711.07,"end":1713.96,"text":"当然能够产生制度"},{"start":1714.8,"end":1717.92,"text":"而且这个智慧是严格意义上"},{"start":1719.12,"end":1720.86,"text":"古希腊意义上的智慧"},{"start":1720.86,"end":1723.48,"text":"对于什么样的生活是值得过的"},{"start":1724.17,"end":1726.23,"text":"什么样的城邦是好的城邦"},{"start":1726.23,"end":1730.93,"text":"城邦应当去追求什么样的价值"},{"start":1732.52,"end":1737.69,"text":"但是这样的智慧它依然是奴隶主的智慧"},{"start":1737.69,"end":1739.39,"text":"是城邦的智慧"},{"start":1739.39,"end":1743.04,"text":"是西欧美国和苏联的智慧"},{"start":1743.48,"end":1749.88,"text":"是能够驾驭输出意识形态的国别的时"},{"start":1750.48,"end":1753.12,"text":"所以我们这个时候就不勉家去想了"},{"start":1753.12,"end":1758.63,"text":"那么那些亚非拉第三世界"},{"start":1760.67,"end":1762.99,"text":"他们的无智慧者呢"},{"start":1767.32,"end":1772.17,"text":"我们会看到20世纪的人类的那一部分"},{"start":1772.17,"end":1773.21,"text":"无智慧的那一部分"},{"start":1773.21,"end":1776.39,"text":"他们的生存是更为惨淡的"},{"start":1776.39,"end":1778.45,"text":"分别是在非洲"},{"start":1779.44,"end":1781.52,"text":"反复的种族仇杀"},{"start":1783.36,"end":1785.56,"text":"没有一点点文明的迹象"},{"start":1786.8,"end":1789.72,"text":"我们刚刚被我们批评的很丑陋的"},{"start":1789.72,"end":1790.76,"text":"什么总体主义恐怖"},{"start":1790.76,"end":1793.2,"text":"这些东西相比于他们"},{"start":1793.55,"end":1795.11,"text":"这已经算是天堂了"},{"start":1795.11,"end":1796.19,"text":"对不对"},{"start":1796.77,"end":1800.59,"text":"那么智慧依然屹立于无智慧"},{"start":1800.59,"end":1803.93,"text":"或者说无智慧的第三世界"},{"start":1803.93,"end":1805.41,"text":"南方世界"},{"start":1807.88,"end":1810.24,"text":"除非看起来是个对立面"},{"start":1810.91,"end":1814.65,"text":"是被看成对曰苏联"},{"start":1814.65,"end":1819.51,"text":"美国欧洲的恐怖也好"},{"start":1820.67,"end":1822.07,"text":"他自己的腐化堕落也罢"},{"start":1823.35,"end":1826.915,"text":"对于这种生活尚可接受的一种辩护"},{"start":1832.82,"end":1841.13,"text":"那么智慧难以在遥远的地方寻找它的对立面"},{"start":1841.13,"end":1842.37,"text":"当然也有啊"},{"start":1842.37,"end":1846.43,"text":"也就是说在这个时候哲学进行的一些努力"},{"start":1846.43,"end":1847.57,"text":"比如说哲学"},{"start":1847.57,"end":1849.01,"text":"人类学"},{"start":1854.66,"end":1855.18,"text":"哲学"},{"start":1855.18,"end":1859.64,"text":"人类学就是法国思想界是从什么里面长出来的"},{"start":1859.64,"end":1863.57,"text":"现象学和革命当中长出来的就两次"},{"start":1863.57,"end":1867.83,"text":"一个就是革命或者是政治合并和现象"},{"start":1867.83,"end":1869.27,"text":"是产"},{"start":1872.06,"end":1872.86,"text":"反过哲学"},{"start":1872.86,"end":1873.4,"text":"人类学"},{"start":1873.4,"end":1875.66,"text":"这些知识分子是会到他们的"},{"start":1875.66,"end":1879.0,"text":"第三世界的殖民地里面去啊"},{"start":1879.0,"end":1879.94,"text":"去研究"},{"start":1879.94,"end":1883.56,"text":"去了解到这个无智慧"},{"start":1883.56,"end":1885.64,"text":"也是一种智慧是怎么样的啊"},{"start":1885.64,"end":1888.9,"text":"反过来去对于这个智慧"},{"start":1888.9,"end":1893.79,"text":"这个时候的智慧其实是总体化的什么啊"},{"start":1893.79,"end":1896.1,"text":"这种总体化的学"},{"start":1897.04,"end":1899.68,"text":"只不过要意识到这个总体化的智慧"},{"start":1899.68,"end":1900.32,"text":"在这里"},{"start":1900.32,"end":1904.3,"text":"是就是通过我们刚刚讲的那个辩证法"},{"start":1904.3,"end":1905.44,"text":"生产出来的智慧"},{"start":1905.44,"end":1908.14,"text":"它不是它是真的智慧"},{"start":1908.14,"end":1909.67,"text":"意识到没有"},{"start":1909.67,"end":1911.35,"text":"It's real wisdom"},{"start":1911.35,"end":1911.99,"text":"真的是我看"},{"start":1911.99,"end":1913.09,"text":"但他整体化的"},{"start":1913.09,"end":1916.67,"text":"它是通过就是说哲学家炮制意识形态"},{"start":1916.67,"end":1919.17,"text":"然后去混乱"},{"start":1919.17,"end":1923.99,"text":"是这个动摇一个巨型数亿人口的"},{"start":1923.99,"end":1925.69,"text":"一个经济共同体"},{"start":1925.69,"end":1926.77,"text":"文化共同体"},{"start":1926.77,"end":1929.21,"text":"然后看他如何恢复在这个过程中"},{"start":1929.21,"end":1930.17,"text":"知识分子来"},{"start":1930.17,"end":1934.67,"text":"或者说当政者去总结这个恢复过程当中的额"},{"start":1934.67,"end":1936.005,"text":"这个"},{"start":1937.66,"end":1939.86,"text":"规律它是形成智慧"},{"start":1939.86,"end":1940.94,"text":"但是是总体化"},{"start":1940.94,"end":1944.14,"text":"就总体化是是自然的"},{"start":1944.14,"end":1945.1,"text":"总体化的"},{"start":1945.1,"end":1949.15,"text":"是在这个机体恢复过程当中所积攒下来的"},{"start":1949.47,"end":1951.29,"text":"稳态恢复的智慧"},{"start":1951.29,"end":1954.7,"text":"这种智慧是非常强大的"},{"start":1963.1,"end":1965.26,"text":"这个时候欧洲的哲学"},{"start":1965.26,"end":1970.87,"text":"人类学通过去接触亚非拉的无智慧"},{"start":1970.87,"end":1972.25,"text":"记住它对立面"},{"start":1972.25,"end":1974.71,"text":"包括还有这个精神分析"},{"start":1974.71,"end":1977.38,"text":"他过程当中还有"},{"start":1979.88,"end":1982.12,"text":"疯狂啊"},{"start":1985.04,"end":1990.06,"text":"在西欧社会当中普遍蔓延的歇斯底里地震啊"},{"start":1990.06,"end":1992.03,"text":"还有这个精神倒错"},{"start":1992.23,"end":1994.41,"text":"以这些东西作为对立面"},{"start":1994.41,"end":1998.92,"text":"他们想戳破的就是啊黑化的趋势"},{"start":1998.92,"end":1999.9,"text":"智慧的总体性"},{"start":2001.02,"end":2005.56,"text":"智慧的总体性其实是一种恢复"},{"start":2005.56,"end":2008.11,"text":"而且是一种局部的恢复"},{"start":2008.71,"end":2012.95,"text":"而且是一种非常非常困难的"},{"start":2012.95,"end":2014.53,"text":"勉励的一种局部回复"},{"start":2014.53,"end":2017.905,"text":"就是这个社会机体的内在稳态的局部回"},{"start":2018.72,"end":2022.88,"text":"而且这种恢复呢实际上是非常惨痛的"},{"start":2022.88,"end":2023.44,"text":"非常痛苦"},{"start":2023.44,"end":2024.36,"text":"你觉得是吗"},{"start":2024.36,"end":2026.77,"text":"俄国这个疗法之后啊"},{"start":2026.77,"end":2029.69,"text":"他只是被自由主义形态给击垮了"},{"start":2029.69,"end":2032.75,"text":"然后他重新恢复他的那个同体性"},{"start":2032.75,"end":2034.17,"text":"现在不是德国哦"},{"start":2034.17,"end":2036.839,"text":"不现在是资金当政"},{"start":2036.839,"end":2037.159,"text":"对不对"},{"start":2038.199,"end":2041.099,"text":"这个总体性难道就是完备的吗"},{"start":2041.099,"end":2042.579,"text":"当然不是完备的"},{"start":2042.579,"end":2045.05,"text":"他的经济模式啊"},{"start":2045.05,"end":2046.93,"text":"或者他的这个文化形态呀"},{"start":2046.93,"end":2052.71,"text":"一大程度上就是依赖于这个德国的往日"},{"start":2052.71,"end":2054.51,"text":"荣光的恢复"},{"start":2058.44,"end":2062.84,"text":"所以我们要看到就是说死亡的趋利"},{"start":2065.599,"end":2069.409,"text":"他现在呈现为什么一呈现为死亡"},{"start":2069.409,"end":2071.889,"text":"就是呈现为赤裸裸的死亡"},{"start":2072.929,"end":2075.449,"text":"那么他出现在哪里"},{"start":2076.119,"end":2077.239,"text":"出现在亚排"},{"start":2077.239,"end":2079.958,"text":"当出现在那些混乱的打内战地方"},{"start":2079.958,"end":2083.559,"text":"那些和枪支无限泛滥的啊"},{"start":2083.559,"end":2091.81,"text":"那些不被整体化的这个我的智慧给看固的地方"},{"start":2091.81,"end":2094.469,"text":"咱们这总体化的智慧难道好在哪里吗"},{"start":2094.469,"end":2096.58,"text":"这东西真的很好吗"},{"start":2096.58,"end":2099.1,"text":"有没有人可以告诉我这个总体化的智慧"},{"start":2099.1,"end":2101.0,"text":"具体的现实的是什么东西"},{"start":2101.0,"end":2102.279,"text":"What it is"},{"start":2102.599,"end":2104.359,"text":"就是想搞"},{"start":2105.76,"end":2108.44,"text":"这个东西是全球资本主义分工"},{"start":2108.44,"end":2111.54,"text":"格罗布开头的分布"},{"start":2112.02,"end":2114.62,"text":"从意识形态当中"},{"start":2114.62,"end":2119.03,"text":"混乱当中恢复过来的这个共同体集体"},{"start":2119.03,"end":2121.47,"text":"无一例外地把自己注册到了全球"},{"start":2121.47,"end":2125.58,"text":"资本主义的对供求分工体系"},{"start":2127.1,"end":2130.1,"text":"非常典型的就是"},{"start":2133.24,"end":2134.24,"text":"明白吗"},{"start":2134.24,"end":2135.68,"text":"就是极为典型"},{"start":2135.68,"end":2136.28,"text":"非常典型"},{"start":2137.95,"end":2141.19,"text":"他其实是现在总结"},{"start":2141.19,"end":2144.64,"text":"可以把它叫做是北方霸权啊"},{"start":2150.0,"end":2152.279,"text":"那么北半球的霸权"},{"start":2152.279,"end":2155.859,"text":"我说人类的这个工业化的人口"},{"start":2155.859,"end":2157.159,"text":"工业化的社会体系"},{"start":2157.159,"end":2159.679,"text":"它维持了一个全球资本主义发展"},{"start":2160.85,"end":2165.29,"text":"那么他把他之间的之前的那个中介项"},{"start":2165.29,"end":2169.14,"text":"拆解开了一半成为死亡"},{"start":2169.3,"end":2173.06,"text":"那么直接就是在无智慧的亚飞刀啊"},{"start":2173.06,"end":2175.52,"text":"另外一半呢就是作为曲里"},{"start":2179.54,"end":2182.1,"text":"那么这种曲率由于它不是死亡区域"},{"start":2182.1,"end":2184.13,"text":"它不是洁净的"},{"start":2184.13,"end":2186.65,"text":"这种区域是混乱的"},{"start":2186.65,"end":2187.71,"text":"是不是肮脏的"},{"start":2187.71,"end":2190.2,"text":"那它就是作为什么"},{"start":2191.0,"end":2192.7,"text":"享乐再明确一点"},{"start":2192.7,"end":2194.84,"text":"作为倒数的享乐"},{"start":2196.58,"end":2199.97,"text":"啧作一首pervert"},{"start":2199.97,"end":2205.63,"text":"倒错的享乐是弥漫浸润在他自己的机体当中的"},{"start":2205.63,"end":2209.95,"text":"总体化的智慧的这个表面的统治之下"},{"start":2209.95,"end":2211.859,"text":"是欧洲"},{"start":2211.859,"end":2214.41,"text":"亚洲和这个北美"},{"start":2214.41,"end":2217.77,"text":"总体的都处在一种倒错的想法当中"},{"start":2217.77,"end":2219.58,"text":"而这个区域是无限的"},{"start":2219.58,"end":2221.92,"text":"这个区域是不断被生产出来的"},{"start":2221.92,"end":2224.58,"text":"只要这个这个辩证法一直在运行"},{"start":2224.58,"end":2227.98,"text":"只要这个I向智慧过渡的辩证法"},{"start":2227.98,"end":2229.96,"text":"中介项是死亡区域"},{"start":2229.96,"end":2232.76,"text":"那么它就会不断的运行"},{"start":2233.48,"end":2236.36,"text":"为什么这个辩证法要不断的运行呢"},{"start":2236.72,"end":2238.24,"text":"因为技术在进步哎"},{"start":2238.24,"end":2240.72,"text":"因为现代社会的运行的基本模式"},{"start":2240.72,"end":2243.22,"text":"随着生产关系的这个进步发展"},{"start":2243.22,"end":2245.4,"text":"不断的在调整它的生"},{"start":2245.9,"end":2248.52,"text":"这个这样一种所谓的这个智慧啊"},{"start":2248.52,"end":2250.73,"text":"他要不断的修正"},{"start":2250.73,"end":2252.25,"text":"不停的去修正"},{"start":2252.25,"end":2254.79,"text":"不停的去改良它自身"},{"start":2254.79,"end":2257.529,"text":"这些资本主义分工是在"},{"start":2259.94,"end":2264.52,"text":"烈度和这个结构性的失衡当中"},{"start":2264.52,"end":2267.2,"text":"要不停的修正它们"},{"start":2268.48,"end":2272.82,"text":"那么这样一种爱呢也是要被生产出来的"},{"start":2272.82,"end":2275.2,"text":"同样像一种哲学家似的"},{"start":2275.2,"end":2278.63,"text":"这种绝望的哲学家族相遇"},{"start":2278.63,"end":2280.63,"text":"自恋的自毁性爱"},{"start":2281.56,"end":2284.98,"text":"自恋而又自悔自爱"},{"start":2290.04,"end":2291.04,"text":"这种心的爱"},{"start":2291.04,"end":2292.28,"text":"这个爱是很明显"},{"start":2292.28,"end":2294.32,"text":"到处让我们回忆一下这是怎样的"},{"start":2294.32,"end":2295.86,"text":"期待着呃"},{"start":2295.86,"end":2297.02,"text":"就是要智慧"},{"start":2297.02,"end":2298.92,"text":"但是说不要占有智慧"},{"start":2298.92,"end":2301.32,"text":"希望自己造成的混乱之后之后"},{"start":2301.32,"end":2304.92,"text":"也可以在混乱的恢复当中显现出来"},{"start":2305.6,"end":2307.84,"text":"希望自己被命运所爱"},{"start":2307.84,"end":2310.64,"text":"但是命运不是直接爱他"},{"start":2310.64,"end":2312.24,"text":"命运是摧毁了他"},{"start":2312.24,"end":2313.32,"text":"而是自毁型的"},{"start":2313.32,"end":2317.18,"text":"或者他自己去被自己命运所摧毁"},{"start":2317.18,"end":2319.86,"text":"然后感受到自己是被命运爱着的"},{"start":2319.86,"end":2322.34,"text":"那命运爱他的方式不是让他免于毁灭"},{"start":2322.34,"end":2326.02,"text":"而是让他的毁灭给带来一些回响"},{"start":2326.42,"end":2329.14,"text":"他能够种复归这个过程"},{"start":2329.14,"end":2331.98,"text":"他把自己当成是完全的工具性的角色"},{"start":2333.17,"end":2335.31,"text":"那么这种追加他是什么呢"},{"start":2335.31,"end":2338.17,"text":"故意踩到那个方块"},{"start":2344.32,"end":2346.65,"text":"总之一下是什么"},{"start":2347.29,"end":2349.35,"text":"有野心的资本家"},{"start":2349.35,"end":2351.76,"text":"有计划有野心的资本家"},{"start":2353.08,"end":2356.52,"text":"他不一定他他的身份可以是很多种身份证"},{"start":2356.52,"end":2359.77,"text":"就是可以是马克宏"},{"start":2359.77,"end":2363.45,"text":"也可以是让马克宏的巨型工厂落地的那些人"},{"start":2363.45,"end":2364.61,"text":"有野心的"},{"start":2364.61,"end":2366.09,"text":"有计划的资本家"},{"start":2366.09,"end":2367.49,"text":"因为资本家实际上是扮演了"},{"start":2367.49,"end":2369.54,"text":"一个是哲学家的一个角色"},{"start":2369.54,"end":2372.78,"text":"如果说他的这个哲学的维度"},{"start":2372.78,"end":2374.74,"text":"哲学的呃"},{"start":2374.74,"end":2379.05,"text":"演算的场是远远超出观念啊"},{"start":2379.76,"end":2381.26,"text":"关键只是中介"},{"start":2381.26,"end":2383.36,"text":"关键被打包起来变成话语"},{"start":2383.36,"end":2386.14,"text":"变成意识形态控制这个社会了"},{"start":2386.14,"end":2388.39,"text":"所以与很多人认为的"},{"start":2390.71,"end":2394.07,"text":"这个时代是一个哲学猖獗的时代"},{"start":2394.99,"end":2398.61,"text":"哲学在作为妖魔在世上舞蹈的时代"},{"start":2398.61,"end":2399.87,"text":"所以我们很明确的说"},{"start":2399.87,"end":2400.71,"text":"哲学就是什么"},{"start":2401.79,"end":2403.955,"text":"哲学就是资产阶级的意识形态"},{"start":2405.27,"end":2408.59,"text":"自然界的一时代总和便是哲学"},{"start":2413.64,"end":2416.08,"text":"那你说这种死亡区域"},{"start":2416.08,"end":2419.55,"text":"有没有可能就是说协调统一在一起"},{"start":2419.55,"end":2422.71,"text":"就是说我们要置换这个中将"},{"start":2423.83,"end":2425.97,"text":"这是要去寻找一种新的辩证法"},{"start":2425.97,"end":2432.58,"text":"还是说要从这个爱和这个智慧的过度之中"},{"start":2433.7,"end":2437.04,"text":"这个空白之中解脱出来"},{"start":2438.96,"end":2441.44,"text":"难道爱一定要比达富贵吗"},{"start":2441.44,"end":2444.48,"text":"爱难道不能以他自身为目的吗"},{"start":2446.26,"end":2447.16,"text":"无论智慧"},{"start":2447.16,"end":2450.5,"text":"为什么非要以爱为起点呢"},{"start":2452.7,"end":2454.3,"text":"这就是你们要思考的东西"},{"start":2454.3,"end":2457.82,"text":"现在人类正在进行这种绝望的努力"},{"start":2459.88,"end":2461.62,"text":"智慧不以爱豆为起点"},{"start":2461.62,"end":2463.92,"text":"那么人类试图在创造什么"},{"start":2465.16,"end":2466.61,"text":"不需要这个活动"},{"start":2466.61,"end":2468.09,"text":"人类在创造什么"},{"start":2468.09,"end":2470.17,"text":"人工智能最好"},{"start":2470.17,"end":2471.21,"text":"人工智能写出两个字"},{"start":2471.21,"end":2474.71,"text":"别是IAI啊"},{"start":2474.71,"end":2476.49,"text":"智慧的自我终结"},{"start":2476.49,"end":2478.55,"text":"追求智慧的自我终结"},{"start":2478.55,"end":2480.75,"text":"那么追求这个爱的自我终结"},{"start":2480.75,"end":2481.45,"text":"它是什么"},{"start":2481.45,"end":2482.985,"text":"What is it"},{"start":2485.56,"end":2486.68,"text":"享乐的专题挂"},{"start":2487.96,"end":2490.28,"text":"所以你们意识到这里的爱不是享乐"},{"start":2490.28,"end":2492.49,"text":"这里的爱是什么"},{"start":2492.97,"end":2498.28,"text":"热情开神啊啊爱是什么"},{"start":2498.28,"end":2500.4,"text":"Passion"},{"start":2500.92,"end":2501.68,"text":"对啊"},{"start":2501.68,"end":2505.58,"text":"那么一个自我中介的爱是什么"},{"start":2505.58,"end":2507.94,"text":"我累哎"},{"start":2510.26,"end":2511.06,"text":"何为此"},{"start":2511.06,"end":2517.91,"text":"我为了热情而而而去拥抱热情"},{"start":2523.02,"end":2528.02,"text":"它是一种普遍的再宗教化"},{"start":2535.68,"end":2536.64,"text":"再宗教化"},{"start":2536.64,"end":2538.529,"text":"而且是普遍再宗教化"},{"start":2538.529,"end":2540.449,"text":"就是比如说举个例子"},{"start":2540.449,"end":2542.249,"text":"你就说骑自行车"},{"start":2542.249,"end":2543.449,"text":"对自行车马上油"},{"start":2543.449,"end":2544.389,"text":"我就爱自行车"},{"start":2544.389,"end":2545.46,"text":"爱车车"},{"start":2545.46,"end":2547.7,"text":"哎我我打游戏挺玩电竞"},{"start":2547.7,"end":2552.4,"text":"我就是痴迷于这个电竞文化的嗯"},{"start":2552.4,"end":2554.3,"text":"他对于这个爱欲的牵引啊"},{"start":2554.3,"end":2557.63,"text":"要形成一种自我指自我指向"},{"start":2557.91,"end":2561.15,"text":"不然我们就在这就说想这不是享乐"},{"start":2561.15,"end":2564.0,"text":"这跟向乐其实是没有没有必然的关系"},{"start":2564.36,"end":2569.56,"text":"这里面是要避免这个这种激情指向总体化的"},{"start":2569.56,"end":2572.52,"text":"计划指向大权"},{"start":2573.0,"end":2579.28,"text":"所以说他是一个局域的局域的局部的"},{"start":2584.24,"end":2586.02,"text":"就是后现代的裂解"},{"start":2586.02,"end":2587.54,"text":"后现代主义的理解"},{"start":2587.54,"end":2588.96,"text":"在后现代主义当中"},{"start":2588.96,"end":2591.52,"text":"其实说每列解出来的这个东西"},{"start":2591.52,"end":2592.68,"text":"这一个小的循环"},{"start":2592.68,"end":2594.32,"text":"你就说是什么cosplay"},{"start":2594.32,"end":2595.28,"text":"我就喜欢cosplay"},{"start":2595.28,"end":2596.0,"text":"对对日漫"},{"start":2596.0,"end":2597.58,"text":"我就喜欢这种亚文化"},{"start":2597.58,"end":2601.11,"text":"注意点他中间有没有享乐"},{"start":2601.11,"end":2602.91,"text":"其实不重要"},{"start":2603.07,"end":2604.39,"text":"对于统治来说"},{"start":2605.39,"end":2610.54,"text":"避免这个玩意零星的指向全局"},{"start":2610.85,"end":2614.43,"text":"是这样一个这种疯狂的这种计划"},{"start":2614.43,"end":2617.27,"text":"让作为革命技术的哲学"},{"start":2617.27,"end":2620.09,"text":"这是他的一个基本需求"},{"start":2620.49,"end":2626.56,"text":"所以各自中介自身真是被看成是"},{"start":2627.46,"end":2630.34,"text":"就叫做后现代性啊"},{"start":2635.16,"end":2638.6,"text":"啊叫做后现代性爱和智慧"},{"start":2638.6,"end":2640.34,"text":"各自中介自身"},{"start":2640.34,"end":2644.65,"text":"把自己作为目的与朝向无关者"},{"start":2647.22,"end":2651.66,"text":"所以我们下一场的讨论就会进入到后现代啊"},{"start":2651.66,"end":2654.58,"text":"今天这一讲就是围绕着意识形态"},{"start":2654.58,"end":2660.44,"text":"围绕着整个一个在现实当中的猖獗无比的哲学"},{"start":2661.66,"end":2668.14,"text":"把整个人类作为这个观念领地展开折叠"},{"start":2669.7,"end":2676.42,"text":"然后去评价介入的这样一种疯狂的历史现实"}],"source":"subtitle"}
