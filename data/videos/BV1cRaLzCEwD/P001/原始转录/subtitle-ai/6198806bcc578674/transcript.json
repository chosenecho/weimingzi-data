{
  "bvid": "BV1cRaLzCEwD",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "6198806bcc578674d6869028c7b63679d5448581899d800d494a83fba5c9a674",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 7350,
      "end_ms": 11400,
      "text": "你的事业发生了非常重大的啊"
    },
    {
      "ordinal": 1,
      "start_ms": 11960,
      "end_ms": 14480,
      "text": "然后剧烈的变化"
    },
    {
      "ordinal": 2,
      "start_ms": 18680,
      "end_ms": 21440,
      "text": "包括这个支教项目"
    },
    {
      "ordinal": 3,
      "start_ms": 23100,
      "end_ms": 29700,
      "text": "还有就是说我们的啊粉丝学习会"
    },
    {
      "ordinal": 4,
      "start_ms": 32600,
      "end_ms": 36760,
      "text": "还有对于我们这个啊"
    },
    {
      "ordinal": 5,
      "start_ms": 37730,
      "end_ms": 42490,
      "text": "工作成员和这个俱乐部会员啊"
    },
    {
      "ordinal": 6,
      "start_ms": 42490,
      "end_ms": 46760,
      "text": "他们的生活啊状况啊"
    },
    {
      "ordinal": 7,
      "start_ms": 46760,
      "end_ms": 47920,
      "text": "求职状况"
    },
    {
      "ordinal": 8,
      "start_ms": 47920,
      "end_ms": 49260,
      "text": "求职意愿"
    },
    {
      "ordinal": 9,
      "start_ms": 49260,
      "end_ms": 53220,
      "text": "还有这个工作技能都进行了一些"
    },
    {
      "ordinal": 10,
      "start_ms": 54190,
      "end_ms": 56390,
      "text": "统计和评定"
    },
    {
      "ordinal": 11,
      "start_ms": 60960,
      "end_ms": 64120,
      "text": "然后以及我们在各个方向上"
    },
    {
      "ordinal": 12,
      "start_ms": 64120,
      "end_ms": 67590,
      "text": "事业的啊全面发展啊"
    },
    {
      "ordinal": 13,
      "start_ms": 67590,
      "end_ms": 71740,
      "text": "工坊啊的这个转型"
    },
    {
      "ordinal": 14,
      "start_ms": 71740,
      "end_ms": 77220,
      "text": "变成这个NPC的一个主要生产基地啊"
    },
    {
      "ordinal": 15,
      "start_ms": 77220,
      "end_ms": 84050,
      "text": "现在也进一步在吸收了嘶啊精干力量啊"
    },
    {
      "ordinal": 16,
      "start_ms": 84050,
      "end_ms": 85890,
      "text": "然后供奉原来的人呢"
    },
    {
      "ordinal": 17,
      "start_ms": 85890,
      "end_ms": 88830,
      "text": "现在要去开始筹备啊"
    },
    {
      "ordinal": 18,
      "start_ms": 88830,
      "end_ms": 92230,
      "text": "修车培训啊"
    },
    {
      "ordinal": 19,
      "start_ms": 92230,
      "end_ms": 94070,
      "text": "和将来的修车行"
    },
    {
      "ordinal": 20,
      "start_ms": 96260,
      "end_ms": 102020,
      "text": "让我们开始陆续呃在店里面设立一个"
    },
    {
      "ordinal": 21,
      "start_ms": 104380,
      "end_ms": 105660,
      "text": "啊接待"
    },
    {
      "ordinal": 22,
      "start_ms": 107900,
      "end_ms": 114630,
      "text": "啊和这个培训引导的你个专用场地"
    },
    {
      "ordinal": 23,
      "start_ms": 115100,
      "end_ms": 117420,
      "text": "也提供各式样的这个职业培训"
    },
    {
      "ordinal": 24,
      "start_ms": 118500,
      "end_ms": 119500,
      "text": "包括电工啊"
    },
    {
      "ordinal": 25,
      "start_ms": 119500,
      "end_ms": 120580,
      "text": "修车啊"
    },
    {
      "ordinal": 26,
      "start_ms": 120580,
      "end_ms": 122420,
      "text": "装机啊"
    },
    {
      "ordinal": 27,
      "start_ms": 122420,
      "end_ms": 124140,
      "text": "设计剪辑"
    },
    {
      "ordinal": 28,
      "start_ms": 124990,
      "end_ms": 127670,
      "text": "还有拍摄啊"
    },
    {
      "ordinal": 29,
      "start_ms": 127670,
      "end_ms": 129550,
      "text": "还有AI"
    },
    {
      "ordinal": 30,
      "start_ms": 131820,
      "end_ms": 139380,
      "text": "我们整个这个哦更不要说就是最近这个月来啊"
    },
    {
      "ordinal": 31,
      "start_ms": 143130,
      "end_ms": 145360,
      "text": "妇女啊"
    },
    {
      "ordinal": 32,
      "start_ms": 145360,
      "end_ms": 148460,
      "text": "我们把这个主要的岗位啊"
    },
    {
      "ordinal": 33,
      "start_ms": 148460,
      "end_ms": 152540,
      "text": "只要不是说啊高强度劳动的"
    },
    {
      "ordinal": 34,
      "start_ms": 152540,
      "end_ms": 155360,
      "text": "日日晒雨淋的"
    },
    {
      "ordinal": 35,
      "start_ms": 156760,
      "end_ms": 160360,
      "text": "都尽可能的转给这个女同志"
    },
    {
      "ordinal": 36,
      "start_ms": 166100,
      "end_ms": 168420,
      "text": "这是一个狂飙突进的"
    },
    {
      "ordinal": 37,
      "start_ms": 170980,
      "end_ms": 172300,
      "text": "夏天"
    },
    {
      "ordinal": 38,
      "start_ms": 173500,
      "end_ms": 178060,
      "text": "这个夏天呢现在也要即将要结束了"
    },
    {
      "ordinal": 39,
      "start_ms": 180460,
      "end_ms": 184780,
      "text": "啊我们的支教志愿者陆陆续续都要啊"
    },
    {
      "ordinal": 40,
      "start_ms": 184780,
      "end_ms": 189340,
      "text": "到奔赴各地去开始一年的支教了"
    },
    {
      "ordinal": 41,
      "start_ms": 189819,
      "end_ms": 191660,
      "text": "然后"
    },
    {
      "ordinal": 42,
      "start_ms": 194920,
      "end_ms": 198760,
      "text": "我们的一些重大计划在昨天啊"
    },
    {
      "ordinal": 43,
      "start_ms": 198760,
      "end_ms": 205900,
      "text": "就是在要也都敲定了这种重要的一个啧"
    },
    {
      "ordinal": 44,
      "start_ms": 208300,
      "end_ms": 209400,
      "text": "那个时间点吧"
    },
    {
      "ordinal": 45,
      "start_ms": 209400,
      "end_ms": 213370,
      "text": "时间节点就在昨天也敲定了哦"
    },
    {
      "ordinal": 46,
      "start_ms": 213370,
      "end_ms": 215170,
      "text": "我准备让"
    },
    {
      "ordinal": 47,
      "start_ms": 217490,
      "end_ms": 220100,
      "text": "大家休息三天啊"
    },
    {
      "ordinal": 48,
      "start_ms": 220100,
      "end_ms": 220960,
      "text": "休息三天"
    },
    {
      "ordinal": 49,
      "start_ms": 220960,
      "end_ms": 222340,
      "text": "好好休息三天"
    },
    {
      "ordinal": 50,
      "start_ms": 222340,
      "end_ms": 224730,
      "text": "好好调整一下"
    },
    {
      "ordinal": 51,
      "start_ms": 225170,
      "end_ms": 228970,
      "text": "但是说好像只是俱乐部店里面休息三天啊"
    },
    {
      "ordinal": 52,
      "start_ms": 228970,
      "end_ms": 235520,
      "text": "俱乐部店里面还有这个啊"
    },
    {
      "ordinal": 53,
      "start_ms": 237240,
      "end_ms": 239120,
      "text": "外地粉丝的这个旅游体验"
    },
    {
      "ordinal": 54,
      "start_ms": 240360,
      "end_ms": 242120,
      "text": "这些项目都可以稍微停一下"
    },
    {
      "ordinal": 55,
      "start_ms": 242120,
      "end_ms": 243400,
      "text": "歇三天"
    },
    {
      "ordinal": 56,
      "start_ms": 243400,
      "end_ms": 244460,
      "text": "太累了"
    },
    {
      "ordinal": 57,
      "start_ms": 244460,
      "end_ms": 245200,
      "text": "歇三天"
    },
    {
      "ordinal": 58,
      "start_ms": 245200,
      "end_ms": 246280,
      "text": "正好呢两方面"
    },
    {
      "ordinal": 59,
      "start_ms": 246280,
      "end_ms": 249760,
      "text": "国内可以把这个阅兵我们好好的期待一下"
    },
    {
      "ordinal": 60,
      "start_ms": 249760,
      "end_ms": 254200,
      "text": "看一下国外呢我们的主要发力的地方"
    },
    {
      "ordinal": 61,
      "start_ms": 254200,
      "end_ms": 257779,
      "text": "现在处在一个变化动荡之中"
    },
    {
      "ordinal": 62,
      "start_ms": 257779,
      "end_ms": 260620,
      "text": "要仔细的观察各方面的情况"
    },
    {
      "ordinal": 63,
      "start_ms": 260620,
      "end_ms": 263240,
      "text": "要好好观察汇总啊"
    },
    {
      "ordinal": 64,
      "start_ms": 263240,
      "end_ms": 265500,
      "text": "好出一些研判"
    },
    {
      "ordinal": 65,
      "start_ms": 266030,
      "end_ms": 269350,
      "text": "才能为将来的工作提供指导"
    },
    {
      "ordinal": 66,
      "start_ms": 272900,
      "end_ms": 278809,
      "text": "人员上我们的发展的就也都比较快啊"
    },
    {
      "ordinal": 67,
      "start_ms": 278809,
      "end_ms": 281269,
      "text": "各种人才现在都"
    },
    {
      "ordinal": 68,
      "start_ms": 282940,
      "end_ms": 284580,
      "text": "相对比较齐全了"
    },
    {
      "ordinal": 69,
      "start_ms": 286620,
      "end_ms": 290220,
      "text": "那么这个夏天的劳作努力呢"
    },
    {
      "ordinal": 70,
      "start_ms": 290220,
      "end_ms": 293900,
      "text": "迎来的会是一个丰饶的秋天"
    },
    {
      "ordinal": 71,
      "start_ms": 293900,
      "end_ms": 297250,
      "text": "还是一个萧瑟的啊"
    },
    {
      "ordinal": 72,
      "start_ms": 298840,
      "end_ms": 299540,
      "text": "秋天了"
    },
    {
      "ordinal": 73,
      "start_ms": 299540,
      "end_ms": 300920,
      "text": "我不确定"
    },
    {
      "ordinal": 74,
      "start_ms": 310080,
      "end_ms": 312160,
      "text": "哦我不确定"
    },
    {
      "ordinal": 75,
      "start_ms": 321820,
      "end_ms": 324140,
      "text": "凉凉下来"
    },
    {
      "ordinal": 76,
      "start_ms": 325180,
      "end_ms": 326940,
      "text": "这个水才好喝进肚子里"
    },
    {
      "ordinal": 77,
      "start_ms": 328140,
      "end_ms": 331340,
      "text": "凉凉下来啊"
    },
    {
      "ordinal": 78,
      "start_ms": 331340,
      "end_ms": 335220,
      "text": "也能够从这个激情澎湃"
    },
    {
      "ordinal": 79,
      "start_ms": 335220,
      "end_ms": 337460,
      "text": "热力四射的状态下"
    },
    {
      "ordinal": 80,
      "start_ms": 337460,
      "end_ms": 340610,
      "text": "把冷暖感受清楚"
    },
    {
      "ordinal": 81,
      "start_ms": 343210,
      "end_ms": 346430,
      "text": "我们现在稍微可以凉下来一点点"
    },
    {
      "ordinal": 82,
      "start_ms": 346990,
      "end_ms": 348630,
      "text": "只是一艘出海的船"
    },
    {
      "ordinal": 83,
      "start_ms": 350430,
      "end_ms": 355510,
      "text": "这个身后的故土已经看不见了"
    },
    {
      "ordinal": 84,
      "start_ms": 355510,
      "end_ms": 359290,
      "text": "只能往前开啊"
    },
    {
      "ordinal": 85,
      "start_ms": 360070,
      "end_ms": 361030,
      "text": "劈开风浪"
    },
    {
      "ordinal": 86,
      "start_ms": 362110,
      "end_ms": 363110,
      "text": "奋勇向前"
    },
    {
      "ordinal": 87,
      "start_ms": 363110,
      "end_ms": 365030,
      "text": "才有可能抵达彼岸"
    },
    {
      "ordinal": 88,
      "start_ms": 365030,
      "end_ms": 368830,
      "text": "很多人处在一种迷茫啊"
    },
    {
      "ordinal": 89,
      "start_ms": 369390,
      "end_ms": 371090,
      "text": "啊怠惰倒是不怠惰"
    },
    {
      "ordinal": 90,
      "start_ms": 371090,
      "end_ms": 372550,
      "text": "没有人怠惰"
    },
    {
      "ordinal": 91,
      "start_ms": 372550,
      "end_ms": 374590,
      "text": "但是很多人处在一种迷茫"
    },
    {
      "ordinal": 92,
      "start_ms": 374590,
      "end_ms": 378500,
      "text": "死用力盲目往前冲的一个状态"
    },
    {
      "ordinal": 93,
      "start_ms": 378500,
      "end_ms": 387340,
      "text": "不能被这样一个啊头脑发热给控制了"
    },
    {
      "ordinal": 94,
      "start_ms": 389040,
      "end_ms": 391320,
      "text": "要好好想一想自己的目的是什么"
    },
    {
      "ordinal": 95,
      "start_ms": 391320,
      "end_ms": 395920,
      "text": "好好去思考清楚自己来这里啊"
    },
    {
      "ordinal": 96,
      "start_ms": 395920,
      "end_ms": 397320,
      "text": "努力奋斗"
    },
    {
      "ordinal": 97,
      "start_ms": 397320,
      "end_ms": 399100,
      "text": "拥抱生活"
    },
    {
      "ordinal": 98,
      "start_ms": 399100,
      "end_ms": 401220,
      "text": "拥抱理想"
    },
    {
      "ordinal": 99,
      "start_ms": 402180,
      "end_ms": 404180,
      "text": "是为了什么"
    },
    {
      "ordinal": 100,
      "start_ms": 406840,
      "end_ms": 410320,
      "text": "我不希望你们把空余时间"
    },
    {
      "ordinal": 101,
      "start_ms": 412460,
      "end_ms": 416360,
      "text": "把思考进步的可能都耗费在游戏当中"
    },
    {
      "ordinal": 102,
      "start_ms": 416360,
      "end_ms": 418100,
      "text": "享乐当中"
    },
    {
      "ordinal": 103,
      "start_ms": 418840,
      "end_ms": 422260,
      "text": "我不希望你们浑浑噩噩"
    },
    {
      "ordinal": 104,
      "start_ms": 422260,
      "end_ms": 423580,
      "text": "百无聊赖"
    },
    {
      "ordinal": 105,
      "start_ms": 424620,
      "end_ms": 426780,
      "text": "用一些低俗的"
    },
    {
      "ordinal": 106,
      "start_ms": 426780,
      "end_ms": 431620,
      "text": "无聊的八卦的话题填补自己的业余生活"
    },
    {
      "ordinal": 107,
      "start_ms": 432270,
      "end_ms": 434870,
      "text": "我希望你们有所成长"
    },
    {
      "ordinal": 108,
      "start_ms": 435929,
      "end_ms": 438089,
      "text": "啊在休息当中"
    },
    {
      "ordinal": 109,
      "start_ms": 438089,
      "end_ms": 442849,
      "text": "在劳逸结合当中能够持续的成长"
    },
    {
      "ordinal": 110,
      "start_ms": 444200,
      "end_ms": 446680,
      "text": "所以我们提供的这些职业培训呢"
    },
    {
      "ordinal": 111,
      "start_ms": 447760,
      "end_ms": 452060,
      "text": "嗯是希望你能够长远发展的"
    },
    {
      "ordinal": 112,
      "start_ms": 452060,
      "end_ms": 453740,
      "text": "希望男同志啊"
    },
    {
      "ordinal": 113,
      "start_ms": 453740,
      "end_ms": 456220,
      "text": "在这里得到了这些职业培训了之后"
    },
    {
      "ordinal": 114,
      "start_ms": 460280,
      "end_ms": 463160,
      "text": "啊我们哪里是斜角啊"
    },
    {
      "ordinal": 115,
      "start_ms": 463160,
      "end_ms": 466530,
      "text": "我们说就是对于这个男性成员"
    },
    {
      "ordinal": 116,
      "start_ms": 466530,
      "end_ms": 468250,
      "text": "提供这些技能培训的时候"
    },
    {
      "ordinal": 117,
      "start_ms": 468250,
      "end_ms": 469830,
      "text": "鼓励他出去就业的"
    },
    {
      "ordinal": 118,
      "start_ms": 469830,
      "end_ms": 472910,
      "text": "出去工作的出去这个"
    },
    {
      "ordinal": 119,
      "start_ms": 476630,
      "end_ms": 480070,
      "text": "游戏想出去狩猎打野啊"
    },
    {
      "ordinal": 120,
      "start_ms": 480070,
      "end_ms": 481830,
      "text": "能有所回报的"
    },
    {
      "ordinal": 121,
      "start_ms": 481830,
      "end_ms": 482630,
      "text": "有所回报"
    },
    {
      "ordinal": 122,
      "start_ms": 482630,
      "end_ms": 485350,
      "text": "就是来我们这消费的能更阔气一点啊"
    },
    {
      "ordinal": 123,
      "start_ms": 485350,
      "end_ms": 487680,
      "text": "然后呢对于女同志呢啊"
    },
    {
      "ordinal": 124,
      "start_ms": 487680,
      "end_ms": 489880,
      "text": "我们这里提供相应的岗位"
    },
    {
      "ordinal": 125,
      "start_ms": 489880,
      "end_ms": 494060,
      "text": "但是也提供相应的这个培训"
    },
    {
      "ordinal": 126,
      "start_ms": 494060,
      "end_ms": 497960,
      "text": "职业培训技能培训啊"
    },
    {
      "ordinal": 127,
      "start_ms": 498780,
      "end_ms": 501440,
      "text": "啊也有一些情感情感关怀啊"
    },
    {
      "ordinal": 128,
      "start_ms": 501440,
      "end_ms": 502740,
      "text": "心理支撑啊"
    },
    {
      "ordinal": 129,
      "start_ms": 502740,
      "end_ms": 507760,
      "text": "啊总是有这个庇护之地啊"
    },
    {
      "ordinal": 130,
      "start_ms": 510300,
      "end_ms": 512940,
      "text": "不是说一定在我们提供这个岗位上面"
    },
    {
      "ordinal": 131,
      "start_ms": 512940,
      "end_ms": 516020,
      "text": "你才能说发发挥你的社会价值啊"
    },
    {
      "ordinal": 132,
      "start_ms": 516020,
      "end_ms": 518429,
      "text": "有相应的技能啊"
    },
    {
      "ordinal": 133,
      "start_ms": 518429,
      "end_ms": 523620,
      "text": "致使武装起来也不会在社会上"
    },
    {
      "ordinal": 134,
      "start_ms": 523620,
      "end_ms": 525240,
      "text": "你感觉自己是单打独斗"
    },
    {
      "ordinal": 135,
      "start_ms": 525240,
      "end_ms": 526380,
      "text": "孤苦无依的了"
    },
    {
      "ordinal": 136,
      "start_ms": 527580,
      "end_ms": 529780,
      "text": "我们做这些事情呢"
    },
    {
      "ordinal": 137,
      "start_ms": 531460,
      "end_ms": 534340,
      "text": "不能说是什么以拖待变啊"
    },
    {
      "ordinal": 138,
      "start_ms": 534340,
      "end_ms": 535300,
      "text": "以待天时啊"
    },
    {
      "ordinal": 139,
      "start_ms": 535300,
      "end_ms": 536480,
      "text": "什么什么东西的"
    },
    {
      "ordinal": 140,
      "start_ms": 536480,
      "end_ms": 540379,
      "text": "这个对于一般普通人来讲的话啊"
    },
    {
      "ordinal": 141,
      "start_ms": 540379,
      "end_ms": 541539,
      "text": "当然不存在普通人啊"
    },
    {
      "ordinal": 142,
      "start_ms": 541539,
      "end_ms": 543419,
      "text": "大家都是这个劳苦大众啊"
    },
    {
      "ordinal": 143,
      "start_ms": 543419,
      "end_ms": 544739,
      "text": "对劳苦大众这种话"
    },
    {
      "ordinal": 144,
      "start_ms": 544739,
      "end_ms": 545919,
      "text": "以待天时"
    },
    {
      "ordinal": 145,
      "start_ms": 545919,
      "end_ms": 546619,
      "text": "换到明天"
    },
    {
      "ordinal": 146,
      "start_ms": 546619,
      "end_ms": 550660,
      "text": "我就要我我我要再往我的碗里面添点吃的东西"
    },
    {
      "ordinal": 147,
      "start_ms": 550660,
      "end_ms": 551420,
      "text": "添点食"
    },
    {
      "ordinal": 148,
      "start_ms": 551420,
      "end_ms": 552380,
      "text": "以代天使"
    },
    {
      "ordinal": 149,
      "start_ms": 552380,
      "end_ms": 553020,
      "text": "你等着拿"
    },
    {
      "ordinal": 150,
      "start_ms": 553020,
      "end_ms": 554920,
      "text": "有东西吃啊"
    },
    {
      "ordinal": 151,
      "start_ms": 555960,
      "end_ms": 557840,
      "text": "所以就是不劳动不得食的人"
    },
    {
      "ordinal": 152,
      "start_ms": 558840,
      "end_ms": 564590,
      "text": "我们让他们劳动的可以更精细"
    },
    {
      "ordinal": 153,
      "start_ms": 564890,
      "end_ms": 566050,
      "text": "更高效"
    },
    {
      "ordinal": 154,
      "start_ms": 566050,
      "end_ms": 567610,
      "text": "更轻巧一些"
    },
    {
      "ordinal": 155,
      "start_ms": 567610,
      "end_ms": 571210,
      "text": "他们得到的回报呢可以更丰富一些"
    },
    {
      "ordinal": 156,
      "start_ms": 572410,
      "end_ms": 576570,
      "text": "啊然后想用自己的劳动成果能够更踏实一些"
    },
    {
      "ordinal": 157,
      "start_ms": 576570,
      "end_ms": 580900,
      "text": "让他没有后顾之忧哈"
    },
    {
      "ordinal": 158,
      "start_ms": 580900,
      "end_ms": 583820,
      "text": "也不陷入这个前瞻的这个疑虑当中去"
    },
    {
      "ordinal": 159,
      "start_ms": 584900,
      "end_ms": 587550,
      "text": "他才能够登高望远"
    },
    {
      "ordinal": 160,
      "start_ms": 587830,
      "end_ms": 589850,
      "text": "或者说才能够啊"
    },
    {
      "ordinal": 161,
      "start_ms": 589850,
      "end_ms": 593970,
      "text": "在这个定定心心的一个相对理智的状态之下"
    },
    {
      "ordinal": 162,
      "start_ms": 593970,
      "end_ms": 597659,
      "text": "我们给他们提供的前线的战报也好"
    },
    {
      "ordinal": 163,
      "start_ms": 597659,
      "end_ms": 601179,
      "text": "或者说是远端的这个地形图也罢"
    },
    {
      "ordinal": 164,
      "start_ms": 601179,
      "end_ms": 605210,
      "text": "他能够有那个注意力啊"
    },
    {
      "ordinal": 165,
      "start_ms": 605210,
      "end_ms": 613290,
      "text": "有那个好整以暇的心理状态去细细浏览"
    },
    {
      "ordinal": 166,
      "start_ms": 614650,
      "end_ms": 616830,
      "text": "去共同参想啊"
    },
    {
      "ordinal": 167,
      "start_ms": 616830,
      "end_ms": 618970,
      "text": "去大胆发言讨论"
    },
    {
      "ordinal": 168,
      "start_ms": 620240,
      "end_ms": 621920,
      "text": "得让大家都定下心来"
    },
    {
      "ordinal": 169,
      "start_ms": 621920,
      "end_ms": 624980,
      "text": "得让大家都这个腾出手来"
    },
    {
      "ordinal": 170,
      "start_ms": 624980,
      "end_ms": 628660,
      "text": "得让大家都什么安稳的坐下来"
    },
    {
      "ordinal": 171,
      "start_ms": 629940,
      "end_ms": 631140,
      "text": "那要让你们安稳坐下来"
    },
    {
      "ordinal": 172,
      "start_ms": 631140,
      "end_ms": 632580,
      "text": "那你就说你在白天"
    },
    {
      "ordinal": 173,
      "start_ms": 632580,
      "end_ms": 633460,
      "text": "你在自己工作"
    },
    {
      "ordinal": 174,
      "start_ms": 633460,
      "end_ms": 634620,
      "text": "自己劳作"
    },
    {
      "ordinal": 175,
      "start_ms": 634620,
      "end_ms": 636820,
      "text": "在过日子的时候"
    },
    {
      "ordinal": 176,
      "start_ms": 636820,
      "end_ms": 639920,
      "text": "把日子过起来了啊"
    },
    {
      "ordinal": 177,
      "start_ms": 640560,
      "end_ms": 643120,
      "text": "把路走通了"
    },
    {
      "ordinal": 178,
      "start_ms": 644740,
      "end_ms": 648900,
      "text": "所以这是一个让大家的生活状态"
    },
    {
      "ordinal": 179,
      "start_ms": 650020,
      "end_ms": 655310,
      "text": "我们致力于是让这个生活状态更积极主动啊"
    },
    {
      "ordinal": 180,
      "start_ms": 655310,
      "end_ms": 658270,
      "text": "让自己的这个生活准备啊"
    },
    {
      "ordinal": 181,
      "start_ms": 658270,
      "end_ms": 662090,
      "text": "生活的这个基础更完备"
    },
    {
      "ordinal": 182,
      "start_ms": 662090,
      "end_ms": 664280,
      "text": "更踏实啊"
    },
    {
      "ordinal": 183,
      "start_ms": 664280,
      "end_ms": 666400,
      "text": "应该要扎实啊"
    },
    {
      "ordinal": 184,
      "start_ms": 668400,
      "end_ms": 671220,
      "text": "我们所作所为是非常有限的"
    },
    {
      "ordinal": 185,
      "start_ms": 671220,
      "end_ms": 672980,
      "text": "而且是来去自由"
    },
    {
      "ordinal": 186,
      "start_ms": 672980,
      "end_ms": 674480,
      "text": "绝对是来去自由"
    },
    {
      "ordinal": 187,
      "start_ms": 674480,
      "end_ms": 678859,
      "text": "然后呃也没有说什么勒索财物啊"
    },
    {
      "ordinal": 188,
      "start_ms": 678859,
      "end_ms": 681020,
      "text": "哄骗啊"
    },
    {
      "ordinal": 189,
      "start_ms": 681020,
      "end_ms": 685880,
      "text": "你这个投入什么什么大大额金钱"
    },
    {
      "ordinal": 190,
      "start_ms": 685880,
      "end_ms": 689820,
      "text": "或者说什么牺牲个人是什么啊"
    },
    {
      "ordinal": 191,
      "start_ms": 689820,
      "end_ms": 690960,
      "text": "情感啊"
    },
    {
      "ordinal": 192,
      "start_ms": 690960,
      "end_ms": 693520,
      "text": "或者说就是啊心理"
    },
    {
      "ordinal": 193,
      "start_ms": 693520,
      "end_ms": 697669,
      "text": "心灵控制这东西统统都没有啊"
    },
    {
      "ordinal": 194,
      "start_ms": 697669,
      "end_ms": 701289,
      "text": "我们得到最近也遭到了很多不实的举报啊"
    },
    {
      "ordinal": 195,
      "start_ms": 701289,
      "end_ms": 704020,
      "text": "哼啊我也挺无语的"
    },
    {
      "ordinal": 196,
      "start_ms": 704020,
      "end_ms": 706960,
      "text": "事实就是这样啊"
    },
    {
      "ordinal": 197,
      "start_ms": 706960,
      "end_ms": 708260,
      "text": "那我回过头来讲"
    },
    {
      "ordinal": 198,
      "start_ms": 708260,
      "end_ms": 711449,
      "text": "就是啊你们还能期待的"
    },
    {
      "ordinal": 199,
      "start_ms": 711449,
      "end_ms": 715129,
      "text": "我们将来要就是要布置发展的一些"
    },
    {
      "ordinal": 200,
      "start_ms": 715129,
      "end_ms": 720090,
      "text": "是一个就这个培训计划啊"
    },
    {
      "ordinal": 201,
      "start_ms": 720090,
      "end_ms": 722730,
      "text": "就职业技能的这种培训啊"
    },
    {
      "ordinal": 202,
      "start_ms": 722730,
      "end_ms": 724370,
      "text": "这是传授教导"
    },
    {
      "ordinal": 203,
      "start_ms": 724370,
      "end_ms": 726690,
      "text": "我们还要再进一步拓展和深化"
    },
    {
      "ordinal": 204,
      "start_ms": 726690,
      "end_ms": 730490,
      "text": "然后呢我们会有一些就是粉丝啊"
    },
    {
      "ordinal": 205,
      "start_ms": 730490,
      "end_ms": 736220,
      "text": "就外地粉丝的一个啊旅游啊"
    },
    {
      "ordinal": 206,
      "start_ms": 736220,
      "end_ms": 738510,
      "text": "旅游的一个啊"
    },
    {
      "ordinal": 207,
      "start_ms": 738685,
      "end_ms": 741930,
      "text": "还有见面会的这么一个筹备"
    },
    {
      "ordinal": 208,
      "start_ms": 741930,
      "end_ms": 745950,
      "text": "这个计划也会提供比较廉价的住宿"
    },
    {
      "ordinal": 209,
      "start_ms": 745950,
      "end_ms": 750910,
      "text": "还有一个就是呃我们会搞个电视台"
    },
    {
      "ordinal": 210,
      "start_ms": 750910,
      "end_ms": 752430,
      "text": "营造个电视台"
    },
    {
      "ordinal": 211,
      "start_ms": 752430,
      "end_ms": 759360,
      "text": "让这个我们的这个直播账号24小时轮播啊"
    },
    {
      "ordinal": 212,
      "start_ms": 759360,
      "end_ms": 761860,
      "text": "因为我们四海之内皆兄弟啊"
    },
    {
      "ordinal": 213,
      "start_ms": 761860,
      "end_ms": 763990,
      "text": "都是知己嗯"
    },
    {
      "ordinal": 214,
      "start_ms": 763990,
      "end_ms": 768810,
      "text": "啊我们在努力能够做成第一个啊"
    },
    {
      "ordinal": 215,
      "start_ms": 775829,
      "end_ms": 777669,
      "text": "不仅是在国内"
    },
    {
      "ordinal": 216,
      "start_ms": 777669,
      "end_ms": 780269,
      "text": "甚至在全球第一个加引号"
    },
    {
      "ordinal": 217,
      "start_ms": 780269,
      "end_ms": 781749,
      "text": "当然是加引号的电视台了"
    },
    {
      "ordinal": 218,
      "start_ms": 781749,
      "end_ms": 784850,
      "text": "民间的一个24小时有新鲜内容"
    },
    {
      "ordinal": 219,
      "start_ms": 784850,
      "end_ms": 785990,
      "text": "有直播"
    },
    {
      "ordinal": 220,
      "start_ms": 785990,
      "end_ms": 787490,
      "text": "有录播啊"
    },
    {
      "ordinal": 221,
      "start_ms": 787490,
      "end_ms": 789050,
      "text": "有剪辑好的视频啊"
    },
    {
      "ordinal": 222,
      "start_ms": 789050,
      "end_ms": 790930,
      "text": "还有讨论啊"
    },
    {
      "ordinal": 223,
      "start_ms": 791210,
      "end_ms": 792750,
      "text": "啊当然也会有广告啊"
    },
    {
      "ordinal": 224,
      "start_ms": 792750,
      "end_ms": 796150,
      "text": "这样一个24小时的一个电视台"
    },
    {
      "ordinal": 225,
      "start_ms": 796750,
      "end_ms": 798870,
      "text": "我们现会在这个年内"
    },
    {
      "ordinal": 226,
      "start_ms": 798870,
      "end_ms": 803720,
      "text": "先让他这个节目方面能够稍微丰满一些"
    },
    {
      "ordinal": 227,
      "start_ms": 804040,
      "end_ms": 809740,
      "text": "然后到年底到明年那过农历春年的时候"
    },
    {
      "ordinal": 228,
      "start_ms": 809740,
      "end_ms": 814380,
      "text": "春春节的时候能够比较正式的正儿八经的啊"
    },
    {
      "ordinal": 229,
      "start_ms": 814380,
      "end_ms": 818910,
      "text": "给大家呈现一点点这种感觉对吧"
    },
    {
      "ordinal": 230,
      "start_ms": 818910,
      "end_ms": 823870,
      "text": "这都是需要工作啊去填补的空白啊"
    },
    {
      "ordinal": 231,
      "start_ms": 823870,
      "end_ms": 824990,
      "text": "都是吓死人的"
    },
    {
      "ordinal": 232,
      "start_ms": 824990,
      "end_ms": 829609,
      "text": "这个劳动时间啊啊我是个战略家啊"
    },
    {
      "ordinal": 233,
      "start_ms": 829609,
      "end_ms": 833060,
      "text": "当然我在战术上也是哎呀"
    },
    {
      "ordinal": 234,
      "start_ms": 833060,
      "end_ms": 834840,
      "text": "反正也是挺机敏的或怎样的"
    },
    {
      "ordinal": 235,
      "start_ms": 834840,
      "end_ms": 838480,
      "text": "我给他们搞了好多这种发展战略啊"
    },
    {
      "ordinal": 236,
      "start_ms": 838480,
      "end_ms": 841230,
      "text": "然后也是在严厉的"
    },
    {
      "ordinal": 237,
      "start_ms": 842270,
      "end_ms": 844310,
      "text": "以及就是劳苦的"
    },
    {
      "ordinal": 238,
      "start_ms": 844310,
      "end_ms": 845750,
      "text": "但弓不一定高"
    },
    {
      "ordinal": 239,
      "start_ms": 845750,
      "end_ms": 848370,
      "text": "我我个人的弓和大家一样高"
    },
    {
      "ordinal": 240,
      "start_ms": 848370,
      "end_ms": 849590,
      "text": "好吧啊"
    },
    {
      "ordinal": 241,
      "start_ms": 849590,
      "end_ms": 855970,
      "text": "比较啊稳步的在催促啊"
    },
    {
      "ordinal": 242,
      "start_ms": 855970,
      "end_ms": 861430,
      "text": "带领着这整个这个我们自己的小小的发展事业"
    },
    {
      "ordinal": 243,
      "start_ms": 861430,
      "end_ms": 862740,
      "text": "往前进"
    },
    {
      "ordinal": 244,
      "start_ms": 862980,
      "end_ms": 865200,
      "text": "但是不要绷太紧啊"
    },
    {
      "ordinal": 245,
      "start_ms": 865200,
      "end_ms": 868280,
      "text": "就是就是说你不要觉得自己少做了点"
    },
    {
      "ordinal": 246,
      "start_ms": 868280,
      "end_ms": 869880,
      "text": "然后这个事情发展的慢了"
    },
    {
      "ordinal": 247,
      "start_ms": 869880,
      "end_ms": 872900,
      "text": "一两天就有成千上万的人啊"
    },
    {
      "ordinal": 248,
      "start_ms": 872900,
      "end_ms": 874780,
      "text": "确实没办法得到我们的帮助"
    },
    {
      "ordinal": 249,
      "start_ms": 874780,
      "end_ms": 876520,
      "text": "不要这样想好吧"
    },
    {
      "ordinal": 250,
      "start_ms": 876520,
      "end_ms": 878329,
      "text": "欲速而不达"
    },
    {
      "ordinal": 251,
      "start_ms": 878329,
      "end_ms": 880089,
      "text": "你想要弄的太快"
    },
    {
      "ordinal": 252,
      "start_ms": 880089,
      "end_ms": 881309,
      "text": "反而有隐患"
    },
    {
      "ordinal": 253,
      "start_ms": 881309,
      "end_ms": 883880,
      "text": "反而可能会走歪啊"
    },
    {
      "ordinal": 254,
      "start_ms": 883880,
      "end_ms": 885540,
      "text": "每一步都要走得扎实"
    },
    {
      "ordinal": 255,
      "start_ms": 885540,
      "end_ms": 888220,
      "text": "每一个细节问题大家都要充分思考"
    },
    {
      "ordinal": 256,
      "start_ms": 888220,
      "end_ms": 889690,
      "text": "讨论啊"
    },
    {
      "ordinal": 257,
      "start_ms": 889690,
      "end_ms": 892390,
      "text": "要主动的去参与讨论啊"
    },
    {
      "ordinal": 258,
      "start_ms": 892390,
      "end_ms": 894770,
      "text": "要善于批评啊"
    },
    {
      "ordinal": 259,
      "start_ms": 894770,
      "end_ms": 896570,
      "text": "要善于自我批评"
    },
    {
      "ordinal": 260,
      "start_ms": 896900,
      "end_ms": 897820,
      "text": "不要懈怠"
    },
    {
      "ordinal": 261,
      "start_ms": 899220,
      "end_ms": 900080,
      "text": "不要懈怠"
    },
    {
      "ordinal": 262,
      "start_ms": 900080,
      "end_ms": 905680,
      "text": "就是说不懈怠不代表瞎忙瞎冲"
    },
    {
      "ordinal": 263,
      "start_ms": 906410,
      "end_ms": 907470,
      "text": "要审慎"
    },
    {
      "ordinal": 264,
      "start_ms": 907470,
      "end_ms": 908750,
      "text": "多花时间思考"
    },
    {
      "ordinal": 265,
      "start_ms": 908750,
      "end_ms": 910770,
      "text": "但是不能就是仅停留于思考"
    },
    {
      "ordinal": 266,
      "start_ms": 910770,
      "end_ms": 911250,
      "text": "你思考"
    },
    {
      "ordinal": 267,
      "start_ms": 911250,
      "end_ms": 912810,
      "text": "你觉得差不多是个头脑"
    },
    {
      "ordinal": 268,
      "start_ms": 912810,
      "end_ms": 914610,
      "text": "你就得去试错"
    },
    {
      "ordinal": 269,
      "start_ms": 914610,
      "end_ms": 915610,
      "text": "得去落实"
    },
    {
      "ordinal": 270,
      "start_ms": 915610,
      "end_ms": 916850,
      "text": "不要害怕被我吊"
    },
    {
      "ordinal": 271,
      "start_ms": 917890,
      "end_ms": 922000,
      "text": "不要害怕被我们这个管理层怎么样啊"
    },
    {
      "ordinal": 272,
      "start_ms": 922000,
      "end_ms": 925100,
      "text": "我们我是至少我是通情达理的"
    },
    {
      "ordinal": 273,
      "start_ms": 925100,
      "end_ms": 926220,
      "text": "你犯这些错误的话"
    },
    {
      "ordinal": 274,
      "start_ms": 926220,
      "end_ms": 928780,
      "text": "如果说不是特别原则性的"
    },
    {
      "ordinal": 275,
      "start_ms": 928780,
      "end_ms": 929820,
      "text": "不是特别严重的"
    },
    {
      "ordinal": 276,
      "start_ms": 930940,
      "end_ms": 933190,
      "text": "我是通情达理的啊"
    },
    {
      "ordinal": 277,
      "start_ms": 933190,
      "end_ms": 934750,
      "text": "你觉得你是受委屈了"
    },
    {
      "ordinal": 278,
      "start_ms": 934750,
      "end_ms": 936350,
      "text": "得到不公正的一个管理"
    },
    {
      "ordinal": 279,
      "start_ms": 936350,
      "end_ms": 941440,
      "text": "一个一个这个控制的一个反馈的一个裁决的"
    },
    {
      "ordinal": 280,
      "start_ms": 941440,
      "end_ms": 945820,
      "text": "都可以向我来打小报告哈"
    },
    {
      "ordinal": 281,
      "start_ms": 948160,
      "end_ms": 951320,
      "text": "唉总体来讲是虽然我表面刀"
    },
    {
      "ordinal": 282,
      "start_ms": 951320,
      "end_ms": 954480,
      "text": "我是标准的这个刀子嘴豆腐心啊"
    },
    {
      "ordinal": 283,
      "start_ms": 954800,
      "end_ms": 959800,
      "text": "宽人嘴巴上坏话说尽好好事做绝啊"
    },
    {
      "ordinal": 284,
      "start_ms": 960650,
      "end_ms": 962170,
      "text": "心地柔软一批"
    },
    {
      "ordinal": 285,
      "start_ms": 962170,
      "end_ms": 965050,
      "text": "我靠有人说我无毒不丈夫"
    },
    {
      "ordinal": 286,
      "start_ms": 965050,
      "end_ms": 970280,
      "text": "你妈你现在天天晚上是不是特哎呀"
    },
    {
      "ordinal": 287,
      "start_ms": 970280,
      "end_ms": 971000,
      "text": "实事求是讲"
    },
    {
      "ordinal": 288,
      "start_ms": 971000,
      "end_ms": 974400,
      "text": "其实都故有些人故意说点让我难受的话"
    },
    {
      "ordinal": 289,
      "start_ms": 974400,
      "end_ms": 975900,
      "text": "我也不是很难受"
    },
    {
      "ordinal": 290,
      "start_ms": 975900,
      "end_ms": 978280,
      "text": "有的时候是傲娇的话"
    },
    {
      "ordinal": 291,
      "start_ms": 978280,
      "end_ms": 981500,
      "text": "听多了也就那样好吧"
    },
    {
      "ordinal": 292,
      "start_ms": 981500,
      "end_ms": 984640,
      "text": "就不要跟我扯什么瞎犊子"
    },
    {
      "ordinal": 293,
      "start_ms": 984640,
      "end_ms": 986100,
      "text": "乱七八糟那些东西"
    },
    {
      "ordinal": 294,
      "start_ms": 986100,
      "end_ms": 987280,
      "text": "先好好休息"
    },
    {
      "ordinal": 295,
      "start_ms": 987280,
      "end_ms": 988400,
      "text": "好好休息之后"
    },
    {
      "ordinal": 296,
      "start_ms": 988400,
      "end_ms": 992470,
      "text": "大家好好的把这个事情呢合计一下"
    },
    {
      "ordinal": 297,
      "start_ms": 992470,
      "end_ms": 994090,
      "text": "9月份啊"
    },
    {
      "ordinal": 298,
      "start_ms": 994090,
      "end_ms": 995910,
      "text": "那后面要我要我要出长途了"
    },
    {
      "ordinal": 299,
      "start_ms": 995910,
      "end_ms": 996790,
      "text": "我靠啊"
    },
    {
      "ordinal": 300,
      "start_ms": 996790,
      "end_ms": 998239,
      "text": "你们自己啊"
    },
    {
      "ordinal": 301,
      "start_ms": 998239,
      "end_ms": 999439,
      "text": "我倒要看看啊"
    },
    {
      "ordinal": 302,
      "start_ms": 999439,
      "end_ms": 1002579,
      "text": "就这个9月上旬你们能不能把这个事情做好啊"
    },
    {
      "ordinal": 303,
      "start_ms": 1002579,
      "end_ms": 1006819,
      "text": "把一些这个工作思路理顺啊"
    },
    {
      "ordinal": 304,
      "start_ms": 1007090,
      "end_ms": 1010110,
      "text": "是吧啊"
    },
    {
      "ordinal": 305,
      "start_ms": 1010110,
      "end_ms": 1013730,
      "text": "我这什么5号六号出发啊"
    },
    {
      "ordinal": 306,
      "start_ms": 1015730,
      "end_ms": 1017810,
      "text": "9号时候回来"
    },
    {
      "ordinal": 307,
      "start_ms": 1021300,
      "end_ms": 1022960,
      "text": "有些人不要露马脚啊"
    },
    {
      "ordinal": 308,
      "start_ms": 1022960,
      "end_ms": 1025800,
      "text": "反正这是一个上旬的一个"
    },
    {
      "ordinal": 309,
      "start_ms": 1025800,
      "end_ms": 1028339,
      "text": "对上上一阶段工作一个总结"
    },
    {
      "ordinal": 310,
      "start_ms": 1028339,
      "end_ms": 1031750,
      "text": "然后希望你们再接再厉啊"
    },
    {
      "ordinal": 311,
      "start_ms": 1034430,
      "end_ms": 1038680,
      "text": "能BA就是你实在不开心"
    },
    {
      "ordinal": 312,
      "start_ms": 1038680,
      "end_ms": 1039500,
      "text": "实在不乐意"
    },
    {
      "ordinal": 313,
      "start_ms": 1039500,
      "end_ms": 1040420,
      "text": "不要毕业"
    },
    {
      "ordinal": 314,
      "start_ms": 1040420,
      "end_ms": 1044020,
      "text": "我们也会想办法给你一个好的安排的"
    },
    {
      "ordinal": 315,
      "start_ms": 1044579,
      "end_ms": 1046280,
      "text": "对啊"
    },
    {
      "ordinal": 316,
      "start_ms": 1046280,
      "end_ms": 1049120,
      "text": "只要你不犯原则性错误啊"
    },
    {
      "ordinal": 317,
      "start_ms": 1049120,
      "end_ms": 1049720,
      "text": "不犯原则"
    },
    {
      "ordinal": 318,
      "start_ms": 1049720,
      "end_ms": 1052080,
      "text": "什么03:30什么的啊"
    },
    {
      "ordinal": 319,
      "start_ms": 1052080,
      "end_ms": 1055159,
      "text": "那种什么打电话报警什么东西"
    },
    {
      "ordinal": 320,
      "start_ms": 1055479,
      "end_ms": 1061630,
      "text": "想要想要想要把这个打包的哎呀"
    },
    {
      "ordinal": 321,
      "start_ms": 1061630,
      "end_ms": 1062990,
      "text": "穷兄弟给弄进去"
    },
    {
      "ordinal": 322,
      "start_ms": 1062990,
      "end_ms": 1064650,
      "text": "卧槽这种原则性的"
    },
    {
      "ordinal": 323,
      "start_ms": 1064650,
      "end_ms": 1065730,
      "text": "这是原谅不了的"
    },
    {
      "ordinal": 324,
      "start_ms": 1065730,
      "end_ms": 1067100,
      "text": "没办法的"
    },
    {
      "ordinal": 325,
      "start_ms": 1067340,
      "end_ms": 1068560,
      "text": "你不是原则性的"
    },
    {
      "ordinal": 326,
      "start_ms": 1068560,
      "end_ms": 1070520,
      "text": "不是这个呃"
    },
    {
      "ordinal": 327,
      "start_ms": 1070520,
      "end_ms": 1074100,
      "text": "就是击穿我们的这个价值和坚守的"
    },
    {
      "ordinal": 328,
      "start_ms": 1074100,
      "end_ms": 1075670,
      "text": "立场的底线的话"
    },
    {
      "ordinal": 329,
      "start_ms": 1075670,
      "end_ms": 1077290,
      "text": "队友的弹好吧"
    },
    {
      "ordinal": 330,
      "start_ms": 1077290,
      "end_ms": 1079310,
      "text": "然后要懂得控制自己啊"
    },
    {
      "ordinal": 331,
      "start_ms": 1083290,
      "end_ms": 1084750,
      "text": "说不要犯病啊"
    },
    {
      "ordinal": 332,
      "start_ms": 1084750,
      "end_ms": 1085610,
      "text": "犯病了之后"
    },
    {
      "ordinal": 333,
      "start_ms": 1085610,
      "end_ms": 1087050,
      "text": "你去想个办法"
    },
    {
      "ordinal": 334,
      "start_ms": 1087050,
      "end_ms": 1088570,
      "text": "先让自己情绪稳定下来"
    },
    {
      "ordinal": 335,
      "start_ms": 1088570,
      "end_ms": 1089820,
      "text": "再和我沟通"
    },
    {
      "ordinal": 336,
      "start_ms": 1089820,
      "end_ms": 1092220,
      "text": "我的时间也很宝贵啊"
    },
    {
      "ordinal": 337,
      "start_ms": 1092220,
      "end_ms": 1095809,
      "text": "我的这个心情脆弱不脆弱啊"
    },
    {
      "ordinal": 338,
      "start_ms": 1095809,
      "end_ms": 1098349,
      "text": "我现在现在还是挺挺坚定的"
    },
    {
      "ordinal": 339,
      "start_ms": 1098349,
      "end_ms": 1100089,
      "text": "但是"
    },
    {
      "ordinal": 340,
      "start_ms": 1101800,
      "end_ms": 1103220,
      "text": "我也会有情绪"
    },
    {
      "ordinal": 341,
      "start_ms": 1103220,
      "end_ms": 1104630,
      "text": "我也会有情绪"
    },
    {
      "ordinal": 342,
      "start_ms": 1104630,
      "end_ms": 1106310,
      "text": "我情绪可能起来"
    },
    {
      "ordinal": 343,
      "start_ms": 1106310,
      "end_ms": 1107750,
      "text": "当时我会让你很难受"
    },
    {
      "ordinal": 344,
      "start_ms": 1107750,
      "end_ms": 1109470,
      "text": "但是后面我自己也会后悔啊"
    },
    {
      "ordinal": 345,
      "start_ms": 1109470,
      "end_ms": 1111270,
      "text": "也会慢慢找补调整"
    },
    {
      "ordinal": 346,
      "start_ms": 1111270,
      "end_ms": 1113130,
      "text": "我就这么个人"
    },
    {
      "ordinal": 347,
      "start_ms": 1113130,
      "end_ms": 1115970,
      "text": "但是说还有一点是严重问题"
    },
    {
      "ordinal": 348,
      "start_ms": 1115970,
      "end_ms": 1118119,
      "text": "想绕过我啊"
    },
    {
      "ordinal": 349,
      "start_ms": 1118119,
      "end_ms": 1120059,
      "text": "想要去这个越权"
    },
    {
      "ordinal": 350,
      "start_ms": 1120059,
      "end_ms": 1122979,
      "text": "或者说决定什么重重大事项瞎逼搞"
    },
    {
      "ordinal": 351,
      "start_ms": 1122979,
      "end_ms": 1125640,
      "text": "或者说做某些刻意"
    },
    {
      "ordinal": 352,
      "start_ms": 1125640,
      "end_ms": 1127960,
      "text": "做某些这个违背我的原则的事"
    },
    {
      "ordinal": 353,
      "start_ms": 1127960,
      "end_ms": 1131800,
      "text": "然后啊拿我的只言片语当成鸡毛令箭"
    },
    {
      "ordinal": 354,
      "start_ms": 1131800,
      "end_ms": 1133580,
      "text": "最后甩锅甩到我头上"
    },
    {
      "ordinal": 355,
      "start_ms": 1133580,
      "end_ms": 1136320,
      "text": "这东西呢我回头看在眼里"
    },
    {
      "ordinal": 356,
      "start_ms": 1136320,
      "end_ms": 1138980,
      "text": "哼好吧"
    },
    {
      "ordinal": 357,
      "start_ms": 1138980,
      "end_ms": 1140240,
      "text": "那不说太多了"
    },
    {
      "ordinal": 358,
      "start_ms": 1140240,
      "end_ms": 1142300,
      "text": "我不会不想给你们太大压力"
    },
    {
      "ordinal": 359,
      "start_ms": 1142300,
      "end_ms": 1143220,
      "text": "反正你去休息吧"
    },
    {
      "ordinal": 360,
      "start_ms": 1143220,
      "end_ms": 1144520,
      "text": "好好的休息"
    },
    {
      "ordinal": 361,
      "start_ms": 1144520,
      "end_ms": 1145480,
      "text": "好好的休息"
    },
    {
      "ordinal": 362,
      "start_ms": 1145480,
      "end_ms": 1147080,
      "text": "这个把这个阅兵式"
    },
    {
      "ordinal": 363,
      "start_ms": 1147080,
      "end_ms": 1150840,
      "text": "大家啊全国都在关注这个事情"
    },
    {
      "ordinal": 364,
      "start_ms": 1150840,
      "end_ms": 1154980,
      "text": "好好嘶观赏观赏啊"
    },
    {
      "ordinal": 365,
      "start_ms": 1154980,
      "end_ms": 1156540,
      "text": "庆贺庆贺啊"
    },
    {
      "ordinal": 366,
      "start_ms": 1156540,
      "end_ms": 1158480,
      "text": "感受感受与国同庆好"
    },
    {
      "ordinal": 367,
      "start_ms": 1158480,
      "end_ms": 1159240,
      "text": "那就这样啊"
    },
    {
      "ordinal": 368,
      "start_ms": 1159240,
      "end_ms": 1159880,
      "text": "拜拜"
