  "segments": [
    {
      "ordinal": 0,
      "start_ms": 42240,
      "end_ms": 64400,
      "text": "算人间处处是晦暗无边，迷清境在何方？"
    },
    {
      "ordinal": 1,
      "start_ms": 69840,
      "end_ms": 79920,
      "text": "踏长夜漫漫里露水如光，静安尘无意彷徨。"
    },
    {
      "ordinal": 2,
      "start_ms": 83840,
      "end_ms": 93360,
      "text": "一醉青冈，风华搜寻无方，暗剑舞轻抚神光。"
    },
    {
      "ordinal": 3,
      "start_ms": 97520,
      "end_ms": 102400,
      "text": "摇落风中，朱红点缀谁上？"
    },
    {
      "ordinal": 4,
      "start_ms": 102720,
      "end_ms": 115200,
      "text": "剩落花，白叶残妆。何方？"
    },
    {
      "ordinal": 5,
      "start_ms": 117120,
      "end_ms": 121920,
      "text": "小径疏，狂看小我。"
    },
    {
      "ordinal": 6,
      "start_ms": 123840,
      "end_ms": 128800,
      "text": "仰天举不见舟航，"
    },
    {
      "ordinal": 7,
      "start_ms": 130720,
      "end_ms": 135040,
      "text": "迷清境在何方？"
    },
    {
      "ordinal": 8,
      "start_ms": 140080,
      "end_ms": 149120,
      "text": "猖狂，尘苦奢疏一品神光。"
    },
    {
      "ordinal": 9,
      "start_ms": 150720,
      "end_ms": 155840,
      "text": "容貌竟如此堂皇，"
    },
    {
      "ordinal": 10,
      "start_ms": 157680,
      "end_ms": 162240,
      "text": "迷清境在何方？"
    },
    {
      "ordinal": 11,
      "start_ms": 163760,
      "end_ms": 174000,
      "text": "算人间处处是晦暗无边，迷清境在何方？"
    },
    {
      "ordinal": 12,
      "start_ms": 179775,
      "end_ms": 189855,
      "text": "踏长夜漫漫，露水如光，静安尘，无力彷徨。"
    },
    {
      "ordinal": 13,
      "start_ms": 193615,
      "end_ms": 203055,
      "text": "一醉青冈，风华搜寻无方，暗剑舞，轻抚神光。"
    },
    {
      "ordinal": 14,
      "start_ms": 207295,
      "end_ms": 216255,
      "text": "摇落风中，朱红点翠水上，剩落花，败叶残妆。"
    },
    {
      "ordinal": 15,
      "start_ms": 221375,
      "end_ms": 230255,
      "text": "担当世事千言无常，纵有愁，岂敢付与长。"
    },
    {
      "ordinal": 16,
      "start_ms": 234175,
      "end_ms": 243615,
      "text": "都化作流水倏然远去，在归时数落半草。"
    },
    {
      "ordinal": 17,
      "start_ms": 247775,
      "end_ms": 257055,
      "text": "一醉青冈，风华搜寻无方，暗剑舞，轻抚神光。"
    },
    {
      "ordinal": 18,
      "start_ms": 261055,
      "end_ms": 271535,
      "text": "摇落风中，朱红点翠水上，剩落花，败叶残妆。"
    }
