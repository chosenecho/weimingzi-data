{"segments":[{"start":0.22,"end":4.019,"text":"就是说历史当中是充满了非常诡异的"},{"start":4.019,"end":8.53,"text":"但是是是非常巨大的巧合的啊"},{"start":10.21,"end":14.66,"text":"说出来睡不着觉的巧合"},{"start":16.92,"end":22.84,"text":"但是这种巧合肯定是给做好了全然准备的人"},{"start":22.84,"end":27.35,"text":"或者团体的这些东西又不是呃"},{"start":27.35,"end":28.71,"text":"没办法和别人说的"},{"start":28.71,"end":30.05,"text":"这不是运气啊"},{"start":30.05,"end":31.85,"text":"这都不是运气"},{"start":31.85,"end":33.01,"text":"说不出来的"},{"start":33.01,"end":34.19,"text":"不可能说的"},{"start":34.19,"end":35.81,"text":"可能过几十年之后"},{"start":35.81,"end":40.23,"text":"我们团队的发展史里面可能会把它写出来"},{"start":40.23,"end":41.71,"text":"但是是说不出来的"},{"start":42.71,"end":44.47,"text":"无论如何呢"},{"start":51.42,"end":56.7,"text":"我们在历史面前保有了全部的尊严啊"},{"start":56.7,"end":61.94,"text":"也有了就是比较重要的成就"},{"start":62.54,"end":66.609,"text":"这个是呃所有人努力的结果啊"},{"start":66.609,"end":70.549,"text":"我们这个舵呢我觉得我还是有自信"},{"start":70.549,"end":73.46,"text":"说我没有长歪这个舵"},{"start":73.86,"end":75.98,"text":"但是说现在成绩也没有"},{"start":75.98,"end":79.9,"text":"就是说真的全做出来啊"},{"start":86.44,"end":88.92,"text":"嗯是好事"},{"start":88.92,"end":90.42,"text":"但是不能叫好事"},{"start":90.42,"end":92.04,"text":"是一件重要的事"},{"start":92.04,"end":94.56,"text":"甚至说是一件很重要的一件事"},{"start":98.9,"end":101.54,"text":"这个历史是现实的"},{"start":102.1,"end":108.13,"text":"然后呢机会也是现实的各种风险嗯"},{"start":109.53,"end":114.65,"text":"事物的潜在的走向和这个最后的真实的后果"},{"start":114.65,"end":116.87,"text":"这些都是真实的"},{"start":128.96,"end":130.12,"text":"哦没有被招安"},{"start":130.12,"end":131.22,"text":"不可能被招安的"},{"start":131.22,"end":133.28,"text":"这种事情怎么可能被招安呢"},{"start":133.28,"end":134.0,"text":"这搞笑呢"},{"start":134.0,"end":135.32,"text":"绝对不会是被招安的啊"},{"start":136.36,"end":137.75,"text":"做梦的"},{"start":144.04,"end":146.56,"text":"但因为这里面是有一种普遍性"},{"start":147.64,"end":148.98,"text":"苦心孤诣"},{"start":148.98,"end":152.16,"text":"有一种普遍性啊"},{"start":152.16,"end":155.22,"text":"一个普遍性横亘在历史之中"},{"start":155.74,"end":159.06,"text":"这个不会就是简单的讲"},{"start":159.06,"end":163.88,"text":"他不但会以个人的这个命运来折射"},{"start":163.88,"end":164.68,"text":"它"},{"start":164.68,"end":173.43,"text":"会是以这个团队的使命和这个这个使命"},{"start":173.43,"end":174.79,"text":"带动下的活动"},{"start":174.79,"end":182.249,"text":"他的啊获得了整个世界的这个回应啊"},{"start":182.249,"end":185.464,"text":"作为一个基本单元而存在"},{"start":191.28,"end":192.88,"text":"不这不是生存问题"},{"start":192.88,"end":194.2,"text":"我没说我没有被招安"},{"start":194.2,"end":195.4,"text":"这不是被招安这个东西"},{"start":195.4,"end":197.5,"text":"你们说我们被招安了"},{"start":197.5,"end":199.82,"text":"这太太太瞧不起我们了"},{"start":199.82,"end":201.64,"text":"太太瞧不起我们了"},{"start":201.64,"end":203.32,"text":"这种什么被招安不招安"},{"start":203.32,"end":206.14,"text":"这东西根本我不这这不配我来"},{"start":206.14,"end":208.6,"text":"我来就比较郑重其事的"},{"start":208.6,"end":210.6,"text":"或者他不能激起我的任何的"},{"start":211.6,"end":215.979,"text":"对于这个历史的觉知啊"},{"start":218.38,"end":220.3,"text":"对这是可以说是世界的回应"},{"start":221.34,"end":224.2,"text":"世界的巧合的很荒诞的"},{"start":224.2,"end":225.74,"text":"非常巧合的一种回应"},{"start":225.74,"end":227.08,"text":"但是他是回应"},{"start":228.88,"end":231.26,"text":"嗯你们不要不要幻想了"},{"start":231.26,"end":237.45,"text":"就是没有办法直接告诉你们这是什么"},{"start":238.21,"end":240.77,"text":"但是你只要你活的时间够长"},{"start":240.77,"end":241.73,"text":"你会活30年"},{"start":241.73,"end":242.13,"text":"40年"},{"start":242.13,"end":243.17,"text":"你会知道这是什么的"},{"start":243.17,"end":244.37,"text":"What it is"},{"start":244.37,"end":245.97,"text":"好吧"},{"start":256.76,"end":260.8,"text":"呃我们在生活当中很多事物没有办法控制"},{"start":262.719,"end":267.95,"text":"绝大部分的现实就是不按照我们的想法"},{"start":267.95,"end":270.19,"text":"在在变化"},{"start":275.54,"end":276.88,"text":"能够坚持的"},{"start":276.88,"end":282.96,"text":"能够去把握住的只是一些很粗浅的信条信念"},{"start":284.12,"end":287.47,"text":"还有一些嗯目力所及"},{"start":287.47,"end":288.99,"text":"就是"},{"start":290.46,"end":291.98,"text":"比较狭隘啊"},{"start":291.98,"end":294.02,"text":"比较这个"},{"start":297.3,"end":302.05,"text":"比较耳近的这些局部周遭啊"},{"start":303.13,"end":304.78,"text":"没办法呀"},{"start":305.1,"end":307.24,"text":"就给了这些东西啊"},{"start":307.24,"end":310.54,"text":"啊没有办法没有办法"},{"start":315.06,"end":317.82,"text":"对我们认为我们有一定的成就了"},{"start":319.26,"end":321.28,"text":"我们认为我们有一定的成就了"},{"start":321.28,"end":326.94,"text":"只是我们认为呃我们至少我们在某种意义上讲"},{"start":326.94,"end":328.26,"text":"我们自居"},{"start":328.26,"end":329.48,"text":"我们的自居"},{"start":329.48,"end":332.83,"text":"我们的自认是内心"},{"start":332.83,"end":335.73,"text":"不再会有任何的自我怀疑和自我犹"},{"start":335.73,"end":337.95,"text":"没有任何的犹豫了"},{"start":338.729,"end":339.609,"text":"明白吗"},{"start":339.609,"end":340.609,"text":"我们不当"},{"start":340.609,"end":343.449,"text":"不再会对于我们自己的内在身份认同"},{"start":343.449,"end":346.02,"text":"会有任何的怀疑和犹豫了"},{"start":346.06,"end":349.62,"text":"在这个讲我们是比较幸福的啊"},{"start":350.78,"end":352.28,"text":"我们是非常幸福的"},{"start":352.28,"end":353.77,"text":"好吧"},{"start":358.78,"end":360.98,"text":"不他不来自于外部的肯定"},{"start":360.98,"end":362.98,"text":"不来自于任何团体的肯定"},{"start":362.98,"end":365.39,"text":"它来自于历史的肯定"},{"start":365.39,"end":366.35,"text":"我们这样说"},{"start":366.35,"end":369.92,"text":"我们认为我们被历史肯定了"},{"start":370.64,"end":373.28,"text":"我们被历史肯定了"},{"start":373.28,"end":374.24,"text":"好吧"},{"start":374.24,"end":378.3,"text":"我们被人类的命运呃"},{"start":378.3,"end":382.72,"text":"发起命运改变的某种历史的契机所肯定了"},{"start":385.44,"end":388.88,"text":"嗯这个是嗯"},{"start":389.62,"end":393.32,"text":"这是非常值得我们去骄傲的"},{"start":393.32,"end":397.34,"text":"非让我们去思考其中的缘由"},{"start":398.8,"end":402.68,"text":"对一件事情一个重大征兆"},{"start":404.4,"end":407.32,"text":"好吧"},{"start":413.82,"end":414.56,"text":"行吧"},{"start":414.56,"end":417.06,"text":"那反正就讲到这边啊"},{"start":417.06,"end":417.86,"text":"他们也很累了"},{"start":419.84,"end":420.74,"text":"很累了"},{"start":420.74,"end":424.609,"text":"我明天也会比较比较忙碌啊"},{"start":425.769,"end":427.449,"text":"明天我比较忙碌"},{"start":431.46,"end":432.62,"text":"就很多巧合"},{"start":434.94,"end":437.62,"text":"很多令人疑惑的"},{"start":438.56,"end":440.32,"text":"这东西算什么呢"},{"start":441.56,"end":443.0,"text":"还不管这东西算什么了"},{"start":443.0,"end":445.16,"text":"反正这些"},{"start":466.8,"end":468.6,"text":"嗯这不是奇迹"},{"start":468.6,"end":472.12,"text":"这背后是有这个逻辑的"},{"start":473.16,"end":475.38,"text":"背后是有客观真理在运行的"},{"start":475.38,"end":476.52,"text":"与其说是奇迹"},{"start":476.52,"end":479.52,"text":"不如说是这是真理和真相的显现"},{"start":479.52,"end":481.6,"text":"它是真理和真相的显现"},{"start":483.72,"end":487.19,"text":"我们会一齐啊"},{"start":487.19,"end":491.79,"text":"和一起去把握住这些机会"},{"start":491.79,"end":496.23,"text":"嗯虽然比较困难啊"},{"start":496.23,"end":499.06,"text":"但总体来讲的话就是说"},{"start":508.2,"end":512.48,"text":"好不扯了不扯了不扯了不扯不扯不扯不扯了"},{"start":512.808,"end":517.049,"text":"就是我们远远比你们想象的要积极乐观的多"},{"start":517.049,"end":522.308,"text":"而且历史也在回应印证这样的积极和乐观"},{"start":522.429,"end":526.34,"text":"以及比如说很多决策"},{"start":526.34,"end":529.22,"text":"我就是很豁然的去豁达地去做了"},{"start":529.22,"end":531.7,"text":"不会有什么犹豫的"},{"start":532.039,"end":536.019,"text":"就可能这事说会有什么样的后果和代价"},{"start":536.019,"end":536.479,"text":"什么什么"},{"start":536.479,"end":540.16,"text":"但是我们考虑就是不论怎样"},{"start":540.16,"end":542.0,"text":"就只有这些方向了"},{"start":542.0,"end":543.54,"text":"没办法的"},{"start":546.12,"end":547.52,"text":"不论怎样"},{"start":547.52,"end":549.8,"text":"就只有这些方向"},{"start":553.52,"end":554.04,"text":"好吧"},{"start":555.48,"end":556.28,"text":"那讲到这里啊"},{"start":556.28,"end":558.34,"text":"拜拜拜拜"}],"source":"subtitle"}
