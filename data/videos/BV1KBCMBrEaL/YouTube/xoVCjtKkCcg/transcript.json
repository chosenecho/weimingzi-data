{
  "model": "qwen-audio-3.1-asr-flash",
  "audio_sha256": "3e7eddf273fae8c45277a2903ead7df6d98872314713a18d76bc3aa2e9e1c88e",
  "chunk_seconds": 240,
  "speaker_diarization_enabled": true,
