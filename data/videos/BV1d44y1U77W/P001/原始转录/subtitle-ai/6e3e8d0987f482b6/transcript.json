    {
      "ordinal": 141,
      "start_ms": 425620,
      "end_ms": 426960,
      "text": "我实事求是讲"
    },
    {
      "ordinal": 142,
      "start_ms": 426960,
      "end_ms": 430020,
      "text": "跑过去就要别人就是盲目的去认你的权威"
