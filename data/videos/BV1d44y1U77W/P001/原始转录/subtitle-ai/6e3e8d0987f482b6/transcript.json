      "ordinal": 269,
      "start_ms": 741620,
      "end_ms": 742880,
      "text": "我是要重装甲"
    },
    {
      "ordinal": 270,
      "start_ms": 742880,
      "end_ms": 744170,
      "text": "你们这些是一个"
    },
    {
      "ordinal": 271,
      "start_ms": 744170,
      "end_ms": 746120,
      "text": "why are you going to do"
    },
    {
      "ordinal": 272,
      "start_ms": 746760,
      "end_ms": 748070,
      "text": "真搞笑"
    },
    {
      "ordinal": 273,
      "start_ms": 748070,
      "end_ms": 751520,
      "text": "还还好意思说我是改良我的花"
    },
    {
      "ordinal": 274,
      "start_ms": 751520,
      "end_ms": 753479,
      "text": "天下之大稽"
    },
    {
      "ordinal": 275,
      "start_ms": 754280,
      "end_ms": 756580,
      "text": "四城华天下之大忌"
    },
    {
      "ordinal": 276,
      "start_ms": 756580,
      "end_ms": 757420,
      "text": "真的是滑天"
    },
    {
      "ordinal": 277,
      "start_ms": 757420,
      "end_ms": 761100,
      "text": "我就我就说我说今年是202年12月4号"
    },
    {
      "ordinal": 278,
      "start_ms": 761100,
      "end_ms": 762930,
      "text": "我我有的时候我遗憾"
    },
    {
      "ordinal": 279,
      "start_ms": 762930,
      "end_ms": 765829,
      "text": "我今年没有听到一个特别搞笑的一个笑话"
    },
    {
      "ordinal": 280,
      "start_ms": 765829,
      "end_ms": 767689,
      "text": "在你们这篇是什么春草"
    },
    {
      "ordinal": 281,
      "start_ms": 767689,
      "end_ms": 769669,
      "text": "这个这个三流笔杆子"
    },
    {
      "ordinal": 282,
      "start_ms": 769669,
      "end_ms": 771949,
      "text": "我前一个视频已经把他骂的狗血淋头"
    },
    {
      "ordinal": 283,
      "start_ms": 771949,
      "end_ms": 774610,
      "text": "这个三流六流笔杆子的嘴巴里面"
    },
    {
      "ordinal": 284,
      "start_ms": 774610,
      "end_ms": 779560,
      "text": "我听到了一个今年最搞笑的活天下之大稽"
    },
    {
      "ordinal": 285,
      "start_ms": 779560,
      "end_ms": 781420,
      "text": "的一个可笑至极的"
    },
    {
      "ordinal": 286,
      "start_ms": 782080,
      "end_ms": 783450,
      "text": "这不是搞笑"
    },
    {
      "ordinal": 287,
      "start_ms": 783450,
      "end_ms": 785400,
      "text": "你这个你有啥资格"
    },
    {
      "ordinal": 288,
      "start_ms": 785400,
      "end_ms": 787080,
      "text": "鲁有什么资格"
    },
    {
      "ordinal": 289,
      "start_ms": 787080,
      "end_ms": 788880,
      "text": "鲁有何资格"
    },
    {
      "ordinal": 290,
      "start_ms": 789840,
      "end_ms": 790640,
      "text": "我就问你"
    },
    {
      "ordinal": 291,
      "start_ms": 790640,
      "end_ms": 791660,
      "text": "你有什么资格"
    },
    {
      "ordinal": 292,
      "start_ms": 793280,
      "end_ms": 794180,
      "text": "真搞笑"
    },
    {
      "ordinal": 293,
      "start_ms": 794180,
      "end_ms": 795380,
      "text": "你知道三流货色"
    },
    {
      "ordinal": 294,
      "start_ms": 795380,
      "end_ms": 796579,
      "text": "你有流货色"
    },
    {
      "ordinal": 295,
      "start_ms": 796620,
      "end_ms": 798240,
      "text": "笑死人了"
    },
    {
      "ordinal": 296,
      "start_ms": 798240,
      "end_ms": 801840,
      "text": "你们这种什么哦"
    },
    {
      "ordinal": 297,
      "start_ms": 801840,
      "end_ms": 805940,
      "text": "哟你们这种什么激进政治经济学家学会"
    },
    {
      "ordinal": 298,
      "start_ms": 805940,
      "end_ms": 806990,
      "text": "就叫你妈呢"
    },
    {
      "ordinal": 299,
      "start_ms": 810290,
      "end_ms": 811430,
      "text": "这个叫激进了"
    },
    {
      "ordinal": 300,
      "start_ms": 811430,
      "end_ms": 812790,
      "text": "这个叫资格了"
    },
    {
      "ordinal": 301,
      "start_ms": 815010,
      "end_ms": 816390,
      "text": "控制几个师了吗"
    },
    {
      "ordinal": 302,
      "start_ms": 816390,
      "end_ms": 819780,
      "text": "狗屁穷酸措大"
    },
    {
      "ordinal": 303,
      "start_ms": 821280,
      "end_ms": 822920,
      "text": "在搞笑活在梦里面"
    },
    {
      "ordinal": 304,
      "start_ms": 822920,
      "end_ms": 824390,
      "text": "他活在活在梦里"
    },
    {
      "ordinal": 305,
      "start_ms": 826940,
      "end_ms": 828459,
      "text": "最序的一个梦里啊"
    },
    {
      "ordinal": 306,
      "start_ms": 831060,
      "end_ms": 832800,
      "text": "实际上就是个穷酸梦"
    },
    {
      "ordinal": 307,
      "start_ms": 832800,
      "end_ms": 835140,
      "text": "你们这什么这狗屁理论家"
    },
    {
      "ordinal": 308,
      "start_ms": 835140,
      "end_ms": 838680,
      "text": "青年理论家就是弄得一身骚气"
    },
    {
      "ordinal": 309,
      "start_ms": 838680,
      "end_ms": 842620,
      "text": "想要去别人收买你最可耻"
    },
    {
      "ordinal": 310,
      "start_ms": 842620,
      "end_ms": 843880,
      "text": "最可恶"
    },
    {
      "ordinal": 311,
      "start_ms": 845020,
      "end_ms": 847160,
      "text": "叫别人就给你卖命送死"
    },
    {
      "ordinal": 312,
      "start_ms": 847480,
      "end_ms": 848800,
      "text": "躲在后面"
    },
    {
      "ordinal": 313,
      "start_ms": 848800,
      "end_ms": 850240,
      "text": "躲在那个笔名后面"
    },
    {
      "ordinal": 314,
      "start_ms": 850240,
      "end_ms": 851230,
      "text": "躲在什么地方"
    },
    {
      "ordinal": 315,
      "start_ms": 851230,
      "end_ms": 852580,
      "text": "你把躲在谁后面"
    },
    {
      "ordinal": 316,
      "start_ms": 852580,
      "end_ms": 853960,
      "text": "谁不知道你是谁吗"
    },
    {
      "ordinal": 317,
      "start_ms": 853960,
      "end_ms": 856180,
      "text": "眼皮底下不知道你是谁吗"
    },
    {
      "ordinal": 318,
      "start_ms": 859100,
      "end_ms": 859580,
      "text": "你知道吗"
    },
    {
      "ordinal": 319,
      "start_ms": 859580,
      "end_ms": 860750,
      "text": "太恶心了"
    },
    {
      "ordinal": 320,
      "start_ms": 860750,
      "end_ms": 862130,
      "text": "terrible"
    },
    {
      "ordinal": 321,
      "start_ms": 862130,
      "end_ms": 863420,
      "text": "阿格里"
    },
    {
      "ordinal": 322,
      "start_ms": 863640,
      "end_ms": 865819,
      "text": "extremely ugly"
    },
    {
      "ordinal": 323,
      "start_ms": 866540,
      "end_ms": 867340,
      "text": "太恶心了"
    },
    {
      "ordinal": 324,
      "start_ms": 867340,
      "end_ms": 869530,
      "text": "我真的我真的是我活在这个世界上"
    },
    {
      "ordinal": 325,
      "start_ms": 869530,
      "end_ms": 871600,
      "text": "如果有的时候就是说你们这种恶心"
    },
    {
      "ordinal": 326,
      "start_ms": 871600,
      "end_ms": 874180,
      "text": "真是令人丧失生活的希望啊"
    },
    {
      "ordinal": 327,
      "start_ms": 874180,
      "end_ms": 876160,
      "text": "但是说我也是认清了"
    },
    {
      "ordinal": 328,
      "start_ms": 877240,
      "end_ms": 879810,
      "text": "就是说某种意义上就是生活的美好"
    },
    {
      "ordinal": 329,
      "start_ms": 879810,
      "end_ms": 882120,
      "text": "需要你们这些丑恶来衬托一下"
    },
    {
      "ordinal": 330,
      "start_ms": 882120,
      "end_ms": 883980,
      "text": "我是我觉得你们衬托的够了"
    },
    {
      "ordinal": 331,
      "start_ms": 883980,
      "end_ms": 884820,
      "text": "不要一直冒出来"
    },
    {
      "ordinal": 332,
      "start_ms": 884820,
      "end_ms": 885960,
      "text": "我知道你们够丑恶"
    },
    {
      "ordinal": 333,
      "start_ms": 885960,
      "end_ms": 887040,
      "text": "够够下落"
    },
    {
      "ordinal": 334,
      "start_ms": 887040,
      "end_ms": 888319,
      "text": "但是不要一直冒出来"
    },
    {
      "ordinal": 335,
      "start_ms": 888319,
      "end_ms": 890199,
      "text": "冒出来的丑恶"
    },
    {
      "ordinal": 336,
      "start_ms": 892860,
      "end_ms": 896219,
      "text": "就是我没有叫那句秋香姐"
    },
    {
      "ordinal": 337,
      "start_ms": 896420,
      "end_ms": 897350,
      "text": "情人节"
    },
    {
      "ordinal": 338,
      "start_ms": 897350,
      "end_ms": 897920,
      "text": "哦不对"
    },
    {
      "ordinal": 339,
      "start_ms": 897920,
      "end_ms": 898340,
      "text": "说错了"
    },
    {
      "ordinal": 340,
      "start_ms": 898340,
      "end_ms": 901020,
      "text": "我没有叫那句美女"
    },
    {
      "ordinal": 341,
      "start_ms": 901060,
      "end_ms": 902440,
      "text": "你不要回头"
    },
    {
      "ordinal": 342,
      "start_ms": 902440,
      "end_ms": 904180,
      "text": "我就叫了一句秋香姐"
    },
    {
      "ordinal": 343,
      "start_ms": 904180,
      "end_ms": 906040,
      "text": "那就秋香自己回头就可以了"
    },
    {
      "ordinal": 344,
      "start_ms": 906240,
      "end_ms": 907080,
      "text": "对不对"
    },
    {
      "ordinal": 345,
      "start_ms": 907080,
      "end_ms": 907980,
      "text": "我叫秋香"
    },
    {
      "ordinal": 346,
      "start_ms": 907980,
      "end_ms": 909360,
      "text": "我没叫你春草回头啊"
    },
    {
      "ordinal": 347,
      "start_ms": 909360,
      "end_ms": 913150,
      "text": "村长你这回头脸上赖麻子他妈丑的一逼的"
    },
    {
      "ordinal": 348,
      "start_ms": 913150,
      "end_ms": 915190,
      "text": "你不要回头做这个对照组"
    },
    {
      "ordinal": 349,
      "start_ms": 915190,
      "end_ms": 916880,
      "text": "我要看丑恶的事物"
    },
    {
      "ordinal": 350,
      "start_ms": 916880,
      "end_ms": 918680,
      "text": "我会看那些现实的"
    },
    {
      "ordinal": 351,
      "start_ms": 918680,
      "end_ms": 921700,
      "text": "对我的行动斗争有意义的丑陋的事物"
    },
    {
      "ordinal": 352,
      "start_ms": 921700,
      "end_ms": 924979,
      "text": "以这种丑陋对我来说其实没有多大现实意义"
    },
    {
      "ordinal": 353,
      "start_ms": 925140,
      "end_ms": 927840,
      "text": "你本来就是个政治小政治投机人物"
    },
    {
      "ordinal": 354,
      "start_ms": 931150,
      "end_ms": 932290,
      "text": "搞点捞一点的吧"
    },
    {
      "ordinal": 355,
      "start_ms": 932290,
      "end_ms": 933490,
      "text": "在那些什么教授圈子"
    },
    {
      "ordinal": 356,
      "start_ms": 933490,
      "end_ms": 935230,
      "text": "什么学者圈子或者激进知识分子"
    },
    {
      "ordinal": 357,
      "start_ms": 935230,
      "end_ms": 938909,
      "text": "全日制里面的一个笔杆子装模作样"
    },
    {
      "ordinal": 358,
      "start_ms": 938909,
      "end_ms": 943140,
      "text": "那个比棍笔杆子老一点"
    },
    {
      "ordinal": 359,
      "start_ms": 943140,
      "end_ms": 945560,
      "text": "你所谓的混圈子里面资历的"
    },
    {
      "ordinal": 360,
      "start_ms": 945900,
      "end_ms": 949530,
      "text": "你对于真正的现实土壤的改善有个毛用啊"
    },
    {
      "ordinal": 361,
      "start_ms": 949530,
      "end_ms": 951360,
      "text": "你那个指导意见几个人看啊"
    },
    {
      "ordinal": 362,
      "start_ms": 951360,
      "end_ms": 952800,
      "text": "你们这什么狗屁激流网"
    },
    {
      "ordinal": 363,
      "start_ms": 952800,
      "end_ms": 954660,
      "text": "几个人看他搞笑"
    },
    {
      "ordinal": 364,
      "start_ms": 954660,
      "end_ms": 959130,
      "text": "我靠我受不了了好吧"
    },
    {
      "ordinal": 365,
      "start_ms": 959130,
      "end_ms": 960479,
      "text": "那就讲到这边"
    },
    {
      "ordinal": 366,
      "start_ms": 960980,
      "end_ms": 962780,
      "text": "我没有叫春草"
    },
    {
      "ordinal": 367,
      "start_ms": 962780,
      "end_ms": 964400,
      "text": "我是叫秋香姐"
    },
    {
      "ordinal": 368,
      "start_ms": 964400,
      "end_ms": 966380,
      "text": "我真的是我没有叫美女"
    },
    {
      "ordinal": 369,
      "start_ms": 966380,
      "end_ms": 967220,
      "text": "你不要回头"
    },
    {
      "ordinal": 370,
      "start_ms": 967220,
      "end_ms": 968360,
      "text": "我以为就受不了了"
    },
    {
      "ordinal": 371,
      "start_ms": 968360,
      "end_ms": 969760,
      "text": "没有人想搭理你"
    },
    {
      "ordinal": 372,
      "start_ms": 969900,
      "end_ms": 973530,
      "text": "没有人想答应这个六六的一个康德主义"
    },
    {
      "ordinal": 373,
      "start_ms": 976380,
      "end_ms": 978079,
      "text": "那个枪康德主义僵尸"
    },
    {
      "ordinal": 374,
      "start_ms": 978320,
      "end_ms": 980120,
      "text": "不知道你老师是谁啊"
    },
    {
      "ordinal": 375,
      "start_ms": 980120,
      "end_ms": 981500,
      "text": "那个三流辩论法"
    },
    {
      "ordinal": 376,
      "start_ms": 981500,
      "end_ms": 984140,
      "text": "六流哲学太糟糕了"
    },
    {
      "ordinal": 377,
      "start_ms": 987520,
      "end_ms": 990960,
      "text": "你咋不想学学南大就看了看阿多诺啊"
    },
    {
      "ordinal": 378,
      "start_ms": 990960,
      "end_ms": 991620,
      "text": "我是99"
    },
    {
      "ordinal": 379,
      "start_ms": 991620,
      "end_ms": 994560,
      "text": "阿多诺那个虽然那个狗屁的房我也我也受不了"
    },
    {
      "ordinal": 380,
      "start_ms": 994560,
      "end_ms": 996960,
      "text": "但是至少人家头脑比你灵光"
    },
    {
      "ordinal": 381,
      "start_ms": 996960,
      "end_ms": 998220,
      "text": "你去看看阿多诺"
    },
    {
      "ordinal": 382,
      "start_ms": 998220,
      "end_ms": 999240,
      "text": "我先我先收拾下"
    },
    {
      "ordinal": 383,
      "start_ms": 999240,
      "end_ms": 999720,
      "text": "跑地面上吧"
    },
    {
      "ordinal": 384,
      "start_ms": 999720,
      "end_ms": 1000440,
      "text": "先去看看我"
    },
    {
      "ordinal": 385,
      "start_ms": 1000440,
      "end_ms": 1001100,
      "text": "我走不了"
    },
    {
      "ordinal": 386,
      "start_ms": 1001100,
      "end_ms": 1002780,
      "text": "你这个盘子蠢的我都呕了"
    },
    {
      "ordinal": 387,
      "start_ms": 1002780,
      "end_ms": 1003920,
      "text": "我靠我是乔治"
