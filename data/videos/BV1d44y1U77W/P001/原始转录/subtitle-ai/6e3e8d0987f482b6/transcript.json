{
  "bvid": "BV1d44y1U77W",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "6e3e8d0987f482b6336a39d37496899ab22a379ae917a740140b39e1ad31535a",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 440,
      "end_ms": 3680,
      "text": "我我觉得就是说激烈网最近在污蔑"
    },
    {
      "ordinal": 1,
      "start_ms": 3680,
      "end_ms": 7800,
      "text": "我那篇文章里面说我是改良的方法"
    },
    {
      "ordinal": 2,
      "start_ms": 9360,
      "end_ms": 10780,
      "text": "当成是激进"
    },
    {
      "ordinal": 3,
      "start_ms": 12720,
      "end_ms": 14660,
      "text": "我我我要笑死了"
    },
    {
      "ordinal": 4,
      "start_ms": 14660,
      "end_ms": 16010,
      "text": "我真的是笑死了"
    },
    {
      "ordinal": 5,
      "start_ms": 16010,
      "end_ms": 23500,
      "text": "在他那个最挫的笔杆子写的是什么什么"
    },
    {
      "ordinal": 6,
      "start_ms": 27340,
      "end_ms": 29070,
      "text": "哦他在这说什么"
    },
    {
      "ordinal": 7,
      "start_ms": 29070,
      "end_ms": 30700,
      "text": "这个鸟人说什么"
    },
    {
      "ordinal": 8,
      "start_ms": 51460,
      "end_ms": 52380,
      "text": "等会啊"
    },
    {
      "ordinal": 9,
      "start_ms": 52380,
      "end_ms": 53480,
      "text": "别着急啊"
    },
    {
      "ordinal": 10,
      "start_ms": 53740,
      "end_ms": 57010,
      "text": "把改良的方法当成了目的啊"
    },
    {
      "ordinal": 11,
      "start_ms": 58780,
      "end_ms": 61000,
      "text": "把改良的方法当成了目的"
    },
    {
      "ordinal": 12,
      "start_ms": 72980,
      "end_ms": 74830,
      "text": "我我我笑掉大牙了"
    },
    {
      "ordinal": 13,
      "start_ms": 74830,
      "end_ms": 76720,
      "text": "这个话任何人都有资格说"
    },
    {
      "ordinal": 14,
      "start_ms": 76720,
      "end_ms": 80800,
      "text": "我记得我没有资格说改良的方法当成了目的"
    },
    {
      "ordinal": 15,
      "start_ms": 83240,
      "end_ms": 85160,
      "text": "你让那些什么通讯"
    },
    {
      "ordinal": 16,
      "start_ms": 85160,
      "end_ms": 89360,
      "text": "你的那些什么来搞什么名单目录全报备的"
    },
    {
      "ordinal": 17,
      "start_ms": 89360,
      "end_ms": 92440,
      "text": "你说我把改良的方法当成了目的"
    },
    {
      "ordinal": 18,
      "start_ms": 92580,
      "end_ms": 95480,
      "text": "我觉得你把方法的改良当成了目的"
    },
    {
      "ordinal": 19,
      "start_ms": 95780,
      "end_ms": 97220,
      "text": "我觉得你们这些人"
    },
    {
      "ordinal": 20,
      "start_ms": 97220,
      "end_ms": 98840,
      "text": "不是把改良的方法当成了目的"
    },
    {
      "ordinal": 21,
      "start_ms": 98840,
      "end_ms": 101030,
      "text": "你们是把方法的改良当成目的啊"
    },
    {
      "ordinal": 22,
      "start_ms": 101030,
      "end_ms": 103899,
      "text": "你们是把一个又一个的方法改良"
    },
    {
      "ordinal": 23,
      "start_ms": 104040,
      "end_ms": 106440,
      "text": "改良好了之后哦"
    },
    {
      "ordinal": 24,
      "start_ms": 106440,
      "end_ms": 107340,
      "text": "你是无害的"
    },
    {
      "ordinal": 25,
      "start_ms": 107340,
      "end_ms": 108619,
      "text": "好乖宝宝"
    },
    {
      "ordinal": 26,
      "start_ms": 109620,
      "end_ms": 110720,
      "text": "我靠等等"
    },
    {
      "ordinal": 27,
      "start_ms": 110720,
      "end_ms": 113840,
      "text": "轮到就激流网也好意思说我是改良"
    },
    {
      "ordinal": 28,
      "start_ms": 113840,
      "end_ms": 116540,
      "text": "我说所有人都有资格说我是改良激流王"
    },
    {
      "ordinal": 29,
      "start_ms": 116540,
      "end_ms": 119350,
      "text": "你好意思说我是改良激流网"
    },
    {
      "ordinal": 30,
      "start_ms": 119350,
      "end_ms": 120100,
      "text": "激流网"
    },
    {
      "ordinal": 31,
      "start_ms": 120100,
      "end_ms": 121780,
      "text": "你你好意思说我是改"
    },
    {
      "ordinal": 32,
      "start_ms": 121780,
      "end_ms": 125500,
      "text": "好好意思说我是改良哇"
    },
    {
      "ordinal": 33,
      "start_ms": 125500,
      "end_ms": 126780,
      "text": "我要笑死了"
    },
    {
      "ordinal": 34,
      "start_ms": 130459,
      "end_ms": 132099,
      "text": "我真的是笑尿了"
    },
    {
      "ordinal": 35,
      "start_ms": 132099,
      "end_ms": 134679,
      "text": "我靠你们记得往这里面再编辑"
    },
    {
      "ordinal": 36,
      "start_ms": 134679,
      "end_ms": 136809,
      "text": "你主创人员或者说负责人"
    },
    {
      "ordinal": 37,
      "start_ms": 136809,
      "end_ms": 138980,
      "text": "哪一个不是向上透明的"
    },
    {
      "ordinal": 38,
      "start_ms": 140279,
      "end_ms": 141919,
      "text": "哪一个不是身家性命"
    },
    {
      "ordinal": 39,
      "start_ms": 141919,
      "end_ms": 143059,
      "text": "全是哎哟"
    },
    {
      "ordinal": 40,
      "start_ms": 143059,
      "end_ms": 144800,
      "text": "知道的一清二楚的"
    },
    {
      "ordinal": 41,
      "start_ms": 147379,
      "end_ms": 149649,
      "text": "在搞笑你们你在搞笑"
    },
    {
      "ordinal": 42,
      "start_ms": 149649,
      "end_ms": 150980,
      "text": "另外有ktv"
    },
    {
      "ordinal": 43,
      "start_ms": 153140,
      "end_ms": 154360,
      "text": "说我是改良"
    },
    {
      "ordinal": 44,
      "start_ms": 155380,
      "end_ms": 156880,
      "text": "那你的斗争是什么"
    },
    {
      "ordinal": 45,
      "start_ms": 157520,
      "end_ms": 159130,
      "text": "我实事求是讲"
    },
    {
      "ordinal": 46,
      "start_ms": 159130,
      "end_ms": 160300,
      "text": "我是九九"
    },
    {
      "ordinal": 47,
      "start_ms": 160300,
      "end_ms": 164380,
      "text": "你们这种自己为占了一个什么绝对真理"
    },
    {
      "ordinal": 48,
      "start_ms": 164380,
      "end_ms": 165800,
      "text": "绝对真理"
    },
    {
      "ordinal": 49,
      "start_ms": 165800,
      "end_ms": 167300,
      "text": "然后事情到了"
    },
    {
      "ordinal": 50,
      "start_ms": 167300,
      "end_ms": 168500,
      "text": "说什么气候到了"
    },
    {
      "ordinal": 51,
      "start_ms": 168500,
      "end_ms": 169100,
      "text": "事情到了"
    },
    {
      "ordinal": 52,
      "start_ms": 169100,
      "end_ms": 170780,
      "text": "然后你拿这个绝对等你下去"
    },
    {
      "ordinal": 53,
      "start_ms": 170780,
      "end_ms": 172149,
      "text": "就要一呼百应"
    },
    {
      "ordinal": 54,
      "start_ms": 172149,
      "end_ms": 175280,
      "text": "一呼百应诶"
    },
    {
      "ordinal": 55,
      "start_ms": 175280,
      "end_ms": 176900,
      "text": "你叫理理论"
    },
    {
      "ordinal": 56,
      "start_ms": 176900,
      "end_ms": 178460,
      "text": "你这个学院性的"
    },
    {
      "ordinal": 57,
      "start_ms": 195690,
      "end_ms": 197670,
      "text": "你们这种货色就是投机犯"
    },
    {
      "ordinal": 58,
      "start_ms": 197670,
      "end_ms": 198810,
      "text": "只求着讲"
    },
    {
      "ordinal": 59,
      "start_ms": 198810,
      "end_ms": 200620,
      "text": "你说我是改良"
    },
    {
      "ordinal": 60,
      "start_ms": 202420,
      "end_ms": 204000,
      "text": "我实事求是讲"
    },
    {
      "ordinal": 61,
      "start_ms": 209680,
      "end_ms": 211040,
      "text": "这是我自己做的"
    },
    {
      "ordinal": 62,
      "start_ms": 211339,
      "end_ms": 213559,
      "text": "我从来没有说呼吁过"
    },
    {
      "ordinal": 63,
      "start_ms": 213559,
      "end_ms": 216840,
      "text": "哪个街道办给我办个什么证照"
    },
    {
      "ordinal": 64,
      "start_ms": 216899,
      "end_ms": 220510,
      "text": "哪个主管单位给我免费租个房子"
    },
    {
      "ordinal": 65,
      "start_ms": 220510,
      "end_ms": 221980,
      "text": "拿个什么"
    },
    {
      "ordinal": 66,
      "start_ms": 225730,
      "end_ms": 227110,
      "text": "从来没有过吧"
    },
    {
      "ordinal": 67,
      "start_ms": 227110,
      "end_ms": 227900,
      "text": "小朋友"
    },
    {
      "ordinal": 68,
      "start_ms": 230420,
      "end_ms": 234180,
      "text": "我也从来没有说过叫啊"
    },
    {
      "ordinal": 69,
      "start_ms": 236320,
      "end_ms": 239140,
      "text": "如果说遭到严重危害的情况下"
    },
    {
      "ordinal": 70,
      "start_ms": 239540,
      "end_ms": 241420,
      "text": "个体要放弃"
    },
    {
      "ordinal": 71,
      "start_ms": 243839,
      "end_ms": 245539,
      "text": "极端的斗争方式"
    },
    {
      "ordinal": 72,
      "start_ms": 248880,
      "end_ms": 253020,
      "text": "那我们肯定是要我们怎么当年说的口号"
    },
    {
      "ordinal": 73,
      "start_ms": 253020,
      "end_ms": 254520,
      "text": "武力保障保卫苏联"
    },
    {
      "ordinal": 74,
      "start_ms": 258380,
      "end_ms": 260480,
      "text": "我们是要拼命的去守卫"
    },
    {
      "ordinal": 75,
      "start_ms": 260480,
      "end_ms": 261440,
      "text": "拼命啊"
    },
    {
      "ordinal": 76,
      "start_ms": 261440,
      "end_ms": 262880,
      "text": "头可以死啊"
    },
    {
      "ordinal": 77,
      "start_ms": 269040,
      "end_ms": 272980,
      "text": "最根本制度的劳动群众的主人翁地位的"
    },
    {
      "ordinal": 78,
      "start_ms": 272980,
      "end_ms": 274000,
      "text": "要拼命去守卫"
    },
    {
      "ordinal": 79,
      "start_ms": 274000,
      "end_ms": 274660,
      "text": "去保卫着你"
    },
    {
      "ordinal": 80,
      "start_ms": 274660,
      "end_ms": 276650,
      "text": "把我叫改良我"
    },
    {
      "ordinal": 81,
      "start_ms": 276650,
      "end_ms": 279920,
      "text": "我说你们这家伙躲在后面"
    },
    {
      "ordinal": 82,
      "start_ms": 279920,
      "end_ms": 282830,
      "text": "躲在学院派的遮罩后面"
    },
    {
      "ordinal": 83,
      "start_ms": 282830,
      "end_ms": 285620,
      "text": "躲在你那些狗屁的笔名后面"
    },
    {
      "ordinal": 84,
      "start_ms": 286440,
      "end_ms": 287840,
      "text": "你是向上透明的"
    },
    {
      "ordinal": 85,
      "start_ms": 287840,
      "end_ms": 289820,
      "text": "不要以为别人不知道你是谁啊"
    },
    {
      "ordinal": 86,
      "start_ms": 291380,
      "end_ms": 292660,
      "text": "我们不知道你是谁"
    },
    {
      "ordinal": 87,
      "start_ms": 294400,
      "end_ms": 295940,
      "text": "公众不知道你是谁"
    },
    {
      "ordinal": 88,
      "start_ms": 297540,
      "end_ms": 298430,
      "text": "明白吗"
    },
    {
      "ordinal": 89,
      "start_ms": 298430,
      "end_ms": 300440,
      "text": "你你说到时候说什么"
    },
    {
      "ordinal": 90,
      "start_ms": 300440,
      "end_ms": 301760,
      "text": "那那边有一个乱子"
    },
    {
      "ordinal": 91,
      "start_ms": 301760,
      "end_ms": 302900,
      "text": "那边出了一个威胁"
    },
    {
      "ordinal": 92,
      "start_ms": 302900,
      "end_ms": 303800,
      "text": "派下去"
    },
    {
      "ordinal": 93,
      "start_ms": 305600,
      "end_ms": 307020,
      "text": "天兵天将一样"
    },
    {
      "ordinal": 94,
      "start_ms": 308300,
      "end_ms": 309940,
      "text": "说我是改良主义"
    },
    {
      "ordinal": 95,
      "start_ms": 309940,
      "end_ms": 311280,
      "text": "你这种叫什么"
    },
    {
      "ordinal": 96,
      "start_ms": 311479,
      "end_ms": 316300,
      "text": "你说你们就叫做标准的说知识精英"
    },
    {
      "ordinal": 97,
      "start_ms": 318550,
      "end_ms": 320770,
      "text": "你们这种人货色就是认为我是智精英"
    },
    {
      "ordinal": 98,
      "start_ms": 320770,
      "end_ms": 322770,
      "text": "我就是政政治权力的预备"
    },
    {
      "ordinal": 99,
      "start_ms": 322770,
      "end_ms": 326430,
      "text": "政治权利的一个预备继承者啊"
    },
    {
      "ordinal": 100,
      "start_ms": 326430,
      "end_ms": 330580,
      "text": "预备继承者就认为政治权利"
    },
    {
      "ordinal": 101,
      "start_ms": 330580,
      "end_ms": 332320,
      "text": "他有他的一个谱系在里面"
    },
    {
      "ordinal": 102,
      "start_ms": 332320,
      "end_ms": 333220,
      "text": "哒哒哒哒哒哒哒"
    },
    {
      "ordinal": 103,
      "start_ms": 333220,
      "end_ms": 335780,
      "text": "有个谱系现在运行在这个谱系上"
    },
    {
      "ordinal": 104,
      "start_ms": 335780,
      "end_ms": 337160,
      "text": "如果现实条件成熟了"
    },
    {
      "ordinal": 105,
      "start_ms": 337160,
      "end_ms": 338120,
      "text": "它会转移啊"
    },
    {
      "ordinal": 106,
      "start_ms": 338120,
      "end_ms": 339900,
      "text": "往左往右转移到这个谱系上"
    },
    {
      "ordinal": 107,
      "start_ms": 339900,
      "end_ms": 341520,
      "text": "转移到这个普及上"
    },
    {
      "ordinal": 108,
      "start_ms": 342039,
      "end_ms": 345519,
      "text": "那你们这些人就能下去做政治权利的预备队"
    },
    {
      "ordinal": 109,
      "start_ms": 345519,
      "end_ms": 346089,
      "text": "继承者"
    },
    {
      "ordinal": 110,
      "start_ms": 346089,
      "end_ms": 347499,
      "text": "加剧巴的啊"
    },
    {
      "ordinal": 111,
      "start_ms": 347499,
      "end_ms": 348660,
      "text": "一呼百应"
    },
    {
      "ordinal": 112,
      "start_ms": 348880,
      "end_ms": 351400,
      "text": "一个人管1000个5000个"
    },
    {
      "ordinal": 113,
      "start_ms": 351400,
      "end_ms": 355840,
      "text": "然后一群江湖豪杰聚到一起去呼啸而起啊"
    },
    {
      "ordinal": 114,
      "start_ms": 355840,
      "end_ms": 357700,
      "text": "你们这些学术知识精英"
    },
    {
      "ordinal": 115,
      "start_ms": 357700,
      "end_ms": 359140,
      "text": "有各种背书的"
    },
    {
      "ordinal": 116,
      "start_ms": 359140,
      "end_ms": 362020,
      "text": "你就可以把做大哥坐那边拿个什么头条"
    },
    {
      "ordinal": 117,
      "start_ms": 362020,
      "end_ms": 364620,
      "text": "那边做一个什么大哥大侠"
    },
    {
      "ordinal": 118,
      "start_ms": 366800,
      "end_ms": 368540,
      "text": "你们这货色他妈搞笑"
    },
    {
      "ordinal": 119,
      "start_ms": 368540,
      "end_ms": 371450,
      "text": "我靠我这实事求是讲"
    },
    {
      "ordinal": 120,
      "start_ms": 371450,
      "end_ms": 373580,
      "text": "贪这么个激流网的名头哦"
    },
    {
      "ordinal": 121,
      "start_ms": 373580,
      "end_ms": 377080,
      "text": "金圈左翼第一网谈这么个哦"
    },
    {
      "ordinal": 122,
      "start_ms": 377080,
      "end_ms": 378580,
      "text": "这个话说出来可能很多"
    },
    {
      "ordinal": 123,
      "start_ms": 380860,
      "end_ms": 382790,
      "text": "还有什么那些什么啊"
    },
    {
      "ordinal": 124,
      "start_ms": 385370,
      "end_ms": 387650,
      "text": "说你这说你是金圈左翼第一王的人"
    },
    {
      "ordinal": 125,
      "start_ms": 388490,
      "end_ms": 389450,
      "text": "我是秋子强"
    },
    {
      "ordinal": 126,
      "start_ms": 389450,
      "end_ms": 391260,
      "text": "啊"
    },
    {
      "ordinal": 127,
      "start_ms": 391260,
      "end_ms": 395090,
      "text": "你们自己先把你们这个盘子里面的几个青豆"
    },
    {
      "ordinal": 128,
      "start_ms": 395090,
      "end_ms": 397820,
      "text": "三个这个萝卜干他妈分分清楚吧"
    },
    {
      "ordinal": 129,
      "start_ms": 397820,
      "end_ms": 399080,
      "text": "到底谁占几个萝卜干"
    },
    {
      "ordinal": 130,
      "start_ms": 399080,
      "end_ms": 400160,
      "text": "谁占几个青豆吧"
    },
    {
      "ordinal": 131,
      "start_ms": 400160,
      "end_ms": 401320,
      "text": "我实事求是讲"
    },
    {
      "ordinal": 132,
      "start_ms": 402840,
      "end_ms": 405680,
      "text": "真是搞笑还是我是改的"
    },
    {
      "ordinal": 133,
      "start_ms": 406600,
      "end_ms": 408000,
      "text": "我是改良"
    },
    {
