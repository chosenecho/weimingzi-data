    {
      "ordinal": 138,
      "start_ms": 418020,
      "end_ms": 419960,
      "text": "他做的什么玩意儿嘛"
    },
    {
      "ordinal": 139,
      "start_ms": 420780,
      "end_ms": 423380,
      "text": "跑过去就是叫人家给你送死卖命"
