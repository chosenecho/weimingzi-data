    {
      "ordinal": 139,
      "start_ms": 417380,
      "end_ms": 418240,
      "text": "卖给他们"
    },
    {
      "ordinal": 140,
      "start_ms": 418240,
      "end_ms": 420880,
      "text": "如果你是跟富哥借钱的"
    },
    {
      "ordinal": 141,
      "start_ms": 420880,
      "end_ms": 422400,
      "text": "不能有一个什么"
    },
    {
      "ordinal": 142,
      "start_ms": 422400,
      "end_ms": 423920,
      "text": "你得有借有还"
    },
    {
      "ordinal": 143,
      "start_ms": 423920,
      "end_ms": 425900,
      "text": "一定得有借有还"
    },
    {
      "ordinal": 144,
      "start_ms": 426020,
      "end_ms": 428360,
      "text": "哪怕你是跟富哥借钱"
    },
    {
      "ordinal": 145,
      "start_ms": 428360,
      "end_ms": 429740,
      "text": "必然是有借有还的"
    },
    {
      "ordinal": 146,
      "start_ms": 429740,
      "end_ms": 431040,
      "text": "不还是耻辱的"
    },
    {
      "ordinal": 147,
      "start_ms": 431040,
