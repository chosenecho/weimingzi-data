    {
      "ordinal": 137,
      "start_ms": 412380,
      "end_ms": 415220,
      "text": "这个东西是什么天经地义的"
    },
    {
      "ordinal": 138,
      "start_ms": 415220,
      "end_ms": 417380,
      "text": "你东西得是明码标价的"
