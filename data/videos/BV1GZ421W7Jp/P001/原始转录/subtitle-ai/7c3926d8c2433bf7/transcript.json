      "ordinal": 187,
      "start_ms": 567120,
      "end_ms": 568400,
      "text": "腐朽堕落"
    },
    {
      "ordinal": 188,
      "start_ms": 570600,
      "end_ms": 573480,
      "text": "的资产阶级"
    },
    {
      "ordinal": 189,
      "start_ms": 575680,
      "end_ms": 579680,
      "text": "啊除了腐朽多的资产阶级作为阶级整体啊"
