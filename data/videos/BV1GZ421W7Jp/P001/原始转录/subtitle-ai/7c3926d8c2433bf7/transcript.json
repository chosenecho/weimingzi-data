      "text": "能做到啊"
    },
    {
      "ordinal": 242,
      "start_ms": 731980,
      "end_ms": 733280,
      "text": "能做到"
    },
    {
      "ordinal": 243,
      "start_ms": 733280,
      "end_ms": 734480,
      "text": "不要大喇叭"
    },
    {
      "ordinal": 244,
      "start_ms": 734480,
      "end_ms": 736100,
      "text": "不要大喇叭啊"
