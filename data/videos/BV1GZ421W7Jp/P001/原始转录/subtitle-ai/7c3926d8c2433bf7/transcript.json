    {
      "ordinal": 155,
      "start_ms": 450230,
      "end_ms": 453150,
      "text": "还有一个借钱的一个事情嗯"
    },
    {
      "ordinal": 156,
      "start_ms": 453150,
      "end_ms": 455090,
      "text": "发现有这样的瑕疵污点的人"
    },
    {
      "ordinal": 157,
      "start_ms": 455090,
      "end_ms": 456050,
      "text": "统统踢掉啊"
    },
    {
      "ordinal": 158,
      "start_ms": 456050,
      "end_ms": 456910,
      "text": "通通踢掉"
    },
    {
      "ordinal": 159,
      "start_ms": 456910,
      "end_ms": 457940,
      "text": "第一点"
    },
    {
      "ordinal": 160,
      "start_ms": 457940,
      "end_ms": 460180,
      "text": "那是严谨啊"
    },
    {
      "ordinal": 161,
      "start_ms": 460180,
      "end_ms": 465740,
      "text": "第一点是严禁严厉禁绝挥刀向更弱者去报复"
