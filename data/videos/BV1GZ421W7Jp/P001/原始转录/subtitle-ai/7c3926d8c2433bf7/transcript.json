  "segments": [
    {
      "ordinal": 0,
      "start_ms": 40,
      "end_ms": 1460,
      "text": "我们今天就讲了"
    },
    {
      "ordinal": 1,
      "start_ms": 1460,
      "end_ms": 5360,
      "text": "在困顿之下"
    },
    {
      "ordinal": 2,
      "start_ms": 7000,
      "end_ms": 11430,
      "text": "嗯之下困苦困顿之下呃"
    },
    {
      "ordinal": 3,
      "start_ms": 11430,
      "end_ms": 12990,
      "text": "我们的支持者"
    },
    {
      "ordinal": 4,
      "start_ms": 12990,
      "end_ms": 16350,
      "text": "理念的认同者要坚守的一些底线啊"
    },
    {
      "ordinal": 5,
      "start_ms": 16350,
      "end_ms": 20195,
      "text": "是不可"
    },
    {
      "ordinal": 6,
      "start_ms": 22300,
      "end_ms": 26260,
      "text": "残害弱者"
    },
    {
      "ordinal": 7,
      "start_ms": 28480,
      "end_ms": 32100,
      "text": "啊绝不可残害弱者"
    },
    {
      "ordinal": 8,
      "start_ms": 32100,
      "end_ms": 36900,
      "text": "这个孩童儿童"
    },
    {
      "ordinal": 9,
      "start_ms": 38200,
      "end_ms": 39720,
      "text": "妇女"
    },
    {
      "ordinal": 10,
      "start_ms": 41480,
      "end_ms": 42600,
      "text": "然后这个"
    },
    {
      "ordinal": 11,
      "start_ms": 44680,
      "end_ms": 46320,
      "text": "老人"
    },
    {
      "ordinal": 12,
      "start_ms": 47920,
      "end_ms": 53140,
      "text": "还有这个残疾人老弱病残了啊"
    },
    {
      "ordinal": 13,
      "start_ms": 53140,
      "end_ms": 54720,
      "text": "那么"
    },
    {
      "ordinal": 14,
      "start_ms": 56360,
      "end_ms": 60100,
      "text": "啊不能把你的不允许"
    },
    {
      "ordinal": 15,
      "start_ms": 60100,
      "end_ms": 64929,
      "text": "不能用你的仇恨愤怒啊"
    },
    {
      "ordinal": 16,
      "start_ms": 64929,
      "end_ms": 66709,
      "text": "挥刀向更弱者"
    },
    {
      "ordinal": 17,
      "start_ms": 66709,
      "end_ms": 69049,
      "text": "这绝不允许啊"
    },
    {
      "ordinal": 18,
      "start_ms": 70249,
      "end_ms": 71800,
      "text": "然后"
    },
    {
      "ordinal": 19,
      "start_ms": 73740,
      "end_ms": 77860,
      "text": "调点四"
    },
    {
      "ordinal": 20,
      "start_ms": 81700,
      "end_ms": 84180,
      "text": "不能够欠钱不还啊"
    },
    {
      "ordinal": 21,
      "start_ms": 84180,
      "end_ms": 87460,
      "text": "就不能够就是透支"
    },
    {
      "ordinal": 22,
      "start_ms": 88640,
      "end_ms": 90000,
      "text": "透支信用"
    },
    {
      "ordinal": 23,
      "start_ms": 92520,
      "end_ms": 94400,
      "text": "榨取金钱"
    },
    {
      "ordinal": 24,
      "start_ms": 97500,
      "end_ms": 101360,
      "text": "也就是说啊有负债一定要还掉"
    },
    {
      "ordinal": 25,
      "start_ms": 101360,
      "end_ms": 105940,
      "text": "就是有负债啊"
    },
    {
      "ordinal": 26,
      "start_ms": 107780,
      "end_ms": 108740,
      "text": "要努力还"
    },
    {
      "ordinal": 27,
      "start_ms": 111260,
      "end_ms": 114300,
      "text": "要努力这还钱啊"
    },
    {
      "ordinal": 28,
      "start_ms": 114940,
      "end_ms": 119540,
      "text": "呃还有一点就是最好就是别借钱啊"
    },
    {
      "ordinal": 29,
      "start_ms": 119540,
      "end_ms": 120840,
      "text": "最好就是别借钱"
    },
    {
      "ordinal": 30,
      "start_ms": 120840,
      "end_ms": 126730,
      "text": "不能因为你自己是身无所托"
    },
    {
      "ordinal": 31,
      "start_ms": 127500,
      "end_ms": 130660,
      "text": "就是你是个无无无所聊赖的啊"
    },
    {
      "ordinal": 32,
      "start_ms": 130660,
      "end_ms": 134260,
      "text": "无所聊赖的这个无赖不是骂人的"
    },
    {
      "ordinal": 33,
      "start_ms": 134260,
      "end_ms": 135500,
      "text": "是无所聊赖"
    },
    {
      "ordinal": 34,
      "start_ms": 135500,
      "end_ms": 136740,
      "text": "就是一人吃饱"
    },
    {
      "ordinal": 35,
      "start_ms": 136740,
      "end_ms": 138100,
      "text": "全家不愁那种状况"
    },
    {
      "ordinal": 36,
      "start_ms": 139180,
      "end_ms": 141080,
      "text": "嗯就是说比较困顿吧"
    },
    {
      "ordinal": 37,
      "start_ms": 141080,
      "end_ms": 143260,
      "text": "我讲的比较困顿"
    },
    {
      "ordinal": 38,
      "start_ms": 144510,
      "end_ms": 146270,
      "text": "尤其在这种情况下"
    },
    {
      "ordinal": 39,
      "start_ms": 146270,
      "end_ms": 150240,
      "text": "不能够榨取金钱啊"
    },
    {
      "ordinal": 40,
      "start_ms": 150240,
      "end_ms": 152600,
      "text": "骗取大不允许骗钱了"
    },
    {
      "ordinal": 41,
      "start_ms": 152600,
      "end_ms": 153180,
      "text": "简单来讲"
    },
    {
      "ordinal": 42,
      "start_ms": 153180,
      "end_ms": 155730,
      "text": "不允许骗取大量金钱"
    },
    {
      "ordinal": 43,
      "start_ms": 156170,
      "end_ms": 158170,
      "text": "骗取金钱"
    },
    {
      "ordinal": 44,
      "start_ms": 158170,
      "end_ms": 161620,
      "text": "然后如果是相互拆借的"
    },
    {
      "ordinal": 45,
      "start_ms": 161620,
      "end_ms": 162860,
      "text": "生活确有困难"
    },
    {
      "ordinal": 46,
      "start_ms": 162860,
      "end_ms": 166060,
      "text": "相互拆借的确有困难"
    },
    {
      "ordinal": 47,
      "start_ms": 169720,
      "end_ms": 172200,
      "text": "啊相互拆借"
    },
    {
      "ordinal": 48,
      "start_ms": 175620,
      "end_ms": 177300,
      "text": "这种情况"
    },
    {
      "ordinal": 49,
      "start_ms": 179220,
      "end_ms": 181540,
      "text": "一不进行网络转账"
    },
    {
      "ordinal": 50,
      "start_ms": 182780,
      "end_ms": 184579,
      "text": "不进行啊"
    },
    {
      "ordinal": 51,
      "start_ms": 184579,
      "end_ms": 186239,
      "text": "这个网上的陌生人"
    },
    {
      "ordinal": 52,
      "start_ms": 186239,
      "end_ms": 187959,
      "text": "网上陌生人"
    },
    {
      "ordinal": 53,
      "start_ms": 189159,
      "end_ms": 192760,
      "text": "所以在我评论区里面说你这呃比较辛苦啊"
    },
    {
      "ordinal": 54,
      "start_ms": 192760,
      "end_ms": 193920,
      "text": "要要吃顿饭啊"
    },
    {
      "ordinal": 55,
      "start_ms": 193920,
      "end_ms": 194660,
      "text": "转饭钱"
    },
    {
      "ordinal": 56,
      "start_ms": 194660,
      "end_ms": 196300,
      "text": "如果评论区里面有留这个东西"
    },
    {
      "ordinal": 57,
      "start_ms": 196300,
      "end_ms": 197380,
      "text": "我都会把他拉黑的啊"
    },
    {
      "ordinal": 58,
      "start_ms": 197380,
      "end_ms": 198320,
      "text": "都是骗钱的啊"
    },
    {
      "ordinal": 59,
      "start_ms": 198320,
      "end_ms": 200580,
      "text": "不进行网上的陌生人转账"
    },
    {
      "ordinal": 60,
      "start_ms": 200580,
      "end_ms": 205670,
      "text": "一定是线下具体认识嗯"
    },
    {
      "ordinal": 61,
      "start_ms": 205670,
      "end_ms": 206690,
      "text": "具体认识"
    },
    {
      "ordinal": 62,
      "start_ms": 206690,
      "end_ms": 209470,
      "text": "然后呢线下具体认识的人"
    },
    {
      "ordinal": 63,
      "start_ms": 210510,
      "end_ms": 212920,
      "text": "如果要相互拆借的话"
    },
    {
      "ordinal": 64,
      "start_ms": 213120,
      "end_ms": 215200,
      "text": "没钱可以用劳力"
    },
    {
      "ordinal": 65,
      "start_ms": 215200,
      "end_ms": 218790,
      "text": "就是一定要按期还"
    },
    {
      "ordinal": 66,
      "start_ms": 219390,
      "end_ms": 220470,
      "text": "按期还"
    },
    {
      "ordinal": 67,
      "start_ms": 220470,
      "end_ms": 221230,
      "text": "约定好了"
    },
    {
      "ordinal": 68,
      "start_ms": 221230,
      "end_ms": 221830,
      "text": "按期还"
    },
    {
      "ordinal": 69,
      "start_ms": 223350,
      "end_ms": 224950,
      "text": "约定好了"
    },
    {
      "ordinal": 70,
      "start_ms": 224950,
      "end_ms": 228850,
      "text": "按期还才能拆解"
    },
    {
      "ordinal": 71,
      "start_ms": 228850,
      "end_ms": 231870,
      "text": "然后到期不还用劳力折"
    },
    {
      "ordinal": 72,
      "start_ms": 231870,
      "end_ms": 234250,
      "text": "到期不还就用劳力去折"
    },
    {
      "ordinal": 73,
      "start_ms": 234250,
      "end_ms": 236690,
      "text": "到期不还用劳力折"
    },
    {
      "ordinal": 74,
      "start_ms": 238100,
      "end_ms": 241860,
      "text": "去帮这个人去一帮他做家务"
    },
    {
      "ordinal": 75,
      "start_ms": 241860,
      "end_ms": 243420,
      "text": "帮他做饭"
    },
    {
      "ordinal": 76,
      "start_ms": 243570,
      "end_ms": 246730,
      "text": "甚至说你直接去帮他跑外卖"
    },
    {
      "ordinal": 77,
      "start_ms": 246730,
      "end_ms": 249550,
      "text": "然后赚到钱给他就一定要到期还钱"
    },
    {
      "ordinal": 78,
      "start_ms": 249550,
      "end_ms": 253050,
      "text": "这个是我对我们的这个比较困顿的"
    },
    {
      "ordinal": 79,
      "start_ms": 253050,
      "end_ms": 255150,
      "text": "我们理念的认同者"
    },
    {
      "ordinal": 80,
      "start_ms": 255150,
      "end_ms": 256610,
      "text": "我还能影响到的"
    },
    {
      "ordinal": 81,
      "start_ms": 256610,
      "end_ms": 259890,
      "text": "就是底层无产阶级的一个要求啊"
    },
    {
      "ordinal": 82,
      "start_ms": 259890,
      "end_ms": 260490,
      "text": "啊"
    },
    {
      "ordinal": 83,
      "start_ms": 260490,
      "end_ms": 265070,
      "text": "只和线下具体认识的人进行金钱上的拆借往来"
    },
    {
      "ordinal": 84,
      "start_ms": 265070,
      "end_ms": 267700,
      "text": "但是前提是你确有困难"
    },
    {
      "ordinal": 85,
      "start_ms": 267700,
      "end_ms": 268780,
      "text": "这个是前提"
    },
    {
      "ordinal": 86,
      "start_ms": 268780,
      "end_ms": 270520,
      "text": "在这个你确实有困难"
    },
    {
      "ordinal": 87,
      "start_ms": 270520,
      "end_ms": 272500,
      "text": "这个人生活确实有困难"
    },
    {
      "ordinal": 88,
      "start_ms": 272500,
      "end_ms": 276770,
      "text": "你亲眼看见了你眼睛亲眼看见了"
    },
    {
      "ordinal": 89,
      "start_ms": 276770,
      "end_ms": 280770,
      "text": "你去他住的地方啊"
    },
    {
      "ordinal": 90,
      "start_ms": 280770,
      "end_ms": 283080,
      "text": "你说他爸妈生病了"
    },
    {
      "ordinal": 91,
      "start_ms": 283080,
      "end_ms": 287350,
      "text": "那你听他父母打电话啊"
    },
    {
      "ordinal": 92,
      "start_ms": 287350,
      "end_ms": 288770,
      "text": "听他和他父母打电话"
    },
    {
      "ordinal": 93,
      "start_ms": 288770,
      "end_ms": 291760,
      "text": "听到了爸妈身边确有困难情况下"
    },
    {
      "ordinal": 94,
      "start_ms": 291760,
      "end_ms": 294300,
      "text": "量力量力而为啊"
    },
    {
      "ordinal": 95,
      "start_ms": 294300,
      "end_ms": 297080,
      "text": "量力你是借给借钱给别人"
    },
    {
      "ordinal": 96,
      "start_ms": 297080,
      "end_ms": 298580,
      "text": "你量力去借"
    },
    {
      "ordinal": 97,
      "start_ms": 298580,
      "end_ms": 301520,
      "text": "你是向别人借钱"
    },
    {
      "ordinal": 98,
      "start_ms": 302280,
      "end_ms": 303560,
      "text": "那也要适度"
    },
    {
      "ordinal": 99,
      "start_ms": 303560,
      "end_ms": 305520,
      "text": "不能盯着一个"
    },
    {
      "ordinal": 100,
      "start_ms": 305520,
      "end_ms": 309340,
      "text": "他本身你借钱的对象也没几个钱的"
    },
    {
      "ordinal": 101,
      "start_ms": 309340,
      "end_ms": 310900,
      "text": "你对不对"
    },
    {
      "ordinal": 102,
      "start_ms": 310900,
      "end_ms": 312720,
      "text": "比如说你爸爸这个病重了"
    },
    {
      "ordinal": 103,
      "start_ms": 312720,
      "end_ms": 313760,
      "text": "严重了"
    },
    {
      "ordinal": 104,
      "start_ms": 313760,
      "end_ms": 316109,
      "text": "缺缺钱啊"
    },
    {
      "ordinal": 105,
      "start_ms": 316109,
      "end_ms": 317640,
      "text": "那你要量力"
    },
    {
      "ordinal": 106,
      "start_ms": 317640,
      "end_ms": 320120,
      "text": "你要适度向人家借钱"
    },
    {
      "ordinal": 107,
      "start_ms": 320120,
      "end_ms": 322200,
      "text": "人家一个月可能两三千块钱"
    },
    {
      "ordinal": 108,
      "start_ms": 322200,
      "end_ms": 324520,
      "text": "你借个一两百块钱不错了"
    },
    {
      "ordinal": 109,
      "start_ms": 324520,
      "end_ms": 324880,
      "text": "实事求是"
    },
    {
      "ordinal": 110,
      "start_ms": 324880,
      "end_ms": 327840,
      "text": "这而且你得是线下具体认识的"
    },
    {
      "ordinal": 111,
      "start_ms": 327840,
      "end_ms": 330960,
      "text": "不和陌生人进行拆借"
    },
    {
      "ordinal": 112,
      "start_ms": 330960,
      "end_ms": 333780,
      "text": "不和陌生人进行这个借钱"
    },
    {
      "ordinal": 113,
      "start_ms": 334180,
      "end_ms": 338710,
      "text": "但凡有人这样做的tea"
    },
    {
      "ordinal": 114,
      "start_ms": 339150,
      "end_ms": 340470,
      "text": "但凡有人这样做的"
    },
    {
      "ordinal": 115,
      "start_ms": 340470,
      "end_ms": 343190,
      "text": "踢掉在网上到处借钱的踢到"
    },
    {
      "ordinal": 116,
      "start_ms": 344310,
      "end_ms": 349040,
      "text": "然后那个呃用各种由头什么什么骗取集资"
    },
    {
      "ordinal": 117,
      "start_ms": 349040,
      "end_ms": 353540,
      "text": "诈取金钱的这种人是我们的仇仇人啊"
    },
    {
      "ordinal": 118,
      "start_ms": 353540,
      "end_ms": 353980,
      "text": "敌人啊"
    },
    {
      "ordinal": 119,
      "start_ms": 353980,
      "end_ms": 357020,
      "text": "我们有一个仇人是干这个事的"
    },
    {
      "ordinal": 120,
      "start_ms": 357020,
      "end_ms": 358540,
      "text": "靠女仆店"
    },
    {
      "ordinal": 121,
      "start_ms": 365240,
      "end_ms": 366620,
      "text": "妈呀啊"
    },
    {
      "ordinal": 122,
      "start_ms": 366620,
      "end_ms": 370060,
      "text": "要然后还钱一定要借钱的时候就约定好了"
    },
    {
      "ordinal": 123,
      "start_ms": 370060,
      "end_ms": 372540,
      "text": "还款的期限一定要定期"
    },
    {
      "ordinal": 124,
      "start_ms": 372540,
      "end_ms": 374710,
      "text": "还要以失信为持"
    },
    {
      "ordinal": 125,
      "start_ms": 374710,
      "end_ms": 378360,
      "text": "以失信为耻啊"
    },
    {
      "ordinal": 126,
      "start_ms": 378360,
      "end_ms": 381920,
      "text": "然后失信之人这个只要是钱啊"
    },
    {
      "ordinal": 127,
      "start_ms": 381920,
      "end_ms": 383200,
      "text": "金钱上失信维持啊"
    },
    {
      "ordinal": 128,
      "start_ms": 383200,
      "end_ms": 384000,
      "text": "金钱上"
    },
    {
      "ordinal": 129,
      "start_ms": 384000,
      "end_ms": 386770,
      "text": "然后金钱上失信的人不要和他往来"
    },
    {
      "ordinal": 130,
      "start_ms": 386770,
      "end_ms": 388990,
      "text": "因为他打着这种理想主义旗号"
    },
    {
      "ordinal": 131,
      "start_ms": 389850,
      "end_ms": 393830,
      "text": "这种人是有问题的啊"
    },
    {
      "ordinal": 132,
      "start_ms": 393830,
      "end_ms": 396550,
      "text": "某个目前在卖电脑的"
    },
    {
      "ordinal": 133,
      "start_ms": 398240,
      "end_ms": 400640,
      "text": "啊跟我们一个成员借的钱"
    },
    {
      "ordinal": 134,
      "start_ms": 401640,
      "end_ms": 403320,
      "text": "你准备什么时候还啊"
    },
    {
      "ordinal": 135,
      "start_ms": 403320,
      "end_ms": 405080,
      "text": "你还困难吗"
