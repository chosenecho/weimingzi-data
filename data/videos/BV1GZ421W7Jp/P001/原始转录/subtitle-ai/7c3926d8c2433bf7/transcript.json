    },
    {
      "ordinal": 176,
      "start_ms": 516059,
      "end_ms": 518280,
      "text": "就是嗯"
    },
    {
      "ordinal": 177,
      "start_ms": 521280,
      "end_ms": 524760,
      "text": "禁绝发表"
    },
    {
      "ordinal": 178,
      "start_ms": 530560,
      "end_ms": 531280,
      "text": "特定"
    },
    {
      "ordinal": 179,
      "start_ms": 533360,
      "end_ms": 535600,
      "text": "群体的"
    },
    {
      "ordinal": 180,
      "start_ms": 537980,
      "end_ms": 539820,
      "text": "仇恨言论"
    },
    {
      "ordinal": 181,
      "start_ms": 549560,
      "end_ms": 550740,
      "text": "有个例外啊"
    },
    {
      "ordinal": 182,
      "start_ms": 550740,
      "end_ms": 551780,
      "text": "有个例外"
    },
    {
      "ordinal": 183,
      "start_ms": 551780,
      "end_ms": 552600,
      "text": "有个例外"
    },
    {
      "ordinal": 184,
      "start_ms": 552600,
      "end_ms": 554400,
      "text": "就腐朽堕落的资产阶级"
