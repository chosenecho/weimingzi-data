  "content_sha256": "8e10eaaea420d8456f1484ecd49bed7bd440ea6139d4c2e3a8f1a6e37f95160f",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 0,
      "end_ms": 1860,
      "text": "我今天来回应信件"
    },
    {
      "ordinal": 1,
      "start_ms": 2360,
      "end_ms": 4720,
      "text": "他说可以公开啊"
    },
    {
      "ordinal": 2,
      "start_ms": 4720,
      "end_ms": 6640,
      "text": "他叫邓家潮"
    },
    {
      "ordinal": 3,
      "start_ms": 6880,
      "end_ms": 7600,
      "text": "你好"
    },
    {
      "ordinal": 4,
      "start_ms": 10060,
      "end_ms": 10240,
      "text": "性"
    },
    {
      "ordinal": 5,
      "start_ms": 10240,
      "end_ms": 13620,
      "text": "之前在在读某中流985大学"
    },
    {
      "ordinal": 6,
      "start_ms": 15420,
      "end_ms": 18490,
      "text": "和学校的规训化活动而休学了"
    },
    {
      "ordinal": 7,
      "start_ms": 18490,
      "end_ms": 21040,
      "text": "因为我的父母沉迷于资本增值的活动"
    },
    {
      "ordinal": 8,
      "start_ms": 21040,
      "end_ms": 22980,
      "text": "我一直只为管饱"
    },
    {
      "ordinal": 9,
      "start_ms": 22980,
      "end_ms": 23640,
      "text": "除此以外"
    },
    {
      "ordinal": 10,
      "start_ms": 23640,
      "end_ms": 24930,
      "text": "我除了沉迷网络之外"
    },
    {
      "ordinal": 11,
      "start_ms": 24930,
      "end_ms": 26340,
      "text": "没有参与过任何社会实践"
    },
    {
      "ordinal": 12,
      "start_ms": 26340,
      "end_ms": 27760,
      "text": "对此深感惭愧"
    },
    {
      "ordinal": 13,
      "start_ms": 28000,
      "end_ms": 29260,
      "text": "不过从今天开始"
    },
    {
      "ordinal": 14,
      "start_ms": 29260,
      "end_ms": 31780,
      "text": "我决定为人类解放事业贡献自己的一份力"
    },
    {
      "ordinal": 15,
      "start_ms": 31780,
      "end_ms": 33820,
      "text": "但我却不知道走上这条路以后"
    },
    {
      "ordinal": 16,
      "start_ms": 33820,
      "end_ms": 35500,
      "text": "我究竟应该具体做什么"
    },
    {
      "ordinal": 17,
      "start_ms": 35500,
      "end_ms": 37019,
      "text": "我基本没有什么欲望"
    },
    {
      "ordinal": 18,
      "start_ms": 37019,
      "end_ms": 38279,
      "text": "可以过很亲民的生活"
    },
    {
      "ordinal": 19,
      "start_ms": 38279,
      "end_ms": 39419,
      "text": "我和家里人讨论过"
    },
    {
      "ordinal": 20,
      "start_ms": 39419,
      "end_ms": 41759,
      "text": "家里可以为我提供一片场地"
    },
    {
      "ordinal": 21,
      "start_ms": 41759,
      "end_ms": 44180,
      "text": "我是否应该向你那样开酒吧"
    },
    {
      "ordinal": 22,
      "start_ms": 44180,
      "end_ms": 46220,
      "text": "可是好像我有的场地也做不了什么"
    },
    {
      "ordinal": 23,
      "start_ms": 46220,
      "end_ms": 49920,
      "text": "我在家人朋友间尝试多次寻找同伴也无果"
    },
    {
      "ordinal": 24,
      "start_ms": 49920,
      "end_ms": 52260,
      "text": "还是我应该回到大学混文凭"
    },
    {
      "ordinal": 25,
      "start_ms": 52260,
      "end_ms": 53160,
      "text": "但一个学术文明"
    },
    {
      "ordinal": 26,
      "start_ms": 53160,
      "end_ms": 54480,
      "text": "对我们共同自己有多少帮助"
    },
    {
      "ordinal": 27,
      "start_ms": 54480,
      "end_ms": 55350,
      "text": "我也不明白"
    },
    {
      "ordinal": 28,
      "start_ms": 55350,
      "end_ms": 57450,
      "text": "我不想在一个人上人的环境生活"
    },
    {
      "ordinal": 29,
      "start_ms": 57450,
      "end_ms": 58770,
      "text": "我也不想出卖脑力"
    },
    {
      "ordinal": 30,
      "start_ms": 58770,
      "end_ms": 60150,
      "text": "对此我很想知道你的看法"
    },
    {
      "ordinal": 31,
      "start_ms": 60150,
      "end_ms": 61650,
      "text": "以及你到底会做什么"
    },
    {
      "ordinal": 32,
      "start_ms": 61650,
      "end_ms": 62190,
      "text": "在做什么"
    },
    {
      "ordinal": 33,
      "start_ms": 62190,
      "end_ms": 64360,
      "text": "因为我在网上看到什么"
    },
    {
      "ordinal": 34,
      "start_ms": 64360,
      "end_ms": 66010,
      "text": "什么等词汇来描述你"
    },
    {
      "ordinal": 35,
      "start_ms": 66010,
      "end_ms": 67300,
      "text": "如果我不害怕这些"
    },
    {
      "ordinal": 36,
      "start_ms": 67300,
      "end_ms": 70900,
      "text": "我要如何为这些运动提供我的力量呢"
    },
    {
      "ordinal": 37,
      "start_ms": 70900,
      "end_ms": 72100,
      "text": "我从现在起"
    },
    {
      "ordinal": 38,
      "start_ms": 72100,
      "end_ms": 75980,
      "text": "又该如何汇集力量来为将来做准备呢"
    },
    {
      "ordinal": 39,
      "start_ms": 76460,
      "end_ms": 78740,
      "text": "我祝愿同志们的事业顺利"
    },
    {
      "ordinal": 40,
      "start_ms": 78740,
      "end_ms": 79460,
      "text": "这是我的手机号"
    },
    {
      "ordinal": 41,
      "start_ms": 79460,
      "end_ms": 80120,
      "text": "哒哒哒"
    },
    {
      "ordinal": 42,
      "start_ms": 80120,
      "end_ms": 81680,
      "text": "如果我的情况具有普遍性"
    },
    {
      "ordinal": 43,
      "start_ms": 81680,
      "end_ms": 83360,
      "text": "我很乐意公开我的信件"
    },
    {
      "ordinal": 44,
      "start_ms": 83360,
      "end_ms": 86680,
      "text": "就是对于这位呢啊什么他手机号给了"
    },
    {
      "ordinal": 45,
      "start_ms": 86680,
      "end_ms": 87720,
      "text": "先拍个照啊"
    },
    {
      "ordinal": 46,
      "start_ms": 88680,
      "end_ms": 90390,
      "text": "呃对于这位老哥"
    },
    {
      "ordinal": 47,
      "start_ms": 90390,
      "end_ms": 91440,
      "text": "我给的建议啊"
    },
    {
      "ordinal": 48,
      "start_ms": 91440,
      "end_ms": 94720,
      "text": "就是说你可以开个餐馆儿啊"
    },
    {
      "ordinal": 49,
      "start_ms": 94720,
      "end_ms": 97160,
      "text": "一个人哪怕你一个人"
    },
    {
      "ordinal": 50,
      "start_ms": 97680,
      "end_ms": 99450,
      "text": "你就学我的模式呗"
    },
    {
      "ordinal": 51,
      "start_ms": 99450,
      "end_ms": 100260,
      "text": "开个餐馆"
    },
    {
      "ordinal": 52,
      "start_ms": 100260,
      "end_ms": 105940,
      "text": "然后呢呃星期123567做生意赚钱"
    },
    {
      "ordinal": 53,
      "start_ms": 105940,
      "end_ms": 111440,
      "text": "星期四免费为周围的呃底层劳动者啊"
    },
    {
      "ordinal": 54,
      "start_ms": 111440,
      "end_ms": 113410,
      "text": "赤贫劳动者无产者"
    },
    {
      "ordinal": 55,
      "start_ms": 113410,
      "end_ms": 114670,
      "text": "但是得劳动者啊"
    },
    {
      "ordinal": 56,
      "start_ms": 114670,
      "end_ms": 115420,
      "text": "他得劳动"
    },
    {
      "ordinal": 57,
      "start_ms": 115420,
      "end_ms": 117850,
      "text": "他得用体力换取生生存资料啊"
    },
    {
      "ordinal": 58,
      "start_ms": 117850,
      "end_ms": 121510,
      "text": "最好是用体力或者重复性的压迫性的脑力"
    },
    {
      "ordinal": 59,
      "start_ms": 121510,
      "end_ms": 122950,
      "text": "折磨性的脑力"
    },
    {
      "ordinal": 60,
      "start_ms": 122950,
      "end_ms": 125200,
      "text": "体力劳动者和底层脑力劳动者"
    },
    {
      "ordinal": 61,
      "start_ms": 125200,
      "end_ms": 127700,
      "text": "可以给他们免费提供一餐饭"
    },
    {
      "ordinal": 62,
      "start_ms": 128639,
      "end_ms": 130249,
      "text": "你不是有个场地吗"
    },
    {
      "ordinal": 63,
      "start_ms": 130249,
      "end_ms": 131479,
      "text": "如果你做成的话"
    },
    {
      "ordinal": 64,
      "start_ms": 131479,
      "end_ms": 133459,
      "text": "你可以申请加入我们啊"
    },
    {
      "ordinal": 65,
      "start_ms": 133459,
      "end_ms": 134800,
      "text": "申请加入我们"
    },
    {
      "ordinal": 66,
      "start_ms": 146919,
      "end_ms": 147879,
      "text": "不要老问我啊"
    },
    {
      "ordinal": 67,
      "start_ms": 147879,
      "end_ms": 148929,
      "text": "自己多去学"
    },
    {
      "ordinal": 68,
      "start_ms": 148929,
      "end_ms": 150699,
      "text": "自己多学啊"
    },
    {
      "ordinal": 69,
      "start_ms": 150699,
      "end_ms": 152979,
      "text": "把实践和这个理论结合到一起"
    },
    {
      "ordinal": 70,
      "start_ms": 152979,
      "end_ms": 157940,
      "text": "多和人民群众交流啊啊啊打成一片啊"
    },
    {
      "ordinal": 71,
      "start_ms": 157940,
      "end_ms": 159240,
      "text": "那就讲到这边好吧"
    }
  ],
  "text": "我今天来回应信件\n他说可以公开啊\n他叫邓家潮\n你好\n性\n之前在在读某中流985大学\n和学校的规训化活动而休学了\n因为我的父母沉迷于资本增值的活动\n我一直只为管饱\n除此以外\n我除了沉迷网络之外\n没有参与过任何社会实践\n对此深感惭愧\n不过从今天开始\n我决定为人类解放事业贡献自己的一份力\n但我却不知道走上这条路以后\n我究竟应该具体做什么\n我基本没有什么欲望\n可以过很亲民的生活\n我和家里人讨论过\n家里可以为我提供一片场地\n我是否应该向你那样开酒吧\n可是好像我有的场地也做不了什么\n我在家人朋友间尝试多次寻找同伴也无果\n还是我应该回到大学混文凭\n但一个学术文明\n对我们共同自己有多少帮助\n我也不明白\n我不想在一个人上人的环境生活\n我也不想出卖脑力\n对此我很想知道你的看法\n以及你到底会做什么\n在做什么\n因为我在网上看到什么\n什么等词汇来描述你\n如果我不害怕这些\n我要如何为这些运动提供我的力量呢\n我从现在起\n又该如何汇集力量来为将来做准备呢\n我祝愿同志们的事业顺利\n这是我的手机号\n哒哒哒\n如果我的情况具有普遍性\n我很乐意公开我的信件\n就是对于这位呢啊什么他手机号给了\n先拍个照啊\n呃对于这位老哥\n我给的建议啊\n就是说你可以开个餐馆儿啊\n一个人哪怕你一个人\n你就学我的模式呗\n开个餐馆\n然后呢呃星期123567做生意赚钱\n星期四免费为周围的呃底层劳动者啊\n赤贫劳动者无产者\n但是得劳动者啊\n他得劳动\n他得用体力换取生生存资料啊\n最好是用体力或者重复性的压迫性的脑力\n折磨性的脑力\n体力劳动者和底层脑力劳动者\n可以给他们免费提供一餐饭\n你不是有个场地吗\n如果你做成的话\n你可以申请加入我们啊\n申请加入我们\n不要老问我啊\n自己多去学\n自己多学啊\n把实践和这个理论结合到一起\n多和人民群众交流啊啊啊打成一片啊\n那就讲到这边好吧",
  "timing_issue": null
}
