{"segments":[{"start":0.02,"end":2.029,"text":"无产青年"},{"start":2.55,"end":4.25,"text":"你不是小资产阶级青年"},{"start":4.25,"end":5.21,"text":"小资产阶级"},{"start":5.21,"end":6.47,"text":"什么是小资产阶级"},{"start":6.47,"end":9.83,"text":"小资产阶级拥有一些符号性的身份"},{"start":9.83,"end":12.32,"text":"符号性的啊"},{"start":12.32,"end":13.7,"text":"符号性的资格"},{"start":13.7,"end":15.23,"text":"符号性的资质"},{"start":15.23,"end":18.1,"text":"而不是符号性的物"},{"start":18.26,"end":21.34,"text":"哎这些东西算是物了防盗系统物啊"},{"start":22.72,"end":23.86,"text":"比如说房产"},{"start":23.86,"end":30.63,"text":"比如说在市场当中尤其受到优待的证书啊"},{"start":30.63,"end":32.5,"text":"那比如说啊"},{"start":32.5,"end":35.02,"text":"比如说一些主要是房产了"},{"start":35.02,"end":36.4,"text":"普遍而言之主要是房产"},{"start":36.4,"end":37.42,"text":"受教育阶级里面"},{"start":37.42,"end":40.95,"text":"受教育者当中是有这个市场当中"},{"start":40.95,"end":45.81,"text":"直接就是工资涨3000涨涨4000的这种证书啊"},{"start":46.09,"end":49.17,"text":"还有一些名校身份啊"},{"start":49.17,"end":50.49,"text":"你如果有这些东西的话"},{"start":50.49,"end":54.6,"text":"你的劳动一般的无产"},{"start":54.6,"end":55.92,"text":"没有这些东西的无产青年"},{"start":55.92,"end":59.0,"text":"他同样的劳动啊"},{"start":59.0,"end":60.95,"text":"他劳动一小时15块钱"},{"start":60.95,"end":62.51,"text":"有这东西的劳动"},{"start":62.51,"end":65.64,"text":"一小时30块钱"},{"start":65.92,"end":67.08,"text":"同等的劳动"},{"start":67.08,"end":69.42,"text":"同样内容的劳动"},{"start":70.26,"end":72.8,"text":"那么这种就是小资产阶级"},{"start":72.8,"end":75.26,"text":"他通过教育实现了他的小资产阶级化"},{"start":75.26,"end":79.23,"text":"它在资资产阶内部承认他这个哦"},{"start":79.23,"end":81.45,"text":"你这个身份我就给你多给一点吧"},{"start":81.45,"end":85.77,"text":"那么他要维护这些身份啊"},{"start":85.77,"end":89.61,"text":"这些能够让他多无条件的多占有一些的"},{"start":89.61,"end":92.55,"text":"这些标签啊"},{"start":92.55,"end":94.92,"text":"他们可以说也是具有反动性的"},{"start":94.92,"end":96.3,"text":"如果你没有这些东西"},{"start":96.3,"end":99.02,"text":"如果你就是不劳动不得食"},{"start":99.02,"end":101.66,"text":"没有办法通过这些玩意的挂靠"},{"start":101.66,"end":104.269,"text":"或者通过这些玩意的一个加成啊"},{"start":104.269,"end":105.409,"text":"从同样的劳动当中"},{"start":105.409,"end":109.369,"text":"比一般的无产的劳动者明显多拿的"},{"start":109.369,"end":111.63,"text":"那你就是无产青年"},{"start":111.97,"end":113.97,"text":"也就是说你的在校教育也好"},{"start":113.97,"end":115.89,"text":"你在社会上考了各种资质"},{"start":115.89,"end":116.43,"text":"各种证"},{"start":116.43,"end":119.76,"text":"它只是准入性的啊"},{"start":119.76,"end":122.99,"text":"啊只是说你可以去干这个东西"},{"start":123.27,"end":124.43,"text":"那我举个例子啊"},{"start":124.43,"end":124.85,"text":"举个例子"},{"start":124.85,"end":125.51,"text":"比如说律师"},{"start":125.51,"end":126.17,"text":"他有律师证"},{"start":127.61,"end":129.28,"text":"他这个律师证"},{"start":129.68,"end":131.5,"text":"你说啊律师也是准入侵的"},{"start":131.5,"end":132.76,"text":"这是这个行业准入侵的"},{"start":132.76,"end":134.25,"text":"但实事求是讲的"},{"start":134.25,"end":136.23,"text":"在司法的"},{"start":136.23,"end":139.68,"text":"在律所里面有很多法学院毕业的学生"},{"start":139.68,"end":140.97,"text":"他没拿到律师证"},{"start":140.97,"end":144.579,"text":"他过去干就特别便宜"},{"start":144.579,"end":146.319,"text":"他过去做同样的劳动"},{"start":148.419,"end":149.439,"text":"他也懂那东西"},{"start":149.439,"end":150.669,"text":"但由于他没有这个证"},{"start":150.669,"end":151.419,"text":"没有卷出来"},{"start":151.419,"end":153.14,"text":"没有考出来"},{"start":153.48,"end":155.9,"text":"他没办法拿这个证啊"},{"start":155.9,"end":159.44,"text":"从他们律所的这个分钱的这个关系当中"},{"start":159.44,"end":160.95,"text":"多分点钱"},{"start":161.11,"end":164.13,"text":"甚至说你光有你光有这个过司法考试"},{"start":164.13,"end":164.91,"text":"这个还不够"},{"start":164.91,"end":165.21,"text":"对不对"},{"start":165.21,"end":167.57,"text":"你还得拿到律师证"},{"start":168.15,"end":170.44,"text":"律师证其实很好拿的"},{"start":170.78,"end":172.72,"text":"但是有的地方管的比较严"},{"start":172.72,"end":174.04,"text":"那么回过来讲"},{"start":174.04,"end":178.58,"text":"就是说你如果是个无产青年啊"},{"start":178.58,"end":180.29,"text":"你是个无产青年"},{"start":180.29,"end":186.839,"text":"你的劳动没有得到额外的符号性的资格的"},{"start":186.839,"end":188.29,"text":"加成的"},{"start":188.29,"end":191.32,"text":"这些加成他不是按照劳动内容"},{"start":191.32,"end":192.94,"text":"不是按照劳动强度"},{"start":192.94,"end":195.62,"text":"而纯粹就是按照一个虚拟的头衔"},{"start":195.62,"end":197.6,"text":"虚拟的一个身份标识"},{"start":197.6,"end":203.11,"text":"虚拟的一个那些人的某种承认在起作用的"},{"start":203.11,"end":204.67,"text":"那么你是无产青年"},{"start":204.67,"end":206.36,"text":"无产青年"},{"start":206.76,"end":209.24,"text":"我我要给一个建议啊"},{"start":209.24,"end":210.44,"text":"就是我给一个建议"},{"start":210.44,"end":213.26,"text":"不要掺和到"},{"start":215.46,"end":218.12,"text":"刚刚讲的是知识性的小资产阶级了"},{"start":218.12,"end":219.62,"text":"当然除了知识性的小资产阶级"},{"start":219.62,"end":224.43,"text":"还有一个纯粹的一个财富性的小资产阶级"},{"start":224.43,"end":226.98,"text":"通过房产可以吸血的"},{"start":226.98,"end":228.63,"text":"家里面有几套好几套房"},{"start":228.63,"end":230.19,"text":"他本身就可以不劳而获"},{"start":230.19,"end":234.05,"text":"吸血的这种帝都实力者"},{"start":235.31,"end":237.05,"text":"不要掺和到这些小自然阶级"},{"start":237.05,"end":238.31,"text":"他的愤懑不满"},{"start":238.31,"end":244.66,"text":"以及他们的额外的啊利益诉求当中去"},{"start":245.12,"end":249.26,"text":"也就是说不要和他们"},{"start":249.26,"end":253.07,"text":"不要为他们的政治妄想啊陪葬啊"},{"start":253.609,"end":255.219,"text":"他们鼓噪舆论"},{"start":255.219,"end":259.509,"text":"他们寄希望于一些某种力量里面的"},{"start":259.509,"end":261.56,"text":"外面的某种力量"},{"start":262.86,"end":264.83,"text":"他们在呼唤他们的主子"},{"start":264.83,"end":265.82,"text":"这些主子"},{"start":265.82,"end":266.81,"text":"那些主子"},{"start":266.81,"end":268.52,"text":"那么作为无产青年呢"},{"start":268.52,"end":270.74,"text":"不要去做这样的事情"},{"start":275.42,"end":277.3,"text":"啊没有意义的"},{"start":277.3,"end":279.7,"text":"没有任何意义的"},{"start":288.58,"end":290.76,"text":"就像一个什么啊"},{"start":290.76,"end":292.29,"text":"狱狱卒的亲戚"},{"start":292.29,"end":294.57,"text":"狱卒的这个亲戚过来"},{"start":294.57,"end":296.99,"text":"他也和你聊聊天啊"},{"start":296.99,"end":297.77,"text":"怎么怎么样的"},{"start":297.77,"end":299.45,"text":"最后他在这里面闷得慌了"},{"start":299.45,"end":300.29,"text":"去去去去"},{"start":300.29,"end":302.63,"text":"叫这个老头过来了"},{"start":303.33,"end":304.94,"text":"像那个老头抱怨几句"},{"start":304.94,"end":306.29,"text":"像那个狱卒抱怨几句"},{"start":307.43,"end":310.07,"text":"就跟你没有任何关系的"},{"start":311.98,"end":313.56,"text":"这和你没有任何关系"},{"start":314.64,"end":316.53,"text":"这和无产青年没有任何关系"},{"start":316.53,"end":319.22,"text":"我们要摆脱这样的痴心妄想"},{"start":319.22,"end":321.62,"text":"摆脱这样靠偷靠嘴巴"},{"start":321.62,"end":323.54,"text":"靠呼喊就能改变现实的力量"},{"start":323.54,"end":325.22,"text":"对比没有这种可能性"},{"start":325.22,"end":326.8,"text":"这种可能性为零"},{"start":326.8,"end":330.64,"text":"那么尤其我们要重视是无产青年"},{"start":330.64,"end":331.78,"text":"在城市当中"},{"start":331.78,"end":337.71,"text":"他要高效的团结的低成本的高收益"},{"start":337.71,"end":338.85,"text":"这个收益不是钱"},{"start":338.85,"end":341.57,"text":"而是指的是你的生存能力"},{"start":341.85,"end":344.66,"text":"而是指的你的劳动发展的能力"},{"start":344.66,"end":348.05,"text":"而是指的你的长远的自我解放的能力"},{"start":348.33,"end":352.46,"text":"你要在你的J生存发展和解放的能力上获益"},{"start":352.46,"end":354.37,"text":"获得实质性的利益"},{"start":354.37,"end":356.68,"text":"你要变强变强大"},{"start":356.68,"end":358.919,"text":"你要砸碎你的锁链"},{"start":359.259,"end":360.509,"text":"靠他们"},{"start":360.509,"end":363.719,"text":"靠他们的嘴巴永远是不可能的"},{"start":364.799,"end":366.94,"text":"要靠我们自己"},{"start":367.76,"end":372.67,"text":"那么首要的就要不是要和他们一起呼喊"},{"start":372.67,"end":376.12,"text":"永远不要和他们一起呼喊"},{"start":385.2,"end":390.529,"text":"因为他们不是在生存的重压之下"},{"start":390.529,"end":393.679,"text":"还要去那样积蓄自己的能力的"},{"start":393.679,"end":396.314,"text":"提高自己的能力的"},{"start":399.94,"end":402.63,"text":"他们只在讨赏"},{"start":403.21,"end":407.57,"text":"他们只是在埋怨"},{"start":408.21,"end":410.09,"text":"他们只是在撒娇"},{"start":410.09,"end":412.789,"text":"向他们的主子们撒娇"},{"start":413.189,"end":415.94,"text":"他们没有任何现实的力量"},{"start":416.1,"end":418.97,"text":"小资产阶级城市小资产阶级喉舌"},{"start":418.97,"end":421.13,"text":"没有任何现实的力量"},{"start":421.13,"end":422.81,"text":"没枪没兵"},{"start":422.81,"end":424.99,"text":"没粮没田"},{"start":425.51,"end":426.55,"text":"什么都没有"},{"start":427.93,"end":429.31,"text":"他们鼓噪舆论"},{"start":429.31,"end":432.25,"text":"只是在撒娇而已"},{"start":432.91,"end":437.54,"text":"纯粹的撒娇没有任何的意义"},{"start":440.98,"end":444.48,"text":"难道我们要陪他们一起撒娇吗"},{"start":448.14,"end":450.26,"text":"可笑吧"},{"start":452.14,"end":458.399,"text":"而且况且这种撒娇又是一种假装撕破脸"},{"start":459.659,"end":467.51,"text":"假装薄嗔嗔恨很嗔怒啊"},{"start":467.51,"end":469.52,"text":"撩拨性的嗔怒"},{"start":469.52,"end":471.62,"text":"这种方式就是要叫勾引啊"},{"start":471.62,"end":473.12,"text":"实际上是引诱勾引性的"},{"start":473.12,"end":474.14,"text":"是淫荡的"},{"start":474.14,"end":477.62,"text":"小段时间这些喉舌做这样的举动无产"},{"start":477.62,"end":481.94,"text":"这个青年确切勿随之起舞"},{"start":481.94,"end":483.41,"text":"没有任何意义"},{"start":483.41,"end":486.26,"text":"他们什么力量都没有"},{"start":488.86,"end":493.89,"text":"但是我们是有力量的无产阶级青年"},{"start":493.89,"end":496.33,"text":"我们是有力量的"},{"start":496.73,"end":498.64,"text":"我们是有现实的"},{"start":498.64,"end":501.68,"text":"活生生的创造物质财富"},{"start":501.68,"end":503.93,"text":"创造社会秩序的力量的"},{"start":503.93,"end":505.67,"text":"社会秩序的主导"},{"start":505.67,"end":510.56,"text":"主要层面是由广大的无产青年"},{"start":511.64,"end":515.94,"text":"联防队员绝大部分是无产阶级"},{"start":517.26,"end":521.669,"text":"一线的辅警绝大部分是无产阶级"},{"start":522.07,"end":523.5,"text":"甚至很多民警"},{"start":523.5,"end":530.62,"text":"绝大部分民警也是心向无产阶级的好同志啊"},{"start":530.62,"end":531.94,"text":"也是同情"},{"start":531.94,"end":538.23,"text":"也是坚持保障人民群众长远利益的好同志"},{"start":538.63,"end":543.02,"text":"社会秩序主要的是由无产阶级来创造的"},{"start":543.02,"end":545.54,"text":"社会财富也是由劳动群众"},{"start":545.54,"end":549.5,"text":"无产阶级无产阶级很多也是无产青年了"},{"start":549.5,"end":550.76,"text":"现在40多岁"},{"start":550.76,"end":551.75,"text":"30多岁的"},{"start":551.75,"end":552.8,"text":"20多岁的"},{"start":552.8,"end":555.14,"text":"现在是我们主要劳动力的主要构成部分"},{"start":555.14,"end":557.36,"text":"是由我们来创造的"},{"start":557.36,"end":560.43,"text":"有人说我没有资格来宣称我们"},{"start":560.465,"end":566.55,"text":"我的团队和我的团队的主要的支持者"},{"start":568.62,"end":573.68,"text":"那我们绝大部分的人是过着一种不是积累"},{"start":573.68,"end":576.88,"text":"我们不进行资产性质的积累"},{"start":576.88,"end":579.7,"text":"不进行资本增值意义上的积累"},{"start":579.7,"end":581.38,"text":"我们不盘剥别人"},{"start":581.38,"end":587.859,"text":"我们不从别人的劳动当中啊获得剩余价值"},{"start":588.679,"end":593.019,"text":"那你说在商业分工里面非要说我什么办"},{"start":5