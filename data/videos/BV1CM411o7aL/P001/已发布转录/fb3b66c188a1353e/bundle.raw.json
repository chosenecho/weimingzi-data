ext":"要控制规模"},{"start":929.19,"end":929.94,"text":"合租的话"},{"start":929.94,"end":932.01,"text":"控制规模不要超过十个"},{"start":932.01,"end":934.92,"text":"你有七个最多了"},{"start":935.26,"end":937.65,"text":"人多的话就给你扣帽子"},{"start":937.65,"end":939.94,"text":"你就得进去"},{"start":940.34,"end":942.82,"text":"在线下控制规模"},{"start":944.08,"end":946.42,"text":"大家合租租个毛坯"},{"start":946.42,"end":948.26,"text":"把生活成本降下来"},{"start":948.26,"end":950.6,"text":"积累到的钱不要去投机"},{"start":950.6,"end":951.26,"text":"不要去赌啊"},{"start":951.26,"end":953.94,"text":"瓢儿的去学习技能"},{"start":953.94,"end":956.64,"text":"有的技能是你有了有了这个资质"},{"start":956.64,"end":957.42,"text":"你才能学的"},{"start":957.42,"end":958.8,"text":"那你这个资质就得交钱"},{"start":958.8,"end":959.91,"text":"比如说考驾照"},{"start":959.91,"end":961.86,"text":"你先做到你们合租的人"},{"start":961.86,"end":965.05,"text":"每个人都会开车考驾照"},{"start":965.05,"end":967.09,"text":"那我的俱乐部就是这样的"},{"start":967.09,"end":967.75,"text":"你要练车"},{"start":967.75,"end":969.37,"text":"你可以到我俱乐部来练你"},{"start":969.37,"end":970.81,"text":"但前提你有驾照"},{"start":970.81,"end":971.77,"text":"你有驾照了"},{"start":971.77,"end":973.984,"text":"我这个车给你开"},{"start":976.02,"end":978.2,"text":"好我们去找个空场地让你练一练"},{"start":978.2,"end":979.7,"text":"人家说你凭什么"},{"start":979.7,"end":982.58,"text":"你妈没有没有资质的教人家教人家练车"},{"start":982.58,"end":983.24,"text":"哎不好意思"},{"start":983.24,"end":987.05,"text":"他有驾照也他有驾照"},{"start":987.05,"end":990.26,"text":"是不能没有车练手吗"},{"start":991.52,"end":992.26,"text":"懂了吗"},{"start":995.38,"end":1002.92,"text":"或者说要让你的活动不具有政治上的可戕害性"},{"start":1003.44,"end":1004.81,"text":"不要让你的活动"},{"start":1004.81,"end":1010.73,"text":"现实的活动本身是应当被合法评价的"},{"start":1010.73,"end":1013.28,"text":"评价为合法的"},{"start":1016.48,"end":1019.56,"text":"你在线上线下的言辞里面被人抓了"},{"start":1019.56,"end":1020.94,"text":"线头被人抓了"},{"start":1020.94,"end":1022.65,"text":"油头和把柄"},{"start":1022.99,"end":1024.96,"text":"别人可以破坏你的"},{"start":1024.96,"end":1027.869,"text":"可以损害你的利益的"},{"start":1029.48,"end":1032.8,"text":"你竞争对手会打击报复你的"},{"start":1035.02,"end":1