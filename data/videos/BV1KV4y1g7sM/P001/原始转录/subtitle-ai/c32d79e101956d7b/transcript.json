    },
    {
      "ordinal": 28,
      "start_ms": 129470,
      "end_ms": 130759,
      "text": "这是最极端的情况"
    },
    {
      "ordinal": 29,
      "start_ms": 130759,
      "end_ms": 131960,
      "text": "被原生家庭吸血"
    },
    {
      "ordinal": 30,
      "start_ms": 131960,
      "end_ms": 134940,
      "text": "逼着你去打工"
