    {
      "ordinal": 32,
      "start_ms": 137250,
      "end_ms": 138000,
      "text": "出卖自己"
    },
    {
      "ordinal": 33,
      "start_ms": 138000,
      "end_ms": 139180,
      "text": "出卖自己"
    },
    {
      "ordinal": 34,
      "start_ms": 139760,
      "end_ms": 141610,
      "text": "这是最严重的情况"
    },
    {
      "ordinal": 35,
      "start_ms": 141610,
