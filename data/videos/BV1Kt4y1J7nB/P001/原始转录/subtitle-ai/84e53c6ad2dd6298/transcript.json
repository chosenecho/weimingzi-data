{
  "bvid": "BV1Kt4y1J7nB",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "84e53c6ad2dd629830d1c9432c3deb0ff549781d13186a37c22d0523409785a6",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 400,
      "end_ms": 2170,
      "text": "呃什么样的人善于"
    },
    {
      "ordinal": 1,
      "start_ms": 2170,
      "end_ms": 4640,
      "text": "我们现在要讲的就是说"
    },
    {
      "ordinal": 2,
      "start_ms": 6180,
      "end_ms": 10640,
      "text": "组织工作就这个是狭义的"
    },
    {
      "ordinal": 3,
      "start_ms": 10640,
      "end_ms": 12060,
      "text": "狭义义上的"
    },
    {
      "ordinal": 4,
      "start_ms": 12999,
      "end_ms": 15779,
      "text": "这就是人才人才选拔"
    },
    {
      "ordinal": 5,
      "start_ms": 15779,
      "end_ms": 17460,
      "text": "人才选拔工作"
    },
    {
      "ordinal": 6,
      "start_ms": 18400,
      "end_ms": 24450,
      "text": "围绕围绕这个人才选拔和组织的初步建制"
    },
    {
      "ordinal": 7,
      "start_ms": 24450,
      "end_ms": 28380,
      "text": "初步初步建设"
    },
    {
      "ordinal": 8,
      "start_ms": 29780,
      "end_ms": 31480,
      "text": "什么样的人合适啊"
    },
    {
      "ordinal": 9,
      "start_ms": 31480,
      "end_ms": 32500,
      "text": "什么叫合适"
    },
    {
      "ordinal": 10,
      "start_ms": 32500,
      "end_ms": 37070,
      "text": "这个合适就是说这个人本身啊"
    },
    {
      "ordinal": 11,
      "start_ms": 37070,
      "end_ms": 41240,
      "text": "这个人本身最好有两个点啊"
    },
    {
      "ordinal": 12,
      "start_ms": 41240,
      "end_ms": 44040,
      "text": "第一个就是一通百通"
    },
    {
      "ordinal": 13,
      "start_ms": 44960,
      "end_ms": 46990,
      "text": "他是一个一通百通的人"
    },
    {
      "ordinal": 14,
      "start_ms": 46990,
      "end_ms": 48820,
      "text": "在某个领域"
    },
    {
      "ordinal": 15,
      "start_ms": 48820,
      "end_ms": 52919,
      "text": "在某个领域已经做到了几乎做的一通百通"
    },
    {
      "ordinal": 16,
      "start_ms": 53120,
      "end_ms": 57419,
      "text": "另外一方面他是一个多才多艺"
    },
    {
      "ordinal": 17,
      "start_ms": 59620,
      "end_ms": 62470,
      "text": "啊什么都都就是他"
    },
    {
      "ordinal": 18,
      "start_ms": 62470,
      "end_ms": 64720,
      "text": "但是一通百通只是某个领域"
    },
    {
      "ordinal": 19,
      "start_ms": 64980,
      "end_ms": 67380,
      "text": "就第二个就是多才多艺"
    },
    {
      "ordinal": 20,
      "start_ms": 67380,
      "end_ms": 70260,
      "text": "都有略有了解懂吧"
    },
    {
      "ordinal": 21,
      "start_ms": 70260,
      "end_ms": 75050,
      "text": "略有了解就是说浅尝折纸啊"
    },
    {
      "ordinal": 22,
      "start_ms": 81560,
      "end_ms": 82690,
      "text": "是这样写吧"
    },
    {
      "ordinal": 23,
      "start_ms": 84760,
      "end_ms": 86140,
      "text": "就是这样的人"
    },
    {
      "ordinal": 24,
      "start_ms": 86140,
      "end_ms": 89020,
      "text": "是很适合进行这个狭义的一个"
    },
    {
      "ordinal": 25,
      "start_ms": 89020,
      "end_ms": 90220,
      "text": "组织工作的啊"
    },
    {
      "ordinal": 26,
      "start_ms": 90220,
      "end_ms": 97190,
      "text": "围绕人才选拔和这个岗位岗位分工啊"
    },
    {
      "ordinal": 27,
      "start_ms": 97190,
      "end_ms": 98960,
      "text": "倒是初步的啊"
    },
    {
      "ordinal": 28,
      "start_ms": 98960,
      "end_ms": 100340,
      "text": "一个初步建设"
    },
    {
      "ordinal": 29,
      "start_ms": 101280,
      "end_ms": 102740,
      "text": "为什么这样说呢"
    },
    {
      "ordinal": 30,
      "start_ms": 102740,
      "end_ms": 105800,
      "text": "因为一通百通意味着"
    },
    {
      "ordinal": 31,
      "start_ms": 105800,
      "end_ms": 110480,
      "text": "它可以以一种比较的方式触类旁通"
    },
    {
      "ordinal": 32,
      "start_ms": 110480,
      "end_ms": 112740,
      "text": "但是本身思维触类旁通啊"
    },
    {
      "ordinal": 33,
      "start_ms": 112740,
      "end_ms": 114780,
      "text": "它可以一种比类比的方式"
    },
    {
      "ordinal": 34,
      "start_ms": 114780,
      "end_ms": 115890,
      "text": "类比的方式"
    },
    {
      "ordinal": 35,
      "start_ms": 115890,
      "end_ms": 121360,
      "text": "理解不同位置上的人啊的这个水准啊"
    },
    {
      "ordinal": 36,
      "start_ms": 121360,
      "end_ms": 122780,
      "text": "另外一方面呢"
    },
    {
      "ordinal": 37,
      "start_ms": 125080,
      "end_ms": 128360,
      "text": "多才多艺很重要"
    },
    {
      "ordinal": 38,
      "start_ms": 128619,
      "end_ms": 130508,
      "text": "多才多艺很重要"
    },
    {
      "ordinal": 39,
      "start_ms": 130508,
      "end_ms": 131439,
      "text": "因为多才多艺"
    },
    {
      "ordinal": 40,
      "start_ms": 131439,
      "end_ms": 137480,
      "text": "意味着他和每一个就是说多才多艺"
    },
    {
      "ordinal": 41,
      "start_ms": 137480,
      "end_ms": 140520,
      "text": "它用来做的就是启发性"
    },
    {
      "ordinal": 42,
      "start_ms": 141860,
      "end_ms": 144580,
      "text": "启发性或者我们说的更更严重"
    },
    {
      "ordinal": 43,
      "start_ms": 144580,
      "end_ms": 147700,
      "text": "这个被启发性就是这个被子最重要"
    },
    {
      "ordinal": 44,
      "start_ms": 147700,
      "end_ms": 148360,
      "text": "多才多艺"
    },
    {
      "ordinal": 45,
      "start_ms": 148360,
      "end_ms": 152890,
      "text": "就意味着说那个人如果他可以启发你哦"
    },
    {
      "ordinal": 46,
      "start_ms": 152890,
      "end_ms": 155560,
      "text": "也就是说比如说你是一个你一同百通"
    },
    {
      "ordinal": 47,
      "start_ms": 155560,
      "end_ms": 160390,
      "text": "比如说你是一个这个啊文学方面一通百通"
    },
    {
      "ordinal": 48,
      "start_ms": 160390,
      "end_ms": 165320,
      "text": "然后你监通什么戏剧也会一些这个作词"
    },
    {
      "ordinal": 49,
      "start_ms": 165320,
      "end_ms": 166520,
      "text": "音乐作词啊"
    },
    {
      "ordinal": 50,
      "start_ms": 166520,
      "end_ms": 167840,
      "text": "作词也会写"
    },
    {
      "ordinal": 51,
      "start_ms": 167840,
      "end_ms": 169970,
      "text": "诗歌也会一些啊"
    },
    {
      "ordinal": 52,
      "start_ms": 169970,
      "end_ms": 171890,
      "text": "诗歌也会写啊"
    },
    {
      "ordinal": 53,
      "start_ms": 171890,
      "end_ms": 174189,
      "text": "这个文娟呃"
    },
    {
      "ordinal": 54,
      "start_ms": 174189,
      "end_ms": 176919,
      "text": "文案创作你也会一些写材料"
    },
    {
      "ordinal": 55,
      "start_ms": 176919,
      "end_ms": 179950,
      "text": "你也会一些啊等等"
    },
    {
      "ordinal": 56,
      "start_ms": 179950,
      "end_ms": 180700,
      "text": "一通百通了"
    },
    {
      "ordinal": 57,
      "start_ms": 180700,
      "end_ms": 182050,
      "text": "你文学水准很高"
    },
    {
      "ordinal": 58,
      "start_ms": 182050,
      "end_ms": 183640,
      "text": "一通百通了啊"
    },
    {
      "ordinal": 59,
      "start_ms": 183640,
      "end_ms": 184400,
      "text": "然后"
    },
    {
      "ordinal": 60,
      "start_ms": 186299,
      "end_ms": 189659,
      "text": "啊那这种人光是这个还不够"
    },
    {
      "ordinal": 61,
      "start_ms": 189659,
      "end_ms": 191279,
      "text": "你还要其他东西多才多艺"
    },
    {
      "ordinal": 62,
      "start_ms": 191279,
      "end_ms": 193780,
      "text": "就有点像赵元任这种"
    },
    {
      "ordinal": 63,
      "start_ms": 194100,
      "end_ms": 196500,
      "text": "但张元院士很多都都都通嘛"
    },
    {
      "ordinal": 64,
      "start_ms": 196500,
      "end_ms": 198840,
      "text": "我说的就是你不可能有那么多人才"
    },
    {
      "ordinal": 65,
      "start_ms": 198840,
      "end_ms": 199740,
      "text": "组织人才"
    },
    {
      "ordinal": 66,
      "start_ms": 199740,
      "end_ms": 200880,
      "text": "我们也需要很多"
    },
    {
      "ordinal": 67,
      "start_ms": 200880,
      "end_ms": 202700,
      "text": "我们需要你多才多"
    },
    {
      "ordinal": 68,
      "start_ms": 202700,
      "end_ms": 204620,
      "text": "意味着就是你也是你会文学"
    },
    {
      "ordinal": 69,
      "start_ms": 204620,
      "end_ms": 206000,
      "text": "但是你又懂这个"
    },
    {
      "ordinal": 70,
      "start_ms": 206000,
      "end_ms": 209780,
      "text": "比如说呃微电子又懂一些"
    },
    {
      "ordinal": 71,
      "start_ms": 209780,
      "end_ms": 214670,
      "text": "然后这个什么医药也懂一些哲学一些东西"
    },
    {
      "ordinal": 72,
      "start_ms": 214670,
      "end_ms": 217659,
      "text": "什么什么其他东西好多也都懂一些啊"
    },
    {
      "ordinal": 73,
      "start_ms": 217659,
      "end_ms": 220509,
      "text": "就是那个网铺的比较开啊"
    },
    {
      "ordinal": 74,
      "start_ms": 220509,
      "end_ms": 221780,
      "text": "多才多艺嘛"
    },
    {
      "ordinal": 75,
      "start_ms": 221839,
      "end_ms": 225120,
      "text": "但这个是不至于成为才艺啊"
    },
    {
      "ordinal": 76,
      "start_ms": 225120,
      "end_ms": 226800,
      "text": "就是都都入入入门"
    },
    {
      "ordinal": 77,
      "start_ms": 226800,
      "end_ms": 227850,
      "text": "都入入门"
    },
    {
      "ordinal": 78,
      "start_ms": 227850,
      "end_ms": 229050,
      "text": "产生则止"
    },
    {
      "ordinal": 79,
      "start_ms": 229050,
      "end_ms": 231210,
      "text": "这个时候你判断人才"
    },
    {
      "ordinal": 80,
      "start_ms": 231210,
      "end_ms": 233399,
      "text": "就是说这种"
    },
    {
      "ordinal": 81,
      "start_ms": 233399,
      "end_ms": 234539,
      "text": "人适合做组织工作"
    },
    {
      "ordinal": 82,
      "start_ms": 234539,
      "end_ms": 236980,
      "text": "因为它可以被折服"
    },
    {
      "ordinal": 83,
      "start_ms": 236980,
      "end_ms": 238360,
      "text": "而不是被唬住"
    },
    {
      "ordinal": 84,
      "start_ms": 238360,
      "end_ms": 239890,
      "text": "他可以被折服"
    },
    {
      "ordinal": 85,
      "start_ms": 239890,
      "end_ms": 241540,
      "text": "他有点小的造诣"
    },
    {
      "ordinal": 86,
      "start_ms": 241540,
      "end_ms": 242680,
      "text": "一点点造诣"
    },
    {
      "ordinal": 87,
      "start_ms": 242720,
      "end_ms": 246200,
      "text": "他会看到找到的人才呢"
    },
    {
      "ordinal": 88,
      "start_ms": 246200,
      "end_ms": 247400,
      "text": "能把他折服"
    },
    {
      "ordinal": 89,
      "start_ms": 247400,
      "end_ms": 249030,
      "text": "能把它启发"
    },
    {
      "ordinal": 90,
      "start_ms": 249030,
      "end_ms": 250230,
      "text": "能让他吃惊"
    },
    {
      "ordinal": 91,
      "start_ms": 250230,
      "end_ms": 251130,
      "text": "他能吃到这个金"
    },
    {
      "ordinal": 92,
      "start_ms": 251130,
      "end_ms": 252300,
      "text": "他能知道这个"
    },
    {
      "ordinal": 93,
      "start_ms": 252300,
      "end_ms": 256740,
      "text": "知道这个这个这个这个确实人家是行家"
    },
    {
      "ordinal": 94,
      "start_ms": 256740,
      "end_ms": 258240,
      "text": "确实他厉害啊"
    },
    {
      "ordinal": 95,
      "start_ms": 258240,
      "end_ms": 261259,
      "text": "这样的人适合做组织工作啊"
    },
    {
      "ordinal": 96,
      "start_ms": 261259,
      "end_ms": 262039,
      "text": "组织工作"
    },
    {
      "ordinal": 97,
      "start_ms": 262039,
      "end_ms": 264859,
      "text": "然后直接说也就是说他自己得"
    },
    {
      "ordinal": 98,
      "start_ms": 264859,
      "end_ms": 267130,
      "text": "我们就是说他他自己得是人才"
    },
    {
      "ordinal": 99,
      "start_ms": 267130,
      "end_ms": 268300,
      "text": "自己是人才"
    },
    {
      "ordinal": 100,
      "start_ms": 268300,
      "end_ms": 269710,
      "text": "自己是一个人才"
    },
    {
      "ordinal": 101,
      "start_ms": 269710,
      "end_ms": 270730,
      "text": "就两个前提吧"
    },
    {
      "ordinal": 102,
      "start_ms": 270730,
      "end_ms": 272110,
      "text": "第一个前提就是他自己是个人"
    },
    {
      "ordinal": 103,
      "start_ms": 272110,
      "end_ms": 275360,
      "text": "第二个前提就是他能够知道别人是人才"
    },
    {
      "ordinal": 104,
      "start_ms": 276560,
      "end_ms": 278780,
      "text": "能够知道别人是人才"
    },
    {
      "ordinal": 105,
      "start_ms": 281440,
      "end_ms": 283480,
      "text": "啊这样的人善于做主持工作"
    },
    {
      "ordinal": 106,
      "start_ms": 283480,
      "end_ms": 286799,
      "text": "那列琳娜在呃一个文章里面说"
    },
    {
      "ordinal": 107,
      "start_ms": 290339,
      "end_ms": 291839,
      "text": "他已经看不到人才了"
    },
    {
      "ordinal": 108,
      "start_ms": 291839,
      "end_ms": 293639,
      "text": "那他就不适合做主持工作"
    },
    {
      "ordinal": 109,
      "start_ms": 293639,
      "end_ms": 295750,
      "text": "那他他自己的能力再强"
    },
    {
      "ordinal": 110,
      "start_ms": 295750,
      "end_ms": 297670,
      "text": "他也不适合做主持工作"
    },
    {
      "ordinal": 111,
      "start_ms": 297670,
      "end_ms": 300250,
      "text": "他必须要能够看到人才"
    },
    {
      "ordinal": 112,
      "start_ms": 300250,
      "end_ms": 303060,
      "text": "而且能够看到别人的技能和能力"
    },
    {
      "ordinal": 113,
      "start_ms": 303260,
      "end_ms": 305960,
      "text": "确实在其他好的好的方面比自己强"
    },
    {
      "ordinal": 114,
      "start_ms": 305960,
      "end_ms": 307580,
      "text": "或者说其他好的方面自己没有"
    },
    {
      "ordinal": 115,
      "start_ms": 307580,
      "end_ms": 308520,
      "text": "他有"
    },
    {
      "ordinal": 116,
      "start_ms": 308880,
      "end_ms": 310560,
      "text": "也就是说他动态东西"
    },
    {
      "ordinal": 117,
      "start_ms": 310560,
      "end_ms": 312720,
      "text": "一个就是说他有点入门"
    },
    {
      "ordinal": 118,
      "start_ms": 312720,
      "end_ms": 314690,
      "text": "能够知道别人比较"
    },
    {
      "ordinal": 119,
      "start_ms": 314690,
      "end_ms": 317510,
      "text": "还有一个它在两个领域的缝隙"
    },
    {
      "ordinal": 120,
      "start_ms": 317510,
      "end_ms": 319250,
      "text": "它知道这个缝隙存在"
    },
    {
      "ordinal": 121,
      "start_ms": 319250,
      "end_ms": 320470,
      "text": "懂吧"
    },
    {
      "ordinal": 122,
      "start_ms": 320470,
      "end_ms": 322030,
      "text": "知道这个缝隙存在"
    },
    {
      "ordinal": 123,
      "start_ms": 322030,
      "end_ms": 322930,
      "text": "他知道这个东"
    },
    {
      "ordinal": 124,
      "start_ms": 322930,
      "end_ms": 324670,
      "text": "西这个环节一定要他"
    },
    {
      "ordinal": 125,
      "start_ms": 324670,
      "end_ms": 325930,
      "text": "而且他这个动态对"
    },
    {
      "ordinal": 126,
      "start_ms": 325930,
      "end_ms": 329150,
      "text": "还意味着一个是他知道别人比自己强"
    },
    {
      "ordinal": 127,
      "start_ms": 329150,
      "end_ms": 330760,
      "text": "别人大于自己"
    },
    {
      "ordinal": 128,
      "start_ms": 331460,
      "end_ms": 335260,
      "text": "第二个是他知道领域之间有哪些领域"
    },
    {
      "ordinal": 129,
      "start_ms": 335260,
      "end_ms": 337640,
      "text": "领域之间的空缺"
    },
    {
      "ordinal": 130,
      "start_ms": 337760,
      "end_ms": 340070,
      "text": "有数知道缺了哪些东西"
    },
    {
      "ordinal": 131,
      "start_ms": 340070,
      "end_ms": 341800,
      "text": "第三个啊"
    },
    {
      "ordinal": 132,
      "start_ms": 341800,
      "end_ms": 344750,
      "text": "第三个就知道他知道领域之间的相互搭配"
    },
    {
      "ordinal": 133,
      "start_ms": 344750,
      "end_ms": 347360,
      "text": "才能之间的搭配才能兼得"
    },
    {
      "ordinal": 134,
      "start_ms": 347360,
      "end_ms": 350840,
