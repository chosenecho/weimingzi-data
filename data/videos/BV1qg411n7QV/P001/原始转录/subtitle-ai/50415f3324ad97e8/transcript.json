  "segments": [
    {
      "ordinal": 0,
      "start_ms": 120,
      "end_ms": 1740,
      "text": "哎我再做一个承诺"
    },
    {
      "ordinal": 1,
      "start_ms": 1740,
      "end_ms": 7650,
      "text": "这个承诺呢就是说表明我绝对是个m主义者"
    },
    {
      "ordinal": 2,
      "start_ms": 7650,
      "end_ms": 9420,
      "text": "我绝对是个m主义者"
    },
    {
      "ordinal": 3,
      "start_ms": 9420,
      "end_ms": 19580,
      "text": "这个承诺就是公开表明你们任何人啊都可以"
    },
    {
      "ordinal": 4,
      "start_ms": 22019,
      "end_ms": 25399,
      "text": "啊去线下"
