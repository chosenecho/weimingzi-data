    {
      "ordinal": 20,
      "start_ms": 71740,
      "end_ms": 75820,
      "text": "贴信件在店内贴的信件啊"
    },
    {
      "ordinal": 21,
      "start_ms": 76160,
      "end_ms": 79280,
      "text": "如果你这个信件有这个回应方式"
