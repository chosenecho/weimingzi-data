{"segments":[{"start":0.0,"end":0.9,"text":"可以信件啊"},{"start":0.9,"end":2.16,"text":"说可以公开"},{"start":2.16,"end":3.4,"text":"允许公开啊"},{"start":3.719,"end":4.319,"text":"您好"},{"start":4.319,"end":5.699,"text":"我是一位高四复读生"},{"start":5.699,"end":7.139,"text":"目前即将进入大学读书"},{"start":7.139,"end":9.119,"text":"有一些问题想请教一下世界背景"},{"start":9.119,"end":10.78,"text":"教背景故事"},{"start":11.739,"end":13.319,"text":"今年高考前十天"},{"start":13.319,"end":14.399,"text":"5月27号那天"},{"start":14.399,"end":16.619,"text":"恍然意识到复读这1年过得很快"},{"start":16.619,"end":19.359,"text":"进一步想一生是不是70多个这样的1年工作"},{"start":19.359,"end":21.94,"text":"后顾生活固定时间过得越快"},{"start":22.0,"end":23.92,"text":"哎一辈子扎眼过去"},{"start":23.92,"end":28.04,"text":"那天晚上我赚的镜子前好像看到老年的自己陷入这时间流逝的恐惧"},{"start":28.04,"end":29.42,"text":"这是当时的状态"},{"start":29.42,"end":31.58,"text":"5月30日又进入想人生数10年"},{"start":31.58,"end":32.659,"text":"父母也是如此"},{"start":32.659,"end":33.92,"text":"尤其自己要出去读书了"},{"start":33.92,"end":35.12,"text":"和父母在一起时间会变"},{"start":35.12,"end":39.74,"text":"少那次考试那天那次考试全全充斥着一种不可控的控方"},{"start":39.74,"end":42.26,"text":"这里的原因当时分析怕时间流逝"},{"start":42.26,"end":43.52,"text":"本质是怕老怕死"},{"start":43.52,"end":44.84,"text":"27日当晚我去搜了"},{"start":44.84,"end":46.1,"text":"害怕时间过得快怎么办"},{"start":46.1,"end":48.26,"text":"拿20多做一些事充实自自己"},{"start":48.26,"end":50.03,"text":"后来去找学校的心理咨询"},{"start":50.03,"end":51.44,"text":"他说人都会死"},{"start":51.44,"end":52.459,"text":"但人"},{"start":54.24,"end":56.54,"text":"不能总想着以后要感受当下"},{"start":56.54,"end":58.41,"text":"对于父母呃"},{"start":58.41,"end":60.18,"text":"他说我终究要融入社会中"},{"start":60.18,"end":61.5,"text":"需要和同龄人去社交"},{"start":61.5,"end":65.12,"text":"而不依赖父母在物质和精神上的庇护啊"},{"start":65.12,"end":67.1,"text":"这个3号那天有个语文作文"},{"start":67.1,"end":67.7,"text":"看图写作"},{"start":67.7,"end":68.9,"text":"一个人把被子盖横了"},{"start":68.9,"end":70.04,"text":"说还以为自己长大了"},{"start":70.04,"end":70.88,"text":"我借题发挥"},{"start":70.88,"end":73.53,"text":"写小孩总以为自己长大了才会受到外界伤害"},{"start":73.53,"end":74.43,"text":"其实根本没有长大"},{"start":74.43,"end":75.64,"text":"是时间不早"},{"start":75.64,"end":80.38,"text":"不断拿走了b庇护念币啊"},{"start":80.38,"end":80.98,"text":"复b啊"},{"start":80.98,"end":86.04,"text":"如父母健康等一丝不挂失也就岌岌可危了"},{"start":86.04,"end":87.2,"text":"6月5号"},{"start":91.18,"end":93.22,"text":"他说我是平时埋在角落的人"},{"start":93.22,"end":95.02,"text":"在大学要多和人接触"},{"start":95.02,"end":96.05,"text":"争取机会"},{"start":96.05,"end":98.2,"text":"也是这次谈话后"},{"start":98.2,"end":101.8,"text":"我对我从对时间的恐慌转到了对人生意义的思考"},{"start":101.8,"end":102.76,"text":"一下是当前的问题"},{"start":102.76,"end":103.42,"text":"既然人死后"},{"start":103.42,"end":104.38,"text":"主观上什么都没有了"},{"start":104.38,"end":106.179,"text":"人活一生的目的是什么"},{"start":106.3,"end":110.38,"text":"过去我相信人的价值在于对社会做出的贡献"},{"start":110.38,"end":112.259,"text":"这个人真的是我的观众吗"},{"start":113.46,"end":115.36,"text":"你明显不是我的观众啊"},{"start":124.54,"end":126.0,"text":"什么人的价值"},{"start":126.0,"end":127.92,"text":"但高41年改变一些想法"},{"start":127.92,"end":129.84,"text":"高考制度很可能培养出比较自私的人"},{"start":129.84,"end":131.58,"text":"为了自己过得相对好"},{"start":133.74,"end":137.329,"text":"我接受的这一价值观与初中政治课建立的体系是相反的"},{"start":137.329,"end":138.949,"text":"所以那几天我一直很迷茫"},{"start":138.949,"end":140.509,"text":"人活一生到底为了什么"},{"start":140.509,"end":142.129,"text":"死亡后主观上一切不可感知"},{"start":142.129,"end":143.509,"text":"生前对社会的贡献"},{"start":143.509,"end":144.97,"text":"对自己有多大影响"},{"start":144.97,"end":147.97,"text":"嗯在之前我有我是有一些理想的"},{"start":147.97,"end":149.17,"text":"比如高中时"},{"start":149.17,"end":152.86,"text":"我自认为左常与人进行关联的交流和传递"},{"start":153.48,"end":156.26,"text":"也对航天感过兴趣"},{"start":156.26,"end":157.52,"text":"那是看了很多相关的书"},{"start":157.52,"end":159.7,"text":"并且是为了接鉴于幻想的目的"},{"start":159.7,"end":161.2,"text":"自己搞点能上天的东西"},{"start":161.2,"end":162.52,"text":"那是也特别有正义感"},{"start":162.52,"end":164.08,"text":"常在网上和神棍等争论"},{"start":164.08,"end":166.45,"text":"不过5月27号七日后"},{"start":166.45,"end":167.95,"text":"这些想法都基本消失了"},{"start":167.95,"end":171.19,"text":"后来自己分析这些理想都是想成为别人眼中厉害的人"},{"start":171.19,"end":171.91,"text":"乃至人上人"},{"start":171.91,"end":173.05,"text":"不过认清实践困难后"},{"start":173.05,"end":174.21,"text":"这些理想就破灭了"},{"start":174.21,"end":176.43,"text":"高考后在网上看到的虚无主义的概念"},{"start":176.43,"end":177.93,"text":"就像抓到救命稻草一样"},{"start":179.49,"end":181.64,"text":"现在可能现在看可能走错了方向"},{"start":181.64,"end":182.78,"text":"我不是认为没有意义"},{"start":182.78,"end":184.37,"text":"而是不知道什么有意义"},{"start":184.37,"end":185.99,"text":"那时我想到一件事"},{"start":185.99,"end":188.87,"text":"所有东西都要用时间换钱或快乐都是"},{"start":188.87,"end":189.95,"text":"所以我不知道这有限的"},{"start":189.95,"end":191.21,"text":"时间要拿来换什么"},{"start":191.21,"end":193.79,"text":"像在网上看到什么什么多少小时学会什么"},{"start":193.79,"end":196.35,"text":"多少用一生做出成熟的科研成果"},{"start":196.35,"end":197.25,"text":"都会有些焦虑感"},{"start":197.25,"end":199.83,"text":"我不知道拿时间换这些是否值得"},{"start":199.83,"end":200.43,"text":"另一方面"},{"start":200.43,"end":201.75,"text":"当下社会选择太多"},{"start":201.75,"end":203.21,"text":"又不可能全走一遍"},{"start":203.21,"end":204.83,"text":"年轻时间就这么多"},{"start":204.83,"end":207.74,"text":"我想有我想走最好的那条路"},{"start":207.74,"end":209.54,"text":"却不知哪条是最好的"},{"start":209.54,"end":213.05,"text":"暑假常在网上看到一些人一起怀念18岁的夏天"},{"start":213.05,"end":214.43,"text":"有时我刚过去的阶段"},{"start":214.43,"end":216.71,"text":"这样的共鸣很容易把我带进消极情绪里去"},{"start":216.71,"end":220.46,"text":"高考前到现在存在着大概15天一次的周期"},{"start":220.46,"end":223.77,"text":"每段每隔段时间就要感怀啊"},{"start":223.77,"end":225.93,"text":"就感怀伤时第二天就怕父"},{"start":225.93,"end":228.09,"text":"母变老第三天就迷茫无以这样一个状态"},{"start":228.09,"end":229.05,"text":"以下是问题总结"},{"start":229.05,"end":230.7,"text":"一对时间的不可挽回"},{"start":230.7,"end":231.48,"text":"不可控的焦虑"},{"start":231.48,"end":235.46,"text":"二对人生意义的寻找和追求"},{"start":235.46,"end":237.76,"text":"这两个问题我知道答案"},{"start":237.76,"end":239.14,"text":"然后你要理解的话"},{"start":239.14,"end":244.3,"text":"你可以在我的视频里面搜死亡和时间这两个关键"},{"start":244.3,"end":247.52,"text":"自己把这些都看了呃"},{"start":247.52,"end":251.0,"text":"首先你是个科学实在论证你对实践理解非常庸俗"},{"start":251.0,"end":252.05,"text":"愚蠢无知"},{"start":252.05,"end":253.66,"text":"呆滞哀班"},{"start":254.6,"end":25