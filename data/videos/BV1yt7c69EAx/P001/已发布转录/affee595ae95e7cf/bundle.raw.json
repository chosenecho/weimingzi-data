"end":439.37,"text":"公共的道义"},{"start":440.37,"end":442.43,"text":"那么从物质层面"},{"start":442.43,"end":443.57,"text":"现实层面"},{"start":443.57,"end":445.53,"text":"那讲究的是这个利益"},{"start":445.53,"end":446.71,"text":"共同利益"},{"start":446.71,"end":447.41,"text":"长远利益"},{"start":448.77,"end":457.04,"text":"所以这个赛制鼓励的是两方的选手"},{"start":457.04,"end":461.03,"text":"具有在抽签抽到的那个"},{"start":461.03,"end":463.27,"text":"但是说为什么你抽签抽到这个"},{"start":463.27,"end":465.44,"text":"你就要去追求这种结果呢"},{"start":465.44,"end":468.039,"text":"那说明是有更高一级的政治机关"},{"start":468.039,"end":471.339,"text":"更高一级的政治意志告诉他"},{"start":471.339,"end":474.839,"text":"现在在这个局部达成这样的利益的"},{"start":474.839,"end":475.8,"text":"军事"},{"start":475.8,"end":478.08,"text":"达成这样的意见的均衡"},{"start":478.08,"end":482.829,"text":"是对于长远利益是有帮助的啊"},{"start":482.829,"end":485.469,"text":"这个不是说要鼓励人们去操纵司法"},{"start":485.469,"end":488.589,"text":"或者鼓励人们去这个三寸不烂之舌"},{"start":488.589,"end":490.92,"text":"想要把结果弄得怎样就怎样"},{"start":490.92,"end":493.689,"text":"不是这样的嗯"},{"start":493.689,"end":495.869,"text":"所以我认为这是一种政治能力"},{"start":495.869,"end":497.189,"text":"这是一种政治理念"},{"start":497.189,"end":499.18,"text":"政治高于法律"},{"start":499.18,"end":500.58,"text":"人们的共识"},{"start":500.58,"end":504.3,"text":"甚至说临时性的共识和一个地区"},{"start":504.3,"end":507.94,"text":"一个局部的长远利益和一个更整体的利益"},{"start":507.94,"end":512.08,"text":"是高于单纯在法条层面"},{"start":512.08,"end":515.61,"text":"单纯单纯在一个哎呀"},{"start":515.61,"end":519.09,"text":"逻辑化的一个文本层面的那些关联的"},{"start":519.09,"end":523.539,"text":"因为前者意味着他是现实深重的现实"},{"start":524.019,"end":528.66,"text":"所以我们始终是这个过程想要去锻炼的"},{"start":528.66,"end":532.0,"text":"不仅仅是参与者的这个法律能力啊"},{"start":532.0,"end":533.26,"text":"法律意识"},{"start":535.43,"end":538.33,"text":"还有就是说道德民粹化鼓动的能力"},{"start":538.33,"end":540.39,"text":"我不希望去培养这种能力"},{"start":540.39,"end":543.27,"text":"我们希望培养的是这些参与者"},{"start":543.27,"end":544.81,"text":"积极积极参与的人士"},{"start":544.81,"end":547.16,"text":"他们的政治能力"},{"start":547.16,"end":552.43,"text":"他们去引导利益达成共识的能力"},{"start":552.43,"end":554.27,"text":"在危急状况之下"},{"start":554.27,"end":557.59,"text":"这种这种能力决定你能不能把杆子拉起来"},{"start":557.92,"end":559.58,"text":"没有缺失这种能力的话"},{"start":559.58,"end":562.5,"text":"你搞得民粹化的那种杆子是没有用的"},{"start":563.92,"end":564.8,"text":"没有任何意义"},{"start":564.8,"end":566.4,"text":"你收收不了"},{"start":566.52,"end":569.58,"text":"重要的是达成一致性的利益啊"},{"start":569.58,"end":571.0,"text":"然后不停的生成共识"},{"start":571.0,"end":572.2,"text":"去引导啊"},{"start":572.2,"end":574.1,"text":"去引导驾驭这个队伍"},{"start":574.46,"end":576.62,"text":"所以我们需要我们的人具有这样的能力"},{"start":576.62,"end":580.6,"text":"这样的能力可能在很多呃社运观察人士眼中"},{"start":580.6,"end":582.46,"text":"卧槽太保守了"},{"start":582.46,"end":584.1,"text":"太温和了"},{"start":584.1,"end":586.31,"text":"但是在我眼中"},{"start":586.31,"end":589.37,"text":"这是核心能力啊"},{"start":589.37,"end":591.39,"text":"这是这是某种核心能力"},{"start":591.39,"end":594.75,"text":"是能够形成形成合力"},{"start":594.75,"end":600.71,"text":"形成一种不那么轻易的就会被打成是什么"},{"start":600.71,"end":603.05,"text":"类似什么义和团什么这种东西"},{"start":603.05,"end":604.57,"text":"太平天国这种东西"},{"start":604.57,"end":608.18,"text":"不那么轻易的就被打成一种反智主义民粹"},{"start":608.18,"end":611.82,"text":"而能够在危机的这个垮塌之下"},{"start":611.82,"end":613.04,"text":"能作为一个堡垒"},{"start":613.04,"end":615.82,"text":"一个节点幸存下来啊"},{"start":615.82,"end":621.31,"text":"那么这就是说能够在有自己的政治意识的明确"},{"start":621.31,"end":622.67,"text":"目的目标"},{"start":622.67,"end":625.02,"text":"对于这个局局势的发展"},{"start":625.02,"end":626.58,"text":"对于这个利益的分配"},{"start":626.58,"end":630.56,"text":"利益格局的调整有自己明确清晰的意志"},{"start":630.56,"end":634.57,"text":"我要把他引导到哪一种局面"},{"start":634.57,"end":636.07,"text":"然后再去思考"},{"start":636.07,"end":638.97,"text":"那因此我要去出具哪些理由"},{"start":638.97,"end":642.149,"text":"我要去侧侧重去强调哪些价值"},{"start":643.149,"end":645.729,"text":"哪部分的这个共情的点"},{"start":645.729,"end":647.839,"text":"我要去主主导的去打"},{"start":647.839,"end":648.339,"text":"哎"},{"start":648.339,"end":652.369,"text":"我要去引导那些没有这个法律和政治的"},{"start":652.369,"end":655.609,"text":"这个特别深厚素养的那些陪审团"},{"start":655.609,"end":659.82,"text":"当然法官模拟法官本身他是职业"},{"start":659.82,"end":663.2,"text":"对于我们来讲是职业职业认可的职业玩家啊"},{"start":663.2,"end":664.24,"text":"职业玩家"},{"start":664.24,"end":667.12,"text":"但是呢他只有一票啊"},{"start":667.12,"end":669.74,"text":"另外那四个人四个这个老百姓啊"},{"start":669.74,"end":670.5,"text":"他们有四票"},{"start":671.5,"end":676.46,"text":"所以就是希望这个这个辩论赛啊"},{"start":676.46,"end":680.04,"text":"能够有效地培养参与者的政治能力"},{"start":680.04,"end":681.12,"text":"现实的政治能力"},{"start":681.12,"end":682.359,"text":"现实的去"},{"start":682.359,"end":683.859,"text":"我不用再重复了吧"},{"start":683.859,"end":686.139,"text":"现实的去把利益格局"},{"start":686.139,"end":688.239,"text":"按照他的政治预期"},{"start":688.239,"end":693.02,"text":"按照他的团体的长远利益啊"},{"start":693.02,"end":695.82,"text":"他的政治目的去引导"},{"start":695.82,"end":697.18,"text":"去达成共识"},{"start":697.18,"end":699.9,"text":"去说服啊"},{"start":699.9,"end":701.2,"text":"去做攻防"},{"start":702.44,"end":703.7,"text":"这是非常重要的"},{"start":703.7,"end":705.0,"text":"这是非常非常重要的"},{"start":705.0,"end":706.68,"text":"我甚至说"},{"start":707.58,"end":710.58,"text":"我甚至非常不客气地说一句"},{"start":715.9,"end":718.7,"text":"如果你们能不能够达成我"},{"start":718.7,"end":722.18,"text":"我我这个活动所要训练的那种基本素养的话"},{"start":724.9,"end":726.31,"text":"都是谁嘛"},{"start":726.51,"end":728.85,"text":"你们自己去掰着手指头去数吧"},{"start":728.85,"end":732.15,"text":"主要的rose who being in是吧"},{"start":732.15,"end":733.41,"text":"Depressed zr"},{"start":734.319,"end":736.679,"text":"都都都知道是干哪个职业的吧"},{"start":736.679,"end":741.11,"text":"至少他们脑袋里面都形成了一个有效的鼓动"},{"start":741.11,"end":741.99,"text":"揭露"},{"start":741.99,"end":743.65,"text":"有效的引导"},{"start":743.65,"end":745.11,"text":"凝聚共识的能力"},{"start":745.11,"end":747.25,"text":"基本能力这个能力"},{"start":747.25,"end":749.47,"text":"那些互联网上叫嚣的最狠的那些反贼"},{"start":749.47,"end":750.86,"text":"没有这个能力"},{"start":751.1,"end":756.01,"text":"他们没有办法把政治共识和切身和长远的利益"},{"start":756.01,"end":756.57,"text":"结合起来"},{"start":756.57,"end":758.17,"text":"和利益结构结合起来"},{"start":758.17,"end":760.37,"text":"他们的话语没有穿透性"},{"start":760.37,"end":763.85,"text":"除去那些非常浮躁的那个民粹化的情感之外"},{"start":763.85,"end":766.11,"text":"他们的话语没有站得住的"},{"start":766.11,"end":768.17,"text":"没有堡垒化解点化"},{"start":768.17,"end":771.28,"text":"没有阵地化的能力啊"},{"start":777.68,"end":780.16,"text":"有人说政治人口哪会在网上口嗨"},{"start":780.16,"end":782.719,"text":"这那我们做的就是一种尝试"},{"start":782.719,"end":784.879,"text":"我们希望能够让平民"},{"start":784.879,"end":789.24,"text":"普通人获得渐次获得这样的能力"},{"start":789.24,"end":793.79,"text":"渐次获得这样去思考权衡均衡"},{"start":794.19,"end":797.91,"text":"还要去引导凝聚共识啊"},{"start":797.91,"end":801.31,"text":"引导利益的能力"},{"start":802.32,"end":805.68,"text":"我甚至觉得我所做的努力不是政治性的"},{"start":805.68,"end":806.88,"text":"而是教育性的"},{"start":806.88,"end":811.59,"text":"我一直在这个国度感到比较痛苦的点"},{"start":811.59,"end":812.33,"text":"就在于"},{"start":812.33,"end":816.84,"text":"我就是比较就是哪怕对于我的支持者和关注者"},{"start":816.84,"end":819.46,"text":"都希望他们我以一个启蒙者的姿态"},{"start":819.46,"end":820.98,"text":"都希望他们和我一样"},{"start":820.98,"end":824.7,"text":"普遍的拥有某种啊政治动员的能力"},{"start":825.02,"end":829.38,"text":"有某种这个这个共识凝聚汇聚啊"},{"start":829.38,"end":834.39,"text":"还有这个某种这个制度架设和命"},{"start":834.39,"end":836.47,"text":"命令灌输的能力"},{"start":843.36,"end":845.12,"text":"但是这个时代特有的嘛"},{"start":845.12,"end":847.4,"text":"这个时代特有的这种东西的"},{"start":847.4,"end":848.52,"text":"一般是在学院里面"},{"start":848.52,"end":850.27,"text":"法学院里面去教授的"},{"start":850.27,"end":853.819,"text":"法学院和政治学院里面就会教这些东西"},{"start":853.819,"end":855.419,"text":"对于老百姓来讲的话"},{"start":855.419,"end":856.919,"text":"这东西向来是奢侈品"},{"start":856.919,"end":861.73,"text":"向来是就是非常稀缺鲜鲜有的一种啊"},{"start":861.73,"end":865.53,"text":"一种一种教育产品"},{"start":871.46,"end":873.06,"text":"但这种努力我们不会停止"},{"start":873.06,"end":875.12,"text":"因为这是最基本的政治素养"},{"start":875.12,"end":877.81,"text":"我们不会停止这这些努力啊"},{"start":877.81,"end":880.83,"text":"然后我们对于这个互联网上那些非常梦浪的"},{"start":880.83,"end":882.89,"text":"浮躁的那些叫嚣啊"},{"start":882.89,"end":884.65,"text":"那弄潮的那些东西"},{"start":884.65,"end":886.66,"text":"我也提不起什么兴趣"},{"start":886.66,"end":888.14,"text":"反正就是这个赛制啊"},{"start":888.14,"end":888.78,"text":"这个赛制的话"},