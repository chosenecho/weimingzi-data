{"segments":[{"start":0.82,"end":7.38,"text":"一个就是说这个啊叫工人前途啊"},{"start":9.82,"end":10.82,"text":"那个辩论赛啊"},{"start":10.82,"end":14.08,"text":"他以法律法庭辩论的形式呈现"},{"start":14.08,"end":15.8,"text":"模拟法庭的形式呈现"},{"start":15.8,"end":18.78,"text":"那么我要强调的讲一下"},{"start":18.78,"end":20.7,"text":"就是他的赛制"},{"start":21.399,"end":23.299,"text":"赛制的话不是一阶的"},{"start":23.299,"end":24.919,"text":"就是不是你扮演哪一方"},{"start":24.919,"end":27.98,"text":"然后把你把另一方打败了呃"},{"start":27.98,"end":30.44,"text":"让这个法官和这个陪审团"},{"start":30.44,"end":36.01,"text":"模拟法官和模拟陪审团都支持你的诉求"},{"start":36.29,"end":37.09,"text":"这个就赢"},{"start":37.09,"end":39.27,"text":"不是的啊"},{"start":39.27,"end":42.13,"text":"我们并不是说通过这个比赛"},{"start":42.13,"end":47.01,"text":"要要筛选或者锻炼的是人的呃"},{"start":47.01,"end":51.599,"text":"单纯的这个法条主义啊"},{"start":51.599,"end":55.019,"text":"啊或者说这种专业主义的这种能力啊"},{"start":55.019,"end":59.38,"text":"或者说就是也不是说扮演道德民粹的啊"},{"start":59.38,"end":61.06,"text":"政治民粹的这种能力"},{"start":61.06,"end":62.64,"text":"否则你选到牢方"},{"start":62.64,"end":64.669,"text":"你煽动一下民粹"},{"start":64.669,"end":68.629,"text":"现场有很多人就判你赢了呃"},{"start":68.629,"end":73.38,"text":"我们采取的赛制是这样的呃"},{"start":73.38,"end":75.66,"text":"每一场比赛啊"},{"start":75.66,"end":77.92,"text":"每一次这个庭审啊"},{"start":77.92,"end":79.58,"text":"这个"},{"start":80.84,"end":84.58,"text":"额那么就以这个原告是劳方"},{"start":84.58,"end":85.88,"text":"被告是资方啊"},{"start":85.88,"end":86.94,"text":"大概都是这样啊"},{"start":86.94,"end":89.31,"text":"有一半以上都是这样的案子"},{"start":92.8,"end":96.46,"text":"但是参赛的两方并不一定是"},{"start":96.46,"end":98.68,"text":"就是说一定是哪一方是原告"},{"start":98.68,"end":100.79,"text":"哪一方是被告啊"},{"start":100.79,"end":101.77,"text":"参赛两方的话"},{"start":101.77,"end":102.69,"text":"我们是这样设定的"},{"start":102.69,"end":103.77,"text":"一方是攻方"},{"start":103.77,"end":105.77,"text":"一方是守方"},{"start":106.49,"end":108.87,"text":"那么攻方会在比赛开始的时候"},{"start":108.87,"end":109.93,"text":"比赛之前啊"},{"start":109.93,"end":112.31,"text":"先去抽抽签"},{"start":112.31,"end":113.74,"text":"抽什么签呢"},{"start":113.74,"end":116.78,"text":"抽的就是说这个案子最后判出来的"},{"start":116.78,"end":119.06,"text":"那个结果会是怎样"},{"start":119.3,"end":122.34,"text":"这个案子最后判出来的结果会有三三"},{"start":122.34,"end":123.96,"text":"三种或者四种啊"},{"start":123.96,"end":125.56,"text":"三档或者四档"},{"start":125.56,"end":130.8,"text":"那么就是最倾向于劳方的原告的"},{"start":130.8,"end":132.96,"text":"或者最倾向于被告的两种"},{"start":132.96,"end":135.57,"text":"然后中间状况一种或者两种"},{"start":135.57,"end":139.77,"text":"那么一开始就是ABCD或者ABC3种啊"},{"start":139.77,"end":141.77,"text":"我们就以ABC3种情况吧"},{"start":141.77,"end":144.29,"text":"那你一开始是攻方去抽签"},{"start":144.29,"end":145.33,"text":"攻方抽签"},{"start":145.33,"end":148.93,"text":"如果抽到的是呃A或者B或者C"},{"start":148.93,"end":153.009,"text":"请向劳方中立或者倾向这个资方"},{"start":153.009,"end":155.649,"text":"那么攻方要做的事情"},{"start":155.649,"end":159.58,"text":"就是去争取陪审团和这个法官"},{"start":159.58,"end":163.22,"text":"模拟陪审团和模拟法官怎样"},{"start":164.54,"end":168.21,"text":"最后的裁定是比如说你抽到的是B"},{"start":168.21,"end":171.73,"text":"就两边和稀泥啊中立的一个结果"},{"start":171.73,"end":174.29,"text":"那要争取这个案子打下来"},{"start":174.29,"end":177.019,"text":"就是一个中立的结果啊"},{"start":177.019,"end":179.619,"text":"而不是说一定是你扮演哪一方要赢"},{"start":179.619,"end":181.639,"text":"或者扮演另一方要赢"},{"start":182.04,"end":182.92,"text":"你赢的"},{"start":182.92,"end":185.46,"text":"你在这场比赛当中能够得分"},{"start":185.46,"end":189.829,"text":"是取决于你抽签抽中的那个"},{"start":189.829,"end":191.509,"text":"最后裁定的那个结果"},{"start":191.509,"end":194.529,"text":"你能不能通过你在这整个比赛过程当中"},{"start":194.529,"end":195.909,"text":"模拟的庭审过程当中"},{"start":195.909,"end":197.84,"text":"通过你的言辞"},{"start":197.84,"end":199.95,"text":"通过你的论理啊"},{"start":199.95,"end":204.55,"text":"通过你的这个情感和这个逻辑的啊啊"},{"start":204.55,"end":206.13,"text":"形成的这个说服力"},{"start":206.13,"end":210.55,"text":"能够让别人让最后的裁决者啊"},{"start":210.55,"end":212.15,"text":"得出你想要的那个结果"},{"start":213.19,"end":215.03,"text":"那如果能够得出这个相应的结果"},{"start":215.03,"end":216.39,"text":"那么就攻方得分"},{"start":216.39,"end":217.91,"text":"如果啊"},{"start":217.91,"end":220.91,"text":"那么相应的这个守方呢就是另外一支队伍呢"},{"start":220.91,"end":224.7,"text":"他的主要要做的就是破坏啊"},{"start":224.7,"end":229.54,"text":"或者说不让你达成你想要达成的那个模式"},{"start":229.86,"end":232.1,"text":"那么这些是"},{"start":233.38,"end":235.66,"text":"啊如果他守方是成功的"},{"start":235.66,"end":236.46,"text":"守住了"},{"start":236.46,"end":241.9,"text":"没有让这个攻方获得他想要的那个庭审结果"},{"start":241.9,"end":243.68,"text":"那么首方得分"},{"start":243.68,"end":247.26,"text":"然后有一个比较呃特别的一种情况"},{"start":247.26,"end":251.889,"text":"就是如果攻方抽中的是最后的审判结果"},{"start":251.889,"end":252.969,"text":"是偏向牢房的"},{"start":252.969,"end":255.31,"text":"最偏向牢牢房的啊"},{"start":255.31,"end":256.75,"text":"最偏向原告的"},{"start":256.75,"end":258.75,"text":"那么在这种情况之下"},{"start":258.75,"end":264.6,"text":"攻方只能扮演只能扮演资方"},{"start":264.6,"end":266.16,"text":"攻方只能扮演次方"},{"start":266.16,"end":267.3,"text":"只能扮演被告"},{"start":267.3,"end":268.64,"text":"否则的话太容易了"},{"start":268.64,"end":269.34,"text":"你明白吗"},{"start":269.34,"end":271.14,"text":"否则的话这个东西你直接上去"},{"start":271.14,"end":273.88,"text":"就是我们不不想鼓励道德民粹"},{"start":273.88,"end":276.14,"text":"我们不想鼓励你作为攻方"},{"start":276.14,"end":278.72,"text":"去作为劳方的代理律师"},{"start":282.08,"end":283.76,"text":"然后去鼓噪政治民粹"},{"start":283.76,"end":284.84,"text":"鼓噪道德民粹"},{"start":284.84,"end":286.24,"text":"这不是我们想看见的"},{"start":286.24,"end":287.68,"text":"但我们想看见的是什么呢"},{"start":287.68,"end":290.989,"text":"我们想看见的是一种啊政治能力"},{"start":290.989,"end":294.489,"text":"这种政治能力是你扮演资方的律师"},{"start":294.489,"end":296.569,"text":"扮演被告的律师啊"},{"start":296.569,"end":298.069,"text":"扮演被告的辩护人"},{"start":298.069,"end":303.3,"text":"但是呢你能够对不对"},{"start":303.3,"end":305.22,"text":"你能够恰如其分啊"},{"start":305.22,"end":307.3,"text":"能够恰如其分的就是做二五仔了"},{"start":307.3,"end":310.02,"text":"能够背叛你的这个也不要背叛"},{"start":310.02,"end":314.23,"text":"就是以某种形式啊呈现出"},{"start":315.17,"end":317.11,"text":"但是这不能过于荒谬"},{"start":317.11,"end":320.31,"text":"如果你呈现出来的那个啊"},{"start":320.31,"end":323.67,"text":"资方代理人的那种嘴脸就不直球"},{"start":323.67,"end":327.07,"text":"就是卖你的这个这个客户的"},{"start":327.07,"end":328.91,"text":"那么这种情况之下"},{"start":328.