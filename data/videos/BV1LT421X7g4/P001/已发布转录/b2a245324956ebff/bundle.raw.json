{"segments":[{"start":0.0,"end":2.22,"text":"现在认识认为现在成熟是什么"},{"start":2.22,"end":4.08,"text":"现在成熟"},{"start":8.9,"end":10.78,"text":"哎呀"},{"start":15.5,"end":16.78,"text":"我觉得现在成熟"},{"start":16.78,"end":19.57,"text":"就是适应大规模科层制里面的人事斗争"},{"start":19.57,"end":21.259,"text":"这就是成熟"},{"start":21.539,"end":23.419,"text":"我说你非要跟我说成熟是啥"},{"start":23.419,"end":25.879,"text":"我觉得是大规模的科层制当中的人事斗争"},{"start":27.019,"end":28.39,"text":"那个适应"},{"start":28.39,"end":33.49,"text":"然后也能够分析判断它的发展脉络情况"},{"start":33.49,"end":34.69,"text":"大概是成熟"},{"start":34.69,"end":37.269,"text":"但是可能熟的有点过熟了"},{"start":37.489,"end":39.67,"text":"说的有点快烂了那种"},{"start":39.67,"end":42.82,"text":"那我说这个刚刚好才成熟"},{"start":42.82,"end":47.23,"text":"相当于自己能够构造小规模的科层制体系"},{"start":47.23,"end":48.925,"text":"算成熟"},{"start":49.65,"end":50.39,"text":"现在陈述"},{"start":50.39,"end":53.87,"text":"就是自己能够构造小规模的科层制的体系"},{"start":53.87,"end":55.37,"text":"并且能让他活着"},{"start":55.37,"end":58.29,"text":"有钱有社会关系"},{"start":58.29,"end":62.63,"text":"网络有那个发展方向"},{"start":62.63,"end":64.67,"text":"有合法活动空间"},{"start":64.67,"end":66.94,"text":"这就是活着"},{"start":67.28,"end":71.0,"text":"OK我觉得这就是我判断成熟"},{"start":71.0,"end":72.32,"text":"就这最简单"},{"start":72.32,"end":74.06,"text":"就是说你三五个人能开个淘宝店"},{"start":74.06,"end":75.32,"text":"然后他能运行的比较好"},{"start":75.32,"end":76.13,"text":"然后有单"},{"start":76.13,"end":78.24,"text":"这就是成熟的"},{"start":78.7,"end":81.9,"text":"十几20个人搞一个什么什么小工坊啊"},{"start":81.9,"end":83.46,"text":"我现在就是干这个的"},{"start":84.57,"end":88.8,"text":"小规模的科层制的一个小的社会单元"},{"start":88.8,"end":90.92,"text":"能够运行它"},{"start":91.14,"end":92.87,"text":"我觉得这就成熟了"},{"start":92.87,"end":95.06,"text":"但有的人是通过结婚生子"},{"start":95.06,"end":96.68,"text":"组建家庭来实现瑞典"},{"start":96.68,"end":98.88,"text":"那有的是通过其他方式"},{"start":98.88,"end":99.84,"text":"简单一点"},{"start":99.84,"end":102.6,"text":"就是说我真的有一头牛的那个牛"},{"start":102.6,"end":105.0,"text":"你能弄个小牛犊出来就差不多了"},{"start":105.0,"end":106.08,"text":"算成熟了"}],"source":"subtitle"}
