      "text": "现实的运行的这个小周点"
    },
    {
      "ordinal": 300,
      "start_ms": 959719,
      "end_ms": 961360,
      "text": "这个小周天是打通了"
    },
    {
      "ordinal": 301,
      "start_ms": 961360,
