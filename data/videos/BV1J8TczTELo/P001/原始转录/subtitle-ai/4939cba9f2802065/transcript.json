    {
      "ordinal": 292,
      "start_ms": 938550,
      "end_ms": 940450,
      "text": "还出元阴"
    },
    {
      "ordinal": 293,
      "start_ms": 940450,
      "end_ms": 944100,
      "text": "这个都是我们将来要去用呃"
    },
    {
      "ordinal": 294,
      "start_ms": 944100,
      "end_ms": 947360,
      "text": "用其他的隐喻去去讲个点听的啊"
    },
    {
      "ordinal": 295,
      "start_ms": 947360,
      "end_ms": 949220,
      "text": "whatever反正你们就知道"
    },
    {
      "ordinal": 296,
      "start_ms": 949220,
      "end_ms": 953670,
      "text": "反正就是说就是如果没有大周哦"
    },
    {
      "ordinal": 297,
      "start_ms": 953670,
      "end_ms": 954990,
      "text": "如果没有小周天"
    },
    {
      "ordinal": 298,
      "start_ms": 954990,
      "end_ms": 958259,
      "text": "如果你连这个组织自动运行的"
    },
    {
      "ordinal": 299,
      "start_ms": 958259,
