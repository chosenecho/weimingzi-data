{"segments":[{"start":1.24,"end":3.28,"text":"所以一个河南大学生要毕业了"},{"start":3.28,"end":5.6,"text":"要告别学生身份"},{"start":6.58,"end":8.61,"text":"长期躺尸在校园"},{"start":8.61,"end":11.26,"text":"习惯这种没心没肺的生活"},{"start":11.459,"end":13.589,"text":"一旦进入社会不知所措"},{"start":13.589,"end":15.6,"text":"他的问题三部分啊"},{"start":15.759,"end":18.699,"text":"要求解一农村老家的问题"},{"start":18.699,"end":19.989,"text":"学生时代问题"},{"start":19.989,"end":23.2,"text":"还有在社会上实习的问题"},{"start":28.59,"end":31.08,"text":"有几亩地时间发展"},{"start":31.08,"end":33.0,"text":"家庭开销增加"},{"start":33.04,"end":34.0,"text":"父亲打工"},{"start":34.0,"end":37.27,"text":"母亲在照顾照顾他的弟弟啊"},{"start":37.27,"end":38.44,"text":"还有种地啊"},{"start":38.44,"end":39.519,"text":"打零工啊"},{"start":44.06,"end":46.07,"text":"要寻找耕地来埋葬"},{"start":46.07,"end":51.98,"text":"农村人去世后要寻找耕地埋葬这个少了一块地"},{"start":53.84,"end":55.419,"text":"所有风水先生"},{"start":62.57,"end":69.13,"text":"它地多这个这这种这种风水先生的字就浪费"},{"start":71.29,"end":75.83,"text":"利于那个两极分化的上端的浪费啊"},{"start":75.83,"end":77.09,"text":"有风水先生说"},{"start":77.09,"end":79.31,"text":"他村东的快递是风水宝地"},{"start":79.31,"end":81.4,"text":"长辈死后要葬在那里"},{"start":81.4,"end":83.2,"text":"某家的不是他自己家里的"},{"start":83.2,"end":85.0,"text":"另外一家的长辈死后葬在那里"},{"start":85.0,"end":85.78,"text":"问父母亲说"},{"start":85.78,"end":87.78,"text":"我同意被他拒绝了"},{"start":87.78,"end":89.88,"text":"这农民是一粒米为珍宝"},{"start":89.88,"end":90.93,"text":"何况一块地啊"},{"start":90.93,"end":94.659,"text":"后来家族长辈逼迫母亲同意"},{"start":94.659,"end":96.099,"text":"她哭着拒绝"},{"start":96.099,"end":99.159,"text":"无奈他那个四大咄咄逼人"},{"start":99.159,"end":100.2,"text":"只好同意"},{"start":100.44,"end":101.4,"text":"如果不同意"},{"start":101.4,"end":103.65,"text":"就是触犯了家族中的规则"},{"start":103.65,"end":104.82,"text":"难以立足"},{"start":104.82,"end":107.08,"text":"恐会群起而攻之"},{"start":107.08,"end":109.6,"text":"前线带那种标准的前线"},{"start":114.69,"end":117.69,"text":"这种东西呢只有大炮和无力可以解决"},{"start":117.69,"end":118.8,"text":"我老实跟你讲"},{"start":118.8,"end":121.29,"text":"当然说我们现在这个和平的时代了"},{"start":121.29,"end":124.63,"text":"和平的时代没有大炮和这个步枪"},{"start":130.699,"end":133.159,"text":"那个烈度如果真的是要下手的话"},{"start":133.159,"end":134.82,"text":"烈度也不会小的"},{"start":135.499,"end":137.259,"text":"家乡每年都有庙会"},{"start":137.259,"end":143.46,"text":"恰逢此时河道就我说这个东西它的经济看上去是个封建迷信啊"},{"start":143.46,"end":145.62,"text":"那实际上他的经济原因是这样的"},{"start":145.62,"end":150.049,"text":"是逼迫乡村的弱小群体就浪费"},{"start":150.049,"end":152.569,"text":"所有的浪费的核心就是相当于这个赌场"},{"start":152.569,"end":154.369,"text":"他这样的这一个赌场"},{"start":154.369,"end":158.78,"text":"要所有人把自己的筹码里面拿十块钱筹码把它毁掉"},{"start":158.78,"end":160.73,"text":"那对于那些本来只有20块钱的筹码"},{"start":160.73,"end":162.11,"text":"就毁掉了一半筹码"},{"start":162.11,"end":164.03,"text":"那对于那些有1万块钱筹码的"},{"start":164.03,"end":166.4,"text":"只是毁掉他微不足道的1‰"},{"start":166.4,"end":167.66,"text":"然后再赌"},{"start":167.7,"end":168.48,"text":"懂了吧"},{"start":168.48,"end":172.29,"text":"所有的浪费都是都是帮助那些既得利益的"},{"start":172.29,"end":174.06,"text":"帮助两极分化的上端的"},{"start":174.06,"end":175.72,"text":"它的优势被扩大"},{"start":177.7,"end":181.18,"text":"这个家族这种家族也是个标准的"},{"start":181.18,"end":183.46,"text":"我说在这个时代还搞家族"},{"start":184.84,"end":186.79,"text":"这个完全无视他的阶级差异"},{"start":186.79,"end":189.4,"text":"完全无视他的经济的现实实质性的差距"},{"start":189.4,"end":193.65,"text":"搞家族这个家族要就是红白喜事都要同等规模"},{"start":193.65,"end":195.5,"text":"一个规矩都要同样遵守"},{"start":195.679,"end":200.67,"text":"唉这种东西都是说利于利于厉害"},{"start":200.67,"end":203.79,"text":"这里这里这个博弈出清了"},{"start":203.79,"end":206.759,"text":"就弄清楚到底谁是胜利者"},{"start":206.759,"end":209.639,"text":"然后形成一个小的小的自然阶级群体"},{"start":209.639,"end":214.42,"text":"里面就会有一就是1000个人口里面可能三五个赢了"},{"start":225.02,"end":227.0,"text":"在这作为一整个市场主体"},{"start":230.9,"end":232.8,"text":"它就会出现这种东西啊"},{"start":233.58,"end":236.7,"text":"每家乡每年都有庙会"},{"start":237.779,"end":243.04,"text":"然后家乡旁的一个什么庙中的神明就会现身"},{"start":243.04,"end":249.68,"text":"命令某人目前用来这个庙头庙会的什么新办啊"},{"start":249.68,"end":250.49,"text":"就浪费啊"},{"start":250.49,"end":254.57,"text":"但是这些钱会跑进啊某些人的腰包啊"},{"start":254.57,"end":255.83,"text":"这里也是浪费啊"},{"start":255.83,"end":256.85,"text":"这种漏俗啊"},{"start":256.85,"end":260.99,"text":"就是快速的逼死一批较弱的人"},{"start":260.99,"end":262.37,"text":"快速的逼死他们"},{"start":262.37,"end":266.36,"text":"然后就是这个庙本来是在村里啊"},{"start":266.36,"end":268.88,"text":"后来有人说这个什么"},{"start":269.039,"end":271.379,"text":"谁觉得啊庙太破"},{"start":271.379,"end":273.78,"text":"就把他集资建造了河道旁"},{"start":274.54,"end":278.82,"text":"凡是有人去世都必须拜谒这个神奇啊"},{"start":278.82,"end":280.74,"text":"然后这个当新春来临"},{"start":280.74,"end":285.93,"text":"便有一些人合资从他乡邀请什么什么歌舞团来村里表演"},{"start":285.93,"end":287.43,"text":"在外面搭建舞台"},{"start":287.43,"end":288.69,"text":"无论男女都会去看"},{"start":288.69,"end":290.86,"text":"一旦到深夜"},{"start":291.5,"end":294.04,"text":"舞女就会赤身裸体登台"},{"start":294.04,"end":295.72,"text":"下面的人拍手叫好"},{"start":295.72,"end":297.88,"text":"儿童少年更是痴迷"},{"start":298.14,"end":301.77,"text":"然后那个舞女将大腿攀附在音响上"},{"start":301.77,"end":306.78,"text":"然后他的virgina就对着台下群众供他们欣赏"},{"start":306.979,"end":309.859,"text":"有些舞女甚至还没有发育"},{"start":309.859,"end":314.45,"text":"完全大约只有15岁左右的年龄啊"},{"start":314.45,"end":316.22,"text":"但是近年因为这个疫情"},{"start":316.22,"end":317.88,"text":"这种现象就再也没有了"},{"start":317.88,"end":320.22,"text":"哎你现在知道是个这个东西"},{"start":321.33,"end":325.47,"text":"这种东西都是由于他平时是一个性压抑的一个状态"},{"start":325.47,"end":329.48,"text":"还需要靠这种补充性的例外啊"},{"start":332.18,"end":335.27,"text":"他当当然他这个也包括这个"},{"start":335.27,"end":337.34,"text":"就是你压抑的越狠"},{"start":337.34,"end":344.3,"text":"他就要越一个就是一个隐匿的狂欢式的宣泄来做补充"},{"start":345.699,"end":350.099,"text":"然后后场的杨树林中有一口有一口枯井"},{"start":350.099,"end":353.68,"text":"在他小时候有一个玩伴失足掉进去摔死了"},{"start":353.9,"end":358.58,"text":"村中就竟然有人说是因为那个孩子触犯了神明"},{"start":358.58,"end":361.4,"text":"卧槽那口枯井至今仍在"},{"start":361.42,"end":364.419,"text":"我很害怕他总觉得里面有什么东西"},{"start":364.419,"end":364.959,"text":"呃"},{"start":364.959,"end":365.799,"text":"我问长辈"},{"start":365.799,"end":368.019,"text":"为什么不不把那个东西填起来"},{"start":368.019,"end":368.679,"text":"是个枯井"},{"start":368.679,"end":370.09,"text":"把它填好了就行了"},{"start":370.09,"end":371.95,"text":"长辈说那是龙的眼睛"},{"start":371.95,"end":373.03,"text":"甜掉会不吉利"},{"start":373.03,"end":374.68,"text":"龙的眼睛要吃小孩啊"},{"start":379.24,"end":379.78,"text":"我说了"},{"start":379.78,"end":382.32,"text":"这玩意儿只能用枪炮来解决"},{"start":383.1,"end":390.84,"text":"或者说就就如果说他依然保持着一个地方的这种问题"},{"start":391.72,"end":396.78,"text":"这种人口再生产和社会权力结构再生产的话"},{"start":396.78,"end":398.89,"text":"只能用枪炮来解决啊"},{"start":398.89,"end":401.8,"text":"那就是如果他被这个经济潮流"},{"start":401.8,"end":403.84,"text":"经济运行模式彻底淘汰的话"},{"start":403.84,"end":407.39,"text":"这些文化呢他会逐逐步消亡啊"},{"start":407.39,"end":408.41,"text":"逐步无害化"},{"start":408.41,"end":414.26,"text":"但是问题就是说这样的经济土壤的新的现代经济土壤的产生"},{"start":415.139,"end":416.659,"text":"他这个难道不是代价吗"},{"start":416.659,"end":418.189,"text":"难道不是代价吗"},{"start":418.189,"end":419.539,"text":"那不知道从何"},{"start":419.539,"end":423.34,"text":"他也有产会产生新的量量级分化"},{"start":423.34,"end":424.24,"text":"不知道从何时起"},{"start":424.24,"end":426.4,"text":"我对家乡的情感已经彻底带了"},{"start":426.4,"end":429.7,"text":"更多的是对小时候美好时光的怀念啊"},{"start":429.7,"end":431.6,"text":"可以在半夜里面看vga"},{"start":431.6,"end":433.88,"text":"但都已经物是人非了"},{"start":433.88,"end":435.2,"text":"有时候我会想"},{"start":435.2,"end":437.38,"text":"以后宁可流浪外地"},{"start":438.139,"end":439.359,"text":"也不回去安居了"},{"start":439.359,"end":442.479,"text":"现在唯一的留恋便是就是家里的长辈了"},{"start":442.479,"end":443.979,"text":"对于这样的故乡该如何呢"},{"start":443.979,"end":445.179,"text":"如果我永远的离开"},{"start":445.179,"end":445.359,"text":"那里"},{"start":445.359,"end":446.289,"text":"还有我的亲人"},{"start":446.289,"end":448.98,"text":"有我早早有我早已陌生的朋友"},{"start":448.98,"end":450.54,"text":"和我毫无关系的家族"},{"start":450.54,"end":451.74,"text":"但对于身处这样的环境"},{"start":451.74,"end":453.31,"text":"他们我又觉得悲哀"},{"start":453.31,"end":455.77,"text":"而他们这样长期已久"},{"start":455.77,"end":458.17,"text":"我的力量单薄又该如何做呢"},{"start":458.17,"end":459.91,"text":"我知道这一切需要改变"},{"start":459.91,"end":461.86,"text":"但如何改变呢"},{"start":461.86,"end":465.52,"text":"或者说对于我的长辈的老一辈人来说"},{"start":465.52,"end":466.78,"text":"使他们安于现状"},{"start":466.78,"end