{"segments":[{"start":0.1,"end":1.5,"text":"有一点得明说啊"},{"start":1.5,"end":4.56,"text":"就是说绝对不准贵啊"},{"start":4.56,"end":9.03,"text":"是字面意义上的下跪这件事情呢"},{"start":9.03,"end":11.57,"text":"呃可以有豁免啊"},{"start":11.57,"end":12.45,"text":"就是有豁免"},{"start":12.45,"end":15.97,"text":"就是说如果你是传统儒教家族"},{"start":15.97,"end":20.57,"text":"就是说由于是民族民民族传统嘛"},{"start":20.57,"end":23.45,"text":"就是说对于你的祖父母辈"},{"start":23.45,"end":26.13,"text":"如果有乡村有这样一种传统"},{"start":26.13,"end":29.51,"text":"为了那个维护你父母的颜面啊"},{"start":29.51,"end":32.83,"text":"比如说是农村的农村家庭出身的啊"},{"start":32.83,"end":34.53,"text":"什么爷爷奶奶死了啊"},{"start":34.53,"end":35.63,"text":"这个要跪啊"},{"start":35.63,"end":36.27,"text":"守灵堂"},{"start":36.27,"end":37.57,"text":"这是豁免的"},{"start":37.57,"end":42.74,"text":"还有那个就是但是这些你是不认的"},{"start":42.74,"end":47.28,"text":"就是我们坚持无神论的立场啊"},{"start":47.28,"end":48.6,"text":"然后呢"},{"start":50.499,"end":53.559,"text":"原则上不允许去佛寺"},{"start":53.559,"end":54.839,"text":"还有道观啊"},{"start":54.839,"end":56.419,"text":"还有其他地那些"},{"start":56.419,"end":60.64,"text":"就还有其他的宗教设施里面去呃祭拜"},{"start":60.64,"end":62.88,"text":"然后不允绝对不允许下跪啊"},{"start":62.88,"end":64.64,"text":"然后呢如果是宗祠啊"},{"start":64.64,"end":67.96,"text":"还有就是这个老人的那种坟呐"},{"start":67.96,"end":71.43,"text":"那这个是出于民俗习俗"},{"start":71.43,"end":74.89,"text":"就是直系亲属要求"},{"start":74.89,"end":76.26,"text":"那可以啊"},{"start":76.26,"end":77.36,"text":"知清楚这些父母啊"},{"start":77.36,"end":78.82,"text":"父母要求可以"},{"start":78.82,"end":80.44,"text":"但是不认这个东西的"},{"start":80.44,"end":83.27,"text":"也就是说这个东西呢等到你父母死的时候"},{"start":83.27,"end":86.55,"text":"你来主持这个白氏葬仪啊"},{"start":86.55,"end":89.53,"text":"要尽可能的要去除跪拜礼啊"},{"start":89.53,"end":91.49,"text":"要鞠躬就行了"},{"start":91.49,"end":92.69,"text":"绝对不准跪"},{"start":94.01,"end":97.89,"text":"给爹娘跪也是啊"},{"start":99.45,"end":104.28,"text":"婚礼婚仪上面可以就是就是汉族传统吧"},{"start":104.28,"end":105.3,"text":"要敬茶礼"},{"start":105.3,"end":107.4,"text":"这可以可以跪的敬茶礼"},{"start":107.4,"end":108.76,"text":"然后改改口啊"},{"start":108.76,"end":112.55,"text":"这个就是婚丧嫁娶嘛婚然后丧礼上的话"},{"start":112.55,"end":115.85,"text":"从你你父母的那一代起就要改"},{"start":116.58,"end":118.3,"text":"尽量尽量争取去改"},{"start":118.3,"end":120.9,"text":"如果说你母亲去世或者父亲去世"},{"start":120.9,"end":121.5,"text":"一方去世"},{"start":121.5,"end":122.34,"text":"另一方没去世"},{"start":122.34,"end":124.26,"text":"然后在另外一方的要求下"},{"start":124.26,"end":125.34,"text":"要要要跪拜"},{"start":125.34,"end":127.25,"text":"这种就是叫传统丧礼的话"},{"start":127.25,"end":128.37,"text":"那再说好吧"},{"start":128.37,"end":131.79,"text":"就是说也就是说你最后一个父母亲去世的时候"},{"start":131.79,"end":136.06,"text":"你要改成不跪拜的唉"},{"start":136.06,"end":139.18,"text":"要寄就到殡仪馆里面去鞠躬就行了"},{"start":140.71,"end":143.53,"text":"啊是这么一个要求"},{"start":143.53,"end":144.25,"text":"然后呢"},{"start":144.25,"end":146.71,"text":"除此之外一律不许跪"},{"start":150.92,"end":152.68,"text":"除非是受刑讯"},{"start":152.68,"end":155.72,"text":"或者说除非是就是受刑啦"},{"start":155.72,"end":157.57,"text":"被打啦啊"},{"start":157.57,"end":158.29,"text":"然后没办法"},{"start":158.29,"end":159.37,"text":"就是被揍了"},{"start":159.37,"end":160.03,"text":"你明白吗"},{"start":160.03,"end":162.019,"text":"就是身体被强迫"},{"start":162.019,"end":163.999,"text":"那么这是要反抗的"},{"start":163.999,"end":164.919,"text":"明白吗"},{"start":164.919,"end":167.81,"text":"除此外一律不得跪啊"},{"start":167.81,"end":169.29,"text":"啧啧啧啊"},{"start":169.29,"end":170.37,"text":"可以鞠躬"},{"start":170.37,"end":174.43,"text":"但是绝对就是这是我们的一个要求"},{"start":174.43,"end":179.07,"text":"就是无神论者要废弃跪拜礼啊"},{"start":179.07,"end":180.37,"text":"废弃跪拜礼"},{"start":180.37,"end":182.83,"text":"然后但是逐步的渐进的"},{"start":182.83,"end":184.67,"text":"不是说一下子全取消的"},{"start":184.67,"end":185.72,"text":"明白吗"},{"start":185.72,"end":188.4,"text":"那你说汉民族主义者不要跟我扯这东西"},{"start":188.4,"end":189.52,"text":"跪拜这玩意的话"},{"start":190.8,"end":192.14,"text":"呃"},{"start":192.64,"end":196.769,"text":"噗啊这个这个这个习俗呃"},{"start":197.129,"end":198.329,"text":"反正我们废除啊"},{"start":198.329,"end":199.729,"text":"反正我不是汉民族主义者"},{"start":199.729,"end":202.54,"text":"我也不认那传统儒教礼仪这玩意的"},{"start":202.54,"end":203.5,"text":"我有权限去改"},{"start":203.5,"end":204.86,"text":"我有全都改掉的"},{"start":204.86,"end":207.54,"text":"好不好啊"},{"start":211.06,"end":212.62,"text":"啊这这一点要明白"},{"start":212.62,"end":216.54,"text":"然后另外一方面就是说这个呃宗教信仰方面"},{"start":216.54,"end":218.2,"text":"就是坚持无神论"},{"start":218.2,"end":222.139,"text":"然后呢你如果有那种什么民俗教信仰的"},{"start":222.139,"end":224.419,"text":"那这些人要剔除啊"},{"start":224.419,"end":227.13,"text":"有这个呃佛道啊"},{"start":227.13,"end":229.55,"text":"还有其他的这个主流宗教那些信仰"},{"start":229.55,"end":233.06,"text":"还尤其是不能有神秘主义信仰啊"},{"start":233.06,"end":233.86,"text":"不能有迷信"},{"start":233.86,"end":235.58,"text":"有神秘主义的那种倾向啊"},{"start":235.58,"end":236.98,"text":"不能搞什么算命啊"},{"start":236.98,"end":238.04,"text":"什么塔罗牌呀"},{"start":238.04,"end":240.69,"text":"什么这些东西通通不允许玩啊"},{"start":240.69,"end":247.469,"text":"发现一个就要剔除这个人这种形邪淫寺邪寺"},{"start":247.469,"end":251.24,"text":"还有指望超自然力量去改变历史现实"},{"start":251.24,"end":255.48,"text":"还有就是供奉祭拜通通不允许"},{"start":257.119,"end":258.559,"text":"明白吧"},{"start":263.64,"end":271.41,"text":"这个就是一个呃基本的一个一个啊"},{"start":271.41,"end":273.53,"text":"一个纪律好吧"},{"start":273.53,"end":275.21,"text":"基本的一个纪律"},{"start":279.72,"end":283.16,"text":"哦然后还有就是灵魂这种说法的话"},{"start":283.16,"end":285.36,"text":"这个对于无神论者的话"},{"start":286.56,"end":290.41,"text":"嗯啊就是生命不朽啊"},{"start":290.41,"end":292.59,"text":"还有什么灵魂形态这个东西"},{"start":292.59,"end":295.25,"text":"它是尚属于哲学范畴"},{"start":295.25,"end":296.81,"text":"尚属于哲学范畴"},{"start":296.81,"end":300.01,"text":"但是说有一个前提就是不能信信仰"},{"start":300.01,"end":302.57,"text":"有任何意义上的主宰啊"},{"start":302.57,"end":304.77,"text":"就是物质自然力量背后的"},{"start":304.77,"end":307.43,"text":"它的运动是所有的"},{"start":307.43,"end":312.2,"text":"就精神性秩序的发生学机制发生的原理啊"},{"start":312.2,"end":313.88,"text":"它是物质运动"},{"start":313.88,"end":317.72,"text":"鲜活的物质运动本身给它发生出来的"},{"start":317.72,"end":321.51,"text":"不是说天然流主宰设计好的啊"},{"start":321.51,"end":323.27,"text":"定性考的"},{"start":323.27,"end":326.21,"text":"那么这个主宰啊就是说我们不承认有主宰"},{"start":326.21,"end":328.87,"text":"我们认为物质现实它是复数化的"},{"start":328.87,"end":334.26,"text":"都是整个宇宙的根本秩序的参与的制定者"},{"start":334.26,"end":338.63,"text":"所有的物质都是在这上是平等的啊"},{"start":338.63,"end":341.82,"text":"然后另外一方面是关于灵魂不朽这个东西呢"},{"start":341.82,"end":343.22,"text":"我们之前也已经讨论过了"},{"start":343.22,"end":345.04,"text":"他并不在任何意义上讲"},{"start":345.04,"end":347.96,"text":"有一个持续的一个载体呀"},{"start":347.96,"end":350.72,"text":"啊有一个实质性的一个灵魂啊"},{"start":350.72,"end":352.58,"text":"作为一个物质在里面一直运行"},{"start":352.58,"end":353.72,"text":"延续着这么一个东西"},{"start":353.72,"end":356.909,"text":"但是呢我们坚持的是精神不朽"},{"start":356.909,"end":360.47,"text":"就是对于这个整个宇宙呃"},{"start":360.47,"end":364.81,"text":"历史秩序的他的深刻的变化的追求"},{"start":364.81,"end":366.29,"text":"这样一种意志"},{"start":366.29,"end":372.35,"text":"还有那样一种强烈的希冀和欲望和愿望"},{"start":372.35,"end":378.43,"text":"和那种啊超群绝伦的那种努力啊"},{"start":378.43,"end":382.379,"text":"他作为一种啊前本体论的力量"},{"start":382.379,"end":383.579,"text":"它是不朽的"},{"start":383.579,"end":385.239,"text":"但是它不是人格化的"},{"start":385.239,"end":386.619,"text":"它也不是灵魂化"},{"start":386.619,"end":389.15,"text":"它不是实体化的啊"},{"start":389.15,"end":390.74,"text":"就精神不朽"},{"start":390.74,"end":393.14,"text":"革命精神不朽啊"},{"start":394.78,"end":396.78,"text":"这种种人类解放的这种精神不朽"},{"start":396.78,"end":398.18,"text":"但是他不是人格化的"},{"start":398.18,"end":399.97,"text":"他不独属于某个人"},{"start":399.97,"end":401.03,"text":"他不对"},{"start":401.03,"end":402.85,"text":"针对到这谁的谁的灵魂"},{"start":402.85,"end":404.05,"text":"谁的人格就可以"},{"start":404.05,"end":405.41,"text":"这个是永垂不朽的"},{"start":405.41,"end":406.33,"text":"没有的不存在"},{"start":406.33,"end":408.24,"text":"这东西明白吗"},{"start":408.24,"end":411.039,"text":"所以就不能有伟大灵魂崇拜"},{"start":411.199,"end":412.979,"text":"不能有伟大人格崇拜"},{"start":412.979,"end":414.699,"text":"不能有这个永恒人格"},{"start":414.699,"end":417.099,"text":"永恒灵魂的预想设想"},{"start":417.099,"end":418.079,"text":"有这个东西"},{"start":418.079,"end":420.53,"text":"即非就不是无神论者"},{"start":420.53,"end":421.67,"text":"就要排除数据"},{"start":421.67,"end":422.43,"text":"就要踢掉"},{"start":422.43,"end":423.69,"text":"删掉这种人"},{"start":423.69,"end":425.61,"text":"要清退除名"},{"start":427.18,"end":427.82,"text":"好吧"},{"start":427.82,"end":429.1,"text":"这不仅是炮打儒教了"},{"start":429.1,"end":431.68,"text":"他炮打很多这种什么领袖崇拜啊"},{"start":431.68,"end":433.06,"text":"你就明白了啊"},{"start":433.06,"end":436.71,"text":"这幻想有这种这种不可能的灵魂人格"},{"start":436.71,"end":438.39,"text":"这东西是不可能不朽的"},{"start":438.39,"end":439.95,"text":"但是呢精神是可以不朽的"},{"start":439.95,"end":443.35,"text":"但是这个精神就不是他一个人独独断的垄断的"},{"start":443.35,"end":445.14,"text":"不是由他所带犹太索"},{"start":445.14,"end":447.619,"text":"这个呃就明白吗"},{"start":447.619,"end":450.259,"text":"就是啊他是人世间唯一的代理"},{"start":450.259,"end":454.01,"text":"垄断性代理的不是这个东西啊"},{"start":454.01,"end":457.21,"text":"所以这个只要你够能够坚持平等主义的一种观"},{"start":457.21,"end":461.17,"text":"点观念的话啊就行"},{"start":464.24,"end":465.6,"text":"行吧"},{"start":467.5,"end":469.4,"text":"乡村敢不跪就要被棍打"},{"start":469.4,"end":470.8,"text":"那就打回去"},{"start":470.8,"end":472.02,"text":"你敢逼我跪"},{"start":472.02,"end":472.82,"text":"你打我一棍"},{"start":472.82,"end":474.66,"text":"我反打你一棍"},{"start":476.88,"end":478.32,"text":"哼你在搞笑"},{"start":479.76,"end":480.76,"text":"你如果是跪了"},{"start":480.76,"end":481.64,"text":"那就不是我们的人"},{"start":481.64,"end":482.64,"text":"那就别别来了"},{"start":482.64,"end":483.35,"text":"你明白吗"},{"start":483.35,"end":484.23,"text":"我都说了"},{"start":484.23,"end":485.61,"text":"我们放口子了"},{"start":485.61,"end":488.05,"text":"你如果是民俗被你直系家属"},{"start":488.05,"end":489.19,"text":"直系近亲属"},{"start":489.19,"end":493.72,"text":"就比如你的父母长辈要求父母要直系的啊要求"},{"start":493.72,"end":495.42,"text":"那你可以逢迎一下"},{"start":495.42,"end":497.78,"text":"因为我考虑到你们很多出生出生在这种"},{"start":497.78,"end":498.96,"text":"前天在农村"},{"start":498.96,"end":501.89,"text":"那这个是而且这个是有前提"},{"start":501.89,"end":505.09,"text":"只有在丧礼啊"},{"start":505.09,"end":508.17,"text":"就是这个死掉的去祭拜"},{"start":508.17,"end":513.099,"text":"或者说是婚礼里面的这个改口礼"},{"start":513.419,"end":514.938,"text":"就这两个例外"},{"start":514.938,"end":516.458,"text":"其他没有例外"},{"start":516.458,"end":519.058,"text":"其他你不要说什么一群要个什么回去"},{"start":519.058,"end":521.19,"text":"莫名其妙要祭祖啊"},{"start":521.83,"end":524.73,"text":"就是只能应直系近亲属"},{"start":524.73,"end":527.17,"text":"直系亲属的要求跪爷爷奶奶"},{"start":527.17,"end":527.91,"text":"外公外婆"},{"start":528.99,"end":530.15,"text":"明白吗"},{"start":530.73,"end":532.07,"text":"其他不允许跪"},{"start":532.07,"end":534.07,"text":"谁跪了就不是我们的人"},{"start":534.07,"end":537.35,"text":"不要带他玩清掉"},{"start":537.35,"end":540.31,"text":"这是要严格要有这个利润的立场的"},{"start":541.79,"end":542.49,"text":"好吧"},{"start":542.49,"end":546.86,"text":"做不到滚给老子滚啊"},{"start":546.86,"end":547.64,"text":"就这个观点"},{"start":549.84,"end":551.36,"text":"Stand up"},{"start":559.68,"end":561.38,"text":"这个应该是能做到的"},{"start":561.38,"end":563.44,"text":"你腿软不要来"},{"start":563.87,"end":564.43,"text":"明白吗"},{"start":564.43,"end":565.47,"text":"我们做生意"},{"start":565.47,"end":566.93,"text":"我们一群穷兄弟"},{"start":566.93,"end":568.71,"text":"这奔个前头啊"},{"start":568.71,"end":569.59,"text":"奔个前程"},{"start":569.59,"end":571.01,"text":"奔个活头"},{"start":571.01,"end":573.869,"text":"如果你这种人对不对"},{"start":573.869,"end":577.13,"text":"还还他妈的算命呢啊"},{"start":577.13,"end":580.51,"text":"还有信信这个信那个是跪拜供奉的"},{"start":580.51,"end":581.65,"text":"这种人是不要的"},{"start":581.65,"end":583.329,"text":"是要清退掉的啊"},{"start":583.329,"end":584.529,"text":"严格讲啊"},{"start":584.529,"end":586.129,"text":"这种人要清退掉的"},{"start":586.129,"end":590.03,"text":"那么把这个无神论的要求"},{"start":590.03,"end":592.66,"text":"在生活当中坚持啊贯彻"},{"start":592.66,"end":595.0,"text":"不要相信有什么超自然神秘力量"},{"start":595.0,"end":596.9,"text":"不要相信有什么啊命定啊"},{"start":596.9,"end":597.88,"text":"什么玩意啊"},{"start":597.88,"end":598.8,"text":"这什么哎呀"},{"start":598.8,"end":599.72,"text":"紫薇圣人"},{"start":599.72,"end":602.23,"text":"还有什么白头翁还是什么玩意"},{"start":603.79,"end":606.7,"text":"这些东西通通不准信也"},{"start":606.7,"end":608.08,"text":"原则上不允许讨论"},{"start":608.08,"end":610.34,"text":"如果要讨论批判啊"},{"start":610.34,"end":612.91,"text":"就是他就是本身就是啊统治集团"},{"start":612.91,"end":616.19,"text":"或者说是啊协协会营私啊"},{"start":616.19,"end":618.27,"text":"这个东西胡就是麻醉老百姓的"},{"start":618.27,"end":620.935,"text":"欺骗老百姓的欺骗性的东西"},{"start":623.58,"end":629.19,"text":"然后就是说嗯不得进行这个人格崇拜啊"},{"start":629.19,"end":629.91,"text":"什么圣人"},{"start":629.91,"end":630.99,"text":"什么这东西的"},{"start":630.99,"end":635.33,"text":"凡是喜欢口必称这个圣那个圣的这种人"},{"start":635.33,"end":636.87,"text":"不带他玩"},{"start":636.87,"end":637.99,"text":"明白吗"},{"start":637.99,"end":639.57,"text":"人就是人普通的人"},{"start":639.57,"end":640.92,"text":"平等的人"},{"start":641.28,"end":642.4,"text":"称这个肾那个肾"},{"start":642.4,"end":646.86,"text":"这个肾那个肾的这种人清退清退好吧"},{"start":646.86,"end":649.78,"text":"发现他是这种轻浮顽"},{"start":649.78,"end":652.42,"text":"就是这种顽劣的啊"},{"start":652.42,"end":654.06,"text":"不是脚呃"},{"start":654.06,"end":656.0,"text":"脚踏实地的这种人清退掉"},{"start":656.0,"end":658.82,"text":"不要和他打交道"},{"start":663.139,"end":663.939,"text":"明白吧"},{"start":663.939,"end":665.819,"text":"就是这种都是落后思想"},{"start":665.819,"end":670.99,"text":"或者说都是某种嗯无纪律呃"},{"start":670.99,"end":672.23,"text":"不严肃的表现"},{"start":672.23,"end":674.699,"text":"这些人是要退掉的啊"},{"start":674.699,"end":678.219,"text":"然后我们店里面店里面口必称卫生的人"},{"start":678.219,"end":680.419,"text":"实际上就是不允许他充会员的"},{"start":680.419,"end":682.77,"text":"会把他清掉的啊"},{"start":687.06,"end":693.58,"text":"唉你们嘴巴上在直播间里面说这说那啊"},{"start":694.26,"end":695.24,"text":"没用的呀"},{"start":695.24,"end":697.06,"text":"现实生活中不带你们玩的啊"},{"start":697.06,"end":697.5,"text":"好吧"},{"start":697.5,"end":698.92,"text":"那就讲到这里啊"}],"source":"subtitle"}
