{"segments":[{"start":1.0,"end":5.44,"text":"哲学的实质其实就是激进资产阶级造反学"},{"start":5.44,"end":8.89,"text":"他和这个封建贵族"},{"start":8.89,"end":13.14,"text":"和这个宗教僧侣的神学体系"},{"start":13.14,"end":15.6,"text":"他抢夺不了现实世界的定义权"},{"start":15.6,"end":17.2,"text":"所以他迂回"},{"start":17.2,"end":18.22,"text":"他绕过去"},{"start":18.22,"end":20.68,"text":"直接说描述我从这个宇宙本源"},{"start":20.68,"end":23.83,"text":"或者说整个不仅宇宙本源本何为本源"},{"start":23.83,"end":24.73,"text":"和我宇宙"},{"start":24.73,"end":25.48,"text":"什么叫时间"},{"start":25.48,"end":26.47,"text":"什么叫空间"},{"start":26.47,"end":28.09,"text":"包括为什么时间"},{"start":28.09,"end":31.59,"text":"空间一定有一个主体来中介体验它"},{"start":31.59,"end":33.06,"text":"它有没有至高主宰"},{"start":33.06,"end":34.29,"text":"有没有第一主体"},{"start":34.29,"end":36.699,"text":"绝对者在中介和体验它"},{"start":36.76,"end":38.65,"text":"那么为什么会有死亡"},{"start":38.65,"end":40.9,"text":"生存意识的断裂"},{"start":40.9,"end":43.78,"text":"连续时间的时间内对性"},{"start":43.78,"end":44.44,"text":"外在性"},{"start":44.44,"end":47.26,"text":"还有包括个体的性化"},{"start":47.26,"end":50.27,"text":"为什么会有会有一种会有一"},{"start":50.27,"end":53.93,"text":"种性化的爱欲模式等等等等等等等等"},{"start":53.93,"end":56.0,"text":"为什么会有回忆知识"},{"start":56.0,"end":58.34,"text":"为什么会有这种痛苦"},{"start":58.34,"end":59.779,"text":"为什么会有"},{"start":61.54,"end":63.6,"text":"就是身体化"},{"start":63.6,"end":66.72,"text":"主体间性等等等等等等等等等等"},{"start":66.72,"end":69.33,"text":"哲学是绕一个大圈子啊"},{"start":69.33,"end":72.1,"text":"激进的就是近代"},{"start":74.22,"end":75.5,"text":"小朋友现在出去了"},{"start":75.5,"end":76.67,"text":"我在做事情"},{"start":76.67,"end":81.24,"text":"激进的一个近代的资产阶级的革命"},{"start":84.58,"end":87.42,"text":"他就是通过哲学来迂回"},{"start":87.42,"end":91.44,"text":"所以我说哲学的实质是是在野性"},{"start":93.0,"end":95.87,"text":"他将自己伪造为"},{"start":95.87,"end":100.27,"text":"或者说他就认为呃我资产阶级上台的时候"},{"start":100.27,"end":101.83,"text":"我之后进行的统治"},{"start":101.83,"end":104.14,"text":"就不是一个神权的直接统治了"},{"start":104.14,"end":105.73,"text":"我永远我是统治者"},{"start":105.73,"end":108.51,"text":"我永远是不直接把握政权的"},{"start":108.51,"end":110.94,"text":"我是通过民意代表或者通过国家机器"},{"start":110.94,"end":112.89,"text":"我作为作为他背后大老板"},{"start":112.89,"end":114.19,"text":"我永远是在野的"},{"start":114.19,"end":115.09,"text":"我就算统治"},{"start":115.09,"end":115.75,"text":"我也是在野的"},{"start":115.75,"end":118.259,"text":"所以我说哲学的实质是在野性"},{"start":118.98,"end":121.4,"text":"资产阶级统治的实质是哲学"},{"start":121.4,"end":121.88,"text":"统治"},{"start":121.88,"end":123.2,"text":"是在野的统治"},{"start":124.06,"end":125.28,"text":"在野的统治"},{"start":125.28,"end":126.45,"text":"他就是个辩证法"},{"start":126.45,"end":127.5,"text":"他是个辩证法"},{"start":127.5,"end":128.4,"text":"懂了吧"},{"start":131.54,"end":132.82,"text":"所以在这个意义上讲"},{"start":132.82,"end":135.78,"text":"哲学它是一个大迂回大迂回"},{"start":135.78,"end":138.6,"text":"但是呢由于它资产阶级的统治"},{"start":138.6,"end":141.42,"text":"是以这种在野性作为他的统治"},{"start":142.059,"end":145.979,"text":"它是统治本身的自我的一个阳气"},{"start":145.979,"end":147.52,"text":"或者一个内在辩证"},{"start":147.52,"end":149.2,"text":"所以我们作为社会主义者"},{"start":149.2,"end":150.64,"text":"我们作为共产主义者"},{"start":150.64,"end":152.98,"text":"我们要推翻资产阶级统治"},{"start":152.98,"end":155.68,"text":"我们并不能够直接对统治下手"},{"start":155.68,"end":158.35,"text":"我们要对他的在野状态下手"},{"start":158.35,"end":162.94,"text":"他的在野状态的至高的这个自信反思"},{"start":162.94,"end":164.959,"text":"就是通过哲学来实现的"},{"start":164.959,"end":166.999,"text":"或者说资产阶级的统治"},{"start":166.999,"end":168.799,"text":"或者说资产阶级的在野状态"},{"start":168.799,"end":171.739,"text":"和他统治之间的一个过渡是如何实现的"},{"start":171.739,"end":173.57,"text":"是通过哲学来终结的"},{"start":173.57,"end":173.87,"text":"是"},{"start":173.87,"end":176.96,"text":"用哲学而且是非常精致的"},{"start":176.96,"end":181.859,"text":"这个法国后结构主义的哲学明白吗"},{"start":181.859,"end":184.769,"text":"就是就是辩证法现象学啊"},{"start":184.769,"end":190.15,"text":"绝对观念论都被吸收和和和和批判的一个"},{"start":190.15,"end":191.77,"text":"法国后结构主义哲学"},{"start":191.77,"end":195.1,"text":"包括海德格尔的生存论"},{"start":195.22,"end":199.56,"text":"还有就是维吉克斯坦的语言哲学"},{"start":199.64,"end":200.48,"text":"通通"},{"start":200.48,"end":201.53,"text":"我觉得都"},{"start":201.53,"end":203.72,"text":"它的最新版本"},{"start":203.72,"end":205.85,"text":"应当是在法国后结构主义当中的"},{"start":205.85,"end":207.84,"text":"然后法国后结构主义"},{"start":207.84,"end":210.39,"text":"以及法国的这个民族性"},{"start":210.39,"end":213.06,"text":"以及欧盟的这个跨民族性"},{"start":213.06,"end":218.23,"text":"它是以及法国的这种半霸权性"},{"start":218.23,"end":221.68,"text":"法国的文化和精神上的这种霸权性"},{"start":221.68,"end":225.6,"text":"以及他在地缘政治和这个军事政治上的"},{"start":225.6,"end":228.39,"text":"失败的仆从性"},{"start":228.39,"end":229.62,"text":"这个东西都"},{"start":229.62,"end":231.45,"text":"是我们近代的"},{"start":231.45,"end":235.739,"text":"就是就是思想这样应该去考虑的"},{"start":235.739,"end":239.829,"text":"美国我觉得反而不是特别需要去去在意的"},{"start":239.829,"end":241.629,"text":"我们现在比较关注的是"},{"start":241.629,"end":243.819,"text":"欧盟的自我拯救问题"},{"start":243.819,"end":246.48,"text":"欧盟呢还法国的自我拯救问题"},{"start":247.219,"end":248.919,"text":"在哲哲学上来讲的话"},{"start":248.919,"end":250.359,"text":"分析哲学已经不值一提了"},{"start":250.359,"end":253.299,"text":"因为他不直接涉及人类的命运和军政"},{"start":253.299,"end":254.11,"text":"现实了"},{"start":254.11,"end":256.6,"text":"议员政治现实都都不介入了"},{"start":256.6,"end":260.899,"text":"更不要谈这资本主义和这个全球阶级斗争"},{"start":260.899,"end":262.099,"text":"的这些态势问题"},{"start":262.099,"end":264.86,"text":"但是法国人一直在关注那个"},{"start":266.56,"end":268.14,"text":"我要说的就是说"},{"start":268.14,"end":272.28,"text":"所以我们就算要反对资产阶级的统治"},{"start":272.28,"end":275.21,"text":"反对资产阶级伪装为在野的统治"},{"start":275.21,"end":278.3,"text":"反对哲学对于人类的统治"},{"start":278.3,"end":280.64,"text":"我们也要从哲学本身来入手"},{"start":280.64,"end":283.79,"text":"所以我说的哲学是资产阶级的造反学"},{"start":283.79,"end":284.96,"text":"他是迂回的"},{"start":284.96,"end":287.01,"text":"他为了为了推翻"},{"start":287.01,"end":289.67,"text":"或者说他就是在辩证法上"},{"start":289.67,"end":292.13,"text":"它代替了之前直接的神权统治"},{"start":292.13,"end":293.63,"text":"但是我们需要直接的神权统治"},{"start":293.63,"end":294.65,"text":"他永远也不是直接"},{"start":294.65,"end":296.28,"text":"他永远也是间接的"},{"start":296.28,"end":300.48,"text":"直觉得就是说之前的统治神权时代"},{"start":300.48,"end":304.44,"text":"统治是代天牧民或者带神牧民"},{"start":305.199,"end":307.079,"text":"他是个间接的直接性"},{"start":307.079,"end":310.06,"text":"然后我们现在统治是一个在野的"},{"start":310.68,"end":312.02,"text":"在野的统治性"},{"start":312.02,"end":312.38,"text":"在野"},{"start":312.38,"end":313.23,"text":"的介入性"},{"start":313.23,"end":314.79,"text":"或者说在野的"},{"start":314.79,"end":316.74,"text":"或者说一种直接的代表性质"},{"start":316.74,"end":317.91,"text":"直接的间接性"},{"start":317.91,"end":318.87,"text":"直接代表性"},{"start":318.87,"end":320.74,"text":"但这是他的明代机制啊"},{"start":320.74,"end":321.49,"text":"代一致嘛"},{"start":321.49,"end":323.3,"text":"它是一个直接的代表性"},{"start":326.219,"end":328.019,"text":"我们应当从这个角度"},{"start":328.019,"end":329.459,"text":"从这种法哲学"},{"start":329.459,"end":330.119,"text":"宪法学"},{"start":330.119,"end":330.779,"text":"宪法哲学"},{"start":330.779,"end":331.919,"text":"或者说这种政治哲学"},{"start":331.919,"end":334.53,"text":"这些角度去把握这些问题"},{"start":334.53,"end":336.27,"text":"所以你们理工科知识分子"},{"start":336.27,"end":337.8,"text":"好像你们对人类的命运"},{"start":337.8,"end":339.45,"text":"仅仅是把人类当成畜生"},{"start":339.45,"end":341.0,"text":"或者说当成他妈的"},{"start":342.3,"end":345.33,"text":"就是电子元器件那样去看待"},{"start":345.33,"end":347.52,"text":"而不是把人类当成历史的主体"},{"start":347.52,"end":352.69,"text":"或者说是就是每个个体都具有其余绝对性"},{"start":352.69,"end":356.64,"text":"这样去来来来来思考人类命运"},{"start":357.06,"end":359.04,"text":"我觉得你们对人是不尊重的"},{"start":359.04,"end":360.33,"text":"是很鄙视人呢"},{"start":360.33,"end":363.02,"text":"或者说你对你自己是很不尊重的"},{"start":363.28,"end":369.169,"text":"就是完全没有在真正的现实的烈度和"},{"start":369.169,"end":373.74,"text":"这个紧迫性和这个组织起来"},{"start":373.74,"end":377.579,"text":"动员起来的那种呃"},{"start":377.579,"end":380.279,"text":"自我激励的这种使命状态当中"},{"start":380.279,"end":381.629,"text":"去思考这些问题"},{"start":381.629,"end":382.859,"text":"你们是很无力的"},{"start":382.859,"end":384.5,"text":"很很肺腑的一群人"},{"start":384.86,"end":387.02,"text":"所以我我已经把话说清楚了"},{"start":387.02,"end":389.339,"text":"就是哲学是曾经啊"},{"start":389.339,"end":392.489,"text":"曾经他是激进的资产阶级的这个造反学"},{"start":392.489,"end":393.749,"text":"后来他赢了"},{"start":393.749,"end":397.46,"text":"所以哲学其实是他的激进资产阶级"},{"start":397.46,"end":398.66,"text":"后来腐化堕落了"},{"start":398.66,"end":401.0,"text":"变成这个反动的资产阶级"},{"start":401.0,"end":404.53,"text":"对于整个现实的统治的一个伪装术"},{"start":404.53,"end":406.87,"text":"或者说是他的再野性和统治"},{"start":406.87,"end":409.03,"text":"之间的一个中介智信中介"},{"start":409.03,"end":410.47,"text":"那么在现在这个时代"},{"start":410.47,"end":414.19,"text":"作为共产主义和社会主义革命的工具"},{"start":414.19,"end":415.45,"text":"哲学马克思主义"},{"start":415.45,"end":418.17,"text":"哲学作为一种彻底的整个的"},{"start":418.17,"end":419.85,"text":"反对资产阶级的哲学"},{"start":419.85,"end":421.53,"text":"反对资产阶级作为"},{"start":421.53,"end":425.24,"text":"在野和统治中介的那种哲学"},{"start":426.7,"end":429.7,"text":"马克思主义哲学就是要击破这些"},{"start":430.039,"end":431.839,"text":"标榜第一生活方式"},{"start":431.839,"end":434.299,"text":"标榜最完美的自信中介方式"},{"start":434.299,"end":438.72,"text":"标榜啊最整齐的一个呃逻辑学谱系"},{"start":438.72,"end":440.4,"text":"这个逻辑学是黑格尔意义上逻辑"},{"start":440.4,"end":441.36,"text":"逻辑学谱系"},{"start":441.36,"end":443.34,"text":"这个谱系迁延到人类的社会"},{"start":443.34,"end":446.01,"text":"生活和历史发展的所有环节"},{"start":446.01,"end":447.87,"text":"他所预言的所有环节"},{"start":447.87,"end":450.48,"text":"马克思主义哲学就是用来击破这些东西"},{"start":450.48,"end":453.479,"text":"击破这些黑格尔式的"},{"start":453.479,"end":455.219,"text":"或者说后黑格尔式的"},{"start":455.219,"end":456.359,"text":"就是生存论"},{"start":456.359,"end":457.559,"text":"后结构主义式的"},{"start":457.559,"end":461.72,"text":"这些黑格尔是准黑格尔或"},{"start":461.72,"end":462.53,"text":"者说"},{"start":462.53,"end":467.45,"text":"或者说过于黑格尔式的这些谱系和环节"},{"start":467.45,"end":470.6,"text":"这谱系学我觉得我觉得我觉得是这样的"},{"start":470.6,"end":471.68,"text":"我觉得是这样的"},{"start":471.68,"end":474.44,"text":"马思主哲学是一种反谱系学"},{"start":474.64,"end":481.12,"text":"马克思主义是一种呃是对于哲学的哲学"},{"start":481.12,"end":482.35,"text":"会意识形态化"},{"start":482.35,"end":485.2,"text":"马克思主义哲学是一种去意识形态化的"},{"start":485.2,"end":486.88,"text":"一种一种一种哲学"},{"start":486.88,"end":489.289,"text":"所以马克思主义哲学是一个导向"},{"start":489.289,"end":494.43,"text":"更进一步的政治经济学和革命军事"},{"start":494.43,"end":497.67,"text":"嗯嗯呃"},{"start":497.67,"end":499.9,"text":"理论的革命"},{"start":499.9,"end":503.86,"text":"理论和军事理论的的一个预备性的科学"},{"start":503.86,"end":505.81,"text":"哲学在这里的功能是预备性的"},{"start":505.81,"end":507.34,"text":"这是我始终是一个观点"},{"start":507.34,"end":509.23,"text":"马克思主义的哲学是预备性的"},{"start":509.23,"end":511.3,"text":"但是你必须在掌"},{"start":511.3,"end":513.0,"text":"握马克思与哲学之后"},{"start":513.48,"end":516.99,"text":"也可以就就要吸收它的最先进的发展"},{"start":516.99,"end":520.2,"text":"就比如说是后结构主义的这种意识"},{"start":520.2,"end":521.89,"text":"在批判学啊"},{"start":521.89,"end":524.5,"text":"以及阶级意识的分析分析学"},{"start":524.5,"end":528.83,"text":"其实就是说对于拉康或者奇斯克这样的呃"},{"start":528.83,"end":529.97,"text":"精神分析师啊"},{"start":529.97,"end":531.08,"text":"精神分析学家"},{"start":531.08,"end":532.73,"text":"他不算精神分析师"},{"start":532.73,"end":536.7,"text":"他的从呃意识形态批判"},{"start":536.7,"end":539.58,"text":"更进一步的阶级意识的直接批判当中"},{"start":539.58,"end":543.81,"text":"要要吸取他们的这种分析批判的能力"},{"start":543.81,"end":547.55,"text":"在这个意义上讲去获得一种新的"},{"start":547.55,"end":549.08,"text":"我们这个时代的马克思主义的"},{"start":549.08,"end":551.18,"text":"一种对阶级意识啊"},{"start":551.18,"end":553.979,"text":"但更不用说意识形态的一种啊"},{"start":554.36,"end":555.92,"text":"一种击破力"},{"start":555.92,"end":556.61,"text":"批判力"},{"start":556.61,"end":557.06,"text":"对"},{"start":557.06,"end":559.04,"text":"包括也是还有"},{"start":559.04,"end":560.36,"text":"一种发声力量"},{"start":560.36,"end":562.49,"text":"你可以凝聚发生"},{"start":562.49,"end":567.12,"text":"或者说引导新的阶级史的产生"},{"start":568.42,"end":569.79,"text":"所以在这个意义上讲"},{"start":569.79,"end":571.62,"text":"这个马克思哲学啊"},{"start":571.62,"end":574.99,"text":"他在我们这个时代的一些新进的一些"},{"start":574.99,"end":577.63,"text":"一些一些发展的一些运用"},{"start":577.63,"end":578.92,"text":"我们要用好它"},{"start":578.92,"end":583.49,"text":"并且为进一步的政治经济学和这个革命呃"},{"start":583.49,"end":587.26,"text":"和军事斗争做好准备"},{"start":587.58,"end":588.51,"text":"嗯对吧"},{"start":588.51,"end":589.62,"text":"那么这些工作呢"},{"start":589.62,"end":594.37,"text":"都不是一个一个已成为学术资产阶级"},{"start":594.37,"end":596.56,"text":"或者说成为一个编制资产阶级"},{"start