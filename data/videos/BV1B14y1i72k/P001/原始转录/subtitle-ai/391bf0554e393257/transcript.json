  "content_sha256": "391bf0554e393257fdeda6f5705c5598fa0299036966438aa67fb55b4b9f5c6d",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 0,
      "end_ms": 5619,
      "text": "呃我要做一个呃比较郑重的一个宣告和呼吁啊"
    },
    {
      "ordinal": 1,
      "start_ms": 5619,
      "end_ms": 10899,
      "text": "就说我已经向国家安全机关实名举报了一位呃"
    },
    {
      "ordinal": 2,
      "start_ms": 10899,
      "end_ms": 13379,
      "text": "这个架设非法网站"
    },
    {
      "ordinal": 3,
      "start_ms": 13379,
      "end_ms": 17009,
      "text": "那么在B站和知乎非法引流"
    },
    {
      "ordinal": 4,
      "start_ms": 17009,
      "end_ms": 18899,
      "text": "利用他的B站和知乎账号"
    },
    {
      "ordinal": 5,
      "start_ms": 18899,
      "end_ms": 21520,
      "text": "非法引流的一个反政府人士"
    },
    {
      "ordinal": 6,
      "start_ms": 21900,
      "end_ms": 25170,
      "text": "并且我提供了完整的举报线索啊"
    },
    {
      "ordinal": 7,
      "start_ms": 25170,
      "end_ms": 29310,
      "text": "包括他的犯罪事实以及这个人的身份啊"
    },
    {
      "ordinal": 8,
      "start_ms": 29310,
      "end_ms": 32259,
      "text": "身份证据对应关系啊"
    },
    {
      "ordinal": 9,
      "start_ms": 32259,
      "end_ms": 33819,
      "text": "立案号就是这个啊"
    },
    {
      "ordinal": 10,
      "start_ms": 33819,
      "end_ms": 36640,
      "text": "立案号就是这个那个"
    },
    {
      "ordinal": 11,
      "start_ms": 36680,
      "end_ms": 40910,
      "text": "我之前在一个视频里面透露的这件事情"
    },
    {
      "ordinal": 12,
      "start_ms": 40910,
      "end_ms": 42650,
      "text": "是要吓住他"
    },
    {
      "ordinal": 13,
      "start_ms": 42650,
      "end_ms": 44920,
      "text": "让他停止进行啊"
    },
    {
      "ordinal": 14,
      "start_ms": 44920,
      "end_ms": 46390,
      "text": "相应的违法犯罪活动"
    },
    {
      "ordinal": 15,
      "start_ms": 46390,
      "end_ms": 53880,
      "text": "没想到这个用户竟然还要这个这还要起诉我"
    },
    {
      "ordinal": 16,
      "start_ms": 53880,
      "end_ms": 55260,
      "text": "我真的是懵了"
    },
    {
      "ordinal": 17,
      "start_ms": 55260,
      "end_ms": 57960,
      "text": "我知道我我我现在对于这个用户的呼吁"
    },
    {
      "ordinal": 18,
      "start_ms": 57960,
      "end_ms": 59070,
      "text": "你赶紧去自首"
    },
    {
      "ordinal": 19,
      "start_ms": 59070,
      "end_ms": 63710,
      "text": "赶紧去找公安机关自首或者安全机关自首"
    },
    {
      "ordinal": 20,
      "start_ms": 63710,
      "end_ms": 67080,
      "text": "然后另外一方面就是说呃"
    },
    {
      "ordinal": 21,
      "start_ms": 67080,
      "end_ms": 72570,
      "text": "我郑重呼吁B站和知乎这两个平台的管理员"
    },
    {
      "ordinal": 22,
      "start_ms": 72570,
      "end_ms": 76820,
      "text": "立即将这个用户封禁"
    },
    {
      "ordinal": 23,
      "start_ms": 77760,
      "end_ms": 79160,
      "text": "那么这个用户啊"
    },
    {
      "ordinal": 24,
      "start_ms": 79160,
      "end_ms": 84230,
      "text": "并且那个保保存该用户的这个相应数据啊"
    },
    {
      "ordinal": 25,
      "start_ms": 84230,
      "end_ms": 85430,
      "text": "保存相关证据"
    },
    {
      "ordinal": 26,
      "start_ms": 85430,
      "end_ms": 87410,
      "text": "到时候配合这个公安机关"
    },
    {
      "ordinal": 27,
      "start_ms": 87410,
      "end_ms": 89600,
      "text": "或者说国家安全机关的调查"
    },
    {
      "ordinal": 28,
      "start_ms": 89600,
      "end_ms": 95120,
      "text": "那么呃我们可以直接看一下这个人"
    },
    {
      "ordinal": 29,
      "start_ms": 95120,
      "end_ms": 97250,
      "text": "既然他到现在他的一些证据啊"
    },
    {
      "ordinal": 30,
      "start_ms": 97250,
      "end_ms": 99020,
      "text": "他都自己都没有删啊"
    },
    {
      "ordinal": 31,
      "start_ms": 99020,
      "end_ms": 101740,
      "text": "我们可以看一下这个"
    },
    {
      "ordinal": 32,
      "start_ms": 105160,
      "end_ms": 107910,
      "text": "首先是在B站的这个账号啊"
    },
    {
      "ordinal": 33,
      "start_ms": 107910,
      "end_ms": 111870,
      "text": "叫做dream247DREAM247"
    },
    {
      "ordinal": 34,
      "start_ms": 111870,
      "end_ms": 116350,
      "text": "他竟然到现在还有这个说这个图书馆"
    },
    {
      "ordinal": 35,
      "start_ms": 116350,
      "end_ms": 121430,
      "text": "似乎由于某这个网站似乎由于没有备案被强了"
    },
    {
      "ordinal": 36,
      "start_ms": 121430,
      "end_ms": 123740,
      "text": "他之后会想办法解决"
    },
    {
      "ordinal": 37,
      "start_ms": 123740,
      "end_ms": 125120,
      "text": "不用着急"
    },
    {
      "ordinal": 38,
      "start_ms": 125120,
      "end_ms": 129400,
      "text": "那很明确的这个非法网站被强"
    },
    {
      "ordinal": 39,
      "start_ms": 129859,
      "end_ms": 131689,
      "text": "他竟然要想办法解决"
    },
    {
      "ordinal": 40,
      "start_ms": 131689,
      "end_ms": 133339,
      "text": "很明显透露的是什么"
    },
    {
      "ordinal": 41,
      "start_ms": 133339,
      "end_ms": 134359,
      "text": "他是站长啊"
    },
    {
      "ordinal": 42,
      "start_ms": 134359,
      "end_ms": 134899,
      "text": "他是站长"
    },
    {
      "ordinal": 43,
      "start_ms": 134899,
      "end_ms": 136880,
      "text": "他是这个网站的站长"
    },
    {
      "ordinal": 44,
      "start_ms": 136940,
      "end_ms": 139700,
      "text": "还能解决备案被强的这个问题啊"
    },
    {
      "ordinal": 45,
      "start_ms": 139700,
      "end_ms": 140720,
      "text": "没办法被强的"
    },
    {
      "ordinal": 46,
      "start_ms": 140720,
      "end_ms": 144660,
      "text": "然后还有这个另外动态我就不找了"
    },
    {
      "ordinal": 47,
      "start_ms": 144660,
      "end_ms": 145260,
      "text": "我就放一下"
    },
    {
      "ordinal": 48,
      "start_ms": 145260,
      "end_ms": 146760,
      "text": "我之前找到一些动态啊"
    },
    {
      "ordinal": 49,
      "start_ms": 146760,
      "end_ms": 148140,
      "text": "之前找到一些动态"
    },
    {
      "ordinal": 50,
      "start_ms": 148140,
      "end_ms": 150810,
      "text": "就是同样的是这个这个动态"
    },
    {
      "ordinal": 51,
      "start_ms": 150810,
      "end_ms": 156680,
      "text": "还有他在这个呃啊"
    },
    {
      "ordinal": 52,
      "start_ms": 156859,
      "end_ms": 160870,
      "text": "他在知乎上的这个他在知乎上的这个用户"
    },
    {
      "ordinal": 53,
      "start_ms": 160870,
      "end_ms": 161800,
      "text": "就知乎的管理员"
    },
    {
      "ordinal": 54,
      "start_ms": 161800,
      "end_ms": 163360,
      "text": "你如果看到这个视频的话"
    },
    {
      "ordinal": 55,
      "start_ms": 163360,
      "end_ms": 167500,
      "text": "我也呼吁你郑重呼吁立刻把它封禁啊"
    },
    {
      "ordinal": 56,
      "start_ms": 167500,
      "end_ms": 169630,
      "text": "因为他现在还在知乎上引流呢"
    },
    {
      "ordinal": 57,
      "start_ms": 169630,
      "end_ms": 173470,
      "text": "他在给他的这个啊这个非法网站引流"
    },
    {
      "ordinal": 58,
      "start_ms": 175030,
      "end_ms": 176940,
      "text": "然后这个呃"
    },
    {
      "ordinal": 59,
      "start_ms": 178459,
      "end_ms": 183770,
      "text": "呃这个他说要给这个网站加什么夜间模式啊"
    },
    {
      "ordinal": 60,
      "start_ms": 183770,
      "end_ms": 185380,
      "text": "加夜间模式啊"
    },
    {
      "ordinal": 61,
      "start_ms": 185380,
      "end_ms": 187660,
      "text": "我待会会把这都打马赛克啊"
    },
    {
      "ordinal": 62,
      "start_ms": 187660,
      "end_ms": 190620,
      "text": "打马赛克的说是这个叫黑暗模式"
    },
    {
      "ordinal": 63,
      "start_ms": 190620,
      "end_ms": 193980,
      "text": "它可以调整这个网站里面的浏览模式"
    },
    {
      "ordinal": 64,
      "start_ms": 193980,
      "end_ms": 195780,
      "text": "它很明显是这个网站的站长"
    },
    {
      "ordinal": 65,
      "start_ms": 195780,
      "end_ms": 203520,
      "text": "这个网站当中有巨量的啊煽动颠覆啊的一些呃"
    },
    {
      "ordinal": 66,
      "start_ms": 203520,
      "end_ms": 205140,
      "text": "一些内容指导性的内容"
    },
    {
      "ordinal": 67,
      "start_ms": 205140,
      "end_ms": 206340,
      "text": "教材性的内容"
    },
    {
      "ordinal": 68,
      "start_ms": 206340,
      "end_ms": 209940,
      "text": "还有一些就是直接涉及到什么类似的这种东西"
    },
    {
      "ordinal": 69,
      "start_ms": 209940,
      "end_ms": 210840,
      "text": "来讨论这种东西"
    },
    {
      "ordinal": 70,
      "start_ms": 210840,
      "end_ms": 214470,
      "text": "他那个网站是很明确是一个非法网站啊"
    },
    {
      "ordinal": 71,
      "start_ms": 214470,
      "end_ms": 216810,
      "text": "煽动暴恐的非法网站"
    },
    {
      "ordinal": 72,
      "start_ms": 216810,
      "end_ms": 219150,
      "text": "那么这两个账户"
    },
    {
      "ordinal": 73,
      "start_ms": 219150,
      "end_ms": 222270,
      "text": "我呼吁这两个平台立即给他进行封禁"
    },
    {
      "ordinal": 74,
      "start_ms": 222270,
      "end_ms": 225300,
      "text": "然后这个人他说还要再次起诉"
    },
    {
      "ordinal": 75,
      "start_ms": 225300,
      "end_ms": 228260,
      "text": "我要说的是你赶紧去自首吧"
    },
    {
      "ordinal": 76,
      "start_ms": 228260,
      "end_ms": 231069,
      "text": "朋友但是你不是朋友啊"
    },
    {
      "ordinal": 77,
      "start_ms": 231069,
      "end_ms": 232479,
      "text": "你赶紧去自首吧"
    },
    {
      "ordinal": 78,
      "start_ms": 232479,
      "end_ms": 233799,
      "text": "你现在要做的是自首"
    },
    {
      "ordinal": 79,
      "start_ms": 233799,
      "end_ms": 234639,
      "text": "你懂吗"
    },
    {
      "ordinal": 80,
      "start_ms": 234639,
      "end_ms": 237160,
      "text": "你不是说要起诉我或者什么"
    },
    {
      "ordinal": 81,
      "start_ms": 238480,
      "end_ms": 239760,
      "text": "你明白吗"
    },
    {
      "ordinal": 82,
      "start_ms": 239760,
      "end_ms": 241950,
      "text": "你现在要做的是去自首"
    },
    {
      "ordinal": 83,
      "start_ms": 241950,
      "end_ms": 243570,
      "text": "而不是来起诉我"
    },
    {
      "ordinal": 84,
      "start_ms": 243570,
      "end_ms": 246020,
      "text": "我暴露你的违法犯罪现实"
    },
    {
      "ordinal": 85,
      "start_ms": 246299,
      "end_ms": 250199,
      "text": "我就要挫败你的这种几量"
    },
    {
      "ordinal": 86,
      "start_ms": 250199,
      "end_ms": 253980,
      "text": "想要用这两个平台的这个这个账号来引流"
    },
    {
      "ordinal": 87,
      "start_ms": 254040,
      "end_ms": 257190,
      "text": "这个不叫侵犯你的合法权益啊"
    },
    {
      "ordinal": 88,
      "start_ms": 257190,
      "end_ms": 260510,
      "text": "这个不叫我侮辱什么什么侮辱诽谤你"
    },
    {
      "ordinal": 89,
      "start_ms": 260510,
      "end_ms": 262610,
      "text": "你自己发的这些动态"
    },
    {
      "ordinal": 90,
      "start_ms": 262610,
      "end_ms": 267440,
      "text": "你自己在这这些平台里面在宣扬你这个网站"
    },
    {
      "ordinal": 91,
      "start_ms": 268280,
      "end_ms": 270700,
      "text": "你这违法犯罪现行犯"
    },
    {
      "ordinal": 92,
      "start_ms": 271140,
      "end_ms": 272400,
      "text": "你现在还"
    },
    {
      "ordinal": 93,
      "start_ms": 272400,
      "end_ms": 276800,
      "text": "我现在立刻我可以打电话给你所在省份的公安"
    },
    {
      "ordinal": 94,
      "start_ms": 278200,
      "end_ms": 281920,
      "text": "我可以立刻打电话给你所在省份的国家安全"
    },
    {
      "ordinal": 95,
      "start_ms": 281920,
      "end_ms": 285240,
      "text": "或者说啊保卫机构"
    },
    {
      "ordinal": 96,
      "start_ms": 288079,
      "end_ms": 291400,
      "text": "我给你的建议就是你立刻删掉这些东西"
    },
    {
      "ordinal": 97,
      "start_ms": 292360,
      "end_ms": 293820,
      "text": "做一个自我检讨"
    },
    {
      "ordinal": 98,
      "start_ms": 293820,
      "end_ms": 297930,
      "text": "可能到时候相关人员会看在你是个幼稚的人"
    },
    {
      "ordinal": 99,
      "start_ms": 297930,
      "end_ms": 300119,
      "text": "会饶你饶你"
    },
    {
      "ordinal": 100,
      "start_ms": 300119,
      "end_ms": 300659,
      "text": "放你一马"
    },
    {
      "ordinal": 101,
      "start_ms": 300659,
      "end_ms": 303599,
      "text": "我觉得就是说应该这个不会放你一马了"
    },
    {
      "ordinal": 102,
      "start_ms": 303599,
      "end_ms": 305579,
      "text": "但是请你就坦白从宽"
    },
    {
      "ordinal": 103,
      "start_ms": 305579,
      "end_ms": 307520,
      "text": "抗拒从严去自首"
    },
    {
      "ordinal": 104,
      "start_ms": 309220,
      "end_ms": 312060,
      "text": "不要让你的父母亲朋好友担心"
    },
    {
      "ordinal": 105,
      "start_ms": 314600,
      "end_ms": 316660,
      "text": "停止这些违法犯罪活动"
    },
    {
      "ordinal": 106,
      "start_ms": 316660,
      "end_ms": 319480,
      "text": "我我做这样的事情"
    },
    {
      "ordinal": 107,
      "start_ms": 319480,
      "end_ms": 321520,
      "text": "不叫侵犯你的合法权益"
    },
    {
      "ordinal": 108,
      "start_ms": 321520,
      "end_ms": 323200,
      "text": "就是和你这个不合法"
    },
    {
      "ordinal": 109,
      "start_ms": 323200,
      "end_ms": 323500,
      "text": "你知道吗"
    },
    {
      "ordinal": 110,
      "start_ms": 323500,
      "end_ms": 324720,
      "text": "你这是犯罪"
    },
    {
      "ordinal": 111,
      "start_ms": 325460,
      "end_ms": 326380,
      "text": "不是违法"
    },
    {
      "ordinal": 112,
      "start_ms": 326380,
      "end_ms": 327880,
      "text": "你做这些事情是犯罪"
    },
    {
      "ordinal": 113,
      "start_ms": 327880,
      "end_ms": 328840,
      "text": "你知道吗"
    },
    {
      "ordinal": 114,
      "start_ms": 328840,
      "end_ms": 329980,
      "text": "您知道吗"
    },
    {
      "ordinal": 115,
      "start_ms": 329980,
      "end_ms": 331840,
      "text": "您在犯罪你知道吗"
    },
    {
      "ordinal": 116,
      "start_ms": 331840,
      "end_ms": 333610,
      "text": "我揭露你在犯罪"
    },
    {
      "ordinal": 117,
      "start_ms": 333610,
      "end_ms": 337660,
      "text": "我已经向国家安全机构举报了"
    },
    {
      "ordinal": 118,
      "start_ms": 337660,
      "end_ms": 341860,
      "text": "我不想再赤裸裸的直接的向这个公安机关举报"
    },
    {
      "ordinal": 119,
      "start_ms": 341860,
      "end_ms": 343120,
      "text": "那直接就上门就逮你了"
    },
    {
      "ordinal": 120,
      "start_ms": 343120,
      "end_ms": 344120,
      "text": "就说你了"
    },
    {
      "ordinal": 121,
      "start_ms": 346220,
      "end_ms": 347560,
      "text": "我是给你面子"
    },
    {
      "ordinal": 122,
      "start_ms": 347560,
      "end_ms": 348430,
      "text": "你知道吗"
    },
    {
      "ordinal": 123,
      "start_ms": 348430,
      "end_ms": 349750,
      "text": "国家安全机构的话"
    },
    {
      "ordinal": 124,
      "start_ms": 349750,
      "end_ms": 351970,
      "text": "他会考虑这个东西有个轻重缓急"
    },
    {
      "ordinal": 125,
      "start_ms": 351970,
      "end_ms": 354180,
      "text": "或者会会稍微再审慎一点"
    },
    {
      "ordinal": 126,
      "start_ms": 354180,
      "end_ms": 355140,
      "text": "公安机关的话"
    },
    {
      "ordinal": 127,
      "start_ms": 355140,
      "end_ms": 358460,
      "text": "它它是直接就是说要去侦查就侦查了"
    },
    {
      "ordinal": 128,
      "start_ms": 359819,
      "end_ms": 361459,
      "text": "你现在你聪明的话"
    },
    {
