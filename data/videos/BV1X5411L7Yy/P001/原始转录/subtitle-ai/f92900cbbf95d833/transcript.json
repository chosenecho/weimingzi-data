  "content_sha256": "f92900cbbf95d8338d81e0e0390bb57d663dd68c9befce4ce6e7f34c1df3373e",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 1980,
      "end_ms": 5560,
      "text": "我们今天来讲的就是决定论"
    },
    {
      "ordinal": 1,
      "start_ms": 5560,
      "end_ms": 8440,
      "text": "宿命论和这个非决定论自由意志"
    },
    {
      "ordinal": 2,
      "start_ms": 8440,
      "end_ms": 11680,
      "text": "之间的那个辩证法辩证关系了"
    },
    {
      "ordinal": 3,
      "start_ms": 11680,
      "end_ms": 15149,
      "text": "那么它的正体就是未来是确定的"
    },
    {
      "ordinal": 4,
      "start_ms": 15149,
      "end_ms": 17489,
      "text": "整个世界是决定论的啊"
    },
    {
      "ordinal": 5,
      "start_ms": 17489,
      "end_ms": 19840,
      "text": "物质世界是确定的啊"
    },
    {
      "ordinal": 6,
      "start_ms": 19939,
      "end_ms": 21679,
      "text": "你想对应的内在世界里面"
    },
    {
      "ordinal": 7,
      "start_ms": 21679,
      "end_ms": 23839,
      "text": "你所体验的到到的那种自由"
    },
    {
      "ordinal": 8,
      "start_ms": 23839,
      "end_ms": 25680,
      "text": "你的自由意志他是用幻觉"
    },
    {
      "ordinal": 9,
      "start_ms": 25680,
      "end_ms": 27000,
      "text": "没有自由意志可言"
    },
    {
      "ordinal": 10,
      "start_ms": 27000,
      "end_ms": 28440,
      "text": "你没有办法主宰自己的命运"
    },
    {
      "ordinal": 11,
      "start_ms": 28440,
      "end_ms": 29619,
      "text": "这叫宿命论"
    },
    {
      "ordinal": 12,
      "start_ms": 29619,
      "end_ms": 32439,
      "text": "那它的反题呢就是未来是不确定的"
    },
    {
      "ordinal": 13,
      "start_ms": 32439,
      "end_ms": 33789,
      "text": "未来是不确定的"
    },
    {
      "ordinal": 14,
      "start_ms": 33789,
      "end_ms": 36159,
      "text": "那就叫做非决定论啊"
    },
    {
      "ordinal": 15,
      "start_ms": 36159,
      "end_ms": 41040,
      "text": "未来是可能是呃有的废弃确定是概率学大"
    },
    {
      "ordinal": 16,
      "start_ms": 41040,
      "end_ms": 44130,
      "text": "做到未来是某种随机性啊"
    },
    {
      "ordinal": 17,
      "start_ms": 44130,
      "end_ms": 46290,
      "text": "某种反正也有可能是断裂了"
    },
    {
      "ordinal": 18,
      "start_ms": 46290,
      "end_ms": 48030,
      "text": "完全就是荒谬的啊"
    },
    {
      "ordinal": 19,
      "start_ms": 48030,
      "end_ms": 49530,
      "text": "非决定论呃"
    },
    {
      "ordinal": 20,
      "start_ms": 49530,
      "end_ms": 51139,
      "text": "他们内在呃"
    },
    {
      "ordinal": 21,
      "start_ms": 51139,
      "end_ms": 53629,
      "text": "对应的那个版本就是思维是不确定的"
    },
    {
      "ordinal": 22,
      "start_ms": 53629,
      "end_ms": 55789,
      "text": "思维本身是有自由意志"
    },
    {
      "ordinal": 23,
      "start_ms": 55789,
      "end_ms": 57589,
      "text": "是有自由意志可言的"
    },
    {
      "ordinal": 24,
      "start_ms": 57589,
      "end_ms": 59239,
      "text": "你是可以自己嗯"
    },
    {
      "ordinal": 25,
      "start_ms": 59239,
      "end_ms": 63040,
      "text": "非常无中生有的萌发出一些"
    },
    {
      "ordinal": 26,
      "start_ms": 63040,
      "end_ms": 66040,
      "text": "不受物质定律所所控制的啊"
    },
    {
      "ordinal": 27,
      "start_ms": 66040,
      "end_ms": 67160,
      "text": "自由意志"
    },
    {
      "ordinal": 28,
      "start_ms": 67520,
      "end_ms": 70820,
      "text": "那么对于这两个我看出来了"
    },
    {
      "ordinal": 29,
      "start_ms": 70820,
      "end_ms": 71780,
      "text": "实际上它的对立"
    },
    {
      "ordinal": 30,
      "start_ms": 71780,
      "end_ms": 74540,
      "text": "就是这个物质世界和心灵之间的对立嘛"
    },
    {
      "ordinal": 31,
      "start_ms": 74540,
      "end_ms": 76100,
      "text": "这物质世界是决定的"
    },
    {
      "ordinal": 32,
      "start_ms": 76100,
      "end_ms": 78300,
      "text": "是物理学定律决定的啊"
    },
    {
      "ordinal": 33,
      "start_ms": 78300,
      "end_ms": 80880,
      "text": "这个心灵呢它是有自由意志"
    },
    {
      "ordinal": 34,
      "start_ms": 80880,
      "end_ms": 85900,
      "text": "是可以自己萌生出属于他自己的一种自发性的"
    },
    {
      "ordinal": 35,
      "start_ms": 85900,
      "end_ms": 88930,
      "text": "它庸俗的调和就是把这两个东西加起来"
    },
    {
      "ordinal": 36,
      "start_ms": 88930,
      "end_ms": 89980,
      "text": "把这两个东西加起来"
    },
    {
      "ordinal": 37,
      "start_ms": 89980,
      "end_ms": 93990,
      "text": "就是说存在一种东西叫主观能动性"
    },
    {
      "ordinal": 38,
      "start_ms": 93990,
      "end_ms": 94920,
      "text": "主观能动性"
    },
    {
      "ordinal": 39,
      "start_ms": 94920,
      "end_ms": 95580,
      "text": "主观能动性"
    },
    {
      "ordinal": 40,
      "start_ms": 95580,
      "end_ms": 98700,
      "text": "这些东西呢它是呃物质世界"
    },
    {
      "ordinal": 41,
      "start_ms": 98700,
      "end_ms": 100020,
      "text": "底层的物质世界"
    },
    {
      "ordinal": 42,
      "start_ms": 100020,
      "end_ms": 101820,
      "text": "它莫名其妙生成的"
    },
    {
      "ordinal": 43,
      "start_ms": 101820,
      "end_ms": 104310,
      "text": "奥特曼的神经系统构造非常有意思"
    },
    {
      "ordinal": 44,
      "start_ms": 104310,
      "end_ms": 107710,
      "text": "或者有的人甚至说是因为你的神经系统"
    },
    {
      "ordinal": 45,
      "start_ms": 107710,
      "end_ms": 109930,
      "text": "它背后的那种神经细胞啊"
    },
    {
      "ordinal": 46,
      "start_ms": 109930,
      "end_ms": 111970,
      "text": "然后神经元里面还底层的"
    },
    {
      "ordinal": 47,
      "start_ms": 111970,
      "end_ms": 113890,
      "text": "甚至是从量子力学的层面说"
    },
    {
      "ordinal": 48,
      "start_ms": 113890,
      "end_ms": 115660,
      "text": "有测不准不确定性在里面"
    },
    {
      "ordinal": 49,
      "start_ms": 115660,
      "end_ms": 116800,
      "text": "所以你的心灵"
    },
    {
      "ordinal": 50,
      "start_ms": 116800,
      "end_ms": 120440,
      "text": "他就可以自己萌生出某种主观能动性"
    },
    {
      "ordinal": 51,
      "start_ms": 121560,
      "end_ms": 124250,
      "text": "这些整个这些物质定律"
    },
    {
      "ordinal": 52,
      "start_ms": 124250,
      "end_ms": 127100,
      "text": "它所约束不到的是一种剩余"
    },
    {
      "ordinal": 53,
      "start_ms": 127100,
      "end_ms": 130560,
      "text": "是一种就像黑箱黑箱操作里面一样"
    },
    {
      "ordinal": 54,
      "start_ms": 130560,
      "end_ms": 132530,
      "text": "那种说不清道不明的东西"
    },
    {
      "ordinal": 55,
      "start_ms": 132530,
      "end_ms": 134480,
      "text": "那么主观能动性"
    },
    {
      "ordinal": 56,
      "start_ms": 134480,
      "end_ms": 138050,
      "text": "再加上这个物质世界是受规律控制的"
    },
    {
      "ordinal": 57,
      "start_ms": 138050,
      "end_ms": 141420,
      "text": "这两个东西拼到一块儿去叫庸俗的实践论"
    },
    {
      "ordinal": 58,
      "start_ms": 141420,
      "end_ms": 142560,
      "text": "我们叫实践论"
    },
    {
      "ordinal": 59,
      "start_ms": 142560,
      "end_ms": 145740,
      "text": "就是主观能动性可以让人去实践实践"
    },
    {
      "ordinal": 60,
      "start_ms": 145740,
      "end_ms": 147240,
      "text": "可以改变物质世界"
    },
    {
      "ordinal": 61,
      "start_ms": 147240,
      "end_ms": 148620,
      "text": "这些东西结合起来"
    },
    {
      "ordinal": 62,
      "start_ms": 148620,
      "end_ms": 152200,
      "text": "就是我们非常流俗的教科书里面经常讲的"
    },
    {
      "ordinal": 63,
      "start_ms": 152200,
      "end_ms": 153640,
      "text": "庸俗的时间论呢"
    },
    {
      "ordinal": 64,
      "start_ms": 153640,
      "end_ms": 155850,
      "text": "他就是想要掩盖掉这个问题"
    },
    {
      "ordinal": 65,
      "start_ms": 155850,
      "end_ms": 158130,
      "text": "实际上他真正的正确的答案"
    },
    {
      "ordinal": 66,
      "start_ms": 158130,
      "end_ms": 161640,
      "text": "正确的合体就是一开始的未来是确定的"
    },
    {
      "ordinal": 67,
      "start_ms": 161640,
      "end_ms": 163020,
      "text": "未来是确定的"
    },
    {
      "ordinal": 68,
      "start_ms": 163020,
      "end_ms": 166840,
      "text": "但是我们一定要把这个重音放到未来"
    },
    {
      "ordinal": 69,
      "start_ms": 168959,
      "end_ms": 171469,
      "text": "并不是说未来是被确定的"
    },
    {
      "ordinal": 70,
      "start_ms": 171469,
      "end_ms": 172999,
      "text": "未来不是被过去"
    },
    {
      "ordinal": 71,
      "start_ms": 172999,
      "end_ms": 175399,
      "text": "不是被现在所确定的"
    },
    {
      "ordinal": 72,
      "start_ms": 175399,
      "end_ms": 176480,
      "text": "而是恰恰相反"
    },
    {
      "ordinal": 73,
      "start_ms": 176480,
      "end_ms": 180560,
      "text": "现在和过去是被未来确定未来决定的"
    },
    {
      "ordinal": 74,
      "start_ms": 180560,
      "end_ms": 185000,
      "text": "那么具体这个未来是怎么来确定你的当下"
    },
    {
      "ordinal": 75,
      "start_ms": 185000,
      "end_ms": 188160,
      "text": "未来是怎么确定过去的历史的"
    },
    {
      "ordinal": 76,
      "start_ms": 189300,
      "end_ms": 191780,
      "text": "就是这种回溯性的确定性"
    },
    {
      "ordinal": 77,
      "start_ms": 191780,
      "end_ms": 195600,
      "text": "这种反向的因果性才是真正的确定论"
    },
    {
      "ordinal": 78,
      "start_ms": 195600,
      "end_ms": 198120,
      "text": "才是辩证法所要去把握的"
    },
    {
      "ordinal": 79,
      "start_ms": 198120,
      "end_ms": 199820,
      "text": "那个世界运行的规律"
    },
    {
      "ordinal": 80,
      "start_ms": 200119,
      "end_ms": 202489,
      "text": "才是黑格尔意义上必然性"
    },
    {
      "ordinal": 81,
      "start_ms": 202489,
      "end_ms": 205740,
      "text": "那么这个我会再用两讲的时间把它说清楚"
    }
  ],
  "text": "我们今天来讲的就是决定论\n宿命论和这个非决定论自由意志\n之间的那个辩证法辩证关系了\n那么它的正体就是未来是确定的\n整个世界是决定论的啊\n物质世界是确定的啊\n你想对应的内在世界里面\n你所体验的到到的那种自由\n你的自由意志他是用幻觉\n没有自由意志可言\n你没有办法主宰自己的命运\n这叫宿命论\n那它的反题呢就是未来是不确定的\n未来是不确定的\n那就叫做非决定论啊\n未来是可能是呃有的废弃确定是概率学大\n做到未来是某种随机性啊\n某种反正也有可能是断裂了\n完全就是荒谬的啊\n非决定论呃\n他们内在呃\n对应的那个版本就是思维是不确定的\n思维本身是有自由意志\n是有自由意志可言的\n你是可以自己嗯\n非常无中生有的萌发出一些\n不受物质定律所所控制的啊\n自由意志\n那么对于这两个我看出来了\n实际上它的对立\n就是这个物质世界和心灵之间的对立嘛\n这物质世界是决定的\n是物理学定律决定的啊\n这个心灵呢它是有自由意志\n是可以自己萌生出属于他自己的一种自发性的\n它庸俗的调和就是把这两个东西加起来\n把这两个东西加起来\n就是说存在一种东西叫主观能动性\n主观能动性\n主观能动性\n这些东西呢它是呃物质世界\n底层的物质世界\n它莫名其妙生成的\n奥特曼的神经系统构造非常有意思\n或者有的人甚至说是因为你的神经系统\n它背后的那种神经细胞啊\n然后神经元里面还底层的\n甚至是从量子力学的层面说\n有测不准不确定性在里面\n所以你的心灵\n他就可以自己萌生出某种主观能动性\n这些整个这些物质定律\n它所约束不到的是一种剩余\n是一种就像黑箱黑箱操作里面一样\n那种说不清道不明的东西\n那么主观能动性\n再加上这个物质世界是受规律控制的\n这两个东西拼到一块儿去叫庸俗的实践论\n我们叫实践论\n就是主观能动性可以让人去实践实践\n可以改变物质世界\n这些东西结合起来\n就是我们非常流俗的教科书里面经常讲的\n庸俗的时间论呢\n他就是想要掩盖掉这个问题\n实际上他真正的正确的答案\n正确的合体就是一开始的未来是确定的\n未来是确定的\n但是我们一定要把这个重音放到未来\n并不是说未来是被确定的\n未来不是被过去\n不是被现在所确定的\n而是恰恰相反\n现在和过去是被未来确定未来决定的\n那么具体这个未来是怎么来确定你的当下\n未来是怎么确定过去的历史的\n就是这种回溯性的确定性\n这种反向的因果性才是真正的确定论\n才是辩证法所要去把握的\n那个世界运行的规律\n才是黑格尔意义上必然性\n那么这个我会再用两讲的时间把它说清楚",
  "timing_issue": null
}
