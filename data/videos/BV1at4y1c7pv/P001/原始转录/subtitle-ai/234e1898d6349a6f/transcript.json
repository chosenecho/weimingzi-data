  "content_sha256": "234e1898d6349a6f3a5f8c4a5081e4f7607d927c7388bf1912c6aec5371733c6",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 200,
      "end_ms": 1780,
      "text": "我们要说就说"
    },
    {
      "ordinal": 1,
      "start_ms": 8880,
      "end_ms": 11880,
      "text": "呃有策略的"
    },
    {
      "ordinal": 2,
      "start_ms": 14680,
      "end_ms": 16760,
      "text": "和有勇气的"
    },
    {
      "ordinal": 3,
      "start_ms": 20060,
      "end_ms": 23440,
      "text": "目前状况分开来了"
    },
    {
      "ordinal": 4,
      "start_ms": 26120,
      "end_ms": 31220,
      "text": "而且还彼此敌对嗯"
    },
    {
      "ordinal": 5,
      "start_ms": 31220,
      "end_ms": 33080,
      "text": "而且还彼此敌对啊"
    },
    {
      "ordinal": 6,
      "start_ms": 34520,
      "end_ms": 38559,
      "text": "或者说有那种就说"
    },
    {
      "ordinal": 7,
      "start_ms": 42340,
      "end_ms": 43560,
      "text": "互相不沟通"
    },
    {
      "ordinal": 8,
      "start_ms": 43560,
      "end_ms": 44430,
      "text": "你知道吧"
    },
    {
      "ordinal": 9,
      "start_ms": 44430,
      "end_ms": 46820,
      "text": "互相不沟通他们的"
    },
    {
      "ordinal": 10,
      "start_ms": 51380,
      "end_ms": 53350,
      "text": "他们的这个意识形态"
    },
    {
      "ordinal": 11,
      "start_ms": 53350,
      "end_ms": 57320,
      "text": "或者说他们的这个没有一个主义"
    },
    {
      "ordinal": 12,
      "start_ms": 57320,
      "end_ms": 59120,
      "text": "作为他们的中介啊"
    },
    {
      "ordinal": 13,
      "start_ms": 59120,
      "end_ms": 63110,
      "text": "少少了个少了一个主意"
    },
    {
      "ordinal": 14,
      "start_ms": 63110,
      "end_ms": 64260,
      "text": "作为棋"
    },
    {
      "ordinal": 15,
      "start_ms": 66500,
      "end_ms": 67390,
      "text": "中介"
    },
    {
      "ordinal": 16,
      "start_ms": 67390,
      "end_ms": 69760,
      "text": "那么我这个主意被占掉了"
    },
    {
      "ordinal": 17,
      "start_ms": 69760,
      "end_ms": 71259,
      "text": "被占掉了"
    },
    {
      "ordinal": 18,
      "start_ms": 75040,
      "end_ms": 76460,
      "text": "被占掉了"
    },
    {
      "ordinal": 19,
      "start_ms": 78340,
      "end_ms": 82860,
      "text": "唉这勇气好多是鱼勇于勇"
    },
    {
      "ordinal": 20,
      "start_ms": 84900,
      "end_ms": 87020,
      "text": "而这个策略呢有好多"
    },
    {
      "ordinal": 21,
      "start_ms": 87020,
      "end_ms": 90860,
      "text": "只是就是说退无可退的"
    },
    {
      "ordinal": 22,
      "start_ms": 94080,
      "end_ms": 96740,
      "text": "都是就是说能不能少损失点"
    },
    {
      "ordinal": 23,
      "start_ms": 96740,
      "end_ms": 98939,
      "text": "少损失点这个策略"
    },
    {
      "ordinal": 24,
      "start_ms": 98939,
      "end_ms": 104600,
      "text": "把少损失当成是把少损失当成是胜利"
    },
    {
      "ordinal": 25,
      "start_ms": 107480,
      "end_ms": 110340,
      "text": "但说我们不是不知道"
    },
    {
      "ordinal": 26,
      "start_ms": 112040,
      "end_ms": 113539,
      "text": "我们不是不知道"
    },
    {
      "ordinal": 27,
      "start_ms": 121420,
      "end_ms": 123900,
      "text": "于是工商拿到赔偿款"
    },
    {
      "ordinal": 28,
      "start_ms": 124980,
      "end_ms": 126200,
      "text": "这叫胜利吗"
    },
    {
      "ordinal": 29,
      "start_ms": 129360,
      "end_ms": 131300,
      "text": "那么这个就算了"
    },
    {
      "ordinal": 30,
      "start_ms": 131300,
      "end_ms": 132830,
      "text": "这不叫胜利啊"
    },
    {
      "ordinal": 31,
      "start_ms": 132830,
      "end_ms": 134780,
      "text": "这是少损失吗"
    },
    {
      "ordinal": 32,
      "start_ms": 135540,
      "end_ms": 138500,
      "text": "少损失这个损失是很慎重的"
    },
    {
      "ordinal": 33,
      "start_ms": 138500,
      "end_ms": 140500,
      "text": "无非是少损失一点点"
    },
    {
      "ordinal": 34,
      "start_ms": 140579,
      "end_ms": 141839,
      "text": "赚这个差额"
    },
    {
      "ordinal": 35,
      "start_ms": 141839,
      "end_ms": 145360,
      "text": "两笔损失中间的差额他本来就是我的"
    },
    {
      "ordinal": 36,
      "start_ms": 145519,
      "end_ms": 148060,
      "text": "或者说我根本不应该承担这个损失"
    },
    {
      "ordinal": 37,
      "start_ms": 148579,
      "end_ms": 150349,
      "text": "退无可退的"
    },
    {
      "ordinal": 38,
      "start_ms": 150349,
      "end_ms": 152120,
      "text": "他不能叫胜利"
    },
    {
      "ordinal": 39,
      "start_ms": 152239,
      "end_ms": 154999,
      "text": "所以这个策略啊也是一个很可悲的"
    },
    {
      "ordinal": 40,
      "start_ms": 154999,
      "end_ms": 156630,
      "text": "就是说现实可悲啊"
    },
    {
      "ordinal": 41,
      "start_ms": 156630,
      "end_ms": 159150,
      "text": "不是说我们执行这些策略本身可悲"
    },
    {
      "ordinal": 42,
      "start_ms": 159150,
      "end_ms": 161550,
      "text": "这个挣扎着能够维护一点力"
    },
    {
      "ordinal": 43,
      "start_ms": 161550,
      "end_ms": 164040,
      "text": "维护一些事一些这不可悲"
    },
    {
      "ordinal": 44,
      "start_ms": 164600,
      "end_ms": 166570,
      "text": "而是说这个局面可悲"
    },
    {
      "ordinal": 45,
      "start_ms": 166570,
      "end_ms": 169060,
      "text": "导致我们不得不这样的那个局面"
    },
    {
      "ordinal": 46,
      "start_ms": 169060,
      "end_ms": 170580,
      "text": "那个状况可悲"
    },
    {
      "ordinal": 47,
      "start_ms": 172100,
      "end_ms": 174250,
      "text": "所以哪怕有这个策略"
    },
    {
      "ordinal": 48,
      "start_ms": 174250,
      "end_ms": 176320,
      "text": "它往往是下策"
    },
    {
      "ordinal": 49,
      "start_ms": 178119,
      "end_ms": 180749,
      "text": "于勇和下策没办法的"
    },
    {
      "ordinal": 50,
      "start_ms": 180749,
      "end_ms": 182820,
      "text": "不得不出此下策"
    },
    {
      "ordinal": 51,
      "start_ms": 185360,
      "end_ms": 190430,
      "text": "一枪鱼勇一向与勇和这个下策之间"
    },
    {
      "ordinal": 52,
      "start_ms": 190430,
      "end_ms": 195180,
      "text": "由于这个现实矛盾太尖锐了"
    },
    {
      "ordinal": 53,
      "start_ms": 196980,
      "end_ms": 199760,
      "text": "还会冲突还会冲突"
    },
    {
      "ordinal": 54,
      "start_ms": 200459,
      "end_ms": 202039,
      "text": "我说这个鱼勇啊"
    },
    {
      "ordinal": 55,
      "start_ms": 202039,
      "end_ms": 206180,
      "text": "这个鱼勇为了让自己好像是啊绅士"
    },
    {
      "ordinal": 56,
      "start_ms": 206180,
      "end_ms": 207620,
      "text": "有点绅士"
    },
    {
      "ordinal": 57,
      "start_ms": 207620,
      "end_ms": 209960,
      "text": "竟然还他妈的分离主义"
    },
    {
      "ordinal": 58,
      "start_ms": 209960,
      "end_ms": 211300,
      "text": "这个你不能碰的"
    },
    {
      "ordinal": 59,
      "start_ms": 211480,
      "end_ms": 213370,
      "text": "和一些分类主义"
    },
    {
      "ordinal": 60,
      "start_ms": 213370,
      "end_ms": 215620,
      "text": "或者说还和一些托派"
    },
    {
      "ordinal": 61,
      "start_ms": 216439,
      "end_ms": 218019,
      "text": "这个都不能碰的"
    },
    {
      "ordinal": 62,
      "start_ms": 218019,
      "end_ms": 219639,
      "text": "但是这些这场雨"
    },
    {
      "ordinal": 63,
      "start_ms": 219639,
      "end_ms": 222980,
      "text": "有的人就是说就是说你明白吧"
    },
    {
      "ordinal": 64,
      "start_ms": 222980,
      "end_ms": 225980,
      "text": "这个这个这个托派不是指的"
    },
    {
      "ordinal": 65,
      "start_ms": 225980,
      "end_ms": 228829,
      "text": "就是说就是凤"
    },
    {
      "ordinal": 66,
      "start_ms": 228829,
      "end_ms": 230929,
      "text": "就是说他是组织上的"
    },
    {
      "ordinal": 67,
      "start_ms": 230929,
      "end_ms": 234420,
      "text": "他是境外组织意义上的"
    },
    {
      "ordinal": 68,
      "start_ms": 235540,
      "end_ms": 238620,
      "text": "我这个这个指着这个派不是指的"
    },
    {
      "ordinal": 69,
      "start_ms": 238620,
      "end_ms": 243179,
      "text": "就是说他他这个就是说不断革命论"
    },
    {
      "ordinal": 70,
      "start_ms": 243179,
      "end_ms": 245879,
      "text": "他这个赞同托了茨基的观点"
    },
    {
      "ordinal": 71,
      "start_ms": 245879,
      "end_ms": 246119,
      "text": "不"
    },
    {
      "ordinal": 72,
      "start_ms": 246119,
      "end_ms": 251160,
      "text": "是指这个他说他是直接是接受境外组织"
    },
    {
      "ordinal": 73,
      "start_ms": 251160,
      "end_ms": 252360,
      "text": "境外的"
    },
    {
      "ordinal": 74,
      "start_ms": 252360,
      "end_ms": 256640,
      "text": "打着第四国际组组织旗号的那些人的"
    },
    {
      "ordinal": 75,
      "start_ms": 256880,
      "end_ms": 258890,
      "text": "组织上的托盘"
    },
    {
      "ordinal": 76,
      "start_ms": 258890,
      "end_ms": 260839,
      "text": "还有分离主义这种东西"
    },
    {
      "ordinal": 77,
      "start_ms": 260839,
      "end_ms": 262160,
      "text": "在我看来都是"
    },
    {
      "ordinal": 78,
      "start_ms": 262420,
      "end_ms": 267720,
      "text": "no you can't不可联合不可联合"
    },
    {
      "ordinal": 79,
      "start_ms": 268340,
      "end_ms": 270020,
      "text": "就他资产阶级一化"
    },
    {
      "ordinal": 80,
      "start_ms": 270020,
      "end_ms": 270380,
      "text": "你知道吗"
    },
    {
      "ordinal": 81,
      "start_ms": 270380,
      "end_ms": 271940,
      "text": "这个境外的这个这些"
    },
    {
      "ordinal": 82,
      "start_ms": 271940,
      "end_ms": 274640,
      "text": "已经是已经是就是北欧"
    },
    {
      "ordinal": 83,
      "start_ms": 274640,
      "end_ms": 278920,
      "text": "或者说南欧的一些游戏者"
    },
    {
      "ordinal": 84,
      "start_ms": 279020,
      "end_ms": 281600,
      "text": "妈的很不严肃的游戏者"
    },
    {
      "ordinal": 85,
      "start_ms": 281600,
      "end_ms": 284120,
      "text": "或者说就是打着这个幌子"
    },
    {
      "ordinal": 86,
      "start_ms": 284120,
      "end_ms": 285110,
      "text": "颠覆者"
    },
    {
      "ordinal": 87,
      "start_ms": 285110,
      "end_ms": 287780,
      "text": "打这个幌子来过来搞事情的"
    },
    {
      "ordinal": 88,
      "start_ms": 288579,
      "end_ms": 290579,
      "text": "他这个鱼涌太他妈鱼了"
    },
    {
      "ordinal": 89,
      "start_ms": 290579,
      "end_ms": 292439,
      "text": "鱼的没有意识形态眼力"
    },
    {
      "ordinal": 90,
      "start_ms": 292439,
      "end_ms": 295380,
      "text": "见人没有一点点自己的长远路径了"
    },
    {
      "ordinal": 91,
      "start_ms": 295680,
      "end_ms": 298860,
      "text": "这个鱼有鱼的已经是一种就是说我所所谓"
    },
    {
      "ordinal": 92,
      "start_ms": 298860,
      "end_ms": 301160,
      "text": "的就是召回派那个医生了"
    },
    {
      "ordinal": 93,
      "start_ms": 301840,
      "end_ms": 304440,
      "text": "已经他妈的是召回派医生的"
    },
    {
      "ordinal": 94,
      "start_ms": 304440,
      "end_ms": 305700,
      "text": "没有自己长远路径"
    },
    {
      "ordinal": 95,
      "start_ms": 305700,
      "end_ms": 306900,
      "text": "太他妈鱼了"
    },
    {
      "ordinal": 96,
      "start_ms": 306900,
      "end_ms": 309539,
      "text": "鱼的鱼的都饿了"
    },
    {
      "ordinal": 97,
      "start_ms": 309539,
      "end_ms": 311549,
      "text": "鱼这都已经是饿了"
    },
    {
      "ordinal": 98,
      "start_ms": 311549,
      "end_ms": 313319,
      "text": "犯错了或至少是错了"
    },
    {
      "ordinal": 99,
      "start_ms": 313319,
      "end_ms": 314429,
      "text": "不说饿了"
    },
    {
      "ordinal": 100,
      "start_ms": 314429,
      "end_ms": 316360,
      "text": "犯严重错误了"
    },
    {
      "ordinal": 101,
      "start_ms": 316380,
      "end_ms": 317700,
      "text": "好好反思反思"
    },
    {
      "ordinal": 102,
      "start_ms": 319740,
      "end_ms": 321560,
      "text": "你这些语用能帮人"
    },
    {
      "ordinal": 103,
      "start_ms": 340740,
      "end_ms": 341960,
      "text": "而不仅是错"
    },
    {
      "ordinal": 104,
      "start_ms": 341960,
      "end_ms": 343610,
      "text": "还铸成大错"
    },
    {
      "ordinal": 105,
      "start_ms": 343610,
      "end_ms": 346400,
      "text": "还铸成原则上的大错"
    },
    {
      "ordinal": 106,
      "start_ms": 346400,
      "end_ms": 349960,
      "text": "原则上的就是说一个根本性的大错"
    },
    {
      "ordinal": 107,
      "start_ms": 355079,
      "end_ms": 357559,
      "text": "那么所以说这这帮人啊"
    },
    {
      "ordinal": 108,
      "start_ms": 357559,
      "end_ms": 362640,
      "text": "目前就是除非我们就除非洗心革面"
    },
    {
      "ordinal": 109,
      "start_ms": 362640,
      "end_ms": 364480,
      "text": "洗心革面"
    },
    {
      "ordinal": 110,
      "start_ms": 366100,
      "end_ms": 368940,
      "text": "就这四个字喜性格面前有喜性"
    },
    {
      "ordinal": 111,
      "start_ms": 368940,
      "end_ms": 371340,
      "text": "革命与勇"
    },
    {
      "ordinal": 112,
      "start_ms": 372460,
      "end_ms": 374700,
      "text": "白兰仗势着于勇"
    },
    {
      "ordinal": 113,
      "start_ms": 374700,
      "end_ms": 377000,
      "text": "去做极端错误的事情"
    },
    {
      "ordinal": 114,
      "start_ms": 380100,
      "end_ms": 382040,
      "text": "去让别人做的牺牲品"
    },
    {
      "ordinal": 115,
      "start_ms": 382040,
      "end_ms": 383040,
      "text": "陪葬品"
    },
    {
      "ordinal": 116,
      "start_ms": 385960,
      "end_ms": 388080,
      "text": "完全沉你一时威风"
    },
    {
      "ordinal": 117,
      "start_ms": 390480,
      "end_ms": 392120,
      "text": "把别人当道具"
    },
    {
      "ordinal": 118,
      "start_ms": 392840,
      "end_ms": 398480,
      "text": "当殉葬品去给你的牺牲增光添彩"
    },
    {
      "ordinal": 119,
      "start_ms": 399759,
      "end_ms": 401099,
      "text": "这是极为可耻"
    },
    {
      "ordinal": 120,
      "start_ms": 402119,
      "end_ms": 403379,
      "text": "不应当如此啊"
    },
    {
      "ordinal": 121,
      "start_ms": 403379,
      "end_ms": 404280,
      "text": "不应当如此"
    },
    {
      "ordinal": 122,
      "start_ms": 405660,
      "end_ms": 407760,
      "text": "根本不能这样做"
    },
    {
      "ordinal": 123,
      "start_ms": 408159,
      "end_ms": 410139,
      "text": "要阻止他"
    },
    {
      "ordinal": 124,
      "start_ms": 410139,
      "end_ms": 412740,
      "text": "我们应该尽全力阻止他们"
    },
    {
      "ordinal": 125,
      "start_ms": 413960,
      "end_ms": 417680,
      "text": "阻止他们孤立他们"
    },
    {
      "ordinal": 126,
      "start_ms": 420420,
      "end_ms": 421940,
      "text": "吃多了他们的名义"
    },
    {
      "ordinal": 127,
      "start_ms": 424040,
      "end_ms": 425760,
      "text": "啊这是一方面的事"
    },
    {
      "ordinal": 128,
      "start_ms": 426560,
      "end_ms": 429820,
      "text": "另一方面呢就是说对于出下策"
    },
    {
      "ordinal": 129,
      "start_ms": 429820,
      "end_ms": 431280,
      "text": "出此下策的"
    },
    {
      "ordinal": 130,
      "start_ms": 431539,
      "end_ms": 434689,
      "text": "我们不应当简单的把它们理解为"
    },
    {
      "ordinal": 131,
      "start_ms": 434689,
      "end_ms": 436140,
      "text": "他们就是取消派"
    },
    {
      "ordinal": 132,
      "start_ms": 439500,
      "end_ms": 441980,
      "text": "不能简简单单扣取消派的帽子"
    },
    {
      "ordinal": 133,
      "start_ms": 443420,
      "end_ms": 444280,
      "text": "出此下策"
    },
    {
      "ordinal": 134,
      "start_ms": 444280,
      "end_ms": 446260,
