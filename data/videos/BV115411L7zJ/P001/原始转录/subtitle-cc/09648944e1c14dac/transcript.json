  "content_sha256": "09648944e1c14daceed0d645b472d9c996d01e3f026c94f2171bcc22e5261524",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 2680,
      "end_ms": 3880,
      "text": "今天我们来讲一个"
    },
    {
      "ordinal": 1,
      "start_ms": 3880,
      "end_ms": 7600,
      "text": "特别在学校、基础教育或者高中"
    },
    {
      "ordinal": 2,
      "start_ms": 7640,
      "end_ms": 8720,
      "text": "特别被提到的"
    },
    {
      "ordinal": 3,
      "start_ms": 8760,
      "end_ms": 10360,
      "text": "就是个人和集体的关系问题"
    },
    {
      "ordinal": 4,
      "start_ms": 10360,
      "end_ms": 11200,
      "text": "我把它扩大一点"
    },
    {
      "ordinal": 5,
      "start_ms": 11240,
      "end_ms": 13000,
      "text": "叫个人和社会的关系问题"
    },
    {
      "ordinal": 6,
      "start_ms": 13360,
      "end_ms": 14160,
      "text": "那么它的正题"
    },
    {
      "ordinal": 7,
      "start_ms": 14280,
      "end_ms": 14880,
      "text": "就是说"
    },
    {
      "ordinal": 8,
      "start_ms": 14880,
      "end_ms": 16560,
      "text": "个人决定了社会"
    },
    {
      "ordinal": 9,
      "start_ms": 17000,
      "end_ms": 18480,
      "text": "这个是昂格鲁萨克逊"
    },
    {
      "ordinal": 10,
      "start_ms": 18520,
      "end_ms": 20280,
      "text": "就是英国和美国"
    },
    {
      "ordinal": 11,
      "start_ms": 20640,
      "end_ms": 21600,
      "text": "或者说澳大利亚"
    },
    {
      "ordinal": 12,
      "start_ms": 21600,
      "end_ms": 22040,
      "text": "加拿大"
    },
    {
      "ordinal": 13,
      "start_ms": 22840,
      "end_ms": 24200,
      "text": "这些国家的传统里面"
    },
    {
      "ordinal": 14,
      "start_ms": 24280,
      "end_ms": 25440,
      "text": "因为这些国家"
    },
    {
      "ordinal": 15,
      "start_ms": 25480,
      "end_ms": 27040,
      "text": "它们都对外殖民"
    },
    {
      "ordinal": 16,
      "start_ms": 27080,
      "end_ms": 29160,
      "text": "相当于是一个个体"
    },
    {
      "ordinal": 17,
      "start_ms": 29160,
      "end_ms": 30480,
      "text": "骑匹马扛把枪"
    },
    {
      "ordinal": 18,
      "start_ms": 30520,
      "end_ms": 31560,
      "text": "就在殖民地上"
    },
    {
      "ordinal": 19,
      "start_ms": 32119,
      "end_ms": 33240,
      "text": "单枪匹马作战的"
    },
    {
      "ordinal": 20,
      "start_ms": 33240,
      "end_ms": 34360,
      "text": "所以它们的社会"
    },
    {
      "ordinal": 21,
      "start_ms": 34360,
      "end_ms": 36760,
      "text": "实际上就是由原子化的个人"
    },
    {
      "ordinal": 22,
      "start_ms": 36760,
      "end_ms": 38200,
      "text": "一个个像原子一样"
    },
    {
      "ordinal": 23,
      "start_ms": 38320,
      "end_ms": 40920,
      "text": "原子化的个人组合而成的"
    },
    {
      "ordinal": 24,
      "start_ms": 42880,
      "end_ms": 44880,
      "text": "这种社会观"
    },
    {
      "ordinal": 25,
      "start_ms": 44880,
      "end_ms": 46360,
      "text": "这种个人主义社会观"
    },
    {
      "ordinal": 26,
      "start_ms": 46400,
      "end_ms": 47320,
      "text": "它的一个反面"
    },
    {
      "ordinal": 27,
      "start_ms": 47320,
      "end_ms": 49820,
      "text": "就是所谓的社会决定个人"
    },
    {
      "ordinal": 28,
      "start_ms": 49820,
      "end_ms": 51040,
      "text": "社会决定个人"
    },
    {
      "ordinal": 29,
      "start_ms": 51040,
      "end_ms": 53350,
      "text": "代表的思想家就是"
    },
    {
      "ordinal": 30,
      "start_ms": 53600,
      "end_ms": 56920,
      "text": "现代社会学的创始人，叫涂尔干"
    },
    {
      "ordinal": 31,
      "start_ms": 56960,
      "end_ms": 58480,
      "text": "法国社会学家涂尔干"
    },
    {
      "ordinal": 32,
      "start_ms": 58480,
      "end_ms": 60680,
      "text": "他认为社会是一个有机体"
    },
    {
      "ordinal": 33,
      "start_ms": 60680,
      "end_ms": 62520,
      "text": "这个有机体是优先于"
    },
    {
      "ordinal": 34,
      "start_ms": 62520,
      "end_ms": 64800,
      "text": "先于单个的个体存在的"
    },
    {
      "ordinal": 35,
      "start_ms": 64800,
      "end_ms": 66120,
      "text": "每个个体的自我认知"
    },
    {
      "ordinal": 36,
      "start_ms": 66160,
      "end_ms": 68040,
      "text": "他在这个有机体里面"
    },
    {
      "ordinal": 37,
      "start_ms": 68080,
      "end_ms": 69560,
      "text": "分层的是在哪一层"
    },
    {
      "ordinal": 38,
      "start_ms": 69720,
      "end_ms": 71560,
      "text": "然后以什么样的方式生活"
    },
    {
      "ordinal": 39,
      "start_ms": 71560,
      "end_ms": 73840,
      "text": "都是由有机体本身来决定的"
    },
    {
      "ordinal": 40,
      "start_ms": 75050,
      "end_ms": 78920,
      "text": "叫做“社会优先于个人”"
    },
    {
      "ordinal": 41,
      "start_ms": 79760,
      "end_ms": 81880,
      "text": "那么它的一个庸俗的合题"
    },
    {
      "ordinal": 42,
      "start_ms": 81880,
      "end_ms": 84960,
      "text": "一般会被各个国家"
    },
    {
      "ordinal": 43,
      "start_ms": 84960,
      "end_ms": 86600,
      "text": "很多文明采用"
    },
    {
      "ordinal": 44,
      "start_ms": 86640,
      "end_ms": 88240,
      "text": "用来克服这种矛盾"
    },
    {
      "ordinal": 45,
      "start_ms": 88240,
      "end_ms": 89880,
      "text": "克服个人与社会之间矛盾的"
    },
    {
      "ordinal": 46,
      "start_ms": 89880,
      "end_ms": 90840,
      "text": "庸俗合题"
    },
    {
      "ordinal": 47,
      "start_ms": 90840,
      "end_ms": 94920,
      "text": "就是叫做和谐社会"
    },
    {
      "ordinal": 48,
      "start_ms": 95080,
      "end_ms": 96760,
      "text": "就是社会和个人的和谐相处"
    },
    {
      "ordinal": 49,
      "start_ms": 96760,
      "end_ms": 98360,
      "text": "那么体现在生活中"
    },
    {
      "ordinal": 50,
      "start_ms": 98360,
      "end_ms": 101080,
      "text": "就是一种中产阶级化的文明礼貌"
    },
    {
      "ordinal": 51,
      "start_ms": 101120,
      "end_ms": 102160,
      "text": "还包括洁净"
    },
    {
      "ordinal": 52,
      "start_ms": 103080,
      "end_ms": 104440,
      "text": "搞各种“文明”"
    },
    {
      "ordinal": 53,
      "start_ms": 106720,
      "end_ms": 108720,
      "text": "我国就是会有各种“文明”"
    },
    {
      "ordinal": 54,
      "start_ms": 109040,
      "end_ms": 110600,
      "text": "或者说“清洁城市"
    },
    {
      "ordinal": 55,
      "start_ms": 110600,
      "end_ms": 112440,
      "text": "大比拼”这种东西啊"
    },
    {
      "ordinal": 56,
      "start_ms": 112600,
      "end_ms": 113640,
      "text": "但是实际上"
    },
    {
      "ordinal": 57,
      "start_ms": 113640,
      "end_ms": 115120,
      "text": "这个玩意是很有问题的"
    },
    {
      "ordinal": 58,
      "start_ms": 115160,
      "end_ms": 117000,
      "text": "因为它还是没有解决"
    },
    {
      "ordinal": 59,
      "start_ms": 117000,
      "end_ms": 118200,
      "text": "社会和个人的矛盾"
    },
    {
      "ordinal": 60,
      "start_ms": 118200,
      "end_ms": 121320,
      "text": "而且要去改变整个社会"
    },
    {
      "ordinal": 61,
      "start_ms": 121840,
      "end_ms": 123800,
      "text": "比去改变"
    },
    {
      "ordinal": 62,
      "start_ms": 124160,
      "end_ms": 127120,
      "text": "或者去压制一个个人要难的多"
    },
    {
      "ordinal": 63,
      "start_ms": 127120,
      "end_ms": 128240,
      "text": "大部分情况下"
    },
    {
      "ordinal": 64,
      "start_ms": 128240,
      "end_ms": 129759,
      "text": "就是在这种"
    },
    {
      "ordinal": 65,
      "start_ms": 130039,
      "end_ms": 133080,
      "text": "温文尔雅的中产化的这种"
    },
    {
      "ordinal": 66,
      "start_ms": 133080,
      "end_ms": 134520,
      "text": "礼貌的"
    },
    {
      "ordinal": 67,
      "start_ms": 134560,
      "end_ms": 136280,
      "text": "文明礼貌的遮盖之下"
    },
    {
      "ordinal": 68,
      "start_ms": 136280,
      "end_ms": 139680,
      "text": "是对很多比较惨痛的个体"
    },
    {
      "ordinal": 69,
      "start_ms": 139680,
      "end_ms": 140880,
      "text": "他比较有否定性的"
    },
    {
      "ordinal": 70,
      "start_ms": 140880,
      "end_ms": 142880,
      "text": "个体的一种压迫和压制"
    },
    {
      "ordinal": 71,
      "start_ms": 143680,
      "end_ms": 145640,
      "text": "这是一个庸俗的合题"
    },
    {
      "ordinal": 72,
      "start_ms": 145720,
      "end_ms": 146720,
      "text": "也是很多国家"
    },
    {
      "ordinal": 73,
      "start_ms": 146720,
      "end_ms": 148680,
      "text": "它现在运行的一个基本模式"
    },
    {
      "ordinal": 74,
      "start_ms": 148960,
      "end_ms": 149960,
      "text": "那么它真正的合题"
    },
    {
      "ordinal": 75,
      "start_ms": 150200,
      "end_ms": 150760,
      "text": "真正的合题"
    },
    {
      "ordinal": 76,
      "start_ms": 150800,
      "end_ms": 152840,
      "text": "就是我说的叫阿尔都塞主义"
    },
    {
      "ordinal": 77,
      "start_ms": 152840,
      "end_ms": 153520,
      "text": "阿尔都塞主义"
    },
    {
      "ordinal": 78,
      "start_ms": 153560,
      "end_ms": 154960,
      "text": "就是你要看出"
    },
    {
      "ordinal": 79,
      "start_ms": 155000,
      "end_ms": 157000,
      "text": "所谓的“个人优先于社会”"
    },
    {
      "ordinal": 80,
      "start_ms": 157040,
      "end_ms": 157920,
      "text": "这里的“个人”"
    },
    {
      "ordinal": 81,
      "start_ms": 157920,
      "end_ms": 159240,
      "text": "并不是你自己"
    },
    {
      "ordinal": 82,
      "start_ms": 159280,
      "end_ms": 160440,
      "text": "而是一种"
    },
    {
      "ordinal": 83,
      "start_ms": 161280,
      "end_ms": 163680,
      "text": "而是这个社会所提供给你的"
    },
    {
      "ordinal": 84,
      "start_ms": 163680,
      "end_ms": 166120,
      "text": "或者说是意识形态所灌输给你的"
    },
    {
      "ordinal": 85,
      "start_ms": 166120,
      "end_ms": 168960,
      "text": "对于你“个人”的一个“自我”的认知"
    },
    {
      "ordinal": 86,
      "start_ms": 169520,
      "end_ms": 172040,
      "text": "在阿尔都塞那边就叫"
    },
    {
      "ordinal": 87,
      "start_ms": 172120,
      "end_ms": 173840,
      "text": "社会这个大的主体"
    },
    {
      "ordinal": 88,
      "start_ms": 173920,
      "end_ms": 177240,
      "text": "祂把一个个的个体征召过来"
    },
    {
      "ordinal": 89,
      "start_ms": 177480,
      "end_ms": 180920,
      "text": "征召，像法院质询一样"
    },
    {
      "ordinal": 90,
      "start_ms": 180960,
      "end_ms": 182240,
      "text": "叫过来叫你质询"
    },
    {
      "ordinal": 91,
      "start_ms": 182600,
      "end_ms": 183880,
      "text": "认自己有罪"
    },
    {
      "ordinal": 92,
      "start_ms": 183960,
      "end_ms": 185360,
      "text": "在这个过程当中"
    },
    {
      "ordinal": 93,
      "start_ms": 185520,
      "end_ms": 188280,
      "text": "你这个个体就会把自己塑造成一个"
    },
    {
      "ordinal": 94,
      "start_ms": 188600,
      "end_ms": 190880,
      "text": "认同为一个臣民：subject"
    },
    {
      "ordinal": 95,
      "start_ms": 191160,
      "end_ms": 192400,
      "text": "一个所谓的“个体”"
    },
    {
      "ordinal": 96,
      "start_ms": 192480,
      "end_ms": 194400,
      "text": "实际上所谓的“个体”"
    },
    {
      "ordinal": 97,
      "start_ms": 194520,
      "end_ms": 195880,
      "text": "有的时候你也会觉得"
    },
    {
      "ordinal": 98,
      "start_ms": 195880,
      "end_ms": 197760,
      "text": "自己就是个孤零零的、原子化的"
    },
    {
      "ordinal": 99,
      "start_ms": 197760,
      "end_ms": 198850,
      "text": "无依无靠的个体"
    },
    {
      "ordinal": 100,
      "start_ms": 198850,
      "end_ms": 200080,
      "text": "这种个体观"
    },
    {
      "ordinal": 101,
      "start_ms": 200080,
      "end_ms": 201480,
      "text": "这种“自我”认同"
    },
    {
      "ordinal": 102,
      "start_ms": 201480,
      "end_ms": 202760,
      "text": "它是现代社会"
    },
    {
      "ordinal": 103,
      "start_ms": 202760,
      "end_ms": 205000,
      "text": "特别是现代资本主义社会的一个基石"
    },
    {
      "ordinal": 104,
      "start_ms": 205000,
      "end_ms": 206960,
      "text": "所以我们说这种“个人”"
    },
    {
      "ordinal": 105,
      "start_ms": 207000,
      "end_ms": 208200,
      "text": "这种“个人”观"
    },
    {
      "ordinal": 106,
      "start_ms": 208200,
      "end_ms": 209880,
      "text": "它是优先于社会的"
    }
  ],
  "text": "今天我们来讲一个\n特别在学校、基础教育或者高中\n特别被提到的\n就是个人和集体的关系问题\n我把它扩大一点\n叫个人和社会的关系问题\n那么它的正题\n就是说\n个人决定了社会\n这个是昂格鲁萨克逊\n就是英国和美国\n或者说澳大利亚\n加拿大\n这些国家的传统里面\n因为这些国家\n它们都对外殖民\n相当于是一个个体\n骑匹马扛把枪\n就在殖民地上\n单枪匹马作战的\n所以它们的社会\n实际上就是由原子化的个人\n一个个像原子一样\n原子化的个人组合而成的\n这种社会观\n这种个人主义社会观\n它的一个反面\n就是所谓的社会决定个人\n社会决定个人\n代表的思想家就是\n现代社会学的创始人，叫涂尔干\n法国社会学家涂尔干\n他认为社会是一个有机体\n这个有机体是优先于\n先于单个的个体存在的\n每个个体的自我认知\n他在这个有机体里面\n分层的是在哪一层\n然后以什么样的方式生活\n都是由有机体本身来决定的\n叫做“社会优先于个人”\n那么它的一个庸俗的合题\n一般会被各个国家\n很多文明采用\n用来克服这种矛盾\n克服个人与社会之间矛盾的\n庸俗合题\n就是叫做和谐社会\n就是社会和个人的和谐相处\n那么体现在生活中\n就是一种中产阶级化的文明礼貌\n还包括洁净\n搞各种“文明”\n我国就是会有各种“文明”\n或者说“清洁城市\n大比拼”这种东西啊\n但是实际上\n这个玩意是很有问题的\n因为它还是没有解决\n社会和个人的矛盾\n而且要去改变整个社会\n比去改变\n或者去压制一个个人要难的多\n大部分情况下\n就是在这种\n温文尔雅的中产化的这种\n礼貌的\n文明礼貌的遮盖之下\n是对很多比较惨痛的个体\n他比较有否定性的\n个体的一种压迫和压制\n这是一个庸俗的合题\n也是很多国家\n它现在运行的一个基本模式\n那么它真正的合题\n真正的合题\n就是我说的叫阿尔都塞主义\n阿尔都塞主义\n就是你要看出\n所谓的“个人优先于社会”\n这里的“个人”\n并不是你自己\n而是一种\n而是这个社会所提供给你的\n或者说是意识形态所灌输给你的\n对于你“个人”的一个“自我”的认知\n在阿尔都塞那边就叫\n社会这个大的主体\n祂把一个个的个体征召过来\n征召，像法院质询一样\n叫过来叫你质询\n认自己有罪\n在这个过程当中\n你这个个体就会把自己塑造成一个\n认同为一个臣民：subject\n一个所谓的“个体”\n实际上所谓的“个体”\n有的时候你也会觉得\n自己就是个孤零零的、原子化的\n无依无靠的个体\n这种个体观\n这种“自我”认同\n它是现代社会\n特别是现代资本主义社会的一个基石\n所以我们说这种“个人”\n这种“个人”观\n它是优先于社会的",
  "timing_issue": null
}
