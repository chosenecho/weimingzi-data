    {
      "ordinal": 42,
      "start_ms": 101690,
      "end_ms": 103310,
      "text": "比如说我怎么去行动啊"
    },
    {
      "ordinal": 43,
      "start_ms": 103310,
      "end_ms": 104210,
      "text": "怎么去思考啊"
