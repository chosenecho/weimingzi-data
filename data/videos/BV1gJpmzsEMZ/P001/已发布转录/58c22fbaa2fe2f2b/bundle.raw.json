{"segments":[{"start":0.16,"end":1.72,"text":"这团队发展最重要的事情呢"},{"start":1.72,"end":4.059,"text":"其实不是什么要传多漂亮"},{"start":4.059,"end":6.0,"text":"多怎么花里胡哨的"},{"start":7.08,"end":12.29,"text":"这个项目能做项目我们都做了啊"},{"start":12.29,"end":15.15,"text":"在就法律范围内能做的"},{"start":15.87,"end":22.05,"text":"甚至带有一点这个呃这个模糊界限性质的"},{"start":22.05,"end":24.09,"text":"所有能做的我们都做了"},{"start":24.09,"end":27.29,"text":"那现在关键问题是并不是说什么项目做了"},{"start":27.29,"end":29.21,"text":"或者说要做很多"},{"start":29.21,"end":31.62,"text":"或者只要啊复制裂变这东西"},{"start":31.62,"end":33.24,"text":"项目不是重要的啊"},{"start":33.24,"end":34.4,"text":"人的培养是重要的"},{"start":34.4,"end":36.04,"text":"人才的培养是重要的"},{"start":36.04,"end":43.96,"text":"现在这个呃就是说人才的培养是最重要的"},{"start":45.72,"end":50.5,"text":"这里面也包括他的这个忠诚度的培养啊"},{"start":50.5,"end":53.94,"text":"你不能说他把他培养具有相应的能力了之后"},{"start":53.94,"end":57.41,"text":"他失去了对这个团队和事业的认同"},{"start":57.41,"end":58.21,"text":"那就跑了"},{"start":59.21,"end":60.83,"text":"那这不是资敌吗"},{"start":60.83,"end":62.71,"text":"嗯所以这里面额"},{"start":64.95,"end":68.29,"text":"那么要培养人就要意识到"},{"start":68.29,"end":71.21,"text":"不能纯粹项目导向或者结果导向"},{"start":71.21,"end":73.01,"text":"要搞好多好多东西怎么样"},{"start":73.01,"end":75.74,"text":"那就干嘛抢占身势声望啊"},{"start":75.74,"end":79.92,"text":"你现在抢占有卵用啊"},{"start":80.4,"end":82.44,"text":"那重要的一点就是什么"},{"start":82.44,"end":85.72,"text":"要给他们充足的休息时间啊"},{"start":85.72,"end":87.72,"text":"充足的休息时间"},{"start":87.72,"end":91.77,"text":"还有要让他们能够逐步培养"},{"start":91.77,"end":94.81,"text":"相对高质量的享乐模式啊"},{"start":94.81,"end":97.479,"text":"开心的舒畅的呃"},{"start":97.479,"end":102.57,"text":"没有什么这个坏处的"},{"start":103.97,"end":108.43,"text":"所以我们在努力的去降工时啊"},{"start":108.43,"end":111.699,"text":"然后让他们有这个"},{"start":111.979,"end":117.04,"text":"也就是说我们搞了一个这个呃这个女性呃"},{"start":117.04,"end":120.88,"text":"这个工作人员她的一个刊物"},{"start":120.88,"end":123.22,"text":"那因为啊是内刊啊"},{"start":123.22,"end":129.289,"text":"内部的一个什么情感情感相差不多的那种啊"},{"start":129.61,"end":131.09,"text":"但是呢"},{"start":132.76,"end":134.44,"text":"他没时间看啊"},{"start":134.44,"end":138.26,"text":"或者说他们就是太过于呃热情的"},{"start":138.26,"end":140.78,"text":"热切的拥抱自己的岗位了"},{"start":140.78,"end":144.399,"text":"然后想要在这个工作岗位上证明自己"},{"start":144.639,"end":148.539,"text":"所以会在一些呃些繁琐的事物上面"},{"start":148.539,"end":151.4,"text":"经营事务上面就花很多的投入"},{"start":151.4,"end":153.2,"text":"很多的精力啊功夫"},{"start":153.2,"end":154.68,"text":"而忽视了"},{"start":154.68,"end":156.0,"text":"其实"},{"start":156.98,"end":161.1,"text":"额这东西你做99.99"},{"start":161.1,"end":162.96,"text":"合作98%"},{"start":162.96,"end":163.88,"text":"97%"},{"start":163.88,"end":166.8,"text":"可能花的时间是好几倍"},{"start":166.8,"end":170.49,"text":"但是效果差不了多少"},{"start":171.69,"end":172.81,"text":"但是呢他们会认为"},{"start":172.81,"end":176.63,"text":"这是他们锻炼自己的能力或者优势长处"},{"start":176.63,"end":181.909,"text":"的最呃快速的方式"},{"start":181.909,"end":184.0,"text":"实际上不是最快速的方式"},{"start":184.0,"end":186.0,"text":"或者说他他会认为"},{"start":186.0,"end":189.85,"text":"我们尤其是我给他安排在这个岗位上面"},{"start":189.85,"end":192.19,"text":"就是看中了他有这方面特长"},{"start":192.19,"end":195.15,"text":"他只要拼命发挥这方面特长就行了"},{"start":195.15,"end":199.45,"text":"那他就一直可以呃获得它的价值"},{"start":200.49,"end":201.57,"text":"其实也不是这样的"},{"start":203.33,"end":205.76,"text":"嗯其实是这样的"},{"start":206.92,"end":207.86,"text":"你没啥特长"},{"start":207.86,"end":211.289,"text":"你就相对而言啊"},{"start":211.289,"end":214.38,"text":"不一定是能力上的一个原因"},{"start":214.82,"end":218.46,"text":"或者有可能是你的成长经历啊"},{"start":219.5,"end":224.27,"text":"或者说是你的这个未来发展预期方面"},{"start":224.27,"end":226.75,"text":"你不一定是能力上适合做这些事"},{"start":226.75,"end":227.01,"text":"情"},{"start":227.01,"end":232.59,"text":"也有可能是我认为你更适合被安排在这方面"},{"start":232.59,"end":236.63,"text":"然后可以有一个成长发展的一个路径"},{"start":236.63,"end":240.87,"text":"能力教你不一定适合做这个事啊"},{"start":241.94,"end":244.0,"text":"能力像你这样教及格"},{"start":244.0,"end":246.1,"text":"我都不需要你98分"},{"start":246.1,"end":250.35,"text":"你只要要60分或者良好80分就可以了啊"},{"start":250.35,"end":253.15,"text":"不需要做到那个程度啊"},{"start":254.19,"end":259.459,"text":"所以这是呃人才培养工作里面的一个误区"},{"start":259.459,"end":262.919,"text":"就以为是敢把给把他安排到这个岗位上"},{"start":262.919,"end":264.659,"text":"就是要发挥他这个特长"},{"start":264.659,"end":267.929,"text":"然后拼命的让他卷这部分工作环节"},{"start":268.289,"end":269.329,"text":"不是这样的"},{"start":269.329,"end":269.769,"text":"明白吗"},{"start":271.569,"end":277.07,"text":"我们是希望这个活计你相对匹配的"},{"start":277.07,"end":279.09,"text":"能够驱动起来"},{"start":279.09,"end":280.62,"text":"运行起来"},{"start":280.62,"end":287.09,"text":"和其他人沟通交流和整个项目啊"},{"start":287.09,"end":288.27,"text":"参与进去"},{"start":288.27,"end":289.27,"text":"投入进去"},{"start":289.27,"end":292.99,"text":"开始去从点到面"},{"start":292.99,"end":297.33,"text":"从点到线到面去思考这个呃"},{"start":297.33,"end":299.39,"text":"你所分工的这个环节"},{"start":299.39,"end":301.85,"text":"对于整体的一个意义和价值"},{"start":301.85,"end":308.18,"text":"嗯那么然后呢这个岗位呢相对难度不是特别大"},{"start":308.18,"end":309.86,"text":"对于你具有可操作性"},{"start":309.86,"end":311.24,"text":"你可以参与加入"},{"start":311.24,"end":315.24,"text":"在这里面感受到整个团体的总体战略"},{"start":315.24,"end":319.679,"text":"或者说啊经营的这个面向他的运动"},{"start":319.679,"end":322.979,"text":"然后可以带动着你补你的短板"},{"start":322.979,"end":324.879,"text":"就是说给你这个岗位"},{"start":324.879,"end":326.499,"text":"其实是逼着你去跟人交流的"},{"start":326.499,"end":327.279,"text":"给你这个岗位"},{"start":327.279,"end":331.37,"text":"其实逼着你去去克服自己的一些心理缺陷呢"},{"start":331.37,"end":332.81,"text":"受不了繁琐的"},{"start":332.81,"end":335.669,"text":"或者说受不了这个呃"},{"start":335.669,"end":337.909,"text":"不断让你分心的嘈杂的环境"},{"start":337.909,"end":339.189,"text":"或者说受不了其他"},{"start":339.189,"end":342.689,"text":"要要要要让你临时的不停的去学小技能的"},{"start":342.689,"end":345.39,"text":"但是每个小技能你就要学到差不多够用"},{"start":345.39,"end":347.79,"text":"就是你没有能力判断什么时候是够用"},{"start":347.79,"end":349.56,"text":"什么时候能交呃"},{"start":349.56,"end":350.36,"text":"能交付了"},{"start":350.36,"end":353.04,"text":"下一个环节不会受特别大影响的结果"},{"start":353.04,"end":356.14,"text":"你们可能欠缺的是这种能力啊"},{"start":356.14,"end":358.4,"text":"绝大部分的这些个体呢"},{"start":358.4,"end":362.36,"text":"他不是说我们希望看见他在这个特长"},{"start":362.36,"end":364.67,"text":"这个特殊岗位上哦"},{"start":364.67,"end":368.02,"text":"一下子飙到什么90分100分"},{"start":368.02,"end":370.78,"text":"然后每个人是你这边90分"},{"start":370.78,"end":371.42,"text":"他那边90分"},{"start":371.42,"end":372.06,"text":"他那边90分"},{"start":372.06,"end":372.7,"text":"他那边100分"},{"start":372.7,"end":373.14,"text":"他一分"},{"start":373.14,"end":374.54,"text":"然后整个好像很很厉害的"},{"start":374.54,"end":375.91,"text":"不是的"},{"start":376.11,"end":380.73,"text":"我们首先企盼的是每一个在这里发展"},{"start":380.73,"end":382.93,"text":"获得发展机会的人"},{"start":383.57,"end":389.71,"text":"首先在规划自己的这个呃工作项目"},{"start":389.71,"end":390.93,"text":"工作安排"},{"start":390.93,"end":393.71,"text":"然后在人员的基本沟通交流"},{"start":393.71,"end":397.77,"text":"还有看清楚这个整个呃项目的战略意图"},{"start":397.77,"end":403.89,"text":"或者说他和市面上其他东西的啊叉叉一啊"},{"start":403.89,"end":405.7,"text":"还有自己的相对优势"},{"start":405.7,"end":409.52,"text":"还有就是说这个自己做好这些事情"},{"start":409.52,"end":413.14,"text":"可能需要哪些物质条件嗯"},{"start":413.14,"end":415.97,"text":"然后或者说是软硬件条件"},{"start":415.97,"end":420.97,"text":"我们希望的是你能围绕你的这个差事"},{"start":420.97,"end":424.76,"text":"进行一个整体的思考嗯"},{"start":424.76,"end":427.16,"text":"体系化的系统性的思考"},{"start":427.16,"end":429.66,"text":"然后有组织有计划"},{"start":429.66,"end":431.32,"text":"有安排的去"},{"start":431.32,"end":437.41,"text":"每个环节只要达标就快速运转到下个环节"},{"start":437.41,"end":440.11,"text":"然后驱动起来"},{"start":440.11,"end":442.23,"text":"也就是说我们希望的"},{"start":442.23,"end":445.19,"text":"并不是说你的特殊能力在疯狂增长"},{"start":445.19,"end":447.745,"text":"我们只是希望你"},{"start":447.84,"end":451.78,"text":"我不是希望你每一步走的那个脚印都完美"},{"start":451.78,"end":453.46,"text":"和前面那个脚印贴合"},{"start":453.46,"end":456.4,"text":"或者说你走出一个绝对平整的一个脚印"},{"start":456.4,"end":457.52,"text":"这不是我们要的"},{"start":457.52,"end":459.08,"text":"我们只要你能走就行了"},{"start":459.08,"end":461.58,"text":"你能一步一步不停的往前走就可以了"},{"start":461.58,"end":464.28,"text":"哼所以合拍"},{"start":464.28,"end":469.56,"text":"或者说呃跟着节奏该抬腿抬腿"},{"start":469.56,"end":470.76,"text":"该放腿放腿"},{"start":470.76,"end":472.38,"text":"该把身体重心往前倾"},{"start":472.38,"end":473.48,"text":"就把往前倾"},{"start":473.