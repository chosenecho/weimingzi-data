{
  "bvid": "BV1xv4y1g7mX",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "ed70b0168077b7906baf562d11885d062d3c90432fbc752dcc64e0c74d504dcc",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 740,
      "end_ms": 7320,
      "text": "今天来唱一首我呃悼念一个朋友的一首歌"
    },
    {
      "ordinal": 1,
      "start_ms": 7320,
      "end_ms": 11360,
      "text": "啊啊它的那个原曲是呃"
    },
    {
      "ordinal": 2,
      "start_ms": 14180,
      "end_ms": 17720,
      "text": "原曲是三国志十那个游戏"
    },
    {
      "ordinal": 3,
      "start_ms": 17939,
      "end_ms": 20579,
      "text": "小男生那个那个年代都玩的"
    },
    {
      "ordinal": 4,
      "start_ms": 20579,
      "end_ms": 22409,
      "text": "就我我的那个年代"
    },
    {
      "ordinal": 5,
      "start_ms": 22409,
      "end_ms": 27860,
      "text": "然后是嗯他的大地图上的主题曲啊"
    },
    {
      "ordinal": 6,
      "start_ms": 27860,
      "end_ms": 29240,
      "text": "大大地图上主题曲"
    },
    {
      "ordinal": 7,
      "start_ms": 29240,
      "end_ms": 32579,
      "text": "应该是应该是很有雄心壮志的"
    },
    {
      "ordinal": 8,
      "start_ms": 32579,
      "end_ms": 35909,
      "text": "但是他那首歌的曲子的名字就叫追悼之情"
    },
    {
      "ordinal": 9,
      "start_ms": 35909,
      "end_ms": 39699,
      "text": "所以正好用这首曲子来填词啊"
    },
    {
      "ordinal": 10,
      "start_ms": 56260,
      "end_ms": 60760,
      "text": "晴空看几鹤舞"
    },
    {
      "ordinal": 11,
      "start_ms": 60760,
      "end_ms": 63190,
      "text": "♪ 秋水一缕 ♪"
    },
    {
      "ordinal": 12,
      "start_ms": 63190,
      "end_ms": 67739,
      "text": "飞去去不归"
    },
    {
      "ordinal": 13,
      "start_ms": 68790,
      "end_ms": 73850,
      "text": "♪ 风还几分朦朦胧 ♪"
    },
    {
      "ordinal": 14,
      "start_ms": 73850,
      "end_ms": 79380,
      "text": "♪ 轻轻风坠去去无踪 ♪"
    },
    {
      "ordinal": 15,
      "start_ms": 80500,
      "end_ms": 83370,
      "text": "♪ 风坠人不醉 ♪"
    },
    {
      "ordinal": 16,
      "start_ms": 83370,
      "end_ms": 86370,
      "text": "浮是非非"
    },
    {
      "ordinal": 17,
      "start_ms": 86370,
      "end_ms": 89250,
      "text": "♪ 风坠何不归 ♪"
    },
    {
      "ordinal": 18,
      "start_ms": 89250,
      "end_ms": 91119,
      "text": "♪ 是十岁 ♪"
    },
    {
      "ordinal": 19,
      "start_ms": 92379,
      "end_ms": 95049,
      "text": "♪ 风坠怨不悔 ♪"
    },
    {
      "ordinal": 20,
      "start_ms": 95049,
      "end_ms": 99940,
      "text": "无踪一堆废去去不归"
    },
    {
      "ordinal": 21,
      "start_ms": 101200,
      "end_ms": 104760,
      "text": "分纵纵起离合路漫漫"
    },
    {
      "ordinal": 22,
      "start_ms": 104760,
      "end_ms": 106830,
      "text": "修远无踪"
    },
    {
      "ordinal": 23,
      "start_ms": 106830,
      "end_ms": 111440,
      "text": "分纵纵起离合云泥斑斓"
    },
    {
      "ordinal": 24,
      "start_ms": 111440,
      "end_ms": 115220,
      "text": "如昨魂魄归来兮无痕锁"
    },
    {
      "ordinal": 25,
      "start_ms": 115220,
      "end_ms": 118560,
      "text": "魂魄归来兮如何锁"
    },
    {
      "ordinal": 26,
      "start_ms": 118560,
      "end_ms": 119700,
      "text": "魂魄归来兮"
    },
    {
      "ordinal": 27,
      "start_ms": 119700,
      "end_ms": 121230,
      "text": "日夜锁"
    },
    {
      "ordinal": 28,
      "start_ms": 121230,
      "end_ms": 124460,
      "text": "魂魄归来兮其无踪"
    },
    {
      "ordinal": 29,
      "start_ms": 124460,
      "end_ms": 125900,
      "text": "魂魄归来兮"
    },
    {
      "ordinal": 30,
      "start_ms": 125900,
      "end_ms": 128300,
      "text": "愁与锁"
    },
    {
      "ordinal": 31,
      "start_ms": 132519,
      "end_ms": 135590,
      "text": "因为是道就是追悼之情"
    },
    {
      "ordinal": 32,
      "start_ms": 135590,
      "end_ms": 138320,
      "text": "所以唱的有点宗教仪式的感觉"
    },
    {
      "ordinal": 33,
      "start_ms": 138320,
      "end_ms": 139910,
      "text": "当然人死不能复生啊"
    },
    {
      "ordinal": 34,
      "start_ms": 139910,
      "end_ms": 142020,
      "text": "我是个辩证唯物主义者啊"
    },
    {
      "ordinal": 35,
      "start_ms": 142020,
      "end_ms": 143880,
      "text": "所以用一些楚辞里面的"
    },
    {
      "ordinal": 36,
      "start_ms": 143880,
      "end_ms": 146919,
      "text": "包括什么不渡河"
    },
    {
      "ordinal": 37,
      "start_ms": 146919,
      "end_ms": 149439,
      "text": "什么什么非要渡河"
    },
    {
      "ordinal": 38,
      "start_ms": 149439,
      "end_ms": 150399,
      "text": "然后嗝屁了啊"
    },
    {
      "ordinal": 39,
      "start_ms": 150399,
      "end_ms": 153209,
      "text": "不这个无追啊"
    },
    {
      "ordinal": 40,
      "start_ms": 153209,
      "end_ms": 155100,
      "text": "追之不及啊"
    },
    {
      "ordinal": 41,
      "start_ms": 155339,
      "end_ms": 157439,
      "text": "这个就是化用一些典故啊"
    },
    {
      "ordinal": 42,
      "start_ms": 157439,
      "end_ms": 158759,
      "text": "好人那就讲到这边啊"
    },
    {
      "ordinal": 43,
      "start_ms": 158759,
      "end_ms": 160480,
      "text": "唱歌这边就唱歌这边啊"
    },
    {
      "ordinal": 44,
      "start_ms": 161839,
      "end_ms": 162669,
      "text": "哦对"
    },
    {
      "ordinal": 45,
      "start_ms": 162669,
      "end_ms": 165260,
      "text": "还有一个悼词"
    },
    {
      "ordinal": 46,
      "start_ms": 165260,
      "end_ms": 169340,
      "text": "是当时刚去世没几天的时候写的悼词啊"
    },
    {
      "ordinal": 47,
      "start_ms": 169340,
      "end_ms": 171160,
      "text": "我会把它投到专栏里面去啊"
    }
  ],
  "text": "今天来唱一首我呃悼念一个朋友的一首歌\n啊啊它的那个原曲是呃\n原曲是三国志十那个游戏\n小男生那个那个年代都玩的\n就我我的那个年代\n然后是嗯他的大地图上的主题曲啊\n大大地图上主题曲\n应该是应该是很有雄心壮志的\n但是他那首歌的曲子的名字就叫追悼之情\n所以正好用这首曲子来填词啊\n晴空看几鹤舞\n♪ 秋水一缕 ♪\n飞去去不归\n♪ 风还几分朦朦胧 ♪\n♪ 轻轻风坠去去无踪 ♪\n♪ 风坠人不醉 ♪\n浮是非非\n♪ 风坠何不归 ♪\n♪ 是十岁 ♪\n♪ 风坠怨不悔 ♪\n无踪一堆废去去不归\n分纵纵起离合路漫漫\n修远无踪\n分纵纵起离合云泥斑斓\n如昨魂魄归来兮无痕锁\n魂魄归来兮如何锁\n魂魄归来兮\n日夜锁\n魂魄归来兮其无踪\n魂魄归来兮\n愁与锁\n因为是道就是追悼之情\n所以唱的有点宗教仪式的感觉\n当然人死不能复生啊\n我是个辩证唯物主义者啊\n所以用一些楚辞里面的\n包括什么不渡河\n什么什么非要渡河\n然后嗝屁了啊\n不这个无追啊\n追之不及啊\n这个就是化用一些典故啊\n好人那就讲到这边啊\n唱歌这边就唱歌这边啊\n哦对\n还有一个悼词\n是当时刚去世没几天的时候写的悼词啊\n我会把它投到专栏里面去啊",
  "timing_issue": null
}
