{"segments":[{"start":0.44,"end":4.4,"text":"所以我要说的就是说这个什么历史调研室"},{"start":4.4,"end":5.87,"text":"能有这么多粉丝啊"},{"start":5.87,"end":8.1,"text":"他身体都要谢斯大林啊"},{"start":8.119,"end":14.959,"text":"是斯大林把这个呃唯物主义教育给庸俗化好"},{"start":14.959,"end":18.34,"text":"首先就是说说是这个历史唯物主义"},{"start":19.98,"end":23.24,"text":"斯大林版本的这个唯物主义教科书啊"},{"start":24.92,"end":26.1,"text":"哲学教科书"},{"start":26.9,"end":32.619,"text":"就首先把呃历史唯物主义说成是辩证"},{"start":32.619,"end":37.019,"text":"唯物主义在历史人类社会方面的一个应用"},{"start":37.34,"end":38.42,"text":"这样吧"},{"start":38.42,"end":41.239,"text":"然后呢就全盘复制粘贴嘛"},{"start":42.4,"end":44.4,"text":"辩证唯物主义里面呢"},{"start":44.4,"end":47.49,"text":"也就在所谓自然界宇宙里面啊"},{"start":47.49,"end":49.14,"text":"物质决定意识"},{"start":50.54,"end":53.08,"text":"然后物质是运动的"},{"start":53.08,"end":54.879,"text":"运动是有矛盾的"},{"start":56.88,"end":59.06,"text":"啊矛盾是发展的什么这东西"},{"start":60.08,"end":65.31,"text":"那么就到了这个整个复制粘贴到历史"},{"start":65.31,"end":66.36,"text":"人类社会领域"},{"start":66.36,"end":68.52,"text":"就变成社会存在"},{"start":68.52,"end":70.56,"text":"决定社会意识"},{"start":72.66,"end":75.35,"text":"然后社会是运动的啊"},{"start":75.35,"end":78.14,"text":"啊社会运动是有矛盾的啊"},{"start":78.14,"end":78.92,"text":"是分阶段的"},{"start":78.92,"end":79.46,"text":"是发展的"},{"start":79.46,"end":80.52,"text":"分阶段的"},{"start":81.58,"end":84.78,"text":"那么我为什么说历史调研室这些粉丝呢"},{"start":84.78,"end":86.55,"text":"他是这么一个错误的"},{"start":86.55,"end":88.59,"text":"斯大林式的辩"},{"start":88.59,"end":91.95,"text":"证唯物主义和历史唯物主义教育的一个产物呢"},{"start":91.95,"end":94.8,"text":"因为他们又把这个东西再进一步了"},{"start":94.8,"end":98.0,"text":"又复制粘贴到反复制粘贴了一次"},{"start":98.64,"end":100.88,"text":"他不是复制粘贴到历史里面去"},{"start":100.88,"end":105.66,"text":"它是把它复制粘贴到历史学里面去啊"},{"start":105.66,"end":114.1,"text":"历史学内部还要变成历史学科里面的材料"},{"start":115.12,"end":119.46,"text":"好历史材料决定历史观念"},{"start":119.46,"end":123.08,"text":"历史意识就史料决定史观"},{"start":123.88,"end":128.699,"text":"但是他漏了后面两个史料是发展的"},{"start":128.699,"end":130.5,"text":"史料是有矛盾的"},{"start":130.5,"end":132.33,"text":"史料是分阶段的"},{"start":132.33,"end":133.44,"text":"所以我们说了"},{"start":133.44,"end":134.2,"text":"就是说"},{"start":139.82,"end":141.49,"text":"他有这么多粉丝"},{"start":141.49,"end":146.58,"text":"就是因为很多人脑子不清楚啊"},{"start":146.58,"end":152.3,"text":"不清楚受了这个斯大林的阉割版的猴版"},{"start":152.38,"end":153.82,"text":"或者叫做这种"},{"start":153.82,"end":157.4,"text":"反正就是阉割版的这个马哲的洗脑"},{"start":158.159,"end":160.519,"text":"斯大林式的这种教科书体系啊"},{"start":161.599,"end":162.889,"text":"这个教科书体系啊"},{"start":162.889,"end":164.0,"text":"他把物质"},{"start":166.519,"end":168.459,"text":"我们叫还原论化"},{"start":168.459,"end":171.939,"text":"实证主义化变成一种惰性的东西"},{"start":171.939,"end":174.099,"text":"就变成一种根本上是惰性的东西"},{"start":174.099,"end":175.9,"text":"运动只是它的一个属性嘛"},{"start":177.02,"end":179.62,"text":"那么正统的真正的马克思主义当中的物质"},{"start":179.62,"end":180.68,"text":"应当是什么呢"},{"start":182.58,"end":187.82,"text":"啊物质是马克思用来颠覆黑格尔"},{"start":188.82,"end":191.3,"text":"大型哲学体系的一个环节"},{"start":191.3,"end":193.5,"text":"是黑格尔哲学本身的一个环节"},{"start":194.239,"end":195.849,"text":"他把自己的哲学叫"},{"start":195.849,"end":201.799,"text":"一开始马克思用的词实际上是用用的是科学"},{"start":201.799,"end":202.219,"text":"实证主义"},{"start":202.219,"end":205.14,"text":"这意识自称自己的体系"},{"start":206.119,"end":213.179,"text":"物质这个环节呢也只是后来的人重新去塑造他"},{"start":213.179,"end":214.96,"text":"锻造他哲学体系的时候"},{"start":220.88,"end":224.02,"text":"稳固的说成是它的核心概念的"},{"start":224.959,"end":226.659,"text":"马克思更喜欢用的是什么"},{"start":226.659,"end":229.0,"text":"现实的或者类似这样的词啊"},{"start":231.779,"end":234.42,"text":"大家都是学黑格尔的同一个祖师"},{"start":235.839,"end":237.719,"text":"所以他用一个环节拆解它"},{"start":237.719,"end":241.019,"text":"整个体系可以理解物质这个环节啊"},{"start":241.019,"end":242.12,"text":"Matter"},{"start":244.52,"end":250.32,"text":"那么呃在马克思顿那边做了"},{"start":250.32,"end":253.2,"text":"我们认为比较具有激进性的这个呃"},{"start":253.2,"end":254.85,"text":"辩证唯物主义哲学那里呢"},{"start":254.85,"end":258.399,"text":"物质本身最具有物质性的"},{"start":258.399,"end":262.179,"text":"是矛盾或者最具有物质性的"},{"start":262.179,"end":265.659,"text":"我们就说就是黑格尔的那些环节之间的"},{"start":265.659,"end":269.569,"text":"那些本体论阶次之间的冲突啊"},{"start":269.569,"end":271.729,"text":"就是那种运动的必然性啊"},{"start":271.729,"end":274.969,"text":"或者所以我们不应当说物质是运动的"},{"start":274.969,"end":278.259,"text":"我们应当说运动是物质阶级"},{"start":278.259,"end":281.99,"text":"运动本身是物质阶级矛盾冲突本身是物质阶级"},{"start":281.99,"end":282.83,"text":"运动就是物质"},{"start":282.83,"end":284.45,"text":"所以这个也是比较能够兼容"},{"start":284.45,"end":288.62,"text":"是现代科学发展的这个里面相对论运动本身"},{"start":288.62,"end":289.46,"text":"能量本身"},{"start":289.46,"end":290.92,"text":"运动本身就是一种物质"},{"start":291.159,"end":293.649,"text":"就是客观的本体论事件"},{"start":293.649,"end":295.839,"text":"真实的客观的本体论事件"},{"start":295.839,"end":301.14,"text":"只要他能够注意到这个这个呃宇宙叙事的"},{"start":301.14,"end":305.19,"text":"宇宙的叙事学的这个次序当中"},{"start":305.19,"end":311.58,"text":"能够形成这个这个系统的一个叙事学响应的"},{"start":311.86,"end":315.34,"text":"能够注册到这个叙事学的体系当中"},{"start":315.34,"end":321.82,"text":"能够形成这个系统的叙事的响应的就是物质"},{"start":325.66,"end":326.4,"text":"啊"},{"start":326.4,"end":327.12,"text":"也就是说"},{"start":327.12,"end":331.0,"text":"物质的概念逐步逐步被事件的概念所代替的"},{"start":333.98,"end":335.66,"text":"但也不是绝对啊"},{"start":339.12,"end":339.86,"text":"但也不是"},{"start":339.86,"end":341.66,"text":"所以后面的激进的左翼思想家"},{"start":341.66,"end":343.54,"text":"他们更喜欢讨论的是事件"},{"start":345.84,"end":348.38,"text":"或者说现实性这样的范畴"},{"start":350.36,"end":351.9,"text":"当然物质也会讨论"},{"start":352.8,"end":357.44,"text":"那不是回到回到这个谢灵来讨论物质啊"},{"start":357.44,"end":358.49,"text":"讨论物质"},{"start":358.49,"end":361.52,"text":"或者说还那个啊它的激进性的"},{"start":361.52,"end":367.92,"text":"会更多采用这个啊事件啊这个词啊"},{"start":367.92,"end":368.22,"text":"扯远了"},{"start":368.22,"end":368.88,"text":"我们不讲哲学啊"},{"start":368.88,"end":369.42,"text":"我们不讲哲学"},{"start":369.42,"end":371.4,"text":"我们回过头来说你们这些人犯的错误"},{"start":371.4,"end":372.6,"text":"就是说啊"},{"start":372.6,"end":377.7,"text":"首先是头脑当中觉得哲学是个劣版的一个呃"},{"start":377.7,"end":382.37,"text":"斯大林的什么日丹诺夫的那个教科书体系"},{"start":382.37,"end":384.41,"text":"那对马哲本来已经是马克思主义"},{"start":384.41,"end":387.46,"text":"哲学本来已经是个弯弯曲一个扭曲了"},{"start":387.46,"end":391.42,"text":"其次又是呃在这个列版体系里面的一个列版的"},{"start":391.42,"end":392.68,"text":"历史唯物主义"},{"start":392.68,"end":395.65,"text":"那个历史唯物主义就是个很僵死的教条的"},{"start":395.65,"end":398.34,"text":"他这还喜欢批评别人是形而上学"},{"start":398.34,"end":400.05,"text":"他那个东西最形而上学的"},{"start":400.05,"end":402.95,"text":"因为他说别人形而上学是僵死的"},{"start":402.95,"end":404.69,"text":"片面的什么什么的"},{"start":404.69,"end":405.5,"text":"静态的"},{"start":405.5,"end":408.23,"text":"你在你那整套骂人体系"},{"start":408.23,"end":412.38,"text":"那整套369等啊体系里面"},{"start":412.38,"end":416.58,"text":"你你自己僵死的片面的静态的"},{"start":416.58,"end":418.74,"text":"你自己就做最坐实了"},{"start":418.74,"end":420.26,"text":"你这个对不对"},{"start":420.26,"end":423.56,"text":"所以他的那个历史唯物主义说是一个辩证"},{"start":423.56,"end":426.14,"text":"唯物主义在历史维度的一个应用啊"},{"start":426.14,"end":428.72,"text":"什么社会存在决定社会意识"},{"start":429.56,"end":430.9,"text":"这也是一个教条"},{"start":433.36,"end":434.16,"text":"他说"},{"start":437.92,"end":442.28,"text":"所以这样的惯性呢它又由于"},{"start":444.98,"end":447.19,"text":"由于这个政治先行啊"},{"start":447.19,"end":448.02,"text":"或者说"},{"start":452.4,"end":453.98,"text":"哲学意识形态工作"},{"start":453.98,"end":457.78,"text":"对于文科研究的科研的一个影响"},{"start":457.78,"end":460.34,"text":"而在我国的史学研究里面"},{"start":460.78,"end":465.23,"text":"史学研究界有一批有一批学者"},{"start":465.23,"end":469.1,"text":"他就错误地把这个原理又复用到啊"},{"start":469.1,"end":470.18,"text":"历史学"},{"start":470.18,"end":471.74,"text":"在历史学当中"},{"start":471.74,"end":474.98,"text":"历史材料决定历史观念"},{"start":475.74,"end":477.08,"text":"放你妈的屁"},{"start":477.08,"end":480.92,"text":"我靠先要有历史材料"},{"start":480.92,"end":482.75,"text":"然后才能产生历史立场"},{"start":482.75,"end":485.66,"text":"先要有历史材料才能产生啊"},{"start":485.66,"end":486.59,"text":"历史观念"},{"start":486.59,"end":487.86,"text":"历史意识"},{"start":488.86,"end":491.28,"text":"那么这一定是个反动的立场啊"},{"start":491.7,"end":494.94,"text":"这就一定是个反动的立场了啊"},{"start":494.94,"end":498.86,"text":"这就因为你这个历史学体系"},{"start":498.86,"end":501.02,"text":"不是像那个什么人类社会"},{"start":501.02,"end":501.98,"text":"人类历史那样"},{"start":501.98,"end":504.42,"text":"是一个客观的物质物质系统"},{"start":504.42,"end":507.06,"text":"或者说像自然事件一样是个物质系统"},{"start":507.06,"end":510.58,"text":"你这个本身就已经是一个被建构起来的东西"},{"start":510.599,"end":513.359,"text":"你这个历史学的这么一个范围"},{"start":513.359,"end":514.948,"text":"使学范畴"},{"start":514.948,"end":516.509,"text":"史实活动范围"},{"start":516.509,"end":518.339,"text":"历史研究活动范围"},{"start":518.7,"end":521.669,"text":"史料并不比什么历史观念"},{"start":521.669,"end":523.35,"text":"历史历史"},{"start":523.35,"end":526.199,"text":"历史立场啊"},{"start":526.34,"end":529.88,"text":"历史史学方法这些东西更客观"},{"start":529.88,"end":531.11,"text":"史料本身"},{"start":531.11,"end":532.61,"text":"史料的分类"},{"start":532.61,"end":534.18,"text":"史料的定义"},{"start":534.18,"end":536.88,"text":"史料的排除和采纳"},{"start":536.88,"end":538.05,"text":"史料的编纂"},{"start":538.05,"end":539.31,"text":"史料的加工"},{"start":539.31,"end":541.099,"text":"史料的解释"},{"start":543.04,"end":544.74,"text":"都是高度编码的"},{"start":544.74,"end":546.42,"text":"高度精神化的高度"},{"start":546.42,"end":547.47,"text":"在这个体系里面"},{"start":547.47,"end":552.12,"text":"预先被被被呃设定好各式各样的参数的"},{"start":553.4,"end":557.92,"text":"因为史历史学这个领地是高度精神化的"},{"start":557.92,"end":560.24,"text":"高度发达的文科体系"},{"start":561.7,"end":564.96,"text":"所以你怎么可能就把这个什么历史唯物主义的"},{"start":564.96,"end":566.04,"text":"这个社会存在"},{"start":566.04,"end":568.08,"text":"决定社会意识再进一步的啊"},{"start":568.08,"end":569.04,"text":"历史材料"},{"start":569.04,"end":572.09,"text":"历史资料决定先要有历史资料"},{"start":572.09,"end":574.16,"text":"就干干净净的客观中立"},{"start":574.16,"end":575.42,"text":"历史资料都排好了"},{"start":575.42,"end":576.45,"text":"不放在那儿"},{"start":576.45,"end":578.97,"text":"然后我们再干干净净洁白的年轻人"},{"start":578.97,"end":580.26,"text":"再去看这历史资料"},{"start":580.26,"end":581.97,"text":"看了之后干干净净的洁白"},{"start":581.97,"end":585.88,"text":"年轻人通过看干干净净洁白的历史资料"},{"start":585.88,"end":588.01,"text":"得出我们正确的啊"},{"start":588.01,"end":588.73,"text":"放之四海"},{"start":588.73,"end":590.74,"text":"而朱准的历史观"},{"start":590.74,"end":591.91,"text":"历史价值观"},{"start":591.91,"end":593.079,"text":"历史判断"},{"start":594.34,"end":595.5,"text":"狗屁呀"},{"start":595.5,"end":596.49,"text":"你知道吗"},{"start":596.49,"end":599.16,"text":"怎么可能干干净净洁白的历史资料"},{"start":599.16,"end":600.18,"text":"这种玩意"},{"start":600.46,"end":602.5,"text":"历史学的编制"},{"start":602.5,"end":603.76,"text":"历史学的机关"},{"start":603.76,"end":606.02,"text":"历史研究的工作人员"},{"start":606.02,"end":608.24,"text":"他都是受某个阶级供养的"},{"start":608.24,"end":609.38,"text":"受某个阶级立场"},{"start":609.38,"end":613.55,"text":"受某个什么统治秩序安排的"},{"start":613.55,"end":618.859,"text":"早就是又充满了他的某些屁股歪的利益"},{"start":618.88,"end":620.68,"text":"包括干干净净的年轻人"},{"start":620.68,"end":622.9,"text":"那年轻人没有家庭出身的年轻人"},{"start":622.9,"end":624.04,"text":"没有他社会地位"},{"start":624.04,"end":624.73,"text":"社会背景"},{"start":624.73,"end":626.38,"text":"年轻人没有他受过的教育"},{"start":626.38,"end":631.18,"text":"没有他呃经受的这个文化影响的干干净净"},{"start":631.18,"end":632.32,"text":"干干净净的年轻人"},{"start":632.32,"end":636.92,"text":"看干干净的史料就得就得出干干净净的历史观"},{"start":636.92,"end":639.08,"text":"你们是不是这小孩的脑子里这样想的"},{"start":639.08,"end":640.79,"text":"这就是历史唯物主义"},{"start":640.79,"end":643.03,"text":"历史学里面的唯物主义立场"},{"start":643.03,"end":644.319,"text":"放你个狗屁"},{"start":647.6,"end":652.84,"text":"这是无意识地在把斯大林主义的错误的"},{"start":652.84,"end":654.04,"text":"唯物主义"},{"start":654.48,"end":657.27,"text":"唯物主义的这个挪用"},{"start":657.27,"end":659.4,"text":"唯物主义的错误挪用"},{"start":659.4,"end":662.42,"text":"再挪用到的历史学范畴里面去"},{"start":663.36,"end":664.859,"text":"太可笑了"},{"start":665.58,"end":667.43,"text":"那我们破解这种"},{"start":667.43,"end":670.82,"text":"那我们就为什么你就多用第一条的啊"},{"start":670.82,"end":672.56,"text":"物质决定意识啊"},{"start":672.56,"end":674.42,"text":"意识反作用于物质"},{"start":675.66,"end":677.54,"text":"那就就就没有了嘛"},{"start":677.54,"end":678.02,"text":"对不对"},{"start":678.02,"end":679.7,"text":"你为什么不能让他第二条呢"},{"start":679.7,"end":680.39,"text":"对不对"},{"start":680.39,"end":682.28,"text":"史料决定史观"},{"start":682.28,"end":684.37,"text":"史观反作用于史料"},{"start":684.37,"end":687.91,"text":"史观会让你去各式各样的去拣选史料"},{"start":688.99,"end":690.67,"text":"各各式耍