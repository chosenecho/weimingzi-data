{
  "model": "qwen-audio-3.1-asr-flash",
  "audio_sha256": "1c37c1356adba6f9061b6c8fe118386a6ff10ebcdbc2eb67124039166985c9ff",
  "chunk_seconds": 240,
  "speaker_diarization_enabled": true,
  "sample_rate": 16000,
  "version": 1,
  "source": "asr-cloud",
  "duration_seconds": 925.8605,
  "segments": [
    {
      "start": 0.0,
      "end": 0.8,
      "text": "寻乌县",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 1.6,
      "end": 2.88,
      "text": "它是一个小县城",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 3.36,
      "end": 4.48,
      "text": "有钱人很多",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 5.04,
      "end": 6.8,
      "text": "嗯，穷人也很多",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 6.548,
      "end": 6.8,
      "text": "多",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 7.92,
      "end": 8.64,
      "text": "嗯",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 9.04,
      "end": 10.64,
      "text": "自然环境是挺好的",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 10.72,
      "end": 12.72,
      "text": "有钱人在这生活挺舒服的",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 13.12,
      "end": 14.56,
      "text": "没钱人在这生活",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 15.04,
      "end": 18.16,
      "text": "嗯，也能够填饱肚子",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 18.4,
      "end": 21.12,
      "text": "有编制年轻人在这过得很滋润",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 22.24,
      "end": 23.6,
      "text": "这是我观察到的",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 23.92,
      "end": 24.4,
      "text": "嗯",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 24.8,
      "end": 26.72,
      "text": "你目前就课业还多吗",
      "speaker_id": 1,
      "chunk_offset_seconds": 0
    },
    {
      "start": 26.64,
      "end": 28.56,
      "text": "都没有课嗯",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 29.12,
      "end": 30.8,
      "text": "自由探索的时间比较多",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 32.0,
      "end": 33.68,
      "text": "那你都探索些什么呢",
      "speaker_id": 1,
      "chunk_offset_seconds": 0
    },
    {
      "start": 34.16,
      "end": 35.44,
      "text": "探索短视频",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 36.32,
      "end": 37.52,
      "text": "探索短视频",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 37.92,
      "end": 42.64,
      "text": "嗯，没，我没有探索，就沉迷短视频研二，沉迷短视频",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 42.8,
      "end": 45.76,
      "text": "嗯，沉迷在吃喝玩乐上",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 46.08,
      "end": 50.8,
      "text": "研三被这个论文压力，还有就业的压力",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 50.88,
      "end": 52.64,
      "text": "呃，困扰着我",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 53.204,
      "end": 56.32,
      "text": "认识好几个朋友，跟我年龄相仿，女性朋友",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 56.72,
      "end": 59.36,
      "text": "嗯，他们有的当了老师",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 59.44,
      "end": 61.28,
      "text": "结婚，嫁人，生孩子",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 61.6,
      "end": 64.64,
      "text": "衣食无忧，没有很大的生存，就业",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 65.12,
      "end": 66.24,
      "text": "各方面的压力",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 66.56,
      "end": 70.0,
      "text": "目前来看我家情况我了解到的应该是最差的",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 75.04,
      "end": 77.76,
      "text": "哦，在，在2楼，在2楼，这个是别人家的",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 82.64,
      "end": 83.76,
      "text": "上来，上去",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 89.36,
      "end": 90.08,
      "text": "哎呀",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 95.2,
      "end": 97.44,
      "text": "这边吗哦，对，对，对",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 97.44,
      "end": 98.56,
      "text": "很乱的啊",
      "speaker_id": 2,
      "chunk_offset_seconds": 0
    },
    {
      "start": 101.44,
      "end": 103.28,
      "text": "那这边晒衣服还挺好的",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 103.92,
      "end": 104.8,
      "text": "晒衣服啊",
      "speaker_id": 2,
      "chunk_offset_seconds": 0
    },
    {
      "start": 104.8,
      "end": 105.28,
      "text": "嗯",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 105.28,
      "end": 108.32,
      "text": "嗯，这个宿舍晾衣服的好一点，其他什么都不好",
      "speaker_id": 2,
      "chunk_offset_seconds": 0
    },
    {
      "start": 108.24,
      "end": 108.88,
      "text": "嗯",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 110.32,
      "end": 111.68,
      "text": "也没好清楚",
      "speaker_id": 2,
      "chunk_offset_seconds": 0
    },
    {
      "start": 122.08,
      "end": 123.28,
      "text": "就我在这里住",
      "speaker_id": 2,
      "chunk_offset_seconds": 0
    },
    {
      "start": 123.44,
      "end": 126.32,
      "text": "我就住这，这两个房子，我又不是人很多",
      "speaker_id": 2,
      "chunk_offset_seconds": 0
    },
    {
      "start": 126.24,
      "end": 128.8,
      "text": "我就跟我女儿，女儿上小学，很少回来",
      "speaker_id": 2,
      "chunk_offset_seconds": 0
    },
    {
      "start": 130.64,
      "end": 131.68,
      "text": "阿姨你等我",
      "speaker_id": 2,
      "chunk_offset_seconds": 0
    },
    {
      "start": 131.6,
      "end": 133.2,
      "text": "等一下哈，欢迎小心了我",
      "speaker_id": 3,
      "chunk_offset_seconds": 0
    },
    {
      "start": 137.808,
      "end": 138.64,
      "text": "叫谷淑冰",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 138.56,
      "end": 139.794,
      "text": "嗯，今年25",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 140.0,
      "end": 143.92,
      "text": "岁，现在是研三然后我的专业是中医医史文献",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 144.24,
      "end": 145.2,
      "text": "嗯",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 145.44,
      "end": 149.36,
      "text": "我家是在江西省赣州市寻乌县的某个村里",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 149.44,
      "end": 155.12,
      "text": "我父母都是农民然后我父亲主要是在家照料这些脐橙树管理这个果园",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 155.28,
      "end": 159.6,
      "text": "啊，我母亲白天，呃，在工地上做小工为主",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 159.68,
      "end": 164.96,
      "text": "我还有个姐姐，是在深圳当老师我还有个妹妹，我妹妹是在",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 165.12,
      "end": 169.2,
      "text": "呃，县城的高中上高二我家种了300棵脐橙树",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 169.52,
      "end": 171.44,
      "text": "嗯，在一片小山坡上",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 171.36,
      "end": 173.68,
      "text": "距离大马路，呃，比较远",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 173.6,
      "end": 177.04,
      "text": "加上那个路比较绕都是一些山路",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 177.12,
      "end": 181.12,
      "text": "所以，所以一些收购商可能不是很愿意开车进来",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 181.04,
      "end": 184.0,
      "text": "比较麻烦导致这个收购情况不是很好",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 185.36,
      "end": 187.6,
      "text": "那你是通过什么方式联系到我们的",
      "speaker_id": 1,
      "chunk_offset_seconds": 0
    },
    {
      "start": 188.16,
      "end": 195.44,
      "text": "哦，我一开始是在是在五年八班那个账号下面，看到有那个就业咨询其实我一开始是",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 195.6,
      "end": 208.16,
      "text": "呃，因为就业咨询去联系了他们然后，呃，我给他们说了一下我的基本情况以后他们给我推荐了正和农产品的负责人然后中和农产品的负责人就表示他们愿意过来帮助我们",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 210.16,
      "end": 212.4,
      "text": "感觉从镇上回到了村里",
      "speaker_id": 0,
      "chunk_offset_seconds": 0
    },
    {
      "start": 212.32,
      "end": 215.04,
      "text": "这边是我们工地我们是做污水的那",
      "speaker_id": 2,
      "chunk_offset_seconds": 0
    },
    {
      "start": 232.853,
      "end": 233.44,
      "text": "走了",
      "speaker_id": 2,
      "chunk_offset_seconds": 0
    },
    {
      "start": 235.2,
      "end": 235.76,
      "text": "哦",
      "speaker_id": 2,
      "chunk_offset_seconds": 0
    },
    {
      "start": 236.4,
      "end": 238.0,
      "text": "从，从哪走的呀",
      "speaker_id": 2,
      "chunk_offset_seconds": 0
    },
    {
      "start": 239.44,
      "end": 239.72,
      "text": "哎",
      "speaker_id": 2,
      "chunk_offset_seconds": 0
    },
    {
      "start": 239.44,
      "end": 240.0,
      "text": "哎呦。",
      "speaker_id": 2,
      "chunk_offset_seconds": 0
    },
    {
      "start": 240.0,
      "end": 240.88,
      "text": "你不用刷",
      "speaker_id": 0,
      "chunk_offset_seconds": 240
    },
    {
      "start": 243.76,
      "end": 244.8,
      "text": "给我空运来",
      "speaker_id": 0,
      "chunk_offset_seconds": 240
    },
    {
      "start": 246.8,
      "end": 247.84,
      "text": "好，我拿土豆",
      "speaker_id": 0,
      "chunk_offset_seconds": 240
    },
    {
      "start": 253.68,
      "end": 256.4,
      "text": "那你觉得你父母认为的好的生活",
      "speaker_id": 1,
      "chunk_offset_seconds": 240
    },
    {
      "start": 256.32,
      "end": 258.72,
      "text": "跟你认为的好的生活有出入吗",
      "speaker_id": 1,
      "chunk_offset_seconds": 240
    },
    {
      "start": 259.04,
      "end": 259.84,
      "text": "出路",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 260.88,
      "end": 261.68,
      "text": "啊",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 262.32,
      "end": 265.04,
      "text": "我觉得我父母认为的好的生活就是",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 265.68,
      "end": 269.44,
      "text": "就是包括我姐姐吧我觉得他们三个都觉得",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 269.84,
      "end": 273.04,
      "text": "钱能解决很多问题钱能减少很多家庭矛盾",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 273.52,
      "end": 274.4,
      "text": "嗯",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 274.64,
      "end": 276.0,
      "text": "但我并",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 276.32,
      "end": 277.44,
      "text": "并不这样认为",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 277.36,
      "end": 280.8,
      "text": "我觉得钱确实能够减少很多争吵，争执",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 280.88,
      "end": 281.68,
      "text": "但",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 282.48,
      "end": 283.76,
      "text": "但是有了钱",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 283.68,
      "end": 286.0,
      "text": "我觉得还是会有新的问题冒出来",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 286.32,
      "end": 287.28,
      "text": "嗯",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 287.52,
      "end": 288.15999999999997,
      "text": "嗯",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 289.04,
      "end": 290.08,
      "text": "比如说",
      "speaker_id": 1,
      "chunk_offset_seconds": 240
    },
    {
      "start": 290.4,
      "end": 291.44,
      "text": "比如说",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 292.15999999999997,
      "end": 295.04,
      "text": "比如说我父母他们两个就是",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 294.96,
      "end": 296.88,
      "text": "我觉得他们就是性格很不合",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 297.04,
      "end": 300.0,
      "text": "嗯，各方面都不不是很合适的一个人",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 300.24,
      "end": 303.12,
      "text": "但是他们就是在一起结婚",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 303.2,
      "end": 304.0,
      "text": "然后",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 304.24,
      "end": 306.96,
      "text": "在这十多年的相处过程中一直在吵架",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 306.88,
      "end": 308.88,
      "text": "不管有钱没钱都都会吵架",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 309.12,
      "end": 309.92,
      "text": "嗯",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 316.48,
      "end": 319.92,
      "text": "我家今年今年不行的原因",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 320.0,
      "end": 321.6,
      "text": "他们没说，就说",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 321.84000000000003,
      "end": 323.44,
      "text": "我那个亲戚他不要了他",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 323.653,
      "end": 324.72,
      "text": "今年不不收",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 324.64,
      "end": 327.44,
      "text": "但是我不清楚是不是因为我家的脐橙",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 327.84000000000003,
      "end": 329.52,
      "text": "不太好看，长得不好看",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 329.6,
      "end": 331.2,
      "text": "长得没有去年好看的原因",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 331.36,
      "end": 333.84000000000003,
      "text": "因为前两年就是都很不错",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 333.76,
      "end": 336.0,
      "text": "今年没有前两年那么好",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 336.72,
      "end": 341.92,
      "text": "我妈的意思是今年的肥肥，她的那个农家肥那个肥力不够",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 342.24,
      "end": 344.56,
      "text": "嗯，前两年用的是猪粪",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 344.48,
      "end": 345.44,
      "text": "肥力比较足",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 345.36,
      "end": 351.52,
      "text": "土壤比较肥沃今年今年是买的那个鸡粪可能鸡粪的水分比较多",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 351.6,
      "end": 353.12,
      "text": "没有没有猪粪",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 353.36,
      "end": 354.4,
      "text": "那么实在",
      "speaker_id": 1,
      "chunk_offset_seconds": 240
    },
    {
      "start": 354.32,
      "end": 354.88,
      "text": "对",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 355.12,
      "end": 358.08,
      "text": "那不是说你你你二伯那边养猪吗",
      "speaker_id": 3,
      "chunk_offset_seconds": 240
    },
    {
      "start": 358.0,
      "end": 360.0,
      "text": "那为什么不能找他要那个猪粪",
      "speaker_id": 3,
      "chunk_offset_seconds": 240
    },
    {
      "start": 360.24,
      "end": 361.36,
      "text": "他那边也要用吗",
      "speaker_id": 3,
      "chunk_offset_seconds": 240
    },
    {
      "start": 361.68,
      "end": 363.52,
      "text": "不知道啊，他们",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 364.56,
      "end": 367.36,
      "text": "他们家他们关系也也很一般",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 367.126,
      "end": 369.03999999999996,
      "text": "般一基本上都不来往的都是",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 377.26,
      "end": 378.4,
      "text": "咱们自己种的",
      "speaker_id": 1,
      "chunk_offset_seconds": 240
    },
    {
      "start": 378.8,
      "end": 379.76,
      "text": "我是买的",
      "speaker_id": 0,
      "chunk_offset_seconds": 240
    },
    {
      "start": 379.76,
      "end": 380.72,
      "text": "你买的",
      "speaker_id": 1,
      "chunk_offset_seconds": 240
    },
    {
      "start": 380.64,
      "end": 381.68,
      "text": "啊，我们",
      "speaker_id": 0,
      "chunk_offset_seconds": 240
    },
    {
      "start": 382.24,
      "end": 383.91999999999996,
      "text": "没时间，没时间种",
      "speaker_id": 1,
      "chunk_offset_seconds": 240
    },
    {
      "start": 383.91999999999996,
      "end": 386.4,
      "text": "还要浇水呀，施肥呀什么的是",
      "speaker_id": 0,
      "chunk_offset_seconds": 240
    },
    {
      "start": 386.8,
      "end": 387.2,
      "text": "吧",
      "speaker_id": 0,
      "chunk_offset_seconds": 240
    },
    {
      "start": 405.6,
      "end": 408.48,
      "text": "早些年的时候，比如说我初中得知",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 408.72,
      "end": 411.6,
      "text": "我我妈得知她有外遇的时候，不离婚",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 412.0,
      "end": 412.96000000000004,
      "text": "的原因",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 414.24,
      "end": 419.68,
      "text": "就是因为我妹妹，她舍不得我妹妹离婚了的话，我妹妹归归我妈的话",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 420.4,
      "end": 422.56,
      "text": "我妈带不了她，养不了三个女儿",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 422.64,
      "end": 425.44,
      "text": "归我爸的话，我妹妹肯定养不好",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 425.76,
      "end": 429.44,
      "text": "她不希望我妹妹早早的就辍学嗯，去打工",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 429.36,
      "end": 431.03999999999996,
      "text": "现在不离开他的原因是",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 431.658,
      "end": 434.0,
      "text": "因为我爸他身体不好了我妈可怜他",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 433.91999999999996,
      "end": 435.36,
      "text": "要是离开了他",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 436.0,
      "end": 437.84000000000003,
      "text": "嗯，他一他一个",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 438.24,
      "end": 440.4,
      "text": "老男人，在这个深山老林里",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 440.8,
      "end": 441.84000000000003,
      "text": "嗯",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 442.0,
      "end": 443.12,
      "text": "生活的话",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 443.52,
      "end": 445.6,
      "text": "我妈觉得他，我妈可怜他",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 445.52,
      "end": 446.56,
      "text": "想要照顾他",
      "speaker_id": 2,
      "chunk_offset_seconds": 240
    },
    {
      "start": 474.08000000000004,
      "end": 474.56,
      "text": "走走",
      "speaker_id": 4,
      "chunk_offset_seconds": 240
    },
    {
      "start": 474.08000000000004,
      "end": 474.8,
      "text": "走走走。",
      "speaker_id": 4,
      "chunk_offset_seconds": 240
    },
    {
      "start": 480.48,
      "end": 482.4,
      "text": "我有几个鹅叶子",
      "speaker_id": 0,
      "chunk_offset_seconds": 480
    },
    {
      "start": 491.68,
      "end": 497.2,
      "text": "我实习就是在一家医院实习的实习护士就我在实习的时候我就能感觉到",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 498.32,
      "end": 503.36,
      "text": "我跟那些同事比如说正式的员工正式的护士",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 505.36,
      "end": 507.36,
      "text": "就我我没有办法融入进他们",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 507.52,
      "end": 512.0,
      "text": "然后他们就是使唤我嘛让我干活就是我能感觉到我是",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 512.48,
      "end": 516.0,
      "text": "当一个耗材在用的我不知道该怎么灵巧的去",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 517.12,
      "end": 518.48,
      "text": "争取自己的权益",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 518.56,
      "end": 520.96,
      "text": "比如说有一次我在一个科室实习的时候",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 521.84,
      "end": 529.04,
      "text": "我本来是在西区它是分东西区然后那个东区的护士又叫我去东区干活然后西区的护士叫我去西区干活",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 529.12,
      "end": 531.28,
      "text": "然后那个时候我就是实在受不了了",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 531.52,
      "end": 536.88,
      "text": "我就我就爆发了我当时反正就喊了一句我说我不我不干怎么样的",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 537.04,
      "end": 542.24,
      "text": "那两个护士她俩就同时沉默了然后就那一天上午她们就再也没有叫我去干任何活",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 542.64,
      "end": 551.92,
      "text": "包括我去换换那个换水她们就很基础的活她们也没有让我去干她们就变得非常的就一言不发就一言不发就走了就是",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 554.08,
      "end": 558.4,
      "text": "结果结果中午的时候那护士长她就叫我去护理部",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 558.56,
      "end": 559.84,
      "text": "找那个护理部主任",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 561.12,
      "end": 564.4,
      "text": "然后那个护理部主任跟我说你今天不用去这个科室了你",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 564.56,
      "end": 566.16,
      "text": "下午去另一个科室报到",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 566.56,
      "end": 568.48,
      "text": "那科室是一个更累的科室",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 586.08,
      "end": 587.36,
      "text": "我们的路不好走",
      "speaker_id": 2,
      "chunk_offset_seconds": 480
    },
    {
      "start": 611.6,
      "end": 618.24,
      "text": "很不擅长思考就我懒得去思考我我习惯了按部就班的去做事就像做题一样当时唯一的想法就是我",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 618.386,
      "end": 619.12,
      "text": "一定要考上",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 618.973,
      "end": 624.0,
      "text": "上我有一种考不上的恐惧感22年本科毕业以后就开始备考",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 624.08,
      "end": 625.92,
      "text": "然后23年的时候考上的",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 626.16,
      "end": 627.6800000000001,
      "text": "考上的那一刻我就觉得",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 628.48,
      "end": 632.4,
      "text": "我还是挺厉害的当时就是尾巴翘到天上去了",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 632.64,
      "end": 634.4,
      "text": "觉得我自己是一个研究生了",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 634.48,
      "end": 640.0,
      "text": "来到山东以后发现会比我考试的人多得多了其实我真的不是说擅长考试我只是",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 642.0,
      "end": 643.6800000000001,
      "text": "习惯了死记硬背",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 644.4,
      "end": 646.96,
      "text": "像中国也是啊中国没有",
      "speaker_id": 0,
      "chunk_offset_seconds": 480
    },
    {
      "start": 647.76,
      "end": 653.36,
      "text": "没有卖出去也是这样啊没有中国也是一样的也是卖不卖卖不出去",
      "speaker_id": 0,
      "chunk_offset_seconds": 480
    },
    {
      "start": 653.44,
      "end": 655.84,
      "text": "放在这里也不是办法嘛是吧",
      "speaker_id": 0,
      "chunk_offset_seconds": 480
    },
    {
      "start": 657.2,
      "end": 661.2,
      "text": "只要有钱赚不管是辛苦再辛苦我们都有无所谓",
      "speaker_id": 0,
      "chunk_offset_seconds": 480
    },
    {
      "start": 661.52,
      "end": 663.76,
      "text": "最难的就是没病就好了一",
      "speaker_id": 0,
      "chunk_offset_seconds": 480
    },
    {
      "start": 663.968,
      "end": 665.84,
      "text": "家人健康就好了是吧",
      "speaker_id": 0,
      "chunk_offset_seconds": 480
    },
    {
      "start": 670.56,
      "end": 676.24,
      "text": "中医是文献目前在就业市场上没有什么工作跟这个专业是对口的当然我父母",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 676.56,
      "end": 686.56,
      "text": "特别是我妈对我抱了很大的期待她以为我在学学中医她以为我以后可能可以当一个医生但这些我都没有告诉她其实并不是像她想的那样的",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 687.6,
      "end": 689.44,
      "text": "对包括我考这个专业",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 690.72,
      "end": 691.76,
      "text": "包括我学医",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 692.96,
      "end": 695.28,
      "text": "我觉得我妈对我的影响比较大吧",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 695.52,
      "end": 703.6,
      "text": "她一直希望我当一名医生但是但是我高考的时候失败了考研的时候也失败了转专业的时候也失败了对",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 705.653,
      "end": 706.4,
      "text": "就是",
      "speaker_id": 1,
      "chunk_offset_seconds": 480
    },
    {
      "start": 711.2,
      "end": 719.84,
      "text": "小谷家的脐橙长在山上只有年迈的母亲和腿脚不便的父亲爬上坡一颗颗亲手摘下现采现发。",
      "speaker_id": 3,
      "chunk_offset_seconds": 480
    },
    {
      "start": 720.0,
      "end": 725.44,
      "text": "擦干净 打好包再由母亲开着小三轮颠簸着去镇上寄快递",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 725.84,
      "end": 728.4,
      "text": "每一天都是一场与时间的赛跑",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 728.8,
      "end": 730.08,
      "text": "如果订单不多",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 730.0,
      "end": 731.6,
      "text": "快递成本就会上涨",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 731.84,
      "end": 734.32,
      "text": "如果大寒来临前果子还未采摘",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 734.4,
      "end": 736.4,
      "text": "它们将经不起严寒的侵袭",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 736.96,
      "end": 738.88,
      "text": "若是过年后仍未售罄",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 738.96,
      "end": 743.36,
      "text": "只能眼睁睁看着一年的心血在枝头腐烂无奈丢弃",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 743.68,
      "end": 749.6,
      "text": "质朴勤劳的农户从不懂网络世界的定价规则只恐稍贵就无人问津",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 749.84,
      "end": 751.44,
      "text": "母亲夜夜焦虑",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 751.36,
      "end": 752.88,
      "text": "价格一降再降",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 752.8,
      "end": 753.92,
      "text": "只盼卖出",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 754.08,
      "end": 755.84,
      "text": "还清借来的化肥钱",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 755.92,
      "end": 758.0,
      "text": "稍补家用便心满意足",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 758.4,
      "end": 760.96,
      "text": "郑和想为这份不易撑一把伞",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 761.04,
      "end": 763.76,
      "text": "我们郑重承诺每一份售出的橙子",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 763.68,
      "end": 765.28,
      "text": "利润仅三到5元",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 765.36,
      "end": 770.08,
      "text": "我们绝不压低果农的价格只为让这些辛勤的双手真正受益",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 770.16,
      "end": 771.6,
      "text": "让每一位农人",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 771.52,
      "end": 773.44,
      "text": "通过自己的汗水与坚守",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 773.36,
      "end": 776.32,
      "text": "收获属于他们的尊严与富足",
      "speaker_id": 0,
      "chunk_offset_seconds": 720
    },
    {
      "start": 776.72,
      "end": 778.48,
      "text": "其实我对自己还是有期许的我",
      "speaker_id": 1,
      "chunk_offset_seconds": 720
    },
    {
      "start": 778.76,
      "end": 779.6,
      "text": "希望我",
      "speaker_id": 1,
      "chunk_offset_seconds": 720
    },
    {
      "start": 779.84,
      "end": 782.8,
      "text": "嗯 能够变得更爱思考",
      "speaker_id": 1,
      "chunk_offset_seconds": 720
    },
    {
      "start": 782.72,
      "end": 785.84,
      "text": "我能够看清楚一件事情它为什么会是现在这样子",
      "speaker_id": 1,
      "chunk_offset_seconds": 720
    },
    {
      "start": 795.84,
      "end": 798.88,
      "text": "右手边有一个上山的岔路",
      "speaker_id": 1,
      "chunk_offset_seconds": 720
    },
    {
      "start": 798.8,
      "end": 800.3199999999999,
      "text": "右手边 右手边这个",
      "speaker_id": 1,
      "chunk_offset_seconds": 720
    },
    {
      "start": 800.8,
      "end": 802.0,
