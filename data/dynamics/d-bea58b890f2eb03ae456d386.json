                    "orig_text": "诸位深圳深耘俱乐部的会员们：",
                    "pics": [],
                    "rid": "",
                    "style": null,
                    "text": "诸位深圳深耘俱乐部的会员们：",
                    "type": "RICH_TEXT_NODE_TYPE_TEXT",
                    "video": null
                  },
                  {
                    "emoji": null,
                    "goods": null,
                    "icon_name": "",
                    "icon_url": "",
                    "jump_url": "",
                    "orig_text": "\n",
                    "pics": [],
