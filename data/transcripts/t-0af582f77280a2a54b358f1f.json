      "end": 711130
    },
    {
      "ordinal": 263,
      "text": "我没有这样说啊",
      "start": 711130,
      "end": 712730
    },
    {
      "ordinal": 264,
      "text": "我们不做这种事情",
      "start": 712730,
      "end": 713630
    },
    {
      "ordinal": 265,
      "text": "这种事情没意义",
      "start": 713630,
      "end": 714800
    },
    {
      "ordinal": 266,
      "text": "我们是现实的",
