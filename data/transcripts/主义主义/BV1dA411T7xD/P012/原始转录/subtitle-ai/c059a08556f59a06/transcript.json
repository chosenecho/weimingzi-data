    {
      "ordinal": 10,
      "start_ms": 28140,
      "end_ms": 31049,
      "text": "如果你对于纯的性质的把握把握"
    },
    {
      "ordinal": 11,
      "start_ms": 31049,
      "end_ms": 32549,
      "text": "是注重它的保护性"
    },
    {
      "ordinal": 12,
      "start_ms": 32549,
      "end_ms": 33869,
      "text": "那你就是练纯皮"
    },
    {
      "ordinal": 13,
      "start_ms": 33869,
      "end_ms": 35919,
      "text": "如果你是注重它的敏感性"
    },
    {
      "ordinal": 14,
      "start_ms": 38610,
      "end_ms": 41880,
      "text": "敏感性这个纯的半纯的敏感性"
    },
    {
      "ordinal": 15,
      "start_ms": 46100,
      "end_ms": 48800,
      "text": "就是他会把这个人的脚啊"
    },
    {
      "ordinal": 16,
      "start_ms": 48800,
      "end_ms": 52730,
      "text": "人的足投射为这个人的足投射为纯"
    },
    {
      "ordinal": 17,
      "start_ms": 52730,
      "end_ms": 59380,
      "text": "人的足投射为纯纯的那种敏感的敏感敏感的"
    },
    {
      "ordinal": 18,
      "start_ms": 59380,
      "end_ms": 60460,
      "text": "还有这个"
    },
    {
      "ordinal": 19,
      "start_ms": 60460,
      "end_ms": 63380,
      "text": "因为人的脚是很敏感的嘛"
    },
    {
      "ordinal": 20,
      "start_ms": 63380,
      "end_ms": 65180,
      "text": "嗯你的脚脚底心很敏感的"
    },
    {
      "ordinal": 21,
      "start_ms": 65180,
      "end_ms": 66440,
      "text": "还会进一步"
    },
    {
      "ordinal": 22,
      "start_ms": 66440,
      "end_ms": 69920,
      "text": "人们还会把他的那个脚趾脚趾啊"
