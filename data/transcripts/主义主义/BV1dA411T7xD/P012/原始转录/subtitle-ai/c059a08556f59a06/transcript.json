    {
      "ordinal": 24,
      "start_ms": 72200,
      "end_ms": 75700,
      "text": "会把脚趾和脚趾夹她的脚趾上面"
    },
    {
      "ordinal": 25,
      "start_ms": 75700,
      "end_ms": 81410,
      "text": "脚趾甲指甲指甲上面的脚指甲角"
    },
    {
      "ordinal": 26,
      "start_ms": 81410,
      "end_ms": 84110,
      "text": "把这个东西就和牙齿对应起来"
    },
    {
      "ordinal": 27,
      "start_ms": 84110,
      "end_ms": 85790,
      "text": "和牙齿对应起来啊"
    },
    {
      "ordinal": 28,
      "start_ms": 85790,
      "end_ms": 86150,
      "text": "了解吗"
    },
    {
      "ordinal": 29,
      "start_ms": 86150,
      "end_ms": 89120,
      "text": "就是一半这个牙齿牙齿指甲"
