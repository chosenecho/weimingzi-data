      "text": "对劳苦大众这种话",
      "start": 543419,
      "end": 544739,
      "index": 143
    },
    {
      "text": "以待天时",
      "start": 544739,
      "end": 545919,
      "index": 144
    },
    {
      "text": "换到明天",
      "start": 545919,
      "end": 546619,
      "index": 145
    },
