      "ordinal": 102,
      "text": "享乐当中",
      "start": 416360,
      "end": 418100
    },
    {
      "ordinal": 103,
      "text": "我不希望你们浑浑噩噩",
      "start": 418840,
      "end": 422260
    },
    {
      "ordinal": 104,
      "text": "百无聊赖",
      "start": 422260,
      "end": 423580
    },
    {
      "ordinal": 105,
      "text": "用一些低俗的",
      "start": 424620,
      "end": 426780
    },
    {
      "ordinal": 106,
      "text": "无聊的八卦的话题填补自己的业余生活",
      "start": 426780,
      "end": 431620
    },
    {
      "ordinal": 107,
      "text": "我希望你们有所成长",
