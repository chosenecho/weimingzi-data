      "end": 633460
    },
    {
      "ordinal": 174,
      "text": "自己劳作",
      "start": 633460,
      "end": 634620
    },
    {
      "ordinal": 175,
      "text": "在过日子的时候",
      "start": 634620,
      "end": 636820
    },
    {
      "ordinal": 176,
      "text": "把日子过起来了啊",
      "start": 636820,
      "end": 639920
    },
    {
      "ordinal": 177,
      "text": "把路走通了",
