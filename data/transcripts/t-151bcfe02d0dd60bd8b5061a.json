      "end": 293900
    },
    {
      "ordinal": 71,
      "text": "还是一个萧瑟的啊",
      "start": 293900,
      "end": 297250
    },
    {
      "ordinal": 72,
      "text": "秋天了",
      "start": 298840,
      "end": 299540
    },
    {
      "ordinal": 73,
      "text": "我不确定",
      "start": 299540,
      "end": 300920
    },
    {
      "ordinal": 74,
      "text": "哦我不确定",
      "start": 310080,
      "end": 312160
    },
    {
      "ordinal": 75,
      "text": "凉凉下来",
      "start": 321820,
      "end": 324140
    },
    {
      "ordinal": 76,
      "text": "这个水才好喝进肚子里",
      "start": 325180,
      "end": 326940
    },
    {
      "ordinal": 77,
      "text": "凉凉下来啊",
