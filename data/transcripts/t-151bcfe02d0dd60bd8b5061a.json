      "end": 621920
    },
    {
      "ordinal": 169,
      "text": "得让大家都这个腾出手来",
      "start": 621920,
      "end": 624980
    },
    {
      "ordinal": 170,
      "text": "得让大家都什么安稳的坐下来",
