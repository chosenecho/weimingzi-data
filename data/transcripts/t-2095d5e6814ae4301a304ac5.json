      "end": 539459
    },
    {
      "ordinal": 200,
      "text": "四就代表一种幻灭",
      "start": 539459,
      "end": 541010
    },
    {
      "ordinal": 201,
      "text": "1234这四个标志是用来简单代表四种理论",
