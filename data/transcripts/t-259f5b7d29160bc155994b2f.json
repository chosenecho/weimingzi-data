      "ordinal": 222,
      "text": "什么也是这样讨论问题的",
      "start": 611870,
      "end": 614079
    },
    {
      "ordinal": 223,
      "text": "这种不断扩大的联合",
      "start": 614360,
      "end": 616460
    },
    {
      "ordinal": 224,
      "text": "必然导致最终组成什么什么什么样",
      "start": 616460,
      "end": 619520
    },
    {
      "ordinal": 225,
      "text": "当大家都看到了工人经济都能自发性时",
      "start": 619520,
      "end": 622660
    },
    {
      "ordinal": 226,
      "text": "要把自觉的因素带到自发斗争当中去",
      "start": 623620,
      "end": 625900
    },
    {
      "ordinal": 227,
      "text": "并扩大并领导自发斗争",
      "start": 631360,
      "end": 633840
    },
    {
      "ordinal": 228,
      "text": "最终达到自觉斗争",
      "start": 633840,
      "end": 635859
    },
    {
      "ordinal": 229,
      "text": "黑格尔主义者却借口这是自发斗争而加以反对",
      "start": 636300,
      "end": 639960
    },
    {
      "ordinal": 230,
      "text": "谁割裂的谁是黑格尔主义者",
      "start": 642780,
      "end": 646540
    },
    {
      "ordinal": 231,
      "text": "黑格尔主义者却借口这是自发斗争而加以反对",
      "start": 647460,
      "end": 650900
    },
    {
      "ordinal": 232,
      "text": "你现在不也反对我做的事情",
      "start": 650900,
      "end": 653000
    },
    {
      "ordinal": 233,
      "text": "就依然是自发斗争吗",
      "start": 653000,
      "end": 654920
    },
    {
      "ordinal": 234,
      "text": "我办公益食堂工人的工",
      "start": 655200,
      "end": 657840
    },
    {
      "ordinal": 235,
      "text": "我让工人聚在一起吃饭聊天",
      "start": 657840,
      "end": 660450
    },
    {
      "ordinal": 236,
      "text": "生成他的组织头脑关系",
      "start": 660450,
      "end": 663089
    },
    {
      "ordinal": 237,
      "text": "在你这边就是我也是自发斗争",
      "start": 663089,
      "end": 665489
    },
    {
      "ordinal": 238,
      "text": "然后你也反对我这个自发斗争了",
      "start": 665489,
      "end": 667660
    },
    {
      "ordinal": 239,
      "text": "谁才是黑格尔主义者",
      "start": 667660,
      "end": 669920
    },
    {
      "ordinal": 240,
      "text": "谁才是打着马列",
      "start": 669980,
      "end": 671570
    },
    {
      "ordinal": 241,
      "text": "谁根本没斗争",
      "start": 676940,
      "end": 678579
    },
    {
      "ordinal": 242,
      "text": "谁根本没有动身",
      "start": 679380,
      "end": 681080
    },
    {
      "ordinal": 243,
      "text": "你在动身吗",
      "start": 682160,
      "end": 683640
    },
    {
      "ordinal": 244,
      "text": "谁写来写去",
      "start": 684540,
      "end": 686000
    },
    {
      "ordinal": 245,
      "text": "文章是在写他自己",
      "start": 686000,
      "end": 687280
    }
