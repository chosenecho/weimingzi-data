      "ordinal": 359,
      "text": "这里是个被迫",
      "start": 848740,
      "end": 849700
    },
    {
      "ordinal": 360,
      "text": "他陷于一个窘境",
      "start": 849700,
      "end": 851460
    },
    {
      "ordinal": 361,
      "text": "他处在一个紧张状态",
