{"segments":[{"start":0.68,"end":2.57,"text":"由于我是民间身份啊"},{"start":2.57,"end":8.56,"text":"所以我只能用乌克兰的共产主义活动家的称号"},{"start":8.56,"end":14.289,"text":"来称呼两位青年活动家啊"},{"start":14.289,"end":18.5,"text":"就是米哈伊尔科诺诺维奇和他的兄弟"},{"start":19.419,"end":20.039,"text":"那么"},{"start":22.679,"end":28.58,"text":"我谴责一个反动的乌克兰的当局的呃"},{"start":31.1,"end":32.619,"text":"未经审判"},{"start":32.619,"end":39.66,"text":"就要对这两位共产与活动家施加死刑啊"},{"start":39.66,"end":42.9,"text":"这样一种法西斯做派纳粹行径啊"},{"start":42.9,"end":45.66,"text":"扼杀共产主义力量的这种啊"},{"start":45.66,"end":54.4,"text":"这种行动应当受到全世界啊拥护社会主义"},{"start":54.4,"end":57.48,"text":"追求共产主义者的一致谴责"},{"start":59.34,"end":66.56,"text":"那么我也忽略中文互联网上的民间的啊"},{"start":66.56,"end":71.69,"text":"这个社会主义嗯支持者和共产主义的追求者啊"},{"start":71.69,"end":73.32,"text":"像这个"},{"start":74.96,"end":79.7,"text":"乌克兰当局可能做出的这一严重违反啊"},{"start":81.4,"end":85.259,"text":"它自己所宣称的所谓的资产阶级法制"},{"start":85.66,"end":88.72,"text":"也严重侵害啊"},{"start":88.72,"end":93.259,"text":"全世界无产阶级的情感啊"},{"start":93.52,"end":100.86,"text":"严重损害全世界共产主义者所应当享有的啊"},{"start":100.86,"end":104.06,"text":"正义和尊严"},{"start":106.32,"end":108.77,"text":"对这样的举动加以谴责"},{"start":108.77,"end":110.42,"text":"那我点名了啊"},{"start":110.42,"end":113.15,"text":"这个马前卒已经退网了"},{"start":113.15,"end":117.55,"text":"那就说呃我点杨和平好吧"},{"start":117.55,"end":120.71,"text":"这个事情上你也表个态啊"},{"start":120.71,"end":121.97,"text":"那我希望就是说"},{"start":121.97,"end":122.84,"text":"然后另外一方面"},{"start":122.84,"end":130.039,"text":"我们要说的就是说你任何在中文互联网上啊"},{"start":130.039,"end":132.26,"text":"打着拥护共产主义旗号"},{"start":132.26,"end":134.24,"text":"追求共产主义理想"},{"start":134.24,"end":138.44,"text":"却为乌克兰啊"},{"start":139.58,"end":143.38,"text":"乌克兰当局所可能采取的这样一个倒行逆施"},{"start":143.38,"end":146.77,"text":"人神共愤的这种行为做辩护的"},{"start":146.77,"end":150.51,"text":"那你们是共产主义支持啊"},{"start":150.51,"end":153.72,"text":"就是说这个你就说是其他异性的"},{"start":153.72,"end":156.59,"text":"比如说知乎这个问题下面其他异形啊"},{"start":156.59,"end":157.37,"text":"什么自由主义"},{"start":157.37,"end":159.35,"text":"什么这玩意儿的那个就另说"},{"start":159.35,"end":160.97,"text":"那本来就不是咱们不是一路人"},{"start":160.97,"end":164.54,"text":"那你如果是自居还自居社会主义者的啊"},{"start":164.54,"end":165.92,"text":"还追求共产主义的"},{"start":165.92,"end":168.6,"text":"那么对于这种残暴的行为"},{"start":169.699,"end":171.819,"text":"当然又有人要嘲讽了啊"},{"start":171.819,"end":173.439,"text":"未经审判直接啊"},{"start":173.439,"end":174.9,"text":"但是我们自己人啊"},{"start":175.06,"end":178.69,"text":"他这个未经审判直接枪决"},{"start":178.69,"end":182.3,"text":"这是违背了他自己的资产阶级法权"},{"start":182.3,"end":185.84,"text":"当然王雷王雷我们也不抱有什么幻想"},{"start":185.84,"end":189.59,"text":"我们不论就为美帝国主义做马前卒的"},{"start":189.59,"end":195.059,"text":"这么一个为北约啊战争机器啊"},{"start":195.059,"end":196.919,"text":"干做绞肉机的"},{"start":196.919,"end":200.879,"text":"干做溃疡面的这么一个事例啊"},{"start":200.879,"end":204.779,"text":"这个泽连斯基本来就是一个好像是一个亲俄的"},{"start":204.779,"end":206.579,"text":"一个寡头的傀儡"},{"start":206.579,"end":209.34,"text":"后来就是说令又投靠了北约"},{"start":211.08,"end":212.96,"text":"他自己本身是傀儡啊"},{"start":212.96,"end":215.54,"text":"纳粹的里面的这个"},{"start":217.36,"end":219.12,"text":"啊极端民族主义"},{"start":219.12,"end":223.08,"text":"甚至可以说纳啊这个呃乌克兰的极端民主义"},{"start":223.08,"end":230.489,"text":"甚至说纳粹主义的这种势力屡次挑拨啊"},{"start":230.489,"end":237.12,"text":"制造俄乌两族人民的互相仇杀的惨惨烈的啊"},{"start":237.12,"end":238.71,"text":"这一个事情啊"},{"start":238.71,"end":240.28,"text":"惨烈的历史事实"},{"start":240.679,"end":245.459,"text":"然后给资产阶级的俄国啊"},{"start":245.459,"end":250.7,"text":"赋予了开启战争的这个一个口实"},{"start":251.399,"end":252.079,"text":"制造"},{"start":252.079,"end":256.819,"text":"两双方共同制造出大量的这个战争的"},{"start":256.819,"end":258.6,"text":"罪行和暴力啊"},{"start":259.14,"end":261.42,"text":"那么共产主义运动呢"},{"start":261.42,"end":264.699,"text":"在这么一个人类历史都可以说的"},{"start":264.699,"end":266.259,"text":"人类历史的溃疡面上"},{"start":266.259,"end":267.579,"text":"共产主义的力量"},{"start":267.579,"end":274.55,"text":"无论是啊这个乌东地区的啊"},{"start":274.55,"end":277.04,"text":"还是这个乌克兰啊"},{"start":277.04,"end":279.8,"text":"他的西部地区城市里面的共产主义力量"},{"start":279.8,"end":285.35,"text":"都成为一个非常啊卓越的有效的反战"},{"start":285.35,"end":286.49,"text":"追求和平"},{"start":286.49,"end":290.59,"text":"防止无产阶级内部仇杀的力量啊"},{"start":290.59,"end":294.01,"text":"都是想要尽快结束战争"},{"start":294.01,"end":298.04,"text":"从这种啊资本主义国家啊"},{"start":298.04,"end":302.059,"text":"而且是一个被不叫被迫反击啊"},{"start":302.059,"end":303.259,"text":"哎呀某种意义上讲"},{"start":303.259,"end":306.499,"text":"也是为了维持他自己政权内部稳定的资产"},{"start":306.499,"end":307.639,"text":"与俄国"},{"start":307.639,"end":313.39,"text":"他对于这个帝国主义北约的这种反击啊"},{"start":313.39,"end":316.32,"text":"那么我所了解的信息就是说"},{"start":316.32,"end":318.47,"text":"真正的共产主义力量啊"},{"start":318.47,"end":322.43,"text":"真正的战斗的积极分子的攻传性力量"},{"start":322.43,"end":325.89,"text":"都是努力想要行走"},{"start":325.89,"end":327.54,"text":"而且说难听点"},{"start":327.54,"end":329.16,"text":"乌克兰都总动员了"},{"start":329.16,"end":330.24,"text":"总动员了"},{"start":330.24,"end":332.61,"text":"为了给北约下投名状"},{"start":332.61,"end":336.179,"text":"总动员派上去坦克陈皮陈皮的死"},{"start":336.179,"end":340.0,"text":"老百姓沉迷沉迷的死啊"},{"start":340.0,"end":342.46,"text":"无产阶级就被成批成批的"},{"start":342.46,"end":345.159,"text":"送到这个战争的绞肉机里面"},{"start":345.159,"end":347.199,"text":"葬送他的命运"},{"start":347.199,"end":350.88,"text":"葬送他的对于这个人生道路的选择权"},{"start":351.74,"end":353.26,"text":"那我说呃"},{"start":353.26,"end":358.06,"text":"我号召乌克兰服产阶级啊啊以及一切啊"},{"start":358.56,"end":359.88,"text":"反对战争"},{"start":359.88,"end":361.02,"text":"追求和平"},{"start":361.02,"end":364.43,"text":"反抗资本主义暴政统治的啊"},{"start":364.43,"end":366.23,"text":"人民群众团结起来"},{"start":366.23,"end":367.76,"text":"团结起来啊"},{"start":367.76,"end":369.14,"text":"用一切方式"},{"start":369.14,"end":370.96,"text":"用一切方式"},{"start":373.52,"end":378.16,"text":"啊用一些方式拒绝成为这样的啊"},{"start":378.16,"end":380.59,"text":"自然阶级内斗的牺牲品"},{"start":380.59,"end":382.6,"text":"拒绝成为两个"},{"start":383.039,"end":384.539,"text":"一个自然与俄国"},{"start":384.539,"end":386.519,"text":"还有一个是帝国主义的北约"},{"start":386.519,"end":389.76,"text":"他们陷入可耻内斗的牺牲品"},{"start":390.2,"end":393.23,"text":"那么团结在这样的啊"},{"start":393.23,"end":397.5,"text":"卓越的本国的共产主义势力的周围啊"},{"start":397.5,"end":400.28,"text":"成为一个坚定的反战力量"},{"start":400.42,"end":404.44,"text":"那么也首要的我呼吁俄国的啊"},{"start":404.44,"end":409.199,"text":"我呼吁着乌克兰的这个无产阶级可以啊"},{"start":409.199,"end":411.959,"text":"尽一切可能的努力去挽救啊"},{"start":411.959,"end":416.62,"text":"去营救这位共产主义的活动价好吧"},{"start":416.62,"end":417.97,"text":"那就讲到这里啊"},{"start":417.97,"end":419.65,"text":"啊我点了杨和平的名字"},{"start":419.65,"end":421.39,"text":"我已经做这个宣誓了"},{"start":421.39,"end":422.64,"text":"我的立场就是这样的"},{"start":422.64,"end":425.46,"text":"我也当时说我作为一个民间人士啊"},{"start":425.46,"end":428.02,"text":"我只能啊我民间这样念一念啊"},{"start":428.06,"end":430.4,"text":"啊那样和平站哪一边我就不知道了"},{"start":430.4,"end":430.88,"text":"不管了啊"},{"start":430.88,"end":431.46,"text":"就讲到这里"}],"source":"subtitle"}
