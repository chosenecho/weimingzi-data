{
  "bvid": "BV1Pm4y1874J",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "13582174bf9f5007a31298261a0c7621111c05cf5be7553ac895bbe98b0c1158",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 120,
      "end_ms": 2520,
      "text": "为什么一定要公开实名活动"
    },
    {
      "ordinal": 1,
      "start_ms": 2520,
      "end_ms": 4220,
      "text": "你们现在明白了吧"
    },
    {
      "ordinal": 2,
      "start_ms": 5480,
      "end_ms": 7479,
      "text": "你哪怕再杀俄罗时期"
    },
    {
      "ordinal": 3,
      "start_ms": 12040,
      "end_ms": 17730,
      "text": "或者说在这个第二国际的德国"
    },
    {
      "ordinal": 4,
      "start_ms": 17730,
      "end_ms": 18660,
      "text": "那个时代"
    },
    {
      "ordinal": 5,
      "start_ms": 18660,
      "end_ms": 21770,
      "text": "德国他们被宣布为非法"
    },
    {
      "ordinal": 6,
      "start_ms": 21770,
      "end_ms": 23260,
      "text": "他们也要公开活动"
    },
    {
      "ordinal": 7,
      "start_ms": 26560,
      "end_ms": 28170,
      "text": "被抓到要坐牢"
    },
    {
      "ordinal": 8,
      "start_ms": 28170,
      "end_ms": 30030,
      "text": "但他还要公开活动"
    },
    {
      "ordinal": 9,
      "start_ms": 30030,
      "end_ms": 32490,
      "text": "还有他的头领人物还是要实名"
    },
    {
      "ordinal": 10,
      "start_ms": 32490,
      "end_ms": 34019,
      "text": "为什么他还要公开"
    },
    {
      "ordinal": 11,
      "start_ms": 34240,
      "end_ms": 36280,
      "text": "他哪怕他就被抓起来要坐牢"
    },
    {
      "ordinal": 12,
      "start_ms": 36280,
      "end_ms": 37870,
      "text": "他也要公开实名活动"
    },
    {
      "ordinal": 13,
      "start_ms": 37870,
      "end_ms": 39199,
      "text": "为什么"
    },
    {
      "ordinal": 14,
      "start_ms": 39480,
      "end_ms": 42060,
      "text": "因为这样的政治活动"
    },
    {
      "ordinal": 15,
      "start_ms": 42060,
      "end_ms": 46019,
      "text": "它是需要有它需要募捐的"
    },
    {
      "ordinal": 16,
      "start_ms": 46760,
      "end_ms": 49600,
      "text": "他需要捐款的呃"
    },
    {
      "ordinal": 17,
      "start_ms": 49600,
      "end_ms": 51250,
      "text": "他必须要让他的支持者"
    },
    {
      "ordinal": 18,
      "start_ms": 51250,
      "end_ms": 54620,
      "text": "把他和匿名的诈骗分子区分开来"
    },
    {
      "ordinal": 19,
      "start_ms": 55280,
      "end_ms": 57320,
      "text": "所以他必须实名公开"
    },
    {
      "ordinal": 20,
      "start_ms": 59820,
      "end_ms": 62279,
      "text": "他必须承受这个这个代价"
    },
    {
      "ordinal": 21,
      "start_ms": 62700,
      "end_ms": 65820,
      "text": "所以你们知道为什么一定要实名公开的吧"
    },
    {
      "ordinal": 22,
      "start_ms": 65820,
      "end_ms": 67830,
      "text": "因为他真的想做成一件事情"
    },
    {
      "ordinal": 23,
      "start_ms": 67830,
      "end_ms": 69800,
      "text": "它是需要社会的帮助的"
    },
    {
      "ordinal": 24,
      "start_ms": 70300,
      "end_ms": 74640,
      "text": "需要社会当中的其他的不确定"
    },
    {
      "ordinal": 25,
      "start_ms": 74640,
      "end_ms": 76899,
      "text": "多数的成员的帮助支持的"
    },
    {
      "ordinal": 26,
      "start_ms": 80060,
      "end_ms": 80800,
      "text": "你匿名"
    },
    {
      "ordinal": 27,
      "start_ms": 80800,
      "end_ms": 81520,
      "text": "你拿不到"
    },
    {
      "ordinal": 28,
      "start_ms": 81520,
      "end_ms": 82270,
      "text": "你得不到"
    },
    {
      "ordinal": 29,
      "start_ms": 82270,
      "end_ms": 83620,
      "text": "你得不到这个支持"
    },
    {
      "ordinal": 30,
      "start_ms": 83620,
      "end_ms": 84580,
      "text": "你知道吗"
    },
    {
      "ordinal": 31,
      "start_ms": 85320,
      "end_ms": 86660,
      "text": "人家知道你是谁啊"
    },
    {
      "ordinal": 32,
      "start_ms": 88460,
      "end_ms": 90200,
      "text": "你必须要么你在一个网"
    },
    {
      "ordinal": 33,
      "start_ms": 90200,
      "end_ms": 93030,
      "text": "要么在一个支持者的网络当中"
    },
    {
      "ordinal": 34,
      "start_ms": 93030,
      "end_ms": 95130,
      "text": "你必须大家知道你是谁呀"
    },
    {
      "ordinal": 35,
      "start_ms": 95130,
      "end_ms": 97980,
      "text": "否则怎么把你和骗子区分开来的"
    },
    {
      "ordinal": 36,
      "start_ms": 98060,
      "end_ms": 99890,
      "text": "那我今天要讲的就是说"
    },
    {
      "ordinal": 37,
      "start_ms": 99890,
      "end_ms": 104119,
      "text": "一定要注意到匿名性和诈骗的这种捆绑关系"
    },
    {
      "ordinal": 38,
      "start_ms": 106600,
      "end_ms": 107700,
      "text": "明白吗"
    },
    {
      "ordinal": 39,
      "start_ms": 109280,
      "end_ms": 112420,
      "text": "匿名意味着不知道他是谁"
    },
    {
      "ordinal": 40,
      "start_ms": 112420,
      "end_ms": 114179,
      "text": "你追责不到他"
    },
    {
      "ordinal": 41,
      "start_ms": 114420,
      "end_ms": 116430,
      "text": "他弄一些假消息出来"
    },
    {
      "ordinal": 42,
      "start_ms": 116430,
      "end_ms": 117540,
      "text": "今天说失业了"
    },
    {
      "ordinal": 43,
      "start_ms": 117540,
      "end_ms": 119940,
      "text": "明天说老子娘得癌了"
    },
    {
      "ordinal": 44,
      "start_ms": 119940,
      "end_ms": 121080,
      "text": "后天说怎么怎么样"
    },
    {
      "ordinal": 45,
      "start_ms": 121080,
      "end_ms": 122160,
      "text": "腿摔断了"
    },
    {
      "ordinal": 46,
      "start_ms": 122500,
      "end_ms": 124180,
      "text": "他这个是可以诈骗了"
    },
    {
      "ordinal": 47,
      "start_ms": 124180,
      "end_ms": 124780,
      "text": "你知道吗"
    },
    {
      "ordinal": 48,
      "start_ms": 124780,
      "end_ms": 126340,
      "text": "你想象出来他的一个形象"
    },
    {
      "ordinal": 49,
      "start_ms": 126340,
      "end_ms": 127600,
      "text": "想象出他的身份"
    },
    {
      "ordinal": 50,
      "start_ms": 127600,
      "end_ms": 128500,
      "text": "他的一个背景"
    },
    {
      "ordinal": 51,
      "start_ms": 128500,
      "end_ms": 129580,
      "text": "他到底是谁"
    },
    {
      "ordinal": 52,
      "start_ms": 130899,
      "end_ms": 136060,
      "text": "所以历史上的左翼的活动家"
    },
    {
      "ordinal": 53,
      "start_ms": 136920,
      "end_ms": 138200,
      "text": "它都是需要"
    },
    {
      "ordinal": 54,
      "start_ms": 138200,
      "end_ms": 139880,
      "text": "除非是军事斗争啊"
    },
    {
      "ordinal": 55,
      "start_ms": 139880,
      "end_ms": 141460,
      "text": "除非是军事斗争"
    },
    {
      "ordinal": 56,
      "start_ms": 141460,
      "end_ms": 144220,
      "text": "偷偷的军事斗争在谍报类意义上的"
    },
    {
      "ordinal": 57,
      "start_ms": 144220,
      "end_ms": 145720,
      "text": "但是作为一个政治活动"
    },
    {
      "ordinal": 58,
      "start_ms": 146680,
      "end_ms": 150300,
      "text": "历史上那些左翼活动人士都是公开使命的"
    },
    {
      "ordinal": 59,
      "start_ms": 150339,
      "end_ms": 152319,
      "text": "哪怕他被宣布为非法"
    },
    {
      "ordinal": 60,
      "start_ms": 152319,
      "end_ms": 152859,
      "text": "你知道吗"
    },
    {
      "ordinal": 61,
      "start_ms": 154239,
      "end_ms": 155280,
      "text": "你了解吗"
    },
    {
      "ordinal": 62,
      "start_ms": 156700,
      "end_ms": 160999,
      "text": "或者说他或者就公众都知道他是谁"
    },
    {
      "ordinal": 63,
      "start_ms": 160999,
      "end_ms": 162739,
      "text": "那你说他如果说要逃的"
    },
    {
      "ordinal": 64,
      "start_ms": 162739,
      "end_ms": 165279,
      "text": "他已经被非法被定义为非法了"
    },
    {
      "ordinal": 65,
      "start_ms": 165279,
      "end_ms": 166059,
      "text": "就要把他抓起来"
    },
    {
      "ordinal": 66,
      "start_ms": 166059,
      "end_ms": 166839,
      "text": "坐牢的那个时候"
    },
    {
      "ordinal": 67,
      "start_ms": 166839,
      "end_ms": 168039,
      "text": "他要逃的那种状态"
    },
    {
      "ordinal": 68,
      "start_ms": 168039,
      "end_ms": 169230,
      "text": "他当然要匿名了"
    },
    {
      "ordinal": 69,
      "start_ms": 169230,
      "end_ms": 172220,
      "text": "当然他当然不能把他这个活生生的"
    },
    {
      "ordinal": 70,
      "start_ms": 172220,
      "end_ms": 175040,
      "text": "身体的控制权和他这个名字对应起来"
    },
    {
      "ordinal": 71,
      "start_ms": 175040,
      "end_ms": 176780,
      "text": "他当然要搞个化名要逃了"
    },
    {
      "ordinal": 72,
      "start_ms": 176780,
      "end_ms": 179300,
      "text": "但并不意味着他想公开去"
    },
    {
      "ordinal": 73,
      "start_ms": 179300,
      "end_ms": 181040,
      "text": "他向公众去活动"
    },
    {
      "ordinal": 74,
      "start_ms": 181040,
      "end_ms": 182450,
      "text": "去灌输他的影响力"
    },
    {
      "ordinal": 75,
      "start_ms": 182450,
      "end_ms": 184440,
      "text": "需要汲取支持的时候"
    },
    {
      "ordinal": 76,
      "start_ms": 184560,
      "end_ms": 186840,
      "text": "他是一定要实名的"
    },
    {
      "ordinal": 77,
      "start_ms": 186840,
      "end_ms": 189060,
      "text": "一定要对于这公众是实名的"
    },
    {
      "ordinal": 78,
      "start_ms": 189060,
      "end_ms": 189780,
      "text": "知道他谁"
    },
    {
      "ordinal": 79,
      "start_ms": 189780,
      "end_ms": 190950,
      "text": "他来自哪里"
    },
    {
      "ordinal": 80,
      "start_ms": 190950,
      "end_ms": 195839,
      "text": "从小到大成长环境明白"
    },
    {
      "ordinal": 81,
      "start_ms": 195839,
      "end_ms": 199319,
      "text": "尤其是他在进行一种募捐的时候"
    },
    {
      "ordinal": 82,
      "start_ms": 199319,
      "end_ms": 200339,
      "text": "那它要做成事"
    },
    {
      "ordinal": 83,
      "start_ms": 200339,
      "end_ms": 202580,
      "text": "他是一定要有社会资源的"
    },
    {
      "ordinal": 84,
      "start_ms": 202839,
      "end_ms": 204459,
      "text": "历史上的革命家"
    },
    {
      "ordinal": 85,
      "start_ms": 204459,
      "end_ms": 208819,
      "text": "他们做成事一定要有社会资源的明白吗"
    },
    {
      "ordinal": 86,
      "start_ms": 208819,
      "end_ms": 210580,
      "text": "一定要社会资源的"
    },
    {
      "ordinal": 87,
      "start_ms": 212700,
      "end_ms": 214480,
      "text": "这是个活生生的人"
    },
    {
      "ordinal": 88,
      "start_ms": 217559,
      "end_ms": 220560,
      "text": "那么这个家伙他处于流亡状态吗"
    },
    {
      "ordinal": 89,
      "start_ms": 220839,
      "end_ms": 221679,
      "text": "你问下"
    },
    {
      "ordinal": 90,
      "start_ms": 221679,
      "end_ms": 224079,
      "text": "今天有一个匿名的家伙说他失业了"
    },
    {
      "ordinal": 91,
      "start_ms": 224079,
      "end_ms": 226989,
      "text": "在互联网上一个半乞讨的一个状态"
    },
    {
      "ordinal": 92,
      "start_ms": 226989,
      "end_ms": 229040,
      "text": "叫别人去给他知识付费"
    },
    {
      "ordinal": 93,
      "start_ms": 229239,
      "end_ms": 231099,
      "text": "那很多人加入他的知识星球"
    },
    {
      "ordinal": 94,
      "start_ms": 231099,
      "end_ms": 233559,
      "text": "只是说要要纯支持他而已"
    },
    {
      "ordinal": 95,
      "start_ms": 233559,
      "end_ms": 237340,
      "text": "并不是说要要去买它那个什么那些服务"
    },
    {
      "ordinal": 96,
      "start_ms": 238140,
      "end_ms": 239450,
      "text": "他是匿名的大哥"
    },
    {
      "ordinal": 97,
      "start_ms": 239450,
      "end_ms": 240560,
      "text": "他也不是流亡吧"
    },
    {
      "ordinal": 98,
      "start_ms": 240560,
      "end_ms": 242630,
      "text": "他很明显不是流亡状态吧"
    },
    {
      "ordinal": 99,
      "start_ms": 242630,
      "end_ms": 247300,
      "text": "他的匿名并不是为了流亡而进行的一个匿名吧"
    },
    {
      "ordinal": 100,
      "start_ms": 249140,
      "end_ms": 250090,
      "text": "不是吧"
    },
    {
      "ordinal": 101,
      "start_ms": 250090,
      "end_ms": 251260,
      "text": "很明显不是吧"
    },
    {
      "ordinal": 102,
      "start_ms": 251260,
      "end_ms": 253540,
      "text": "大哥他的ip地址是北京啊"
    },
    {
      "ordinal": 103,
      "start_ms": 253540,
      "end_ms": 256459,
      "text": "大哥那他在干什么"
    },
    {
      "ordinal": 104,
      "start_ms": 258079,
      "end_ms": 260620,
      "text": "如果他不提供说他失业了"
    },
    {
      "ordinal": 105,
      "start_ms": 260620,
      "end_ms": 263440,
      "text": "并且他不保证他的这个得到的钱"
    },
    {
      "ordinal": 106,
      "start_ms": 263440,
      "end_ms": 267420,
      "text": "确实是用于自己个人生活度过困难时期"
    },
    {
      "ordinal": 107,
      "start_ms": 268060,
      "end_ms": 271560,
      "text": "我们有理由认为有理由认为哦"
    },
    {
      "ordinal": 108,
      "start_ms": 271560,
      "end_ms": 272520,
      "text": "如果他不提供的话"
    },
    {
      "ordinal": 109,
      "start_ms": 272520,
      "end_ms": 274620,
      "text": "我们有理由怀疑他嫌疑"
    },
    {
      "ordinal": 110,
      "start_ms": 274620,
      "end_ms": 275580,
      "text": "他有这个嫌疑"
    },
    {
      "ordinal": 111,
      "start_ms": 275580,
      "end_ms": 276760,
      "text": "他有诈骗的嫌疑"
    },
    {
      "ordinal": 112,
      "start_ms": 277540,
      "end_ms": 279540,
      "text": "到底他是一个人还是一个组织"
    },
    {
      "ordinal": 113,
      "start_ms": 279540,
      "end_ms": 280080,
      "text": "一群人"
    },
    {
      "ordinal": 114,
      "start_ms": 280080,
      "end_ms": 282520,
      "text": "我们不知道还是什么mc不知道"
    },
    {
      "ordinal": 115,
      "start_ms": 282880,
      "end_ms": 283960,
      "text": "另外一方面"
    },
    {
      "ordinal": 116,
      "start_ms": 285160,
      "end_ms": 286720,
      "text": "就算如此"
    },
    {
      "ordinal": 117,
      "start_ms": 288360,
      "end_ms": 290340,
      "text": "就算即便如此"
    },
    {
      "ordinal": 118,
      "start_ms": 292240,
      "end_ms": 295260,
      "text": "这个也也已经是某种木款的形式了"
    },
    {
      "ordinal": 119,
      "start_ms": 295260,
      "end_ms": 297060,
      "text": "实际上也是一种木款的形式了"
    },
    {
      "ordinal": 120,
      "start_ms": 297060,
      "end_ms": 302330,
      "text": "这种木款形式是非常非常非常"
    },
    {
      "ordinal": 121,
      "start_ms": 302330,
      "end_ms": 304320,
      "text": "我们在我们看来"
    },
    {
      "ordinal": 122,
      "start_ms": 304960,
      "end_ms": 307860,
      "text": "而且他就通过这个向公众募款的形式解"
    },
    {
      "ordinal": 123,
      "start_ms": 307860,
      "end_ms": 310440,
      "text": "仅是解决他个人的生存问题"
    },
    {
      "ordinal": 124,
      "start_ms": 310920,
      "end_ms": 312300,
      "text": "这非常可笑的"
    },
    {
      "ordinal": 125,
      "start_ms": 312300,
      "end_ms": 313120,
      "text": "你知道吗"
    },
    {
      "ordinal": 126,
      "start_ms": 313340,
      "end_ms": 316640,
      "text": "因为当年历史上的布尔什维克他要募款"
    },
    {
      "ordinal": 127,
      "start_ms": 316640,
      "end_ms": 319440,
      "text": "他这个募款不是说在解决自己生活费的问题吧"
    },
    {
      "ordinal": 128,
      "start_ms": 321220,
      "end_ms": 322440,
      "text": "游击性的知识分子"
    },
    {
      "ordinal": 129,
      "start_ms": 322440,
      "end_ms": 324980,
      "text": "在当年那个沙俄历史时期"
    },
    {
      "ordinal": 130,
      "start_ms": 324980,
      "end_ms": 326180,
      "text": "他要公开募款"
    },
    {
      "ordinal": 131,
      "start_ms": 326180,
      "end_ms": 327080,
      "text": "他们都是社会精英"
    },
    {
      "ordinal": 132,
      "start_ms": 327080,
      "end_ms": 328040,
      "text": "他自己活不下去吗"
    },
    {
      "ordinal": 133,
      "start_ms": 328040,
      "end_ms": 328880,
      "text": "肯定活得下去"
    },
    {
      "ordinal": 134,
      "start_ms": 328880,
      "end_ms": 332100,
