    {
      "ordinal": 271,
      "start_ms": 707590,
      "end_ms": 709340,
      "text": "不难以驯化的"
    },
    {
      "ordinal": 272,
      "start_ms": 709340,
      "end_ms": 711180,
      "text": "该怎么办怎么办好吧"
    },
    {
      "ordinal": 273,
      "start_ms": 711180,
      "end_ms": 713600,
      "text": "就是按照实际利益出发"
    },
    {
      "ordinal": 274,
      "start_ms": 713600,
      "end_ms": 717750,
      "text": "按照实际的团队的这个存亡心肺出发"
