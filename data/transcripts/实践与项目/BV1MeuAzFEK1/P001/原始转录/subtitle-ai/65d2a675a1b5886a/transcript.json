    {
      "ordinal": 280,
      "start_ms": 724519,
      "end_ms": 728050,
      "text": "了解了解就行了好吧"
    },
    {
      "ordinal": 281,
      "start_ms": 728410,
      "end_ms": 730030,
      "text": "那么这个是我们的一个姿态"
    },
    {
      "ordinal": 282,
      "start_ms": 730030,
      "end_ms": 734210,
      "text": "我的姿态我基本上很讨厌失意文人"
    },
    {
      "ordinal": 283,
      "start_ms": 736280,
      "end_ms": 739160,
      "text": "讨厌的我是个得意文人嘛"
    },
    {
      "ordinal": 284,
      "start_ms": 739160,
      "end_ms": 739920,
      "text": "我不是个文人啊"
    },
    {
      "ordinal": 285,
      "start_ms": 739920,
      "end_ms": 741000,
      "text": "从来不是个文人"
    },
    {
      "ordinal": 286,
      "start_ms": 741000,
      "end_ms": 743670,
      "text": "我算是个隐士啊"
    },
    {
      "ordinal": 287,
      "start_ms": 743670,
      "end_ms": 745170,
      "text": "士人和文人是不一样的"
    },
    {
      "ordinal": 288,
      "start_ms": 745170,
      "end_ms": 748830,
      "text": "但是我不是那个意义上传统意义上的士人"
