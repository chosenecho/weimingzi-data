{
  "bvid": "BV1dg4y157cJ",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "10e0843e647738bc7a61c09fcd2afefe580729d936249ed6a2bb6c620e042ad7",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 0,
      "end_ms": 3120,
      "text": "我们要今天要讲的就是说如何"
    },
    {
      "ordinal": 1,
      "start_ms": 3120,
      "end_ms": 4860,
      "text": "公益小组的成员里面"
    },
    {
      "ordinal": 2,
      "start_ms": 4860,
      "end_ms": 7399,
      "text": "一部分特殊成员如何对应他啊"
    },
    {
      "ordinal": 3,
      "start_ms": 26539,
      "end_ms": 28420,
      "text": "还有一些富二代啊"
    },
    {
      "ordinal": 4,
      "start_ms": 30800,
      "end_ms": 32229,
      "text": "关在富二代"
    },
    {
      "ordinal": 5,
      "start_ms": 32229,
      "end_ms": 34660,
      "text": "那么原则上就是"
    },
    {
      "ordinal": 6,
      "start_ms": 37220,
      "end_ms": 40940,
      "text": "一个大的原则就是公益活动"
    },
    {
      "ordinal": 7,
      "start_ms": 42800,
      "end_ms": 44720,
      "text": "啊不能"
    },
    {
      "ordinal": 8,
      "start_ms": 47280,
      "end_ms": 51300,
      "text": "这些成员的家庭"
    },
    {
      "ordinal": 9,
      "start_ms": 54580,
      "end_ms": 56820,
      "text": "家庭利益"
    },
    {
      "ordinal": 10,
      "start_ms": 62260,
      "end_ms": 66300,
      "text": "沾染我不说污染的话所沾染啊"
    },
    {
      "ordinal": 11,
      "start_ms": 66300,
      "end_ms": 67480,
      "text": "然后呢"
    },
    {
      "ordinal": 12,
      "start_ms": 73080,
      "end_ms": 76530,
      "text": "如果他们的父母被调查"
    },
    {
      "ordinal": 13,
      "start_ms": 76530,
      "end_ms": 78679,
      "text": "或者说啊"
    },
    {
      "ordinal": 14,
      "start_ms": 80540,
      "end_ms": 82340,
      "text": "这种可能性啊"
    },
    {
      "ordinal": 15,
      "start_ms": 82420,
      "end_ms": 84220,
      "text": "有贪腐的可能性"
    },
    {
      "ordinal": 16,
      "start_ms": 84220,
      "end_ms": 86350,
      "text": "那么绝对不能成为"
    },
    {
      "ordinal": 17,
      "start_ms": 86350,
      "end_ms": 88360,
      "text": "绝对不能把公益活动的名义"
    },
    {
      "ordinal": 18,
      "start_ms": 88360,
      "end_ms": 91960,
      "text": "也就是说你们这些年清白的年轻人啊"
    },
    {
      "ordinal": 19,
      "start_ms": 92000,
      "end_ms": 94700,
      "text": "你们这些清白的年轻人"
    },
    {
      "ordinal": 20,
      "start_ms": 96680,
      "end_ms": 97780,
      "text": "头脑不要热"
    },
    {
      "ordinal": 21,
      "start_ms": 99880,
      "end_ms": 101480,
      "text": "富二代是你们的朋友"
    },
    {
      "ordinal": 22,
      "start_ms": 102680,
      "end_ms": 105429,
      "text": "那平时带你们吃香的"
    },
    {
      "ordinal": 23,
      "start_ms": 105429,
      "end_ms": 105969,
      "text": "喝辣的"
    },
    {
      "ordinal": 24,
      "start_ms": 105969,
      "end_ms": 107289,
      "text": "或者说怎么怎么样的"
    },
    {
      "ordinal": 25,
      "start_ms": 107289,
      "end_ms": 108789,
      "text": "你们这些清白年轻人"
    },
    {
      "ordinal": 26,
      "start_ms": 114880,
      "end_ms": 119620,
      "text": "当然我知道这个不会有特别大的用处啊"
    },
    {
      "ordinal": 27,
      "start_ms": 119620,
      "end_ms": 122740,
      "text": "啊我我是比较担心啊"
    },
    {
      "ordinal": 28,
      "start_ms": 129030,
      "end_ms": 133160,
      "text": "它会有一些居心叵测的一些成员"
    },
    {
      "ordinal": 29,
      "start_ms": 133380,
      "end_ms": 136120,
      "text": "他无计可施了"
    },
    {
      "ordinal": 30,
      "start_ms": 141360,
      "end_ms": 144080,
      "text": "那么他本人呢可能还在公益小组里面"
    },
    {
      "ordinal": 31,
      "start_ms": 144080,
      "end_ms": 145520,
      "text": "有一些号召力"
    },
    {
      "ordinal": 32,
      "start_ms": 145520,
      "end_ms": 146330,
      "text": "影响力"
    },
    {
      "ordinal": 33,
      "start_ms": 146330,
      "end_ms": 148550,
      "text": "这个时候可能会啊"
    },
    {
      "ordinal": 34,
      "start_ms": 148550,
      "end_ms": 149870,
      "text": "那么公益小组我说了"
    },
    {
      "ordinal": 35,
      "start_ms": 149870,
      "end_ms": 152929,
      "text": "他只是一个群众啊"
    },
    {
      "ordinal": 36,
      "start_ms": 152929,
      "end_ms": 155779,
      "text": "一起啊献爱心"
    },
    {
      "ordinal": 37,
      "start_ms": 155779,
      "end_ms": 159059,
      "text": "送温暖的一个啊"
    },
    {
      "ordinal": 38,
      "start_ms": 159059,
      "end_ms": 162460,
      "text": "群众的学雷锋做好事的一个运动"
    },
    {
      "ordinal": 39,
      "start_ms": 162920,
      "end_ms": 167500,
      "text": "所以你们哪怕你们到了一个互助的程度"
    },
    {
      "ordinal": 40,
      "start_ms": 168540,
      "end_ms": 174480,
      "text": "不应当去做任何过激的非法的啊"
    },
    {
      "ordinal": 41,
      "start_ms": 174480,
      "end_ms": 179120,
      "text": "非法的事情想要妄图要去给嗯"
    },
    {
      "ordinal": 42,
      "start_ms": 179120,
      "end_ms": 180530,
      "text": "那么这样的成员呢"
    },
    {
      "ordinal": 43,
      "start_ms": 180530,
      "end_ms": 182270,
      "text": "他的家庭啊"
    },
    {
      "ordinal": 44,
      "start_ms": 184670,
      "end_ms": 187070,
      "text": "被查了啊"
    },
    {
      "ordinal": 45,
      "start_ms": 188900,
      "end_ms": 190410,
      "text": "no no no啊"
    },
    {
      "ordinal": 46,
      "start_ms": 190410,
      "end_ms": 192450,
      "text": "不要把你们的清白啊"
    },
    {
      "ordinal": 47,
      "start_ms": 192450,
      "end_ms": 196440,
      "text": "而且是你们一群人的清白当成是一个要挟"
    },
    {
      "ordinal": 48,
      "start_ms": 196440,
      "end_ms": 199040,
      "text": "当成是一个啊"
    },
    {
      "ordinal": 49,
      "start_ms": 199040,
      "end_ms": 201470,
      "text": "也不要写什么联名信这种东西了"
    },
    {
      "ordinal": 50,
      "start_ms": 208420,
      "end_ms": 212480,
      "text": "这些身家啊家境较好的"
    },
    {
      "ordinal": 51,
      "start_ms": 212480,
      "end_ms": 214400,
      "text": "说不定哪个屁股就被查了"
    },
    {
      "ordinal": 52,
      "start_ms": 214400,
      "end_ms": 216650,
      "text": "说不定那个就怎么样的"
    },
    {
      "ordinal": 53,
      "start_ms": 216650,
      "end_ms": 217700,
      "text": "有个大原则"
    },
    {
      "ordinal": 54,
      "start_ms": 217700,
      "end_ms": 220010,
      "text": "就是说公益公益小组"
    },
    {
      "ordinal": 55,
      "start_ms": 220010,
      "end_ms": 224849,
      "text": "公益团体整个是不能够被利用的"
    },
    {
      "ordinal": 56,
      "start_ms": 224849,
      "end_ms": 226100,
      "text": "不允许"
    },
    {
      "ordinal": 57,
      "start_ms": 230919,
      "end_ms": 235860,
      "text": "富二代成员被这样的一些成员利用"
    },
    {
      "ordinal": 58,
      "start_ms": 235860,
      "end_ms": 239699,
      "text": "用来去维护他的家庭"
    },
    {
      "ordinal": 59,
      "start_ms": 239699,
      "end_ms": 240299,
      "text": "私立"
    },
    {
      "ordinal": 60,
      "start_ms": 243059,
      "end_ms": 244280,
      "text": "啊家庭私利"
    },
    {
      "ordinal": 61,
      "start_ms": 244679,
      "end_ms": 246269,
      "text": "那么同样的道理"
    },
    {
      "ordinal": 62,
      "start_ms": 246269,
      "end_ms": 247739,
      "text": "就按照这个思维方式"
    },
    {
      "ordinal": 63,
      "start_ms": 247739,
      "end_ms": 248219,
      "text": "同样的道理"
    },
    {
      "ordinal": 64,
      "start_ms": 248219,
      "end_ms": 249149,
      "text": "公益团体呢"
    },
    {
      "ordinal": 65,
      "start_ms": 249149,
      "end_ms": 261160,
      "text": "也切记不要让一些啊og的一些地方小官僚啊"
    },
    {
      "ordinal": 66,
      "start_ms": 261519,
      "end_ms": 266940,
      "text": "加餐餐掺杂进他们的名义啊"
    },
    {
      "ordinal": 67,
      "start_ms": 266940,
      "end_ms": 268680,
      "text": "比如哪里的一个管委会"
    },
    {
      "ordinal": 68,
      "start_ms": 268680,
      "end_ms": 271570,
      "text": "哪里的一个什么什么什么什么办公室"
    },
    {
      "ordinal": 69,
      "start_ms": 271570,
      "end_ms": 273620,
      "text": "不要让他掺杂这种名义"
    },
    {
      "ordinal": 70,
      "start_ms": 274319,
      "end_ms": 276619,
      "text": "或者你也不要让一些投机的地方"
    },
    {
      "ordinal": 71,
      "start_ms": 276619,
      "end_ms": 278359,
      "text": "小老板或者小官僚"
    },
    {
      "ordinal": 72,
      "start_ms": 278359,
      "end_ms": 279979,
      "text": "小老板啊"
    },
    {
      "ordinal": 73,
      "start_ms": 279979,
      "end_ms": 282440,
      "text": "让他们掺杂民意或者掺杂股份"
    },
    {
      "ordinal": 74,
      "start_ms": 282700,
      "end_ms": 285970,
      "text": "小老板可能会什么基金会给你一个办公室"
    },
    {
      "ordinal": 75,
      "start_ms": 285970,
      "end_ms": 287749,
      "text": "或者说给你一笔钱"
    },
    {
      "ordinal": 76,
      "start_ms": 287749,
      "end_ms": 289249,
      "text": "这些东西都不能要的"
    },
    {
      "ordinal": 77,
      "start_ms": 289249,
      "end_ms": 290239,
      "text": "为什么呢"
    },
    {
      "ordinal": 78,
      "start_ms": 290239,
      "end_ms": 291979,
      "text": "因为我说了"
    },
    {
      "ordinal": 79,
      "start_ms": 291979,
      "end_ms": 293479,
      "text": "他们愿意掏钱"
    },
    {
      "ordinal": 80,
      "start_ms": 293479,
      "end_ms": 294709,
      "text": "愿意给方便"
    },
    {
      "ordinal": 81,
      "start_ms": 294709,
      "end_ms": 298230,
      "text": "愿意你理解吗"
    },
    {
      "ordinal": 82,
      "start_ms": 300840,
      "end_ms": 302160,
      "text": "因为你们比较干净"
    },
    {
      "ordinal": 83,
      "start_ms": 302160,
      "end_ms": 303880,
      "text": "至少里面是干净的"
    },
    {
      "ordinal": 84,
      "start_ms": 304280,
      "end_ms": 306260,
      "text": "你们这个干净对他们来说"
    },
    {
      "ordinal": 85,
      "start_ms": 306260,
      "end_ms": 308620,
      "text": "就只是擦屁股的厕纸而已"
    },
    {
      "ordinal": 86,
      "start_ms": 309199,
      "end_ms": 314450,
      "text": "了解吗啊目前的态势啊"
    },
    {
      "ordinal": 87,
      "start_ms": 314450,
      "end_ms": 316080,
      "text": "那我的观点就是说"
    },
    {
      "ordinal": 88,
      "start_ms": 317980,
      "end_ms": 323100,
      "text": "啊我们始终要保证的一个就是干净纯洁干净啊"
    },
    {
      "ordinal": 89,
      "start_ms": 325380,
      "end_ms": 326990,
      "text": "保证纯洁干净"
    },
    {
      "ordinal": 90,
      "start_ms": 326990,
      "end_ms": 327830,
      "text": "不要脏"
    },
    {
      "ordinal": 91,
      "start_ms": 327830,
      "end_ms": 329300,
      "text": "不要被别人利用"
    },
    {
      "ordinal": 92,
      "start_ms": 330320,
      "end_ms": 333820,
      "text": "三那么这个这个纯洁干净呢"
    },
    {
      "ordinal": 93,
      "start_ms": 333820,
      "end_ms": 336910,
      "text": "主要就是说避免让你成为别人的"
    },
    {
      "ordinal": 94,
      "start_ms": 341000,
      "end_ms": 343040,
      "text": "那就做他的挡箭牌"
    },
    {
      "ordinal": 95,
      "start_ms": 346340,
      "end_ms": 348540,
      "text": "被他们拿来做挡箭牌"
    },
    {
      "ordinal": 96,
      "start_ms": 352420,
      "end_ms": 355740,
      "text": "啊防不要不要被人拿来做挡箭牌啊"
    },
    {
      "ordinal": 97,
      "start_ms": 356940,
      "end_ms": 359180,
      "text": "甚至我说的难听点啊"
    },
    {
      "ordinal": 98,
      "start_ms": 359180,
      "end_ms": 360650,
      "text": "这不仅是小老板"
    },
    {
      "ordinal": 99,
      "start_ms": 360650,
      "end_ms": 361610,
      "text": "小官僚"
    },
    {
      "ordinal": 100,
      "start_ms": 361610,
      "end_ms": 363410,
      "text": "甚至有的还有小学者啊"
    },
    {
      "ordinal": 101,
      "start_ms": 363410,
      "end_ms": 364190,
      "text": "有一些学者"
    },
    {
      "ordinal": 102,
      "start_ms": 364190,
      "end_ms": 367600,
      "text": "小的学者也会把你们这些东西拿来做挡箭牌"
    },
    {
      "ordinal": 103,
      "start_ms": 372319,
      "end_ms": 375460,
      "text": "那么还有一件事情就是"
    },
    {
      "ordinal": 104,
      "start_ms": 379460,
      "end_ms": 382080,
      "text": "啊就是说嗯"
    },
    {
      "ordinal": 105,
      "start_ms": 383060,
      "end_ms": 385900,
      "text": "所以你们所就我们所说的这个公益活动"
    },
    {
      "ordinal": 106,
      "start_ms": 385900,
      "end_ms": 388880,
      "text": "这个干净啊啊是"
    },
    {
      "ordinal": 107,
      "start_ms": 390940,
      "end_ms": 395370,
      "text": "不要成为违法犯罪的挡箭牌的意义上的干净"
    },
    {
      "ordinal": 108,
      "start_ms": 395370,
      "end_ms": 396720,
      "text": "不要被这样的"
    },
    {
      "ordinal": 109,
      "start_ms": 396720,
      "end_ms": 399340,
      "text": "可能有这样的要素的东西掺杂进来"
    },
    {
      "ordinal": 110,
      "start_ms": 399560,
      "end_ms": 404620,
      "text": "我并不愿意说那种什么道德严酷主义"
    },
    {
      "ordinal": 111,
      "start_ms": 405039,
      "end_ms": 407499,
      "text": "我不说的干净并不是严酷主义啊"
    },
    {
      "ordinal": 112,
      "start_ms": 407499,
      "end_ms": 409280,
      "text": "并不是严酷主义啊"
    },
    {
      "ordinal": 113,
      "start_ms": 409460,
      "end_ms": 411200,
      "text": "啊什么出身论这种东西"
    },
    {
      "ordinal": 114,
      "start_ms": 411200,
      "end_ms": 412920,
      "text": "我不是严酷主义出身论"
    },
    {
      "ordinal": 115,
      "start_ms": 412920,
      "end_ms": 414900,
      "text": "你们小孩一天到晚都在争的"
    },
    {
      "ordinal": 116,
      "start_ms": 414900,
      "end_ms": 415800,
      "text": "谁是小资"
    },
    {
      "ordinal": 117,
      "start_ms": 415800,
      "end_ms": 416730,
      "text": "谁是小布"
    },
    {
      "ordinal": 118,
      "start_ms": 416730,
      "end_ms": 418710,
      "text": "这种东西干净不干净"
    },
    {
      "ordinal": 119,
      "start_ms": 418710,
      "end_ms": 422030,
      "text": "你们可能对于就是干净做的再简单一点"
    },
    {
      "ordinal": 120,
      "start_ms": 422030,
      "end_ms": 423720,
      "text": "就是免于法律风险"
    },
    {
      "ordinal": 121,
      "start_ms": 424020,
      "end_ms": 427040,
      "text": "就是你们这些人要免于法律风险"
    },
    {
      "ordinal": 122,
      "start_ms": 429680,
      "end_ms": 433150,
      "text": "你们做事情首先要免于法律风险"
    },
    {
      "ordinal": 123,
      "start_ms": 433150,
      "end_ms": 434530,
      "text": "不要违法犯罪"
    },
    {
      "ordinal": 124,
      "start_ms": 434530,
      "end_ms": 436000,
      "text": "你自己不保护犯罪"
    },
    {
      "ordinal": 125,
      "start_ms": 436000,
      "end_ms": 438920,
      "text": "同时你也不要被别人当顿时"
    },
    {
      "ordinal": 126,
      "start_ms": 438920,
      "end_ms": 440960,
      "text": "不要被别人当盾神当枪使"
    },
    {
      "ordinal": 127,
      "start_ms": 440960,
      "end_ms": 443420,
      "text": "可能我已经足够给你们教训了"
    },
    {
      "ordinal": 128,
      "start_ms": 443420,
      "end_ms": 445640,
      "text": "但是你不要被别人当盾使啊"
    },
    {
      "ordinal": 129,
      "start_ms": 446039,
      "end_ms": 448559,
      "text": "学生学生你什么都没有"
    },
    {
      "ordinal": 130,
      "start_ms": 448559,
      "end_ms": 449759,
      "text": "但是你有清白"
    },
    {
      "ordinal": 131,
      "start_ms": 449759,
      "end_ms": 452040,
      "text": "你这个清白可能被别人拿去用"
    },
    {
      "ordinal": 132,
      "start_ms": 452420,
      "end_ms": 455120,
      "text": "要记得要当提防一点啊"
    },
    {
