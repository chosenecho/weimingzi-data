  "content_sha256": "6e86b0c4982737831297349c634c60861e755345c3441c97153bb6e227210014",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 0,
      "end_ms": 1960,
      "text": "这个呃项目情况"
    },
    {
      "ordinal": 1,
      "start_ms": 6180,
      "end_ms": 11450,
      "text": "跟进来要向关注者要汇报一下"
    },
    {
      "ordinal": 2,
      "start_ms": 11450,
      "end_ms": 16980,
      "text": "就是说这个营养星期四的这个事情啊"
    },
    {
      "ordinal": 3,
      "start_ms": 17980,
      "end_ms": 20100,
      "text": "就是食堂啊"
    },
    {
      "ordinal": 4,
      "start_ms": 20100,
      "end_ms": 22700,
      "text": "他的后厨房难走"
    },
    {
      "ordinal": 5,
      "start_ms": 23780,
      "end_ms": 25240,
      "text": "受到一点挫折啊"
    },
    {
      "ordinal": 6,
      "start_ms": 25240,
      "end_ms": 26720,
      "text": "左边一点挫折"
    },
    {
      "ordinal": 7,
      "start_ms": 27980,
      "end_ms": 29680,
      "text": "那么除了这些客服"
    },
    {
      "ordinal": 8,
      "start_ms": 29680,
      "end_ms": 34240,
      "text": "就厨房呢本来我们打算是在一个成员的"
    },
    {
      "ordinal": 9,
      "start_ms": 34240,
      "end_ms": 35080,
      "text": "他的"
    },
    {
      "ordinal": 10,
      "start_ms": 38720,
      "end_ms": 41530,
      "text": "家里的厂里面借用的啊"
    },
    {
      "ordinal": 11,
      "start_ms": 41530,
      "end_ms": 47380,
      "text": "但是呃害怕就说害怕有食品安全隐患"
    },
    {
      "ordinal": 12,
      "start_ms": 47380,
      "end_ms": 48660,
      "text": "怕担责任"
    },
    {
      "ordinal": 13,
      "start_ms": 49220,
      "end_ms": 51640,
      "text": "但是长发呢他自己说了不算了"
    },
    {
      "ordinal": 14,
      "start_ms": 51640,
      "end_ms": 54130,
      "text": "食品安全的问题"
    },
    {
      "ordinal": 15,
      "start_ms": 54130,
      "end_ms": 56740,
      "text": "他们害怕担这个责任"
    },
    {
      "ordinal": 16,
      "start_ms": 56740,
      "end_ms": 62510,
      "text": "那么就啊拒绝拒绝借不借"
    },
    {
      "ordinal": 17,
      "start_ms": 62510,
      "end_ms": 63440,
      "text": "没谈下来啊"
    },
    {
      "ordinal": 18,
      "start_ms": 63440,
      "end_ms": 64440,
      "text": "没谈下来"
    },
    {
      "ordinal": 19,
      "start_ms": 64440,
      "end_ms": 66930,
      "text": "我们的行动能力是很弱小的"
    },
    {
      "ordinal": 20,
      "start_ms": 66930,
      "end_ms": 68100,
      "text": "那么这种情况下"
    },
    {
      "ordinal": 21,
      "start_ms": 68100,
      "end_ms": 69660,
      "text": "我们准备两个方案"
    },
    {
      "ordinal": 22,
      "start_ms": 69660,
      "end_ms": 73600,
      "text": "一个就是说在我们自己的出租屋里面"
    },
    {
      "ordinal": 23,
      "start_ms": 76020,
      "end_ms": 78560,
      "text": "出租屋里啊"
    },
    {
      "ordinal": 24,
      "start_ms": 78560,
      "end_ms": 80119,
      "text": "可以搞个一次两次"
    },
    {
      "ordinal": 25,
      "start_ms": 81660,
      "end_ms": 83150,
      "text": "出租屋里面啊"
    },
    {
      "ordinal": 26,
      "start_ms": 83150,
      "end_ms": 84950,
      "text": "那出租屋排烟"
    },
    {
      "ordinal": 27,
      "start_ms": 84950,
      "end_ms": 86179,
      "text": "还有一个"
    },
    {
      "ordinal": 28,
      "start_ms": 89060,
      "end_ms": 90790,
      "text": "灶台的问题"
    },
    {
      "ordinal": 29,
      "start_ms": 90790,
      "end_ms": 94679,
      "text": "然后另外一方面就是把我现在的电脑来改造"
    },
    {
      "ordinal": 30,
      "start_ms": 96640,
      "end_ms": 98440,
      "text": "改造改造"
    },
    {
      "ordinal": 31,
      "start_ms": 98440,
      "end_ms": 100900,
      "text": "把烟道和这个排水就改造出来"
    },
    {
      "ordinal": 32,
      "start_ms": 100900,
      "end_ms": 104620,
      "text": "把这个呃这个灶台啊都改造出来"
    },
    {
      "ordinal": 33,
      "start_ms": 104620,
      "end_ms": 109080,
      "text": "我们准备把这个酒吧的嗯"
    },
    {
      "ordinal": 34,
      "start_ms": 110820,
      "end_ms": 114910,
      "text": "我不知道你们有没有去过这个酒吧啊"
    },
    {
      "ordinal": 35,
      "start_ms": 119230,
      "end_ms": 120630,
      "text": "这里是仓库"
    },
    {
      "ordinal": 36,
      "start_ms": 120630,
      "end_ms": 121770,
      "text": "这里是仓库"
    },
    {
      "ordinal": 37,
      "start_ms": 123540,
      "end_ms": 125130,
      "text": "然后这里是八台"
    },
    {
      "ordinal": 38,
      "start_ms": 131700,
      "end_ms": 132500,
      "text": "给毁掉"
    },
    {
      "ordinal": 39,
      "start_ms": 133520,
      "end_ms": 134750,
      "text": "就是拆了"
    },
    {
      "ordinal": 40,
      "start_ms": 134750,
      "end_ms": 138010,
      "text": "那就是钱装修的"
    },
    {
      "ordinal": 41,
      "start_ms": 139540,
      "end_ms": 141190,
      "text": "这个损失就不要算了"
    },
    {
      "ordinal": 42,
      "start_ms": 141190,
      "end_ms": 145459,
      "text": "然后把它改造成一个厨房"
    },
    {
      "ordinal": 43,
      "start_ms": 145459,
      "end_ms": 146640,
      "text": "一个后厨"
    },
    {
      "ordinal": 44,
      "start_ms": 149679,
      "end_ms": 154400,
      "text": "我们以前的师傅过去报价是6000 6000元"
    },
    {
      "ordinal": 45,
      "start_ms": 155040,
      "end_ms": 156480,
      "text": "有专业的人来改"
    },
    {
      "ordinal": 46,
      "start_ms": 156480,
      "end_ms": 160780,
      "text": "他就是烟道要排排气通道呀"
    },
    {
      "ordinal": 47,
      "start_ms": 160780,
      "end_ms": 163510,
      "text": "还有这个走的电路啊"
    },
    {
      "ordinal": 48,
      "start_ms": 163510,
      "end_ms": 164800,
      "text": "消防呀"
    },
    {
      "ordinal": 49,
      "start_ms": 164800,
      "end_ms": 165820,
      "text": "他漏电呀"
    },
    {
      "ordinal": 50,
      "start_ms": 165820,
      "end_ms": 167440,
      "text": "可能那边要重新做弱电"
    },
    {
      "ordinal": 51,
      "start_ms": 167440,
      "end_ms": 169270,
      "text": "然后还要做排水"
    },
    {
      "ordinal": 52,
      "start_ms": 169270,
      "end_ms": 175669,
      "text": "然后这里本来有一个有一个长桌"
    },
    {
      "ordinal": 53,
      "start_ms": 175669,
      "end_ms": 177499,
      "text": "是混凝土打的"
    },
    {
      "ordinal": 54,
      "start_ms": 177499,
      "end_ms": 179450,
      "text": "但是他有点下线了啊"
    },
    {
      "ordinal": 55,
      "start_ms": 179450,
      "end_ms": 181130,
      "text": "然后有这个东西在的话"
    },
    {
      "ordinal": 56,
      "start_ms": 181130,
      "end_ms": 182750,
      "text": "可能就做不了多少人吧"
    },
    {
      "ordinal": 57,
      "start_ms": 182750,
      "end_ms": 185460,
      "text": "我打算这个不确定的"
    },
    {
      "ordinal": 58,
      "start_ms": 185460,
      "end_ms": 186630,
      "text": "要不要把它拆掉"
    },
    {
      "ordinal": 59,
      "start_ms": 186630,
      "end_ms": 187380,
      "text": "他也是"
    },
    {
      "ordinal": 60,
      "start_ms": 187380,
      "end_ms": 188280,
      "text": "2000块钱做的"
    },
    {
      "ordinal": 61,
      "start_ms": 188280,
      "end_ms": 189480,
      "text": "当时花了2000块钱"
    },
    {
      "ordinal": 62,
      "start_ms": 189480,
      "end_ms": 191580,
      "text": "让那个让那个师傅做的"
    },
    {
      "ordinal": 63,
      "start_ms": 191580,
      "end_ms": 192720,
      "text": "他们现在混凝土"
    },
    {
      "ordinal": 64,
      "start_ms": 192720,
      "end_ms": 196320,
      "text": "他里面的钢筋都变形了"
    },
    {
      "ordinal": 65,
      "start_ms": 197520,
      "end_ms": 198950,
      "text": "电要改造一下"
    },
    {
      "ordinal": 66,
      "start_ms": 198950,
      "end_ms": 199520,
      "text": "改造一下"
    },
    {
      "ordinal": 67,
      "start_ms": 199520,
      "end_ms": 201530,
      "text": "就是后厨要改造一下这里的"
    },
    {
      "ordinal": 68,
      "start_ms": 201530,
      "end_ms": 206260,
      "text": "当然这里有有三组还是四组卡座啊"
    },
    {
      "ordinal": 69,
      "start_ms": 206260,
      "end_ms": 207040,
      "text": "还有二楼"
    },
    {
      "ordinal": 70,
      "start_ms": 207040,
      "end_ms": 208300,
      "text": "二楼有好多座位"
    },
    {
      "ordinal": 71,
      "start_ms": 208300,
      "end_ms": 210660,
      "text": "二楼有好的座位或者座位的话"
    },
    {
      "ordinal": 72,
      "start_ms": 210660,
      "end_ms": 211620,
      "text": "其实是够做的"
    },
    {
      "ordinal": 73,
      "start_ms": 211620,
      "end_ms": 213600,
      "text": "你这个这个这个不动的话"
    },
    {
      "ordinal": 74,
      "start_ms": 213600,
      "end_ms": 214380,
      "text": "它也可以"
    },
    {
      "ordinal": 75,
      "start_ms": 214380,
      "end_ms": 215940,
      "text": "这里有高脚凳啊"
    },
    {
      "ordinal": 76,
      "start_ms": 215940,
      "end_ms": 218239,
      "text": "在旁边可以高脚凳啊"
    },
    {
      "ordinal": 77,
      "start_ms": 218239,
      "end_ms": 221100,
      "text": "在旁边可以做"
    },
    {
      "ordinal": 78,
      "start_ms": 221100,
      "end_ms": 221820,
      "text": "好多人呢"
    },
    {
      "ordinal": 79,
      "start_ms": 221820,
      "end_ms": 224940,
      "text": "就说吃就吃饭的座位肯定是够的啊"
    },
    {
      "ordinal": 80,
      "start_ms": 224940,
      "end_ms": 226650,
      "text": "只是这个后厨要改造"
    },
    {
      "ordinal": 81,
      "start_ms": 233940,
      "end_ms": 234720,
      "text": "你知道我们平时"
    },
    {
      "ordinal": 82,
      "start_ms": 234720,
      "end_ms": 235560,
      "text": "发货什么的"
    },
    {
      "ordinal": 83,
      "start_ms": 238500,
      "end_ms": 240300,
      "text": "他当然平时没声音的时候"
    },
    {
      "ordinal": 84,
      "start_ms": 240300,
      "end_ms": 241560,
      "text": "他就是用来发货"
    },
    {
      "ordinal": 85,
      "start_ms": 241560,
      "end_ms": 243140,
      "text": "用的是发货用的"
    },
    {
      "ordinal": 86,
      "start_ms": 243380,
      "end_ms": 245270,
      "text": "要进行这么一个改造"
    },
    {
      "ordinal": 87,
      "start_ms": 245270,
      "end_ms": 246560,
      "text": "改造完毕了之后呢"
    },
    {
      "ordinal": 88,
      "start_ms": 246560,
      "end_ms": 247910,
      "text": "那直接就在店里面"
    },
    {
      "ordinal": 89,
      "start_ms": 247910,
      "end_ms": 248720,
      "text": "店里面"
    },
    {
      "ordinal": 90,
      "start_ms": 248720,
      "end_ms": 250280,
      "text": "那么直接就做饭的话"
    },
    {
      "ordinal": 91,
      "start_ms": 250280,
      "end_ms": 252400,
      "text": "我们有志愿者呃"
    },
    {
      "ordinal": 92,
      "start_ms": 254260,
      "end_ms": 254920,
      "text": "我们有志愿者"
    },
    {
      "ordinal": 93,
      "start_ms": 254920,
      "end_ms": 256839,
      "text": "他以前是开餐馆的啊"
    },
    {
      "ordinal": 94,
      "start_ms": 256839,
      "end_ms": 261740,
      "text": "我们准备把他就是半勤或者全勤啊啊让他过来兼职"
    },
    {
      "ordinal": 95,
      "start_ms": 261740,
      "end_ms": 264040,
      "text": "或者说直接就把他雇佣了"
    },
    {
      "ordinal": 96,
      "start_ms": 266420,
      "end_ms": 269339,
      "text": "志愿者他就是雇佣他"
    },
    {
      "ordinal": 97,
      "start_ms": 269339,
      "end_ms": 273120,
      "text": "他不他可能如果他就想就是义务劳动的"
    },
    {
      "ordinal": 98,
      "start_ms": 274560,
      "end_ms": 277160,
      "text": "我们那还是要给报酬"
    },
    {
      "ordinal": 99,
      "start_ms": 277160,
      "end_ms": 278660,
      "text": "那就讲到这边啊"
    },
    {
      "ordinal": 100,
      "start_ms": 278660,
      "end_ms": 280610,
      "text": "就目前来说就是这么个状况"
    },
    {
      "ordinal": 101,
      "start_ms": 280610,
      "end_ms": 281900,
      "text": "那国庆之后呢"
    },
    {
      "ordinal": 102,
      "start_ms": 281900,
      "end_ms": 284400,
      "text": "呃明天就今天啊"
    },
    {
      "ordinal": 103,
      "start_ms": 284400,
      "end_ms": 286590,
      "text": "10月9号我去给他们开会"
    },
    {
      "ordinal": 104,
      "start_ms": 286590,
      "end_ms": 292800,
      "text": "然后我要讲的就是说呃以及一步一个脚印啊"
    },
    {
      "ordinal": 105,
      "start_ms": 292800,
      "end_ms": 299040,
      "text": "事情没有那么那没有那么没有那么没那么简单的"
    },
    {
      "ordinal": 106,
      "start_ms": 299040,
      "end_ms": 300620,
      "text": "没那么容易的"
    },
    {
      "ordinal": 107,
      "start_ms": 305700,
      "end_ms": 309040,
      "text": "呃我自认已经是尽了最大的可能了"
    },
    {
      "ordinal": 108,
      "start_ms": 310600,
      "end_ms": 312240,
      "text": "我们就参与度"
    },
    {
      "ordinal": 109,
      "start_ms": 312240,
      "end_ms": 312870,
      "text": "关注度"
    },
    {
      "ordinal": 110,
      "start_ms": 312870,
      "end_ms": 314650,
      "text": "参与度和关注度"
    },
    {
      "ordinal": 111,
      "start_ms": 314650,
      "end_ms": 319270,
      "text": "还有他的一个乘以一个他的一方面是它的时效"
    },
    {
      "ordinal": 112,
      "start_ms": 319270,
      "end_ms": 321440,
      "text": "还有一方面它的可复制性"
    },
    {
      "ordinal": 113,
      "start_ms": 324440,
      "end_ms": 327840,
      "text": "啊我们要让这个沉积呢尽可能大"
    },
    {
      "ordinal": 114,
      "start_ms": 329840,
      "end_ms": 334480,
      "text": "时效和参与度可以可以看一组关注度和可复制性"
    },
    {
      "ordinal": 115,
      "start_ms": 334480,
      "end_ms": 335300,
      "text": "又是一组"
    },
    {
      "ordinal": 116,
      "start_ms": 340700,
      "end_ms": 345200,
      "text": "啊我们我们讲的就是说我们实事求是讲这个啊"
    },
    {
      "ordinal": 117,
      "start_ms": 345200,
      "end_ms": 347870,
      "text": "另外一个可以跟大家呃承诺的一点"
    },
    {
      "ordinal": 118,
      "start_ms": 347870,
      "end_ms": 349910,
      "text": "就是说我们这个星期四啊"
    },
    {
      "ordinal": 119,
      "start_ms": 349910,
      "end_ms": 352130,
      "text": "这个项目做起来之后呢"
    },
    {
      "ordinal": 120,
      "start_ms": 352130,
      "end_ms": 353700,
      "text": "是可以那个"
    },
    {
      "ordinal": 121,
      "start_ms": 355720,
      "end_ms": 356850,
      "text": "在广东啊"
    },
    {
      "ordinal": 122,
      "start_ms": 356850,
      "end_ms": 359520,
      "text": "在广东是由崇拜啊"
    },
    {
      "ordinal": 123,
      "start_ms": 359520,
      "end_ms": 363780,
      "text": "是或者说是有机构或者说组织是有和我们合作的"
    },
    {
      "ordinal": 124,
      "start_ms": 364180,
      "end_ms": 367210,
      "text": "我们也可以就是说相应的在广东也开展"
    },
    {
      "ordinal": 125,
      "start_ms": 367210,
      "end_ms": 368890,
      "text": "也开展这样的店"
    },
    {
      "ordinal": 126,
      "start_ms": 368890,
      "end_ms": 370760,
      "text": "也开展这样的店"
    },
    {
      "ordinal": 127,
      "start_ms": 371300,
      "end_ms": 374080,
      "text": "然后我就说我还是说了"
    },
    {
      "ordinal": 128,
      "start_ms": 374080,
      "end_ms": 374960,
      "text": "就是说"
    },
    {
      "ordinal": 129,
      "start_ms": 376840,
      "end_ms": 385700,
      "text": "哎呦我大致就是说的就是说敢做事的这个"
    },
    {
      "ordinal": 130,
      "start_ms": 389620,
      "end_ms": 390300,
      "text": "有点"
    },
    {
      "ordinal": 131,
      "start_ms": 393120,
      "end_ms": 394420,
      "text": "木屑啊"
    },
    {
      "ordinal": 132,
      "start_ms": 397980,
      "end_ms": 400970,
      "text": "那个你们绕圈子准备闹多少年了"
    },
    {
      "ordinal": 133,
      "start_ms": 400970,
      "end_ms": 402200,
      "text": "唠一辈子吗"
    },
    {
      "ordinal": 134,
      "start_ms": 402200,
      "end_ms": 404320,
      "text": "绕圈子绕圈子绕圈子"
    },
