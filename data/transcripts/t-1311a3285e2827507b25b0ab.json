    {
      "ordinal": 87,
      "text": "新的忠诚",
      "start": 290730,
      "end": 292090
    },
    {
      "ordinal": 88,
      "text": "新的服从",
      "start": 292090,
      "end": 293010
    },
    {
      "ordinal": 89,
      "text": "新的正义",
      "start": 293010,
      "end": 294670
    },
    {
      "ordinal": 90,
      "text": "新的偏袒",
      "start": 295270,
      "end": 296290
    },
    {
      "ordinal": 91,
      "text": "甚至说啊新的憎恨啊",
      "start": 296290,
      "end": 300290
    },
    {
      "ordinal": 92,
      "text": "新的安定性",
      "start": 300290,
      "end": 303260
    },
    {
      "ordinal": 93,
      "text": "新的秩序",
      "start": 303260,
      "end": 304420
    },
    {
      "ordinal": 94,
      "text": "新的幸福",
      "start": 304420,
      "end": 306360
    },
    {
      "ordinal": 95,
      "text": "他甚至有这种",
      "start": 306800,
      "end": 309040
    },
    {
      "ordinal": 96,
      "text": "他需要有这种气度和这样的一种忍耐",
      "start": 309040,
      "end": 313580
    },
    {
      "ordinal": 97,
      "text": "忍耐这些新的关联",
      "start": 313580,
      "end": 316220
    },
    {
      "ordinal": 98,
      "text": "新的范式诞生时降临时候的那无限的痛苦",
      "start": 317300,
      "end": 322610
    },
    {
      "ordinal": 99,
      "text": "他是一个妊娠者孕育者",
      "start": 322610,
      "end": 325750
    },
    {
      "ordinal": 100,
      "text": "所以某种人一样",
      "start": 325950,
      "end": 326750
    },
    {
      "ordinal": 101,
      "text": "他像个共同体的一个新的母亲呐",
      "start": 326750,
      "end": 330390
    },
    {
      "ordinal": 102,
      "text": "兽是第一个母亲",
      "start": 330390,
      "end": 332910
    },
    {
      "ordinal": 103,
      "text": "我那个人他有这样一种",
      "start": 332910,
      "end": 336680
    },
    {
      "ordinal": 104,
      "text": "我们讲的就是这个意义上的革命家",
      "start": 336680,
      "end": 339220
    },
    {
      "ordinal": 105,
      "text": "职业革命家",
      "start": 339220,
      "end": 339920
    },
    {
      "ordinal": 106,
      "text": "他不仅仅是政治革命家或者军事统领袖",
      "start": 339920,
      "end": 343690
    },
    {
      "ordinal": 107,
      "text": "意义上的",
      "start": 343690,
      "end": 344090
    },
    {
      "ordinal": 108,
      "text": "它是某种生活方式",
      "start": 344090,
      "end": 345330
    },
    {
      "ordinal": 109,
      "text": "或者某种存在的价值基准",
      "start": 345330,
      "end": 348450
    },
    {
      "ordinal": 110,
      "text": "的一个一个创制者和一个接生者",
      "start": 348450,
      "end": 354709
    },
    {
      "ordinal": 111,
      "text": "或者一个认生者",
      "start": 354709,
      "end": 356549
    },
    {
      "ordinal": 112,
      "text": "唉总之这个过程每一个绝对性的降临",
      "start": 356549,
      "end": 363330
    },
    {
      "ordinal": 113,
      "text": "或者说他的重新的结构和呈现",
      "start": 363330,
      "end": 366090
    },
    {
      "ordinal": 114,
      "text": "都包含着欲望的异化扭曲",
      "start": 366090,
      "end": 372020
    },
    {
      "ordinal": 115,
      "text": "啊一个解放性的一个努力",
      "start": 374060,
      "end": 378350
    },
    {
      "ordinal": 116,
      "text": "是试图去使得这样的异化和扭曲",
      "start": 378350,
      "end": 381070
    },
    {
      "ordinal": 117,
      "text": "为其更长远的计划所用的服从于这种计划",
      "start": 381070,
      "end": 386020
    },
    {
      "ordinal": 118,
      "text": "并且转化成组织的共同体的合力",
      "start": 386020,
      "end": 389360
    },
    {
      "ordinal": 119,
      "text": "以及和整个社会的共鸣和相互的包容啊",
      "start": 389360,
      "end": 397630
    },
    {
      "ordinal": 120,
      "text": "是能在现实当中生根落地的",
      "start": 397630,
      "end": 400770
    },
    {
      "ordinal": 121,
      "text": "所以我们并不惧怕与权力关",
      "start": 402420,
      "end": 405020
    },
    {
      "ordinal": 122,
      "text": "权力关系的扭结甚至扭曲",
      "start": 405020,
      "end": 408590
    },
    {
      "ordinal": 123,
      "text": "我们也并不惧怕于组织和这个活动当中的额",
      "start": 408590,
      "end": 415390
    },
    {
      "ordinal": 124,
      "text": "这个拥挤和散漫和",
      "start": 415520,
      "end": 421760
    },
    {
      "ordinal": 125,
      "text": "秩序本身所带来的一些倾轧和践踏",
      "start": 424800,
      "end": 428440
    },
    {
      "ordinal": 126,
      "text": "这东西就存在很正常啊",
      "start": 428440,
      "end": 430720
    },
    {
      "ordinal": 127,
      "text": "历史的某一个环节",
      "start": 430720,
      "end": 432000
    },
    {
      "ordinal": 128,
      "text": "每一个这",
      "start": 432000,
      "end": 433600
    },
    {
      "ordinal": 129,
      "text": "你哪怕洗澡的时候",
      "start": 436120,
      "end": 438240
    },
    {
      "ordinal": 130,
      "text": "你搓身上的哪块哪块这个污渍",
      "start": 438240,
      "end": 440760
    },
    {
      "ordinal": 131,
      "text": "你就感觉搓的差不多就行了",
      "start": 440760,
      "end": 443669
    },
    {
      "ordinal": 132,
      "text": "搓的太多的皮层",
      "start": 443669,
      "end": 444949
    },
    {
      "ordinal": 133,
      "text": "搓的太少了",
      "start": 444949,
      "end": 445469
    },
    {
      "ordinal": 134,
      "text": "感觉没搓干净",
      "start": 445469,
      "end": 446269
    },
    {
      "ordinal": 135,
      "text": "但是总体来讲差不多",
      "start": 446269,
      "end": 448029
    },
    {
      "ordinal": 136,
      "text": "给予活动家啊",
      "start": 452990,
      "end": 455210
    },
    {
      "ordinal": 137,
      "text": "作为职业革命家",
      "start": 455210,
      "end": 456190
    },
    {
      "ordinal": 138,
      "text": "存在和活动的机遇的窗口只有10~25年嗯",
      "start": 456190,
      "end": 463680
    },
    {
      "ordinal": 139,
      "text": "历史是非常残酷的",
      "start": 463680,
      "end": 466520
    },
    {
      "ordinal": 140,
      "text": "当你足够成熟的时候",
      "start": 466520,
      "end": 468700
    },
    {
      "ordinal": 141,
      "text": "你可能要到30多岁",
      "start": 468700,
      "end": 470120
    },
    {
      "ordinal": 142,
      "text": "40多岁",
      "start": 470120,
      "end": 470980
    },
    {
      "ordinal": 143,
      "text": "然后然后你要足够幸运的免幸免于难",
      "start": 470980,
      "end": 475650
    },
    {
      "ordinal": 144,
      "text": "不停的去发挥相应的影响和作用",
      "start": 475650,
      "end": 479630
    },
    {
      "ordinal": 145,
      "text": "那其实也就十几20年的时间",
      "start": 479630,
      "end": 482034
    },
    {
      "ordinal": 146,
      "text": "然后你会背弃你自身",
      "start": 483800,
      "end": 485800
    },
    {
      "ordinal": 147,
      "text": "然后你会失败或者被消灭",
      "start": 485800,
      "end": 490520
    },
    {
      "ordinal": 148,
      "text": "所以我要说的是呃",
      "start": 491380,
      "end": 496049
    },
    {
      "ordinal": 149,
      "text": "职业革命家不应当惧怕权力的异化",
      "start": 496889,
      "end": 499289
    },
    {
      "ordinal": 150,
      "text": "也不应当就是从这些斗争当中怯懦的退场",
      "start": 500329,
      "end": 506669
    },
    {
      "ordinal": 151,
      "text": "因为这个斗争",
      "start": 506669,
      "end": 507789
    },
    {
      "ordinal": 152,
      "text": "那是和自身的斗争和生存是一个底色的",
      "start": 507789,
      "end": 512289
    },
    {
      "ordinal": 153,
      "text": "他本来就是生存的职责",
      "start": 512289,
      "end": 516049
    },
    {
      "ordinal": 154,
      "text": "或者说",
      "start": 516049,
      "end": 518140
    },
    {
      "ordinal": 155,
      "text": "他就是本来就是啊",
      "start": 523159,
      "end": 525250
    },
    {
      "ordinal": 156,
      "text": "这就是本来就是不断的去设立",
      "start": 525250,
      "end": 527850
    },
    {
      "ordinal": 157,
      "text": "本来就是不断的去跳到时间之前",
      "start": 527850,
      "end": 531810
    },
    {
      "ordinal": 158,
      "text": "抢在时间之前去给出顺序",
      "start": 531810,
      "end": 537510
    },
    {
      "ordinal": 159,
      "text": "给出秩序",
      "start": 537510,
      "end": 539250
    },
    {
      "ordinal": 160,
      "text": "给出优先性",
      "start": 539250,
      "end": 541420
    },
    {
      "ordinal": 161,
      "text": "这个过程是每一个职业革命家",
      "start": 541820,
      "end": 545660
    },
    {
      "ordinal": 162,
      "text": "都需要去深思和创制的",
      "start": 545660,
      "end": 550080
    },
    {
      "ordinal": 163,
      "text": "或者说我们说去闯荡",
      "start": 551400,
      "end": 553280
    },
    {
      "ordinal": 164,
      "text": "甚至我说再夸张一点",
      "start": 553280,
      "end": 555200
    },
    {
      "ordinal": 165,
      "text": "是去流浪而被",
      "start": 555200,
      "end": 558040
    },
    {
      "ordinal": 166,
      "text": "而为幸运的获救的就是这个过程",
      "start": 559510,
      "end": 565019
    },
    {
      "ordinal": 167,
      "text": "他一定是如此的",
      "start": 565019,
      "end": 566539
    },
    {
      "ordinal": 168,
      "text": "那么如何才能增加获救的概率呢",
      "start": 566539,
      "end": 570400
    },
    {
      "ordinal": 169,
      "text": "应当坦诚的呼救",
      "start": 572660,
      "end": 574980
    },
    {
      "ordinal": 170,
      "text": "这种坦诚的呼救会成为最为热烈的",
      "start": 575460,
      "end": 579940
    },
    {
      "ordinal": 171,
      "text": "嘶就是你当当你去帮助救助别人的时候",
      "start": 581100,
      "end": 585140
    },
    {
      "ordinal": 172,
      "text": "实际上是职业革命在呼救啊",
      "start": 585140,
      "end": 587060
    },
    {
      "ordinal": 173,
      "text": "他在在进行一种于求",
      "start": 587060,
      "end": 590050
    },
    {
      "ordinal": 174,
      "text": "他在历史当中迷失",
      "start": 590050,
      "end": 591630
    },
    {
      "ordinal": 175,
      "text": "或者说在自身当中迷失了",
      "start": 591630,
      "end": 593770
    },
    {
      "ordinal": 176,
      "text": "在自身的扭结出来的这种权力",
      "start": 593770,
      "end": 596010
    },
    {
      "ordinal": 177,
      "text": "强力当中迷失了",
      "start": 596010,
      "end": 598375
    },
    {
      "ordinal": 178,
      "text": "呃我不是说我迷失了啊",
      "start": 599760,
      "end": 601760
    },
    {
      "ordinal": 179,
      "text": "我我还是比较坚定的",
      "start": 601760,
      "end": 603160
    },
    {
      "ordinal": 180,
      "text": "我能看清清楚各式各样的方向",
      "start": 603160,
      "end": 605180
    },
    {
      "ordinal": 181,
      "text": "我没有说我是迷失的",
      "start": 605180,
      "end": 606940
    },
    {
      "ordinal": 182,
      "text": "我只说是会不断的不断的有这样的环节啊",
      "start": 606940,
      "end": 611400
    },
    {
      "ordinal": 183,
      "text": "有这样的照面",
      "start": 611400,
      "end": 613160
    },
    {
      "ordinal": 184,
      "text": "有这样的遗忘之海",
      "start": 613160,
      "end": 614920
    },
    {
      "ordinal": 185,
      "text": "不断的会把你淹没好吧",
      "start": 614920,
      "end": 618680
    },
    {
      "ordinal": 186,
      "text": "那我作为过来人",
      "start": 618680,
      "end": 620360
    },
    {
      "ordinal": 187,
      "text": "或者说正在途中者",
      "start": 620360,
      "end": 622620
    },
    {
      "ordinal": 188,
      "text": "我有必要把历史的实情向你们袒露啊",
      "start": 622620,
      "end": 627500
    },
    {
      "ordinal": 189,
      "text": "这些东西是非常正常的",
      "start": 627500,
      "end": 630980
    },
    {
      "ordinal": 190,
      "text": "因为",
      "start": 630980,
      "end": 632980
    },
    {
      "ordinal": 191,
      "text": "一切都是必要的",
      "start": 634300,
      "end": 635700
    },
    {
      "ordinal": 192,
      "text": "好吧",
      "start": 635700,
      "end": 636360
    },
    {
      "ordinal": 193,
      "text": "讲到这里啊",
      "start": 636360,
      "end": 637580
    }
  ],
