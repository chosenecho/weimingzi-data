    },
    {
      "ordinal": 333,
      "text": "你们不要自投罗网啊",
      "start": 1166420,
      "end": 1169140
    },
    {
      "ordinal": 334,
      "text": "你们不要质疑其咎",
      "start": 1169140,
      "end": 1171600
    },
    {
      "ordinal": 335,
      "text": "不是说天与不取啊",
