{
  "bvid": "BV1y8411Y7ig",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "9004a30111b7e4356f20f2e98b661f6afedc1f4528dd31318ca3fdffd0e87dde",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 2240,
      "end_ms": 4610,
      "text": "啊回应信件可公开啊"
    },
    {
      "ordinal": 1,
      "start_ms": 4610,
      "end_ms": 6800,
      "text": "他说呃你好"
    },
    {
      "ordinal": 2,
      "start_ms": 6800,
      "end_ms": 10009,
      "text": "请许我花仙花一些篇幅介绍自己"
    },
    {
      "ordinal": 3,
      "start_ms": 10009,
      "end_ms": 11569,
      "text": "我是一名即将毕业大学生"
    },
    {
      "ordinal": 4,
      "start_ms": 13189,
      "end_ms": 15740,
      "text": "结果取决于明年3月份的军检啊"
    },
    {
      "ordinal": 5,
      "start_ms": 15740,
      "end_ms": 16700,
      "text": "我父母都是工人"
    },
    {
      "ordinal": 6,
      "start_ms": 16700,
      "end_ms": 18980,
      "text": "而且他们在工作中都很上进"
    },
    {
      "ordinal": 7,
      "start_ms": 18980,
      "end_ms": 20300,
      "text": "所以我家条件不差"
    },
    {
      "ordinal": 8,
      "start_ms": 20300,
      "end_ms": 22070,
      "text": "工得了我读书"
    },
    {
      "ordinal": 9,
      "start_ms": 22070,
      "end_ms": 23990,
      "text": "但我读书可能和周围人有些差别"
    },
    {
      "ordinal": 10,
      "start_ms": 25310,
      "end_ms": 26619,
      "text": "我考上双非一本"
    },
    {
      "ordinal": 11,
      "start_ms": 26619,
      "end_ms": 29289,
      "text": "那纯是父母紧逼和砸钱进辅导班的手段"
    },
    {
      "ordinal": 12,
      "start_ms": 29289,
      "end_ms": 30820,
      "text": "拉扯进了这样的"
    },
    {
      "ordinal": 13,
      "start_ms": 30820,
      "end_ms": 32020,
      "text": "我身上埋了个炸弹"
    },
    {
      "ordinal": 14,
      "start_ms": 32020,
      "end_ms": 34270,
      "text": "却被我和家人忽视啊"
    },
    {
      "ordinal": 15,
      "start_ms": 34270,
      "end_ms": 35350,
      "text": "到了大学他爆炸了"
    },
    {
      "ordinal": 16,
      "start_ms": 35350,
      "end_ms": 36070,
      "text": "在大学课堂上"
    },
    {
      "ordinal": 17,
      "start_ms": 36070,
      "end_ms": 38110,
      "text": "我几乎没法听一节课"
    },
    {
      "ordinal": 18,
      "start_ms": 38110,
      "end_ms": 39190,
      "text": "在教室里我只有发"
    },
    {
      "ordinal": 19,
      "start_ms": 39190,
      "end_ms": 40630,
      "text": "呆玩睡觉玩手机"
    },
    {
      "ordinal": 20,
      "start_ms": 40630,
      "end_ms": 43060,
      "text": "偶尔想听也就听五分钟就走神了"
    },
    {
      "ordinal": 21,
      "start_ms": 43060,
      "end_ms": 46800,
      "text": "这样的我面临考试时只能临时临考啊"
    },
    {
      "ordinal": 22,
      "start_ms": 46800,
      "end_ms": 48000,
      "text": "只能靠抱佛脚"
    },
    {
      "ordinal": 23,
      "start_ms": 48000,
      "end_ms": 51000,
      "text": "他就靠写成考考抱佛脚恶补"
    },
    {
      "ordinal": 24,
      "start_ms": 51000,
      "end_ms": 53720,
      "text": "但以往我是在辅导班老师指导一下"
    },
    {
      "ordinal": 25,
      "start_ms": 53720,
      "end_ms": 54140,
      "text": "整理知识"
    },
    {
      "ordinal": 26,
      "start_ms": 54140,
      "end_ms": 54500,
      "text": "没老师"
    },
    {
      "ordinal": 27,
      "start_ms": 55880,
      "end_ms": 56540,
      "text": "一盘散沙"
    },
    {
      "ordinal": 28,
      "start_ms": 56540,
      "end_ms": 57440,
      "text": "挂科成了必然"
    },
    {
      "ordinal": 29,
      "start_ms": 57440,
      "end_ms": 59580,
      "text": "连续亮红灯刀到大二"
    },
    {
      "ordinal": 30,
      "start_ms": 59800,
      "end_ms": 60580,
      "text": "我崩溃了"
    },
    {
      "ordinal": 31,
      "start_ms": 60580,
      "end_ms": 61540,
      "text": "我想不出办法了"
    },
    {
      "ordinal": 32,
      "start_ms": 62920,
      "end_ms": 64180,
      "text": "每天我坐在教室"
    },
    {
      "ordinal": 33,
      "start_ms": 64180,
      "end_ms": 64959,
      "text": "图书馆只有哭"
    },
    {
      "ordinal": 34,
      "start_ms": 64959,
      "end_ms": 66100,
      "text": "我不知道该怎么做"
    },
    {
      "ordinal": 35,
      "start_ms": 66100,
      "end_ms": 67480,
      "text": "我被焦虑和悲伤打败了"
    },
    {
      "ordinal": 36,
      "start_ms": 67480,
      "end_ms": 68190,
      "text": "我生病了"
    },
    {
      "ordinal": 37,
      "start_ms": 68190,
      "end_ms": 71010,
      "text": "母亲拿着确诊单走出脑科医院"
    },
    {
      "ordinal": 38,
      "start_ms": 71010,
      "end_ms": 71610,
      "text": "满脸通红"
    },
    {
      "ordinal": 39,
      "start_ms": 71610,
      "end_ms": 72410,
      "text": "眼里还有泪"
    },
    {
      "ordinal": 40,
      "start_ms": 72410,
      "end_ms": 73550,
      "text": "我不是这个东西"
    },
    {
      "ordinal": 41,
      "start_ms": 73550,
      "end_ms": 74030,
      "text": "怎么查"
    },
    {
      "ordinal": 42,
      "start_ms": 74030,
      "end_ms": 74990,
      "text": "都他妈是抑郁症"
    },
    {
      "ordinal": 43,
      "start_ms": 74990,
      "end_ms": 75470,
      "text": "我靠"
    },
    {
      "ordinal": 44,
      "start_ms": 75470,
      "end_ms": 76970,
      "text": "其实他没有病理的"
    },
    {
      "ordinal": 45,
      "start_ms": 76970,
      "end_ms": 77860,
      "text": "没有病理"
    },
    {
      "ordinal": 46,
      "start_ms": 79780,
      "end_ms": 81760,
      "text": "啊我不知道做如何做何"
    },
    {
      "ordinal": 47,
      "start_ms": 81760,
      "end_ms": 83200,
      "text": "表示合并一起来的"
    },
    {
      "ordinal": 48,
      "start_ms": 83200,
      "end_ms": 84360,
      "text": "还有疫情啊"
    },
    {
      "ordinal": 49,
      "start_ms": 84360,
      "end_ms": 86970,
      "text": "呃学校改成了网课教学"
    },
    {
      "ordinal": 50,
      "start_ms": 86970,
      "end_ms": 88740,
      "text": "为我的摆烂创造的好条件"
    },
    {
      "ordinal": 51,
      "start_ms": 88740,
      "end_ms": 91899,
      "text": "那时我认为自己本就不属于大学"
    },
    {
      "ordinal": 52,
      "start_ms": 91900,
      "end_ms": 93760,
      "text": "其实实事求是讲"
    },
    {
      "ordinal": 53,
      "start_ms": 93760,
      "end_ms": 95399,
      "text": "就是按照"
    },
    {
      "ordinal": 54,
      "start_ms": 105060,
      "end_ms": 106740,
      "text": "其实是很不合适的"
    },
    {
      "ordinal": 55,
      "start_ms": 106740,
      "end_ms": 108070,
      "text": "是很不合拍的"
    },
    {
      "ordinal": 56,
      "start_ms": 114720,
      "end_ms": 118290,
      "text": "他是他的那个阶级家庭的那种教育氛围"
    },
    {
      "ordinal": 57,
      "start_ms": 118290,
      "end_ms": 121399,
      "text": "那个知识氛围就让他就进了大学也不行"
    },
    {
      "ordinal": 58,
      "start_ms": 121960,
      "end_ms": 123420,
      "text": "就阶级再生产里面"
    },
    {
      "ordinal": 59,
      "start_ms": 126600,
      "end_ms": 127920,
      "text": "教育资本的"
    },
    {
      "ordinal": 60,
      "start_ms": 131179,
      "end_ms": 132079,
      "text": "对不对"
    },
    {
      "ordinal": 61,
      "start_ms": 139670,
      "end_ms": 141320,
      "text": "我没有说哪个社会啊"
    },
    {
      "ordinal": 62,
      "start_ms": 143970,
      "end_ms": 146340,
      "text": "产里面就不需要生产它的这个教育"
    },
    {
      "ordinal": 63,
      "start_ms": 146340,
      "end_ms": 148350,
      "text": "就是或者说只要生产一小部分"
    },
    {
      "ordinal": 64,
      "start_ms": 148350,
      "end_ms": 150120,
      "text": "这取决于他要干什么活呀"
    },
    {
      "ordinal": 65,
      "start_ms": 150120,
      "end_ms": 154970,
      "text": "取决他是普攻钳工啊"
    },
    {
      "ordinal": 66,
      "start_ms": 157280,
      "end_ms": 160160,
      "text": "不是质检工还是什么什么功"
    },
    {
      "ordinal": 67,
      "start_ms": 160160,
      "end_ms": 161270,
      "text": "取决他是什么工"
    },
    {
      "ordinal": 68,
      "start_ms": 161270,
      "end_ms": 162020,
      "text": "你知道吗"
    },
    {
      "ordinal": 69,
      "start_ms": 163400,
      "end_ms": 164320,
      "text": "组装工"
    },
    {
      "ordinal": 70,
      "start_ms": 166439,
      "end_ms": 168660,
      "text": "电工焊工"
    },
    {
      "ordinal": 71,
      "start_ms": 171760,
      "end_ms": 174300,
      "text": "所以实际上他是被教育系统甩掉的"
    },
    {
      "ordinal": 72,
      "start_ms": 183420,
      "end_ms": 185400,
      "text": "因为他父母他没有教育能力嘛"
    },
    {
      "ordinal": 73,
      "start_ms": 190420,
      "end_ms": 191820,
      "text": "然后于是我不上网课"
    },
    {
      "ordinal": 74,
      "start_ms": 191820,
      "end_ms": 192810,
      "text": "沉迷记享乐"
    },
    {
      "ordinal": 75,
      "start_ms": 192810,
      "end_ms": 194610,
      "text": "那时我认为自己本就不属于大学"
    },
    {
      "ordinal": 76,
      "start_ms": 194610,
      "end_ms": 195360,
      "text": "不上网课"
    },
    {
      "ordinal": 77,
      "start_ms": 195360,
      "end_ms": 196650,
      "text": "陈秘境想到麻醉自己"
    },
    {
      "ordinal": 78,
      "start_ms": 196650,
      "end_ms": 197430,
      "text": "可我母亲不甘心"
    },
    {
      "ordinal": 79,
      "start_ms": 197430,
      "end_ms": 200000,
      "text": "她在期末后打电话给我所有老师"
    },
    {
      "ordinal": 80,
      "start_ms": 200000,
      "end_ms": 200960,
      "text": "求他们给我60分"
    },
    {
      "ordinal": 81,
      "start_ms": 200960,
      "end_ms": 201680,
      "text": "老师都答应了"
    },
    {
      "ordinal": 82,
      "start_ms": 201680,
      "end_ms": 204859,
      "text": "甚至有两位热心点老师主动向我了解情况"
    },
    {
      "ordinal": 83,
      "start_ms": 204859,
      "end_ms": 206299,
      "text": "无非是劝我生活美好"
    },
    {
      "ordinal": 84,
      "start_ms": 206299,
      "end_ms": 207079,
      "text": "我心里感激他们"
    },
    {
      "ordinal": 85,
      "start_ms": 207079,
      "end_ms": 208579,
      "text": "但也觉得没有必要"
    },
    {
      "ordinal": 86,
      "start_ms": 208579,
      "end_ms": 211219,
      "text": "疫情后第一学期我坚持上完了课"
    },
    {
      "ordinal": 87,
      "start_ms": 211219,
      "end_ms": 212839,
      "text": "但化学对我来说依然是天书"
    },
    {
      "ordinal": 88,
      "start_ms": 212839,
      "end_ms": 213379,
      "text": "果不其然"
    },
    {
      "ordinal": 89,
      "start_ms": 213379,
      "end_ms": 214579,
      "text": "成绩单上满堂彩"
    },
    {
      "ordinal": 90,
      "start_ms": 214579,
      "end_ms": 216000,
      "text": "我被辅导员拉去谈话"
    },
    {
      "ordinal": 91,
      "start_ms": 216000,
      "end_ms": 216840,
      "text": "他问我降了一级"
    },
    {
      "ordinal": 92,
      "start_ms": 216840,
      "end_ms": 218820,
      "text": "我想五宝上1年给我60分的老师们"
    },
    {
      "ordinal": 93,
      "start_ms": 218820,
      "end_ms": 221270,
      "text": "我欠他们一人一张卷子降级"
    },
    {
      "ordinal": 94,
      "start_ms": 221270,
      "end_ms": 222290,
      "text": "第1年我真进步了"
    },
    {
      "ordinal": 95,
      "start_ms": 222290,
      "end_ms": 223430,
      "text": "我真的考上了60"
    },
    {
      "ordinal": 96,
      "start_ms": 223430,
      "end_ms": 225590,
      "text": "当然不乏新舍友和老师的帮助"
    },
    {
      "ordinal": 97,
      "start_ms": 225590,
      "end_ms": 226310,
      "text": "我很开心"
    },
    {
      "ordinal": 98,
      "start_ms": 226310,
      "end_ms": 227720,
      "text": "下一学期我又进步了"
    },
    {
      "ordinal": 99,
      "start_ms": 227720,
      "end_ms": 229340,
      "text": "平均分到了70分"
    },
    {
      "ordinal": 100,
      "start_ms": 229340,
      "end_ms": 231250,
      "text": "历史遗留挂科也减少了"
    },
    {
      "ordinal": 101,
      "start_ms": 231250,
      "end_ms": 232270,
      "text": "我动了幻想"
    },
    {
      "ordinal": 102,
      "start_ms": 232270,
      "end_ms": 234070,
      "text": "照这个势头考上研也不是问题"
    },
    {
      "ordinal": 103,
      "start_ms": 234070,
      "end_ms": 235390,
      "text": "但事实证明我错了"
    },
    {
      "ordinal": 104,
      "start_ms": 235390,
      "end_ms": 236200,
      "text": "在我一边"
    },
    {
      "ordinal": 105,
      "start_ms": 236200,
      "end_ms": 239020,
      "text": "他就开始又考70分"
    },
    {
      "ordinal": 106,
      "start_ms": 239020,
      "end_ms": 239800,
      "text": "想考研了"
    },
    {
      "ordinal": 107,
      "start_ms": 239800,
      "end_ms": 240730,
      "text": "在我一边"
    },
    {
      "ordinal": 108,
      "start_ms": 240730,
      "end_ms": 242080,
      "text": "在这他还是要考"
    },
    {
      "ordinal": 109,
      "start_ms": 244960,
      "end_ms": 247540,
      "text": "他要就只问飘飘然"
    },
    {
      "ordinal": 110,
      "start_ms": 256339,
      "end_ms": 259459,
      "text": "帮助他父母摆脱这种糟糕的劳动环境"
    },
    {
      "ordinal": 111,
      "start_ms": 259459,
      "end_ms": 264700,
      "text": "以及帮助他如和他父母一样的劳动者摆脱那种劳动环境"
    },
    {
      "ordinal": 112,
      "start_ms": 264700,
      "end_ms": 267280,
      "text": "而不是说你自己考上好学校"
    },
    {
      "ordinal": 113,
      "start_ms": 267280,
      "end_ms": 268180,
      "text": "考上研究生"
    },
    {
      "ordinal": 114,
      "start_ms": 268180,
      "end_ms": 270070,
      "text": "带你的父母吃香的"
    },
    {
      "ordinal": 115,
      "start_ms": 270070,
      "end_ms": 270610,
      "text": "喝辣的"
    },
    {
      "ordinal": 116,
      "start_ms": 270610,
      "end_ms": 272050,
      "text": "这就是你的历史使命"
    },
    {
      "ordinal": 117,
      "start_ms": 272050,
      "end_ms": 277100,
      "text": "你的历史使命不是仅仅着眼在你父母身上的"
    },
    {
      "ordinal": 118,
      "start_ms": 279830,
      "end_ms": 281310,
      "text": "在我一边啊"
    },
    {
      "ordinal": 119,
      "start_ms": 281310,
      "end_ms": 283000,
      "text": "学校内课程呃"
    },
    {
      "ordinal": 120,
      "start_ms": 283000,
      "end_ms": 286000,
      "text": "一边被研的备考研的第一学期我退步了"
    },
    {
      "ordinal": 121,
      "start_ms": 286000,
      "end_ms": 287200,
      "text": "平均分只有60多"
    },
    {
      "ordinal": 122,
      "start_ms": 287200,
      "end_ms": 289000,
      "text": "考研大概率是不行的"
    },
    {
      "ordinal": 123,
      "start_ms": 289000,
      "end_ms": 291320,
      "text": "因为我连学位证都拿不到的"
    },
    {
      "ordinal": 124,
      "start_ms": 291659,
      "end_ms": 295679,
      "text": "学校平均绩点二点以上可发学位证"
    },
    {
      "ordinal": 125,
      "start_ms": 295679,
      "end_ms": 296759,
      "text": "也就是他只有学历啊"
    },
    {
      "ordinal": 126,
      "start_ms": 296759,
      "end_ms": 298139,
      "text": "通俗点讲就是专业"
    },
    {
      "ordinal": 127,
      "start_ms": 298139,
      "end_ms": 299650,
      "text": "课均分70分"
    },
    {
      "ordinal": 128,
      "start_ms": 299650,
      "end_ms": 301780,
      "text": "而我只有62~63分"
    },
    {
      "ordinal": 129,
      "start_ms": 301780,
      "end_ms": 303620,
      "text": "我心如死灰的时候"
    },
    {
      "ordinal": 130,
      "start_ms": 303620,
      "end_ms": 304880,
      "text": "他写了一个私会啊"
    },
    {
      "ordinal": 131,
      "start_ms": 304880,
      "end_ms": 306740,
      "text": "思想思在网上看你的视频"
    },
    {
      "ordinal": 132,
      "start_ms": 306740,
      "end_ms": 307460,
      "text": "同时受了影响"
    },
    {
      "ordinal": 133,
      "start_ms": 308600,
      "end_ms": 312650,
      "text": "读了宣言啊和雇佣劳动与资本"
    },
    {
      "ordinal": 134,
      "start_ms": 312650,
