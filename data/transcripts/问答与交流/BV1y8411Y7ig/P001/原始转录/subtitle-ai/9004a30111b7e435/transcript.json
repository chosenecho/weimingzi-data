    {
      "ordinal": 282,
      "start_ms": 715900,
      "end_ms": 716980,
      "text": "只会显得你一般嘛"
    },
    {
      "ordinal": 283,
      "start_ms": 716980,
      "end_ms": 719440,
      "text": "就是说正常人都有个学学位学历证"
