      "ordinal": 284,
      "start_ms": 719440,
      "end_ms": 720199,
      "text": "对不对"
    },
    {
      "ordinal": 285,
      "start_ms": 720560,
      "end_ms": 723350,
      "text": "就如果如果这条路走不通啊"
