    {
      "ordinal": 331,
      "start_ms": 836460,
      "end_ms": 841350,
      "text": "能够有所啊有所成就啊"
    },
    {
      "ordinal": 332,
      "start_ms": 841350,
      "end_ms": 844800,
      "text": "也对我们所有的行动者都有所启发"
    },
    {
      "ordinal": 333,
      "start_ms": 844800,
      "end_ms": 845820,
      "text": "好吧啊"
    },
    {
      "ordinal": 334,
      "start_ms": 845820,
      "end_ms": 846700,
      "text": "就讲到这里啊"
    }
