    {
      "ordinal": 270,
      "start_ms": 696460,
      "end_ms": 698800,
      "text": "是他重视你还是忽视你"
    },
    {
      "ordinal": 271,
      "start_ms": 698800,
      "end_ms": 701520,
      "text": "哪种会更影响你的你的实践"
    },
    {
      "ordinal": 272,
      "start_ms": 701740,
      "end_ms": 703120,
      "text": "爵爷你本人呀"
