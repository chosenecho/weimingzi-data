    {
      "ordinal": 302,
      "start_ms": 768800,
      "end_ms": 770719,
      "text": "或者说你这种反抗"
    },
    {
      "ordinal": 303,
      "start_ms": 772400,
      "end_ms": 773740,
      "text": "把它作为一个反抗"
