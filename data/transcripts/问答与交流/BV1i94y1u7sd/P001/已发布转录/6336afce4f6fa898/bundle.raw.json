{"segments":[{"start":0.84,"end":5.28,"text":"最后是一个小朋友的道歉信啊"},{"start":5.28,"end":8.14,"text":"他说未明子你好"},{"start":8.24,"end":12.969,"text":"感谢你在2021年12月4日直播时指责我"},{"start":12.969,"end":15.729,"text":"以及发了一个视频叫社会观察"},{"start":15.729,"end":19.149,"text":"帮助别人前要先确定对方是否需要"},{"start":19.149,"end":20.289,"text":"是否愿意接受"},{"start":20.289,"end":23.78,"text":"尤其是近乎万用无无用的一个帮助"},{"start":23.78,"end":26.48,"text":"当时我仍然是沉浸在幻想中的大三学生"},{"start":26.48,"end":27.98,"text":"甚至还想着去考研"},{"start":27.98,"end":28.82,"text":"钻学术圈"},{"start":28.82,"end":30.29,"text":"实际在逃避现实"},{"start":30.29,"end":33.11,"text":"不愿意面对实际上已知的困难和问题"},{"start":33.11,"end":36.7,"text":"你的斥责是贯穿我的幻想"},{"start":36.7,"end":38.74,"text":"让我鼓起勇气面对我"},{"start":38.74,"end":40.53,"text":"mother呃"},{"start":40.53,"end":41.19,"text":"绝症啊"},{"start":41.19,"end":42.09,"text":"某种绝症啊"},{"start":42.09,"end":44.52,"text":"面对我所逃避的工作的第一枪"},{"start":44.52,"end":46.68,"text":"承认我的技能理论水平很差"},{"start":46.68,"end":49.26,"text":"也有很多后悔应当适当的事情"},{"start":49.26,"end":52.839,"text":"但承担了我所应当为之负责的工作"},{"start":52.839,"end":57.22,"text":"使得那些日益正日益糟糕的事态有了好转"},{"start":57.22,"end":58.9,"text":"自从那个视频之后呢"},{"start":58.9,"end":59.86,"text":"他放弃了考研"},{"start":59.86,"end":63.989,"text":"现在在第三方检测公司当实验员"},{"start":64.748,"end":66.68,"text":"当然"},{"start":68.24,"end":71.38,"text":"什么上实际上不存在第三方"},{"start":72.58,"end":75.04,"text":"所有的实验数据都是资方控制的"},{"start":75.04,"end":79.22,"text":"这其中呃不存在保护劳动者工作环境的内容"},{"start":79.22,"end":80.6,"text":"若是当时去读研"},{"start":80.6,"end":81.92,"text":"那就真的很了"},{"start":83.45,"end":85.73,"text":"所以说提前去工作"},{"start":85.73,"end":87.789,"text":"知道这些狗屁猫腻"},{"start":88.189,"end":90.08,"text":"然后就知道哦"},{"start":90.08,"end":93.14,"text":"原来再花3年青春去考个研"},{"start":98.03,"end":100.55,"text":"回过头来看当时那个视频"},{"start":100.55,"end":103.1,"text":"是我下决心改变自己的开始"},{"start":103.1,"end":105.33,"text":"我现在在呃"},{"start":105.33,"end":108.68,"text":"也在我们的这个呃另外一个号里面"},{"start":108.68,"end":109.91,"text":"回答劳动者问题"},{"start":109.91,"end":111.02,"text":"参加俱乐部活动"},{"start":111.02,"end":112.22,"text":"就是工作很累"},{"start":112.22,"end":113.84,"text":"难得抽空来之后"},{"start":113.84,"end":114.68,"text":"调整工作后"},{"start":114.68,"end":117.79,"text":"应该能更多的参加这个俱乐部活动啊"},{"start":117.79,"end":120.44,"text":"向我向向你表示感谢"},{"start":120.44,"end":123.26,"text":"以及对当时我带有冒犯的废话"},{"start":123.26,"end":124.94,"text":"建议向你正式道歉"},{"start":124.94,"end":126.96,"text":"建议是虽然建议我也算听了啊"},{"start":126.96,"end":130.56,"text":"也是影响我整个大数据运算的一个头脑里面"},{"start":131.19,"end":134.49,"text":"我头脑里面有个显卡进行大数据运算啊"},{"start":134.49,"end":136.83,"text":"你这些建议应该也是能够影响这里面"},{"start":136.83,"end":139.66,"text":"一些向量变化的啊"},{"start":139.66,"end":140.68,"text":"这可能有些迟到了"},{"start":140.68,"end":144.5,"text":"这个建议套件有些迟到的信件可公开"},{"start":145.02,"end":146.94,"text":"有他他做了这个"},{"start":146.94,"end":148.98,"text":"他直接去上手"},{"start":148.98,"end":149.82,"text":"干了这个活"},{"start":149.82,"end":153.3,"text":"发现卧槽这个所谓的第三方检测啊"},{"start":153.3,"end":158.14,"text":"检测检测机构检测这东西全是资方操控的"},{"start":158.14,"end":158.8,"text":"造假的"},{"start":158.8,"end":160.24,"text":"其实他那个劳动环境啊"},{"start":160.24,"end":163.36,"text":"或者说他一些这个生产流程里面的"},{"start":163.36,"end":165.52,"text":"这个一些有害有毒物质"},{"start":165.52,"end":166.6,"text":"都他妈超标了呀"},{"start":166.6,"end":170.22,"text":"你以为啊"},{"start":175.22,"end":179.78,"text":"不好说不好说呀"},{"start":181.72,"end":183.1,"text":"怎么说呢"},{"start":183.1,"end":186.31,"text":"我又不能说叫你们不要赌烟"},{"start":186.31,"end":190.67,"text":"但是我的建议就是说非要去读研"},{"start":190.67,"end":194.75,"text":"先去实习几个月再来做做评估"},{"start":194.75,"end":197.9,"text":"你要考那个研的那个工作"},{"start":197.9,"end":200.03,"text":"先去实习去试一试"},{"start":200.03,"end":203.6,"text":"你就会发现读了研和没读研的"},{"start":203.6,"end":206.68,"text":"其实工作内容实际上是80%"},{"start":206.68,"end":207.85,"text":"90%是一样的"},{"start":207.85,"end":210.58,"text":"只不过说读了研的稍微有一点点上升的"},{"start":210.58,"end":213.32,"text":"一点点小的筹码稍微"},{"start":213.32,"end":215.51,"text":"但是相比之下还有一个问题"},{"start":215.51,"end":218.03,"text":"你去读研你就少工作3年"},{"start":218.03,"end":219.05,"text":"少工作3年"},{"start":219.05,"end":221.97,"text":"你在这个行业的资历就比别人少3年"},{"start":221.97,"end":224.49,"text":"而且你比别人同样进去了之后"},{"start":224.49,"end":226.53,"text":"你比比别人老3年"},{"start":226.53,"end":229.02,"text":"这个其实是你的这个就业的劣势"},{"start":229.02,"end":230.1,"text":"除非读研"},{"start":230.1,"end":231.31,"text":"读上这个研"},{"start":231.31,"end":234.97,"text":"可以给你带来很大的这个工作的一个加权"},{"start":234.97,"end":238.65,"text":"或者说比比如说你不是法学专业的"},{"start":238.65,"end":240.51,"text":"你要读了法律的研究生"},{"start":240.51,"end":242.75,"text":"你才能去考法考"},{"start":243.39,"end":244.61,"text":"不是医学专业的"},{"start":244.61,"end":246.17,"text":"你也读了这个研究生"},{"start":246.17,"end":250.37,"text":"你才能去考这个什么职业职业资格证什么的"},{"start":250.37,"end":251.3,"text":"明白吗"},{"start":251.3,"end":254.5,"text":"他就是说如果有这种比较硬性规定的话"},{"start":254.5,"end":256.899,"text":"这个有研究生文凭"},{"start":256.899,"end":257.44,"text":"没有研究生"},{"start":257.44,"end":259.089,"text":"文明差异非常大"},{"start":259.089,"end":261.49,"text":"我觉得你是要努努力就业的"},{"start":261.49,"end":262.24,"text":"差距很大"},{"start":262.24,"end":265.03,"text":"但是如果说你通过实习工作"},{"start":265.03,"end":266.65,"text":"会发现这里面这个差距"},{"start":266.65,"end":269.25,"text":"纯粹就是一个提拔的时候"},{"start":269.25,"end":269.97,"text":"加薪的时候"},{"start":269.97,"end":271.35,"text":"或者说裁不裁员的时候"},{"start":271.35,"end":276.61,"text":"一个参考一个衡量的一点点小的指标的话啊"},{"start":276.61,"end":279.37,"text":"一点小的指标的话"},{"start":281.46,"end":284.0,"text":"有学术理想的毕竟是少部分人"},{"start":284.0,"end":290.08,"text":"而且有学术理想的就就不会说是我们的啊"},{"start":290.08,"end":292.21,"text":"对不太可能是我们的人"},{"start":292.21,"end":292.93,"text":"你知道吗"},{"start":298.37,"end":300.44,"text":"他认为搞学术理想理想"},{"start":300.44,"end":305.02,"text":"搞什么自信权威去追求这种东西"},{"start":306.01,"end":309.81,"text":"还好他反正现在这个事态就这么个事态啊"},{"start":309.81,"end":311.43,"text":"所以我总的一个建议"},{"start":311.43,"end":313.44,"text":"结合我上上封信"},{"start":313.44,"end":315.68,"text":"上上上封信讲的那个事情"},{"start":315.68,"end":318.2,"text":"总的一个建议就是说你如果要读研"},{"start":318.2,"end":322.58,"text":"先去尝试着去这方面工作做一做"},{"start":322.58,"end":325.04,"text":"然后观察工作环境里面"},{"start":325.04,"end":326.78,"text":"这个职场里面这个有研究生"},{"start":326.78,"end":328.82,"text":"没有研究这个待遇的差别"},{"start":328.82,"end":331.179,"text":"还有整个这个行业发展的一个"},{"start":331.179,"end":332.799,"text":"不要看行业的前景"},{"start":332.799,"end":334.779,"text":"要看里面的人的前景啊"},{"start":334.779,"end":337.28,"text":"这些这些求职这这里面的学生"},{"start":337.28,"end":339.11,"text":"他几年可以薪资加倍啊"},{"start":339.11,"end":340.25,"text":"几年可以怎么样的"},{"start":340.25,"end":343.71,"text":"你要用那几个月的时间实习的时间"},{"start":343.71,"end":347.61,"text":"要混到和其中的一些正式的员工关系"},{"start":347.61,"end":349.59,"text":"好好的套出什么话"},{"start":349.59,"end":351.47,"text":"套出他什么时候涨薪的"},{"start":351.47,"end":353.9,"text":"他说他怎么样怎么样"},{"start":353.9,"end":355.7,"text":"凭什么涨薪的"},{"start":355.7,"end":357.8,"text":"你要套一些就是实质性的利益"},{"start":357.8,"end":361.4,"text":"要把这个利益关系给他摸出来啊"},{"start":361.4,"end":362.93,"text":"就是做这个事情"},{"start":362.93,"end":364.46,"text":"我就建议你们做这个事情"},{"start":364.46,"end":368.38,"text":"那么这个老哥他是去第三方去当实验员"},{"start":368.38,"end":369.16,"text":"一看这猫腻"},{"start":369.16,"end":370.0,"text":"什么都看看"},{"start":370.0,"end":371.58,"text":"看明白看清楚了"},{"start":371.58,"end":372.54,"text":"他就破灭了"},{"start":372.54,"end":373.05,"text":"你知道吗"},{"start":373.05,"end":375.0,"text":"破灭了他想我操老子去读研"},{"start":375.0,"end":376.44,"text":"都是学这叼毛玩意"},{"start":376.44,"end":378.25,"text":"最后啊"},{"start":378.25,"end":381.79,"text":"什么什么什么一些掌握更多的一些技巧方法"},{"start":381.79,"end":383.32,"text":"什么技术原理什么"},{"start":383.32,"end":385.36,"text":"原来最后最后原来这个东西"},{"start":385.36,"end":390.07,"text":"只是生产一个生产许可指标的"},{"start":390.07,"end":393.6,"text":"只是为一些违法行为"},{"start":393.6,"end":396.78,"text":"或者说不正当的一些现实做掩盖的"},{"start":396.78,"end":398.03,"text":"对不对"},{"start":398.03,"end":400.01,"text":"那就是看穿了自己存在的"},{"start":400.01,"end":401.789,"text":"存在的意义是什么呀"},{"start":401.789,"end":402.809,"text":"有一定作用"},{"start":402.809,"end":404.909,"text":"就是说相当于他那个不让他非常严重"},{"start":404.909,"end":406.289,"text":"不让它变成事态"},{"start":406.289,"end":407.069,"text":"很容易爆发"},{"start":407.069,"end":411.55,"text":"但是说这个事态本身就是不是特别正义的"},{"start":411.55,"end":413.789,"text":"不是特别美好的一个状态"},{"start":413.789,"end":415.949,"text":"用一些专业学术话语给他掩盖"},{"start":415.949,"end":417.389,"text":"掩盖那些什么指标啊"},{"start":417.389,"end":418.649,"text":"什么检测结果啊"},{"start":418.649,"end":419.909,"text":"什么报告啊"},{"start":419.909,"end":420.509,"text":"证书啊"},{"start":420.509,"end":422.729,"text":"给他掩盖掩盖"},{"start":425.6,"end":427.49,"text":"我曾说任重而道远"},{"start":427.49,"end":428.75,"text":"任重而道远"},{"start":428.75,"end":432.23,"text":"在大型什么什么国家工业国"},{"start":432.23,"end":433.49,"text":"在大型工业国家"},{"start":433.49,"end":437.08,"text":"这种东西很正常非常正常"},{"start":438.1,"end":439.33,"text":"这个人类都是"},{"start":439.33,"end":441.34,"text":"所以我觉得马前卒说的"},{"start":441.34,"end":444.86,"text":"这个什么草台班子是有问题的"},{"start":444.86,"end":446.18,"text":"他在我又重复了"},{"start":446.18,"end":449.76,"text":"他把2023年总结出一个草台来做总结"},{"start":449.76,"end":450.45,"text":"是错的"},{"start":450.45,"end":451.62,"text":"不是草台班子"},{"start":451.62,"end":453.99,"text":"也就不是里面的人是草台"},{"start":453.99,"end":458.44,"text":"是就是说是这个舞台"},{"start":458.44,"end":461.47,"text":"或者说这事就不是人是草台"},{"start":461.47,"end":464.76,"text":"而是运行的这些机制本身是草台草台"},{"start":464.76,"end":466.86,"text":"所以我就应该叫草台草台"},{"start":466.86,"end":468.15,"text":"而不是草台班子"},{"start":468.15,"end":469.02,"text":"草草台"},{"start":469.02,"end":470.14,"text":"你知道吗"},{"start":470.14,"end":472.42,"text":"我觉得大家应该更更应当理解的"},{"start":472.42,"end":474.02,"text":"就是说不是人的问题"},{"start":474.02,"end":475.4,"text":"不是里面的从业人"},{"start":475.4,"end":478.04,"text":"或者说相比于教育机制"},{"start":478.04,"end":480.86,"text":"教育出来的人不是特别合格"},{"start":480.86,"end":484.7,"text":"与其你评价说是教育系统生产出来的人不合格"},{"start":484.7,"end":486.539,"text":"你不如说"},{"start":487.419,"end":489.599,"text":"教育机器已经是这些机器里面"},{"start":489.599,"end":490.92,"text":"最像样的一个机器了"},{"start":490.92,"end":493.2,"text":"教育机器已经比后面的生产机器"},{"start":493.2,"end":494.34,"text":"管理机器相当"},{"start":494.34,"end":496.32,"text":"以及后面的这些监督机器什么"},{"start":496.32,"end":498.49,"text":"这些机器更像机器了"},{"start":498.49,"end":501.52,"text":"教育机器生产出来的人更像人了"},{"start":501.52,"end":502.9,"text":"教育机器生产出来的人"},{"start":502.9,"end":504.88,"text":"到这些其他后面更挫的机器里面"},{"start":504.88,"end":508.14,"text":"会突然忽然之间觉得卧槽这些垃圾机器"},{"start":508.14,"end":509.79,"text":"这样你能明白吗"},{"start":509.79,"end":512.03,"text":"这机器好挫"},{"start":512.309,"end":515.57,"text":"因为后面那些机器都是几十年利益关系"},{"start":515.57,"end":517.07,"text":"操爆了的"},{"start":517.07,"end":519.339,"text":"早就根据这个现实"},{"start":519.339,"end":520.899,"text":"而且是因为教育机器"},{"start":520.899,"end":522.999,"text":"它有的时候脱离现实的经济关联"},{"start":522.999,"end":524.619,"text":"脱离现实的人事权利"},{"start":524.619,"end":526.75,"text":"互相之间的一个倾轧呀"},{"start":526.75,"end":529.51,"text":"互相之间这个他利益冲突还没有那么狂野"},{"start":529.51,"end":531.22,"text":"他还是一个伊甸园"},{"start":531.22,"end":533.46,"text":"或者说不是不是还是个象牙塔"},{"start":533.46,"end":536.09,"text":"还处在一个可以微调"},{"start":536.09,"end":538.31,"text":"还可以比较自由浪漫的一个状态"},{"start":538.31,"end":540.02,"text":"比较理想化的一个状况"},{"start":540.02,"end":542.13,"text":"但是你现在的工业机器呀"},{"start":542.13,"end":546.06,"text":"还有包括下面就是什么这些啊"},{"start":546.06,"end":550.22,"text":"各个各个行业产业上面的这些利益条件"},{"start":550.22,"end":554.36,"text":"上面所架构的一些监督安全规范的这些机制啊"},{"start":554.36,"end":555.43,"text":"什么这些玩意"},{"start":555.43,"end":559.35,"text":"老实说5年一烂"},{"start":559.35,"end":560.07,"text":"5年一烂啊"},{"start":560.07,"end":561.51,"text":"我甚至说几年就会烂一下"},{"start":561.51,"end":562.91,"text":"几年就会烂一下"},{"start":562.91,"end":564.05,"text":"要不停的更新呢"},{"start":564.05,"end":568.05,"text":"其实说它很一定很容易堕落的啊"},{"start":568.05,"end":569.64,"text":"啊很容易堕落的"},{"start":569.64,"end":572.13,"text":"所以我觉得不要说形容人家是草台"},{"start":572.13,"end":573.54,"text":"这不是人的问题"},{"start":573.54,"end":574.89,"text":"这不再是人的问题"},{"start":574.89,"end":576.75,"text":"这是一个人和人人际关系"},{"start":576.75,"end":577.829,"text":"人际的那种"},{"start":577.829,"end":578.909,"text":"不仅是人际关系"},{"start":578.909,"end":579.989,"text":"也是阶级之间"},{"start":579.989,"end":581.099,"text":"利益集团之间"},{"start":581.099,"end":581.849,"text":"行业之间"},{"start":581.849,"end":583.919,"text":"产业之间啊"},{"start":583.919,"end":587.01,"text":"这个啊就是说呃生活方式"},{"start":587.01,"end":588.57,"text":"不同生活方式的人群之间"},{"start":588.57,"end":591.38,"text":"社群之间的它的利益关系"},{"start":591.38,"end":592.94,"text":"冲突斗争的模式"},{"start":592.94,"end":597.31,"text":"在深刻地反复蹂躏这些工业机器"},{"start":597.31,"end":597.85,"text":"生产机器"},{"start":597.85,"end":598.63,"text":"安全机器"},{"start":598.63,"end":599.41,"text":"建筑机器"},{"start":599.41,"end":601.08,"text":"行政管理机器"},{"start":601.62,"end":606.72,"text":"这些机器里面的物质部分是各种废弛的啊"},{"start":606.72,"end":608.55,"text":"各种怎么样的烂"},{"start":608.55,"end":609.54,"text":"这边烂一烂"},{"start":609.54,"end":611.12,"text":"那边秀一秀"},{"start":611.12,"end":614.28,"text":"这边什么什么懂吗"},{"start":614.56,"end":617.97,"text":"所以你非要说是你就说换一批人上去就好了吗"},{"start":617.97,"end":620.15,"text":"或者说让这些人都不是草台"},{"start":620.15,"end":622.94,"text":"都是什么正儿八经精英什么就好了吗"},{"start":622.94,"end":626.58,"text":"未见得不一定的啊"},{"start":626.58,"end":627.6,"text":"当时是什么"},{"start":627.6,"end":631.01,"text":"反正是举的一个什么例子是什么"},{"start":631.01,"end":634.25,"text":"要在这个首都开办一个什么东西把哦"},{"start":634.25,"end":636.44,"text":"或者北方哪个省份要搞一个什么东西"},{"start":636.44,"end":639.11,"text":"然后把这个深圳的哪个什么几千个"},{"start":639.11,"end":641.57,"text":"什么比较熟练的"},{"start":641.57,"end":647.45,"text":"比较比较这个这就比较比较成熟"},{"start":647.45,"end":654.26,"text":"能够能够承担这个任务的呃"},{"start":654.26,"end":658.46,"text":"一些官员几千个调过去嗯"},{"start":658.46,"end":661.25,"text":"然后呢是一下子就改观了"},{"start":661.25,"end":663.26,"text":"这个不是说换了人就改观的"},{"start":663.26,"end":667.43,"text":"而是说要让这些人精英要到位"},{"start":667.43,"end":669.11,"text":"另外一方面也要放权给他们"},{"start":669.11,"end":670.73,"text":"让他们去塑造那个制度"},{"start":670.73,"end":673.39,"text":"现实塑造人的制度框架和那里的"},{"start":673.39,"end":678.43,"text":"一个就是整个的治理机器治理架构要放权"},{"start":678.43,"end":682.69,"text":"要让他们敢敢于去建构自己的一个这个体系"},{"start":682.69,"end":684.91,"text":"哪怕就是在局部的建构这个体系"},{"start":684.91,"end":689.78,"text":"然后在聪明的上风说上峰是一个什么"},{"start":689.78,"end":691.88,"text":"是一个什么反贼口号"},{"start":691.88,"end":692.42,"text":"不是的"},{"start":692.42,"end":693.86,"text":"我我喜欢说上风"},{"start":693.86,"end":695.78,"text":"因为我年轻的时候看过很多"},{"start":695.78,"end":698.9,"text":"这个是那个那个小说啊"},{"start":698.9,"end":700.46,"text":"很多那个穿越小说"},{"start":700.46,"end":703.19,"text":"穿越小说里面都把那个上级叫上风了"},{"start":703.19,"end":708.16,"text":"他这个封建封建官僚层级制里面的"},{"start":708.16,"end":709.48,"text":"那我也讲的"},{"start":709.48,"end":712.66,"text":"就是说啊稍微还算有点头脑的"},{"start":712.66,"end":714.97,"text":"上级会把这些比较好的"},{"start":714.97,"end":716.33,"text":"比较有闯劲"},{"start":716.33,"end":719.51,"text":"比较有有这个现实的判断啊"},{"start":719.51,"end":722.69,"text":"决决断能力的这些年轻人建构出来的新的制度"},{"start":722.69,"end":723.95,"text":"现实放大调整"},{"start":723.95,"end":727.089,"text":"然后再运用到其他的其他的范围"},{"start":727.089,"end":728.169,"text":"其他领域当中"},{"start":728.169,"end":733.209,"text":"能够让整个行政机器治理体系有一个质的改观"},{"start":733.209,"end":735.295,"text":"质"},{"start":736.58,"end":739.96,"text":"所以我这个这个就说了嘛"},{"start":739.96,"end":747.41,"text":"我觉得嗯这种东西你也不好埋怨"},{"start":747.41,"end":749.33,"text":"教育是不是你也不好埋怨"},{"start":749.33,"end":751.709,"text":"具体的个人不是特别好埋怨"},{"start":751.709,"end":753.329,"text":"具体的个人没什么好埋怨的"},{"start":753.329,"end":756.37,"text":"而且要看到他是一个力格局"},{"start":756.37,"end":759.79,"text":"力量对比是不是很强硬的"},{"start":759.79,"end":761.74,"text":"非常强硬的嗯"},{"start":761.74,"end":762.67,"text":"一动全动"},{"start":762.67,"end":764.29,"text":"牵一发动全身"},{"start":764.29,"end":768.61,"text":"一改全改这种一权关系"},{"start":768.61,"end":770.71,"text":"如果最后将此固化到一定程度的话"},{"start":770.71,"end":771.73,"text":"那就没办法了"},{"start":771.73,"end":775.55,"text":"只能说老八一揭就全揭掉了"},{"start":775.55,"end":778.01,"text":"因为下面的新肉已经长好了嘛"},{"start":778.01,"end":779.0,"text":"对不对"},{"start":779.0,"end":781.34,"text":"你想要见到翻天覆地的变化"},{"start":781.34,"end":784.22,"text":"可以下面的新的肉已经快长得差不多了"},{"start":784.22,"end":785.18,"text":"或者说下面的新肉"},{"start":785.18,"end":785.96,"text":"你把它揭开了"},{"