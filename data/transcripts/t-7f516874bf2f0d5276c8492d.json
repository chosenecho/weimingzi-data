      "end": 371730,
      "index": 150
    },
    {
      "text": "20个刀",
      "start": 373880,
      "end": 377840,
      "index": 151
    },
    {
      "text": "卖到美国去",
      "start": 380800,
      "end": 382710,
      "index": 152
    },
    {
