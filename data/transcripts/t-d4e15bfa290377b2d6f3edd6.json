      "end": 652840
    },
    {
      "ordinal": 222,
      "text": "唯物主义",
      "start": 652840,
      "end": 654040
    },
    {
      "ordinal": 223,
      "text": "唯物主义的这个挪用",
      "start": 654480,
      "end": 657270
    },
    {
      "ordinal": 224,
      "text": "唯物主义的错误挪用",
      "start": 657270,
      "end": 659400
    },
    {
      "ordinal": 225,
      "text": "再挪用到的历史学范畴里面去",
