      "end": 624040
    },
    {
      "ordinal": 212,
      "text": "社会背景",
      "start": 624040,
      "end": 624730
    },
    {
      "ordinal": 213,
      "text": "年轻人没有他受过的教育",
      "start": 624730,
      "end": 626380
    },
    {
      "ordinal": 214,
      "text": "没有他呃经受的这个文化影响的干干净净",
