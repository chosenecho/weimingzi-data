{"segments":[{"start":0.16,"end":3.14,"text":"我们今天要把这首凤歌给他唱了啊"},{"start":3.14,"end":5.96,"text":"这里的这个衰字念催啊"},{"start":5.96,"end":8.02,"text":"意思就是"},{"start":8.82,"end":13.93,"text":"按照一定的等级递减掉下来啊"},{"start":13.93,"end":18.05,"text":"就得其实应该何如得之崔啊"},{"start":19.17,"end":24.05,"text":"就是你能拿世间道德"},{"start":24.05,"end":26.81,"text":"就是德行的降低"},{"start":27.17,"end":28.73,"text":"拿他怎么办啊"},{"start":28.73,"end":30.01,"text":"所以这个念催啊"},{"start":30.01,"end":33.49,"text":"就是一个等等地的降低啊"},{"start":37.96,"end":40.16,"text":"风起"},{"start":44.52,"end":47.72,"text":"喝得直摧"},{"start":53.34,"end":55.78,"text":"风起"},{"start":59.7,"end":63.1,"text":"哈得志翠"},{"start":68.74,"end":70.9,"text":"风起"},{"start":75.06,"end":78.54,"text":"♪ 喝得至摧 ♪"},{"start":83.7,"end":86.18,"text":"♪ 风信 ♪"},{"start":90.26,"end":93.7,"text":"阿得至翠"},{"start":107.64,"end":111.67,"text":"♪ 来者不带追 ♪"},{"start":111.67,"end":118.16,"text":"♪ 来者良德倏忽可见 ♪"},{"start":121.36,"end":124.64,"text":"♪ 蛇身而去 ♪"},{"start":124.64,"end":126.62,"text":"一者也"},{"start":128.259,"end":132.71,"text":"♪ 望者不可见 ♪"},{"start":134.44,"end":136.12,"text":"♪ 天下有道 ♪"},{"start":138.04,"end":140.4,"text":"♪ 圣人沉言 ♪"},{"start":141.29,"end":142.97,"text":"♪ 涉世无道 ♪"},{"start":144.53,"end":147.33,"text":"♪ 苟且神严 ♪"},{"start":152.06,"end":163.62,"text":"♪ 我之所抚琴胡语载而不可取 ♪"},{"start":165.8,"end":170.8,"text":"♪ 福之所以众苦 ♪"},{"start":170.8,"end":177.39,"text":"♪ 地莫知之所必 ♪"},{"start":179.1,"end":180.78,"text":"♪ 天下无道 ♪"},{"start":182.74,"end":187.57,"text":"♪ 圣人神厌方今之事 ♪"},{"start":189.17,"end":191.93,"text":"♪ 今年新颜 ♪"},{"start":193.38,"end":194.38,"text":"♪ 一而 ♪"},{"start":196.46,"end":198.86,"text":"♪ 令人意得 ♪"},{"start":200.24,"end":201.2,"text":"♪ 一而 ♪"},{"start":203.32,"end":205.8,"text":"令人易得"},{"start":207.06,"end":208.1,"text":"带护"},{"start":210.22,"end":212.66,"text":"♪ 划地而去 ♪"},{"start":213.9,"end":215.9,"text":"♪ 黛乎 ♪"},{"start":216.89,"end":219.53,"text":"划地而去"},{"start":272.36,"end":273.4,"text":"♪ 绵阳 ♪"},{"start":275.48,"end":277.96,"text":"♪ 无声无形 ♪"},{"start":279.22,"end":280.22,"text":"♪ 绵阳 ♪"},{"start":282.34,"end":284.78,"text":"五行西去"},{"start":286.02,"end":286.98,"text":"♪ 谜谣 ♪"},{"start":289.3,"end":291.7,"text":"♪ 无声无形 ♪"},{"start":292.94,"end":293.9,"text":"♪ 谜样 ♪"},{"start":296.06,"end":297.72,"text":"♪ 无商无阻 ♪"}],"source":"subtitle"}
