      "text": "我写了一首词啊"
    },
    {
      "ordinal": 1,
      "start_ms": 2880,
      "end_ms": 6830,
      "text": "填了一首词是呃以前写的一部分"
    },
    {
      "ordinal": 2,
      "start_ms": 6830,
      "end_ms": 8890,
      "text": "但是魔改了大改了"
    },
    {
      "ordinal": 3,
      "start_ms": 8890,
      "end_ms": 12200,
      "text": "然后用鱼符给他补足啊"
    },
    {
      "ordinal": 4,
      "start_ms": 41740,
      "end_ms": 45160,
      "text": "银河所依虽晚"
    },
    {
      "ordinal": 5,
      "start_ms": 45160,
      "end_ms": 48000,
      "text": "♪ 云芳龙吟 ♪"
    },
    {
      "ordinal": 6,
      "start_ms": 48720,
      "end_ms": 51680,
      "text": "余韵若惊惊"
    },
    {
      "ordinal": 7,
      "start_ms": 51680,
      "end_ms": 54810,
      "text": "几乎无人心"
    },
    {
      "ordinal": 8,
      "start_ms": 55450,
      "end_ms": 57870,
      "text": "天缘有飞"
    },
    {
      "ordinal": 9,
      "start_ms": 57870,
      "end_ms": 59530,
      "text": "家似海"
    },
    {
      "ordinal": 10,
      "start_ms": 59530,
      "end_ms": 63100,
      "text": "覆万顷光"
    },
    {
      "ordinal": 11,
      "start_ms": 63100,
      "end_ms": 64680,
      "text": "冷如霜"
    },
    {
      "ordinal": 12,
      "start_ms": 64680,
      "end_ms": 66400,
      "text": "吻如妆"
    },
    {
      "ordinal": 13,
      "start_ms": 66400,
      "end_ms": 68640,
      "text": "面如凝"
    },
    {
      "ordinal": 14,
      "start_ms": 70860,
      "end_ms": 73419,
      "text": "♪ 心无影 ♪"
    },
    {
      "ordinal": 15,
      "start_ms": 73899,
      "end_ms": 74899,
      "text": "♪ 一无情 ♪"
    },
    {
      "ordinal": 16,
      "start_ms": 74899,
      "end_ms": 76219,
      "text": "♪ 欲寄苍冥 ♪"
    },
    {
      "ordinal": 17,
      "start_ms": 77539,
      "end_ms": 81920,
      "text": "♪ 无天无欲无非偶 ♪"
    },
    {
      "ordinal": 18,
      "start_ms": 81920,
      "end_ms": 83080,
      "text": "无可惊"
    },
    {
      "ordinal": 19,
      "start_ms": 84640,
      "end_ms": 87160,
      "text": "♪ 心无情 ♪"
    },
    {
      "ordinal": 20,
      "start_ms": 87560,
      "end_ms": 89000,
      "text": "以为风月"
    },
    {
      "ordinal": 21,
      "start_ms": 89000,
      "end_ms": 91980,
      "text": "花鸟啄凌波"
    },
    {
      "ordinal": 22,
      "start_ms": 91980,
      "end_ms": 93600,
      "text": "♪ 不可脱 ♪"
    },
    {
      "ordinal": 23,
      "start_ms": 93600,
      "end_ms": 94340,
      "text": "♪ 秋 ♪"
    },
    {
      "ordinal": 24,
      "start_ms": 94340,
      "end_ms": 99450,
      "text": "♪ 索索珠落谁最多 ♪"
    },
    {
      "ordinal": 25,
      "start_ms": 101700,
      "end_ms": 107729,
      "text": "水浊兮沧浪可以捉足"
    },
    {
      "ordinal": 26,
      "start_ms": 108209,
      "end_ms": 109909,
      "text": "莞尔莫索"
    },
    {
      "ordinal": 27,
      "start_ms": 109909,
      "end_ms": 113409,
      "text": "♪ 鼓已而去 ♪"
    },
    {
      "ordinal": 28,
      "start_ms": 115560,
      "end_ms": 117600,
      "text": "♪ 水若清 ♪"
    },
    {
      "ordinal": 29,
      "start_ms": 118720,
      "end_ms": 121620,
      "text": "♪ 沧浪可以捉无影 ♪"
    },
    {
      "ordinal": 30,
      "start_ms": 121940,
      "end_ms": 123620,
      "text": "♪ 世人皆醉 ♪"
    },
    {
      "ordinal": 31,
      "start_ms": 123620,
      "end_ms": 128590,
      "text": "♪ 岂可一人独行 ♪"
    },
    {
      "ordinal": 32,
      "start_ms": 156840,
      "end_ms": 160000,
      "text": "银河所依虽晚"
    },
    {
      "ordinal": 33,
      "start_ms": 160000,
      "end_ms": 162920,
      "text": "云方弄吟"
    },
    {
      "ordinal": 34,
      "start_ms": 163570,
      "end_ms": 165810,
      "text": "♪ 雨云若惊 ♪"
    },
    {
      "ordinal": 35,
      "start_ms": 165810,
      "end_ms": 169720,
      "text": "惊棘浮无人心"
    },
    {
      "ordinal": 36,
      "start_ms": 170360,
      "end_ms": 172680,
      "text": "田园又飞"
    },
    {
      "ordinal": 37,
      "start_ms": 172680,
      "end_ms": 177970,
      "text": "加四海抚万顷光"
    },
    {
      "ordinal": 38,
      "start_ms": 177970,
      "end_ms": 179530,
      "text": "♪ 冷如霜 ♪"
    },
    {
      "ordinal": 39,
      "start_ms": 179530,
      "end_ms": 181230,
      "text": "温如妆"
    },
    {
      "ordinal": 40,
      "start_ms": 181230,
      "end_ms": 183490,
      "text": "♪ 面如凝 ♪"
    },
    {
      "ordinal": 41,
      "start_ms": 185380,
      "end_ms": 189740,
      "text": "唯心无影亦无晴"
    },
    {
      "ordinal": 42,
      "start_ms": 189740,
      "end_ms": 192020,
      "text": "雨祭苍冥"
    },
    {
      "ordinal": 43,
      "start_ms": 192249,
      "end_ms": 198889,
      "text": "无天无欲无飞后不可亲"
    },
    {
      "ordinal": 44,
      "start_ms": 199590,
      "end_ms": 201390,
      "text": "♪ 心无情 ♪"
    },
    {
      "ordinal": 45,
      "start_ms": 202470,
      "end_ms": 203890,
      "text": "以为风月"
    },
    {
      "ordinal": 46,
