    {
      "ordinal": 54,
      "start_ms": 233460,
      "end_ms": 236300,
      "text": "♪ 沧浪可以捉无影 ♪"
    },
    {
      "ordinal": 55,
      "start_ms": 236740,
      "end_ms": 238460,
      "text": "♪ 禾木鸿飞 ♪"
