      "ordinal": 68,
      "start_ms": 292820,
      "end_ms": 295800,
      "text": "本来这里的是个是星星的星"
    },
    {
      "ordinal": 69,
      "start_ms": 295800,
      "end_ms": 298340,
      "text": "后来改成了这个内心的星啊"
    },
    {
      "ordinal": 70,
      "start_ms": 298340,
      "end_ms": 300020,
      "text": "因为外物太多了"
