  "segments": [
    {
      "ordinal": 0,
      "start_ms": 29020,
      "end_ms": 34860,
      "text": "成人梦几番起伏总不行"
    },
    {
      "ordinal": 1,
      "start_ms": 35940,
      "end_ms": 39800,
      "text": "到如今当成烟云"
    },
    {
      "ordinal": 2,
      "start_ms": 42820,
      "end_ms": 44790,
      "text": "也成空"
    },
    {
      "ordinal": 3,
      "start_ms": 44790,
      "end_ms": 47779,
      "text": "宛如回首秀的风"
    },
    {
      "ordinal": 4,
      "start_ms": 48840,
      "end_ms": 50780,
      "text": "悠悠一缕香"
    },
    {
      "ordinal": 5,
      "start_ms": 51920,
      "end_ms": 54540,
      "text": "飘在深深旧梦中"
    },
    {
      "ordinal": 6,
      "start_ms": 55500,
      "end_ms": 57440,
      "text": "繁华落尽"
    },
    {
      "ordinal": 7,
      "start_ms": 58580,
      "end_ms": 59750,
      "text": "一生憔悴"
    },
    {
      "ordinal": 8,
      "start_ms": 59750,
      "end_ms": 61820,
      "text": "在风里"
    },
    {
      "ordinal": 9,
      "start_ms": 62560,
      "end_ms": 65860,
      "text": "回头时无晴也无雨"
    },
    {
      "ordinal": 10,
      "start_ms": 68760,
      "end_ms": 72980,
      "text": "明月小楼不住人"
    },
    {
      "ordinal": 11,
      "start_ms": 72980,
      "end_ms": 74380,
      "text": "宿群中"
    },
    {
      "ordinal": 12,
      "start_ms": 75800,
      "end_ms": 77530,
      "text": "人间有我"
    },
    {
      "ordinal": 13,
      "start_ms": 77530,
      "end_ms": 79679,
      "text": "残梦未醒"
    },
    {
      "ordinal": 14,
      "start_ms": 85360,
      "end_ms": 89180,
      "text": "漫漫长路起伏"
    },
    {
      "ordinal": 15,
      "start_ms": 89180,
      "end_ms": 94580,
      "text": "不能由我人海漂泊"
    },
    {
      "ordinal": 16,
      "start_ms": 94800,
      "end_ms": 99930,
      "text": "尝尽人情淡漠热情"
    },
    {
      "ordinal": 17,
      "start_ms": 99930,
      "end_ms": 104320,
      "text": "热心换冷淡冷漠"
    },
    {
      "ordinal": 18,
      "start_ms": 104860,
      "end_ms": 107400,
      "text": "人多少深情"
    },
    {
      "ordinal": 19,
      "start_ms": 107400,
      "end_ms": 109380,
      "text": "独向寂寞"
    },
    {
      "ordinal": 20,
      "start_ms": 111300,
      "end_ms": 115520,
      "text": "爱春风波自在"
    },
    {
      "ordinal": 21,
      "start_ms": 115520,
      "end_ms": 117580,
      "text": "花开花又落"
    },
    {
      "ordinal": 22,
      "start_ms": 118960,
      "end_ms": 122619,
      "text": "不管世间沧桑如何"
    },
    {
      "ordinal": 23,
      "start_ms": 125220,
      "end_ms": 130880,
      "text": "一城风絮满腹相思都沉默"
    },
    {
      "ordinal": 24,
      "start_ms": 132339,
      "end_ms": 135960,
      "text": "只有桂花香暗飘过"
    },
    {
      "ordinal": 25,
      "start_ms": 165459,
      "end_ms": 169600,
      "text": "不管世间沧桑如何"
    },
    {
      "ordinal": 26,
      "start_ms": 172839,
      "end_ms": 174980,
      "text": "有桂花香看"
    },
    {
      "ordinal": 27,
      "start_ms": 178679,
      "end_ms": 179620,
      "text": "啊啊啊"
    },
    {
      "ordinal": 28,
      "start_ms": 188240,
      "end_ms": 192100,
      "text": "漫漫长路起伏"
    },
    {
      "ordinal": 29,
      "start_ms": 192100,
      "end_ms": 196899,
      "text": "不能由我人海漂泊"
    },
    {
      "ordinal": 30,
      "start_ms": 197979,
      "end_ms": 202929,
      "text": "尝尽人情淡薄热情"
    },
    {
      "ordinal": 31,
      "start_ms": 202929,
      "end_ms": 207240,
      "text": "热心换冷淡冷漠"
    },
    {
      "ordinal": 32,
      "start_ms": 207619,
      "end_ms": 210289,
      "text": "人多少深情"
    },
    {
      "ordinal": 33,
      "start_ms": 210289,
      "end_ms": 212180,
      "text": "独向寂寞"
    },
    {
      "ordinal": 34,
      "start_ms": 214180,
      "end_ms": 218460,
      "text": "那一起风波自在"
    },
    {
      "ordinal": 35,
      "start_ms": 218460,
      "end_ms": 220460,
      "text": "花开花又落"
    },
    {
      "ordinal": 36,
      "start_ms": 221920,
      "end_ms": 224520,
      "text": "呼唤世间沧桑"
    },
    {
      "ordinal": 37,
      "start_ms": 224520,
      "end_ms": 225900,
      "text": "如何"
    },
    {
      "ordinal": 38,
      "start_ms": 228140,
      "end_ms": 233820,
      "text": "离尘风雪慢慢不相思都沉默"
    },
    {
      "ordinal": 39,
      "start_ms": 235200,
      "end_ms": 238840,
      "text": "只有桂花香太飘过"
    },
    {
      "ordinal": 40,
      "start_ms": 241839,
      "end_ms": 246040,
      "text": "只有桂花香啊"
    },
    {
      "ordinal": 41,
      "start_ms": 247240,
      "end_ms": 248660,
      "text": "飘过"
    }
  ],
  "text": "成人梦几番起伏总不行\n到如今当成烟云\n也成空\n宛如回首秀的风\n悠悠一缕香\n飘在深深旧梦中\n繁华落尽\n一生憔悴\n在风里\n回头时无晴也无雨\n明月小楼不住人\n宿群中\n人间有我\n残梦未醒\n漫漫长路起伏\n不能由我人海漂泊\n尝尽人情淡漠热情\n热心换冷淡冷漠\n人多少深情\n独向寂寞\n爱春风波自在\n花开花又落\n不管世间沧桑如何\n一城风絮满腹相思都沉默\n只有桂花香暗飘过\n不管世间沧桑如何\n有桂花香看\n啊啊啊\n漫漫长路起伏\n不能由我人海漂泊\n尝尽人情淡薄热情\n热心换冷淡冷漠\n人多少深情\n独向寂寞\n那一起风波自在\n花开花又落\n呼唤世间沧桑\n如何\n离尘风雪慢慢不相思都沉默\n只有桂花香太飘过\n只有桂花香啊\n飘过",
