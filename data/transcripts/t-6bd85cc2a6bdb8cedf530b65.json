    {
      "ordinal": 354,
      "text": "要形成他的观念理念",
      "start": 894460,
      "end": 898540
    },
    {
      "ordinal": 355,
      "text": "整个合法性的体系",
      "start": 898540,
      "end": 900479
    },
    {
      "ordinal": 356,
      "text": "你们误解我的人",
      "start": 905500,
      "end": 908640
    },
    {
      "ordinal": 357,
      "text": "我觉得是这个世界的一些悲惨面",
      "start": 908640,
      "end": 913720
    },
    {
      "ordinal": 358,
      "text": "感到让人感到悲惨",
      "start": 913720,
      "end": 915850
    },
    {
      "ordinal": 359,
      "text": "感到无福利的一面啊",
      "start": 915850,
      "end": 917800
    },
    {
      "ordinal": 360,
      "text": "那就讲到这里了",
      "start": 917800,
      "end": 918640
    }
