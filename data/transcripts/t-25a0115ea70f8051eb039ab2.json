      "end": 435880
    },
    {
      "ordinal": 195,
      "text": "你了解吗",
      "start": 435880,
      "end": 436600
    },
    {
      "ordinal": 196,
      "text": "你的学习能力",
      "start": 436600,
      "end": 437900
    },
    {
      "ordinal": 197,
      "text": "你的学习能力强弱",
      "start": 438280,
      "end": 439960
    },
    {
      "ordinal": 198,
      "text": "取决于你用的这个浏览器能够让你他不要很卡",
      "start": 439960,
      "end": 444090
    },
    {
      "ordinal": 199,
      "text": "如果他很卡",
      "start": 444090,
      "end": 444900
    },
    {
      "ordinal": 200,
      "text": "浏览的很慢",
      "start": 444900,
      "end": 445800
    },
    {
      "ordinal": 201,
      "text": "网速又慢",
      "start": 445800,
      "end": 446460
    },
    {
      "ordinal": 202,
      "text": "还偷跑流量",
