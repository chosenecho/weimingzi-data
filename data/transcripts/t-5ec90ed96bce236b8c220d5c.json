      "text": "就在于他不够诡异",
      "start": 663060,
      "end": 664440
    },
    {
      "ordinal": 222,
      "text": "他太简单了",
      "start": 664440,
      "end": 666000
    },
    {
      "ordinal": 223,
      "text": "就是他他诡异就诡异在他妈的太太太低幼了",
      "start": 666000,
      "end": 669780
    },
    {
      "ordinal": 224,
      "text": "这个太低幼了",
      "start": 669780,
      "end": 671640
    },
    {
      "ordinal": 225,
      "text": "太明牌了",
      "start": 671640,
      "end": 672960
    },
    {
      "ordinal": 226,
      "text": "太低幼了",
      "start": 672960,
      "end": 673860
    },
    {
      "ordinal": 227,
      "text": "太愚蠢了",
      "start": 673860,
      "end": 674700
    },
    {
      "ordinal": 228,
      "text": "你知道吗",
      "start": 674700,
      "end": 675300
    },
    {
      "ordinal": 229,
      "text": "太愚蠢了",
      "start": 675300,
      "end": 676630
    },
    {
      "ordinal": 230,
      "text": "就是他的诡异",
