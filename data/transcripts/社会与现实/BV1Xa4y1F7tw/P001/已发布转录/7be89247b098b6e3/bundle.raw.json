{"segments":[{"start":1.62,"end":2.94,"text":"姓名啊"},{"start":2.94,"end":4.18,"text":"刘思墨"},{"start":7.63,"end":10.33,"text":"江苏省苏州市吴中区"},{"start":10.33,"end":12.42,"text":"是我的居住地"},{"start":12.639,"end":15.729,"text":"我这个名字呢比较显啊"},{"start":15.729,"end":16.419,"text":"显见"},{"start":16.419,"end":19.73,"text":"那你就是说都可以找到我啊"},{"start":19.73,"end":21.56,"text":"这些信息足够让你找到我了"},{"start":23.18,"end":28.1,"text":"那我就说我作为一个受制国家公民"},{"start":28.4,"end":32.96,"text":"我们有其他的任何的这个什么利益上的一个"},{"start":32.96,"end":34.79,"text":"私立的一个追求"},{"start":34.79,"end":38.779,"text":"我只是说出于维护呃一些"},{"start":38.9,"end":42.56,"text":"我觉得我们这个民族共同体啊"},{"start":42.56,"end":44.18,"text":"而且我们是多民族共同体"},{"start":50.85,"end":55.69,"text":"啊那我想邀请一位人士"},{"start":55.69,"end":59.23,"text":"这位人士呢我不知道他具体的姓名"},{"start":59.23,"end":64.15,"text":"但是他有一个这个账号啊"},{"start":64.15,"end":67.0,"text":"B站的账号叫历史调研室"},{"start":67.24,"end":73.26,"text":"我邀请他的这个主笔的创作者和我本人"},{"start":73.26,"end":75.54,"text":"或者说不需要和我本人啊"},{"start":75.54,"end":77.82,"text":"他只要以他个人的身份"},{"start":77.82,"end":83.6,"text":"以其以承担其言论的全部现实"},{"start":83.6,"end":88.679,"text":"这个代价的这么一个啊个人身份"},{"start":89.12,"end":91.1,"text":"只要回答以下几个问题"},{"start":91.1,"end":95.1,"text":"或者就以下几个问题呢谈一谈做一个表态"},{"start":96.84,"end":98.86,"text":"那么第一个问题就是说"},{"start":101.0,"end":102.76,"text":"他是否认为"},{"start":105.34,"end":110.22,"text":"可以成为一个民族国家的整体民意的表达机制"},{"start":117.7,"end":119.46,"text":"合法的表达机制"},{"start":119.46,"end":121.7,"text":"唯一合法的表达机制"},{"start":131.459,"end":132.9,"text":"这第一个问题"},{"start":133.019,"end":134.789,"text":"那么我的立场"},{"start":134.789,"end":138.269,"text":"对此我的立场我是不同意的"},{"start":142.059,"end":142.919,"text":"为什么呢"},{"start":142.919,"end":145.019,"text":"因为对于底层"},{"start":146.099,"end":148.619,"text":"尤其是生活啊"},{"start":148.619,"end":149.699,"text":"生活在资本主义社会"},{"start":149.699,"end":151.199,"text":"被资本主义啊"},{"start":151.199,"end":153.329,"text":"被资本产业压迫的平民"},{"start":153.329,"end":155.129,"text":"甚至说压迫到一个"},{"start":155.129,"end":159.35,"text":"不得不迸发否定性的无产阶级"},{"start":159.35,"end":162.41,"text":"马克思主义原教旨义上的马克思的无产阶级"},{"start":162.41,"end":163.74,"text":"无产阶级而言"},{"start":164.679,"end":168.719,"text":"首先即便他们不被各式各样的形式剥夺"},{"start":172.279,"end":173.019,"text":"对于"},{"start":176.439,"end":180.54,"text":"啊对于涉及他们根本利益的"},{"start":180.54,"end":184.53,"text":"并且始终让他们处在贫困"},{"start":184.53,"end":191.63,"text":"饥饿和流离失所的最悲惨的生存底线上的"},{"start":191.63,"end":195.609,"text":"所有的绝大部分的社会事物的表决权"},{"start":195.609,"end":196.659,"text":"他们只有一票"},{"start":196.659,"end":201.02,"text":"这是非常非常不正义的"},{"start":201.679,"end":204.639,"text":"因为他是这些事物啊"},{"start":204.639,"end":205.749,"text":"对他们的损害"},{"start":205.749,"end":209.38,"text":"或者说对他们的这个这个生存的状况的"},{"start":209.38,"end":211.0,"text":"影响是最重大的"},{"start":211.0,"end":213.98,"text":"并且他们对于整个社会存去"},{"start":214.079,"end":215.999,"text":"付出的代价是最大的"},{"start":215.999,"end":219.779,"text":"事实上整个社会都是由劳动劳动阶级啊"},{"start":219.779,"end":223.28,"text":"劳动阶级的奉献所维系的"},{"start":223.92,"end":227.15,"text":"所以他们在对于这些社会事物的表达上面"},{"start":227.15,"end":229.64,"text":"不应当用一人一票的资产阶级"},{"start":229.64,"end":233.86,"text":"抽象的抽离于具体现实的待遇制来表达"},{"start":235.42,"end":238.68,"text":"如果在一个非常发达的未来"},{"start":238.68,"end":240.54,"text":"人类一个非常发达的未来"},{"start":240.54,"end":244.58,"text":"我觉得可以通过我个人意见是可以通过权重制"},{"start":249.199,"end":253.62,"text":"但说很多事情它的发展是非常转瞬即逝的"},{"start":254.8,"end":256.32,"text":"那么这个权重是怎么理解呢"},{"start":256.32,"end":259.5,"text":"比如说这些事情需要某一个特定工种的"},{"start":259.5,"end":262.079,"text":"或者说某一种特定劳动者啊"},{"start":262.079,"end":266.15,"text":"他付出更为啊不可逆的更为严重的代价"},{"start":266.15,"end":269.87,"text":"那么他们对这些事物的表达权就应当是百倍"},{"start":269.87,"end":272.84,"text":"千倍于那些对于这个事情的走向"},{"start":272.84,"end":274.52,"text":"是完全没有一个利害关系"},{"start":274.52,"end":275.89,"text":"那些人甚至可以"},{"start":275.89,"end":278.77,"text":"就根本就剥夺那些人的表达权啊"},{"start":278.77,"end":279.72,"text":"表决权"},{"start":280.379,"end":284.5,"text":"那么这是到了技术发展到一定程度啊"},{"start":284.5,"end":289.15,"text":"并且人民的这个政治素养都得到很高的"},{"start":289.15,"end":290.42,"text":"很大的提高"},{"start":290.42,"end":292.76,"text":"生产力本身也得到了很大的提高"},{"start":292.76,"end":296.1,"text":"才能通过这种方式来决定绝大部分的社会事务"},{"start":296.2,"end":298.63,"text":"那么在技术尚未成熟的时候"},{"start":298.63,"end":304.78,"text":"那么就要通过尤其是最底层的贫穷的贫安"},{"start":304.78,"end":307.0,"text":"贫困的贫民的无产阶级"},{"start":307.0,"end":309.28,"text":"代表他们利益的啊"},{"start":309.28,"end":312.06,"text":"代表他们利益的啊"},{"start":313.14,"end":317.01,"text":"社会力量应当由这个社会力量"},{"start":317.01,"end":321.56,"text":"无产阶级先锋队来主导这个国家的社会秩序"},{"start":321.84,"end":323.4,"text":"基本的社会决策"},{"start":323.4,"end":325.98,"text":"这是我的观点啊"},{"start":325.98,"end":326.91,"text":"这是我的观点"},{"start":330.059,"end":334.019,"text":"都是有违历史现实当中"},{"start":334.019,"end":337.9,"text":"人类应当做出了正确抉择的方向的啊"},{"start":337.9,"end":339.4,"text":"这个定语说的很长的"},{"start":339.4,"end":341.41,"text":"你们可以就倒倒回过去"},{"start":341.41,"end":343.18,"text":"倒回过去看这个啊"},{"start":343.18,"end":344.9,"text":"听这个我说了什么"},{"start":345.68,"end":346.54,"text":"这是第一点"},{"start":348.46,"end":356.74,"text":"那么第二点第二点就是说第二点这个问题啊"},{"start":356.74,"end":358.09,"text":"第二点就是这个问题"},{"start":358.09,"end":360.06,"text":"就是你认为"},{"start":365.639,"end":370.46,"text":"你认为啊在一个"},{"start":374.639,"end":377.119,"text":"啊我们就说当时的历史情境吧"},{"start":380.479,"end":386.38,"text":"这个俄国革命打破了至少东欧的这个"},{"start":396.319,"end":398.32,"text":"在那么一个动荡期间当中"},{"start":399.16,"end":400.44,"text":"如果是你本人啊"},{"start":400.44,"end":401.52,"text":"所以这第二个问题呢"},{"start":401.52,"end":402.96,"text":"它有一定的历史加工性"},{"start":402.96,"end":405.54,"text":"如果是你本人回到那么一个芬兰"},{"start":405.54,"end":408.18,"text":"你会参加白军还是红军"},{"start":408.88,"end":410.61,"text":"我就希望你个人"},{"start":410.61,"end":414.74,"text":"按照你的个人的立场能够回答这个问题"},{"start":414.96,"end":416.94,"text":"当然你可以不回答"},{"start":416.94,"end":418.44,"text":"保留你的建议"},{"start":420.04,"end":421.32,"text":"Show your guts"},{"start":421.32,"end":422.82,"text":"No you don't have guts"},{"start":422.82,"end":424.94,"text":"Or you have"},{"start":425.26,"end":426.52,"text":"我们不确定啊"},{"start":426.52,"end":432.419,"text":"你有没有就是说因为当时的那种内战烈度当中"},{"start":432.419,"end":436.109,"text":"好像第三派的可能性不是特别大啊"},{"start":436.109,"end":437.219,"text":"你要极强的"},{"start":437.219,"end":439.03,"text":"这个没有什么说服力啊"},{"start":439.03,"end":440.83,"text":"那我的答案也是明确的"},{"start":440.83,"end":443.35,"text":"我一定会如果说穿越回芬兰"},{"start":443.35,"end":445.43,"text":"我一定会参加红军"},{"start":445.43,"end":446.99,"text":"我一定会参加红军"},{"start":446.99,"end":447.98,"text":"我一定会参加"},{"start":447.98,"end":451.8,"text":"代表底层无产阶级的利益"},{"start":451.8,"end":454.5,"text":"根本利无产阶级和资产阶级"},{"start":454.5,"end":458.75,"text":"并或或者说其他的有产者并不是并列关系"},{"start":458.75,"end":460.7,"text":"他们并不是并列关系"},{"start":460.7,"end":463.31,"text":"他们并不是说社会是一个班级里面的这个同学"},{"start":463.31,"end":465.37,"text":"和另外一个同学不是并列关系"},{"start":465.37,"end":469.54,"text":"而是一个是一个班级里面的这个同学和"},{"start":473.1,"end":475.64,"text":"他们把其他的同学像椅子一样"},{"start":475.64,"end":479.419,"text":"坐在身下的那张椅子"},{"start":479.419,"end":481.76,"text":"那张人形椅子的关系"},{"start":481.8,"end":485.07,"text":"我觉得就是说你的很多受众不理解"},{"start":485.07,"end":487.84,"text":"有产者和无产阶级之间的关系"},{"start":488.46,"end":490.88,"text":"资产阶级和无产阶级之间的关系"},{"start":493.38,"end":496.73,"text":"有产者在社会当中能够存在"},{"start":496.73,"end":498.28,"text":"就如同"},{"start":500.8,"end":504.66,"text":"一个跳舞的舞蹈在由人搭成的舞台上跳舞"},{"start":504.66,"end":506.06,"text":"一样啊"},{"start":506.06,"end":507.53,"text":"一个跳舞的一个舞者"},{"start":507.53,"end":510.65,"text":"或者说一个上课的学生坐在人"},{"start":510.65,"end":513.919,"text":"同样的应当也在课堂上上学的学生"},{"start":513.919,"end":516.429,"text":"但是他却成为他的课桌椅"},{"start":516.429,"end":517.509,"text":"或者成为它的地板"},{"start":517.509,"end":521.059,"text":"被踩在脚下啊"},{"start":522.679,"end":524.099,"text":"被人骑在身上"},{"start":524.98,"end":527.28,"text":"但是你的很多受众不明白"},{"start":527.28,"end":528.78,"text":"他以为说无产阶级"},{"start":528.78,"end":529.26,"text":"无产者"},{"start":529.26,"end":533.94,"text":"穷人平民贫穷贫是和那些有产者"},{"start":533.94,"end":535.62,"text":"资产阶级是一个并列关系"},{"start":535.62,"end":539.6,"text"