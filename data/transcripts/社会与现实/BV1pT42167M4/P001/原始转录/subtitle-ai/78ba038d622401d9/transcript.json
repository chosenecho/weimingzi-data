{
  "bvid": "BV1pT42167M4",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "78ba038d622401d9f8a14c8f61f02b32561074c8dcf2de673d03643a37e9656e",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 40,
      "end_ms": 2510,
      "text": "不能直接成为自己的主人的啊"
    },
    {
      "ordinal": 1,
      "start_ms": 2510,
      "end_ms": 5210,
      "text": "因为人总要在这个市场关系当中"
    },
    {
      "ordinal": 2,
      "start_ms": 7610,
      "end_ms": 8590,
      "text": "在经济关系中"
    },
    {
      "ordinal": 3,
      "start_ms": 8590,
      "end_ms": 11330,
      "text": "就有我刚刚所说的那种不对称的结构"
    },
    {
      "ordinal": 4,
      "start_ms": 11330,
      "end_ms": 14550,
      "text": "消费者和被被消费者啊"
    },
    {
      "ordinal": 5,
      "start_ms": 14550,
      "end_ms": 17050,
      "text": "我服务商品生产者不对称的结构"
    },
    {
      "ordinal": 6,
      "start_ms": 21870,
      "end_ms": 25630,
      "text": "就社会秩序对你的安排以及你的服从啊"
    },
    {
      "ordinal": 7,
      "start_ms": 25630,
      "end_ms": 27780,
      "text": "对你的刻画限制啊"
    },
    {
      "ordinal": 8,
      "start_ms": 27780,
      "end_ms": 28520,
      "text": "明白吗"
    },
    {
      "ordinal": 9,
      "start_ms": 28520,
      "end_ms": 30800,
      "text": "所以人不能直接是自己主人"
    },
    {
      "ordinal": 10,
      "start_ms": 30800,
      "end_ms": 35560,
      "text": "只有在猫的虚假的自恋的自我幻想图景中"
    },
    {
      "ordinal": 11,
      "start_ms": 35560,
      "end_ms": 37700,
      "text": "人才能直接成为主人"
    },
    {
      "ordinal": 12,
      "start_ms": 37700,
      "end_ms": 40940,
      "text": "就是说啊其实我的主人是我的奴才"
    },
    {
      "ordinal": 13,
      "start_ms": 40940,
      "end_ms": 41800,
      "text": "他在伺候我"
    },
    {
      "ordinal": 14,
      "start_ms": 41800,
      "end_ms": 44950,
      "text": "给我一个安稳的和善的环境"
    },
    {
      "ordinal": 15,
      "start_ms": 45030,
      "end_ms": 47590,
      "text": "我这一段补录一下这种辩证法"
    },
    {
      "ordinal": 16,
      "start_ms": 47590,
      "end_ms": 49830,
      "text": "他的主人感是虚假的"
    },
    {
      "ordinal": 17,
      "start_ms": 49830,
      "end_ms": 51750,
      "text": "猫是会虚幻的欺骗自己"
    },
    {
      "ordinal": 18,
      "start_ms": 51750,
      "end_ms": 52790,
      "text": "好像自己是主人"
    },
    {
      "ordinal": 19,
      "start_ms": 52790,
      "end_ms": 56640,
      "text": "狗狗只有反主人性啊"
    },
    {
      "ordinal": 20,
      "start_ms": 56640,
      "end_ms": 59500,
      "text": "或者狗和狼他是有反主人性"
    },
    {
      "ordinal": 21,
      "start_ms": 59500,
      "end_ms": 63880,
      "text": "他会明确意识到自己不是主人啊"
    },
    {
      "ordinal": 22,
      "start_ms": 63880,
      "end_ms": 66160,
      "text": "就是说狗是意识到自己不是主人"
    },
    {
      "ordinal": 23,
      "start_ms": 66160,
      "end_ms": 67280,
      "text": "它是主人"
    },
    {
      "ordinal": 24,
      "start_ms": 67280,
      "end_ms": 70180,
      "text": "狼会意识到他不是主人"
    },
    {
      "ordinal": 25,
      "start_ms": 70180,
      "end_ms": 72979,
      "text": "我也不是主人"
    },
    {
      "ordinal": 26,
      "start_ms": 73379,
      "end_ms": 74219,
      "text": "明白吗"
    },
    {
      "ordinal": 27,
      "start_ms": 74219,
      "end_ms": 76139,
      "text": "我是我的族群的狗"
    },
    {
      "ordinal": 28,
      "start_ms": 76139,
      "end_ms": 77479,
      "text": "是我族群的成员"
    },
    {
      "ordinal": 29,
      "start_ms": 77479,
      "end_ms": 80419,
      "text": "在这里才有一种平等性"
    },
    {
      "ordinal": 30,
      "start_ms": 80419,
      "end_ms": 82490,
      "text": "才有一种平等性"
    },
    {
      "ordinal": 31,
      "start_ms": 84900,
      "end_ms": 88740,
      "text": "OK啊"
    },
    {
      "ordinal": 32,
      "start_ms": 93000,
      "end_ms": 93940,
      "text": "然后这是一点"
    },
    {
      "ordinal": 33,
      "start_ms": 93940,
      "end_ms": 95800,
      "text": "还有一点我要补充的那个是啥的"
    },
    {
      "ordinal": 34,
      "start_ms": 95800,
      "end_ms": 96280,
      "text": "我记不得了"
    },
    {
      "ordinal": 35,
      "start_ms": 96280,
      "end_ms": 97600,
      "text": "我看一下"
    },
    {
      "ordinal": 36,
      "start_ms": 102420,
      "end_ms": 106100,
      "text": "还有一点就是说你在周围身边全是猫"
    },
    {
      "ordinal": 37,
      "start_ms": 106100,
      "end_ms": 106880,
      "text": "你找不到狼"
    },
    {
      "ordinal": 38,
      "start_ms": 106880,
      "end_ms": 108660,
      "text": "那我要讲的就是说你不要去找狼"
    },
    {
      "ordinal": 39,
      "start_ms": 108660,
      "end_ms": 110050,
      "text": "你去找狗"
    },
    {
      "ordinal": 40,
      "start_ms": 110050,
      "end_ms": 111210,
      "text": "你要告诉他"
    },
    {
      "ordinal": 41,
      "start_ms": 111210,
      "end_ms": 112130,
      "text": "你要效忠的"
    },
    {
      "ordinal": 42,
      "start_ms": 112130,
      "end_ms": 113650,
      "text": "你真正要去认清楚的"
    },
    {
      "ordinal": 43,
      "start_ms": 113650,
      "end_ms": 114930,
      "text": "你能够去效忠的"
    },
    {
      "ordinal": 44,
      "start_ms": 114930,
      "end_ms": 116650,
      "text": "你能够去去呵护"
    },
    {
      "ordinal": 45,
      "start_ms": 116650,
      "end_ms": 118620,
      "text": "去维持的一个团体"
    },
    {
      "ordinal": 46,
      "start_ms": 118620,
      "end_ms": 121440,
      "text": "首先是家庭家族"
    },
    {
      "ordinal": 47,
      "start_ms": 121560,
      "end_ms": 123920,
      "text": "其次是有共同的利益立场的"
    },
    {
      "ordinal": 48,
      "start_ms": 123920,
      "end_ms": 126440,
      "text": "这个同样的同样的这些劳动者"
    },
    {
      "ordinal": 49,
      "start_ms": 126440,
      "end_ms": 127720,
      "text": "同样出身的"
    },
    {
      "ordinal": 50,
      "start_ms": 127720,
      "end_ms": 132020,
      "text": "同样前途命运的这批人狗"
    },
    {
      "ordinal": 51,
      "start_ms": 132020,
      "end_ms": 133280,
      "text": "只要认准了主人"
    },
    {
      "ordinal": 52,
      "start_ms": 133280,
      "end_ms": 134860,
      "text": "狗是能变成狼的"
    },
    {
      "ordinal": 53,
      "start_ms": 134860,
      "end_ms": 139870,
      "text": "因为在侵侵害狗群的利益的人"
    },
    {
      "ordinal": 54,
      "start_ms": 139870,
      "end_ms": 142810,
      "text": "不就是这些狗会去咬他吗"
    },
    {
      "ordinal": 55,
      "start_ms": 142810,
      "end_ms": 144510,
      "text": "咬它咬人的狗不就是狼吗"
    },
    {
      "ordinal": 56,
      "start_ms": 144510,
      "end_ms": 145735,
      "text": "对不对"
    },
    {
      "ordinal": 57,
      "start_ms": 146760,
      "end_ms": 147920,
      "text": "猫是没用的"
    },
    {
      "ordinal": 58,
      "start_ms": 147920,
      "end_ms": 148840,
      "text": "猫永远不可变"
    },
    {
      "ordinal": 59,
      "start_ms": 148840,
      "end_ms": 150090,
      "text": "狮子的"
    },
    {
      "ordinal": 60,
      "start_ms": 150410,
      "end_ms": 151430,
      "text": "明白吗"
    },
    {
      "ordinal": 61,
      "start_ms": 151430,
      "end_ms": 155730,
      "text": "主人喂养猫也只会说给它有限的肉养着"
    },
    {
      "ordinal": 62,
      "start_ms": 155730,
      "end_ms": 157870,
      "text": "不会让这个猫"
    },
    {
      "ordinal": 63,
      "start_ms": 158230,
      "end_ms": 159750,
      "text": "而且猫要长成虱子"
    },
    {
      "ordinal": 64,
      "start_ms": 159750,
      "end_ms": 162650,
      "text": "在它幼小的时候就要拼命的给它肉吃"
    },
    {
      "ordinal": 65,
      "start_ms": 162970,
      "end_ms": 165050,
      "text": "而且他吃过那种各式样的肉"
    },
    {
      "ordinal": 66,
      "start_ms": 166170,
      "end_ms": 168050,
      "text": "猫肉长的柿子是很困难的"
    },
    {
      "ordinal": 67,
      "start_ms": 168050,
      "end_ms": 169890,
      "text": "非常困难的"
    },
    {
      "ordinal": 68,
      "start_ms": 175580,
      "end_ms": 176500,
      "text": "明白吗"
    },
    {
      "ordinal": 69,
      "start_ms": 176500,
      "end_ms": 179020,
      "text": "人不可能直接成为自己的主人的"
    },
    {
      "ordinal": 70,
      "start_ms": 179020,
      "end_ms": 179460,
      "text": "人"
    },
    {
      "ordinal": 71,
      "start_ms": 179460,
      "end_ms": 181180,
      "text": "只有在主体间性当中"
    },
    {
      "ordinal": 72,
      "start_ms": 181180,
      "end_ms": 184400,
      "text": "在人群当中才能成为自己的主人"
    },
    {
      "ordinal": 73,
      "start_ms": 184400,
      "end_ms": 186520,
      "text": "在人群当中不是成为别人的主人"
    },
    {
      "ordinal": 74,
      "start_ms": 188880,
      "end_ms": 190040,
      "text": "我换句话说"
    },
    {
      "ordinal": 75,
      "start_ms": 190040,
      "end_ms": 194300,
      "text": "一只狼只能在狼群当中才能意识到自己"
    },
    {
      "ordinal": 76,
      "start_ms": 194300,
      "end_ms": 197300,
      "text": "是可以去建构主人性的"
    },
    {
      "ordinal": 77,
      "start_ms": 197300,
      "end_ms": 198460,
      "text": "去为他的族群"
    },
    {
      "ordinal": 78,
      "start_ms": 198460,
      "end_ms": 200380,
      "text": "只是设定主人性"
    },
    {
      "ordinal": 79,
      "start_ms": 202800,
      "end_ms": 205240,
      "text": "你没有办法直接成为自己的主人"
    },
    {
      "ordinal": 80,
      "start_ms": 205240,
      "end_ms": 209740,
      "text": "你没有办法直接说自己有一个明确的这个啊"
    },
    {
      "ordinal": 81,
      "start_ms": 209740,
      "end_ms": 211510,
      "text": "自己就是效忠对象"
    },
    {
      "ordinal": 82,
      "start_ms": 211510,
      "end_ms": 213630,
      "text": "因为你所谓的自己是什么呢"
    },
    {
      "ordinal": 83,
      "start_ms": 213630,
      "end_ms": 215150,
      "text": "自我是个节点性的东西"
    },
    {
      "ordinal": 84,
      "start_ms": 215150,
      "end_ms": 216750,
      "text": "他不是个实体性的东西"
    },
    {
      "ordinal": 85,
      "start_ms": 216750,
      "end_ms": 218870,
      "text": "自我是个边界性的节点性的"
    },
    {
      "ordinal": 86,
      "start_ms": 218870,
      "end_ms": 220380,
      "text": "他不是个东西"
    },
    {
      "ordinal": 87,
      "start_ms": 220380,
      "end_ms": 221820,
      "text": "他没有他的图块"
    },
    {
      "ordinal": 88,
      "start_ms": 223060,
      "end_ms": 227430,
      "text": "它只有它的边界缝隙痕迹啊"
    },
    {
      "ordinal": 89,
      "start_ms": 228790,
      "end_ms": 232769,
      "text": "所以摆脱一种恋物癖式的自我幻想"
    },
    {
      "ordinal": 90,
      "start_ms": 232929,
      "end_ms": 234829,
      "text": "猫就会把自己焦点化"
    },
    {
      "ordinal": 91,
      "start_ms": 234829,
      "end_ms": 235549,
      "text": "中心化"
    },
    {
      "ordinal": 92,
      "start_ms": 235549,
      "end_ms": 236189,
      "text": "实质化"
    },
    {
      "ordinal": 93,
      "start_ms": 236189,
      "end_ms": 236829,
      "text": "图块化"
    },
    {
      "ordinal": 94,
      "start_ms": 236829,
      "end_ms": 240400,
      "text": "它自己所能所谓的绝对控制的一个舒适范围"
    },
    {
      "ordinal": 95,
      "start_ms": 240400,
      "end_ms": 241640,
      "text": "就是他的自己"
    },
    {
      "ordinal": 96,
      "start_ms": 241640,
      "end_ms": 244440,
      "text": "然后他只要在这个舒适范围内能控制这些东西"
    },
    {
      "ordinal": 97,
      "start_ms": 244440,
      "end_ms": 246079,
      "text": "他就是所谓的自己的主人"
    },
    {
      "ordinal": 98,
      "start_ms": 246079,
      "end_ms": 249499,
      "text": "只是恋物癖式的把自我完全恋物癖"
    },
    {
      "ordinal": 99,
      "start_ms": 249499,
      "end_ms": 254620,
      "text": "悟悟神化物象化呈现出来一坨一团一块"
    },
    {
      "ordinal": 100,
      "start_ms": 254620,
      "end_ms": 255660,
      "text": "那叫自我"
    },
    {
      "ordinal": 101,
      "start_ms": 255660,
      "end_ms": 257579,
      "text": "然后我是这个都是主人"
    },
    {
      "ordinal": 102,
      "start_ms": 257579,
      "end_ms": 259639,
      "text": "只有猫才会这样去设想嘛"
    },
    {
      "ordinal": 103,
      "start_ms": 259639,
      "end_ms": 262310,
      "text": "因为猫的心理想象是外围东西"
    },
    {
      "ordinal": 104,
      "start_ms": 262310,
      "end_ms": 263590,
      "text": "是主人给我设定的"
    },
    {
      "ordinal": 105,
      "start_ms": 263590,
      "end_ms": 264790,
      "text": "中间是我可以控制的"
    },
    {
      "ordinal": 106,
      "start_ms": 264790,
      "end_ms": 268790,
      "text": "然后我这个中心不停的在这个自由的这个一块"
    },
    {
      "ordinal": 107,
      "start_ms": 268790,
      "end_ms": 270960,
      "text": "这个图景里面游来游去"
    },
    {
      "ordinal": 108,
      "start_ms": 270960,
      "end_ms": 272740,
      "text": "是所谓的自我的主人"
    },
    {
      "ordinal": 109,
      "start_ms": 272740,
      "end_ms": 273760,
      "text": "狼不这样"
    },
    {
      "ordinal": 110,
      "start_ms": 273760,
      "end_ms": 275600,
      "text": "狗不是这样的呀"
    },
    {
      "ordinal": 111,
      "start_ms": 275600,
      "end_ms": 279400,
      "text": "他处在一个驱逐被驱逐和驱逐驱逐"
    },
    {
      "ordinal": 112,
      "start_ms": 279400,
      "end_ms": 281930,
      "text": "他者或者说自己被驱逐"
    },
    {
      "ordinal": 113,
      "start_ms": 281930,
      "end_ms": 285690,
      "text": "它处在一个交锋的一个界面上面"
    },
    {
      "ordinal": 114,
      "start_ms": 288080,
      "end_ms": 292680,
      "text": "OK希望你们弄清楚弄明白"
    },
    {
      "ordinal": 115,
      "start_ms": 293530,
      "end_ms": 296310,
      "text": "就像牧羊犬那边去赶那些羊一样"
    },
    {
      "ordinal": 116,
      "start_ms": 296310,
      "end_ms": 302160,
      "text": "它是在界面上去驱赶一个个体"
    },
    {
      "ordinal": 117,
      "start_ms": 303360,
      "end_ms": 304760,
      "text": "要成为自己的主人"
    },
    {
      "ordinal": 118,
      "start_ms": 305920,
      "end_ms": 309939,
      "text": "首先明确的是要有明确是真正属于自己的领地"
    },
    {
      "ordinal": 119,
      "start_ms": 311359,
      "end_ms": 315399,
      "text": "你可以是自己的领地的主人"
    },
    {
      "ordinal": 120,
      "start_ms": 315399,
      "end_ms": 318320,
      "text": "自己的家族的主人"
    },
    {
      "ordinal": 121,
      "start_ms": 318320,
      "end_ms": 320260,
      "text": "自己的团队的主人"
    },
    {
      "ordinal": 122,
      "start_ms": 320260,
      "end_ms": 322220,
      "text": "共同的是这个团队的主人"
    },
    {
      "ordinal": 123,
      "start_ms": 322220,
      "end_ms": 323539,
      "text": "这个领地的主人"
    },
    {
      "ordinal": 124,
      "start_ms": 323539,
      "end_ms": 327179,
      "text": "主人性不在于是你被豢养了之后"
    },
    {
      "ordinal": 125,
      "start_ms": 327179,
      "end_ms": 328839,
      "text": "你可以自由的去享乐"
    },
    {
      "ordinal": 126,
      "start_ms": 328839,
      "end_ms": 330550,
      "text": "这不是主人性"
    },
    {
      "ordinal": 127,
      "start_ms": 330550,
      "end_ms": 333940,
      "text": "汝等可知何为主人"
    },
    {
      "ordinal": 128,
      "start_ms": 334580,
      "end_ms": 338370,
      "text": "封邦建国是也在古代啊"
    },
    {
      "ordinal": 129,
      "start_ms": 338690,
      "end_ms": 339850,
      "text": "主人耶"
    },
    {
      "ordinal": 130,
      "start_ms": 339850,
      "end_ms": 345650,
      "text": "东道主就是这个领地这一圈这一块你说了算"
    },
    {
      "ordinal": 131,
      "start_ms": 345650,
      "end_ms": 350939,
      "text": "你做主不得由他人介入干涉"
    },
    {
      "ordinal": 132,
      "start_ms": 350939,
      "end_ms": 354939,
      "text": "是有非常强大的排他性的"
    },
    {
      "ordinal": 133,
      "start_ms": 356560,
      "end_ms": 357680,
      "text": "在古代噢"
    },
    {
      "ordinal": 134,
      "start_ms": 357680,
      "end_ms": 360080,
      "text": "我说在古代封建时代"
    },
    {
      "ordinal": 135,
      "start_ms": 360740,
      "end_ms": 364860,
      "text": "明白你可以有你可以有你自己的僚属礼乐制度"
    },
    {
      "ordinal": 136,
      "start_ms": 364860,
      "end_ms": 367420,
      "text": "衣冠有你自己的陵寝"
    },
    {
      "ordinal": 137,
      "start_ms": 367420,
      "end_ms": 369580,
      "text": "有你自己的宗庙"
    },
    {
      "ordinal": 138,
      "start_ms": 369860,
      "end_ms": 372120,
      "text": "这叫主人"
    },
    {
      "ordinal": 139,
      "start_ms": 373340,
      "end_ms": 374320,
      "text": "明白吗"
    },
    {
      "ordinal": 140,
      "start_ms": 374320,
      "end_ms": 376300,
      "text": "你要成为你自己的主人"
    },
    {
      "ordinal": 141,
      "start_ms": 376300,
      "end_ms": 379420,
      "text": "你要成为你自己的世系的主人"
    },
    {
      "ordinal": 142,
      "start_ms": 380760,
      "end_ms": 383080,
      "text": "你以为这很容易啊"
    },
    {
      "ordinal": 143,
      "start_ms": 391020,
      "end_ms": 393540,
      "text": "你不可能在某种意义上讲"
    },
    {
      "ordinal": 144,
      "start_ms": 393540,
      "end_ms": 395840,
      "text": "你不可能直接主宰支配你自己"
    },
    {
      "ordinal": 145,
      "start_ms": 395840,
      "end_ms": 396980,
      "text": "在这个意义上讲"
    },
    {
      "ordinal": 146,
      "start_ms": 396980,
      "end_ms": 398730,
      "text": "主人的主奴"
    },
    {
      "ordinal": 147,
      "start_ms": 398730,
      "end_ms": 403909,
      "text": "辩证法是实现在一个嵌套关系当中的"
    },
    {
      "ordinal": 148,
      "start_ms": 404309,
      "end_ms": 405189,
      "text": "明白吧"
    },
    {
      "ordinal": 149,
      "start_ms": 405189,
      "end_ms": 407770,
      "text": "你是是可以成为自己的主人"
    },
    {
      "ordinal": 150,
      "start_ms": 407770,
      "end_ms": 408530,
      "text": "也换言之"
    },
    {
      "ordinal": 151,
      "start_ms": 408530,
      "end_ms": 411090,
      "text": "你是实质上是成为自己的奴隶"
    },
    {
      "ordinal": 152,
      "start_ms": 411090,
      "end_ms": 413130,
      "text": "只要你只是自己的奴隶的时候"
    },
    {
      "ordinal": 153,
      "start_ms": 413130,
      "end_ms": 414610,
      "text": "你才是自己的主人"
    },
    {
      "ordinal": 154,
      "start_ms": 414610,
      "end_ms": 417490,
      "text": "人可以直接成为自己的奴隶"
    },
    {
      "ordinal": 155,
      "start_ms": 418350,
      "end_ms": 419490,
      "text": "自己的臣仆吧"
    },
    {
      "ordinal": 156,
      "start_ms": 419490,
      "end_ms": 420970,
      "text": "奴隶不就是主体吗"
    },
    {
      "ordinal": 157,
      "start_ms": 420970,
      "end_ms": 423370,
      "text": "人可以直接是自己的主体"
    },
    {
      "ordinal": 158,
      "start_ms": 423370,
      "end_ms": 426000,
      "text": "自己的承受者"
    },
    {
      "ordinal": 159,
      "start_ms": 426480,
      "end_ms": 428620,
      "text": "主体性是一种承受性"
    },
    {
      "ordinal": 160,
      "start_ms": 428620,
      "end_ms": 429700,
      "text": "被动性"
    },
    {
      "ordinal": 161,
      "start_ms": 429700,
      "end_ms": 430720,
      "text": "这个视欲"
    },
    {
      "ordinal": 162,
      "start_ms": 430720,
      "end_ms": 432640,
      "text": "这是整个世界你所体验的一切"
    },
    {
      "ordinal": 163,
      "start_ms": 432640,
      "end_ms": 435270,
      "text": "在一个界面上被动去承受"
    },
    {
      "ordinal": 164,
      "start_ms": 435270,
      "end_ms": 437430,
      "text": "主体性的最本质内核"
    },
    {
      "ordinal": 165,
      "start_ms": 437430,
      "end_ms": 438890,
      "text": "不是主人性"
    },
    {
      "ordinal": 166,
      "start_ms": 438890,
      "end_ms": 441020,
      "text": "主人不是个主体"
    },
    {
      "ordinal": 167,
      "start_ms": 441020,
      "end_ms": 442700,
      "text": "主人是君主"
    },
    {
      "ordinal": 168,
      "start_ms": 442700,
      "end_ms": 443860,
      "text": "不是臣仆"
    },
    {
      "ordinal": 169,
      "start_ms": 444940,
      "end_ms": 447640,
      "text": "主体才是臣仆"
    },
    {
      "ordinal": 170,
      "start_ms": 447960,
      "end_ms": 449120,
      "text": "我希望你们明白"
    },
    {
      "ordinal": 171,
      "start_ms": 449120,
      "end_ms": 450360,
      "text": "不不要给我讲扯哲学"
    },
    {
      "ordinal": 172,
      "start_ms": 450360,
      "end_ms": 452480,
      "text": "哲学作为主体subject"
    },
    {
      "ordinal": 173,
      "start_ms": 452480,
      "end_ms": 455060,
      "text": "它是一个诚朴性的个界面"
    },
    {
      "ordinal": 174,
      "start_ms": 455060,
      "end_ms": 457540,
      "text": "你的主体性不得不向这个世界敞开"
    },
    {
      "ordinal": 175,
      "start_ms": 457540,
      "end_ms": 461460,
      "text": "但是这种被迫是不得不你说我下一瞬间"
    },
    {
      "ordinal": 176,
      "start_ms": 461460,
      "end_ms": 464700,
      "text": "我这个我这体验的这个位面不要让它消失"
    },
    {
      "ordinal": 177,
      "start_ms": 464700,
      "end_ms": 465620,
      "text": "你能让他消失啊"
    },
    {
      "ordinal": 178,
      "start_ms": 465620,
      "end_ms": 466260,
      "text": "笑你妈呢"
    },
    {
      "ordinal": 179,
      "start_ms": 466260,
      "end_ms": 468520,
      "text": "我靠明白吗"
    },
    {
      "ordinal": 180,
      "start_ms": 469800,
      "end_ms": 472580,
      "text": "人无法直接成为自己的主人"
    },
    {
      "ordinal": 181,
      "start_ms": 472580,
      "end_ms": 474940,
      "text": "但是人可以直接人直接的"
    },
    {
      "ordinal": 182,
      "start_ms": 474940,
      "end_ms": 476060,
      "text": "就从其定义来讲"
    },
    {
      "ordinal": 183,
      "start_ms": 476060,
      "end_ms": 477780,
      "text": "人直接就是他自己的奴隶"
    },
    {
      "ordinal": 184,
      "start_ms": 477780,
      "end_ms": 481760,
      "text": "人是一个不得不是自己的奴隶"
    },
    {
      "ordinal": 185,
      "start_ms": 481760,
      "end_ms": 484280,
      "text": "人是宇宙的奴隶啊"
    },
    {
      "ordinal": 186,
      "start_ms": 484280,
      "end_ms": 489920,
      "text": "然后这个宇宙是以自我的方式作为这个奴隶"
    },
    {
      "ordinal": 187,
      "start_ms": 489920,
      "end_ms": 492240,
      "text": "而而展现出来的是吧"
    },
    {
      "ordinal": 188,
      "start_ms": 492240,
      "end_ms": 493000,
      "text": "大家都活着"
    },
    {
      "ordinal": 189,
      "start_ms": 493000,
      "end_ms": 494000,
      "text": "大家都懂这个道理吗"
    },
    {
      "ordinal": 190,
      "start_ms": 494000,
      "end_ms": 494720,
      "text": "我他妈不"
    },
    {
      "ordinal": 191,
      "start_ms": 494720,
      "end_ms": 496900,
      "text": "我只能做这个宇宙"
    },
    {
      "ordinal": 192,
      "start_ms": 496900,
      "end_ms": 499060,
      "text": "然后主体化的这么一个承受者"
    },
    {
      "ordinal": 193,
      "start_ms": 499060,
      "end_ms": 499800,
      "text": "我只能这样"
    },
    {
      "ordinal": 194,
      "start_ms": 499800,
      "end_ms": 500940,
      "text": "我不能别呀"
    },
    {
      "ordinal": 195,
      "start_ms": 500940,
      "end_ms": 504320,
      "text": "我不能说我现在要把他的灵魂穿越到谁身上"
    },
    {
      "ordinal": 196,
      "start_ms": 504320,
      "end_ms": 508020,
      "text": "我变成什么谁谁谁谁是谁"
    },
    {
      "ordinal": 197,
      "start_ms": 508780,
      "end_ms": 510040,
      "text": "很简单吧"
    },
    {
      "ordinal": 198,
      "start_ms": 510040,
      "end_ms": 512700,
      "text": "人直接的就是自己的奴隶"
    },
    {
      "ordinal": 199,
      "start_ms": 512700,
      "end_ms": 513539,
      "text": "这是很明确的"
    },
    {
      "ordinal": 200,
      "start_ms": 513539,
      "end_ms": 515580,
      "text": "因为这是人的定义呀"
    },
    {
      "ordinal": 201,
      "start_ms": 517190,
      "end_ms": 518350,
      "text": "人直接就是自己"
    },
    {
      "ordinal": 202,
      "start_ms": 518350,
      "end_ms": 521730,
      "text": "主体是自己成不是自己的一切的承受者"
    },
    {
      "ordinal": 203,
      "start_ms": 521730,
      "end_ms": 522789,
      "text": "这不废话吗"
    },
    {
      "ordinal": 204,
      "start_ms": 522789,
      "end_ms": 524380,
      "text": "打你是不是你自己疼啊"
    },
    {
      "ordinal": 205,
      "start_ms": 524380,
      "end_ms": 525100,
      "text": "给你一拳"
    },
    {
      "ordinal": 206,
      "start_ms": 525100,
      "end_ms": 527120,
      "text": "是不是你自己难受啊"
    },
    {
      "ordinal": 207,
      "start_ms": 527640,
      "end_ms": 530120,
      "text": "你不能认为别人代劳的嘛"
    },
    {
      "ordinal": 208,
      "start_ms": 530120,
      "end_ms": 531680,
      "text": "你说我把这个架空"
    },
    {
      "ordinal": 209,
      "start_ms": 531680,
      "end_ms": 532740,
      "text": "让别人给代劳"
    },
    {
      "ordinal": 210,
      "start_ms": 532740,
      "end_ms": 533540,
      "text": "给你一拳"
    },
    {
      "ordinal": 211,
      "start_ms": 533540,
      "end_ms": 534320,
      "text": "你妈的这个疼"
    },
    {
      "ordinal": 212,
      "start_ms": 534320,
      "end_ms": 536120,
      "text": "让别人给我承受这个疼"
    },
    {
      "ordinal": 213,
      "start_ms": 536120,
      "end_ms": 538820,
      "text": "你只能你是绝对自己的绝对奴仆"
    },
    {
      "ordinal": 214,
      "start_ms": 538820,
      "end_ms": 540400,
      "text": "但是你要成为自己的主人"
    },
    {
      "ordinal": 215,
      "start_ms": 540400,
      "end_ms": 542280,
      "text": "如何成为自己主人呢"
    },
    {
      "ordinal": 216,
      "start_ms": 543490,
      "end_ms": 545450,
      "text": "明白你不仅是自己的奴仆"
    },
    {
      "ordinal": 217,
      "start_ms": 545450,
      "end_ms": 547410,
      "text": "你也是别人的奴仆"
    },
    {
      "ordinal": 218,
      "start_ms": 547900,
      "end_ms": 549460,
      "text": "要成为自己的主人"
    },
    {
      "ordinal": 219,
      "start_ms": 549460,
      "end_ms": 550340,
      "text": "只有一个办法"
    },
    {
      "ordinal": 220,
      "start_ms": 550340,
      "end_ms": 552540,
      "text": "就是你不仅是别人的"
    },
    {
      "ordinal": 221,
      "start_ms": 552540,
      "end_ms": 554840,
      "text": "你不仅是自己的奴仆"
    },
    {
      "ordinal": 222,
      "start_ms": 554840,
      "end_ms": 556970,
      "text": "你也是别人的奴仆"
    },
    {
      "ordinal": 223,
      "start_ms": 557010,
      "end_ms": 559450,
      "text": "你在这个狼群或者狗群里面"
    },
    {
      "ordinal": 224,
      "start_ms": 559450,
      "end_ms": 560839,
      "text": "你帮助其他的狗"
    },
    {
      "ordinal": 225,
      "start_ms": 560839,
      "end_ms": 564679,
      "text": "然后你帮助的那条狗相当于帮助了你自己的话"
    },
    {
      "ordinal": 226,
      "start_ms": 564679,
      "end_ms": 567000,
      "text": "那你就不就是你自己的主人吗"
    },
    {
      "ordinal": 227,
      "start_ms": 567000,
      "end_ms": 569520,
      "text": "你效忠于比如说你帮了你妈妈"
    },
    {
      "ordinal": 228,
      "start_ms": 569520,
      "end_ms": 572589,
      "text": "你妈相相当于你妈妈也可以更好的帮助你"
    },
    {
      "ordinal": 229,
      "start_ms": 572589,
      "end_ms": 574469,
      "text": "你通过你帮你妈的这种方式"
    },
    {
      "ordinal": 230,
      "start_ms": 574469,
      "end_ms": 575429,
      "text": "你妈帮了你"
    },
    {
      "ordinal": 231,
      "start_ms": 575429,
      "end_ms": 577989,
      "text": "不就是你帮了你自己吗"
    },
    {
      "ordinal": 232,
      "start_ms": 578759,
      "end_ms": 582399,
      "text": "而且你可以自主的决定你妈是帮你还是你妈"
    },
    {
      "ordinal": 233,
      "start_ms": 582399,
      "end_ms": 583279,
      "text": "是害你"
    },
    {
      "ordinal": 234,
      "start_ms": 583279,
      "end_ms": 583999,
      "text": "在这个地上"
    },
    {
      "ordinal": 235,
      "start_ms": 583999,
      "end_ms": 585459,
      "text": "你不就是你的主人了吗"
    },
    {
      "ordinal": 236,
      "start_ms": 585459,
      "end_ms": 587849,
      "text": "人只能间接的是自己的主人"
    },
    {
      "ordinal": 237,
      "start_ms": 588550,
      "end_ms": 590150,
      "text": "人让自己的活动"
    },
    {
      "ordinal": 238,
      "start_ms": 590150,
      "end_ms": 594090,
      "text": "让自己的这个影响以一个间接的方式"
    },
    {
      "ordinal": 239,
      "start_ms": 594090,
      "end_ms": 596590,
      "text": "以让他者来主动影响"
    },
    {
      "ordinal": 240,
      "start_ms": 596590,
      "end_ms": 599680,
      "text": "你明白吗"
    },
    {
      "ordinal": 241,
      "start_ms": 599680,
      "end_ms": 602160,
      "text": "人创人把自己劳动变成工具"
    },
    {
      "ordinal": 242,
      "start_ms": 602160,
      "end_ms": 606270,
      "text": "然后这个工具以某种方式以作为他者的方式"
    },
    {
      "ordinal": 243,
      "start_ms": 606270,
      "end_ms": 606990,
      "text": "帮助到我"
    },
    {
      "ordinal": 244,
      "start_ms": 606990,
      "end_ms": 608630,
      "text": "我可以去支配这个工具"
    },
    {
      "ordinal": 245,
      "start_ms": 608630,
      "end_ms": 611510,
      "text": "其实支配的这个工具里面是我凝结在里面的"
    },
    {
      "ordinal": 246,
      "start_ms": 611510,
      "end_ms": 612510,
      "text": "我的劳动"
    },
    {
      "ordinal": 247,
      "start_ms": 612510,
      "end_ms": 614890,
      "text": "那我不就是这个工具的主人吗"
    },
    {
      "ordinal": 248,
      "start_ms": 614890,
      "end_ms": 618270,
      "text": "人只能用间接的方式才能成为自己的主人"
    },
    {
      "ordinal": 249,
      "start_ms": 618270,
      "end_ms": 620370,
      "text": "一定请你们牢记清楚"
    },
    {
      "ordinal": 250,
      "start_ms": 620370,
      "end_ms": 622710,
      "text": "否则你就在逃避劳动"
    },
    {
      "ordinal": 251,
      "start_ms": 622710,
      "end_ms": 624850,
      "text": "逃避劳人际交往"
    },
    {
      "ordinal": 252,
      "start_ms": 624850,
      "end_ms": 626890,
      "text": "逃避这个世界的责任"
    },
    {
      "ordinal": 253,
      "start_ms": 626890,
      "end_ms": 630370,
      "text": "否则你陷入虚幻的无这个唯我论"
    },
    {
      "ordinal": 254,
      "start_ms": 630370,
      "end_ms": 631610,
      "text": "你知道吗"
    },
    {
      "ordinal": 255,
      "start_ms": 632080,
      "end_ms": 633580,
      "text": "如果你是愚蠢的人"
    },
    {
      "ordinal": 256,
      "start_ms": 633580,
      "end_ms": 636480,
      "text": "你就是会狂妄的相信自己"
    },
    {
      "ordinal": 257,
      "start_ms": 636480,
      "end_ms": 637940,
      "text": "就直接是自己的主人"
    },
    {
      "ordinal": 258,
      "start_ms": 637940,
      "end_ms": 639590,
      "text": "狂妄的相信那种什么"
    },
    {
      "ordinal": 259,
      "start_ms": 639590,
      "end_ms": 641290,
      "text": "这是那种什么"
    },
    {
      "ordinal": 260,
      "start_ms": 641290,
      "end_ms": 645100,
      "text": "就自由主义的那个法权理论体系里面的"
    },
    {
      "ordinal": 261,
      "start_ms": 645100,
      "end_ms": 646140,
      "text": "人家是错的"
    },
    {
      "ordinal": 262,
      "start_ms": 646140,
      "end_ms": 647000,
      "text": "你知道吗"
    },
    {
      "ordinal": 263,
      "start_ms": 649300,
      "end_ms": 651829,
      "text": "我直接我就是我自己的主人"
    },
    {
      "ordinal": 264,
      "start_ms": 651829,
      "end_ms": 654189,
      "text": "人对于自己的支配性"
    },
    {
      "ordinal": 265,
      "start_ms": 654189,
      "end_ms": 657960,
      "text": "在法哲学里面都是中介的呀"
    },
    {
      "ordinal": 266,
      "start_ms": 657960,
      "end_ms": 659560,
      "text": "都有具有中介要求"
    },
    {
      "ordinal": 267,
      "start_ms": 659560,
      "end_ms": 660600,
      "text": "通过身体来中介"
    },
    {
      "ordinal": 268,
      "start_ms": 660600,
      "end_ms": 661760,
      "text": "通过他人来中介"
    },
    {
      "ordinal": 269,
      "start_ms": 661760,
      "end_ms": 662620,
      "text": "通过财产"
    },
    {
      "ordinal": 270,
      "start_ms": 662620,
      "end_ms": 663820,
      "text": "通过工具来中介"
    },
    {
      "ordinal": 271,
      "start_ms": 663820,
      "end_ms": 665740,
      "text": "通过人和自己的思维"
    },
    {
      "ordinal": 272,
      "start_ms": 665740,
      "end_ms": 667880,
      "text": "人和自己的意识内容来中介"
    },
    {
      "ordinal": 273,
      "start_ms": 667880,
      "end_ms": 669460,
      "text": "都是带有中介性"
    },
    {
      "ordinal": 274,
      "start_ms": 669460,
      "end_ms": 670980,
      "text": "人不能直接的支配下自己"
    },
    {
      "ordinal": 275,
      "start_ms": 670980,
      "end_ms": 674030,
      "text": "如果人直接的支配到自己的人是神"
    },
    {
      "ordinal": 276,
      "start_ms": 674390,
      "end_ms": 676590,
      "text": "如果你可以直接是你的主人"
    },
    {
      "ordinal": 277,
      "start_ms": 676590,
      "end_ms": 677950,
      "text": "那就应该是这样"
    },
    {
      "ordinal": 278,
      "start_ms": 677950,
      "end_ms": 680760,
      "text": "我现在我要我的体验里面是个大美女"
    },
    {
      "ordinal": 279,
      "start_ms": 680760,
      "end_ms": 681720,
      "text": "在被我日好"
    },
    {
      "ordinal": 280,
      "start_ms": 681720,
      "end_ms": 683620,
      "text": "那你的体验一下子变成个大美女"
    },
    {
      "ordinal": 281,
      "start_ms": 683620,
      "end_ms": 684760,
      "text": "你你在日常"
    },
    {
      "ordinal": 282,
      "start_ms": 684760,
      "end_ms": 687880,
      "text": "我现在我的体验里面就是我要有超级好吃"
    },
    {
      "ordinal": 283,
      "start_ms": 687880,
      "end_ms": 688340,
      "text": "冰淇淋"
    },
    {
      "ordinal": 284,
      "start_ms": 688340,
      "end_ms": 689850,
      "text": "好我的"
    },
    {
      "ordinal": 285,
      "start_ms": 689850,
      "end_ms": 691070,
      "text": "如果你是你是主人"
    },
    {
      "ordinal": 286,
      "start_ms": 691070,
      "end_ms": 692590,
      "text": "你想让你体验什么"
    },
    {
      "ordinal": 287,
      "start_ms": 692590,
      "end_ms": 695150,
      "text": "就让你这才是真正意义上你你是你的主人"
    },
    {
      "ordinal": 288,
      "start_ms": 695150,
      "end_ms": 695810,
      "text": "你懂吗"
    },
    {
      "ordinal": 289,
      "start_ms": 695810,
      "end_ms": 698190,
      "text": "人只能间接的是自己的主人"
    },
    {
      "ordinal": 290,
      "start_ms": 698190,
      "end_ms": 699590,
      "text": "你要有个大美女"
    },
    {
      "ordinal": 291,
      "start_ms": 699590,
      "end_ms": 700150,
      "text": "让你怎么样"
    },
    {
      "ordinal": 292,
      "start_ms": 700150,
      "end_ms": 701430,
      "text": "有个好吃冰激凌"
    },
    {
      "ordinal": 293,
      "start_ms": 701430,
      "end_ms": 702300,
      "text": "让你怎么样"
    },
    {
      "ordinal": 294,
      "start_ms": 702300,
      "end_ms": 703940,
      "text": "你得间接的来"
    },
    {
      "ordinal": 295,
      "start_ms": 703940,
      "end_ms": 705560,
      "text": "你得先付出努力"
    },
    {
      "ordinal": 296,
      "start_ms": 705560,
      "end_ms": 708460,
      "text": "先让这个整个来兜那么一圈"
    },
    {
      "ordinal": 297,
      "start_ms": 708460,
      "end_ms": 709960,
      "text": "最后兜回来"
    },
    {
      "ordinal": 298,
      "start_ms": 710200,
      "end_ms": 712260,
      "text": "这个不是很简单的道理吗"
    },
    {
      "ordinal": 299,
      "start_ms": 712260,
      "end_ms": 713600,
      "text": "从哲学上来讲"
    },
    {
      "ordinal": 300,
      "start_ms": 713600,
      "end_ms": 716620,
      "text": "你怎么可能直接是自己主人呢"
    },
    {
      "ordinal": 301,
      "start_ms": 716620,
      "end_ms": 718100,
      "text": "好understand呢"
    },
    {
      "ordinal": 302,
      "start_ms": 719740,
      "end_ms": 721020,
      "text": "直接是自己主任的"
    },
    {
      "ordinal": 303,
      "start_ms": 721020,
      "end_ms": 722310,
      "text": "那是疯子"
    },
    {
      "ordinal": 304,
      "start_ms": 722310,
      "end_ms": 722750,
      "text": "你知道吗"
    },
    {
      "ordinal": 305,
      "start_ms": 722750,
      "end_ms": 723930,
      "text": "这种人不存在"
    },
    {
      "ordinal": 306,
      "start_ms": 723930,
      "end_ms": 724630,
      "text": "明白吗"
    },
    {
      "ordinal": 307,
      "start_ms": 724630,
      "end_ms": 727470,
      "text": "这种意识结构是不向世界敞开的"
    },
    {
      "ordinal": 308,
      "start_ms": 727470,
      "end_ms": 729070,
      "text": "闭合的或者是紊乱的"
    },
    {
      "ordinal": 309,
      "start_ms": 729070,
      "end_ms": 731820,
      "text": "你知道是短路的"
    },
    {
      "ordinal": 310,
      "start_ms": 737020,
      "end_ms": 738380,
      "text": "希望你想清楚啊"
    },
    {
      "ordinal": 311,
      "start_ms": 738380,
      "end_ms": 739740,
      "text": "所以我们回过头来讲"
    },
    {
      "ordinal": 312,
      "start_ms": 739740,
      "end_ms": 742630,
      "text": "就是说狗可以变成狼"
    },
    {
      "ordinal": 313,
      "start_ms": 742630,
      "end_ms": 744010,
      "text": "但是猫是不可能的"
    },
    {
      "ordinal": 314,
      "start_ms": 744010,
      "end_ms": 746230,
      "text": "猫永远不可能变成狮的"
    },
    {
      "ordinal": 315,
      "start_ms": 746470,
      "end_ms": 747630,
      "text": "猫不肯变狮子"
    },
    {
      "ordinal": 316,
      "start_ms": 747630,
      "end_ms": 748430,
      "text": "不能变老虎"
    },
    {
      "ordinal": 317,
      "start_ms": 748430,
      "end_ms": 750210,
      "text": "但狮子和老虎还是有差别的"
    },
    {
      "ordinal": 318,
      "start_ms": 750210,
      "end_ms": 751770,
      "text": "这个就是我们下次要讲的"
    },
    {
      "ordinal": 319,
      "start_ms": 751770,
      "end_ms": 753390,
      "text": "就是说在这个比喻当中"
    },
    {
      "ordinal": 320,
      "start_ms": 753390,
      "end_ms": 755230,
      "text": "狼只有一种狼"
    },
    {
      "ordinal": 321,
      "start_ms": 755540,
      "end_ms": 757900,
      "text": "狼王和狗王其实也是有点差别的"
    },
    {
      "ordinal": 322,
      "start_ms": 757900,
      "end_ms": 763760,
      "text": "但是呢就是头狼和下面那些小狼之间的差别"
    },
    {
      "ordinal": 323,
      "start_ms": 763760,
      "end_ms": 765220,
      "text": "我可能会下一次讲"
    },
    {
      "ordinal": 324,
      "start_ms": 765220,
      "end_ms": 768290,
      "text": "还有一个就是狮子和老虎也是不一样的"
    },
    {
      "ordinal": 325,
      "start_ms": 768290,
      "end_ms": 770150,
      "text": "狮子和老虎吃肉的"
    },
    {
      "ordinal": 326,
      "start_ms": 770150,
      "end_ms": 771710,
      "text": "狮子和老虎也是不一样的"
    },
    {
      "ordinal": 327,
      "start_ms": 771710,
      "end_ms": 772650,
      "text": "同样是吃肉的"
    },
    {
      "ordinal": 328,
      "start_ms": 772650,
      "end_ms": 776500,
      "text": "狼和狮子和老虎也是不一样的"
    },
    {
      "ordinal": 329,
      "start_ms": 778620,
      "end_ms": 780380,
      "text": "OK希望你们想想清楚啊"
    },
    {
      "ordinal": 330,
      "start_ms": 780380,
      "end_ms": 781980,
      "text": "我们就要用用这种比喻的方式"
    },
    {
      "ordinal": 331,
      "start_ms": 781980,
      "end_ms": 784900,
      "text": "有点像伊索寓言的方式来跟你讲社会结构啊"
    },
    {
      "ordinal": 332,
      "start_ms": 784900,
      "end_ms": 787760,
      "text": "来跟你讲这种实质的非常致命的"
    },
    {
      "ordinal": 333,
      "start_ms": 787760,
      "end_ms": 790260,
      "text": "非常重要的这种人际关系"
    },
    {
      "ordinal": 334,
      "start_ms": 790260,
      "end_ms": 792380,
      "text": "权力斗争的经验"
    },
    {
      "ordinal": 335,
      "start_ms": 792380,
      "end_ms": 796319,
      "text": "人际权力关系交往交往的那种范式"
    },
    {
      "ordinal": 336,
      "start_ms": 796319,
      "end_ms": 799799,
      "text": "或者说每个人的自我认同的那个符号学的"
    },
    {
      "ordinal": 337,
      "start_ms": 799799,
      "end_ms": 802950,
      "text": "根本性的那个基本的一个想象图示"
    },
    {
      "ordinal": 338,
      "start_ms": 802950,
      "end_ms": 804230,
      "text": "我只是用比方"
    },
    {
      "ordinal": 339,
      "start_ms": 804230,
      "end_ms": 806870,
      "text": "大家都是可以用很精细的术语来表达"
    },
    {
      "ordinal": 340,
      "start_ms": 806870,
      "end_ms": 808870,
      "text": "什么自恋性的啊"
    },
    {
      "ordinal": 341,
      "start_ms": 808870,
      "end_ms": 810339,
      "text": "什么神经症的"
    },
    {
      "ordinal": 342,
      "start_ms": 810339,
      "end_ms": 814050,
      "text": "比如强迫症式的倒错的嗯"
    },
    {
      "ordinal": 343,
      "start_ms": 814050,
      "end_ms": 816870,
      "text": "就是分析师或者说一些结构主义者"
    },
    {
      "ordinal": 344,
      "start_ms": 816870,
      "end_ms": 819750,
      "text": "他会用一些更复杂的术语来跟你们讲"
    },
    {
      "ordinal": 345,
      "start_ms": 819750,
      "end_ms": 823320,
      "text": "这个道理更精细的更复杂的道理嗯"
    },
    {
      "ordinal": 346,
      "start_ms": 823320,
      "end_ms": 825480,
      "text": "但是我就是用这比较粗浅的比喻"
    },
    {
      "ordinal": 347,
      "start_ms": 825480,
      "end_ms": 828380,
      "text": "希望你们能能能懂这个东西啊"
    },
    {
      "ordinal": 348,
      "start_ms": 828380,
      "end_ms": 829980,
      "text": "能理解这个东西好吧"
    },
    {
      "ordinal": 349,
      "start_ms": 829980,
      "end_ms": 830740,
      "text": "那讲到这边啊"
    },
    {
      "ordinal": 350,
      "start_ms": 830740,
      "end_ms": 831720,
      "text": "goodbye拜拜"
    }
