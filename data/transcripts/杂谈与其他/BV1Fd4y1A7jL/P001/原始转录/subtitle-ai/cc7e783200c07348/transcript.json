  "content_sha256": "cc7e783200c0734860ab42a725891fd0de8b22c4c7e1df125bfd6eead13be132",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 160,
      "end_ms": 2200,
      "text": "因为他这个触手是延伸到那边"
    },
    {
      "ordinal": 1,
      "start_ms": 8500,
      "end_ms": 11400,
      "text": "整个里面的这个毛细血管里面"
    },
    {
      "ordinal": 2,
      "start_ms": 11400,
      "end_ms": 13860,
      "text": "推动这些毛细血管里面的这些呃"
    },
    {
      "ordinal": 3,
      "start_ms": 13860,
      "end_ms": 15780,
      "text": "物质力量运动"
    },
    {
      "ordinal": 4,
      "start_ms": 16239,
      "end_ms": 20739,
      "text": "明白吗的一个必备的必备的一个梯度差"
    },
    {
      "ordinal": 5,
      "start_ms": 20739,
      "end_ms": 21699,
      "text": "一个梯度"
    },
    {
      "ordinal": 6,
      "start_ms": 21699,
      "end_ms": 24190,
      "text": "一个是啊一个视差"
    },
    {
      "ordinal": 7,
      "start_ms": 24190,
      "end_ms": 26780,
      "text": "或者说一个就是离子浓度差异"
    },
    {
      "ordinal": 8,
      "start_ms": 27140,
      "end_ms": 27920,
      "text": "明白吗"
    },
    {
      "ordinal": 9,
      "start_ms": 27920,
      "end_ms": 29780,
      "text": "所以目前来讲的话"
    },
    {
      "ordinal": 10,
      "start_ms": 29780,
      "end_ms": 32530,
      "text": "你在工作当中"
    },
    {
      "ordinal": 11,
      "start_ms": 32530,
      "end_ms": 35740,
      "text": "尽量了解这工作所切入的社会面"
    },
    {
      "ordinal": 12,
      "start_ms": 35740,
      "end_ms": 37180,
      "text": "里面的各种情报"
    },
    {
      "ordinal": 13,
      "start_ms": 37180,
      "end_ms": 40420,
      "text": "了解这一项工作目现实的利益"
    },
    {
      "ordinal": 14,
      "start_ms": 40420,
      "end_ms": 42140,
      "text": "网络当中的现实的人"
    },
    {
      "ordinal": 15,
      "start_ms": 43400,
      "end_ms": 45530,
      "text": "他们的存在状况啊"
    },
    {
      "ordinal": 16,
      "start_ms": 45530,
      "end_ms": 48050,
      "text": "以及当然也也有这个体系当中的"
    },
    {
      "ordinal": 17,
      "start_ms": 48050,
      "end_ms": 49940,
      "text": "那些劳动者的状况"
    },
    {
      "ordinal": 18,
      "start_ms": 52040,
      "end_ms": 53059,
      "text": "就是"
    },
    {
      "ordinal": 19,
      "start_ms": 54800,
      "end_ms": 56860,
      "text": "这是一个常态化的装准备"
    },
    {
      "ordinal": 20,
      "start_ms": 56860,
      "end_ms": 57820,
      "text": "这是一个重要的准备"
    },
    {
      "ordinal": 21,
      "start_ms": 57820,
      "end_ms": 59660,
      "text": "这是一个常态化的准备啊"
    },
    {
      "ordinal": 22,
      "start_ms": 60100,
      "end_ms": 61990,
      "text": "要更了解社会"
    },
    {
      "ordinal": 23,
      "start_ms": 61990,
      "end_ms": 65659,
      "text": "而且更控制社会力量啊"
    },
    {
      "ordinal": 24,
      "start_ms": 65659,
      "end_ms": 67459,
      "text": "我们作为劳动者本身"
    },
    {
      "ordinal": 25,
      "start_ms": 67459,
      "end_ms": 69079,
      "text": "我们是国家的主人啊"
    },
    {
      "ordinal": 26,
      "start_ms": 69079,
      "end_ms": 71039,
      "text": "要更了解这个社会"
    },
    {
      "ordinal": 27,
      "start_ms": 71100,
      "end_ms": 73110,
      "text": "跟一个主人翁的姿态"
    },
    {
      "ordinal": 28,
      "start_ms": 73110,
      "end_ms": 75600,
      "text": "去和生活生活资料相结合"
    },
    {
      "ordinal": 29,
      "start_ms": 75600,
      "end_ms": 78460,
      "text": "比如说一个布尔乔亚装修房子"
    },
    {
      "ordinal": 30,
      "start_ms": 78460,
      "end_ms": 80620,
      "text": "1001000给2001000给"
    },
    {
      "ordinal": 31,
      "start_ms": 80620,
      "end_ms": 82000,
      "text": "然后就撒手了"
    },
    {
      "ordinal": 32,
      "start_ms": 84380,
      "end_ms": 86360,
      "text": "但是如果你是个老祖老虎大众"
    },
    {
      "ordinal": 33,
      "start_ms": 86360,
      "end_ms": 87800,
      "text": "你花5000块钱装修房子"
    },
    {
      "ordinal": 34,
      "start_ms": 87800,
      "end_ms": 89009,
      "text": "花1万块钱装修房子"
    },
    {
      "ordinal": 35,
      "start_ms": 89009,
      "end_ms": 90209,
      "text": "你自己亲力亲为"
    },
    {
      "ordinal": 36,
      "start_ms": 90209,
      "end_ms": 91529,
      "text": "掌握无数生活技能"
    },
    {
      "ordinal": 37,
      "start_ms": 91529,
      "end_ms": 93710,
      "text": "掌握很多是这些物资"
    },
    {
      "ordinal": 38,
      "start_ms": 93710,
      "end_ms": 94940,
      "text": "知道那个虚假"
    },
    {
      "ordinal": 39,
      "start_ms": 94940,
      "end_ms": 98300,
      "text": "的表象背后的现实是如何被搭搭搭建的"
    },
    {
      "ordinal": 40,
      "start_ms": 98300,
      "end_ms": 99500,
      "text": "各种原理啊"
    },
    {
      "ordinal": 41,
      "start_ms": 99500,
      "end_ms": 100850,
      "text": "什么铆钉枪啊"
    },
    {
      "ordinal": 42,
      "start_ms": 100850,
      "end_ms": 101540,
      "text": "什么什么"
    },
    {
      "ordinal": 43,
      "start_ms": 101540,
      "end_ms": 103399,
      "text": "就像我最近做的这些事情"
    },
    {
      "ordinal": 44,
      "start_ms": 104300,
      "end_ms": 105640,
      "text": "什么鸡毛啊"
    },
    {
      "ordinal": 45,
      "start_ms": 105640,
      "end_ms": 108200,
      "text": "什么什么啊"
    },
    {
      "ordinal": 46,
      "start_ms": 108200,
      "end_ms": 110120,
      "text": "这种膨胀螺丝啊"
    },
    {
      "ordinal": 47,
      "start_ms": 110120,
      "end_ms": 111860,
      "text": "之前都通通就明白了"
    },
    {
      "ordinal": 48,
      "start_ms": 111860,
      "end_ms": 114620,
      "text": "要和这些生活资料结合到一块去"
    },
    {
      "ordinal": 49,
      "start_ms": 114620,
      "end_ms": 118179,
      "text": "因为表象是容易坍塌的"
    },
    {
      "ordinal": 50,
      "start_ms": 120820,
      "end_ms": 122460,
      "text": "啊本质是表象表象嘛"
    },
    {
      "ordinal": 51,
      "start_ms": 122460,
      "end_ms": 125539,
      "text": "那当然说我们并不是说这些东西就是的啊"
    },
    {
      "ordinal": 52,
      "start_ms": 128598,
      "end_ms": 131119,
      "text": "就是奥兹赞助物质面占住实践面"
    },
    {
      "ordinal": 53,
      "start_ms": 131119,
      "end_ms": 132800,
      "text": "赞助的本质不是这样的"
    },
    {
      "ordinal": 54,
      "start_ms": 134119,
      "end_ms": 135219,
      "text": "都不是这样的"
    },
    {
      "ordinal": 55,
      "start_ms": 135219,
      "end_ms": 136239,
      "text": "就不这样了"
    },
    {
      "ordinal": 56,
      "start_ms": 136239,
      "end_ms": 137589,
      "text": "我们站着是真相"
    },
    {
      "ordinal": 57,
      "start_ms": 137589,
      "end_ms": 138879,
      "text": "我们站着的真相"
    },
    {
      "ordinal": 58,
      "start_ms": 138879,
      "end_ms": 140619,
      "text": "我们往往喜欢说的是真相"
    },
    {
      "ordinal": 59,
      "start_ms": 141159,
      "end_ms": 142860,
      "text": "we don't talk about"
    },
    {
      "ordinal": 60,
      "start_ms": 144140,
      "end_ms": 145180,
      "text": "essence"
    },
    {
      "ordinal": 61,
      "start_ms": 145180,
      "end_ms": 146800,
      "text": "我们往往讨论真相"
    },
    {
      "ordinal": 62,
      "start_ms": 148590,
      "end_ms": 151110,
      "text": "都和真相和生生活资料的真相"
    },
    {
      "ordinal": 63,
      "start_ms": 154940,
      "end_ms": 156200,
      "text": "就他会掏1万块钱"
    },
    {
      "ordinal": 64,
      "start_ms": 156200,
      "end_ms": 156800,
      "text": "就在我这边"
    },
    {
      "ordinal": 65,
      "start_ms": 156800,
      "end_ms": 158280,
      "text": "他值20块嗯"
    },
    {
      "ordinal": 66,
      "start_ms": 158280,
      "end_ms": 159480,
      "text": "就那那我知道他真相"
    },
    {
      "ordinal": 67,
      "start_ms": 159480,
      "end_ms": 161040,
      "text": "那我知道他为什么就值20块"
    },
    {
      "ordinal": 68,
      "start_ms": 161040,
      "end_ms": 162000,
      "text": "他怎么被生产出来"
    },
    {
      "ordinal": 69,
      "start_ms": 162000,
      "end_ms": 162960,
      "text": "泡了什么药水"
    },
    {
      "ordinal": 70,
      "start_ms": 162960,
      "end_ms": 164140,
      "text": "他是怎么怎么样的"
    },
    {
      "ordinal": 71,
      "start_ms": 168950,
      "end_ms": 172370,
      "text": "通信虚拟道被当成是优质什么呃"
    },
    {
      "ordinal": 72,
      "start_ms": 172370,
      "end_ms": 174890,
      "text": "股股票优质资产"
    },
    {
      "ordinal": 73,
      "start_ms": 174890,
      "end_ms": 176240,
      "text": "然后捆绑上市"
    },
    {
      "ordinal": 74,
      "start_ms": 178220,
      "end_ms": 180240,
      "text": "这些东西它只是一个资本"
    },
    {
      "ordinal": 75,
      "start_ms": 181119,
      "end_ms": 182639,
      "text": "反而是一种空转的"
    },
    {
      "ordinal": 76,
      "start_ms": 182639,
      "end_ms": 184950,
      "text": "一个一个虚假的差异标的"
    },
    {
      "ordinal": 77,
      "start_ms": 184950,
      "end_ms": 186030,
      "text": "但是对于我们来说"
    },
    {
      "ordinal": 78,
      "start_ms": 186030,
      "end_ms": 187530,
      "text": "就是现实的这个信道"
    },
    {
      "ordinal": 79,
      "start_ms": 187530,
      "end_ms": 188730,
      "text": "在那边有什么样的作用"
    },
    {
      "ordinal": 80,
      "start_ms": 188730,
      "end_ms": 190290,
      "text": "对这个街区的啊"
    },
    {
      "ordinal": 81,
      "start_ms": 190290,
      "end_ms": 191250,
      "text": "哪些人口"
    },
    {
      "ordinal": 82,
      "start_ms": 191250,
      "end_ms": 193209,
      "text": "他的什么基本需求"
    },
    {
      "ordinal": 83,
      "start_ms": 193209,
      "end_ms": 195069,
      "text": "它能起到什么作用啊"
    },
    {
      "ordinal": 84,
      "start_ms": 195069,
      "end_ms": 196209,
      "text": "对它的根本的利益"
    },
    {
      "ordinal": 85,
      "start_ms": 196209,
      "end_ms": 197529,
      "text": "它能够呃"
    },
    {
      "ordinal": 86,
      "start_ms": 197529,
      "end_ms": 198729,
      "text": "让这里的平民"
    },
    {
      "ordinal": 87,
      "start_ms": 198729,
      "end_ms": 202559,
      "text": "也能够动员起这个大量的车队"
    },
    {
      "ordinal": 88,
      "start_ms": 202559,
      "end_ms": 203459,
      "text": "大量的运力"
    },
    {
      "ordinal": 89,
      "start_ms": 203459,
      "end_ms": 205619,
      "text": "大量的物资投投投送"
    },
    {
      "ordinal": 90,
      "start_ms": 205619,
      "end_ms": 211150,
      "text": "大量的这个社会危机的一个一个反馈点啊"
    },
    {
      "ordinal": 91,
      "start_ms": 211150,
      "end_ms": 213490,
      "text": "它是通讯信道有如此重要的作用"
    },
    {
      "ordinal": 92,
      "start_ms": 214690,
      "end_ms": 217090,
      "text": "你就能知道这些也可以控制这些东西"
    },
    {
      "ordinal": 93,
      "start_ms": 217090,
      "end_ms": 218650,
      "text": "也可能更更更现实"
    },
    {
      "ordinal": 94,
      "start_ms": 218650,
      "end_ms": 220090,
      "text": "更切实的控制这些东西"
    },
    {
      "ordinal": 95,
      "start_ms": 220090,
      "end_ms": 221080,
      "text": "然后就讲到这里啊"
    },
    {
      "ordinal": 96,
      "start_ms": 221080,
      "end_ms": 223279,
      "text": "这是目前的一个状况啊"
    },
    {
      "ordinal": 97,
      "start_ms": 223279,
      "end_ms": 223699,
      "text": "我心中"
    },
    {
      "ordinal": 98,
      "start_ms": 223699,
      "end_ms": 225199,
      "text": "然后还有另外插一嘴"
    },
    {
      "ordinal": 99,
      "start_ms": 225199,
      "end_ms": 225499,
      "text": "就是我"
    },
    {
      "ordinal": 100,
      "start_ms": 225499,
      "end_ms": 228859,
      "text": "们那个呃网络班的那个改造要延期"
    },
    {
      "ordinal": 101,
      "start_ms": 228859,
      "end_ms": 229920,
      "text": "要攒气"
    },
    {
      "ordinal": 102,
      "start_ms": 230760,
      "end_ms": 232999,
      "text": "要有一定的转型嗯"
    },
    {
      "ordinal": 103,
      "start_ms": 232999,
      "end_ms": 234619,
      "text": "目前就是吊顶已经调好了"
    },
    {
      "ordinal": 104,
      "start_ms": 234619,
      "end_ms": 237499,
      "text": "但是那个墙的那个墙皮处理好"
    },
    {
      "ordinal": 105,
      "start_ms": 237499,
      "end_ms": 239639,
      "text": "但还没有贴贴墙纸"
    },
    {
      "ordinal": 106,
      "start_ms": 239639,
      "end_ms": 242000,
      "text": "然后那边的那个两个厕所厕所"
    },
    {
      "ordinal": 107,
      "start_ms": 242000,
      "end_ms": 244280,
      "text": "一个厕所他那个砖头砌好了"
    },
    {
      "ordinal": 108,
      "start_ms": 244280,
      "end_ms": 245540,
      "text": "现在做防水"
    },
    {
      "ordinal": 109,
      "start_ms": 245540,
      "end_ms": 247100,
      "text": "外面的瓷砖贴了一大半"
    },
    {
      "ordinal": 110,
      "start_ms": 247100,
      "end_ms": 250280,
      "text": "那边的那个厕所啊"
    },
    {
      "ordinal": 111,
      "start_ms": 250280,
      "end_ms": 252020,
      "text": "上面的逆子打完了啊"
    },
    {
      "ordinal": 112,
      "start_ms": 252020,
      "end_ms": 254510,
      "text": "那上面腻子可能还没有打完啊"
    },
    {
      "ordinal": 113,
      "start_ms": 254510,
      "end_ms": 258110,
      "text": "然后那个反正明天要把这个漆油漆给气下"
    },
    {
      "ordinal": 114,
      "start_ms": 258110,
      "end_ms": 258709,
      "text": "把那个厕所"
    },
    {
      "ordinal": 115,
      "start_ms": 258709,
      "end_ms": 261540,
      "text": "尤其给七七厕所里面切七油漆啊"
    },
    {
      "ordinal": 116,
      "start_ms": 264750,
      "end_ms": 266580,
      "text": "墙墙墙面太走也好多"
    },
    {
      "ordinal": 117,
      "start_ms": 266580,
      "end_ms": 267240,
      "text": "墙面好多个"
    },
    {
      "ordinal": 118,
      "start_ms": 267240,
      "end_ms": 268939,
      "text": "我只能用用用铝"
    },
    {
      "ordinal": 119,
      "start_ms": 268939,
      "end_ms": 270199,
      "text": "塑板给钉上去了"
    },
    {
      "ordinal": 120,
      "start_ms": 270199,
      "end_ms": 271999,
      "text": "外面大的可以用铝塑板定"
    },
    {
      "ordinal": 121,
      "start_ms": 271999,
      "end_ms": 273739,
      "text": "那这个厕所里面吕苏版"
    },
    {
      "ordinal": 122,
      "start_ms": 273739,
      "end_ms": 274480,
      "text": "我靠"
    },
    {
      "ordinal": 123,
      "start_ms": 275020,
      "end_ms": 277560,
      "text": "我们现在也为了为了为了定铝塑板"
    },
    {
      "ordinal": 124,
      "start_ms": 277560,
      "end_ms": 278940,
      "text": "或者为了加固一些东西"
    },
    {
      "ordinal": 125,
      "start_ms": 278940,
      "end_ms": 281760,
      "text": "那个墙我们用炮钉枪在顶配一枪哈"
    },
    {
      "ordinal": 126,
      "start_ms": 281760,
      "end_ms": 283400,
      "text": "笑死炮金枪再定"
    },
    {
      "ordinal": 127,
      "start_ms": 285019,
      "end_ms": 288189,
      "text": "然后这个斩击可能就整整攒个两三天"
    },
    {
      "ordinal": 128,
      "start_ms": 288189,
      "end_ms": 288879,
      "text": "就能搞定"
    },
    {
      "ordinal": 129,
      "start_ms": 288879,
      "end_ms": 290259,
      "text": "这个周末肯定能搞定的"
    },
    {
      "ordinal": 130,
      "start_ms": 290259,
      "end_ms": 293280,
      "text": "因为剩下的工序不多"
    },
    {
      "ordinal": 131,
      "start_ms": 293280,
      "end_ms": 294870,
      "text": "就是强制一天啊"
    },
    {
      "ordinal": 132,
      "start_ms": 297000,
      "end_ms": 300500,
      "text": "把他打到墙上那边那个厕所"
    },
    {
      "ordinal": 133,
      "start_ms": 300500,
      "end_ms": 303670,
      "text": "然后再把这个那个那边那个绘本"
    },
    {
      "ordinal": 134,
