    },
    {
      "ordinal": 164,
      "start_ms": 548280,
      "end_ms": 549980,
      "text": "一个最小的组织单元"
    },
    {
      "ordinal": 165,
      "start_ms": 549980,
      "end_ms": 552790,
      "text": "家庭婚姻要革命"
    },
    {
      "ordinal": 166,
      "start_ms": 552790,
      "end_ms": 554650,
      "text": "要运行这种小周天"
    },
    {
      "ordinal": 167,
      "start_ms": 554650,
      "end_ms": 557200,
      "text": "哼哼啊"
    },
    {
      "ordinal": 168,
      "start_ms": 557200,
      "end_ms": 558780,
      "text": "革命是要运行这种小周贴的"
    },
    {
      "ordinal": 169,
      "start_ms": 558780,
      "end_ms": 562460,
      "text": "只不过说就是"
    },
    {
      "ordinal": 170,
      "start_ms": 567680,
      "end_ms": 570080,
      "text": "就是这个小桌垫是不断的在运行的"
    },
    {
      "ordinal": 171,
      "start_ms": 570080,
      "end_ms": 571160,
      "text": "不断的在运行的"
    },
    {
      "ordinal": 172,
      "start_ms": 571160,
      "end_ms": 573250,
      "text": "它这个是呃"
    },
    {
      "ordinal": 173,
      "start_ms": 573250,
      "end_ms": 577080,
      "text": "如果你是我们一开始所说的地缘单法啊"
