    {
      "ordinal": 174,
      "start_ms": 577080,
      "end_ms": 579360,
      "text": "就是还是从下丹田出发"
    },
    {
      "ordinal": 175,
      "start_ms": 579360,
      "end_ms": 584260,
      "text": "那么这整个这个运行就只是一个思想精神层面"
