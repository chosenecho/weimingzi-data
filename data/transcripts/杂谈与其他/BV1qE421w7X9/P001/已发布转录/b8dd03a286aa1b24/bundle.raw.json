{"segments":[{"start":1.16,"end":3.04,"text":"啊我们实事求是讲"},{"start":3.04,"end":5.23,"text":"就是"},{"start":5.95,"end":7.95,"text":"我觉得应该把我们国家当成是一个"},{"start":7.95,"end":9.99,"text":"比较好的新手村"},{"start":10.79,"end":13.63,"text":"我真的就是说包括你去美国"},{"start":13.63,"end":15.39,"text":"你能过上比较好的生活"},{"start":15.39,"end":16.43,"text":"但有个前提"},{"start":16.43,"end":18.99,"text":"你在我们这里学了技能"},{"start":19.95,"end":20.77,"text":"懂吗"},{"start":20.77,"end":22.27,"text":"哪怕你是个蹩脚"},{"start":22.27,"end":24.31,"text":"学的是个蹩脚ENGLISH英语"},{"start":25.39,"end":27.47,"text":"然后你就会点电工"},{"start":28.9,"end":30.92,"text":"你在美国你也可以过得比较好"},{"start":30.92,"end":35.18,"text":"你想在美国的那个什么华人社区里面"},{"start":35.18,"end":37.44,"text":"学会学好一个英语"},{"start":37.44,"end":38.76,"text":"很难很难"},{"start":38.76,"end":39.72,"text":"你知道吗"},{"start":39.72,"end":42.18,"text":"你在我们国家应试教育"},{"start":42.18,"end":43.84,"text":"初高中什么义务教育里面"},{"start":43.84,"end":44.8,"text":"你把英语学好了"},{"start":44.8,"end":46.84,"text":"高考能应付的过了"},{"start":47.16,"end":48.88,"text":"其实你才run出去"},{"start":48.88,"end":51.6,"text":"才能有一个基本的好日子过"},{"start":52.13,"end":56.46,"text":"你想要出去在那个什么华人街里面"},{"start":56.46,"end":59.48,"text":"唐人街里面他妈的把英语再再学的好的不"},{"start":59.48,"end":60.34,"text":"你哪有这个实验"},{"start":60.34,"end":61.24,"text":"天天妈打黑工"},{"start":61.24,"end":65.029,"text":"黑工打一辈子啊"},{"start":65.029,"end":66.329,"text":"很多run出去的人"},{"start":66.329,"end":68.709,"text":"他能之所以还能过上比较好的生活"},{"start":68.709,"end":71.549,"text":"是因为他在这里获得了相应的技能"},{"start":71.549,"end":74.78,"text":"培训劳动群众啊"},{"start":74.78,"end":75.58,"text":"这个国家"},{"start":75.58,"end":79.76,"text":"这个社会给你身上投入了很多这个教育资源"},{"start":83.74,"end":88.16,"text":"啊你然后这些人出去说"},{"start":88.16,"end":90.84,"text":"哎我在外面当电工啊"},{"start":90.84,"end":92.34,"text":"一个月多少刀多少刀"},{"start":92.34,"end":93.48,"text":"你在国内当电工"},{"start":93.48,"end":94.52,"text":"一个月才多少钱多少钱"},{"start":94.52,"end":96.12,"text":"这个话他妈的被狗吃了"},{"start":96.12,"end":96.44,"text":"你知道吗"},{"start":96.44,"end":97.88,"text":"当电工的技能"},{"start":97.88,"end":100.65,"text":"你如果就是个花华人黑工的仔"},{"start":100.65,"end":102.33,"text":"你在你在欧洲"},{"start":102.33,"end":103.57,"text":"你想学你妈电工"},{"start":103.57,"end":104.97,"text":"你妈的你学多久"},{"start":104.97,"end":108.37,"text":"你有你哪有这个学习的喘息的余地"},{"start":108.37,"end":110.09,"text":"去学这些东西"},{"start":116.48,"end":120.92,"text":"不是主要是华人的那个还比较勤奋你吗"},{"start":120.92,"end":123.56,"text":"中国人很勤奋的老黑"},{"start":123.56,"end":126.34,"text":"他会英语是被崩的命"},{"start":126.34,"end":131.66,"text":"那是因为他们那个社区文化被被腐蚀了嗯"},{"start":131.66,"end":135.34,"text":"华人总的来讲还是反对的华人家庭"},{"start":135.34,"end":137.82,"text":"然后也反对那个性滥交的"},{"start":137.82,"end":138.76,"text":"总的来讲"},{"start":138.76,"end":141.86,"text":"然后那些什么帮派文化也是有节制的"},{"start":141.86,"end":143.9,"text":"不是无节制的搞暴力的"},{"start":143.9,"end":146.079,"text":"搞什么枪制什么东西的"},{"start":146.079,"end":147.019,"text":"明白吗"},{"start":147.019,"end":151.619,"text":"然后这个老黑他是会盲目的模仿白人世界当中"},{"start":151.619,"end":154.119,"text":"底层的比较错误的文化"},{"start":154.44,"end":155.14,"text":"懂吗"},{"start":155.14,"end":158.36,"text":"就是那白人搞了一个种族主义3K党"},{"start":158.36,"end":160.16,"text":"那么老黑还搞个类似的"},{"start":160.16,"end":161.04,"text":"你懂吗"},{"start":161.04,"end":164.61,"text":"类似的就是说类似的那种"},{"start":164.61,"end":167.59,"text":"排其他肤色的一种种族主义"},{"start":168.03,"end":170.43,"text":"愁白的或者愁黄的种族主义"},{"start":170.43,"end":174.23,"text":"就是说就是说老黑就有个问题"},{"start":174.23,"end":179.89,"text":"他会盲目的去模仿他的对手的一些错误的方式"},{"start":179.89,"end":181.26,"text":"错误的选项"},{"start":181.26,"end":182.58,"text":"那中国不一样对吧"},{"start":182.58,"end":184.06,"text":"中国再怎么退往后退呢"},{"start":184.06,"end":188.04,"text":"退退回儒教乌堡自守的家族家族"},{"start":188.04,"end":192.45,"text":"宗族制这个玩意还是在历史上是经受过考验的"},{"start":192.45,"end":194.07,"text":"他有那么多大一统王朝"},{"start":194.07,"end":195.27,"text":"也有那么多乱世呢"},{"start":195.27,"end":198.799,"text":"嗯承受过啊历史的检验的"},{"start":198.799,"end":200.219,"text":"他还有这个差异的"},{"start":200.219,"end":202.979,"text":"而且中国人是除了犹太人啊"},{"start":202.979,"end":206.74,"text":"中国人是所有民族当中是最或者德国人"},{"start":206.74,"end":207.74,"text":"啊啊啊"},{"start":207.74,"end":208.9,"text":"中国和德国人差不多的"},{"start":208.9,"end":209.86,"text":"最讲究教育的吧"},{"start":209.86,"end":212.14,"text":"家庭教育只要能安顿下来"},{"start":212.14,"end":213.48,"text":"然后自给自足"},{"start":213.48,"end":215.18,"text":"不依赖于这个市场"},{"start":215.18,"end":216.2,"text":"不花很多钱的"},{"start":216.2,"end":217.5,"text":"或喜欢攒钱的"},{"start":217.5,"end":218.68,"text":"然后很勤奋"},{"start":218.68,"end":220.0,"text":"一个人打四份工"},{"start":220.0,"end":222.23,"text":"五份工拼命的啊"},{"start":222.23,"end":224.32,"text":"为自己的子女啊"},{"start":224.32,"end":227.76,"text":"所以这我们国家老百姓那么几千年"},{"start":227.76,"end":230.62,"text":"都是在这个最难的难度里面的"},{"start":230.62,"end":234.33,"text":"比我们国家更难的可能就是那个啧"},{"start":234.33,"end":235.77,"text":"不是说朝鲜"},{"start":235.77,"end":237.05,"text":"我说古代啊"},{"start":237.05,"end":240.84,"text":"古代那个过的日子可能比那明朝更苦一点"},{"start":241.24,"end":244.2,"text":"明朝清朝就是中国老百姓就过得很苦的"},{"start":244.2,"end":245.96,"text":"难度是在一个比较地狱难度"},{"start":245.96,"end":247.08,"text":"不说噩梦难度吧"},{"start":247.08,"end":249.0,"text":"这样过出来的"},{"start":252.28,"end":255.68,"text":"所以总的来讲你就你不要以为就是外国很好"},{"start":255.68,"end":257.6,"text":"外国也够呛的"},{"start":257.6,"end":259.029,"text":"很累的"},{"start":259.189,"end":260.668,"text":"然后你能去外国过得好"},{"start":260.668,"end":264.269,"text":"是因为你们在国内其实占了很多便宜"},{"start":264.47,"end":266.07,"text":"比如说我可能去国外"},{"start":266.07,"end":267.63,"text":"我也可以过得比较好"},{"start":269.43,"end":270.45,"text":"这一点你们可以保证"},{"start":270.45,"end":272.02,"text":"但我也不会出国"},{"start":272.02,"end":272.98,"text":"我去国外的话"},{"start":272.98,"end":275.18,"text":"我可能我就做司机或者做个电工啊"},{"start":275.18,"end":276.84,"text":"或者做个什么呃"},{"start":276.84,"end":277.98,"text":"这个管道工"},{"start":277.98,"end":280.44,"text":"我可能我会做个这个马里奥管道管道工"},{"start":280.44,"end":281.6,"text":"给他修管道或怎么样"},{"start":281.6,"end":283.4,"text":"或者我可以做个脱口秀"},{"start":283.4,"end":284.68,"text":"把口语稍微练一练"},{"start":284.68,"end":286.44,"text":"就开始开始扯段子"},{"start":286.44,"end":288.21,"text":"说脱口秀或怎么样的"},{"start":288.21,"end":289.57,"text":"那赚到一定的钱了之后"},{"start":289.57,"end":292.75,"text":"我也会直接在在美国做一个什么工团头头"},{"start":296.94,"end":298.54,"text":"所以我的我的观点是"},{"start":301.06,"end":306.64,"text":"啊就是西方的制度陷阱是不能走的"},{"start":306.64,"end":308.02,"text":"没有意义的啊"},{"start":308.02,"end":308.7,"text":"而且你走了"},{"start":308.7,"end":311.72,"text":"实际上是让这个西方资本给你干涉"},{"start":311.72,"end":314.14,"text":"开了个口子啊"},{"start":314.14,"end":315.64,"text":"暴露在这个"},{"start":315.64,"end":317.76,"text":"就像是给自己伤口上涂大便那种感觉"},{"start":317.76,"end":319.54,"text":"他就腐烂了"},{"start":321.82,"end":323.65,"text":"他的政治筹码不烂呢"},{"start":325.79,"end":328.69,"text":"他的政治筹码和这个他的援引"},{"start":328.69,"end":330.77,"text":"靠着外援来获得胜利"},{"start":330.77,"end":332.81,"text":"实际上是要更多的呃"},{"start":332.81,"end":334.15,"text":"他的代价就是老百姓"},{"start":334.15,"end":336.83,"text":"底层老百姓是要受到更严重的剥削"},{"start":336.83,"end":338.01,"text":"他不会是解放者"},{"start":338.01,"end":339.93,"text":"我们不是认为咳咳"},{"start":339.93,"end":342.71,"text":"人家就是瞅着你身上还算有有肉"},{"start":342.71,"end":345.06,"text":"想把你这一口吃下去的"},{"start":345.3,"end":348.26,"text":"那如果是西方势力正在成功干涉的话"},{"start":348.26,"end":351.12,"text":"那中国底层老百姓受教育权就没得了"},{"start":351.28,"end":353.56,"text":"就是没有正儿八经的受教育权的"},{"start":354.6,"end":358.88,"text":"他不会说想把你做成什么合格的工业人口"},{"start":359.82,"end":363.86,"text":"你只要是合格的被被性侵人口就行了"},{"start":363.86,"end":365.3,"text":"明白吗"},{"start":365.79,"end":366.71,"text":"对他们来讲"},{"start":366.71,"end":368.75,"text":"他就是不需要把你变成合格的工业人口"},{"start":368.75,"end":369.95,"text":"他就会把你分化"},{"start":369.95,"end":373.46,"text":"然后是扶植各个分裂主义势力啊"},{"start":373.46,"end":375.58,"text":"对于这个中华民族都是毁灭性的灾难"},{"start":375.58,"end":376.94,"text":"这个是我们不能承受的啊"},{"start":376.94,"end":377.58,"text":"不能承受的"},{"start":377.58,"end":379.1,"text":"所以我们盯着各个团体"},{"start":379.1,"end":381.089,"text":"其实就盯着你骨子里"},{"start":381.089,"end":383.209,"text":"最后是不是就是要的西方代议制"},{"start":383.209,"end":385.009,"text":"或者西方势力干涉"},{"start":385.27,"end":386.95,"text":"我们绝对不会跟这种合作的"},{"start":386.95,"end":387.83,"text":"就是汉奸"},{"start":387.83,"end":388.43,"text":"绝对不能做"},{"start":389.59,"end":390.73,"text":"绝对不能做汉奸"},{"start":390.73,"end":392.63,"text":"或者说华监"},{"start":393.54,"end":395.62,"text":"你叫我一天到晚呃"},{"start":395.62,"end":398.26,"text":"这个呃说我爱国爱国"},{"start":398.26,"end":401.75,"text":"这个我也我们也不会说一天到晚拿在嘴巴上的"},{"start":401.75,"end":403.59,"text":"就是绝对不做汉奸"},{"start":403.59,"end":406.52,"text":"这是肯定的啊"},{"start":407.84,"end":409.52,"text":"啊当然我也不会说片面的"},{"start":409.52,"end":410.96,"text":"一天到晚吼着爱国爱国"},{"start":410.96,"end":415.599,"text":"就是被某种呃狭隘的爱国主义的民粹捆绑"},{"start":415.599,"end":418.199,"text":"然后比如说其实是对国家有利的一些角色"},{"start":418.199,"end":419.279,"text":"一些一些行动"},{"start":419.279,"end":424.39,"text":"比如说呃笼络这个东亚一些国别嗯"},{"start":425.47,"end":426.47,"text":"笼络他们"},{"start":426.47,"end":429.71,"text":"或者说输出呃势力"},{"start":429.71,"end":431.55,"text":"影响他们的内部决策"},{"start":431.55,"end":436.75,"text":"或者说他的和平战争啊的一些决策呃"},{"start":436.75,"end":438.37,"text":"利利于我们的长远利益"},{"start":438.37,"end":439.47,"text":"那在那种情况下"},{"start":439.47,"end":441.03,"text":"你狭隘也打着是爱国的旗号"},{"start":441.03,"end":442.09,"text":"说不允许跟他谈"},{"start":442.09,"end":444.61,"text":"不允许跟他是什么嗯"},{"start":444.61,"end":446.98,"text":"有一个准联盟关系也好"},{"start":446.98,"end":449.04,"text":"那就是妨碍我们的利益的对吧"},{"start":449.04,"end":452.26,"text":"就是你抽离的狭隘的讲一个哇"},{"start":452.26,"end":453.24,"text":"一定要他们赎罪"},{"start":453.24,"end":454.02,"text":"要把他们干翻"},{"start":454.02,"end":455.34,"text":"要把他们杀光什么的"},{"start":455.34,"end":456.32,"text":"讲民族仇恨"},{"start":456.32,"end":457.52,"text":"那你又不是讲爱国"},{"start":457.52,"end":458.92,"text":"你实际上是在讲仇恨"},{"start":458.92,"end":460.03,"text":"对不对"},{"start":460.03,"end":461.11,"text":"你讲爱国"},{"start":461.11,"end":462.11,"text":"那是还是要讲"},{"start":462.11,"end":465.34,"text":"我们这个当下的长远和长远的利益"},{"start":465.34,"end":467.82,"text":"而不是说就是直接我要报仇"},{"start":467.82,"end":468.7,"text":"被他们杀光啊"},{"start":468.7,"end":470.049,"text":"什么这东西的"},{"start":470.049,"end":471.889,"text":"那你讲光讲你这个东西"