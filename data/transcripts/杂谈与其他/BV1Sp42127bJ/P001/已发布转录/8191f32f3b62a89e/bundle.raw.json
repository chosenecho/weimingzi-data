{"segments":[{"start":0.32,"end":4.58,"text":"某个境内自媒体从业人士"},{"start":5.5,"end":6.96,"text":"我现在警告你"},{"start":8.22,"end":12.44,"text":"你在境外组建的群组引流"},{"start":12.96,"end":18.41,"text":"主导其中的管理制度啊"},{"start":18.99,"end":21.83,"text":"所组建的这么一个群组当中的"},{"start":21.83,"end":23.33,"text":"无论是你的核心粉丝"},{"start":23.33,"end":27.29,"text":"还是那些在外面大群的外围粉丝"},{"start":29.76,"end":31.98,"text":"你必须"},{"start":33.2,"end":35.68,"text":"由于你是唯一的第一责任人"},{"start":35.68,"end":38.7,"text":"你必须我现在警告你"},{"start":38.7,"end":45.44,"text":"即刻停止对于我和我的团体的侮辱诽谤陷害"},{"start":48.26,"end":50.52,"text":"停止你那些"},{"start":53.44,"end":60.58,"text":"针对我和我的团队的肮脏的造谣栽赃"},{"start":61.81,"end":63.06,"text":"即刻停止"},{"start":63.06,"end":64.95,"text":"那么对于你你那些东西"},{"start":64.95,"end":66.48,"text":"对于其他的自然人"},{"start":66.48,"end":68.7,"text":"其他的社会现象"},{"start":68.7,"end":70.62,"text":"其他的什么这些东西的"},{"start":70.62,"end":72.42,"text":"也有一些不法的"},{"start":72.42,"end":73.77,"text":"非法的那东西"},{"start":73.77,"end":77.57,"text":"那老实说我现在只顾着找我自己"},{"start":77.57,"end":79.14,"text":"即刻停止"}],"source":"subtitle"}
