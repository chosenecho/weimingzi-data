nd":703.72,"text":"也不要放的太大"},{"start":703.72,"end":707.32,"text":"就是我我的建议是这样啊"},{"start":713.28,"end":715.26,"text":"啊是的没错"},{"start":715.26,"end":718.62,"text":"但是呢魏明子虽然说我们不能跟他硬碰硬眼"},{"start":718.62,"end":721.42,"text":"但是在背地里面批判一下他的那些逆天言论"},{"start":721.42,"end":722.819,"text":"还是很好的"},{"start":722.819,"end":724.279,"text":"不是说不行啊"},{"start":724.279,"end":725.819,"text":"但是呢批判他的时候呢"},{"start":725.819,"end":727.239,"text":"就不能挺名言"},{"start":727.239,"end":730.15,"text":"就是直就是直呼一些什么东西的"},{"start":730.15,"end":731.51,"text":"不然真的可能会触塔"},{"start":733.11,"end":737.57,"text":"当介是过了转爱联合键"},{"start":737.57,"end":739.03,"text":"其实可以试试看"},{"start":739.03,"end":739.85,"text":"你知道吗"},{"start":739.85,"end":742.49,"text":"但是呢不知道去哪里找他们"},{"start":742.49,"end":746.66,"text":"对他批判过哪一些人呃"},{"start":746.66,"end":747.68,"text":"挺傻的"},{"start":747.68,"end":749.05,"text":"真的啊"},{"start":749.05,"end":752.87,"text":"当然他那个他就是互联网上那条木羊犬而已"},{"start":752.87,"end":754.46,"text":"就是基督城"},{"start":754.46,"end":759.32,"text":"他批判的人包括咱们天宇杨杨和平米哈游呃"},{"start":759.32,"end":760.16,"text":"张北海"},{"start":760.16,"end":761.18,"text":"郭同志"},{"start":761.18,"end":763.7,"text":"你家还有许许多多的左车up"},{"start":763.7,"end":766.87,"text":"他就是一条人见人嫌的"},{"start":766.87,"end":768.83,"text":"他不是无路线斗争"},{"start":768.83,"end":771.079,"text":"是意识形态的争斗"},{"start":771.439,"end":774.639,"text":"他就是个他就是个对吧"},{"start":774.639,"end":779.18,"text":"他哥哥学院这学盗版是学疯魔的废物对吧"},{"start":779.18,"end":780.58,"text":"我看到我一个初中的时候"},{"start":780.58,"end":781.26,"text":"我看盗版书"},{"start":781.26,"end":783.27,"text":"我都最起码我都哎对"},{"start":783.27,"end":784.47,"text":"这不对那不对的对吧"},{"start":784.47,"end":785.67,"text":"我都能看出来"},{"start":785.67,"end":787.15,"text":"当然他也不是看不出来"},{"start":787.15,"end":789.23,"text":"他就想赚那逼钱"},{"start":789.46,"end":791.74,"text":"我们就要利用他这一点对吧"},{"start":791.74,"end":793.97,"text":"你看你这个你也你也不想"},{"start":793.97,"end":796.79,"text":"你也不想让失去警察叔叔的信任吧"},{"start":796.79,"end":798.78,"text":"差吧是差不多"},{"start":798.78,"end":802.2,"text":"当然我们和魏民子的矛盾是路线斗争吗"},{"start":802.2,"end":804.02,"text":"其实不仅是路线斗争"},{"start":806.06,"end":807.38,"text":"他是维护哪个阶级"},{"start":807.38,"end":809.249,"text":"我都不我都不用多说"},{"start":809.249,"end":809.729,"text":"我跟你讲"},{"start":809.729,"end":814.31,"text":"你们听你们听279同志的那个呃"},{"start":814.31,"end":817.07,"text":"那个发言都能猜出他是维护哪一个的"},{"start":817.07,"end":819.94,"text":"这里就不必直接点塔了"},{"start":823.5,"end":829.4,"text":"我们就是要而而且呢我们还是要同它斗争辩论"},{"start":829.4,"end":831.16,"text":"至于辩论方面的话"},{"start":831.16,"end":833.06,"text":"我们肯定不能跟他当面对论呢"},{"start":833.06,"end":834.84,"text":"甚至是他发表那些时候呢"},{"start":834.84,"end":838.66,"text":"我们我们大部分人是是无法跟他证明兑现的"},{"start":838.66,"end":840.26,"text":"只能退而求其色"},{"start":840.26,"end":841.52,"text":"你知道吗"},{"start":843.58,"end":845.72,"text":"而且呢怎么说呢"},{"start":845.72,"end":846.7,"text":"魏明子啊"},{"start":846.7,"end":848.78,"text":"他发表那个动态啊有很多"},{"start":848.78,"end":851.839,"text":"那就比如说他他对你啊"},{"start":851.839,"end":856.39,"text":"他目前发的最近的一个动态是6月30号发的"},{"start":856.39,"end":858.57,"text":"那个我维护八小时工作制"},{"start":858.57,"end":862.11,"text":"反对煽动激进政治幻想"},{"start":862.72,"end":864.22,"text":"他就是个工贼"},{"start":864.22,"end":865.76,"text":"这个这段明显是公贼发言"},{"start":865.76,"end":867.58,"text":"我现在可以立刻就劈他"},{"start":867.58,"end":868.76,"text":"完全可以批斗对吧"},{"start":868.76,"end":870.21,"text":"我我连副本我都不用拿"},{"start":870.21,"end":873.23,"text":"他说这个正好就是我们批判他的嘛"},{"start":873.23,"end":875.89,"text":"你你看一下他的那个内容是什么"},{"start":875.89,"end":877.25,"text":"大概念给你们听啊"},{"start":877.25,"end":878.329,"text":"就说什么了"},{"start":878.329,"end":881.609,"text":"他说什么不实谣言疯传"},{"start":881.609,"end":883.97,"text":"我个人和团队不支持"},{"start":883.97,"end":887.17,"text":"八小时工作制和相关法律的落实"},{"start":887.17,"end":887.93,"text":"实际上"},{"start":887.93,"end":894.45,"text":"我们在与舆论宣传和法务咨询服务层面啊"},{"start":894.45,"end":897.529,"text":"括号始终始终至此"},{"start":897.529,"end":900.709,"text":"完全的尊重和拥护八小时工作制的"},{"start":905.29,"end":908.04,"text":"愿意用行动继续支持国家"},{"start":908.04,"end":911.58,"text":"对企业实行八个小时的工作情况的监督和完善"},{"start":911.58,"end":912.06,"text":"说真的"},{"start":912.06,"end":913.91,"text":"这句话简直跟放狗屁一样"},{"start":913.91,"end":915.85,"text":"我都不知道他究竟维护在哪里"},{"start":915.85,"end":917.38,"text":"还愿意用行动"},{"start":917.38,"end":919.98,"text":"我我倒不清楚他的行动在哪里"},{"start":919.98,"end":921.06,"text":"但凡看过他的视频"},{"start":921.06,"end":922.66,"text":"知道我靠三个小时"},{"start":922.66,"end":923.9,"text":"几个小时的那种视频"},{"start":923.9,"end":926.29,"text":"好像他都一屁股就坐在那个电脑面前"},{"start":926.29,"end":928.57,"text":"都不知道他监视跟维护在哪里"},{"start":928.57,"end":930.97,"text":"他还他还好意思说提相关法律"},{"start":930.97,"end":934.4,"text":"说真的我老爸都是在打夜班呐"},{"start":934.4,"end":936.42,"text":"啊从来都是白班"},{"start":936.42,"end":937.74,"text":"晚班两边倒"},{"start":937.74,"end":938.82,"text":"累死累活"},{"start":938.82,"end":940.66,"text":"我老妈也是一个情况"},{"start":940.66,"end":942.26,"text":"你说这个只八小时吗"},{"start":942.26,"end":944.0,"text":"我就好奇他监控在哪里呢"},{"start":944.0,"end":946.66,"text":"合着监控她在老家呢"},{"start":947.22,"end":948.44,"text":"而且还有什么呢"},{"start":948.44,"end":949.56,"text":"那下面这些什么"},{"start":949.56,"end":954.86,"text":"某些生因趋于一线劳动者追求权益的大方向啊"},{"start":954.86,"end":956.73,"text":"什么顽固"},{"start":956.73,"end":961.03,"text":"国家介入调整劳资关系时"},{"start":961.03,"end":965.46,"text":"对八小时工作制的全力落实和持续完善"},{"start":965.46,"end":967.44,"text":"片面炒作工作"},{"start":967.44,"end":972.599,"text":"把工时啊议题反复制造啊"},{"start":972.959,"end":974.739,"text":"舆情热点啊"},{"start":974.739,"end":977.459,"text":"酝酿空洞的焦虑和不满"},{"start":977.459,"end":980.8,"text":"对此我们坚决反对哈"},{"start":981.24,"end":984.8,"text":"嗯这一段一停下来"},{"start":984.8,"end":985.8,"text":"重点是什么"},{"start":985.8,"end":986.76,"text":"他说什么"},{"start":986.76,"end":989.14,"text":"他说某一件事啊"},{"start":989.14,"end":991.24,"text":"那某一些声音他说的是我们"},{"start":991.24,"end":994.84,"text":"那他说的就是我们说的就是我们这些左翼人士"},{"start":994.84,"end":1000.0,"text":"那还趋于一线劳动者追求权益的大方向"},{"start":1000.0,"end":1001.24,"text":"难道不是吗"},{"start":1001.24,"end":1001.92,"text":"我们左右"},{"start":1001.92,"end":1006.54,"text":"不就是为了让那些劳动者们得到相应的利益吗"},{"start":1006.54,"end":1007.86,"text":"那他这句话什么意思"},{"start":1007.86,"end":1009.52,"text":"很显然他出于反对的态度"},{"start":1009.52,"end":1011.18,"text":"知道还他还说什么"},{"start":1011.18,"end":1014.36,"text":"他说故就是他还搬出这个国家"},{"start":1014.36,"end":1017.16,"text":"调整难度关系的全面落实和持续完善"},{"start":1017.16,"end":1018.64,"text":"说增长"},{"start":1019.259,"end":1023.359,"text":"国家根本不可能完全落实这八小时工作制的"},{"start":1023.359,"end":1026.579,"text":"它也而且现在国家也做不到"},{"start":1026.898,"end":1028.019,"text":"就就怎么说"},{"start":1028.019,"end":1030.419,"text":"他们国国家要是落实了就不"},{"start":1030.419,"end":1032.378,"text":"我们都不会在这开会是吧"},{"start":1032.378,"end":1033.539,"text":"国家要是落实了"},{"start":1033.539,"end":1036.29,"text":"我们我们我们这个群我都建不起嗯"},{"start":1036.29,"end":1037.55,"text":"他但凡落实了"},{"start":1037.55,"end":1038.109,"text":"我跟你讲"},{"start":1038.109,"end":1040.069,"text":"他根本都不会发出这种动态出来"},{"start":1040.069,"end":1040.55,"text":"你知道吗"},{"start":1040.55,"end":1042.13,"text":"这还是啊这啊"},{"start":1042.13,"end":1045.405,"text":"这还是两个月前6月30号发的啊"},{"start":1045.53,"end":1046.849,"text":"而且怎么说"},{"start":1046.849,"end":1048.569,"text":"然后他还说什么我吧"},{"start":1048.569,"end":1051.19,"text":"他还说我们反复什么片面的炒作"},{"start":1051.19,"end":1053.25,"text":"公就是公实议题"},{"start":1053.25,"end":1056.93,"text":"然后人家还反复制造舆论的热度热点啊"},{"start":1056.93,"end":1057.69,"text":"他还这"},{"start":1057.69,"end":1058.13,"text":"他还说"},{"start":1058.13,"end":1061.8,"text":"我就是我们酝酿出了空洞的焦虑和不满啊"},{"start":1061.8,"end":1065.54,"text":"对此他们决坚决反对我们这这就这些做法"},{"start":1065.54,"end":1068.82,"text":"难道是我们引起了劳动者们的焦虑和不满吗"},{"start":1068.82,"end":1069.98,"text":"我们反复制造热点"},{"start":1069.98,"end":1072.82,"text":"不就是为了让劳动者们理解到"},{"start":1072.82,"end":1074.76,"text":"而且要争取这八小时工作制吗"},{"start":1074.76,"end":1076.1,"text":"那如果照他这么说的话"},{"start":1076.1,"end":1077.14,"text":"那当年李大钊的话"},{"start":1077.14,"end":1080.66,"text":"就应该早早的就被这个位名字枪毙啊"},{"start":1081.19,"end":1083.51,"text":"那合着他当年就是反对那些陈独秀"},{"start":1083.51,"end":1085.03,"text":"李大钊这这些革命先驱"},{"start":1086.03,"end":1088.82,"text":"那他简直就是狗屁不如知"},{"start":1090.2,"end":1093.4,"text":"但但是各位我们要带一个弦外之音"},{"start":1093.4,"end":1095.9,"text":"就是我们通揽下来这个动态"},{"start":1095.9,"end":1098.2,"text":"我们就可以发现他用一种我们很熟悉的说法"},{"start":1098.2,"end":1101.3,"text":"就是春秋笔法分流笔法啊"},{"start":1101.3,"end":1102.04,"text":"同志们"},{"start":1102.04,"end":1103.86,"text":"这代表了什么"},{"start":1103.86,"end":1107.22,"text":"这他妈和那个工作文件他妈一模一样"},{"start":1107.22,"end":1109.42,"text":"就当时的话各种事业单位发的"},{"start":1109.42,"end":1113.44,"text":"就就他甚至比这个有一个各种工业单位"},{"start":1113.44,"end":1115.98,"text":"那些事业单位那些文件还要长篇大论"},{"start":1115.98,"end":1116.82,"text":"还要空洞"},{"start":1116.82,"end":1117.72,"text":"还有空发"},{"start":1117.72,"end":1118.52,"text":"这说明什么"},{"start":1118.52,"end":1120.77,"text":"他已经被招安了对吧"},{"start":1120.77,"end":1122.29,"text":"你们可以翻一翻他前面的动态"},{"start":1122.29,"end":1123.64,"text":"各种东西对吧"},{"start":1123.64,"end":1125.24,"text":"他要么要么就是狠骂佐伊"},{"start":1125.24,"end":1125.92,"text":"要么就是怎么着"},{"start":1125.92,"end":1126.5,"text":"然后对吧"},{"start":1126.5,"end":1129.98,"text":"这已经充分的证明他已经被招安了这个事实"},{"start":1130.38,"end":1131.7,"text":"但是我还是想说"},{"start":1131.7,"end":1134.06,"text":"未明子就是个畜生草的呀"},{"start":1134.06,"end":1137.02,"text":"哎呀我真的我真的很想骂他"},{"start":1137.02,"end":1138.14,"text":"是的没错"},{"start":1138.14,"end":1140.54,"text":"但要不是他他有个组织啊"},{"start":1140.54,"end":1141.24,"text":"我跟你讲"},{"start":1141.24,"end":1143.34,"text":"虽然说我们打狗都要看主人呢"},{"start":1143.34,"end":1145.27,"text":"哎这是他嗯"},{"start":1145.27,"end":1148.67,"text":"这还只是他短短前面的两段话的意思而已"},{"start":1148.67,"end":1152.39,"text":"那么后那么后面第三段呢啊他说什么呢"},{"start":1152.39,"end":1154.54,"text":"我们从法务咨询实"}],"source":"subtitle"}
