{
  "bvid": "BV16r4y1w7oY",
  "page": 1,
  "source": "subtitle-cc",
  "language": "zh-CN",
  "model": null,
  "content_sha256": "a64344cb1ab866d7399df6e968091bf63ba3332c3944f1ef2967d23a9a3b7751",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 2040,
      "end_ms": 4540,
      "text": "我们要聊的下一个问题"
    },
    {
      "ordinal": 1,
      "start_ms": 5040,
      "end_ms": 7980,
      "text": "是科学主义和神秘主义之间的"
    },
    {
      "ordinal": 2,
      "start_ms": 8039,
      "end_ms": 9440,
      "text": "这么一个对立"
    },
    {
      "ordinal": 3,
      "start_ms": 10160,
      "end_ms": 12280,
      "text": "在我国，科学主义"
    },
    {
      "ordinal": 4,
      "start_ms": 12320,
      "end_ms": 13570,
      "text": "最明显的就是"
    },
    {
      "ordinal": 5,
      "start_ms": 14800,
      "end_ms": 16840,
      "text": "很多人会支持转基因"
    },
    {
      "ordinal": 6,
      "start_ms": 16840,
      "end_ms": 20440,
      "text": "会支持现代医学"
    },
    {
      "ordinal": 7,
      "start_ms": 20440,
      "end_ms": 23800,
      "text": "凡事都要通过数理、物理学"
    },
    {
      "ordinal": 8,
      "start_ms": 23800,
      "end_ms": 25760,
      "text": "生物学、医学的分析"
    },
    {
      "ordinal": 9,
      "start_ms": 25760,
      "end_ms": 27800,
      "text": "才能得到所谓科学的答案"
    },
    {
      "ordinal": 10,
      "start_ms": 28200,
      "end_ms": 29800,
      "text": "这就是【科学主义】"
    },
    {
      "ordinal": 11,
      "start_ms": 30100,
      "end_ms": 31270,
      "text": "那么"
    },
    {
      "ordinal": 12,
      "start_ms": 31680,
      "end_ms": 34360,
      "text": "它最终主张的是对整个自然界"
    },
    {
      "ordinal": 13,
      "start_ms": 34360,
      "end_ms": 37960,
      "text": "包括人类社会、人的精神和意识"
    },
    {
      "ordinal": 14,
      "start_ms": 37960,
      "end_ms": 39520,
      "text": "进行所谓的祛魅"
    },
    {
      "ordinal": 15,
      "start_ms": 39520,
      "end_ms": 40500,
      "text": "那么祛魅"
    },
    {
      "ordinal": 16,
      "start_ms": 40500,
      "end_ms": 43400,
      "text": "大体就是把它还原成一些基本的"
    },
    {
      "ordinal": 17,
      "start_ms": 43720,
      "end_ms": 45520,
      "text": "统计学意义上的"
    },
    {
      "ordinal": 18,
      "start_ms": 45680,
      "end_ms": 48000,
      "text": "甚至就是一些决定论意义上的"
    },
    {
      "ordinal": 19,
      "start_ms": 49120,
      "end_ms": 51280,
      "text": "庸俗决定论意义上的一些"
    },
    {
      "ordinal": 20,
      "start_ms": 52400,
      "end_ms": 53000,
      "text": "“定律”"
    },
    {
      "ordinal": 21,
      "start_ms": 53000,
      "end_ms": 54360,
      "text": "直接把这些现象"
    },
    {
      "ordinal": 22,
      "start_ms": 54400,
      "end_ms": 56640,
      "text": "都还原成具体的一些"
    },
    {
      "ordinal": 23,
      "start_ms": 56680,
      "end_ms": 58160,
      "text": "数学、物理学定律"
    },
    {
      "ordinal": 24,
      "start_ms": 58960,
      "end_ms": 60920,
      "text": "那么它的反题就是【神秘主义】"
    },
    {
      "ordinal": 25,
      "start_ms": 61400,
      "end_ms": 63800,
      "text": "神秘主义它一般就是"
    },
    {
      "ordinal": 26,
      "start_ms": 63840,
      "end_ms": 64680,
      "text": "在生活当中"
    },
    {
      "ordinal": 27,
      "start_ms": 64680,
      "end_ms": 66560,
      "text": "就体现为一个“中药吹”"
    },
    {
      "ordinal": 28,
      "start_ms": 66680,
      "end_ms": 68130,
      "text": "还有一些就是"
    },
    {
      "ordinal": 29,
      "start_ms": 68400,
      "end_ms": 70520,
      "text": "对于转基因的一种"
    },
    {
      "ordinal": 30,
      "start_ms": 71240,
      "end_ms": 72600,
      "text": "恐慌式的反对"
    },
    {
      "ordinal": 31,
      "start_ms": 72600,
      "end_ms": 73920,
      "text": "这个代表人物是谁"
    },
    {
      "ordinal": 32,
      "start_ms": 73920,
      "end_ms": 75360,
      "text": "我就不说了啊"
    },
    {
      "ordinal": 33,
      "start_ms": 75680,
      "end_ms": 77720,
      "text": "然后它最终要追求的"
    },
    {
      "ordinal": 34,
      "start_ms": 77720,
      "end_ms": 80380,
      "text": "实际上是对于生命力的一个"
    },
    {
      "ordinal": 35,
      "start_ms": 80380,
      "end_ms": 81800,
      "text": "重新的“赋魅”"
    },
    {
      "ordinal": 36,
      "start_ms": 82130,
      "end_ms": 86440,
      "text": "就是那个……被科学描述为"
    },
    {
      "ordinal": 37,
      "start_ms": 86440,
      "end_ms": 89480,
      "text": "冷冰冰的机械过程的生命"
    },
    {
      "ordinal": 38,
      "start_ms": 89800,
      "end_ms": 91840,
      "text": "在神秘主义者那边看来"
    },
    {
      "ordinal": 39,
      "start_ms": 91840,
      "end_ms": 93200,
      "text": "“不应该是这样的”"
    },
    {
      "ordinal": 40,
      "start_ms": 93200,
      "end_ms": 94240,
      "text": "“我的生命”"
    },
    {
      "ordinal": 41,
      "start_ms": 94240,
      "end_ms": 96040,
      "text": "特别是中老年人"
    },
    {
      "ordinal": 42,
      "start_ms": 96360,
      "end_ms": 98000,
      "text": "特别是买保健品的"
    },
    {
      "ordinal": 43,
      "start_ms": 98000,
      "end_ms": 100360,
      "text": "他们就觉得买了这个东西就可以"
    },
    {
      "ordinal": 44,
      "start_ms": 100600,
      "end_ms": 101640,
      "text": "跳跃性地"
    },
    {
      "ordinal": 45,
      "start_ms": 101680,
      "end_ms": 103680,
      "text": "跨越性地、超越地"
    },
    {
      "ordinal": 46,
      "start_ms": 104320,
      "end_ms": 106120,
      "text": "重新恢复自己的生命力"
    },
    {
      "ordinal": 47,
      "start_ms": 106120,
      "end_ms": 107720,
      "text": "特别是延长自己的寿命"
    },
    {
      "ordinal": 48,
      "start_ms": 107760,
      "end_ms": 110840,
      "text": "提高自己的生活质量"
    },
    {
      "ordinal": 49,
      "start_ms": 111650,
      "end_ms": 114080,
      "text": "这是它的反题就是神秘主义"
    },
    {
      "ordinal": 50,
      "start_ms": 116040,
      "end_ms": 119400,
      "text": "对于这两种思潮的这种对立"
    },
    {
      "ordinal": 51,
      "start_ms": 119400,
      "end_ms": 121560,
      "text": "其实有一个庸俗的合题"
    },
    {
      "ordinal": 52,
      "start_ms": 121560,
      "end_ms": 123000,
      "text": "那就是【新世纪运动】"
    },
    {
      "ordinal": 53,
      "start_ms": 123000,
      "end_ms": 125160,
      "text": "或者就是所谓的【后人类运动】"
    },
    {
      "ordinal": 54,
      "start_ms": 126000,
      "end_ms": 127320,
      "text": "它实际上就是用科学"
    },
    {
      "ordinal": 55,
      "start_ms": 127320,
      "end_ms": 130120,
      "text": "来描绘一种神秘主义的图景"
    },
    {
      "ordinal": 56,
      "start_ms": 130160,
      "end_ms": 132080,
      "text": "比如说“量子佛学”"
    },
    {
      "ordinal": 57,
      "start_ms": 132080,
      "end_ms": 134480,
      "text": "用量子力学来去解释"
    },
    {
      "ordinal": 58,
      "start_ms": 134800,
      "end_ms": 137280,
      "text": "佛教里面的“神通”、“禅定”"
    },
    {
      "ordinal": 59,
      "start_ms": 137320,
      "end_ms": 140560,
      "text": "还有说是用生物学"
    },
    {
      "ordinal": 60,
      "start_ms": 141000,
      "end_ms": 144120,
      "text": "还有竟然会有一种“分子业力学”"
    },
    {
      "ordinal": 61,
      "start_ms": 144120,
      "end_ms": 145560,
      "text": "来描绘"
    },
    {
      "ordinal": 62,
      "start_ms": 145600,
      "end_ms": 146160,
      "text": "解释"
    },
    {
      "ordinal": 63,
      "start_ms": 146280,
      "end_ms": 147120,
      "text": "比如说"
    },
    {
      "ordinal": 64,
      "start_ms": 147320,
      "end_ms": 149880,
      "text": "人体在后人类时代"
    },
    {
      "ordinal": 65,
      "start_ms": 149880,
      "end_ms": 152280,
      "text": "你的意识能够获得怎样在这个"
    },
    {
      "ordinal": 66,
      "start_ms": 152280,
      "end_ms": 152880,
      "text": "服务器里面"
    },
    {
      "ordinal": 67,
      "start_ms": 152880,
      "end_ms": 155240,
      "text": "获得怎样的一种超越性的状态"
    },
    {
      "ordinal": 68,
      "start_ms": 155280,
      "end_ms": 157040,
      "text": "灵体的那样一种状态"
    },
    {
      "ordinal": 69,
      "start_ms": 157200,
      "end_ms": 160600,
      "text": "这都是新世纪运动和后人类主义"
    },
    {
      "ordinal": 70,
      "start_ms": 160640,
      "end_ms": 163760,
      "text": "它所提供的虚假的合题"
    },
    {
      "ordinal": 71,
      "start_ms": 163760,
      "end_ms": 164920,
      "text": "那么它真正的合题"
    },
    {
      "ordinal": 72,
      "start_ms": 165000,
      "end_ms": 167040,
      "text": "其实还是科学主义本身"
    },
    {
      "ordinal": 73,
      "start_ms": 167080,
      "end_ms": 168040,
      "text": "为什么科学主义"
    },
    {
      "ordinal": 74,
      "start_ms": 168040,
      "end_ms": 169000,
      "text": "“会有这么一个"
    },
    {
      "ordinal": 75,
      "start_ms": 169000,
      "end_ms": 170120,
      "text": "神秘主义的对立面？”"
    },
    {
      "ordinal": 76,
      "start_ms": 170160,
      "end_ms": 171040,
      "text": "是因为科学主义"
    },
    {
      "ordinal": 77,
      "start_ms": 171040,
      "end_ms": 173080,
      "text": "实际上它本身是一种【信仰】"
    },
    {
      "ordinal": 78,
      "start_ms": 173800,
      "end_ms": 175000,
      "text": "就像普朗克在一本书"
    },
    {
      "ordinal": 79,
      "start_ms": 175000,
      "end_ms": 177600,
      "text": "叫《科学何去何从》里面说过"
    },
    {
      "ordinal": 80,
      "start_ms": 178200,
      "end_ms": 180160,
      "text": "很经典的一句话叫“科学"
    },
    {
      "ordinal": 81,
      "start_ms": 180280,
      "end_ms": 181400,
      "text": "你要学习科学"
    },
    {
      "ordinal": 82,
      "start_ms": 181440,
      "end_ms": 182080,
      "text": "研究科学"
    },
    {
      "ordinal": 83,
      "start_ms": 182080,
      "end_ms": 183600,
      "text": "“你必须有信仰！”"
    },
    {
      "ordinal": 84,
      "start_ms": 183600,
      "end_ms": 185520,
      "text": "You must have faith！"
    },
    {
      "ordinal": 85,
      "start_ms": 185520,
      "end_ms": 186920,
      "text": "“你必须有信仰”"
    },
    {
      "ordinal": 86,
      "start_ms": 187640,
      "end_ms": 188520,
      "text": "但是这种信仰"
    },
    {
      "ordinal": 87,
      "start_ms": 188560,
      "end_ms": 190600,
      "text": "并不是对那种超越性的"
    },
    {
      "ordinal": 88,
      "start_ms": 190640,
      "end_ms": 193200,
      "text": "跳跃的、断裂的那种"
    },
    {
      "ordinal": 89,
      "start_ms": 193440,
      "end_ms": 194640,
      "text": "“奇迹”的信仰"
    },
    {
      "ordinal": 90,
      "start_ms": 194640,
      "end_ms": 199000,
      "text": "而是对于【因果法则】支配之下的"
    },
    {
      "ordinal": 91,
      "start_ms": 199000,
      "end_ms": 201800,
      "text": "一种【普遍定律】"
    },
    {
      "ordinal": 92,
      "start_ms": 202360,
      "end_ms": 203760,
      "text": "普遍的真理的信仰"
    },
    {
      "ordinal": 93,
      "start_ms": 203760,
      "end_ms": 204880,
      "text": "这种普遍的真理"
    },
    {
      "ordinal": 94,
      "start_ms": 204880,
      "end_ms": 206280,
      "text": "是可以用数理逻辑"
    },
    {
      "ordinal": 95,
      "start_ms": 206280,
      "end_ms": 208480,
      "text": "数学和逻辑学去讨论的"
    }
  ],
  "text": "我们要聊的下一个问题\n是科学主义和神秘主义之间的\n这么一个对立\n在我国，科学主义\n最明显的就是\n很多人会支持转基因\n会支持现代医学\n凡事都要通过数理、物理学\n生物学、医学的分析\n才能得到所谓科学的答案\n这就是【科学主义】\n那么\n它最终主张的是对整个自然界\n包括人类社会、人的精神和意识\n进行所谓的祛魅\n那么祛魅\n大体就是把它还原成一些基本的\n统计学意义上的\n甚至就是一些决定论意义上的\n庸俗决定论意义上的一些\n“定律”\n直接把这些现象\n都还原成具体的一些\n数学、物理学定律\n那么它的反题就是【神秘主义】\n神秘主义它一般就是\n在生活当中\n就体现为一个“中药吹”\n还有一些就是\n对于转基因的一种\n恐慌式的反对\n这个代表人物是谁\n我就不说了啊\n然后它最终要追求的\n实际上是对于生命力的一个\n重新的“赋魅”\n就是那个……被科学描述为\n冷冰冰的机械过程的生命\n在神秘主义者那边看来\n“不应该是这样的”\n“我的生命”\n特别是中老年人\n特别是买保健品的\n他们就觉得买了这个东西就可以\n跳跃性地\n跨越性地、超越地\n重新恢复自己的生命力\n特别是延长自己的寿命\n提高自己的生活质量\n这是它的反题就是神秘主义\n对于这两种思潮的这种对立\n其实有一个庸俗的合题\n那就是【新世纪运动】\n或者就是所谓的【后人类运动】\n它实际上就是用科学\n来描绘一种神秘主义的图景\n比如说“量子佛学”\n用量子力学来去解释\n佛教里面的“神通”、“禅定”\n还有说是用生物学\n还有竟然会有一种“分子业力学”\n来描绘\n解释\n比如说\n人体在后人类时代\n你的意识能够获得怎样在这个\n服务器里面\n获得怎样的一种超越性的状态\n灵体的那样一种状态\n这都是新世纪运动和后人类主义\n它所提供的虚假的合题\n那么它真正的合题\n其实还是科学主义本身\n为什么科学主义\n“会有这么一个\n神秘主义的对立面？”\n是因为科学主义\n实际上它本身是一种【信仰】\n就像普朗克在一本书\n叫《科学何去何从》里面说过\n很经典的一句话叫“科学\n你要学习科学\n研究科学\n“你必须有信仰！”\nYou must have faith！\n“你必须有信仰”\n但是这种信仰\n并不是对那种超越性的\n跳跃的、断裂的那种\n“奇迹”的信仰\n而是对于【因果法则】支配之下的\n一种【普遍定律】\n普遍的真理的信仰\n这种普遍的真理\n是可以用数理逻辑\n数学和逻辑学去讨论的",
  "timing_issue": null
}
