{
  "bvid": "BV1KA411j7BY",
  "page": 1,
  "source": "subtitle-cc",
  "language": "zh-CN",
  "model": null,
  "content_sha256": "cc4425d723ea6a7391091c299c403f59ad3a48cd72afc88fc59e90b6dba13351",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 1560,
      "end_ms": 2560,
      "text": "我们今天来讲"
    },
    {
      "ordinal": 1,
      "start_ms": 3880,
      "end_ms": 5600,
      "text": "辩证法的第一个小专题"
    },
    {
      "ordinal": 2,
      "start_ms": 5760,
      "end_ms": 8560,
      "text": "那就是非常有名的一个"
    },
    {
      "ordinal": 3,
      "start_ms": 8560,
      "end_ms": 9440,
      "text": "鸡生蛋生鸡的问题"
    },
    {
      "ordinal": 4,
      "start_ms": 10040,
      "end_ms": 11000,
      "text": "我直接说正题"
    },
    {
      "ordinal": 5,
      "start_ms": 11040,
      "end_ms": 12520,
      "text": "当然就是鸡生蛋"
    },
    {
      "ordinal": 6,
      "start_ms": 12760,
      "end_ms": 13680,
      "text": "是鸡把蛋生出来的"
    },
    {
      "ordinal": 7,
      "start_ms": 13680,
      "end_ms": 14880,
      "text": "反题是蛋生鸡"
    },
    {
      "ordinal": 8,
      "start_ms": 15960,
      "end_ms": 17280,
      "text": "是蛋把鸡生出来的"
    },
    {
      "ordinal": 9,
      "start_ms": 17760,
      "end_ms": 20440,
      "text": "那么错误的合题"
    },
    {
      "ordinal": 10,
      "start_ms": 20600,
      "end_ms": 22240,
      "text": "这个就是庸俗的辩证法"
    },
    {
      "ordinal": 11,
      "start_ms": 22240,
      "end_ms": 22960,
      "text": "错误的合题"
    },
    {
      "ordinal": 12,
      "start_ms": 23000,
      "end_ms": 23480,
      "text": "就是"
    },
    {
      "ordinal": 13,
      "start_ms": 23920,
      "end_ms": 25040,
      "text": "“既不是鸡生蛋”"
    },
    {
      "ordinal": 14,
      "start_ms": 25080,
      "end_ms": 25840,
      "text": "“也不是蛋生鸡”"
    },
    {
      "ordinal": 15,
      "start_ms": 25840,
      "end_ms": 27080,
      "text": "而是两个加起来"
    },
    {
      "ordinal": 16,
      "start_ms": 27120,
      "end_ms": 29360,
      "text": "加起来就变成“鸡生蛋生鸡生……”"
    },
    {
      "ordinal": 17,
      "start_ms": 29360,
      "end_ms": 30200,
      "text": "鸡生蛋生"
    },
    {
      "ordinal": 18,
      "start_ms": 30200,
      "end_ms": 31960,
      "text": "鸡生蛋生……就无穷了"
    },
    {
      "ordinal": 19,
      "start_ms": 32000,
      "end_ms": 33480,
      "text": "子子孙孙无穷匮也"
    },
    {
      "ordinal": 20,
      "start_ms": 33480,
      "end_ms": 34960,
      "text": "互相循环"
    },
    {
      "ordinal": 21,
      "start_ms": 35040,
      "end_ms": 37040,
      "text": "这是标准的整体主义的理解方式"
    },
    {
      "ordinal": 22,
      "start_ms": 37040,
      "end_ms": 38280,
      "text": "就是彻底错误的"
    },
    {
      "ordinal": 23,
      "start_ms": 38520,
      "end_ms": 39360,
      "text": "正确的合题很简单"
    },
    {
      "ordinal": 24,
      "start_ms": 40600,
      "end_ms": 41560,
      "text": "就是鸡生蛋"
    },
    {
      "ordinal": 25,
      "start_ms": 41600,
      "end_ms": 43200,
      "text": "合题还是“鸡生蛋”"
    },
    {
      "ordinal": 26,
      "start_ms": 44160,
      "end_ms": 45280,
      "text": "问题就是说"
    },
    {
      "ordinal": 27,
      "start_ms": 45560,
      "end_ms": 47400,
      "text": "我们所有的辩证法"
    },
    {
      "ordinal": 28,
      "start_ms": 47400,
      "end_ms": 49840,
      "text": "Dialectic"
    },
    {
      "ordinal": 29,
      "start_ms": 51280,
      "end_ms": 53120,
      "text": "都包含一个重音的转换"
    },
    {
      "ordinal": 30,
      "start_ms": 53320,
      "end_ms": 54760,
      "text": "在我们第一句话里面"
    },
    {
      "ordinal": 31,
      "start_ms": 54800,
      "end_ms": 58200,
      "text": "正题里面是【鸡】生蛋，重音在【鸡】上面"
    },
    {
      "ordinal": 32,
      "start_ms": 58520,
      "end_ms": 60440,
      "text": "第二个反题是【蛋】生鸡"
    },
    {
      "ordinal": 33,
      "start_ms": 60480,
      "end_ms": 61880,
      "text": "重音在【蛋】上面"
    },
    {
      "ordinal": 34,
      "start_ms": 61960,
      "end_ms": 63360,
      "text": "它在错误的合题里面"
    },
    {
      "ordinal": 35,
      "start_ms": 63360,
      "end_ms": 65160,
      "text": "是【鸡】生【蛋】生"
    },
    {
      "ordinal": 36,
      "start_ms": 65200,
      "end_ms": 66520,
      "text": "【鸡】生【蛋】生"
    },
    {
      "ordinal": 37,
      "start_ms": 66520,
      "end_ms": 67160,
      "text": "它的重音"
    },
    {
      "ordinal": 38,
      "start_ms": 67200,
      "end_ms": 69520,
      "text": "总是在这两个所谓的主体上面"
    },
    {
      "ordinal": 39,
      "start_ms": 70080,
      "end_ms": 72640,
      "text": "辩证法的合题就是"
    },
    {
      "ordinal": 40,
      "start_ms": 73160,
      "end_ms": 74960,
      "text": "告诉你这个否定"
    },
    {
      "ordinal": 41,
      "start_ms": 74960,
      "end_ms": 76120,
      "text": "是一个虚假的否定"
    },
    {
      "ordinal": 42,
      "start_ms": 78160,
      "end_ms": 79680,
      "text": "它正题本身就包含了"
    },
    {
      "ordinal": 43,
      "start_ms": 79720,
      "end_ms": 80920,
      "text": "对它自身的否定"
    },
    {
      "ordinal": 44,
      "start_ms": 81960,
      "end_ms": 82800,
      "text": "了解吗"
    },
    {
      "ordinal": 45,
      "start_ms": 83040,
      "end_ms": 85200,
      "text": "也就是说所谓的【鸡】生蛋"
    },
    {
      "ordinal": 46,
      "start_ms": 85800,
      "end_ms": 88720,
      "text": "我们把重音从【鸡】"
    },
    {
      "ordinal": 47,
      "start_ms": 88760,
      "end_ms": 90040,
      "text": "或者从【蛋】上面"
    },
    {
      "ordinal": 48,
      "start_ms": 90040,
      "end_ms": 91520,
      "text": "挪到这个【生】上面去"
    },
    {
      "ordinal": 49,
      "start_ms": 91560,
      "end_ms": 92760,
      "text": "我们就能看到"
    },
    {
      "ordinal": 50,
      "start_ms": 93560,
      "end_ms": 95520,
      "text": "这个辩题它内在的问题"
    },
    {
      "ordinal": 51,
      "start_ms": 96200,
      "end_ms": 99000,
      "text": "如果我们把重音放到【生】上面"
    },
    {
      "ordinal": 52,
      "start_ms": 99000,
      "end_ms": 101080,
      "text": "你会发现鸡【生】蛋"
    },
    {
      "ordinal": 53,
      "start_ms": 101640,
      "end_ms": 103800,
      "text": "你就开始去思考这个【生】"
    },
    {
      "ordinal": 54,
      "start_ms": 106840,
      "end_ms": 107880,
      "text": "这什么叫鸡“生”蛋"
    },
    {
      "ordinal": 55,
      "start_ms": 108320,
      "end_ms": 109440,
      "text": "你应该去想想"
    },
    {
      "ordinal": 56,
      "start_ms": 109480,
      "end_ms": 111840,
      "text": "实际上是鸡把蛋给它排出来的"
    },
    {
      "ordinal": 57,
      "start_ms": 111840,
      "end_ms": 112920,
      "text": "创造出来的"
    },
    {
      "ordinal": 58,
      "start_ms": 113400,
      "end_ms": 114240,
      "text": "鸡生了蛋之后"
    },
    {
      "ordinal": 59,
      "start_ms": 114240,
      "end_ms": 114920,
      "text": "鸡还是鸡"
    },
    {
      "ordinal": 60,
      "start_ms": 114920,
      "end_ms": 115600,
      "text": "对不对"
    },
    {
      "ordinal": 61,
      "start_ms": 116120,
      "end_ms": 118120,
      "text": "它自己没有本质性的变化"
    },
    {
      "ordinal": 62,
      "start_ms": 118280,
      "end_ms": 120120,
      "text": "所以“生”是一个创造者"
    },
    {
      "ordinal": 63,
      "start_ms": 120120,
      "end_ms": 121880,
      "text": "和被创造者之间的关系"
    },
    {
      "ordinal": 64,
      "start_ms": 121880,
      "end_ms": 122920,
      "text": "也就是create"
    },
    {
      "ordinal": 65,
      "start_ms": 123200,
      "end_ms": 126160,
      "text": "那么你把重音移到“生”上之后"
    },
    {
      "ordinal": 66,
      "start_ms": 126160,
      "end_ms": 127440,
      "text": "你再去看所谓的反题"
    },
    {
      "ordinal": 67,
      "start_ms": 127440,
      "end_ms": 128970,
      "text": "就是“蛋生鸡”里面"
    },
    {
      "ordinal": 68,
      "start_ms": 128970,
      "end_ms": 130520,
      "text": "那个蛋生鸡"
    },
    {
      "ordinal": 69,
      "start_ms": 130639,
      "end_ms": 131520,
      "text": "它不是"
    },
    {
      "ordinal": 70,
      "start_ms": 132520,
      "end_ms": 134760,
      "text": "它不是说蛋create"
    },
    {
      "ordinal": 71,
      "start_ms": 137720,
      "end_ms": 138320,
      "text": "你知道吗"
    },
    {
      "ordinal": 72,
      "start_ms": 138680,
      "end_ms": 140240,
      "text": "不是蛋创造了一个鸡儿"
    },
    {
      "ordinal": 73,
      "start_ms": 140280,
      "end_ms": 141040,
      "text": "是“become”"
    },
    {
      "ordinal": 74,
      "start_ms": 141040,
      "end_ms": 142520,
      "text": "蛋“变成”了鸡"
    },
    {
      "ordinal": 75,
      "start_ms": 143440,
      "end_ms": 144040,
      "text": "你了解吗"
    },
    {
      "ordinal": 76,
      "start_ms": 144040,
      "end_ms": 145280,
      "text": "所以这样的话"
    },
    {
      "ordinal": 77,
      "start_ms": 145280,
      "end_ms": 146480,
      "text": "你把重音移到"
    },
    {
      "ordinal": 78,
      "start_ms": 149160,
      "end_ms": 150960,
      "text": "正题的中间那个字"
    },
    {
      "ordinal": 79,
      "start_ms": 151200,
      "end_ms": 151960,
      "text": "它在反题里面"
    },
    {
      "ordinal": 80,
      "start_ms": 151960,
      "end_ms": 154320,
      "text": "它也没有被重音"
    },
    {
      "ordinal": 81,
      "start_ms": 154360,
      "end_ms": 156560,
      "text": "没有被重视"
    },
    {
      "ordinal": 82,
      "start_ms": 158240,
      "end_ms": 160400,
      "text": "正题和反题当中的差异"
    },
    {
      "ordinal": 83,
      "start_ms": 160400,
      "end_ms": 164000,
      "text": "被虚假的合题所掩盖了"
    },
    {
      "ordinal": 84,
      "start_ms": 164000,
      "end_ms": 167720,
      "text": "比如“鸡生蛋生鸡生……”这个“生”不停在重复"
    },
    {
      "ordinal": 85,
      "start_ms": 167720,
      "end_ms": 170200,
      "text": "我们误以为它是同一种“生”"
    },
    {
      "ordinal": 86,
      "start_ms": 170520,
      "end_ms": 171120,
      "text": "了解吗"
    },
    {
      "ordinal": 87,
      "start_ms": 171120,
      "end_ms": 172160,
      "text": "这就是虚假的辩证法"
    },
    {
      "ordinal": 88,
      "start_ms": 172160,
      "end_ms": 173920,
      "text": "它把差异给它抹掉了"
    },
    {
      "ordinal": 89,
      "start_ms": 175240,
      "end_ms": 176240,
      "text": "真正的辩证法"
    },
    {
      "ordinal": 90,
      "start_ms": 176240,
      "end_ms": 178200,
      "text": "它是要把差异凸显出来"
    },
    {
      "ordinal": 91,
      "start_ms": 178240,
      "end_ms": 179680,
      "text": "鸡生蛋"
    },
    {
      "ordinal": 92,
      "start_ms": 179960,
      "end_ms": 180640,
      "text": "这个生"
    },
    {
      "ordinal": 93,
      "start_ms": 181160,
      "end_ms": 183440,
      "text": "就意味着鸡和蛋"
    },
    {
      "ordinal": 94,
      "start_ms": 183440,
      "end_ms": 184000,
      "text": "它是"
    },
    {
      "ordinal": 95,
      "start_ms": 184400,
      "end_ms": 185880,
      "text": "我把蛋生出来之后"
    },
    {
      "ordinal": 96,
      "start_ms": 185920,
      "end_ms": 186920,
      "text": "我有两个东西"
    },
    {
      "ordinal": 97,
      "start_ms": 186920,
      "end_ms": 187720,
      "text": "有一个鸡"
    },
    {
      "ordinal": 98,
      "start_ms": 187760,
      "end_ms": 188160,
      "text": "一个蛋"
    },
    {
      "ordinal": 99,
      "start_ms": 188160,
      "end_ms": 189080,
      "text": "两个东西"
    },
    {
      "ordinal": 100,
      "start_ms": 189120,
      "end_ms": 191960,
      "text": "但是蛋生鸡它是蛋变成了鸡"
    },
    {
      "ordinal": 101,
      "start_ms": 192160,
      "end_ms": 193560,
      "text": "之前的蛋就不存在了"
    },
    {
      "ordinal": 102,
      "start_ms": 193680,
      "end_ms": 194880,
      "text": "或者说我们可以说"
    },
    {
      "ordinal": 103,
      "start_ms": 194880,
      "end_ms": 195560,
      "text": "所谓的蛋"
    },
    {
      "ordinal": 104,
      "start_ms": 195560,
      "end_ms": 197160,
      "text": "只是鸡的一个存在状态"
    },
    {
      "ordinal": 105,
      "start_ms": 197160,
      "end_ms": 199080,
      "text": "是一开始的存在状态"
    },
    {
      "ordinal": 106,
      "start_ms": 199080,
      "end_ms": 201000,
      "text": "所以它的合题是"
    },
    {
      "ordinal": 107,
      "start_ms": 201280,
      "end_ms": 203280,
      "text": "是鸡生蛋"
    },
    {
      "ordinal": 108,
      "start_ms": 203320,
      "end_ms": 203760,
      "text": "了解了吗？"
    }
  ],
  "text": "我们今天来讲\n辩证法的第一个小专题\n那就是非常有名的一个\n鸡生蛋生鸡的问题\n我直接说正题\n当然就是鸡生蛋\n是鸡把蛋生出来的\n反题是蛋生鸡\n是蛋把鸡生出来的\n那么错误的合题\n这个就是庸俗的辩证法\n错误的合题\n就是\n“既不是鸡生蛋”\n“也不是蛋生鸡”\n而是两个加起来\n加起来就变成“鸡生蛋生鸡生……”\n鸡生蛋生\n鸡生蛋生……就无穷了\n子子孙孙无穷匮也\n互相循环\n这是标准的整体主义的理解方式\n就是彻底错误的\n正确的合题很简单\n就是鸡生蛋\n合题还是“鸡生蛋”\n问题就是说\n我们所有的辩证法\nDialectic\n都包含一个重音的转换\n在我们第一句话里面\n正题里面是【鸡】生蛋，重音在【鸡】上面\n第二个反题是【蛋】生鸡\n重音在【蛋】上面\n它在错误的合题里面\n是【鸡】生【蛋】生\n【鸡】生【蛋】生\n它的重音\n总是在这两个所谓的主体上面\n辩证法的合题就是\n告诉你这个否定\n是一个虚假的否定\n它正题本身就包含了\n对它自身的否定\n了解吗\n也就是说所谓的【鸡】生蛋\n我们把重音从【鸡】\n或者从【蛋】上面\n挪到这个【生】上面去\n我们就能看到\n这个辩题它内在的问题\n如果我们把重音放到【生】上面\n你会发现鸡【生】蛋\n你就开始去思考这个【生】\n这什么叫鸡“生”蛋\n你应该去想想\n实际上是鸡把蛋给它排出来的\n创造出来的\n鸡生了蛋之后\n鸡还是鸡\n对不对\n它自己没有本质性的变化\n所以“生”是一个创造者\n和被创造者之间的关系\n也就是create\n那么你把重音移到“生”上之后\n你再去看所谓的反题\n就是“蛋生鸡”里面\n那个蛋生鸡\n它不是\n它不是说蛋create\n你知道吗\n不是蛋创造了一个鸡儿\n是“become”\n蛋“变成”了鸡\n你了解吗\n所以这样的话\n你把重音移到\n正题的中间那个字\n它在反题里面\n它也没有被重音\n没有被重视\n正题和反题当中的差异\n被虚假的合题所掩盖了\n比如“鸡生蛋生鸡生……”这个“生”不停在重复\n我们误以为它是同一种“生”\n了解吗\n这就是虚假的辩证法\n它把差异给它抹掉了\n真正的辩证法\n它是要把差异凸显出来\n鸡生蛋\n这个生\n就意味着鸡和蛋\n它是\n我把蛋生出来之后\n我有两个东西\n有一个鸡\n一个蛋\n两个东西\n但是蛋生鸡它是蛋变成了鸡\n之前的蛋就不存在了\n或者说我们可以说\n所谓的蛋\n只是鸡的一个存在状态\n是一开始的存在状态\n所以它的合题是\n是鸡生蛋\n了解了吗？",
  "timing_issue": null
}
