2467.98,"end":2470.22,"text":"他会有他的方法"},{"start":2471.23,"end":2472.77,"text":"有他的分类学"},{"start":2472.77,"end":2476.83,"text":"这个分类学不来自于他直接诞生那个总体"},{"start":2477.67,"end":2484.39,"text":"他他的这个哲学在这样作为中介的智慧的哲学所诞生出的这些辩证法"},{"start":2484.39,"end":2486.365,"text":"唯物辩证法"},{"start":2491.72,"end":2494.06,"text":"那辩证法再生成一套世界观"},{"start":2497.96,"end":2501.72,"text":"它会生成它新的总体与报表"},{"start":2503.12,"end":2506.4,"text":"这个总体是一个竞争性的总体"},{"start":2512.28,"end":2513.62,"text":"是一个竞争性总体"},{"start":2513.62,"end":2515.92,"text":"这个竞竞争性的总体是什么"},{"start":2515.92,"end":2517.24,"text":"历史的新的总体"},{"start":2518.48,"end":2520.36,"text":"新的统统理解所有的历史意志"},{"start":2520.36,"end":2521.26,"text":"历史运动"},{"start":2526.21,"end":2529.17,"text":"我还认识这个马克主义"},{"start":2529.17,"end":2533.13,"text":"其实他经过这个历史的辩证法的运动"},{"start":2534.53,"end":2536.529,"text":"它就会变成列宁主义"},{"start":2537.009,"end":2538.169,"text":"在这里作为中介"},{"start":2538.169,"end":2539.169,"text":"就这个东西啊"},{"start":2539.169,"end":2541.569,"text":"然后这里是行动啊"},{"start":2543.2,"end":2551.9,"text":"这个就是新的总体很NEO在历史的现实当中生成出来的新的总体"},{"start":2551.9,"end":2555.16,"text":"新的历史意志的表达机制"},{"start":2555.16,"end":2557.14,"text":"表达的同一体"},{"start":2557.14,"end":2560.46,"text":"单一体总体啊"},{"start":2572.56,"end":2580.05,"text":"那在金牛这个总体又会生成出列板的无所不包的智慧光"},{"start":2580.05,"end":2582.37,"text":"又走向走向斯大林5月"},{"start":2590.56,"end":2591.68,"text":"这里是什么"},{"start":2591.68,"end":2593.28,"text":"What it is"},{"start":2597.18,"end":2598.22,"text":"斯大林主义"},{"start":2598.22,"end":2599.7,"text":"他经营这个总体是冠军"},{"start":2599.7,"end":2601.9,"text":"总体是什么"},{"start":2606.46,"end":2610.1,"text":"工业industry啊"},{"start":2610.1,"end":2613.02,"text":"每次上完课跟猜谜一样"},{"start":2615.28,"end":2618.6,"text":"作为工工业化的命令体系啊"},{"start":2624.88,"end":2625.86,"text":"那么很明显"},{"start":2625.86,"end":2630.95,"text":"一个历史的总体化并不总是采取工业的模式"},{"start":2630.95,"end":2638.55,"text":"尤其当一个工业性的总体和它在地缘边缘产生冲突的时候"},{"start":2638.55,"end":2642.75,"text":"农业国或者说石油原产地国"},{"start":2643.15,"end":2645.99,"text":"或者说他对语言有巨大的差异"},{"start":2645.99,"end":2647.83,"text":"没有办法并入的工业体系的"},{"start":2647.83,"end":2648.47,"text":"最后"},{"start":2648.47,"end":2650.39,"text":"苏联就亡在这个事上面啊"},{"start":2650.39,"end":2651.97,"text":"斯大林主义的基本范式"},{"start":2651.97,"end":2656.11,"text":"它围绕工业所建构的东方就失败"},{"start":2657.41,"end":2660.77,"text":"所以哲学带来总体主义吗"},{"start":2660.77,"end":2664.81,"text":"或者说它带来一种不可承受的恐怖吗"},{"start":2666.08,"end":2668.72,"text":"哲学作为马克思主义哲学"},{"start":2668.72,"end":2672.88,"text":"作为他的这个近代的他本身列宁主义"},{"start":2672.88,"end":2674.94,"text":"三林主义这三种变种"},{"start":2675.73,"end":2677.53,"text":"他也是有目的的"},{"start":2677.53,"end":2681.11,"text":"在以总体主义作为他的工具"},{"start":2681.11,"end":2682.35,"text":"作为他的中介"},{"start":2682.35,"end":2683.71,"text":"他是带来的总体主义"},{"start":2683.71,"end":2684.47,"text":"但他也阳性了"},{"start":2684.47,"end":2685.79,"text":"总体主义"},{"start":2689.06,"end":2690.14,"text":"很洋气的他"},{"start":2692.42,"end":2698.64,"text":"每一个都有它圣女这个剩余出来就成啊"},{"start":2698.64,"end":2700.2,"text":"就是他的地下潜规则"},{"start":2700.2,"end":2702.86,"text":"就是这种液化的腐烂的那些东西"},{"start":2702.86,"end":2705.44,"text":"他想要用工业化统治社会的一切"},{"start":2705.44,"end":2709.819,"text":"那没办法对它的工业就会变成一层夹皮"},{"start":2709.819,"end":2711.8,"text":"下面的血肉还是一模糊的"},{"start":2711.8,"end":2713.9,"text":"整个社会是运行在潜规则的"},{"start":2713.9,"end":2717.35,"text":"还有这个特务统治的那种蛮横当中"},{"start":2717.35,"end":2718.31,"text":"两个极端"},{"start":2718.31,"end":2720.15,"text":"各个模件是一切都统制"},{"start":2720.15,"end":2721.91,"text":"极度总体化"},{"start":2721.91,"end":2723.17,"text":"另外一个极端"},{"start":2723.17,"end":2725.31,"text":"所有一切东西都是好书"},{"start":2725.31,"end":2726.03,"text":"搞定你的行为"},{"start":2726.03,"end":2727.31,"text":"有无数的地下潜规则"},{"start":2727.31,"end":2728.13,"text":"你找不到人"},{"start":2728.13,"end":2730.04,"text":"怎么能不帮你搞定"},{"start":2730.36,"end":2732.7,"text":"每一个都是一个有机的单一的原胞"},{"start":2732.7,"end":2735.36,"text":"卧槽是单细胞"},{"start":2735.36,"end":2738.16,"text":"就是这孢子生命的它都不是植物性的"},{"start":2738.16,"end":2741.44,"text":"是菌菌真菌性"},{"start":2741.76,"end":2747.87,"text":"然后呢列宁主义这里也啊也会诞生它一个圣约"},{"start":2747.87,"end":2750.27,"text":"我看见他的影子啊"},{"start":2750.27,"end":2751.27,"text":"俄罗斯主义"},{"start":2751.27,"end":2752.23,"text":"看看他的影子"},{"start":2752.23,"end":2754.78,"text":"俄罗斯知识分子精英主义"},{"start":2754.78,"end":2762.23,"text":"知识分子的精英主义和这个啊派对对总体的一个差异"},{"start":2762.23,"end":2763.67,"text":"其实我们在这个上面"},{"start":2763.67,"end":2769.01,"text":"我们可以把托洛茨基主义就看成就是知识分子的精英话语"},{"start":2769.01,"end":2775.26,"text":"对于这个先锋队的议言论话语的一个建越啊"},{"start":2775.47,"end":2779.5,"text":"有一种弑父情结"},{"start":2780.4,"end":2783.16,"text":"那马克思这里也是的啊"},{"start":2783.16,"end":2785.42,"text":"马克思这里作为这个智慧"},{"start":2785.42,"end":2787.68,"text":"作为政治经济学的"},{"start":2787.84,"end":2788.94,"text":"他导向行动"},{"start":2788.94,"end":2792.029,"text":"他甩出的声音就是导向不了行动"},{"start":2792.029,"end":2793.549,"text":"停留在智慧当中"},{"start":2794.549,"end":2797.929,"text":"奥地利马克思主义者直接就成为自然界政府的阁员了"},{"start":2797.929,"end":2799.4,"text":"会有行动"},{"start":2800.04,"end":2801.6,"text":"打着这个行动的名号"},{"start":2801.6,"end":2803.52,"text":"他始终把智慧作为中介"},{"start":2803.52,"end":2806.24,"text":"他可以去抵达他各式各样的心理"},{"start":2806.24,"end":2806.88,"text":"这样"},{"start":2808.68,"end":2811.44,"text":"为哲学是带来了总体主义"},{"start":2811.44,"end":2816.31,"text":"但是他是否带来了不可承受的恐怖呢"},{"start":2816.31,"end":2818.31,"text":"在这里被指控的除了马克思主义"},{"start":2818.31,"end":2819.35,"text":"还有尼采主义"},{"start":2819.35,"end":2821.15,"text":"对不对哦"},{"start":2821.15,"end":2823.35,"text":"或者还有还有那个主义"},{"start":2832.12,"end":2837.0,"text":"知识分子认为这样的哲学适宜被终结"},{"start":2837.0,"end":2837.94,"text":"被终结掉"},{"start":2837.94,"end":2840.08,"text":"但是我认为这种指控是错误的"},{"start":2840.08,"end":2845.77,"text":"因为实际上带来恐怖的不是哲学"},{"start":2846.37,"end":2851.3,"text":"实际上使得这种恐怖或者说恐怖怎么可能就单单就会被带来"},{"start":2851.3,"end":2854.6,"text":"或者说哲学家高估了文化基因"},{"start":2854.6,"end":2857.82,"text":"高估了他这种精致的思想"},{"start":2857.82,"end":2862.61,"text":"办事或者说话语深沉的机制"},{"start":2862.61,"end":2864.17,"text":"对于整个社会动员"},{"start":2864.17,"end":2868.745,"text":"我们更确切的讲就是我的个人态度"},{"start":2875.3,"end":2877.9,"text":"作为底层报复的"},{"start":2890.28,"end":2893.52,"text":"作为底层报复和宣泄的宗教"},{"start":2895.12,"end":2900.27,"text":"实际上是并不是由哲学带来的总体主义的不可承受的程度"},{"start":2900.27,"end":2905.07,"text":"而是哲学始终没有斩断他的宗教的根源"},{"start":2905.31,"end":2908.57,"text":"这是幻觉在向下传达的时候"},{"start":2908.57,"end":2910.61,"text":"普遍传播的时候"},{"start":2910.61,"end":2915.33,"text":"它的完结在他保持自身的时候就已经完结了"},{"start":2916.85,"end":2919.17,"text":"它完结于什么宗教"},{"start":2921.9,"end":2923.34,"text":"那么宗教带来暴力"},{"start":2924.58,"end":2928.26,"text":"带来作为底层报复和宣泄的暴力"},{"start":2932.6,"end":2936.939,"text":"像尼采主义和孩子的主义并没有那么大的动员力"},{"start":2936.939,"end":2938.539,"text":"我在过程中也辩护过了"},{"start":2938.539,"end":2939.339,"text":"还有格尔哲学"},{"start":2939.339,"end":2944.459,"text":"科学理解是看的是新教的自我辩护的一个较为激进的一个体系"},{"start":2949.18,"end":2953.34,"text":"一代本身就是基督复活的记录"},{"start":2953.34,"end":2955.46,"text":"或者说是复活的基督教"},{"start":2962.74,"end":2968.86,"text":"啊都可以看成是一种基督教意义上的本真主义的反潮哲学"},{"start":2968.86,"end":2972.85,"text":"只是说面包糠把这坨屎就给它括起来了"},{"start":2973.37,"end":2980.59,"text":"把他带来的是这个德国的小战阶级的大规模恐怖排油"},{"start":2980.59,"end":2982.555,"text":"杀了数百万人马"},{"start":2984.01,"end":2985.53,"text":"二战战场上死了多少人呐"},{"start":2986.65,"end":2989.83,"text":"特别是在这个对啊"},{"start":2989.83,"end":2991.9,"text":"苏联死了2000万人"},{"start":2992.3,"end":2993.16,"text":"对不对"},{"start":2993.16,"end":2995.36,"text":"就是阶级运动"},{"start":2995.36,"end":2996.14,"text":"阶级矛盾"},{"start":2996.14,"end":2997.74,"text":"阶级冲突带来的伤亡"},{"start":2998.9,"end":3001.24,"text":"真正的总体主义"},{"start":3002.68,"end":3005.62,"text":"就是后面是苏联分的总体主义的锅"},{"start":3007.16,"end":3008.58,"text":"它运行了这么多年"},{"start":3008.58,"end":3010.12,"text":"他还有所谓的大清洗"},{"start":3010.12,"end":3011.31,"text":"这些恐怖的东西"},{"start":3011.31,"end":3014.15,"text":"大型企为什么不能把锅甩到东升教程上去"},{"start":3014.15,"end":3016.1,"text":"当然不"},{"start":3016.98,"end":3020.94,"text":"所以并不是哲学带来整体主义不可承受的词"},{"start":3020.94,"end":3025.66,"text":"而是反过来总体主义带来哲学的环节"},{"start":3025.66,"end":3030.93,"text":"而总体主义的种子或者它的土壤并不在哲学当中"},{"start":3030.93,"end":3033.41,"text":"哲学反过来它是一个永恒的"},{"start":3033.41,"end":3036.38,"text":"在试图去超越它的总体性"},{"start":3036.38,"end":3038.62,"text":"或者说哲学所把握的东西形式"},{"start":3038.62,"end":3040.46,"text":"一种不停的自我讽刺"},{"start":3041.46,"end":3043.26,"text":"你自我辨认"},{"start":3044.31,"end":3048.79,"text":"自我否弃或辨认"},{"start":3050.069,"end":3052.63,"text":"哲学不停的说话言说"},{"start":3053.03,"end":3055.69,"text":"希望通过言辞来寻获自身"},{"start":3055.69,"end":3059.83,"text":"但是呢他又发现这些话不足以代表他自己的那种生存姿态"},{"start":3059.83,"end":3060.88,"text":"他的立场"},{"start":3060.88,"end":3064.79,"text":"他是在不断的辨认他自己啊"},{"start":3064.79,"end":3066.15,"text":"倒数他自身"},{"start":3066.15,"end":3068.8,"text":"或者说通过发问呢"},{"start":3069.44,"end":3073.08,"text":"或者我们在这里说哲学是一种疑问"},{"start":3074.2,"end":3076.56,"text":"你必须有所言说"},{"start":3076.56,"end":3078.94,"text":"然后你言辩论辩论"},{"start":3078.94,"end":3082.92,"text":"这些言辞就像诗人写诗一样"},{"start":3082.92,"end":3085.95,"text":"所以哲学从来不离开"},{"start":3085.95,"end":3089.53,"text":"实则让让孩子在这里造出某种错误的真相"},{"start":3089.53,"end":3091.05,"text":"因为海德格是反哲学"},{"start":3091.05,"end":3093.789,"text":"哲所学所学"},{"start":3093.789,"end":3095.449,"text":"这和写是一样的"},{"start":3095.449,"end":3098.27,"text":"如果它是更为诗"},{"start":3098.27,"end":3099.49,"text":"是兴致来了才写"},{"start":3099.49,"end":3101.27,"text":"哲学是没有性质"},{"start":3101.27,"end":3102.59,"text":"也也要强行逼问"},{"start":3102.59,"end":3103.81,"text":"不停的逼问"},{"start":3103.81,"end":3106.33,"text":"然后语言写出来"},{"start":3106.33,"end":3109.67,"text":"然后不停的说到底这是不是我想说的到底是不是"},{"start":3109.67,"end":3113.83,"text":"这我想表达的哲学是一种说话的强迫症"},{"start":3114.95,"end":3116.42,"text":"就像我现在这样"},{"start":3116.42,"end":3118.26,"text":"我可以无止境给你们下下去"},{"start":3118.26,"end":3118.86,"text":"一个小时"},{"start":3118.86,"end":3119.26,"text":"两个小时"},{"start":3119.26,"end":3120.04,"text":"三个小时"},{"start":3120.04,"end":3122.94,"text":"但是我觉得我讲到这里也差不多了"},{"start":3122.94,"end":3125.69,"text":"让你知道什么叫做作为完结的哲学"},{"start":3125.69,"end":3127.09,"text":"哲学并没有"},{"start":3127.09,"end":3129.07,"text":"因为反哲学的存在"},{"start":3129.07,"end":3132.57,"text":"所有这些主题都叫反哲学主义啊"},{"start":3135.2,"end":3137.46,"text":"啊一堆反哲学"},{"start":3137.46,"end":3141.12,"text":"反哲学这个运动没有使得哲学完结"},{"start":3141.12,"end":3145.51,"text":"但相反啊对于善于思考的人"},{"start":3145.51,"end":3148.83,"text":"对于有有志去改变这个世界的人"},{"start":3150.74,"end":3155.5,"text":"反而能够抓住它的内在的一元论的这个核心犹豫"},{"start":3155.5,"end":3157.36,"text":"他认为这个世界只有一种犹豫"},{"start":3157.36,"end":3158.08,"text":"在致敬上"},{"start":3158.08,"end":3159.38,"text":"我还没有获得真理"},{"start":3159.38,"end":3161.779,"text":"所以我要始终动摇摇摆"},{"start":3161.779,"end":3164.919,"text":"其实犹豫还有另外一种"},{"start":3164.919,"end":3167.739,"text":"或者说他应该是有两种犹豫"},{"start":3168.43,"end":3170.23,"text":"甚至三种"},{"start":3173.5,"end":3175.82,"text":"犹豫是否要放弃"},{"start":3176.52,"end":3179.76,"text":"不再追问撤回"},{"start":3179.76,"end":3180.92,"text":"现在就"},{"start":3184.1,"end":3187.38,"text":"你不因为体验过这种犹豫"},{"start":3187.38,"end":3192.74,"text":"你就好像不再是超越这种犹豫的犹豫"},{"start":3192.74,"end":3195.66,"text":"不会因为体验过他就超越了他"},{"start":3196.14,"end":3197.1,"text":"你不能说哦"},{"start":3197.1,"end":3197.78,"text":"我犹豫了"},{"start":3197.78,"end":3199.22,"text":"然后我再随便做个什么决定"},{"start":3199.22,"end":3200.34,"text":"如果还要克服这个犹豫"},{"start":3200.34,"end":3201.98,"text":"就下定决心"},{"start":3202.86,"end":3206.06,"text":"这就是这种反哲学主义"},{"start":3206.06,"end":3209.2,"text":"他的骗术啊"},{"start":3209.2,"end":3210.86,"text":"他的骗术"},{"start":3213.78,"end":3215.74,"text":"他让你处在这种犹豫当中"},{"start":3215.74,"end":3218.5,"text":"然后告诉你直接去爱"},{"start":3218.5,"end":3220.3,"text":"去行动就行了"},{"start":3220.44,"end":3221.96,"text":"你不会因为体验犹豫"},{"start":3221.96,"end":3224.4,"text":"你就说你克服了犹豫啧"},{"start":3226.6,"end":3227.2,"text":"明白吗"},{"start":3228.48,"end":3230.72,"text":"他没有给出一个真正的终结"},{"start":3230.72,"end":3232.76,"text":"所以这是一种撤回性的作为"},{"start":3232.76,"end":3233.68,"text":"放弃的犹豫"},{"start":3233.68,"end":3235.38,"text":"还有一种犹豫是什么"},{"start":3241.62,"end":3242.96,"text":"它不是撤回"},{"start":3242.96,"end":3244.7,"text":"而是作为抵达的游戏"},{"start":3246.86,"end":3248.72,"text":"或者说是啊"},{"start":3249.46,"end":3252.22,"text":"那作为到时的犹豫"},{"start":3258.88,"end":3260.84,"text":"他不是作为放弃它"},{"start":3260.84,"end":3262.68,"text":"是作为什么"},{"start":3264.02,"end":3266.46,"text":"他不是放弃了这个东西"},{"start":3266.46,"end":3268.55,"text":"他是做了"},{"start":3269.39,"end":3272.07,"text":"作为否认的鱿鱼啊"},{"start":3272.07,"end":3274.2,"text":"做了这让我否认他"},{"start":3276.82,"end":3281.27,"text":"或者这种犹豫是作为对决的将信将疑"},{"start":3281.27,"end":3284.55,"text":"然后一直挨着一直就是作为保持着游泳"},{"start":3284.55,"end":3285.31,"text":"我最后说一下"},{"start":3285.31,"end":3287.39,"text":"就是作为保持的犹豫"},{"start":3298.48,"end":3300.44,"text":"因此它是作为什么游圆"},{"start":3301.64,"end":3303.8,"text":"你记得就好了"},{"start":3306.64,"end":3309.0,"text":"因此还是作为高潮的哲学"},{"start":3309.0,"end":3311.64,"text":"所以爱哲学"},{"start":3314.8,"end":3317.64,"text":"他抵达的不是婚姻"},{"start":3318.04,"end":3320.64,"text":"就是应该听到我们今天今天讲的所有这些东西"},{"start":3320.64,"end":3322.18,"text":"都是说通过爱哲学"},{"start":3322.18,"end":3323.24,"text":"他抵达了婚姻"},{"start":3323.24,"end":3323.88,"text":"对不对"},{"start":3323.88,"end":3325.02,"text":"爱降落了"},{"start":3325.02,"end":3326.72,"text":"不再爱了"},{"start":3327.29,"end":3329.75,"text":"但是我们靠的就是哲学"},{"start":3329.75,"end":3334.59,"text":"它是通过保持在这种犹豫当中"},{"start":3335.11,"end":3342.88,"text":"通过到了到了到了快到了快到了抵达的"},{"start":3343.82,"end":3344.74,"text":"高潮啊"},{"start":3344.74,"end":3348.56,"text":"所以说这种哲学停留在犹豫当中"},{"start":3348.56,"end":3350.7,"text":"他是能够"},{"start":3352.16,"end":3353.88,"text":"形成新的享乐的"},{"start":3356.44,"end":3359.04,"text":"形成新的享乐机制的"},{"start":3361.4,"end":3363.64,"text":"啊新的想法在哲学内部当中"},{"start":3363.64,"end":3367.76,"text":"在哲学本身当中就形成新的彻底性的想法"},{"start":3368.949,"end":3371.589,"text":"这种彻底性的享受是不假外求的"},{"start":3371.589,"end":3376.709,"text":"不需要再跳出抽离智慧去"},{"start":3378.28,"end":3381.56,"text":"去行动或者去额外的享乐"},{"start":3382.1,"end":3385.38,"text":"这种哲学就是我们一般说的是严肃哲学"},{"start":3386.5,"end":3387.3,"text":"就是严肃哲学"},{"start":3387.3,"end":3389.18,"text":"是一种淫荡的哲学"},{"start":3391.04,"end":3394.319,"text":"严肃哲学的实质就是和智慧性交"},{"start":3394.399,"end":3395.499,"text":"好吧"},{"start":3395.499,"end":3399.279,"text":"那么今天讲的是不严肃的学术"},{"start":3399.279,"end":3403.51,"text":"今天讲的是这种以为世界上只有一种犹豫"},{"start":3403.51,"end":3404.91,"text":"不知道该怎么学"},{"start":3404.91,"end":3408.83,"text":"然后那个假模假样的我就什么都别想了"},{"start":3408.83,"end":3410.31,"text":"撤了撤离了跑掉了"},{"start":3410.31,"end":3416.1,"text":"反正就但是还有另外一种哲学和严肃哲学或者淫荡的哲学"},{"start":3424.12,"end":3428.5,"text":"所以我们下一讲要讲最后一讲的是哲学和"},{"start":3434.54,"end":3437.26,"text":"是啊太阳下哲学与生活啊"},{"start":3437.26,"end":3437.74,"text":"真搞笑"},{"start":3437.74,"end":3439.32,"text":"就是哲学和他的伴侣"},{"start":3439.32,"end":3442.87,"text":"伴随物哲学和他的它的伴侣"},{"start":3442.87,"end":3444.37,"text":"比如说变成意思"},{"start":3444.37,"end":3445.57,"text":"Companion"},{"start":3445.57,"end":3447.03,"text":"哲学与它的伴侣"},{"start":3447.03,"end":3448.17,"text":"我们刚刚讲的吧"},{"start":3448.17,"end":3450.765,"text":"哲学一个伴侣就是享乐"},{"start":3453.26,"end":3455.18,"text":"直接能够抵达快乐能够抵达"},{"start":3455.18,"end":3457.72,"text":"就类似于性交高潮的快乐"},{"start":3457.72,"end":3460.16,"text":"你直接会有什办法"},{"start":3460.16,"end":3462.01,"text":"那意味着就是说"},{"start":3463.43,"end":3465.68,"text":"哲学本身会成为一种办法"},{"start":3465.68,"end":3467.68,"text":"你要带着哲学生活"},{"start":3467.68,"end":3469.8,"text":"或者陪伴着哲学生活"},{"start":3469.8,"end":3472.17,"text":"你自身是作为哲学的伴侣"},{"start":3472.17,"end":3474.63,"text":"这就是我们要讲的哲学基础"},{"start":3474.63,"end":3475.77,"text":"作为基础"},{"start":3475.77,"end":3477.65,"text":"那最后不是踩在你脚下的"},{"start":3477.65,"end":3481.89,"text":"或者说也会使得你人生的每一步都好像是踩在哲学上"},{"start":3483.13,"end":3485.88,"text":"踩在哲学思辨给你铺就的道路上"}],"source":"subtitle"}
