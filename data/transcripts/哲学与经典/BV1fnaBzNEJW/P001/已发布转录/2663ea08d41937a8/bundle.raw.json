{"segments":[{"start":0.16,"end":2.04,"text":"当然这个系列没有完结啊"},{"start":2.04,"end":3.5,"text":"这个是倒数第二讲"},{"start":3.5,"end":5.58,"text":"你在演示什么"},{"start":5.82,"end":6.78,"text":"给我的"},{"start":6.78,"end":8.02,"text":"我爱的人"},{"start":8.02,"end":8.94,"text":"给你爱的人"},{"start":8.94,"end":9.82,"text":"你要求他们怎么做"},{"start":10.82,"end":15.47,"text":"要求他们按照自己的生活方式"},{"start":15.47,"end":17.05,"text":"就是去经验"},{"start":17.05,"end":17.73,"text":"去生活"},{"start":17.73,"end":18.7,"text":"去"},{"start":21.46,"end":22.06,"text":"创造"},{"start":22.06,"end":26.0,"text":"也就是说那你的死亡不希望给他们带来任何改变"},{"start":26.0,"end":27.74,"text":"对吗"},{"start":30.4,"end":35.26,"text":"继续你提到的是继续不能积极使死亡"},{"start":35.26,"end":36.18,"text":"不能积极死亡"},{"start":36.18,"end":42.32,"text":"对那你是不是继续按照他们原有的方式去生活"},{"start":42.32,"end":43.739,"text":"不是原有的"},{"start":43.799,"end":47.059,"text":"根据他们自己的生命经验哦"},{"start":48.579,"end":51.22,"text":"你希望他们忠于自己对啊"},{"start":51.22,"end":54.94,"text":"能够自由地独立地做出选择"},{"start":54.94,"end":59.51,"text":"对嗯但是你认为在你死之前"},{"start":60.51,"end":62.03,"text":"他不太是这样的"},{"start":62.03,"end":65.47,"text":"可能会依附于世俗的拥见啊"},{"start":65.47,"end":71.13,"text":"或者怎样希望你的死亡能够让他们成为他们自己"},{"start":71.13,"end":71.67,"text":"对"},{"start":73.99,"end":75.15,"text":"我没有写"},{"start":75.15,"end":76.27,"text":"你没写"},{"start":76.27,"end":78.33,"text":"行好好"},{"start":79.37,"end":83.29,"text":"我就有个我就是让人"},{"start":84.94,"end":86.7,"text":"哎呀我问下小雨没写完"},{"start":86.7,"end":90.58,"text":"因为你总共写了几句吧"},{"start":91.5,"end":94.33,"text":"就是我就笑了你"},{"start":94.335,"end":97.43,"text":"我其实跟跟女朋友想的差不多吧"},{"start":97.43,"end":98.81,"text":"跟女朋友想的差不多"},{"start":98.81,"end":99.41,"text":"差不多"},{"start":99.41,"end":103.0,"text":"都是希望自己的死亡能够成为别人"},{"start":103.0,"end":106.6,"text":"把握自己生命完整意义的一个契机对吧"},{"start":107.34,"end":113.25,"text":"然后这个我写的给我自己给你自己的"},{"start":113.25,"end":115.73,"text":"那你是怎么布置你的后事呢"},{"start":115.73,"end":119.21,"text":"算是后期就是目前各种方面的工作"},{"start":119.21,"end":121.26,"text":"就是该怎么配音"},{"start":121.26,"end":123.3,"text":"然后就诶你都死了呀"},{"start":123.3,"end":124.8,"text":"还是点遗言啊"},{"start":124.8,"end":126.88,"text":"遗书遗言嗯"},{"start":126.94,"end":127.9,"text":"我要死"},{"start":127.9,"end":132.09,"text":"我觉得死了就也不算那种死了哦"},{"start":132.09,"end":136.37,"text":"这意思是旧的自我已经终结了"},{"start":136.37,"end":137.39,"text":"那边都安排下"},{"start":137.39,"end":139.975,"text":"然后看后面哪些条路是最大"},{"start":143.22,"end":148.189,"text":"相当于那个SBC还是SCPA哦"},{"start":148.189,"end":152.329,"text":"他有个第96号就做第二次"},{"start":152.329,"end":154.729,"text":"他会是在人死了之后"},{"start":154.729,"end":163.36,"text":"这个类人型的这个奇异体就会变成死掉的那个人滋一下子生成出来"},{"start":163.36,"end":170.29,"text":"那么他就会啊不停的去和非常有序的去规划自己的生活"},{"start":170.29,"end":172.57,"text":"弥补自己的种种过失"},{"start":172.57,"end":173.88,"text":"错误遗憾"},{"start":173.88,"end":176.24,"text":"然后把这些事情尽量做的特别特别好"},{"start":177.24,"end":182.14,"text":"但是呢他好像那个里面他就没有办法再有新的欲望了"},{"start":182.14,"end":184.78,"text":"那生活就变成不停的去弥补遗憾"},{"start":185.78,"end":190.3,"text":"不停的去让自己过往的一些计划能够得到落实"},{"start":190.62,"end":191.62,"text":"没有新的意志"},{"start":193.74,"end":195.98,"text":"你应该是不太一样吧"},{"start":196.02,"end":200.34,"text":"哇老师看你在那个给我安排了"},{"start":200.34,"end":203.86,"text":"就是有的应该也不会被哦"},{"start":203.86,"end":205.04,"text":"是的是的"},{"start":205.04,"end":207.04,"text":"那就要重新选的是吧"},{"start":208.25,"end":212.81,"text":"偶尔闲下来闲下来就是看看就哪里就没体型的话题"},{"start":212.81,"end":214.49,"text":"可能有点什么"},{"start":214.49,"end":217.48,"text":"暂停下好吧"},{"start":217.88,"end":221.34,"text":"我我我感觉很难写没写"},{"start":221.34,"end":222.36,"text":"所以没写是吧"},{"start":222.36,"end":224.57,"text":"很困难呃"},{"start":224.57,"end":228.63,"text":"把我手机写的一些东西发布出去哦"},{"start":228.63,"end":231.209,"text":"有有有文学创作呃"},{"start":231.209,"end":234.54,"text":"我有几百个游戏点子"},{"start":236.1,"end":237.1,"text":"400多分"},{"start":237.1,"end":238.72,"text":"希望别人帮你实践是吧"},{"start":238.72,"end":243.83,"text":"对然后我就在那个就是有一个具体的执行机构吧"},{"start":243.83,"end":247.34,"text":"就是首先把我这个死事件本身做一个炒作"},{"start":247.34,"end":250.12,"text":"变形拉高那个视频可能传播度"},{"start":250.12,"end":252.38,"text":"然后我再把这这个是一方面"},{"start":252.38,"end":255.77,"text":"其实还有一些就是我以前有吊别人胃口"},{"start":255.77,"end":256.79,"text":"出了一系列东西"},{"start":256.79,"end":259.99,"text":"然后有些人会问我要那个你那个资料存档吗"},{"start":259.99,"end":261.89,"text":"哦哦诶我有的时候也没发"},{"start":261.89,"end":264.75,"text":"然后这东西现在没发出去"},{"start":264.75,"end":270.47,"text":"就是希望你的死亡本身能够激起别人对于你创作出来的事"},{"start":270.47,"end":273.65,"text":"对作品的一个好奇心啊"},{"start":273.65,"end":274.99,"text":"我们更重视它的价值"},{"start":274.99,"end":278.45,"text":"或者能够让点子变成真正的游戏"},{"start":278.45,"end":280.73,"text":"是对时间没有好"},{"start":280.73,"end":282.93,"text":"没有感觉哦"},{"start":282.93,"end":286.17,"text":"把这自己的生命的进一步的展开"},{"start":286.17,"end":287.73,"text":"孕育出来的种子"},{"start":287.73,"end":291.14,"text":"就是作为一个请求吧"},{"start":291.14,"end":292.76,"text":"传传递给谁"},{"start":292.76,"end":293.78,"text":"活着的人"},{"start":293.78,"end":297.33,"text":"你想那么细就好好活着啊"},{"start":297.33,"end":298.55,"text":"好好活着"},{"start":298.55,"end":300.61,"text":"就希望别人好好活着嗯"},{"start":300.61,"end":304.7,"text":"那你总归要写怎么叫好好活着"},{"start":304.7,"end":307.04,"text":"不知道他们自己可以选哦"},{"start":307.04,"end":309.5,"text":"那就跟这还差不多啊"},{"start":309.5,"end":313.66,"text":"那我们今天讲的这个叫环节"},{"start":316.68,"end":319.56,"text":"哲学是爱智慧"},{"start":327.22,"end":330.9,"text":"啧那为什么会和完结有关呢"},{"start":331.15,"end":335.97,"text":"啊因为这个智慧被看成是某种虽然名为智慧呢"},{"start":335.97,"end":340.04,"text":"但是可以看成是智力探索的结束终结"},{"start":340.04,"end":342.08,"text":"或者说致敬的死亡"},{"start":351.84,"end":355.32,"text":"那么它对应在哲学上对应的是什么呢"},{"start":355.859,"end":362.06,"text":"这样的哲学对应的是其实是科学革命时期非常盛行的一种哲学"},{"start":362.06,"end":365.14,"text":"那个时候有的人名字叫韦林吧"},{"start":365.14,"end":366.62,"text":"我说知巨"},{"start":372.34,"end":374.54,"text":"查尔文音乐"},{"start":377.3,"end":382.1,"text":"那么这样的哲学呢它说是庸俗哲学"},{"start":382.1,"end":384.7,"text":"因为我们前面两讲讲的是庸俗庸俗哲学"},{"start":384.7,"end":386.56,"text":"历史近代哲学或者教科书哲学"},{"start":386.56,"end":391.62,"text":"这两种哲学呢它是适配于科学"},{"start":391.62,"end":394.33,"text":"认可科学"},{"start":396.37,"end":399.29,"text":"人口所消费的"},{"start":402.72,"end":405.44,"text":"呃一种特种哲学"},{"start":411.72,"end":415.12,"text":"这种哲学如果用孩子的话说"},{"start":415.12,"end":419.54,"text":"他就是反对思考"},{"start":422.66,"end":429.22,"text":"或者反对那种就是严肃思考"},{"start":429.22,"end":432.8,"text":"反对那种根本的严格的严格这个词"},{"start":432.8,"end":435.27,"text":"反对严格的彻底的追思"},{"start":443.38,"end":451.82,"text":"基本上你看这个呃那个爱因斯坦波尔这些人"},{"start":451.82,"end":454.82,"text":"他们会有比较庸俗的一些啊"},{"start":454.82,"end":458.85,"text":"这些思考或者什么波普尔啊"},{"start":458.85,"end":464.01,"text":"当时的一些这个在科学家家当中还被称呼为是所谓哲学家的人"},{"start":464.01,"end":465.73,"text":"他们的哲学都很不严肃"},{"start":465.73,"end":467.76,"text":"很不严格呃"},{"start":467.76,"end":472.04,"text":"然后是不进行彻底的思考"},{"start":472.04,"end":480.99,"text":"也就是说首先他们就不对自己的科学话语当中的预设"},{"start":481.61,"end":485.39,"text":"工具性的预设做根本的反思"},{"start":485.39,"end":489.56,"text":"因为这样的反思会要求他们进入现象学"},{"start":489.56,"end":490.68,"text":"如果要反思"},{"start":490.68,"end":491.62,"text":"我还要进无限"},{"start":491.62,"end":495.05,"text":"所以他们都是啧"},{"start":495.05,"end":496.77,"text":"从分支上来讲"},{"start":496.77,"end":498.91,"text":"就是他们是反现象学"},{"start":498.91,"end":502.04,"text":"从血脉上来讲就是反现象学"},{"start":502.04,"end":506.72,"text":"咱们的正经的完整的哲学传承"},{"start":506.72,"end":509.15,"text":"旧到新康德主义"},{"start":509.51,"end":512.309,"text":"甚至也是反台这个主义啊"},{"start":512.309,"end":513.23,"text":"我们都有个特点"},{"start":513.23,"end":516.63,"text":"停留在就是现象学的那个"},{"start":519.0,"end":522.76,"text":"反正玩原或者怎样那一套繁琐的哲学运思呢"},{"start":522.76,"end":525.86,"text":"他是不采取了不进行这个立场"},{"start":525.86,"end":532.3,"text":"然后基本上都是拥抱工具假设啊"},{"start":538.7,"end":539.9,"text":"然后用帽工具角"},{"start":539.9,"end":540.54,"text":"什么叫工具甲"},{"start":540.54,"end":542.58,"text":"这呢就是"},{"start":543.64,"end":545.92,"text":"比如说数学"},{"start":547.44,"end":551.4,"text":"和逻辑学依赖于一些根本的逻辑定律"},{"start":551.4,"end":552.56,"text":"公理性的定律"},{"start":552.56,"end":554.66,"text":"排他律什么什么的"},{"start":554.66,"end":556.54,"text":"那么这些根本的这些公理"},{"start":558.36,"end":559.8,"text":"凭什么是这样的"},{"start":559.8,"end":564.609,"text":"我集合论他有很很多条集合论的前置性的这些公理"},{"start":564.889,"end":568.729,"text":"那么这些科学家他就会认为啊"},{"start":568.729,"end":570.55,"text":"能用就行了"},{"start":570.99,"end":574.27,"text":"我再反过来想要去这个呃"},{"start":574.27,"end":576.59,"text":"用逻辑去驳倒他的时候"},{"start":576.59,"end":577.61,"text":"否定他的时候"},{"start":577.61,"end":580.61,"text":"我不还是先假设它是正确的吗"},{"start":580.61,"end":583.65,"text":"就像马克思写资本论"},{"start":583.65,"end":587.55,"text":"他会假设国民经济学里面的那些价值理论"},{"start":587.55,"end":590.84,"text":"或者说那些所有制关系啊"},{"start":590.84,"end":593.2,"text":"劳动的可计量化"},{"start":594.15,"end":596.59,"text":"他会假设这个东西是先是对的"},{"start":596.59,"end":599.23,"text":"然后在这个对的基础上去推推推推导出来"},{"start":599.23,"end":604.54,"text":"那么必然会有阶级运动去把这些资产阶级所认可的许可的"},{"start":604.54,"end":607.94,"text":"觉得天经地义的私有制的这种关联可能推翻"},{"start":607.94,"end":610.139,"text":"那要这叫工具假设"},{"start":610.139,"end":611.419,"text":"他们都认一些工具"},{"start":611.419,"end":616.48,"text":"假设这些工具假设基本上就是对于呃认识论"},{"start":616.88,"end":620.28,"text":"认识论背后的这个本体论"},{"start":621.36,"end":623.82,"text":"啊还有就是超越性的啊"},{"start":623.82,"end":624.76,"text":"超越性的"},{"start":624.76,"end":627.32,"text":"比如说这个世界到底是不是真实的等等等等"},{"start":627.32,"end":628.42,"text":"超越性的"},{"start":628.42,"end":634.31,"text":"还有包括是啊主体意识的真实性"},{"start":634.31,"end":638.38,"text":"这些问题呢就都选址起来了"},{"start":638.38,"end":640.74,"text":"都不讨论了啊"},{"start":640.74,"end":640.9,"text":"都"},{"start":643.4,"end":646.16,"text":"那么他在这些那些超验的问题上"},{"start":646.16,"end":649.0,"text":"往往采取一个直接主义的一个立场"},{"start":650.78,"end":657.26,"text":"啊就但是他会陷入什么直觉一元论啊"},{"start":657.26,"end":660.02,"text":"我们叫直观一元论"},{"start":662.34,"end":666.68,"text":"稍微精致一点会变成什么啊"},{"start":666.68,"end":672.24,"text":"要素一元论或者说什么信息一元论啊"},{"start":673.54,"end":675.38,"text":"他会有他的列板的理论"},{"start":675.38,"end":678.5,"text":"调出原来我啊信息等"},{"start":680.66,"end":683.46,"text":"这些都是比较愚蠢的哲学"},{"start":684.61,"end":685.49,"text":"直观一人了"},{"start":685.49,"end":689.09,"text":"就是说啊他的精致化到极致"},{"start":689.09,"end":692.37,"text":"就是罗素的哲学啊"},{"start":692.37,"end":696.07,"text":"看似弥弥合了什么唯物主义和唯心主义的对立"},{"start":696.07,"end":697.74,"text":"其实大家一个都没搞懂"},{"start":697.74,"end":700.76,"text":"他没有经过关联论的这个严格训练"},{"start":700.76,"end":703.62,"text":"然后也没有切入现象学论域"},{"start":704.78,"end":710.51,"text":"然后对于他所采用的逻辑工具本身也是不加以反思的啊"},{"start":710.51,"end":714.2,"text":"像罗素他是试图用逻辑命题啊"},{"start":714.2,"end":715.36,"text":"逻辑性的关系啊"},{"start":715.36,"end":721.17,"text":"一个非常毕业角的粗糙的一个数理逻辑体系去建构数学的根据"},{"start":721.17,"end":724.81,"text":"但是他对这个逻辑系统的符号性的关系"},{"start":724.81,"end":728.62,"text":"它背后的这个实际的啊"},{"start":730.78,"end":732.68,"text":"结构不加以任何解释"},{"start":732.68,"end":733.7,"text":"不加以任何反思"},{"start":734.9,"end":736.18,"text":"他没有那个血量啊"},{"start":736.18,"end":741.46,"text":"没有那个气象学直观和符号学拆解的能力"},{"start":741.46,"end":742.22,"text":"分析能力"},{"start":743.54,"end":745.47,"text":"那么这样的哲学呢"},{"start":745.47,"end":748.91,"text":"他现在是被普遍的作为一种姿态"},{"start":750.07,"end":751.63,"text":"作为一种姿态"},{"start":755.66,"end":761.1,"text":"就是智慧应当是让你停止发问的东西"},{"start":782.12,"end":786.2,"text":"爱与智慧就是让这种爱得到止息"},{"start":789.02,"end":793.18,"text":"我这种就有点像这种作为完结的主页"},{"start":793.18,"end":796.17,"text":"他就有点像作为作为婚姻的爱情"},{"start":796.49,"end":797.73,"text":"那当然是庸俗了"},{"start":797.73,"end":800.04,"text":"是牛族为主的"},{"start":804.38,"end":805.34,"text":"那么这个里面"},{"start":807.42,"end":809.18,"text":"典型是谁"},{"start":811.32,"end":813.44,"text":"被奉为割裂的典型是谁"},{"start":813.44,"end":816.16,"text":"年轻的时候试图用"},{"start":818.02,"end":822.14,"text":"逻辑命题来建构一个完备的真理体系"},{"start":822.14,"end":823.38,"text":"语言描述体系"},{"start":824.58,"end":826.349,"text":"年纪稍大一点"},{"start":826.91,"end":828.13,"text":"开始说"},{"start":828.13,"end":830.96,"text":"智慧是令人停止发问的"},{"start":832.74,"end":835.82,"text":"嗯这个里面的典型是维特根斯坦啊"},{"start":853.94,"end":859.42,"text":"就是说不再追求超越日常话语的啊"},{"start":859.42,"end":862.69,"text":"一个神秘的神话般的啊"},{"start":862.69,"end":865.29,"text":"揭露这一切背后的真相啊"},{"start":865.29,"end":874.36,"text":"啊或者说在整个世界背后运行的额肌理的超越性的语言"},{"start":874.36,"end":876.14,"text":"而只存在日常语言"},{"start":876.14,"end":878.54,"text":"也就不存在私人语言"},{"start":879.17,"end":880.69,"text":"取消私人合计"},{"start":884.37,"end":887.509,"text":"四元与其说私人语言"},{"start":887.509,"end":890.889,"text":"它并不是说和自己对话的私人语言"},{"start":890.889,"end":895.81,"text":"它是像你用什么话向大杀者进行发问"},{"start":895.81,"end":896.63,"text":"请君问答"},{"start":896.63,"end":898.92,"text":"意是说如果是在顺人"},{"start":898.92,"end":902.18,"text":"你就没有办法去进行究竟的根本的发问"},{"start":902.18,"end":906.32,"text":"因为问总是要用语言来问的"},{"start":913.94,"end":917.06,"text":"所以维特根散之后的哲学"},{"start":917.06,"end":919.9,"text":"从字面上讲"},{"start":920.59,"end":922.19,"text":"他们的"},{"start":923.47,"end":924.87,"text":"就是作为什么存在的"},{"start":924.87,"end":925.71,"text":"从字面上讲"},{"start":925.71,"end":930.07,"text":"维特根斯坦之后就都是作为向往"},{"start":932.62,"end":934.98,"text":"字面意义上讲的笑话所在"},{"start":934.98,"end":938.13,"text":"俏皮话as jokes"},{"start":938.13,"end":940.85,"text":"或者说作为讽刺"},{"start":940.85,"end":943.94,"text":"高级点就是作为讽刺啊"},{"start":949.18,"end":951.14,"text":"那么这个导向的就是这个"},{"start":953.18,"end":954.7,"text":"后生补液"},{"start":960.5,"end":962.18,"text":"所以比如说齐泽克这种人"},{"start":962.18,"end":963.58,"text":"在很大意义上讲"},{"start":963.58,"end":969.3,"text":"我个人并不认为他是个严肃的激进哲学道统里面的存在"},{"start":969.3,"end":973.08,"text":"他的哲学作为一个历史事件兴起"},{"start":973.08,"end":975.9,"text":"是在美国的后实用主义的"},{"start":975.9,"end":977.64,"text":"后现代主义的"},{"start":977.64,"end":983.65,"text":"把哲学当作笑话和讽刺来看待的这个传统当中"},{"start":983.65,"end":987.21,"text":"那么这样的笑话他是两方面"},{"start":987.21,"end":988.33,"text":"如果说作为笑话"},{"start":988.33,"end":991.05,"text":"他是朝向的是生存"},{"start":991.45,"end":997.13,"text":"那么现代的主要生存的重点在于什么享乐"},{"start":999.6,"end":1003.8,"text":"强制性的义务和享受性的义务是有什么"},{"start":1008.62,"end":1016.119,"text":"近郊那这个笑话就瞄瞄准各式样的这个你叫"},{"start":1016.119,"end":1020.46,"text":"那么他的代表人物就是四个"},{"start":1023.48,"end":1027.93,"text":"作为把智慧看成是停止发问之物"},{"start":1028.29,"end":1030.9,"text":"停止语言性的发we"},{"start":1031.18,"end":1034.42,"text":"就就作为一个哲学立场来讲"},{"start":1034.42,"end":1035.96,"text":"其实这个是在典型"},{"start":1035.96,"end":1039.819,"text":"那么另外一方面讽刺讽刺的长安是什么"},{"start":1039.819,"end":1041.2,"text":"众人的深情"},{"start":1041.2,"end":1042.16,"text":"他人的深情"},{"start":1042.16,"end":1043.579,"text":"或者说"},{"start":1045.56,"end":1047.64,"text":"政治啊"},{"start":1063.36,"end":1065.36,"text":"那么最具有讽刺性的政治是什么"},{"start":1067.28,"end":1069.22,"text":"Olydi"},{"start":1070.82,"end":1072.26,"text":"是手枪啊"},{"start":1072.26,"end":1073.5,"text":"是手枪"},{"start":1073.5,"end":1075.74,"text":"给我打个喷嚏"},{"start":1083.0,"end":1086.08,"text":"咳咳教育啊"},{"start":1091.84,"end":1094.32,"text":"最具有讽刺性的政治"},{"start":1094.32,"end":1097.06,"text":"It is education"},{"start":1098.38,"end":1103.28,"text":"因为讽刺注定是一个不对等的啊"},{"start":1104.84,"end":1110.82,"text":"然后是一个啧啧遇鬼害怕的姿态"},{"start":1110.82,"end":1113.16,"text":"是一个弱势的一个姿态"},{"start":1116.78,"end":1120.47,"text":"那么他在教育方面对应的是什么内容"},{"start":1121.19,"end":1125.19,"text":"他才比比奇瑞克要早一点"},{"start":1125.19,"end":1126.47,"text":"人物"},{"start":1127.76,"end":1131.76,"text":"杜威的杜威的生命哲学"},{"start":1132.0,"end":1136.32,"text":"就是那样的不同的教育"},{"start":1137.4,"end":1138.72,"text":"一种"},{"start":1139.76,"end":1141.4,"text":"教育应当具有启发性"},{"start":1142.48,"end":1148.78,"text":"教育应当不拘泥于那个时候美国的或者英美的逻辑适用的啊"},{"start":1148.78,"end":1149.82,"text":"实证主义传统"},{"start":1149.82,"end":1155.23,"text":"或者说是不拘泥于是苏东的意识形态的统治"},{"start":1155.65,"end":1156.87,"text":"乌龟式的教育"},{"start":1156.87,"end":1164.1,"text":"这个时候智力对于人类的启发性的意义在于教育"},{"start":1164.1,"end":1168.01,"text":"而教育呢他不会给予你答案"},{"start":1168.41,"end":1171.31,"text":"杜威式的教育就是说句式答案的教育"},{"start":1171.31,"end":1173.18,"text":"句式要问答案"},{"start":1183.76,"end":1189.04,"text":"所谓的让这个自信保持开放的效果"},{"start":1192.06,"end":1194.56,"text":"所以如果我们再进一步说的话"},{"start":1194.56,"end":1200.05,"text":"这种教育会变成一个公共话语空间"},{"start":1207.92,"end":1210.6,"text":"就是两者结合到一块去"},{"start":1213.48,"end":1216.89,"text":"这这个关于性交的荤段子"},{"start":1216.89,"end":1219.3,"text":"这是公共话语空间的反面"},{"start":1219.3,"end":1220.9,"text":"或者说它的剩余"},{"start":1220.9,"end":1223.02,"text":"那么教育本身作为成年人"},{"start":1223.02,"end":1224.5,"text":"公民之间的相互教育"},{"start":1224.5,"end":1229.449,"text":"那就是他们对应的人物是哈维马斯"},{"start":1236.74,"end":1239.02,"text":"嘶留根哈根达斯"},{"start":1239.02,"end":1243.98,"text":"所以这几个哲学家形成了共同的个矩阵"},{"start":1243.98,"end":1250.069,"text":"是在一个哲学已经终结了意义上的后现代学家"},{"start":1250.069,"end":1251.589,"text":"就这群人了"},{"start":1251.83,"end":1253.03,"text":"它形成一个新宠"},{"start":1254.03,"end":1255.37,"text":"作为完结的哲学"},{"start":1255.37,"end":1256.47,"text":"如果你要把握的话"},{"start":1256.47,"end":1258.31,"text":"主要就是这帮王八蛋"},{"start":1264.9,"end":1265.98,"text":"你不会写笔记"},{"start":1265.98,"end":1267.14,"text":"比我记板书还要慢吧"},{"start":1268.58,"end":1270.26,"text":"我擦掉了啊"},{"start":1272.62,"end":1274.02,"text":"啊由于是哲学基础"},{"start":1274.02,"end":1276.94,"text":"所以我不可能说把这些人的东西全给你们讲一遍啊"},{"start":1276.94,"end":1278.99,"text":"就那个就那个"},{"start":1279.83,"end":1282.51,"text":"那么我们现在就要问了"},{"start":1282.87,"end":1287.19,"text":"那么爱智慧是要抵达到这样一种姿态吗"},{"start":1289.02,"end":1290.58,"text":"哲学"},{"start":1294.02,"end":1298.08,"text":"追求自身的完结吗"},{"start":1298.08,"end":1304.12,"text":"或者说哲学追求不追求智慧吗"},{"start":1305.29,"end":1308.21,"text":"或者说不再追求数对吗"},{"start":1320.1,"end":1325.7,"text":"所以我我就说如果你们那个遗书里面能够逻辑"},{"start":1325.7,"end":1329.95,"text":"就是说我知道你们写一封遗书要跟死亡没有关系"},{"start":1329.95,"end":1330.47,"text":"对不对"},{"start":1330.47,"end":1332.15,"text":"然后又是一个命令性的话语"},{"start":1332.15,"end":1332.74,"text":"对不对"},{"start":1332.74,"end":1337.74,"text":"那现在类似的就相当于你去写模拟数学的说"},{"start":1339.18,"end":1340.94,"text":"该死让我死吧"},{"start":1342.9,"end":1343.98,"text":"他跟死活没有关系"},{"start":1343.98,"end":1346.17,"text":"因为这就是他还活着"},{"start":1346.65,"end":1348.71,"text":"他这个尚未成为遗书的遗书"},{"start":1348.71,"end":1350.05,"text":"但他又是遗书"},{"start":1350.05,"end":1352.61,"text":"因为人活着就可以写遗书"},{"start":1356.2,"end":1361.87,"text":"那么这样的哲学它就类似于一个人写了这样一封遗书"},{"start":1361.87,"end":1363.79,"text":"他就给自己施加命令"},{"start":1363.79,"end":1367.54,"text":"这个命令呢就必须他活着才能抵达"},{"start":1367.54,"end":1373.06,"text":"就有没有想到这个罗素的那个什么理发师悖论的给自己理发"},{"start":1373.06,"end":1375.0,"text":"我说不能给自己"},{"start":1377.74,"end":1381.3,"text":"他本身不再追求智慧"},{"start":1381.3,"end":1386.77,"text":"那么在这里解决这个难题的就是这个"},{"start":1388.77,"end":1390.74,"text":"No longer"},{"start":1392.14,"end":1393.74,"text":"No more"},{"start":1397.06,"end":1401.9,"text":"剩余的重复的取消就把发问这件事情"},{"start":1403.12,"end":1408.08,"text":"而且是什么样语言化的"},{"start":1410.58,"end":1412.22,"text":"啊用语言来发问"},{"start":1413.3,"end":1416.42,"text":"看成是生命的"},{"start":1419.46,"end":1425.44,"text":"啊这个坠油注意一般都写不写了啊"},{"start":1425.44,"end":1426.4,"text":"上面的多余啊"},{"start":1426.4,"end":1428.24,"text":"剩余数"},{"start":1429.88,"end":1435.0,"text":"所以根本来讲呢这样这个姿态是一种反哲学姿态"},{"start":1437.26,"end":1442.98,"text":"但是这个反对的态怎样是要通过哲学本身来完成"},{"start":1443.92,"end":1448.2,"text":"他必须通过哲学来抵达反哲学"},{"start":1452.04,"end":1455.36,"text":"这里又有一个过渡啊"},{"start":1463.74,"end":1467.74,"text":"通过学习哲学来抵达一个啊"},{"start":1468.72,"end":1470.3,"text":"我再也不用发问了"},{"start":1470.3,"end":1472.23,"text":"我再也不用惊奇了"},{"start":1472.23,"end":1474.13,"text":"而且就算我有惊奇"},{"start":1474.13,"end":1476.85,"text":"哪怕有这种生命的悸动"},{"start":1476.85,"end":1480.31,"text":"我不应该把它变成语词"},{"start":1480.31,"end":1484.97,"text":"不应该把它用语言注册到思想思索的体象中"},{"start":1484.97,"end":1489.23,"text":"No more thinking normal thought"},{"start":1490.4,"end":1495.36,"text":"啊不再去进行思考而代替什么"},{"start":1496.04,"end":1497.84,"text":"代之以诗"},{"start":1499.88,"end":1506.07,"text":"艺术创伤刻意的什么宿醉啊"},{"start":1507.53,"end":1509.17,"text":"我要对生活啊"},{"start":1509.17,"end":1511.64,"text":"或者说革命蜂巢式的革命"},{"start":1511.64,"end":1513.4,"text":"这个革命就非常可疑了"},{"start":1513.4,"end":1515.36,"text":"因为采取这样一种哲学姿态"},{"start":1515.36,"end":1519.08,"text":"实际上是没办法展展出真正的革命的啊"},{"start":1519.08,"end":1521.16,"text":"嗯对抛弃思考"},{"start":1521.16,"end":1522.48,"text":"你不再进行理性化"},{"start":1522.48,"end":1525.89,"text":"对中立问题不是悬置"},{"start":1525.89,"end":1527.01,"text":"而是把它切断"},{"start":1529.37,"end":1531.56,"text":"还是最重要的是吧"},{"start":1541.64,"end":1548.0,"text":"所以这种哲学呢会成为很多资产阶级政客的辩护术"},{"start":1549.22,"end":1551.02,"text":"啊他在哲学上"},{"start":1551.02,"end":1555.78,"text":"他通过尤其是那些名校毕业的自然认证"},{"start":1555.98,"end":1557.62,"text":"如we share the"},{"start":1557.62,"end":1559.42,"text":"We share different plos"},{"start":1559.42,"end":1560.76,"text":"我们有不同的哲学"},{"start":1560.76,"end":1562.36,"text":"我们有同样的哲学"},{"start":1562.36,"end":1567.64,"text":"哲学会成为只是他抛弃一些战机价值基准啊"},{"start":1567.64,"end":1570.42,"text":"去年轻的时候搞一搞街头运动"},{"start":1570.42,"end":1572.52,"text":"搞了之后拥抱成熟的时候"},{"start":1572.52,"end":1575.01,"text":"拥抱这个现实的所有的罪恶"},{"start":1575.01,"end":1575.49,"text":"然后呢"},{"start":1575.49,"end":1578.71,"text":"平时沉溺在这些荒张性的享乐啊"},{"start":1578.71,"end":1581.91,"text":"艺术品店长无法购买"},{"start":1581.91,"end":1584.21,"text":"还有付现的诗歌消费"},{"start":1584.21,"end":1592.04,"text":"导游去这个维持了大量的西方资产阶级统治人口的精神世界"},{"start":1595.1,"end":1599.24,"text":"他是进入哲学学习的系统化的哲学学习"},{"start":1599.24,"end":1601.86,"text":"然后走向反哲学"},{"start":1602.38,"end":1604.5,"text":"我看到所有的哲学体系都有缺陷"},{"start":1604.5,"end":1606.38,"text":"就有这个那个这个那个的一个缺陷"},{"start":1607.38,"end":1612.469,"text":"那么实际上这种姿态样是停留在这个中"},{"start":1613.269,"end":1615.649,"text":"使得发问"},{"start":1615.649,"end":1619.949,"text":"或者说使得这个内在的追索"},{"start":1620.26,"end":1623.65,"text":"这是一个很吊诡的一种方式"},{"start":1624.29,"end":1627.62,"text":"他其实也不是说真的不发文的"},{"start":1628.06,"end":1634.02,"text":"他把方位只是说他取消了问题这件事情本身的呃"},{"start":1634.86,"end":1635.9,"text":"绝对的挣扎"},{"start":1636.98,"end":1638.42,"text":"绝对挣扎"},{"start":1647.8,"end":1649.48,"text":"他不是犹豫啊"},{"start":1649.48,"end":1651.56,"text":"并不是说不再犹豫"},{"start":1656.12,"end":1657.6,"text":"他不是不再犹豫"},{"start":1657.6,"end":1660.36,"text":"而是他不再在乎自己"},{"start":1660.36,"end":1662.32,"text":"犹豫了"},{"start":1669.2,"end":1676.31,"text":"因为他好像发现了再怎么有智慧啊"},{"start":1676.31,"end":1677.61,"text":"犹豫是已经在场的"},{"start":1677.61,"end":1682.42,"text":"或者说这里面就是一个犹豫犹豫了"},{"start":1682.42,"end":1686.129,"text":"同志论"},{"start":1686.129,"end":1689.289,"text":"他认为世间所有的智性犹豫是通用"},{"start":1689.289,"end":1691.71,"text":"犹豫就是他们犯的错误"},{"start":1693.63,"end":1694.83,"text":"他消费了哲学"},{"start":1694.83,"end":1695.47,"text":"学习哲学"},{"start":1695.47,"end":1696.59,"text":"然后走向反哲学"},{"start":1696.59,"end":1702.9,"text":"然后他对于世间的疑问啊不再停留在哲学当中"},{"start":1702.9,"end":1705.02,"text":"反而就停留在哲学当中"},{"start":1705.02,"end":1707.54,"text":"反而使他的根本的彻底的否定性"},{"start":1707.54,"end":1708.02,"text":"反思性"},{"start":1708.02,"end":1709.929,"text":"批判性只停留在哲学当中"},{"start":1709.929,"end":1712.209,"text":"从哲学当中幸存出来的反思性"},{"start":1712.209,"end":1712.729,"text":"否定性"},{"start":1712.729,"end":1714.429,"text":"批判性是一种虚假的反思性"},{"start":1714.429,"end":1714.969,"text":"否定性"},{"start":1714.969,"end":1719.01,"text":"批判性是一种实质上对他的利益的这些利益"},{"start":1719.01,"end":1719.61,"text":"这些话语"},{"start":1719.61,"end":1723.05,"text":"阶级意识形态的运作的维护"},{"start":1724.29,"end":1733.08,"text":"那么他们的共同的错误就是认为所有的积极努力是分有同一种犹豫的"},{"start":1735.5,"end":1742.1,"text":"或者说他们共同的错误是认为所有的哲学都是哲学"},{"start":1748.44,"end":1750.68,"text":"都是哲学"},{"start":1755.66,"end":1762.3,"text":"或者说他们会认为所有哲学都是只不过是不同的哲学"},{"start":1770.18,"end":1771.96,"text":"不同种类的哲学"},{"start":1771.96,"end":1775.94,"text":"或者说是他们其实是认为所有的哲学都是什么"},{"start":1775.94,"end":1777.4,"text":"同一种东西"},{"start":1777.4,"end":1778.82,"text":"同一种哲学"},{"start":1783.78,"end":1786.84,"text":"他们是哲学的遗言论者"},{"start":1786.84,"end":1787.98,"text":"哲学本身"},{"start":1787.98,"end":1788.98,"text":"哲学这种活动"},{"start":1789.98,"end":1793.1,"text":"他内容载体内容可以不一样"},{"start":1793.1,"end":1797.46,"text":"但是这个活动在这些人看来都都是一种发骚发浪"},{"start":1797.46,"end":1799.84,"text":"然后追到一半就跟恋爱一样"},{"start":1799.84,"end":1803.28,"text":"这些人所理解的哲学就是神智的恋爱"},{"start":1803.28,"end":1805.85,"text":"神智围绕一个语词"},{"start":1806.56,"end":1809.84,"text":"一个辩护术"},{"start":1809.84,"end":1812.84,"text":"一个话语体系在发骚发牢"},{"start":1826.8,"end":1828.48,"text":"由于他们不再犹豫了"},{"start":1829.72,"end":1835.48,"text":"或者由于他们他是沉浸在只停留在同同一种流域当中"},{"start":1835.48,"end":1841.28,"text":"因为这样的