      "end": 753620,
      "index": 279
    },
    {
      "text": "比如葬礼啊",
      "start": 753620,
      "end": 754680,
      "index": 280
    },
    {
      "text": "都都都可以",
      "start": 754680,
      "end": 756480,
      "index": 281
    },
    {
      "text": "然后呢",
      "start": 756480,
      "end": 757020,
      "index": 282
    },
