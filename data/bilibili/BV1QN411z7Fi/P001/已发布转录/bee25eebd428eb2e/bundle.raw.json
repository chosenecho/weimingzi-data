{"segments":[{"start":0.12,"end":3.33,"text":"在我我下面讲的这段话呢"},{"start":3.33,"end":9.27,"text":"这个在前一个视频里面其实已经全都讲过了"},{"start":9.27,"end":10.5,"text":"但是我认为比较重要"},{"start":10.5,"end":11.94,"text":"我单独把它拿出来说啊"},{"start":11.94,"end":12.7,"text":"就是说"},{"start":14.44,"end":14.94,"text":"呃"},{"start":17.28,"end":19.98,"text":"我国啊这个"},{"start":22.38,"end":27.86,"text":"是有一些曾经他们是这个上层精英哦"},{"start":27.86,"end":31.96,"text":"然后他们是这个现在是落魄失势了的"},{"start":31.96,"end":34.21,"text":"那么这些精英层呢"},{"start":34.21,"end":37.18,"text":"它好多都其实是有一个"},{"start":37.52,"end":44.08,"text":"其实他们在人前表达的那种倾向是很明显的啊"},{"start":44.08,"end":45.07,"text":"挺明显的"},{"start":45.07,"end":47.68,"text":"就是他们在酒会上面就会吹嘘"},{"start":47.68,"end":49.9,"text":"自己在海外有什么别墅"},{"start":49.9,"end":52.95,"text":"自己的子女有多少张绿卡啊"},{"start":52.95,"end":54.9,"text":"然后自己早就什么护照"},{"start":54.9,"end":56.07,"text":"什么准备好的"},{"start":59.18,"end":62.469,"text":"那么这些人呢有一部分曾经啊"},{"start":62.469,"end":65.259,"text":"或者说以精英自居了啊"},{"start":65.259,"end":66.129,"text":"精英自居"},{"start":66.129,"end":67.479,"text":"也以某种方式呢"},{"start":67.479,"end":70.34,"text":"窃夺了我国的很多发展的一个果实"},{"start":71.22,"end":77.759,"text":"那么这些货色呢他们有一部分啊还留在境内"},{"start":77.98,"end":79.21,"text":"还留在境内"},{"start":79.21,"end":81.46,"text":"但身份已经出去了啊"},{"start":81.46,"end":82.81,"text":"身份已经出去了"},{"start":82.81,"end":85.54,"text":"但是那个就是身份出去"},{"start":85.54,"end":86.2,"text":"人不出去"},{"start":86.2,"end":87.24,"text":"还在境内"},{"start":88.98,"end":89.6,"text":"我说了"},{"start":89.6,"end":90.86,"text":"我以前是不是在苏州"},{"start":90.86,"end":92.9,"text":"在和一些什么这些人吃饭的时候"},{"start":92.9,"end":97.7,"text":"这些人他自己是啊搞什么精神文明呢"},{"start":98.78,"end":104.04,"text":"然后自己酒桌上就在不停的骂人啊"},{"start":104.04,"end":105.6,"text":"骂谁我就不说了啊"},{"start":105.6,"end":110.26,"text":"然后还不停的吹嘘自己是什么啊啊"},{"start":110.26,"end":112.09,"text":"随时随地他要出去就出去"},{"start":112.09,"end":113.74,"text":"然后他有好多护照什么的"},{"start":113.74,"end":116.02,"text":"吹这样吹牛的啊"},{"start":116.02,"end":116.86,"text":"很夸张的"},{"start":116.86,"end":118.15,"text":"非常夸张的"},{"start":118.15,"end":121.83,"text":"就说就就从这个渗透层面来讲来说"},{"start":121.83,"end":123.63,"text":"我们要坚决的反渗透"},{"start":123.63,"end":125.43,"text":"坚决地反对敌对势力"},{"start":125.43,"end":129.6,"text":"对我们的这个这些精英层的一种洗脑"},{"start":129.6,"end":131.34,"text":"控制价值观的洗脑啊"},{"start":131.34,"end":135.22,"text":"以及这个是什么财产身份关系上的控制"},{"start":136.52,"end":143.16,"text":"所以这个工作呢呃是我是非常呃欢迎赞同啊"},{"start":143.16,"end":144.87,"text":"去进行这样的一个工作的"},{"start":144.87,"end":147.7,"text":"但是说目前呃"},{"start":147.799,"end":149.719,"text":"我认为我的观点是"},{"start":149.719,"end":153.319,"text":"这样的工作应当由专业人士啊"},{"start":153.319,"end":157.34,"text":"应当加强进行这些工作的这个人员的"},{"start":157.34,"end":159.79,"text":"专业人员的专业素养啊"},{"start":159.79,"end":164.05,"text":"然后对他这里面的人员进行严格的这个淘汰"},{"start":164.05,"end":170.029,"text":"是啊和这个选拔不能简单的就是说"},{"start":170.029,"end":173.96,"text":"因为我们我甚至在知乎上看到有那种日子人"},{"start":173.96,"end":176.03,"text":"他纯粹就是一个小市民"},{"start":176.03,"end":179.66,"text":"他纯粹就是一个自私的个人主义的小市民"},{"start":179.66,"end":181.86,"text":"这种人呢知乎上还在问"},{"start":181.86,"end":184.8,"text":"他同时被这个苏州的电力系统"},{"start":184.8,"end":189.5,"text":"苏州电力系统是呃第一最待遇最好的嘛"},{"start":189.5,"end":193.28,"text":"然后说又同时被这个我刚刚所说的那个相关的"},{"start":193.28,"end":195.64,"text":"反渗透的这样的部门录取了"},{"start":195.64,"end":201.21,"text":"它就像在进行一个功利的待遇上的一个比较"},{"start":201.21,"end":202.68,"text":"这个纯粹是日子人"},{"start":202.68,"end":205.98,"text":"那么这种日子人就算他说没进电网"},{"start":205.98,"end":209.22,"text":"他去了这个这个这个这么一个"},{"start":209.22,"end":210.98,"text":"反渗透的一个部门"},{"start":211.06,"end":212.59,"text":"他有什么用啊"},{"start":212.59,"end":216.04,"text":"那么这种人呢他就纯粹是为了待遇"},{"start":216.04,"end":216.73,"text":"为了钱"},{"start":216.73,"end":217.78,"text":"他就是个日子人"},{"start":217.78,"end":218.8,"text":"过日子的"},{"start":218.8,"end":220.96,"text":"岁月静好的这种人"},{"start":220.96,"end":224.86,"text":"那么我觉得与其是啊"},{"start":224.86,"end":228.31,"text":"就是说这种人应当尽量调离这个岗位"},{"start":228.31,"end":230.709,"text":"或者说呢就把他裁汰掉"},{"start":230.709,"end":233.709,"text":"他没有那种刀头舔血舔舔血"},{"start":233.709,"end":236.88,"text":"没有那种紧张的那种急迫感的"},{"start":237.04,"end":241.42,"text":"没有那种自己身为强力部门的啊"},{"start":241.42,"end":243.34,"text":"内内务他应该不是内部"},{"start":243.34,"end":246.19,"text":"那呃内务也管"},{"start":246.19,"end":249.46,"text":"然后这个对外的也也管的啊"},{"start":249.46,"end":253.039,"text":"这种人呢绝对不能用这种岁月静好的日子"},{"start":253.039,"end":255.31,"text":"人啊啊"},{"start":255.31,"end":258.82,"text":"绝对是不能让他们过这样一种享乐主义的"},{"start":258.82,"end":259.99,"text":"消费主义的生活"},{"start":259.99,"end":261.61,"text":"打卡上班啊"},{"start":261.61,"end":263.559,"text":"然后是什么啊"},{"start":263.559,"end":265.779,"text":"周末了就去网红景点"},{"start":265.779,"end":267.06,"text":"就是吃喝玩乐"},{"start":267.18,"end":268.56,"text":"那人有什么用呢"},{"start":268.56,"end":269.19,"text":"对不对"},{"start":269.19,"end":271.5,"text":"那我所以我的观点啊"},{"start":272.199,"end":276.989,"text":"我的观点就是说我不建议走群众路线啊"},{"start":276.989,"end":278.879,"text":"因为这个是个很专业的"},{"start":278.879,"end":281.729,"text":"然后这个过程当中也是一个非常秘密的"},{"start":281.729,"end":284.12,"text":"非常缜密的啊"},{"start":284.159,"end":287.219,"text":"对不不建议走群众路线"},{"start":295.73,"end":296.93,"text":"这是可以的"},{"start":296.93,"end":300.89,"text":"但是说境外的这样一种间谍啊"},{"start":300.89,"end":303.46,"text":"或者说这样的一种渗透啊"},{"start":304.46,"end":309.16,"text":"它它的那个烈度不是不是什么诈骗级别的啊"},{"start":309.16,"end":311.04,"text":"它是很烈度很高的"},{"start":311.24,"end":314.12,"text":"尤其是不好进行这样一种"},{"start":317.64,"end":322.929,"text":"因为容易被对方利用啊"},{"start":322.929,"end":325.78,"text":"容易搞得人心惶惶"},{"start":325.8,"end":329.64,"text":"也容易就是说这样的这个调查啊"},{"start":329.64,"end":333.319,"text":"或者是那种用全民的方式啊"},{"start":333.319,"end":336.379,"text":"会使得一些手续啊不严格啊"},{"start":336.379,"end":342.589,"text":"会使得就啊是是专业度打折扣啊"},{"start":342.589,"end":343.879,"text":"这个反间谍法"},{"start":343.879,"end":347.089,"text":"它是要有有一个非常严格的一些法律的"},{"start":347.089,"end":348.229,"text":"一些程序的"},{"start":348.229,"end":351.88,"text":"依法的按照法治的方式去进行的"},{"start":351.88,"end":353.82,"text":"用全民来搞的话"},{"start":354.24,"end":356.4,"text":"民众也不知道怎么搜集证据"},{"st