{"segments":[{"start":0.0,"end":0.78,"text":"我们也要讲一个"},{"start":0.78,"end":4.92,"text":"就是说急需打破的"},{"start":7.44,"end":13.62,"text":"急切的非常最急切的打破了一条罪恶链条"},{"start":16.9,"end":19.8,"text":"我呼吁一切社会力量集中起来"},{"start":19.8,"end":21.3,"text":"打破这个罪恶链条"},{"start":21.3,"end":27.82,"text":"这个罪恶链条就叫做啊实质上的童工啊"},{"start":27.82,"end":28.92,"text":"实质上的"},{"start":31.28,"end":32.68,"text":"同工链条啊"},{"start":35.44,"end":38.24,"text":"未成年啊"},{"start":38.24,"end":41.96,"text":"那法律明确不允许你这个劳务派遣工"},{"start":41.96,"end":43.82,"text":"合同工不能是同工"},{"start":43.82,"end":48.76,"text":"但是呢现在很多学校中专啊"},{"start":48.76,"end":52.55,"text":"职中很多这种中专啊"},{"start":52.55,"end":53.5,"text":"职校"},{"start":55.1,"end":59.92,"text":"现在已经是可以说一些里面当中的腐败"},{"start":59.92,"end":61.33,"text":"堕落的啊"},{"start":61.33,"end":66.54,"text":"这个啊校长啊或者什么的啊"},{"start":66.54,"end":69.48,"text":"这个辅导员老师上线病狂"},{"start":69.48,"end":72.78,"text":"和一些劳务中介派遣公司啊"},{"start":72.8,"end":75.14,"text":"有着不可告人的啊"},{"start":75.14,"end":76.76,"text":"有什么不可告人就分钱呢"},{"start":76.76,"end":80.2,"text":"一个罪恶链条把人摇到"},{"start":80.2,"end":81.0,"text":"这个"},{"start":81.62,"end":87.71,"text":"可以说是我们据我们目前掌握的一手的信息啊"},{"start":87.71,"end":90.119,"text":"这是可以说是一件事"},{"start":90.82,"end":92.52,"text":"连轴转了啊"},{"start":92.52,"end":96.48,"text":"连轴转连轴转啊"},{"start":96.48,"end":98.19,"text":"连轴转啊"},{"start":98.19,"end":100.44,"text":"暑假有暑期工"},{"start":102.7,"end":111.98,"text":"暑期工这个这个事情呢适合近几年的学制紊乱"},{"start":113.54,"end":117.76,"text":"好近几年h我说这个东西一定要立刻拨乱"},{"start":117.76,"end":121.76,"text":"反正近几年疫情之下啊"},{"start":121.76,"end":124.22,"text":"疫情下学制紊乱"},{"start":124.22,"end":125.84,"text":"大学生还不上课了"},{"start":125.84,"end":126.86,"text":"对不对啊"},{"start":126.86,"end":131.56,"text":"那对于这个这些中专职校学生更是学之紊乱"},{"start":131.56,"end":133.54,"text":"他们什么时候上学"},{"start":133.54,"end":134.83,"text":"什么时候放假"},{"start":134.83,"end":136.24,"text":"就是非常混乱的"},{"start":136.24,"end":137.08,"text":"管理很混乱"},{"start":137.08,"end":137.95,"text":"学制紊乱"},{"start":137.95,"end":139.09,"text":"然后还有什么呢"},{"start":139.09,"end":140.72,"text":"产业衰退"},{"start":141.019,"end":142.759,"text":"产业衰退的一个背景下"},{"start":142.759,"end":146.779,"text":"用工成本或者说产业经营的风险啊"},{"start":146.779,"end":148.58,"text":"产业经营的风险很高"},{"start":152.26,"end":156.4,"text":"那他就要啊就是不是他的那个利润率无法维持"},{"start":158.269,"end":160.669,"text":"在产业衰退学之紊乱啊"},{"start":160.669,"end":163.009,"text":"经营风险斗争了这几年"},{"start":163.009,"end":165.28,"text":"疫情这几年3年啊"},{"start":165.28,"end":168.34,"text":"目前其实我们也是看就只是放开了"},{"start":168.34,"end":170.2,"text":"但疫情依然在延续啊"},{"start":170.22,"end":174.28,"text":"在这种情况下出现了一个极大的一个乱象"},{"start":176.399,"end":180.58,"text":"极大的乱象就是以文凭为要挟"},{"start":182.48,"end":190.199,"text":"为要挟啊啊这个中专职校送学生工到流水线上"},{"start":190.199,"end":193.46,"text":"已经到了一个连轴转的一个程度了"},{"start":193.46,"end":198.14,"text":"连轴转就是说实际上已经逼这些人逼着学生"},{"start":198.14,"end":201.699,"text":"这是一种这是一种强迫就业啊"},{"start":201.699,"end":203.1,"text":"这种强迫就业"},{"start":204.82,"end":208.78,"text":"这种强迫就业就是违背一些啊"},{"start":210.52,"end":213.4,"text":"甚至说连轴转"},{"start":215.059,"end":219.58,"text":"啊暑假漫长的暑期工啊"},{"start":219.58,"end":221.02,"text":"那么这个学制紊乱了嘛"},{"start":221.02,"end":222.76,"text":"啊这个啊节假日啊"},{"start":222.76,"end":227.569,"text":"上学放假在这几年就是就是17攻一打"},{"start":227.569,"end":231.06,"text":"打到个能够打到10月份"},{"start":231.06,"end":232.02,"text":"11月份"},{"start":232.02,"end":235.88,"text":"然后后面又立刻又是什么实习工啊"},{"start":235.88,"end":238.34,"text":"然后后面又变成寒假工"},{"start":239.66,"end":241.94,"text":"寒假工啊"},{"start":242.76,"end":245.3,"text":"这个年前年后的寒假工啊"},{"start":245.3,"end":246.74,"text":"年后还有寒年后"},{"start":246.74,"end":248.96,"text":"按道理要复学了啊"},{"start":248.96,"end":251.959,"text":"他这个学之紊乱不用去学校了"},{"start":251.959,"end":253.609,"text":"你继续在那边打工吧"},{"start":253.609,"end":257.599,"text":"我导致流水线上大量的都是啊"},{"start":257.599,"end":259.98,"text":"中专职校的在校生"},{"start":261.439,"end":264.819,"text":"在校生之前说的好听是中专职校学生"},{"start":264.819,"end":266.139,"text":"你妈说难听点"},{"start":266.139,"end":271.7,"text":"其他的那个他的那个学习阶段相当于高中啊"},{"start":272.759,"end":274.759,"text":"15 六七岁的样子啊"},{"start":276.079,"end":277.279,"text":"啊这个叫童工啊"},{"start":277.279,"end":278.4,"text":"未成年人"},{"start":278.8,"end":283.15,"text":"那么这个是这个是非常非常严重的社会问题"},{"start":283.15,"end":286.76,"text":"非常严重极为严重啊"},{"start":286.76,"end":288.56,"text":"你不要看好像看上去是哦"},{"start":288.56,"end":289.7,"text":"我用了一部分童工"},{"start":289.7,"end":290.89,"text":"但你已经违法了"},{"start":290.89,"end":292.27,"text":"这看上去不违法啊"},{"start":292.27,"end":293.23,"text":"我叫他实习"},{"start":293.23,"end":296.18,"text":"但实质上他不就是在那边连轴转的上班吗"},{"start":296.58,"end":298.049,"text":"工资很少"},{"start":298.049,"end":301.229,"text":"工资相比正式工而言少了啊"},{"start":301.229,"end":304.439,"text":"我要在医学这个啊"},{"start":304.439,"end":305.729,"text":"医学生那边"},{"start":305.729,"end":310.609,"text":"医药行业当中的这个这个这个这个这个规培生"},{"start":310.609,"end":312.9,"text":"只是这个现象的规培生啊"},{"start":312.9,"end":316.56,"text":"只是这个现象的一个一个个例而已"},{"start":316.56,"end":318.36,"text":"一个例子而已啊"},{"start":322.72,"end":324.28,"text":"就这些中专职校学生而言"},{"start":324.28,"end":327.26,"text":"他已经很普遍的出现了这种实质性同工"},{"start":327.44,"end":329.0,"text":"实质性同工啊"},{"start":329.0,"end":332.279,"text":"或者这样的强迫就业实质同工啊"},{"start":332.279,"end":333.239,"text":"强迫就业"},{"start":333.239,"end":336.749,"text":"而且是用他的这个学习啊"},{"start":336.749,"end":340.2,"text":"强迫就业这个状况呢"},{"start":340.2,"end":343.08,"text":"它是疫情这3年特殊状况之下"},{"start":345.24,"end":348.4,"text":"危机化的大规律所导致的啊"},{"start":350.8,"end":355.879,"text":"一定要一定要及时的快速的拨乱"},{"start":355.879,"end":359.46,"text":"反正否则这种情况远于连啊"},{"start":359.46,"end":361.32,"text":"吃到嘴巴里的肉好"},{"start":361.32,"end":364.38,"text":"他说或者说他一他通过这种强迫劳动"},{"start":364.38,"end":366.12,"text":"强迫就业啊"},{"start":366.12,"end":367.26,"text":"强迫不再就业"},{"start":367.26,"end":368.22,"text":"强迫劳动啊"},{"start":368.22,"end":371.979,"text":"强迫劳动实质性同工"},{"start":376.36,"end":380.05,"text":"其实只是维持了危机之前的"},{"start":380.05,"end":384.22,"text":"一个不那么高的资本增值率啊"},{"start":384.22,"end":389.08,"text":"资本增值率他增值率并没有多高啊"},{"start":389.08,"end":390.94,"text":"分值率并没有多高啊"},{"start":390.94,"end":392.44,"text":"所以他这个暴雪降不下来"},{"start":392.44,"end":395.34,"text":"所以他这个东西好像看上去就没法取消"},{"start":395.5,"end":397.72,"text":"这个纽带已经扭那么紧了啊"},{"start":397.72,"end":399.4,"text":"他松不了了啊"},{"start":399.4,"end":402.44,"text":"但是说我们要想尽一切办法啊"},{"start":402.44,"end":403.7,"text":"如果不想一切办法来"},{"start":403.7,"end":406.16,"text":"来把这个这个情况解决掉的话"},{"start":406.16,"end":410.58,"text":"那是巨大的变乱的变乱的啊"},{"start":411.16,"end":412.32,"text":"变乱的种子"},{"start":412.32,"end":414.12,"text":"这是个巨大的祸乱"},{"start":414.12,"end":415.23,"text":"由之而发"},{"start":415.23,"end":416.16,"text":"为什么"},{"start":416.16,"end":420.92,"text":"因为这些人这些人啊太年轻了"},{"start":422.84,"end":424.18,"text":"太年轻了"},{"start":425.86,"end":427.02,"text":"十几岁"},{"start":428.639,"end":430.579,"text":"这些人如果做了"},{"start":430.579,"end":432.379,"text":"因为被逼得走投无路"},{"start":432.379,"end":433.609,"text":"做了一些激进的事情"},{"start":433.609,"end":435.199,"text":"你说你是抓还是不抓"},{"start":435.199,"end":437.4,"text":"抓了之后你是胖还是不胖"},{"start":438.24,"end":439.43,"text":"窗还是不报"},{"start":439.43,"end":440.68,"text":"判还是不判"},{"start":441.319,"end":442.059,"text":"这个东西"},{"start":442.059,"end":445.78,"text":"代表着就是说你让这十几岁的孩子承担责任吗"},{"start":446.08,"end":448.3,"text":"那谁把他卖到这个产线上去的"},{"start":448.3,"end":451.54,"text":"或者说谁让他就说说没办法好好念了"},{"start":451.54,"end":453.46,"text":"这个技术培训"},{"start":453.46,"end":455.04,"text":"没办法好好接受了"},{"start":455.26,"end":461.02,"text":"闹的那么闹的就是说一块去闹着激进化了"},{"start":461.02,"end":463.66,"text":"闹着去盲目的去做一些"},{"start":463.74,"end":466.46,"text":"我要申请你们说违法犯罪的事儿了"},{"start":467.0,"end":469.25,"text":"你抓还是不怕判还是不判"},{"start":469.25,"end":472.43,"text":"这个东西是个非常难搞的东西啊"},{"start":472.43,"end":474.23,"text":"这个情况如果普遍化的话"},{"start":474.23,"end":478.71,"text":"那这个就会成为霍乱的啊"},{"start":478.71,"end":480.63,"text":"霍乱由此而生啊"},{"start":480.63,"end":482.37,"text":"祸乱由此而生也"},{"start":482.37,"end":486.48,"text":"而且这个东西我拿我实事求是"},{"start":486.48,"end":489.33,"text":"这样就是说同工现象的一个结局"},{"start":489.33,"end":491.04,"text":"同工现象的一个结