    },
    {
      "ordinal": 2,
      "start_ms": 4960,
      "end_ms": 7420,
      "text": "它是通过两三重东西"
    },
    {
      "ordinal": 3,
      "start_ms": 7420,
      "end_ms": 14300,
      "text": "它是通过三重三重机制来来来来压制来解除的"
    },
    {
      "ordinal": 4,
      "start_ms": 14300,
      "end_ms": 17159,
      "text": "不说压制来解除的啊"
    },
    {
      "ordinal": 5,
