{
  "bvid": "BV1dg411a7oC",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "be8debe98e687d82a36d181434f9c5ada2cd2b2769df2923b5d83fc39f65e84b",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 600,
      "end_ms": 2820,
      "text": "我们做一个简短的例行的批判"
    },
    {
      "ordinal": 1,
      "start_ms": 8138,
      "end_ms": 9659,
      "text": "当然他的他的伴侣"
    },
    {
      "ordinal": 2,
      "start_ms": 9659,
      "end_ms": 12239,
      "text": "他的妻子也是个臭名昭的自然级人物"
    },
    {
      "ordinal": 3,
      "start_ms": 13439,
      "end_ms": 15840,
      "text": "他们说什么人生总有风雨"
    },
    {
      "ordinal": 4,
      "start_ms": 17199,
      "end_ms": 20279,
      "text": "那个时间总要向前"
    },
    {
      "ordinal": 5,
      "start_ms": 20279,
      "end_ms": 21880,
      "text": "这两句话都是错的"
    },
    {
      "ordinal": 6,
      "start_ms": 21880,
      "end_ms": 23530,
      "text": "不是人生有风雨"
    },
    {
      "ordinal": 7,
      "start_ms": 23530,
      "end_ms": 26950,
      "text": "而是风雨就是历史的不稳定的变动"
    },
    {
      "ordinal": 8,
      "start_ms": 26950,
      "end_ms": 29440,
      "text": "它产生了人生风雨"
    },
    {
      "ordinal": 9,
      "start_ms": 29440,
      "end_ms": 30310,
      "text": "总有人生"
    },
    {
      "ordinal": 10,
      "start_ms": 33519,
      "end_ms": 36819,
      "text": "把人生看成是一个安宁安稳的一个持续状态"
    },
    {
      "ordinal": 11,
      "start_ms": 36819,
      "end_ms": 37479,
      "text": "稳定状态"
    },
    {
      "ordinal": 12,
      "start_ms": 37479,
      "end_ms": 39590,
      "text": "然后它会有扰动波动"
    },
    {
      "ordinal": 13,
      "start_ms": 39590,
      "end_ms": 41690,
      "text": "但实际上对于辩证唯物主义者"
    },
    {
      "ordinal": 14,
      "start_ms": 41690,
      "end_ms": 43170,
      "text": "对于我们来说"
    },
    {
      "ordinal": 15,
      "start_ms": 44910,
      "end_ms": 46830,
      "text": "不是是反过来是风雨"
    },
    {
      "ordinal": 16,
      "start_ms": 46830,
      "end_ms": 49559,
      "text": "有人生不稳定不安宁"
    },
    {
      "ordinal": 17,
      "start_ms": 49840,
      "end_ms": 52570,
      "text": "这种这种斗争冲突状态"
    },
    {
      "ordinal": 18,
      "start_ms": 52570,
      "end_ms": 53980,
      "text": "它是首要的"
    },
    {
      "ordinal": 19,
      "start_ms": 54240,
      "end_ms": 57090,
      "text": "它生产出来一个人生"
    },
    {
      "ordinal": 20,
      "start_ms": 57090,
      "end_ms": 58920,
      "text": "人生就是两方面"
    },
    {
      "ordinal": 21,
      "start_ms": 58920,
      "end_ms": 62120,
      "text": "一方面内在性内在自我中介体验过程"
    },
    {
      "ordinal": 22,
      "start_ms": 62120,
      "end_ms": 63920,
      "text": "剧烈的物质运动"
    },
    {
      "ordinal": 23,
      "start_ms": 67640,
      "end_ms": 72190,
      "text": "它产生出精神这种内在中介的啊自我意识"
    },
    {
      "ordinal": 24,
      "start_ms": 72190,
      "end_ms": 73810,
      "text": "人还有一个人生"
    },
    {
      "ordinal": 25,
      "start_ms": 73810,
      "end_ms": 75850,
      "text": "它是生活在人间的"
    },
    {
      "ordinal": 26,
      "start_ms": 75850,
      "end_ms": 78560,
      "text": "它产生出这个共同体"
    },
    {
      "ordinal": 27,
      "start_ms": 78560,
      "end_ms": 80470,
      "text": "相互之间的一种关联"
    },
    {
      "ordinal": 28,
      "start_ms": 80470,
      "end_ms": 82480,
      "text": "人与人之间的一种冲突纠葛"
    },
    {
      "ordinal": 29,
      "start_ms": 82480,
      "end_ms": 85270,
      "text": "他把那个宇宙物质位面"
    },
    {
      "ordinal": 30,
      "start_ms": 85270,
      "end_ms": 86080,
      "text": "不同位面"
    },
    {
      "ordinal": 31,
      "start_ms": 86080,
      "end_ms": 88560,
      "text": "不同位面的物质性力量的冲突"
    },
    {
      "ordinal": 32,
      "start_ms": 88560,
      "end_ms": 90450,
      "text": "经由内在性的中介"
    },
    {
      "ordinal": 33,
      "start_ms": 90450,
      "end_ms": 93440,
      "text": "他有个内在的一个自我意识的人"
    },
    {
      "ordinal": 34,
      "start_ms": 93440,
      "end_ms": 96940,
      "text": "它然后它变成人与人之间冲突"
    },
    {
      "ordinal": 35,
      "start_ms": 96940,
      "end_ms": 98200,
      "text": "变成社会冲突"
    },
    {
      "ordinal": 36,
      "start_ms": 98200,
      "end_ms": 102790,
      "text": "社会冲突是宇宙冲突的一个一个转化"
    },
    {
      "ordinal": 37,
      "start_ms": 102790,
      "end_ms": 105600,
      "text": "一个一个再呈现的啊"
    },
    {
      "ordinal": 38,
      "start_ms": 105600,
      "end_ms": 110160,
      "text": "社会冲突是这么一种宇宙冲突的一种呈现方式"
    },
    {
      "ordinal": 39,
      "start_ms": 110160,
      "end_ms": 112380,
      "text": "或者说是一个进一步的实现"
    },
    {
      "ordinal": 40,
      "start_ms": 112380,
      "end_ms": 114240,
      "text": "进一步的一个运转的一个方式"
    },
    {
      "ordinal": 41,
      "start_ms": 114240,
      "end_ms": 115770,
      "text": "另外一方面呢"
    },
    {
      "ordinal": 42,
      "start_ms": 115770,
      "end_ms": 119250,
      "text": "所以他就是说所以我们会认为风雨有人"
    },
    {
      "ordinal": 43,
      "start_ms": 119250,
      "end_ms": 120810,
      "text": "生先有风雨"
    },
    {
      "ordinal": 44,
      "start_ms": 120810,
      "end_ms": 123840,
      "text": "先有这个呃世界的物质性的运动"
    },
    {
      "ordinal": 45,
      "start_ms": 123840,
      "end_ms": 126000,
      "text": "然后再有人的内在性"
    },
    {
      "ordinal": 46,
      "start_ms": 126000,
      "end_ms": 126870,
      "text": "再有人的"
    },
    {
      "ordinal": 47,
      "start_ms": 126870,
      "end_ms": 128759,
      "text": "但是我们说社会性先于内在性"
    },
    {
      "ordinal": 48,
      "start_ms": 128759,
      "end_ms": 133520,
      "text": "或者说这种冲突之间的一种互相之间的这种纠葛纠缠啊"
    },
    {
      "ordinal": 49,
      "start_ms": 133520,
      "end_ms": 134780,
      "text": "彼此竞争啊"
    },
    {
      "ordinal": 50,
      "start_ms": 134780,
      "end_ms": 137400,
      "text": "以及它相互的一个协同的一个进步"
    },
    {
      "ordinal": 51,
      "start_ms": 137579,
      "end_ms": 139079,
      "text": "它生成的内在意识"
    },
    {
      "ordinal": 52,
      "start_ms": 139079,
      "end_ms": 143519,
      "text": "内在意识又展现为啊这个在处在群体社群啊"
    },
    {
      "ordinal": 53,
      "start_ms": 143519,
      "end_ms": 145600,
      "text": "社会结构当中的内在意识"
    },
    {
      "ordinal": 54,
      "start_ms": 145859,
      "end_ms": 147299,
      "text": "对风雨有人生"
    },
    {
      "ordinal": 55,
      "start_ms": 147299,
      "end_ms": 150840,
      "text": "另外一方面就是说他说时间总会向前"
    },
    {
      "ordinal": 56,
      "start_ms": 150840,
      "end_ms": 151740,
      "text": "这又是错的"
    },
    {
      "ordinal": 57,
      "start_ms": 151740,
      "end_ms": 155400,
      "text": "他又幻想就是他所处的也是他这种时间能够向前"
    },
    {
      "ordinal": 58,
      "start_ms": 157140,
      "end_ms": 160190,
      "text": "或者说是一种非常错的劣质的一个时间观"
    },
    {
      "ordinal": 59,
      "start_ms": 160190,
      "end_ms": 162530,
      "text": "时间并不是从当下"
    },
    {
      "ordinal": 60,
      "start_ms": 162530,
      "end_ms": 165400,
      "text": "并不是从这儿或者当不了那present"
    },
    {
      "ordinal": 61,
      "start_ms": 165400,
      "end_ms": 166600,
      "text": "不是从在场"
    },
    {
      "ordinal": 62,
      "start_ms": 166600,
      "end_ms": 169120,
      "text": "从现在出发到到前面去"
    },
    {
      "ordinal": 63,
      "start_ms": 169120,
      "end_ms": 171580,
      "text": "时间总会像检查一切历史的旧账"
    },
    {
      "ordinal": 64,
      "start_ms": 171580,
      "end_ms": 173630,
      "text": "一切这她的丈夫出轨啊"
    },
    {
      "ordinal": 65,
      "start_ms": 173630,
      "end_ms": 176490,
      "text": "那种淘这种各种肮脏的这种丑陋的东西"
    },
    {
      "ordinal": 66,
      "start_ms": 176490,
      "end_ms": 177720,
      "text": "都会被历史遗忘"
    },
    {
      "ordinal": 67,
      "start_ms": 177720,
      "end_ms": 179190,
      "text": "历史变成他垃圾堆的"
    },
    {
      "ordinal": 68,
      "start_ms": 179190,
      "end_ms": 181990,
      "text": "我靠焚化炉焚尸炉啊"
    },
    {
      "ordinal": 69,
      "start_ms": 181990,
      "end_ms": 184030,
      "text": "这个是很肮脏的一个历史观"
    },
    {
      "ordinal": 70,
      "start_ms": 184030,
      "end_ms": 187030,
      "text": "自然界的罪恶就完全就是只要时间一直运动"
    },
    {
      "ordinal": 71,
      "start_ms": 187030,
      "end_ms": 188280,
      "text": "就可以忽略不计"
    },
    {
      "ordinal": 72,
      "start_ms": 188280,
      "end_ms": 192160,
      "text": "都是一个逃避逃避他的历史罪责的一种啊"
    },
    {
      "ordinal": 73,
      "start_ms": 192160,
      "end_ms": 193600,
      "text": "史观时间观"
    },
    {
      "ordinal": 74,
      "start_ms": 193600,
      "end_ms": 198779,
      "text": "那我们的观点就是说时间不是向前的"
    },
    {
      "ordinal": 75,
      "start_ms": 198779,
      "end_ms": 201059,
      "text": "时间是向后运动的"
    },
    {
      "ordinal": 76,
      "start_ms": 201059,
      "end_ms": 204580,
      "text": "或者说未来在抵达当下"
    },
    {
      "ordinal": 77,
      "start_ms": 205839,
      "end_ms": 208089,
      "text": "我有没有猜出来嗯"
    },
    {
      "ordinal": 78,
      "start_ms": 208089,
      "end_ms": 212599,
      "text": "就这个历史性的力量啊"
    },
    {
      "ordinal": 79,
      "start_ms": 212599,
      "end_ms": 215149,
      "text": "它在不停地抵达当下"
    },
    {
      "ordinal": 80,
      "start_ms": 215149,
      "end_ms": 222100,
      "text": "或者说我们我我们所说的未来是指的是是指的是整个宇宙或者历史"
    },
    {
      "ordinal": 81,
      "start_ms": 222100,
      "end_ms": 223420,
      "text": "整个本体论结构"
    },
    {
      "ordinal": 82,
      "start_ms": 223420,
      "end_ms": 224800,
      "text": "它的那种"
    },
    {
      "ordinal": 83,
      "start_ms": 230010,
      "end_ms": 232500,
      "text": "这些事件会抵达当下"
    },
    {
      "ordinal": 84,
      "start_ms": 232500,
      "end_ms": 235020,
      "text": "他是从未来抵达到当下"
    },
    {
      "ordinal": 85,
      "start_ms": 235020,
      "end_ms": 236900,
      "text": "我们是在迎接未来"
    },
    {
      "ordinal": 86,
      "start_ms": 236900,
      "end_ms": 237740,
      "text": "是时间"
    },
    {
      "ordinal": 87,
      "start_ms": 237740,
      "end_ms": 242480,
      "text": "从未来到现在来发生降落在现实当中"
    },
    {
      "ordinal": 88,
      "start_ms": 242519,
      "end_ms": 245069,
      "text": "时间是从未来到这儿来的"
    },
    {
      "ordinal": 89,
      "start_ms": 245069,
      "end_ms": 247199,
      "text": "这里是它就是它像一个天空"
    },
    {
      "ordinal": 90,
      "start_ms": 247199,
      "end_ms": 250110,
      "text": "它降落伞降落在降落在当下"
    },
    {
      "ordinal": 91,
      "start_ms": 250110,
      "end_ms": 250950,
      "text": "明白了吗"
    },
    {
      "ordinal": 92,
      "start_ms": 250950,
      "end_ms": 253200,
      "text": "并不是说我们在往前走"
    },
    {
      "ordinal": 93,
      "start_ms": 253200,
      "end_ms": 259738,
      "text": "历史现实就他是呃在这个上我们我喜欢说是展开"
    },
    {
      "ordinal": 94,
      "start_ms": 259738,
      "end_ms": 260600,
      "text": "你懂吗"
    },
    {
      "ordinal": 95,
      "start_ms": 261060,
      "end_ms": 267080,
      "text": "绽开从天空当中绽放到绽放到现实当中啊"
    },
    {
      "ordinal": 96,
      "start_ms": 267080,
      "end_ms": 269580,
      "text": "我们不能什么时间观要扭转一下"
    },
    {
      "ordinal": 97,
      "start_ms": 269780,
      "end_ms": 274100,
      "text": "那就是历史的必然性在从未来向我们招显啊"
    },
    {
      "ordinal": 98,
      "start_ms": 274100,
      "end_ms": 277260,
      "text": "未来在成为当下"
    },
    {
      "ordinal": 99,
      "start_ms": 278100,
      "end_ms": 280640,
      "text": "这两种说法是有决定性的差别的"
    },
    {
      "ordinal": 100,
      "start_ms": 280640,
      "end_ms": 282080,
      "text": "未来在成为当下"
    },
    {
      "ordinal": 101,
      "start_ms": 291150,
      "end_ms": 292500,
      "text": "就是也就是过去"
    },
    {
      "ordinal": 102,
      "start_ms": 292500,
      "end_ms": 294810,
      "text": "就我们这个时候要重新理解历史"
    },
    {
      "ordinal": 103,
      "start_ms": 294810,
      "end_ms": 296280,
      "text": "重新理解什么叫过去"
    },
    {
      "ordinal": 104,
      "start_ms": 296280,
      "end_ms": 300000,
      "text": "过去不是说是个垃圾走被遗忘的焚尸炉"
    },
    {
      "ordinal": 105,
      "start_ms": 300000,
      "end_ms": 301020,
      "text": "什么东西"
    },
    {
      "ordinal": 106,
      "start_ms": 301020,
      "end_ms": 302340,
      "text": "离他只要够远"
    },
    {
      "ordinal": 107,
      "start_ms": 302340,
      "end_ms": 304140,
      "text": "他就看看不见的叫过去"
    },
    {
      "ordinal": 108,
      "start_ms": 304140,
      "end_ms": 304700,
      "text": "不是的"
    },
    {
      "ordinal": 109,
      "start_ms": 304700,
      "end_ms": 309380,
      "text": "过去是未能够成功降落在当下的未来"
    },
    {
      "ordinal": 110,
      "start_ms": 310060,
      "end_ms": 311970,
      "text": "是我们措施的"
    },
    {
      "ordinal": 111,
      "start_ms": 311970,
      "end_ms": 312960,
      "text": "懂了吧"
    },
    {
      "ordinal": 112,
      "start_ms": 312960,
      "end_ms": 314739,
      "text": "是一些啊拯救性的"
    },
    {
      "ordinal": 113,
      "start_ms": 314739,
      "end_ms": 317139,
      "text": "绝对绝对的一些拯救性的"
    },
    {
      "ordinal": 114,
      "start_ms": 317139,
      "end_ms": 318669,
      "text": "解放性的一些契机"
    },
    {
      "ordinal": 115,
      "start_ms": 318669,
      "end_ms": 320559,
      "text": "我们未能成功把握它"
    },
    {
      "ordinal": 116,
      "start_ms": 320559,
      "end_ms": 323180,
      "text": "这些东西被我们遗忘了"
    },
    {
      "ordinal": 117,
      "start_ms": 323180,
      "end_ms": 325890,
      "text": "沉沦在一个历史的无意识当中"
    },
    {
      "ordinal": 118,
      "start_ms": 325890,
      "end_ms": 327210,
      "text": "就所谓的过去"
    },
    {
      "ordinal": 119,
      "start_ms": 327210,
      "end_ms": 330330,
      "text": "但是他并没有就是说离我们越来越远"
    },
    {
      "ordinal": 120,
      "start_ms": 330330,
      "end_ms": 331180,
      "text": "越来越远"
    },
    {
      "ordinal": 121,
      "start_ms": 339900,
      "end_ms": 345639,
      "text": "它被我们的我们曾经的懦弱无能"
    },
    {
      "ordinal": 122,
      "start_ms": 345639,
      "end_ms": 350700,
      "text": "或者说历史的一些它本身的一些无力僵局被辜负了"
    },
    {
      "ordinal": 123,
      "start_ms": 350700,
      "end_ms": 351900,
      "text": "被背叛了"
    },
    {
      "ordinal": 124,
      "start_ms": 351900,
      "end_ms": 353220,
      "text": "他沉寂了"
    },
    {
      "ordinal": 125,
      "start_ms": 353220,
      "end_ms": 356060,
      "text": "它是一些过去消"
    },
    {
      "ordinal": 126,
      "start_ms": 356060,
      "end_ms": 358520,
      "text": "但是他没有说他完全消灭的"
    },
    {
      "ordinal": 127,
      "start_ms": 358520,
      "end_ms": 359420,
      "text": "它不会消弭的"
    },
    {
      "ordinal": 128,
      "start_ms": 359420,
      "end_ms": 361180,
      "text": "他会在未来等着我们"
    },
    {
      "ordinal": 129,
      "start_ms": 361219,
      "end_ms": 363229,
      "text": "所以说他会重复他自己"
    },
    {
      "ordinal": 130,
      "start_ms": 363229,
      "end_ms": 364219,
      "text": "他会重新降临"
    },
    {
      "ordinal": 131,
      "start_ms": 364219,
      "end_ms": 365269,
      "text": "做未来降临"
    },
    {
      "ordinal": 132,
      "start_ms": 365269,
      "end_ms": 367500,
      "text": "所以我们我们始终要说的说"
    },
    {
      "ordinal": 133,
      "start_ms": 367599,
      "end_ms": 369639,
      "text": "作为未来啊"
    },
    {
      "ordinal": 134,
      "start_ms": 369639,
      "end_ms": 371400,
      "text": "降临在当下"
    },
    {
      "ordinal": 135,
      "start_ms": 371620,
      "end_ms": 374950,
      "text": "迎面朝我们而来的这些未来"
    },
    {
      "ordinal": 136,
      "start_ms": 374950,
      "end_ms": 377440,
      "text": "其实很多是那些被压抑"
    },
    {
      "ordinal": 137,
      "start_ms": 377440,
      "end_ms": 378540,
      "text": "被掩盖"
    },
    {
      "ordinal": 138,
      "start_ms": 378840,
      "end_ms": 381600,
      "text": "被辜负的过去"
    },
    {
      "ordinal": 139,
      "start_ms": 381600,
      "end_ms": 382410,
      "text": "明白吗"
    },
    {
      "ordinal": 140,
      "start_ms": 382410,
      "end_ms": 386430,
      "text": "就是说这些过去并不是简简单单你体验过的东西叫过去"
    },
    {
      "ordinal": 141,
      "start_ms": 386430,
      "end_ms": 393770,
      "text": "而是说你曾经未能够完整的彻底的体验的叫做过去"
    },
    {
      "ordinal": 142,
      "start_ms": 393770,
      "end_ms": 395400,
      "text": "they are the past"
    },
    {
      "ordinal": 143,
      "start_ms": 395680,
      "end_ms": 397000,
      "text": "被辜负的"
    },
    {
      "ordinal": 144,
      "start_ms": 397000,
      "end_ms": 397840,
      "text": "被忽略的"
    },
    {
      "ordinal": 145,
      "start_ms": 397840,
      "end_ms": 399640,
      "text": "被遗忘的啊"
    },
    {
      "ordinal": 146,
      "start_ms": 399640,
      "end_ms": 400860,
      "text": "那就叫过去"
    },
    {
      "ordinal": 147,
      "start_ms": 402440,
      "end_ms": 404060,
      "text": "那就讲到这里啊"
    },
    {
      "ordinal": 148,
      "start_ms": 404740,
      "end_ms": 406500,
      "text": "所以所以我最后总结一下"
    },
    {
      "ordinal": 149,
      "start_ms": 406500,
      "end_ms": 412120,
      "text": "所以说我们的这个呃伦理学或者生存的方式啊"
    },
    {
      "ordinal": 150,
      "start_ms": 412120,
      "end_ms": 416000,
      "text": "就是说你要彻底的终结这个未来啊"
    },
    {
      "ordinal": 151,
      "start_ms": 416000,
      "end_ms": 417980,
      "text": "尽可能的尽一切可能性"
    },
    {
      "ordinal": 152,
      "start_ms": 417980,
      "end_ms": 420440,
      "text": "尽力的彻底终结未来啊"
    },
    {
      "ordinal": 153,
      "start_ms": 420440,
      "end_ms": 422040,
      "text": "不让它成为过去"
    },
    {
      "ordinal": 154,
      "start_ms": 422440,
      "end_ms": 423400,
      "text": "是未来"
    },
    {
      "ordinal": 155,
      "start_ms": 423400,
      "end_ms": 424330,
      "text": "成为过去"
    },
    {
      "ordinal": 156,
      "start_ms": 424330,
      "end_ms": 425980,
      "text": "而不是过去成为未来"
    },
    {
      "ordinal": 157,
      "start_ms": 425980,
      "end_ms": 427060,
      "text": "这是我们时间观"
    },
    {
      "ordinal": 158,
      "start_ms": 427060,
      "end_ms": 431920,
      "text": "我们时间观是未来成为过去的过去"
    },
    {
      "ordinal": 159,
      "start_ms": 431920,
      "end_ms": 437020,
      "text": "我只说未来和过去在我们这里都代表一种未被本体论中介"
    },
    {
      "ordinal": 160,
      "start_ms": 437020,
      "end_ms": 440500,
      "text": "没有合法的出现的呈现出来"
    },
    {
      "ordinal": 161,
      "start_ms": 440500,
      "end_ms": 444580,
      "text": "没有合法的被被体验的那些钱"
    },
    {
      "ordinal": 162,
      "start_ms": 444580,
      "end_ms": 445660,
      "text": "本体论的力量"
    },
    {
      "ordinal": 163,
      "start_ms": 445660,
      "end_ms": 448240,
      "text": "我们把它叫未来和和过去"
    },
    {
      "ordinal": 164,
      "start_ms": 448880,
      "end_ms": 451420,
      "text": "当当下现前的被体验到的"
    },
    {
      "ordinal": 165,
      "start_ms": 451420,
      "end_ms": 454360,
      "text": "被中介的被感受到的这些表象化这些东西"
    },
    {
      "ordinal": 166,
      "start_ms": 454360,
      "end_ms": 457060,
      "text": "它是所谓的在本体论架构内部的"
    },
    {
      "ordinal": 167,
      "start_ms": 457060,
      "end_ms": 459760,
      "text": "但是说就算是在本体论架构内部的"
    },
    {
      "ordinal": 168,
      "start_ms": 459760,
      "end_ms": 462160,
      "text": "这些本体论架构本身也有内在的不一致性"
    },
    {
      "ordinal": 169,
      "start_ms": 462160,
      "end_ms": 462700,
      "text": "也是不停的"
    },
    {
      "ordinal": 170,
      "start_ms": 462700,
      "end_ms": 463720,
      "text": "只要超出他自己的"
    },
    {
      "ordinal": 171,
      "start_ms": 463720,
      "end_ms": 466840,
      "text": "所以哪怕是一个完整的良性运行"
    },
    {
      "ordinal": 172,
      "start_ms": 466840,
      "end_ms": 467800,
      "text": "那个本体的架构"
    },
    {
      "ordinal": 173,
      "start_ms": 467800,
      "end_ms": 470390,
      "text": "它在现实当中啊"
    },
    {
      "ordinal": 174,
      "start_ms": 470390,
      "end_ms": 472580,
      "text": "运行呈呈现展开的时候"
    },
    {
      "ordinal": 175,
      "start_ms": 472580,
      "end_ms": 474710,
      "text": "它也要花时间"
    },
    {
      "ordinal": 176,
      "start_ms": 474710,
      "end_ms": 478800,
      "text": "并且在空间的一个并列的场当中"
    },
    {
      "ordinal": 177,
      "start_ms": 478800,
      "end_ms": 481500,
      "text": "这个厂是有内在的自我矛盾的"
    },
    {
      "ordinal": 178,
      "start_ms": 481500,
      "end_ms": 485880,
      "text": "就是场合它所呈现的东西之间有个二分的张力的"
    },
    {
      "ordinal": 179,
      "start_ms": 485960,
      "end_ms": 488390,
      "text": "前景和背景呢是有差别的"
    },
    {
      "ordinal": 180,
      "start_ms": 488390,
      "end_ms": 490520,
      "text": "所以差别本身不能够作为前景"
    },
    {
      "ordinal": 181,
      "start_ms": 490520,
      "end_ms": 492240,
      "text": "也不能作为背景呈现"
    },
    {
      "ordinal": 182,
      "start_ms": 492240,
      "end_ms": 495600,
      "text": "或者他这些差别本身有的时候会被当成这个背景"
    },
    {
      "ordinal": 183,
      "start_ms": 495600,
      "end_ms": 498400,
      "text": "它是有它内在辨证的不一致性的"
    },
    {
      "ordinal": 184,
      "start_ms": 498900,
      "end_ms": 504540,
      "text": "所以对我们指指我们这样的历史唯物主义的历史观"
    },
    {
      "ordinal": 185,
      "start_ms": 504540,
      "end_ms": 505740,
      "text": "时间观的人而言"
    },
    {
      "ordinal": 186,
      "start_ms": 505740,
      "end_ms": 509960,
      "text": "时间是从未来到过去"
    },
    {
      "ordinal": 187,
      "start_ms": 511940,
      "end_ms": 513520,
      "text": "从未来到过去的"
    },
    {
      "ordinal": 188,
      "start_ms": 513520,
      "end_ms": 515980,
      "text": "在这个过程当中被中介的部分"
    },
    {
      "ordinal": 189,
      "start_ms": 515980,
      "end_ms": 517929,
      "text": "我们称之为它的现实"
    },
    {
      "ordinal": 190,
      "start_ms": 517929,
      "end_ms": 520000,
      "text": "或者成为他的当下"
    },
    {
      "ordinal": 191,
      "start_ms": 521020,
      "end_ms": 521970,
      "text": "看见吗"
    },
    {
      "ordinal": 192,
      "start_ms": 524580,
      "end_ms": 527200,
      "text": "他就认为这个是风雨"
    },
    {
      "ordinal": 193,
      "start_ms": 527200,
      "end_ms": 528400,
      "text": "人生有风雨"
    },
    {
      "ordinal": 194,
      "start_ms": 528400,
      "end_ms": 529420,
      "text": "一个安宁的一个东西"
    },
    {
      "ordinal": 195,
      "start_ms": 529420,
      "end_ms": 532180,
      "text": "它会发现剧烈的不确定的一个变动"
    },
    {
      "ordinal": 196,
      "start_ms": 534400,
      "end_ms": 538210,
      "text": "时间时间总是向前的"
    },
    {
      "ordinal": 197,
      "start_ms": 538210,
      "end_ms": 541690,
      "text": "他是一个虚假的一个进步主义的一个一个自由主义"
    },
    {
      "ordinal": 198,
      "start_ms": 541690,
      "end_ms": 544210,
      "text": "宽容主义的一个一个一个价值观"
    },
    {
      "ordinal": 199,
      "start_ms": 544210,
      "end_ms": 546010,
      "text": "所以我们在他的这两句话里面"
    },
    {
      "ordinal": 200,
      "start_ms": 551230,
      "end_ms": 553260,
      "text": "什么liberalism"
    },
    {
      "ordinal": 201,
      "start_ms": 553260,
      "end_ms": 555750,
      "text": "满着自由主义实际上是同一个东西"
    },
    {
      "ordinal": 202,
      "start_ms": 555750,
      "end_ms": 556939,
      "text": "同一个东西"
    },
    {
      "ordinal": 203,
      "start_ms": 564110,
      "end_ms": 564710,
      "text": "人生观"
    },
    {
      "ordinal": 204,
      "start_ms": 564710,
      "end_ms": 565250,
      "text": "世界观"
    },
    {
      "ordinal": 205,
      "start_ms": 565250,
      "end_ms": 568320,
      "text": "历史观是彻底对立的啊"
    },
    {
      "ordinal": 206,
      "start_ms": 568320,
      "end_ms": 568920,
      "text": "彻底对立"
    },
    {
      "ordinal": 207,
      "start_ms": 568920,
      "end_ms": 570510,
      "text": "但是我们不需要非常"
    },
    {
      "ordinal": 208,
      "start_ms": 570510,
      "end_ms": 573480,
      "text": "我们只要把它的词的顺序改一改就行了好吧"
    },
    {
      "ordinal": 209,
      "start_ms": 576160,
      "end_ms": 578110,
      "text": "那他们的生活如此可笑"
    },
    {
      "ordinal": 210,
      "start_ms": 578110,
      "end_ms": 580480,
      "text": "呵呵我都不想承认那个是我的什么"
    },
    {
      "ordinal": 211,
      "start_ms": 580480,
      "end_ms": 581200,
      "text": "江苏老乡"
    },
    {
      "ordinal": 212,
      "start_ms": 581200,
      "end_ms": 583760,
      "text": "苏北老乡还是荒诞可笑的"
    },
    {
      "ordinal": 213,
      "start_ms": 583760,
      "end_ms": 586620,
      "text": "人生不只值一提不值一提"
    },
    {
      "ordinal": 214,
      "start_ms": 586900,
      "end_ms": 589859,
      "text": "他们的名字会被历史彻底的遗忘"
    },
    {
      "ordinal": 215,
      "start_ms": 590560,
      "end_ms": 593020,
      "text": "我我其实我有点那个"
    },
    {
      "ordinal": 216,
      "start_ms": 593020,
      "end_ms": 595600,
      "text": "但是所以我不会听他的名字好"
    },
    {
      "ordinal": 217,
      "start_ms": 595600,
      "end_ms": 596480,
      "text": "那就讲到这里啊"
    }
