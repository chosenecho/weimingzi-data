  "content_sha256": "06d85f6295ce4a5f6e3dd80520d1e5a91a20555f773a102b7a960fa67c207932",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 1840,
      "end_ms": 3840,
      "text": "来唱首歌啊。"
    },
    {
      "ordinal": 1,
      "start_ms": 15040,
      "end_ms": 22000,
      "text": "在山间，清清泉水悠悠空鸣。"
    },
    {
      "ordinal": 2,
      "start_ms": 24560,
      "end_ms": 28640,
      "text": "初升前笑苍狼，慢慢作息。"
    },
    {
      "ordinal": 3,
      "start_ms": 31120,
      "end_ms": 34960,
      "text": "云之清溪何日纷纷而来？"
    },
    {
      "ordinal": 4,
      "start_ms": 38160,
      "end_ms": 47120,
      "text": "青山欲与知，同谁人笑？因何事哭？"
    },
    {
      "ordinal": 5,
      "start_ms": 48480,
      "end_ms": 54880,
      "text": "看丛中红妆一袭，却了玉容尘埃。"
    },
    {
      "ordinal": 6,
      "start_ms": 55520,
      "end_ms": 60800,
      "text": "风谷中归来，应是佳人待何婚？"
    },
    {
      "ordinal": 7,
      "start_ms": 60800,
      "end_ms": 65440,
      "text": "日暮一宿住，何处去？又何处寻？"
    },
    {
      "ordinal": 8,
      "start_ms": 65760,
      "end_ms": 68640,
      "text": "我心他妈的太恶心了，把它删了。"
    },
    {
      "ordinal": 9,
      "start_ms": 68880,
      "end_ms": 80800,
      "text": "啊，你们可以可以不删，太娘了，删了。"
    },
    {
      "ordinal": 10,
      "start_ms": 83680,
      "end_ms": 92880,
      "text": "就是君，君，这个应该是女生来唱。何处寻？"
    },
    {
      "ordinal": 11,
      "start_ms": 93360,
      "end_ms": 94400,
      "text": "对，应该女生来唱。"
    },
    {
      "ordinal": 12,
      "start_ms": 100560,
      "end_ms": 109200,
      "text": "在云间，飘飘如影，轻轻坠远。你也可以唱出来啊。"
    },
    {
      "ordinal": 13,
      "start_ms": 110080,
      "end_ms": 114000,
      "text": "出云间，映沧海，残照依然。"
    },
    {
      "ordinal": 14,
      "start_ms": 116640,
      "end_ms": 120800,
      "text": "人世不易，何时秋光已老？"
    },
    {
      "ordinal": 15,
      "start_ms": 123360,
      "end_ms": 132400,
      "text": "明月笑我痴，同谁人笑？因何事哭？"
    },
    {
      "ordinal": 16,
      "start_ms": 133920,
      "end_ms": 140480,
      "text": "看丛中红妆一袭，却了玉容尘埃。"
    },
    {
      "ordinal": 17,
      "start_ms": 140960,
      "end_ms": 146080,
      "text": "风谷中归来，是我佳人待何婚？"
    },
    {
      "ordinal": 18,
      "start_ms": 146320,
      "end_ms": 150960,
      "text": "日暮一宿住，何处去？又何处寻？"
    },
    {
      "ordinal": 19,
      "start_ms": 151280,
      "end_ms": 153600,
      "text": "我身在人间独徘徊。"
    },
    {
      "ordinal": 20,
      "start_ms": 154080,
      "end_ms": 161360,
      "text": "风谷中的人已绝世而立，应笑我华发未老。"
    },
    {
      "ordinal": 21,
      "start_ms": 161600,
      "end_ms": 166480,
      "text": "纵观青天晚，醉罗汉徘徊还是徘徊啊？"
    },
    {
      "ordinal": 22,
      "start_ms": 167280,
      "end_ms": 172240,
      "text": "风谷中归来，逆水越天心待何婚？"
    },
    {
      "ordinal": 23,
      "start_ms": 172640,
      "end_ms": 175600,
      "text": "日暮一宿住，何处去？"
    },
    {
      "ordinal": 24,
      "start_ms": 175899,
      "end_ms": 179979,
      "text": "又何处寻那清风不改旧桃花？"
    },
    {
      "ordinal": 25,
      "start_ms": 180459,
      "end_ms": 191819,
      "text": "风骨中的人，以绝世而立，应笑我发花未老，纵观晴天晚，催落寒。"
    },
    {
      "ordinal": 26,
      "start_ms": 193499,
      "end_ms": 202219,
      "text": "待开时，空留白发一簪。"
    },
    {
      "ordinal": 27,
      "start_ms": 204939,
      "end_ms": 207899,
      "text": "啊，好，就这首歌啊，"
    },
    {
      "ordinal": 28,
      "start_ms": 209179,
      "end_ms": 211899,
      "text": "唱的不是那么严肃啊，他他不是这个意思。"
    },
    {
      "ordinal": 29,
      "start_ms": 213419,
      "end_ms": 214859,
      "text": "祝大家春节快乐。"
    }
  ],
  "text": "来唱首歌啊。\n在山间，清清泉水悠悠空鸣。\n初升前笑苍狼，慢慢作息。\n云之清溪何日纷纷而来？\n青山欲与知，同谁人笑？因何事哭？\n看丛中红妆一袭，却了玉容尘埃。\n风谷中归来，应是佳人待何婚？\n日暮一宿住，何处去？又何处寻？\n我心他妈的太恶心了，把它删了。\n啊，你们可以可以不删，太娘了，删了。\n就是君，君，这个应该是女生来唱。何处寻？\n对，应该女生来唱。\n在云间，飘飘如影，轻轻坠远。你也可以唱出来啊。\n出云间，映沧海，残照依然。\n人世不易，何时秋光已老？\n明月笑我痴，同谁人笑？因何事哭？\n看丛中红妆一袭，却了玉容尘埃。\n风谷中归来，是我佳人待何婚？\n日暮一宿住，何处去？又何处寻？\n我身在人间独徘徊。\n风谷中的人已绝世而立，应笑我华发未老。\n纵观青天晚，醉罗汉徘徊还是徘徊啊？\n风谷中归来，逆水越天心待何婚？\n日暮一宿住，何处去？\n又何处寻那清风不改旧桃花？\n风骨中的人，以绝世而立，应笑我发花未老，纵观晴天晚，催落寒。\n待开时，空留白发一簪。\n啊，好，就这首歌啊，\n唱的不是那么严肃啊，他他不是这个意思。\n祝大家春节快乐。",
  "timing_issue": null
}
