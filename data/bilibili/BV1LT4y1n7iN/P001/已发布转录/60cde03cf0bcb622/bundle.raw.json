{"segments":[{"start":1.14,"end":2.75,"text":"他说"},{"start":3.63,"end":4.55,"text":"写这封信"},{"start":4.55,"end":7.55,"text":"问当今的星星之火在何方"},{"start":8.75,"end":11.26,"text":"巴勒斯坦今年18岁"},{"start":11.26,"end":13.06,"text":"早两年接触马克思主义"},{"start":13.06,"end":16.46,"text":"不久就去苏州中介寻真理"},{"start":16.46,"end":20.24,"text":"学习中越来越发现会陷入雪里的空转"},{"start":20.24,"end":24.26,"text":"他就在什么零社会经验基础上去苏州打工"},{"start":24.26,"end":26.81,"text":"原始资金来自于压岁钱"},{"start":26.81,"end":28.91,"text":"爸妈以前给压岁钱"},{"start":29.19,"end":30.95,"text":"他第一次步入社会"},{"start":30.95,"end":32.99,"text":"就坚持和劳动者站在一边"},{"start":32.99,"end":34.64,"text":"问你首先和自己站在一边吧"},{"start":34.64,"end":36.89,"text":"坚持劳动者尊严的底色"},{"start":36.89,"end":38.685,"text":"将自己无产化"},{"start":38.71,"end":41.17,"text":"不是你本来就他妈去打工了"},{"start":41.17,"end":43.27,"text":"还弄得好像把自己无知"},{"start":43.27,"end":45.93,"text":"你本来也不是小资产阶级"},{"start":46.39,"end":47.49,"text":"因为不这样"},{"start":47.49,"end":48.81,"text":"或者没有这种决心"},{"start":48.81,"end":50.43,"text":"绝不会也不能懂得"},{"start":56.45,"end":59.919,"text":"哎你就是打个工而已啊"},{"start":59.919,"end":60.579,"text":"然后是的"},{"start":60.579,"end":62.619,"text":"我不出所料的被中介坑了"},{"start":62.619,"end":63.219,"text":"体检费"},{"start":63.219,"end":63.579,"text":"车费"},{"start":63.579,"end":64.289,"text":"被子费"},{"start":64.289,"end":66.479,"text":"这些不明意义的收费"},{"start":66.479,"end":67.529,"text":"怎么不明意义啊"},{"start":67.529,"end":68.999,"text":"体检费就是体检的费啊"},{"start":68.999,"end":70.649,"text":"车费就是坐车的钱了"},{"start":70.649,"end":72.88,"text":"被子费不就是被子的钱吗"},{"start":72.88,"end":74.47,"text":"这是2022年"},{"start":74.47,"end":75.82,"text":"正是那个有名的视频"},{"start":75.82,"end":76.72,"text":"九块钱一个小时"},{"start":76.72,"end":78.22,"text":"那个年头可恨的是"},{"start":78.22,"end":79.36,"text":"在去往工厂路上"},{"start":79.36,"end":80.71,"text":"没有一个成年人"},{"start":80.71,"end":83.0,"text":"全是学生工啊"},{"start":83.7,"end":84.8,"text":"没有一个成年人"},{"start":84.8,"end":87.74,"text":"他18岁的其他人未成年啊"},{"start":87.74,"end":90.89,"text":"他被分到了这个嘉定区"},{"start":90.89,"end":92.66,"text":"上海工业区"},{"start":93.21,"end":96.23,"text":"在车上遇到了三个15岁的小孩"},{"start":96.23,"end":98.53,"text":"目的地也是上海"},{"start":98.53,"end":100.75,"text":"中介骗他们去昆昆山"},{"start":100.75,"end":102.43,"text":"实际上他是去上海"},{"start":102.43,"end":107.08,"text":"然后他所在的公司叫富士通将军"},{"start":107.08,"end":108.88,"text":"是个日企空调厂"},{"start":108.88,"end":109.72,"text":"干了两个月"},{"start":109.72,"end":112.44,"text":"期间想尝试劳动仲裁"},{"start":112.44,"end":113.25,"text":"诶"},{"start":113.25,"end":114.18,"text":"什么意思啊"},{"start":114.18,"end":116.64,"text":"必须去试错这种斗争经验"},{"start":116.64,"end":120.32,"text":"因为不合理的制度竟然竟让500多个学生工"},{"start":120.32,"end":122.6,"text":"没有一人打仲裁"},{"start":123.29,"end":123.91,"text":"是的"},{"start":125.65,"end":127.81,"text":"然后他替人家打了投诉电话吗"},{"start":127.81,"end":130.03,"text":"你替人家投诉吗"},{"start":133.44,"end":135.98,"text":"哦他主要投诉的就是加班"},{"start":135.98,"end":137.21,"text":"不给加班费啊"},{"start":137.21,"end":139.22,"text":"加班工资应该双倍啊"},{"start":139.22,"end":141.51,"text":"或者怎么样的不给加班费啊"},{"start":141.51,"end":143.28,"text":"然后大致如下"},{"start":143.28,"end":145.26,"text":"一说清劳务关系"},{"start":145.26,"end":149.43,"text":"然后他是被劳务公司派遣的嘛"},{"start":149.43,"end":151.88,"text":"然后认准投诉对象"},{"start":151.88,"end":154.04,"text":"最后是投资的富士通啊"},{"start":154.04,"end":157.43,"text":"然后他的诉求集中在经济诉求上啊"},{"start":157.43,"end":158.66,"text":"不给加班费"},{"start":158.66,"end":164.15,"text":"违违反八小时工作制允诺的包吃住没有兑现啊"},{"start":164.15,"end":167.99,"text":"然后一天之后给了答复"},{"start":169.07,"end":173.32,"text":"加班是因为处在这个呃市场旺季"},{"start":173.32,"end":177.31,"text":"所以可以进行特殊的生产活动啊"},{"start":177.31,"end":178.9,"text":"然后就不用给加班费"},{"start":178.9,"end":183.04,"text":"加班费除是劳务中介允诺的啊"},{"start":183.04,"end":186.25,"text":"不是这个企业允诺的包吃住"},{"start":186.25,"end":188.23,"text":"口头承诺没有法律效益"},{"start":188.23,"end":190.69,"text":"要写在合同里才有用"},{"start":191.28,"end":191.78,"text":"对啊"},{"start":191.78,"end":193.4,"text":"你吃一堑长一智吧"},{"start":193.4,"end":196.94,"text":"因为这家工厂应该是和劳务中介合作"},{"start":196.94,"end":201.23,"text":"所以劳务公司负责人火速给他通