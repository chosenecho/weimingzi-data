{"segments":[{"start":0.04,"end":0.96,"text":"头上拉屎啊"},{"start":0.96,"end":2.88,"text":"这个首先呢改名叫安全屋"},{"start":2.88,"end":3.86,"text":"你配吗"},{"start":3.86,"end":4.68,"text":"你妈的"},{"start":4.68,"end":5.82,"text":"你们又不是反贼团体"},{"start":5.82,"end":7.94,"text":"我靠你配叫安全屋吗"},{"start":7.94,"end":8.88,"text":"对不对"},{"start":8.88,"end":10.22,"text":"安全屋用干嘛的"},{"start":10.22,"end":11.5,"text":"躲避侦查用的"},{"start":11.5,"end":14.5,"text":"你们有没有侦查价值不对"},{"start":14.5,"end":17.56,"text":"一群小屁孩叫安全屋"},{"start":17.56,"end":18.98,"text":"没资格"},{"start":18.98,"end":19.78,"text":"明白吗"},{"start":19.78,"end":21.1,"text":"我都没有安全屋"},{"start":21.1,"end":23.13,"text":"你们还他妈叫安全屋"},{"start":23.13,"end":25.33,"text":"给自己脸上抹这个格气"},{"start":25.33,"end":25.83,"text":"你知道吗"},{"start":25.83,"end":27.37,"text":"抹这个反气啊"},{"start":27.37,"end":28.01,"text":"太挫了"},{"start":28.01,"end":29.69,"text":"然后另外这个这不是重点"},{"start":29.69,"end":32.95,"text":"重点是这个叫做什么270元"},{"start":32.95,"end":33.93,"text":"掌握电工技能"},{"start":33.93,"end":35.85,"text":"他要搞在线电工培训啊"},{"start":35.85,"end":37.37,"text":"那我在此宣布"},{"start":37.37,"end":40.01,"text":"我们也要搞这个在线电工培训"},{"start":40.01,"end":44.53,"text":"然后我们的电工每个月培训出来的学员啊"},{"start":44.53,"end":46.515,"text":"有这个什么"},{"start":48.28,"end":54.44,"text":"一般我想都十个十个十个十个十个"},{"start":54.85,"end":57.99,"text":"20额有80个左右"},{"start":58.39,"end":60.07,"text":"有80个左右啊"},{"start":60.07,"end":62.11,"text":"里面挑一半算掌握的比较好的"},{"start":62.11,"end":64.87,"text":"或者说挑这个四四分之一"},{"start":64.87,"end":67.61,"text":"那就有20个优秀学员啊"},{"start":67.61,"end":72.74,"text":"所以说我们开展这个在线电工培训的这个硬件"},{"start":72.74,"end":74.16,"text":"硬实力能力也比较强的多啊"},{"start":74.16,"end":75.18,"text":"我们还有个工厂"},{"start":75.18,"end":79.14,"text":"因为这个等会我听着"},{"start":79.14,"end":83.22,"text":"因为这个电工培训实操培训比较重要的"},{"start":83.22,"end":84.64,"text":"就是反复的去接线"},{"start":84.64,"end":86.9,"text":"反复的去练啊这些东西"},{"start":86.9,"end":93.71,"text":"所以说我们打算开设这个在线的电工培训教啊"},{"start":93.71,"end":94.95,"text":"不仅是教程"},{"start":94.95,"end":96.47,"text":"还