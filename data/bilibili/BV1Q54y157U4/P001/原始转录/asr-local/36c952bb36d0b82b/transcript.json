  "content_sha256": "36c952bb36d0b82be9b35a77e77f495913b176d7b335b18447c1eb6873652df9",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 21840,
      "end_ms": 26960,
      "text": "某人夜半，仍然害怕会失落。"
    },
    {
      "ordinal": 1,
      "start_ms": 28400,
      "end_ms": 35090,
      "text": "要求证证使我善忘。"
    },
    {
      "ordinal": 2,
      "start_ms": 35140,
      "end_ms": 39553,
      "text": "半生情感，谁能像我咁用心？"
    },
    {
      "ordinal": 3,
      "start_ms": 39844,
      "end_ms": 44160,
      "text": "拣个冷或暖，但最终也要遗忘。"
    },
    {
      "ordinal": 4,
      "start_ms": 46160,
      "end_ms": 50640,
      "text": "繁华渐散，仍然踏进这街道。"
    },
    {
      "ordinal": 5,
      "start_ms": 52720,
      "end_ms": 55440,
      "text": "过往的光景满路旁，"
    },
    {
      "ordinal": 6,
      "start_ms": 58400,
      "end_ms": 68640,
      "text": "也许某知留恋在这老地方，前尘的深处不填忘。"
    },
    {
      "ordinal": 7,
      "start_ms": 73440,
      "end_ms": 81040,
      "text": "想说自咎，笑拥当天的我，每次再散，"
    },
    {
      "ordinal": 8,
      "start_ms": 82320,
      "end_ms": 86320,
      "text": "竟不发觉为何。"
    },
    {
      "ordinal": 9,
      "start_ms": 88080,
      "end_ms": 97920,
      "text": "爱过恨过，越少过骂过，但一心相处的不太多。"
    },
    {
      "ordinal": 10,
      "start_ms": 97920,
      "end_ms": 104182,
      "text": "回头路远，头顶夜半更疏落。"
    },
    {
      "ordinal": 11,
      "start_ms": 104320,
      "end_ms": 107760,
      "text": "远去的灯影已静卧。"
    },
    {
      "ordinal": 12,
      "start_ms": 108218,
      "end_ms": 115280,
      "text": "戏短情深，留神望遍这地方，"
    },
    {
      "ordinal": 13,
      "start_ms": 116560,
      "end_ms": 118080,
      "text": "回头的一刹皆寥落。"
    },
    {
      "ordinal": 14,
      "start_ms": 118080,
      "end_ms": 128160,
      "text": "繁华渐散，仍"
    },
    {
      "ordinal": 15,
      "start_ms": 129840,
      "end_ms": 148320,
      "text": "然踏进这街道。"
    },
    {
      "ordinal": 16,
      "start_ms": 150000,
      "end_ms": 156320,
      "text": "过往的光景满路"
    },
    {
      "ordinal": 17,
      "start_ms": 157520,
      "end_ms": 164000,
      "text": "旁，也许某知留恋在这老地方，"
    },
    {
      "ordinal": 18,
      "start_ms": 165120,
      "end_ms": 168960,
      "text": "前尘的深处不填忘。"
    },
    {
      "ordinal": 19,
      "start_ms": 169828,
      "end_ms": 181600,
      "text": "想说自咎，笑拥当天的我，每次再散。"
    },
    {
      "ordinal": 20,
      "start_ms": 182670,
      "end_ms": 195950,
      "text": "竟不發覺，為何愛過恨過，熱笑過罵過，但一心相處的不太多。"
    },
    {
      "ordinal": 21,
      "start_ms": 198190,
      "end_ms": 203550,
      "text": "回頭留怨，留怨夜半更疏落，"
    },
    {
      "ordinal": 22,
      "start_ms": 204670,
      "end_ms": 208110,
      "text": "遠去的燈影已靜卧。"
    },
    {
      "ordinal": 23,
      "start_ms": 208190,
      "end_ms": 215630,
      "text": "戲短情長，樓上望遍這地方，"
    },
    {
      "ordinal": 24,
      "start_ms": 216830,
      "end_ms": 219630,
      "text": "回頭的一剎皆寥落。"
    },
    {
      "ordinal": 25,
      "start_ms": 222670,
      "end_ms": 227070,
      "text": "戲短情長，樓上望遍這地方，"
    },
    {
      "ordinal": 26,
      "start_ms": 228750,
      "end_ms": 234830,
      "text": "遙遠的光景怎回望？"
    }
  ],
  "text": "某人夜半，仍然害怕会失落。\n要求证证使我善忘。\n半生情感，谁能像我咁用心？\n拣个冷或暖，但最终也要遗忘。\n繁华渐散，仍然踏进这街道。\n过往的光景满路旁，\n也许某知留恋在这老地方，前尘的深处不填忘。\n想说自咎，笑拥当天的我，每次再散，\n竟不发觉为何。\n爱过恨过，越少过骂过，但一心相处的不太多。\n回头路远，头顶夜半更疏落。\n远去的灯影已静卧。\n戏短情深，留神望遍这地方，\n回头的一刹皆寥落。\n繁华渐散，仍\n然踏进这街道。\n过往的光景满路\n旁，也许某知留恋在这老地方，\n前尘的深处不填忘。\n想说自咎，笑拥当天的我，每次再散。\n竟不發覺，為何愛過恨過，熱笑過罵過，但一心相處的不太多。\n回頭留怨，留怨夜半更疏落，\n遠去的燈影已靜卧。\n戲短情長，樓上望遍這地方，\n回頭的一剎皆寥落。\n戲短情長，樓上望遍這地方，\n遙遠的光景怎回望？",
