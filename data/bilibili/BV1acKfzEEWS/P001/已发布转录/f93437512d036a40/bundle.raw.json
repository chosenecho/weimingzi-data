{"segments":[{"start":0.08,"end":2.22,"text":"我们要来简短的讲一下啊"},{"start":2.22,"end":6.29,"text":"这个为什么"},{"start":9.93,"end":12.09,"text":"学马克思"},{"start":15.62,"end":17.7,"text":"就是没有必要"},{"start":19.26,"end":21.02,"text":"就是直接成为马克思就行了"},{"start":21.02,"end":24.58,"text":"我我简单来讲就是说嗯"},{"start":25.94,"end":28.5,"text":"没必要学习马克思这个人"},{"start":28.5,"end":31.5,"text":"但是当然如果你有时间"},{"start":32.06,"end":34.56,"text":"应当去读他的几乎所有的著作"},{"start":34.56,"end":36.4,"text":"和他的几乎所有的思想"},{"start":36.4,"end":38.58,"text":"但这只是起步"},{"start":39.25,"end":42.73,"text":"我的要求从来都是对职业革命家的要求"},{"start":43.15,"end":45.87,"text":"一般的普通的庸众没什么好要求的"},{"start":45.87,"end":48.39,"text":"那你既然要做职业革命家"},{"start":48.55,"end":49.59,"text":"马克思的东西"},{"start":49.59,"end":51.41,"text":"列宁的东西都是必读的"},{"start":51.41,"end":52.89,"text":"就不要废话的"},{"start":52.89,"end":55.99,"text":"但是他们没什么好学习的"},{"start":56.94,"end":59.3,"text":"你为什么要刻舟求剑呢"},{"start":59.64,"end":62.0,"text":"呃更多的是要直接成为他们"},{"start":62.0,"end":63.48,"text":"成为这个时代的马克思"},{"start":63.48,"end":66.58,"text":"这个时代的列宁好吧"},{"start":66.58,"end":68.34,"text":"那既然要成为这个时代的马克思"},{"start":68.34,"end":70.73,"text":"这个时代的列宁啊"},{"start":70.73,"end":72.89,"text":"黑格尔的法哲学是必读的"},{"start":72.89,"end":76.45,"text":"黑格尔的逻辑学和他的法哲学是必读的"},{"start":77.47,"end":78.73,"text":"为什么这么说呢"},{"start":78.73,"end":79.87,"text":"尤其在这个时代"},{"start":81.07,"end":84.2,"text":"并不是说从思想源流上"},{"start":84.2,"end":86.42,"text":"我需要学了黑格尔"},{"start":86.42,"end":89.48,"text":"我才能学或者读得懂马克思"},{"start":89.48,"end":91.48,"text":"才能读得懂列宁"},{"start":91.48,"end":92.94,"text":"不是这样的"},{"start":92.94,"end":96.58,"text":"其实恰恰相反是这样的"},{"start":96.58,"end":98.42,"text":"黑格尔的哲学"},{"start":98.42,"end":100.52,"text":"或者说德国观念论的哲学"},{"start":100.52,"end":102.26,"text":"归根结底是资产阶级"},{"start":102.26,"end":107.2,"text":"激进的资产阶级的建建邦治县雪"},{"start":107.68,"end":109.62,"text":"他是伪装成"},{"start":109.62,"end":114.86,"text":"或者说他是作为呃绝对者的创世学而存在的"},{"start":114.86,"end":115.7,"text":"一个绝对者"},{"start":115.7,"end":117.26,"text":"如何创世"},{"start":117.26,"end":119.52,"text":"不仅是创造整个自然世界"},{"start":119.52,"end":122.4,"text":"而创造整个逻辑意义的空间"},{"start":122.4,"end":124.009,"text":"创造时间"},{"start":124.009,"end":126.07,"text":"历史宇宙"},{"start":126.39,"end":127.83,"text":"创造主观意识"},{"start":127.83,"end":130.55,"text":"精神物质之间的差别"},{"start":130.55,"end":133.05,"text":"甚至说创造一切"},{"start":133.05,"end":135.85,"text":"那么这种学问学了之后呢"},{"start":135.85,"end":137.93,"text":"会有个什么基本的作用呢"},{"start":137.93,"end":142.85,"text":"一你能够明白资产阶级激进的"},{"start":142.85,"end":147.21,"text":"资产阶级的制宪学背后的里路"},{"start":148.56,"end":151.62,"text":"那么激进的资产阶级是你的对手"},{"start":151.62,"end":154.16,"text":"作为无产阶级革命家"},{"start":154.56,"end":156.04,"text":"任何时代的"},{"start":156.04,"end":161.47,"text":"一定要知道你的对手是如何编制他的环节"},{"start":161.47,"end":163.27,"text":"运行他的礼路的"},{"start":164.27,"end":167.08,"text":"所以需要去学知己知彼"},{"start":167.44,"end":168.4,"text":"这是一方面"},{"start":168.4,"end":169.52,"text":"另外一方面"},{"start":169.52,"end":172.519,"text":"黑格尔的逻辑学体系当中"},{"start":173.159,"end":176.519,"text":"有权力运行的制高法药"},{"start":177.619,"end":179.359,"text":"而且有权利腐化"},{"start":179.359,"end":181.379,"text":"或者说权利超脱自身"},{"start":181.379,"end":185.34,"text":"这个绝对绝对者的这种绝对意志"},{"start":185.34,"end":188.91,"text":"或者说我们说的这种不断超越阳气"},{"start":188.91,"end":192.03,"text":"前一个环节的将死性的这种纯粹的否定性"},{"start":192.03,"end":194.31,"text":"其实就是权力的逻辑"},{"start":194.75,"end":196.01,"text":"自我创生的"},{"start":196.01,"end":197.09,"text":"自我设定的"},{"start":197.09,"end":199.51,"text":"自我洋气的自我否弃"},{"start":199.51,"end":201.28,"text":"自我遗忘"},{"start":201.6,"end":204.06,"text":"然后诞生出他者设立他者"},{"start":204.06,"end":206.52,"text":"创造他者的权利的逻辑"},{"start":208.62,"end":210.76,"text":"无产阶级的革命家"},{"start":210.76,"end":212.12,"text":"我再强调一遍"},{"start":212.12,"end":215.94,"text":"我始终的要求的对象是职业革命家人群"},{"start":215.94,"end":217.08,"text":"你不是职业革命家"},{"start":217.08,"end":219.71,"text":"滚出去好"},{"start":219.71,"end":221.35,"text":"那么说到这个点上"},{"start":221.35,"end":222.91,"text":"为什么一定要学黑格尔"},{"start":223.99,"end":225.95,"text":"或者说为什么你不学黑格尔"},{"start":225.95,"end":226.07,"text":"可以"},{"start":226.07,"end":227.995,"text":"你可以学我的数正学"},{"start":228.43,"end":229.83,"text":"或者学我的权利哲学"},{"start":230.95,"end":231.81,"text":"为什么要学呢"},{"start":231.81,"end":235.95,"text":"因为如果你是真正意义上的富有历史的"},{"start":235.95,"end":237.17,"text":"绝对激进性"},{"start":237.17,"end":239.57,"text":"否定性的职业革命家的话"},{"start":239.57,"end":243.81,"text":"你一定会很早的就体验到权力的异化"},{"start":244.85,"end":247.9,"text":"你一定对这个无产阶级整体"},{"start":247.9,"end":249.96,"text":"具有极强的动员力和号召力"},{"start":249.96,"end":254.65,"text":"一定是已经能够征召很多的这样的人了"},{"start":255.09,"end":256.97,"text":"你一定是富集的权力的"},{"start":256.97,"end":258.11,"text":"你一定有权利"},{"start":258.11,"end":258.73,"text":"有步骤"},{"start":259.81,"end":260.61,"text":"有组织"},{"start":260.61,"end":262.17,"text":"有运动"},{"start":262.49,"end":264.83,"text":"这个过程你一定被异化"},{"start":264.83,"end":265.69,"text":"被腐蚀"},{"start":267.33,"end":271.13,"text":"那你要知道他把你腐蚀"},{"start":271.13,"end":272.77,"text":"把你异化的基本逻辑"},{"start":273.77,"end":276.81,"text":"那你要演练这个过程如何演练呢"},{"start":276.81,"end":278.25,"text":"所有人遭受权利"},{"start":278.25,"end":279.94,"text":"拥有权力都是第一招"},{"start":279.94,"end":281.36,"text":"如何演练呢"},{"start":281.36,"end":283.62,"text":"首先在哲学当中做演练"},{"start":283.62,"end":287.48,"text":"在哲学当中感受绝对者的绝对意志"},{"start":287.48,"end":292.139,"text":"在历史中行进所玩弄的每一个环节"},{"start":292.139,"end":293.919,"text":"每一个把戏"},{"start":294.7,"end":300.57,"text":"然后从其中把自己拯救出来也好"},{"start":300.57,"end":302.05,"text":"超脱出来也罢"},{"start":302.05,"end":303.69,"text":"逃遁出来也行"},{"start":304.77,"end":305.87,"text":"迂回出来"},{"start":305.87,"end":309.47,"text":"勉强明白吧"},{"start":309.47,"end":313.63,"text":"这会使得你在编织你的步骤"},{"start":313.63,"end":315.09,"text":"制定你的路线"},{"start":315.09,"end":317.18,"text":"实践你的战略的时候"},{"start":317.18,"end":319.1,"text":"你能够游刃有余"},{"start":319.1,"end":320.26,"text":"这是必备的"},{"start":320.26,"end":322.74,"text":"否则你必定腐化"},{"start":322.88,"end":324.26,"text":"所以在这个时代"},{"start":324.26,"end":328.2,"text":"我们已经见证了无产阶级革命"},{"start":332.7,"end":335.62,"text":"首先他在第二国际那堕落了"},{"start":335.62,"end":338.74,"text":"在前苏联那里也堕落了"},{"start":340.33,"end":345.05,"text":"那我说在某种唉我就不想多说了"},{"start":345.05,"end":348.71,"text":"所以首先要做到的是"},{"start":348.71,"end":350.83,"text":"不要走老路"},{"start":351.15,"end":355.4,"text":"不要走在总体性的叙事下"},{"start":355.4,"end":358.46,"text":"总体性的权力的诱惑下"},{"start":358.46,"end":360.12,"text":"腐化堕落的老路"},{"start":360.12,"end":363.0,"text":"那么这种老路我始终说的"},{"start":363.0,"end":366.88,"text":"斯大林和黑格尔是一体两面的东西"},{"start":369.12,"end":371.28,"text":"啊所以在黑格尔的体系当中"},{"start":371.28,"end":373.64,"text":"没有人可以直接拥有几千个师"},{"start":373.64,"end":374.88,"text":"然后做黑格尔啊"},{"start":374.88,"end":375.6,"text":"做斯大林"},{"start":375.6,"end":379.159,"text":"但是大家可以拥有几千种范畴"},{"start":379.479,"end":382.499,"text":"几千个这个逻辑运转的环节"},{"start":382.499,"end":383.719,"text":"在思想观念中"},{"start":383.719,"end":386.999,"text":"熟悉这些权利环节当中的相互关系"},{"start":387.46,"end":391.17,"text":"所以叫你们学习这个黑格尔的哲学"},{"start":391.17,"end":395.25,"text":"是叫你们提前感受权力的蛮横霸道"},{"start":395.25,"end":397.53,"text":"灵巧狡猾"},{"start":398.1,"end":401.74,"text":"虚伪和真挚"},{"start":403.32,"end":407.54,"text":"不学黑格尔逻辑学的人是无法驾驭权力的"},{"start":407.54,"end":409.33,"text":"一定会被他反噬的"},{"start":409.33,"end":412.37,"text":"一定会哭着流着泪离开这个世界"},{"start":413.41,"end":415.45,"text":"在晚年不停的痛哭"},{"start":415.45,"end":417.45,"text":"哀悼他的失败"},{"start":423.02,"end":423.78,"text":"当然我们知道"},{"start":423.78,"end":426.049,"text":"革命肯定会在某种意义上注定失败了"},{"start":426.049,"end":428.869,"text":"他一定会被这个城市的统治啊"},{"start":428.869,"end":432.6,"text":"腐朽堕落的关系所暂时的代替掉"},{"start":432.64,"end":434.64,"text":"我们希望让这种浮夸多了"},{"start":434.64,"end":437.3,"text":"来得迟一点"},{"start":438.1,"end":442.64,"text":"而且现在有很多庸人一辈子不可能掌权的佣人"},{"start":442.64,"end":443.04,"text":"一辈子"},{"start":443.04,"end":445.06,"text":"或者连不说是掌权"},{"start":445.06,"end":448.8,"text":"看获得某种属于他的权利的"},{"start":448.8,"end":449.76,"text":"在家庭"},{"start":449.76,"end":450.68,"text":"在一个单位"},{"start":450.68,"end":453.2,"text":"在一某种组织团队当中获得他的权利"},{"start":453.2,"end":454.6,"text":"这通通都是佣人"},{"start":454.6,"end":456.42,"text":"他们惧怕权力"},{"start":456.42,"end":459.0,"text":"他们也惧怕发号施令"},{"start":459.0,"end":461.2,"text":"惧怕去铺设真实的战略"},{"start":461.2,"end":463.3,"text":"去践行那些路线"},{"start":463.77,"end":465.67,"text":"所以他们不需要哲学"},{"start":465.67,"end":468.57,"text":"他们也不敢去尝试哲学"},{"start":471.6,"end":473.0,"text":"他连哲学都不敢尝试"},{"start":473.0,"end":476.13,"text":"你觉得他们能够真的去尝试所谓的革命吗"},{"start":476.13,"end":477.21,"text":"更不可能了"},{"start":477.21,"end":478.89,"text":"思想中的演练都不可能做到的"},{"start":478.89,"end":479.51,"text":"现实当中"},{"start":479.51,"end":481.62,"text":"他们只敢做一些作秀的"},{"start":481.62,"end":482.22,"text":"虚伪的"},{"start":482.22,"end":482.88,"text":"虚假的"},{"start":482.88,"end":483.66,"text":"修修补补的"},{"start":483.66,"end":486.22,"text":"自我陶醉的愚蠢的一些东西"},{"start":486.22,"end":489.86,"text":"这就是那批人始终在做的东西"},{"start":492.1,"end":494.34,"text":"他们尚且没有办法对自己的生命进行"},{"start":494.34,"end":496.6,"text":"总总体性的征召"},{"start":497.0,"end":499.46,"text":"还领着建制的退休金"},{"start":499.46,"end":503.72,"text":"在那呼喊最义正的"},{"start":505.259,"end":511.71,"text":"做梦一样的那种那些口号这种种这些存在哪"},{"start":511.71,"end":513.19,"text":"还有这些人的拥趸"},{"start":513.19,"end":518.34,"text":"都是历史当中冥顽不灵和微不足道的"},{"start":518.34,"end":523.47,"text":"轻微的可怜虫和迂腐的败类"},{"start":525.76,"end":527.3,"text":"我是出于我的仁慈"},{"start":527.3,"end":530.4,"text":"才把这些事情重复的再给讲给你们听"},{"start":530.4,"end":535.76,"text":"那啊我觉得除此之外"},{"start":535.76,"end":536.96,"text":"我没什么要多说的"},{"start":536.96,"end":537.88,"text":"就这样吧"}],"source":"subtitle"}
