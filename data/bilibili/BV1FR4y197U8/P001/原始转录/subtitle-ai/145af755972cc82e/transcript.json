      "text": "我靠糖桶"
    },
    {
      "ordinal": 53,
      "start_ms": 175119,
      "end_ms": 176799,
      "text": "还有呃"
    },
    {
      "ordinal": 54,
      "start_ms": 176799,
      "end_ms": 178479,
      "text": "诶就这些东西了"
    },
    {
      "ordinal": 55,
      "start_ms": 178479,
      "end_ms": 180159,
      "text": "好像就这些东西了"
    },
    {
      "ordinal": 56,
      "start_ms": 180159,
      "end_ms": 183730,
