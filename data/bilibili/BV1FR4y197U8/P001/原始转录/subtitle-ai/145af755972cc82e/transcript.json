    },
    {
      "ordinal": 48,
      "start_ms": 165040,
      "end_ms": 166740,
      "text": "然后还有一个汤桶"
    },
    {
      "ordinal": 49,
      "start_ms": 166740,
      "end_ms": 168060,
      "text": "还有一个汤桶啊"
    },
    {
      "ordinal": 50,
      "start_ms": 168060,
      "end_ms": 169240,
      "text": "还有一个汤桶"
    },
    {
      "ordinal": 51,
      "start_ms": 170399,
      "end_ms": 171499,
      "text": "还有一个汤桶"
    },
    {
      "ordinal": 52,
      "start_ms": 172999,
