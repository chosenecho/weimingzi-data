    },
    {
      "ordinal": 124,
      "start_ms": 347079,
      "end_ms": 347799,
      "text": "这样算下来"
    },
    {
      "ordinal": 125,
      "start_ms": 347799,
      "end_ms": 350680,
      "text": "2100 3100 4800"
    },
    {
      "ordinal": 126,
      "start_ms": 351860,
      "end_ms": 353470,
      "text": "6450"
    },
    {
      "ordinal": 127,
