    },
    {
      "ordinal": 20,
      "start_ms": 83540,
      "end_ms": 85300,
      "text": "花了3000块啊"
    },
    {
      "ordinal": 21,
      "start_ms": 85300,
      "end_ms": 89380,
      "text": "2298元用的是公司的钱"
    },
    {
      "ordinal": 22,
      "start_ms": 89380,
      "end_ms": 89620,
      "text": "走了"
