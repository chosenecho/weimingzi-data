    {
      "ordinal": 109,
      "start_ms": 300180,
      "end_ms": 304570,
      "text": "30个平方瓷砖的材料要1800"
    },
    {
      "ordinal": 110,
      "start_ms": 304570,
      "end_ms": 306010,
      "text": "工价啊"
    },
    {
      "ordinal": 111,
      "start_ms": 306010,
      "end_ms": 307820,
      "text": "要1650元"
    },
    {
      "ordinal": 112,
