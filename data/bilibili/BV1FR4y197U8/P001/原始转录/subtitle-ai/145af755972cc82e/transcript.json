    {
      "ordinal": 12,
      "start_ms": 53650,
      "end_ms": 54940,
      "text": "这里是吧台"
    },
    {
      "ordinal": 13,
      "start_ms": 57920,
      "end_ms": 58940,
      "text": "就是楼梯"
    },
    {
      "ordinal": 14,
      "start_ms": 58940,
      "end_ms": 60320,
      "text": "这边是楼梯啊"
    },
    {
      "ordinal": 15,
      "start_ms": 60320,
      "end_ms": 61700,
      "text": "这边是储物间"
    },
    {
      "ordinal": 16,
      "start_ms": 61700,
      "end_ms": 65069,
      "text": "这边是这边就是这个"
    },
    {
      "ordinal": 17,
      "start_ms": 74880,
      "end_ms": 76220,
      "text": "方向改造人厨房"
    },
    {
      "ordinal": 18,
      "start_ms": 76220,
      "end_ms": 81030,
      "text": "这个上个星期间我们把设备买了"
    },
    {
      "ordinal": 19,
      "start_ms": 81030,
