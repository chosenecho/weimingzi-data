      "end_ms": 316660,
      "text": "1700元"
    },
    {
      "ordinal": 113,
      "start_ms": 316660,
      "end_ms": 320420,
      "text": "然后这个不用打动了"
    },
    {
      "ordinal": 114,
      "start_ms": 320420,
