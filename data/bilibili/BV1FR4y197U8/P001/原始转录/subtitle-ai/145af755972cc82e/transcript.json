    {
      "ordinal": 96,
      "start_ms": 266240,
      "end_ms": 266840,
      "text": "我记不得了"
    },
    {
      "ordinal": 97,
      "start_ms": 266840,
      "end_ms": 267500,
      "text": "我不管了"
    },
    {
      "ordinal": 98,
      "start_ms": 267500,
      "end_ms": 268280,
      "text": "还是做干锅的"
    },
    {
      "ordinal": 99,
      "start_ms": 268280,
      "end_ms": 270260,
      "text": "反正是他之前也是做餐饮的"
    },
    {
      "ordinal": 100,
