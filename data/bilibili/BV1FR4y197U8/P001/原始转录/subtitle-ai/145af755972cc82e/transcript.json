    },
    {
      "ordinal": 120,
      "start_ms": 341700,
      "end_ms": 344229,
      "text": "我靠要2000块啊"
    },
    {
      "ordinal": 121,
      "start_ms": 344229,
      "end_ms": 345399,
      "text": "杂物乱七八糟"
    },
    {
      "ordinal": 122,
