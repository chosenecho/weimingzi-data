    },
    {
      "ordinal": 40,
      "start_ms": 145399,
      "end_ms": 146899,
      "text": "还有一个这个"
    },
    {
      "ordinal": 41,
      "start_ms": 149299,
      "end_ms": 153419,
      "text": "比较大的一个那个吸烟气啊"
    },
    {
      "ordinal": 42,
      "start_ms": 153419,
      "end_ms": 154439,
      "text": "吸油烟气啊"
    },
    {
      "ordinal": 43,
      "start_ms": 154439,
      "end_ms": 155980,
