  "segments": [
    {
      "ordinal": 0,
      "start_ms": 0,
      "end_ms": 4540,
      "text": "我现在讲一下我们的这个营养星期四的项目的一个进度啊"
    },
    {
      "ordinal": 1,
      "start_ms": 13720,
      "end_ms": 16040,
      "text": "这个进度目前是"
    },
    {
      "ordinal": 2,
      "start_ms": 17860,
      "end_ms": 20490,
      "text": "也由于我们没有厨房了"
    },
    {
      "ordinal": 3,
      "start_ms": 20490,
      "end_ms": 23580,
      "text": "就是说就我们不打算"
    },
    {
      "ordinal": 4,
      "start_ms": 24180,
      "end_ms": 28760,
      "text": "我们本来就是出去一个一个我们的一个志愿者"
    },
    {
      "ordinal": 5,
