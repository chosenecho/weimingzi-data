{
  "bvid": "BV1gW411a7Mo",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "801b26679e7a54b28c91ab56c98cae9d17ad212f4f702bb91b5d7b6e52cd394a",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 12040,
      "end_ms": 14260,
      "text": "嗯怎么这音乐没声啊"
    },
    {
      "ordinal": 1,
      "start_ms": 14260,
      "end_ms": 15640,
      "text": "哦有声音"
    },
    {
      "ordinal": 2,
      "start_ms": 17460,
      "end_ms": 20970,
      "text": "啊啊啊"
    },
    {
      "ordinal": 3,
      "start_ms": 20970,
      "end_ms": 23580,
      "text": "这讲要讲的就是所谓的辩证法"
    },
    {
      "ordinal": 4,
      "start_ms": 23580,
      "end_ms": 25340,
      "text": "跟形而上学这个对子啊"
    },
    {
      "ordinal": 5,
      "start_ms": 26420,
      "end_ms": 32640,
      "text": "他们在这个都叫做方法论的啊"
    },
    {
      "ordinal": 6,
      "start_ms": 32640,
      "end_ms": 33950,
      "text": "一个对立啊"
    },
    {
      "ordinal": 7,
      "start_ms": 33950,
      "end_ms": 35030,
      "text": "在教科书系统里面"
    },
    {
      "ordinal": 8,
      "start_ms": 35030,
      "end_ms": 39410,
      "text": "所谓的形而上学就是将死的静态的什么狭隘的"
    },
    {
      "ordinal": 9,
      "start_ms": 39410,
      "end_ms": 42370,
      "text": "从某个特定的视角是吧"
    },
    {
      "ordinal": 10,
      "start_ms": 42370,
      "end_ms": 43870,
      "text": "去把握世界"
    },
    {
      "ordinal": 11,
      "start_ms": 43870,
      "end_ms": 46570,
      "text": "而所谓的那个辩证法"
    },
    {
      "ordinal": 12,
      "start_ms": 46570,
      "end_ms": 49120,
      "text": "就是要从一个统一的变化的"
    },
    {
      "ordinal": 13,
      "start_ms": 49120,
      "end_ms": 52300,
      "text": "然后是一个动态的视角去保护世界"
    },
    {
      "ordinal": 14,
      "start_ms": 52300,
      "end_ms": 53440,
      "text": "我跟你讲这扯淡"
    },
    {
      "ordinal": 15,
      "start_ms": 53440,
      "end_ms": 56410,
      "text": "放屁啊啊我不知道放屁这个词"
    },
    {
      "ordinal": 16,
      "start_ms": 56410,
      "end_ms": 60930,
      "text": "我不是不是那种禁用词啊"
    },
    {
      "ordinal": 17,
      "start_ms": 60930,
      "end_ms": 62190,
      "text": "呃想要上学"
    },
    {
      "ordinal": 18,
      "start_ms": 62190,
      "end_ms": 64739,
      "text": "其实原词叫metaphysics"
    },
    {
      "ordinal": 19,
      "start_ms": 64739,
      "end_ms": 66000,
      "text": "对吧啊"
    },
    {
      "ordinal": 20,
      "start_ms": 66000,
      "end_ms": 67020,
      "text": "你说他是近代的"
    },
    {
      "ordinal": 21,
      "start_ms": 67020,
      "end_ms": 68280,
      "text": "我静态的啊"
    },
    {
      "ordinal": 22,
      "start_ms": 68280,
      "end_ms": 69060,
      "text": "我承认啊"
    },
    {
      "ordinal": 23,
      "start_ms": 69060,
      "end_ms": 71160,
      "text": "他有有有有静态化的过程"
    },
    {
      "ordinal": 24,
      "start_ms": 71160,
      "end_ms": 74350,
      "text": "特别是呃希腊化时期啊"
    },
    {
      "ordinal": 25,
      "start_ms": 74350,
      "end_ms": 77200,
      "text": "也就是说古希腊之后还有罗马的"
    },
    {
      "ordinal": 26,
      "start_ms": 77640,
      "end_ms": 82180,
      "text": "罗马的那个宗教啊"
    },
    {
      "ordinal": 27,
      "start_ms": 82180,
      "end_ms": 84580,
      "text": "罗马的这个思想啊"
    },
    {
      "ordinal": 28,
      "start_ms": 84580,
      "end_ms": 87100,
      "text": "回回归到希腊那种"
    },
    {
      "ordinal": 29,
      "start_ms": 87100,
      "end_ms": 91980,
      "text": "特别是学了很多那个柏拉图和就是基督教"
    },
    {
      "ordinal": 30,
      "start_ms": 91980,
      "end_ms": 94679,
      "text": "吸收了很多柏拉图的那种思想之后"
    },
    {
      "ordinal": 31,
      "start_ms": 95020,
      "end_ms": 97240,
      "text": "他有一种静态化"
    },
    {
      "ordinal": 32,
      "start_ms": 97240,
      "end_ms": 97900,
      "text": "有一种固态化"
    },
    {
      "ordinal": 33,
      "start_ms": 97900,
      "end_ms": 100960,
      "text": "就是把柏拉图和亚里士多德的一些思想"
    },
    {
      "ordinal": 34,
      "start_ms": 100960,
      "end_ms": 103460,
      "text": "看成是绝对呃"
    },
    {
      "ordinal": 35,
      "start_ms": 103460,
      "end_ms": 104420,
      "text": "就是正确的啊"
    },
    {
      "ordinal": 36,
      "start_ms": 104420,
      "end_ms": 107260,
      "text": "这是就再也不想去突破"
    },
    {
      "ordinal": 37,
      "start_ms": 107260,
      "end_ms": 108520,
      "text": "去思考了"
    },
    {
      "ordinal": 38,
      "start_ms": 108520,
      "end_ms": 110560,
      "text": "那么导致一个结果是什么呢"
    },
    {
      "ordinal": 39,
      "start_ms": 110560,
      "end_ms": 114280,
      "text": "呃就是亚里士德在他的物理学之后"
    },
    {
      "ordinal": 40,
      "start_ms": 114280,
      "end_ms": 116140,
      "text": "他的物理学也蛮粗浅的"
    },
    {
      "ordinal": 41,
      "start_ms": 116140,
      "end_ms": 119410,
      "text": "实质上就是一套研究世界的一种分类学"
    },
    {
      "ordinal": 42,
      "start_ms": 119410,
      "end_ms": 123710,
      "text": "一种啊所谓的科学逻辑演绎的一套方法论啊"
    },
    {
      "ordinal": 43,
      "start_ms": 123710,
      "end_ms": 124910,
      "text": "在物理学之后"
    },
    {
      "ordinal": 44,
      "start_ms": 124910,
      "end_ms": 128570,
      "text": "他有提出了一些关于世界本源是什么"
    },
    {
      "ordinal": 45,
      "start_ms": 128570,
      "end_ms": 131840,
      "text": "世界本源我用哪些范畴去加以定义"
    },
    {
      "ordinal": 46,
      "start_ms": 131840,
      "end_ms": 132680,
      "text": "加以规范"
    },
    {
      "ordinal": 47,
      "start_ms": 132680,
      "end_ms": 134170,
      "text": "我可以去思考它"
    },
    {
      "ordinal": 48,
      "start_ms": 134185,
      "end_ms": 138010,
      "text": "就是因为亚里士多德研究的这些关于世界本源"
    },
    {
      "ordinal": 49,
      "start_ms": 138010,
      "end_ms": 141310,
      "text": "然后他又恰巧把这些世界本源叫做自然啊"
    },
    {
      "ordinal": 50,
      "start_ms": 141310,
      "end_ms": 142620,
      "text": "physics啊"
    },
    {
      "ordinal": 51,
      "start_ms": 143740,
      "end_ms": 145650,
      "text": "然后所谓物理学嘛"
    },
    {
      "ordinal": 52,
      "start_ms": 145650,
      "end_ms": 150330,
      "text": "所以呃中国人或者说传统教科书体系"
    },
    {
      "ordinal": 53,
      "start_ms": 150330,
      "end_ms": 153290,
      "text": "就把亚里士多德看成是朴素的唯物主义啊"
    },
    {
      "ordinal": 54,
      "start_ms": 153290,
      "end_ms": 154850,
      "text": "但实际上不是的啊"
    },
    {
      "ordinal": 55,
      "start_ms": 154850,
      "end_ms": 159840,
      "text": "实质上亚里士多德研究这些啊所谓本源啊"
    },
    {
      "ordinal": 56,
      "start_ms": 159840,
      "end_ms": 162040,
      "text": "啊所谓啊实存"
    },
    {
      "ordinal": 57,
      "start_ms": 162040,
      "end_ms": 164290,
      "text": "所以事物存在的根基"
    },
    {
      "ordinal": 58,
      "start_ms": 164290,
      "end_ms": 166480,
      "text": "他们用的方法和柏拉图没有"
    },
    {
      "ordinal": 59,
      "start_ms": 166480,
      "end_ms": 168160,
      "text": "没有什么本质性的差别"
    },
    {
      "ordinal": 60,
      "start_ms": 168160,
      "end_ms": 169060,
      "text": "没有什么实质性的差别"
    },
    {
      "ordinal": 61,
      "start_ms": 169060,
      "end_ms": 170880,
      "text": "也是也是一个语言学的方法"
    },
    {
      "ordinal": 62,
      "start_ms": 170880,
      "end_ms": 174480,
      "text": "主主流的其实也是一些呃范畴"
    },
    {
      "ordinal": 63,
      "start_ms": 174480,
      "end_ms": 176310,
      "text": "分类范畴之间关系"
    },
    {
      "ordinal": 64,
      "start_ms": 176310,
      "end_ms": 177540,
      "text": "他们思考一下"
    },
    {
      "ordinal": 65,
      "start_ms": 177540,
      "end_ms": 179600,
      "text": "而思考的都是比较肤浅的"
    },
    {
      "ordinal": 66,
      "start_ms": 179600,
      "end_ms": 184880,
      "text": "他的方法啊集在一本小册子"
    },
    {
      "ordinal": 67,
      "start_ms": 184880,
      "end_ms": 189300,
      "text": "小册子是写在他们那个研究具体物理"
    },
    {
      "ordinal": 68,
      "start_ms": 189300,
      "end_ms": 192300,
      "text": "研究具体自然问题的那个物理学后面的"
    },
    {
      "ordinal": 69,
      "start_ms": 192300,
      "end_ms": 196390,
      "text": "所以那部分就叫做写在物理学之后的学问"
    },
    {
      "ordinal": 70,
      "start_ms": 196390,
      "end_ms": 199740,
      "text": "那么就翻译成希腊文知识"
    },
    {
      "ordinal": 71,
      "start_ms": 199740,
      "end_ms": 200640,
      "text": "Meta physics"
    },
    {
      "ordinal": 72,
      "start_ms": 200640,
      "end_ms": 203280,
      "text": "meta就是在什么时后面"
    },
    {
      "ordinal": 73,
      "start_ms": 204380,
      "end_ms": 207430,
      "text": "但是呢到了古罗马的希腊化时期"
    },
    {
      "ordinal": 74,
      "start_ms": 207430,
      "end_ms": 210860,
      "text": "有一些啊他们实际上是神学家了"
    },
    {
      "ordinal": 75,
      "start_ms": 210860,
      "end_ms": 211820,
      "text": "不应该叫哲学家"
    },
    {
      "ordinal": 76,
      "start_ms": 211820,
      "end_ms": 214100,
      "text": "就会就觉得这个写在什么的后面"
    },
    {
      "ordinal": 77,
      "start_ms": 214100,
      "end_ms": 216000,
      "text": "就是比他更牛逼啊"
    },
    {
      "ordinal": 78,
      "start_ms": 216000,
      "end_ms": 217200,
      "text": "就是超越嘛"
    },
    {
      "ordinal": 79,
      "start_ms": 217200,
      "end_ms": 220679,
      "text": "就把这个meta从一个在什么什么后面"
    },
    {
      "ordinal": 80,
      "start_ms": 220679,
      "end_ms": 223289,
      "text": "实际上是我研究具体问题"
    },
    {
      "ordinal": 81,
      "start_ms": 223289,
      "end_ms": 225089,
      "text": "这些问题我差不多可以这样解决了"
    },
    {
      "ordinal": 82,
      "start_ms": 225089,
      "end_ms": 227400,
      "text": "但是这些具体问题背后还有更深层次的问题"
    },
    {
      "ordinal": 83,
      "start_ms": 227400,
      "end_ms": 228120,
      "text": "我去研究他们"
    },
    {
      "ordinal": 84,
      "start_ms": 228120,
      "end_ms": 230460,
      "text": "我其实还是有点不得其解"
    },
    {
      "ordinal": 85,
      "start_ms": 230460,
      "end_ms": 231360,
      "text": "对不对啊"
    },
    {
      "ordinal": 86,
      "start_ms": 231579,
      "end_ms": 234459,
      "text": "啊这个幸福幸福哒哒哒到底是什么"
    },
    {
      "ordinal": 87,
      "start_ms": 234459,
      "end_ms": 236380,
      "text": "有点不得其解"
    },
    {
      "ordinal": 88,
      "start_ms": 236380,
      "end_ms": 237280,
      "text": "他还是不得其解"
    },
    {
      "ordinal": 89,
      "start_ms": 237280,
      "end_ms": 239440,
      "text": "所以他们把这些东西写在物理学后面"
    },
    {
      "ordinal": 90,
      "start_ms": 239440,
      "end_ms": 242680,
      "text": "他们并不是说我已经得到终终极答案"
    },
    {
      "ordinal": 91,
      "start_ms": 242680,
      "end_ms": 244660,
      "text": "那么这些终极答案可以用来去理解"
    },
    {
      "ordinal": 92,
      "start_ms": 244660,
      "end_ms": 248000,
      "text": "我前面关于物理学的一些那些方法"
    },
    {
      "ordinal": 93,
      "start_ms": 248000,
      "end_ms": 249500,
      "text": "错的不是这样的"
    },
    {
      "ordinal": 94,
      "start_ms": 249500,
      "end_ms": 252050,
      "text": "就是因为这个原因啊"
    },
    {
      "ordinal": 95,
      "start_ms": 252050,
      "end_ms": 255580,
      "text": "那些神学家啊"
    },
    {
      "ordinal": 96,
      "start_ms": 255580,
      "end_ms": 259870,
      "text": "误解了亚里士多德对于形而上学这个定义的"
    },
    {
      "ordinal": 97,
      "start_ms": 259870,
      "end_ms": 261339,
      "text": "其实不应该叫形而上啊"
    },
    {
      "ordinal": 98,
      "start_ms": 261339,
      "end_ms": 262860,
      "text": "其实叫形而后学"
    },
    {
      "ordinal": 99,
      "start_ms": 262900,
      "end_ms": 265240,
      "text": "或者叫这物理后面的学问"
    },
    {
      "ordinal": 100,
      "start_ms": 265240,
      "end_ms": 270359,
      "text": "物理后学应该叫啊好物理学之外的学问"
    },
    {
      "ordinal": 101,
      "start_ms": 270359,
      "end_ms": 274579,
      "text": "物理学之外我还没有弄清楚的学问啊"
    },
    {
      "ordinal": 102,
      "start_ms": 274579,
      "end_ms": 275359,
      "text": "关于这个问题"
    },
    {
      "ordinal": 103,
      "start_ms": 275359,
      "end_ms": 278119,
      "text": "那个海德格尔在一本教导形而上学导论里面"
    },
    {
      "ordinal": 104,
      "start_ms": 278119,
      "end_ms": 280100,
      "text": "他讲的很清楚了啊"
    },
    {
      "ordinal": 105,
      "start_ms": 280300,
      "end_ms": 284280,
      "text": "就使得他他认为这也是当时"
    },
    {
      "ordinal": 106,
      "start_ms": 284460,
      "end_ms": 288450,
      "text": "或者说西方这套学术系统一个没办法解决问题"
    },
    {
      "ordinal": 107,
      "start_ms": 288450,
      "end_ms": 289680,
      "text": "然后不得不装作自己"
    },
    {
      "ordinal": 108,
      "start_ms": 289680,
      "end_ms": 292440,
      "text": "好像解决了问题的一个一个宿命"
    },
    {
      "ordinal": 109,
      "start_ms": 292440,
      "end_ms": 297300,
      "text": "他就会把之前啊特别牛掰的人物写出来的"
    },
    {
      "ordinal": 110,
      "start_ms": 297300,
      "end_ms": 299940,
      "text": "他其实没解决问题的一个纲领性的小册子"
    },
    {
      "ordinal": 111,
      "start_ms": 299960,
      "end_ms": 302000,
      "text": "尚待解决问题和钢影形小册子"
    },
    {
      "ordinal": 112,
      "start_ms": 302000,
      "end_ms": 303350,
      "text": "看成是所有问题的答案"
    },
    {
      "ordinal": 113,
      "start_ms": 303350,
      "end_ms": 303980,
      "text": "终极答案"
    },
    {
      "ordinal": 114,
      "start_ms": 303980,
      "end_ms": 306800,
      "text": "而且是然后就变成僵死僵化了"
    },
    {
      "ordinal": 115,
      "start_ms": 306800,
      "end_ms": 310219,
      "text": "可以派生出很多啊概念论的形而上学"
    },
    {
      "ordinal": 116,
      "start_ms": 310219,
      "end_ms": 311569,
      "text": "实在论的形而上学"
    },
    {
      "ordinal": 117,
      "start_ms": 311569,
      "end_ms": 315770,
      "text": "就是说这个世界本质上都是有一些呃超越性的"
    },
    {
      "ordinal": 118,
      "start_ms": 315770,
      "end_ms": 318140,
      "text": "一些一些属性啊"
    },
    {
      "ordinal": 119,
      "start_ms": 318140,
      "end_ms": 319940,
      "text": "一些范畴啊"
    },
    {
      "ordinal": 120,
      "start_ms": 319979,
      "end_ms": 322739,
      "text": "他在一个超越的彼岸世界存在"
    },
    {
      "ordinal": 121,
      "start_ms": 322739,
      "end_ms": 324700,
      "text": "这些东西是"
    },
    {
      "ordinal": 122,
      "start_ms": 326760,
      "end_ms": 328340,
      "text": "永远存在的实存的"
    },
    {
      "ordinal": 123,
      "start_ms": 328340,
      "end_ms": 331040,
      "text": "然后这些东西具有向外留意的那种能力"
    },
    {
      "ordinal": 124,
      "start_ms": 331040,
      "end_ms": 333620,
      "text": "能够使得具体的事物显现出来啊"
    },
    {
      "ordinal": 125,
      "start_ms": 333620,
      "end_ms": 335869,
      "text": "啊这个当然就是形而上学的"
    },
    {
      "ordinal": 126,
      "start_ms": 335869,
      "end_ms": 336679,
      "text": "形而上的东西"
    },
    {
      "ordinal": 127,
      "start_ms": 336679,
      "end_ms": 338200,
      "text": "决定形而下的东西吗"
    },
    {
      "ordinal": 128,
      "start_ms": 339200,
      "end_ms": 340480,
      "text": "形而上者之谓道"
    },
    {
      "ordinal": 129,
      "start_ms": 340480,
      "end_ms": 341800,
      "text": "形而下者之谓器嘛"
    },
    {
      "ordinal": 130,
      "start_ms": 341800,
      "end_ms": 345340,
      "text": "而且符合易经里面那种那种那种想法了吗"
    },
    {
      "ordinal": 131,
      "start_ms": 345340,
      "end_ms": 347520,
      "text": "那么实质上易经也被曲解了"
    },
    {
      "ordinal": 132,
      "start_ms": 347520,
      "end_ms": 349740,
      "text": "毕竟这个形而上和形而下也被拒绝"
    },
    {
      "ordinal": 133,
      "start_ms": 349740,
      "end_ms": 351580,
      "text": "盗妻关系也没有那么解决"
    },
    {
      "ordinal": 134,
      "start_ms": 351580,
      "end_ms": 354370,
      "text": "不是那个决定和被决定的关系好吧"
    },
    {
      "ordinal": 135,
      "start_ms": 354370,
      "end_ms": 358970,
      "text": "所以当你的学术系统里面讲到什么决定啥"
    },
    {
      "ordinal": 136,
      "start_ms": 358970,
      "end_ms": 359810,
      "text": "什么和什么"
    },
    {
      "ordinal": 137,
      "start_ms": 359810,
      "end_ms": 363310,
      "text": "特别是两个本源性的两个桂冠官要的两个东西"
    },
    {
      "ordinal": 138,
      "start_ms": 363310,
      "end_ms": 364930,
      "text": "你说这个A决定了B就这么简单"
    },
    {
      "ordinal": 139,
      "start_ms": 364930,
      "end_ms": 366310,
      "text": "一句话像推土机一样"
    },
    {
      "ordinal": 140,
      "start_ms": 369500,
      "end_ms": 370670,
      "text": "这个问题就解决了"
    },
    {
      "ordinal": 141,
      "start_ms": 370670,
      "end_ms": 372500,
      "text": "那么你的方式本身就形而上学的"
    },
    {
      "ordinal": 142,
      "start_ms": 372500,
      "end_ms": 374580,
      "text": "所以我说最形而上学就是你教科书"
    },
    {
      "ordinal": 143,
      "start_ms": 374580,
      "end_ms": 376159,
      "text": "教科书本身最形而上学"
    },
    {
      "ordinal": 144,
      "start_ms": 376159,
      "end_ms": 379819,
      "text": "那么在这套对于形而上学进行曲解的话语里面"
    },
    {
      "ordinal": 145,
      "start_ms": 379819,
      "end_ms": 382279,
      "text": "教科书话语里面他对于辩证法也进行了曲解"
    },
    {
      "ordinal": 146,
      "start_ms": 382279,
      "end_ms": 383119,
      "text": "什么叫辩证法"
    },
    {
      "ordinal": 147,
      "start_ms": 383119,
      "end_ms": 385280,
      "text": "辩证法就是动态的"
    },
    {
      "ordinal": 148,
      "start_ms": 385380,
      "end_ms": 387470,
      "text": "他认为啊辩证法就是动态的"
    },
    {
      "ordinal": 149,
      "start_ms": 387470,
      "end_ms": 390140,
      "text": "具体的啊统一的看问题"
    },
    {
      "ordinal": 150,
      "start_ms": 390140,
      "end_ms": 391280,
      "text": "从不同视角出发"
    },
    {
      "ordinal": 151,
      "start_ms": 391280,
      "end_ms": 392780,
      "text": "我告诉你这个不叫什么辩证法"
    },
    {
      "ordinal": 152,
      "start_ms": 392780,
      "end_ms": 393799,
      "text": "这叫视角主义"
    },
    {
      "ordinal": 153,
      "start_ms": 393799,
      "end_ms": 394999,
      "text": "Perspectivism"
    },
    {
      "ordinal": 154,
      "start_ms": 394999,
      "end_ms": 396859,
      "text": "从不同的视角去看待一个东西"
    },
    {
      "ordinal": 155,
      "start_ms": 396859,
      "end_ms": 399280,
      "text": "它有不同的实质或者自家相对主义"
    },
    {
      "ordinal": 156,
      "start_ms": 399280,
      "end_ms": 400930,
      "text": "但是他又说这是统一的"
    },
    {
      "ordinal": 157,
      "start_ms": 400930,
      "end_ms": 402250,
      "text": "从不同的视角"
    },
    {
      "ordinal": 158,
      "start_ms": 402250,
      "end_ms": 405040,
      "text": "我又把不同的视角分成主要和次要的"
    },
    {
      "ordinal": 159,
      "start_ms": 405040,
      "end_ms": 405640,
      "text": "关键"
    },
    {
      "ordinal": 160,
      "start_ms": 405640,
      "end_ms": 406000,
      "text": "你告诉我"
    },
    {
      "ordinal": 161,
      "start_ms": 406000,
      "end_ms": 409400,
      "text": "为什么不同视角可以翻变成主要和次要的"
    },
    {
      "ordinal": 162,
      "start_ms": 409400,
      "end_ms": 410600,
      "text": "然后所谓主要方面"
    },
    {
      "ordinal": 163,
      "start_ms": 410600,
      "end_ms": 411470,
      "text": "次要方面矛盾"
    },
    {
      "ordinal": 164,
      "start_ms": 411470,
      "end_ms": 414760,
      "text": "他有他有他有主要矛盾"
    },
    {
      "ordinal": 165,
      "start_ms": 414760,
      "end_ms": 416560,
      "text": "次要矛盾主次如何分开来了"
    },
    {
      "ordinal": 166,
      "start_ms": 416560,
      "end_ms": 417520,
      "text": "如何区分呢"
    },
    {
      "ordinal": 167,
      "start_ms": 417520,
      "end_ms": 418720,
      "text": "你凭什么区分主次"
    },
    {
      "ordinal": 168,
      "start_ms": 418720,
      "end_ms": 422720,
      "text": "你不同一个不同一个那种将死的系统出发"
    },
    {
      "ordinal": 169,
      "start_ms": 422720,
      "end_ms": 424220,
      "text": "你凭什么就区分主次"
    },
    {
      "ordinal": 170,
      "start_ms": 425480,
      "end_ms": 426440,
      "text": "对不对"
    },
    {
      "ordinal": 171,
      "start_ms": 426440,
      "end_ms": 429280,
      "text": "所以我们学到的所谓辩证法里面"
    },
    {
      "ordinal": 172,
      "start_ms": 429280,
      "end_ms": 431770,
      "text": "那些所谓的方法论什么"
    },
    {
      "ordinal": 173,
      "start_ms": 431770,
      "end_ms": 434250,
      "text": "一定要要普遍联系的观点"
    },
    {
      "ordinal": 174,
      "start_ms": 434250,
      "end_ms": 436880,
      "text": "那是普遍联系对是普遍联系"
    },
    {
      "ordinal": 175,
      "start_ms": 436880,
      "end_ms": 437750,
      "text": "没错"
    },
    {
      "ordinal": 176,
      "start_ms": 437750,
      "end_ms": 439790,
      "text": "什么东西强行去扯"
    },
    {
      "ordinal": 177,
      "start_ms": 439790,
      "end_ms": 441080,
      "text": "都有普遍联系"
    },
    {
      "ordinal": 178,
      "start_ms": 441080,
      "end_ms": 444050,
      "text": "那么哪些联系是值得被说的"
    },
    {
      "ordinal": 179,
      "start_ms": 444050,
      "end_ms": 445280,
      "text": "值得被思考的"
    },
    {
      "ordinal": 180,
      "start_ms": 445280,
      "end_ms": 447080,
      "text": "哪些练习是不得不值得被说的"
    },
    {
      "ordinal": 181,
      "start_ms": 447080,
      "end_ms": 447980,
      "text": "不值得被思考的"
    },
    {
      "ordinal": 182,
      "start_ms": 447980,
      "end_ms": 449320,
      "text": "他们的标准在哪里"
    },
    {
      "ordinal": 183,
      "start_ms": 449320,
      "end_ms": 453270,
      "text": "他要告诉你就是主要联系和次要联系"
    },
    {
      "ordinal": 184,
      "start_ms": 453810,
      "end_ms": 457050,
      "text": "那主要联系就决定了他们是矛盾的主要方面"
    },
    {
      "ordinal": 185,
      "start_ms": 457050,
      "end_ms": 457620,
      "text": "次要方面"
    },
    {
      "ordinal": 186,
      "start_ms": 457620,
      "end_ms": 459900,
      "text": "所有这些东西都仅仅是一个"
    },
    {
      "ordinal": 187,
      "start_ms": 459900,
      "end_ms": 462060,
      "text": "非常简单的主次二分法"
    },
    {
      "ordinal": 188,
      "start_ms": 462060,
      "end_ms": 463320,
      "text": "这个主次二分法"
    },
    {
      "ordinal": 189,
      "start_ms": 463320,
      "end_ms": 465980,
      "text": "本质上就是一个非常简单的独断论"
    },
    {
      "ordinal": 190,
      "start_ms": 465980,
      "end_ms": 468860,
      "text": "所谓的独断论就是告诉你哪些东西是主要的"
    },
    {
      "ordinal": 191,
      "start_ms": 468860,
      "end_ms": 470840,
      "text": "那些东西是决定性的"
    },
    {
      "ordinal": 192,
      "start_ms": 470840,
      "end_ms": 471980,
      "text": "其他东西都是派什么的"
    },
    {
      "ordinal": 193,
      "start_ms": 471980,
      "end_ms": 472580,
      "text": "无关紧要的"
    },
    {
      "ordinal": 194,
      "start_ms": 472580,
      "end_ms": 473340,
      "text": "不用说话"
    },
    {
      "ordinal": 195,
      "start_ms": 473340,
      "end_ms": 475210,
      "text": "甚至可以说其他东西就虚无"
    },
    {
      "ordinal": 196,
      "start_ms": 475425,
      "end_ms": 477610,
      "text": "但这他们会多一句话啊"
    },
    {
      "ordinal": 197,
      "start_ms": 477610,
      "end_ms": 480490,
      "text": "次要矛盾在特定情况下会转变成主要矛盾"
    },
    {
      "ordinal": 198,
      "start_ms": 480490,
      "end_ms": 482510,
      "text": "那你告诉我是哪哪种特定情况"
    },
    {
      "ordinal": 199,
      "start_ms": 482510,
      "end_ms": 486310,
      "text": "这种特定情况为什么会发生对吧"
    },
    {
      "ordinal": 200,
      "start_ms": 486310,
      "end_ms": 487720,
      "text": "既然有这种特定情况"
    },
    {
      "ordinal": 201,
      "start_ms": 487720,
      "end_ms": 491699,
      "text": "那我们为什么不说他只是暂时的主要矛盾"
    },
    {
      "ordinal": 202,
      "start_ms": 491699,
      "end_ms": 493499,
      "text": "他后面会变成思想矛盾"
    },
    {
      "ordinal": 203,
      "start_ms": 493499,
      "end_ms": 495460,
      "text": "这种转化过程啊"
    },
    {
      "ordinal": 204,
      "start_ms": 495460,
      "end_ms": 498100,
      "text": "他当然它有一定的科学性在里面"
    },
    {
      "ordinal": 205,
      "start_ms": 498100,
      "end_ms": 500260,
      "text": "什么叫特定特定情况"
    },
    {
      "ordinal": 206,
      "start_ms": 500260,
      "end_ms": 501500,
      "text": "何为特定情况"
    },
    {
      "ordinal": 207,
      "start_ms": 501500,
      "end_ms": 503420,
      "text": "我们在一个事态当中"
    },
    {
      "ordinal": 208,
      "start_ms": 503420,
      "end_ms": 505040,
      "text": "在一个矛盾的事态当中"
    },
    {
      "ordinal": 209,
      "start_ms": 505040,
      "end_ms": 507470,
      "text": "我们去如何把情况"
    },
    {
      "ordinal": 210,
      "start_ms": 507470,
      "end_ms": 509880,
      "text": "他背后的背景和这个矛盾本身"
    },
    {
      "ordinal": 211,
      "start_ms": 509880,
      "end_ms": 511320,
      "text": "华哥开了"
    },
    {
      "ordinal": 212,
      "start_ms": 511320,
      "end_ms": 512370,
      "text": "对不对"
    },
    {
      "ordinal": 213,
      "start_ms": 512370,
      "end_ms": 513780,
      "text": "你这样说的话"
    },
    {
      "ordinal": 214,
      "start_ms": 513780,
      "end_ms": 516760,
      "text": "特定情况下矛盾的主次方面可以转化"
    },
    {
      "ordinal": 215,
      "start_ms": 516760,
      "end_ms": 518620,
      "text": "可以一个特定情况下"
    },
    {
      "ordinal": 216,
      "start_ms": 518620,
      "end_ms": 521320,
      "text": "那个重要的矛盾和次要的矛盾会发展转化"
    },
    {
      "ordinal": 217,
      "start_ms": 521320,
      "end_ms": 524800,
      "text": "你告诉我那特定情况是不是矛盾的一部分"
    },
    {
      "ordinal": 218,
      "start_ms": 524800,
      "end_ms": 527500,
      "text": "这个情境是不是这个矛盾整个事态的一部分"
    },
    {
      "ordinal": 219,
      "start_ms": 527500,
      "end_ms": 529420,
      "text": "那么这个情境在这个事态当中"
    },
    {
      "ordinal": 220,
      "start_ms": 529420,
      "end_ms": 530890,
      "text": "他是主要矛盾还是思想矛盾"
    },
    {
      "ordinal": 221,
      "start_ms": 530890,
      "end_ms": 533880,
      "text": "他既然可以主导整个主次关系的转化"
    },
    {
      "ordinal": 222,
      "start_ms": 533880,
      "end_ms": 535560,
      "text": "那这个所谓的情境"
    },
    {
      "ordinal": 223,
      "start_ms": 535560,
      "end_ms": 538800,
      "text": "所谓的大环境实际上它是一个政治性的隐喻了"
    },
    {
      "ordinal": 224,
      "start_ms": 538800,
      "end_ms": 543420,
      "text": "这个政治性隐喻实质上就是你知道的power权利啊"
    },
    {
      "ordinal": 225,
      "start_ms": 543420,
      "end_ms": 544140,
      "text": "这个政治性语言"
    },
    {
      "ordinal": 226,
      "start_ms": 544140,
      "end_ms": 547599,
      "text": "你这个背景就实质上就是所有一切矛盾的"
    },
    {
      "ordinal": 227,
      "start_ms": 547860,
      "end_ms": 549420,
      "text": "主要嘛核心嘛"
    },
    {
      "ordinal": 228,
      "start_ms": 549420,
      "end_ms": 550860,
      "text": "那么这个核心的确立"
    },
    {
      "ordinal": 229,
      "start_ms": 550860,
      "end_ms": 552660,
      "text": "这个所谓的背景的这个确立"
    },
    {
      "ordinal": 230,
      "start_ms": 552660,
      "end_ms": 555020,
      "text": "这个最宏大的这个背景的确立"
    },
    {
      "ordinal": 231,
      "start_ms": 555020,
      "end_ms": 556670,
      "text": "就是独断论啊"
    },
    {
      "ordinal": 232,
      "start_ms": 556670,
      "end_ms": 560339,
      "text": "所以我我们会发现"
    },
    {
      "ordinal": 233,
      "start_ms": 564320,
      "end_ms": 567640,
      "text": "我们的教科书系统对于辩证法的理解"
    },
    {
      "ordinal": 234,
      "start_ms": 567640,
      "end_ms": 569530,
      "text": "是停留在独断论的层面上"
    },
    {
      "ordinal": 235,
      "start_ms": 569530,
      "end_ms": 573320,
      "text": "那么独断论实质上在呃哲学谱系上"
    },
    {
      "ordinal": 236,
      "start_ms": 573320,
      "end_ms": 579430,
      "text": "他是他是连康德康德都是克服了独断论的啊"
    },
    {
      "ordinal": 237,
      "start_ms": 579430,
      "end_ms": 580000,
      "text": "某种意义上"
    },
    {
      "ordinal": 238,
      "start_ms": 580000,
      "end_ms": 581290,
      "text": "笛卡尔就已经"
    },
    {
      "ordinal": 239,
      "start_ms": 581290,
      "end_ms": 584370,
      "text": "斯宾诺莎就已经克服了独断论了啊"
    },
    {
      "ordinal": 240,
      "start_ms": 584370,
      "end_ms": 587960,
      "text": "否则他们不会他们哲学不会那么保守啊"
    },
    {
      "ordinal": 241,
      "start_ms": 587960,
      "end_ms": 589400,
      "text": "或者是或者说基金"
    },
    {
      "ordinal": 242,
      "start_ms": 589400,
      "end_ms": 593300,
      "text": "那么连康德的层次都没有达到了一个独特论者"
    },
    {
      "ordinal": 243,
      "start_ms": 593300,
      "end_ms": 595180,
      "text": "他既然可以说他"
    },
    {
      "ordinal": 244,
      "start_ms": 596800,
      "end_ms": 599160,
      "text": "他已经达到了既继承了康德"
    },
    {
      "ordinal": 245,
      "start_ms": 599160,
      "end_ms": 601860,
      "text": "又极大程度上发展了康德的黑格尔的辩证法"
    },
    {
      "ordinal": 246,
      "start_ms": 601860,
      "end_ms": 602460,
      "text": "那个水平"
    },
    {
      "ordinal": 247,
      "start_ms": 602460,
      "end_ms": 605060,
      "text": "辩证法远远不是这些独断论可以去"
    },
    {
      "ordinal": 248,
      "start_ms": 605200,
      "end_ms": 606820,
      "text": "可以去冒充的啊"
    },
    {
      "ordinal": 249,
      "start_ms": 606820,
      "end_ms": 609680,
      "text": "就是就是非常非常侮辱的"
    },
    {
      "ordinal": 250,
      "start_ms": 609680,
      "end_ms": 612700,
      "text": "这对于思想本身是非常侮辱性的一种作为"
    },
    {
      "ordinal": 251,
      "start_ms": 612700,
      "end_ms": 614560,
      "text": "包括你们去看那个人民的名义里面"
    },
    {
      "ordinal": 252,
      "start_ms": 614560,
      "end_ms": 616960,
      "text": "会夸里面那个高书记会讲辩证法"
    },
    {
      "ordinal": 253,
      "start_ms": 616960,
      "end_ms": 618220,
      "text": "其实他就是会诡辩嘛"
    },
    {
      "ordinal": 254,
      "start_ms": 618220,
      "end_ms": 619890,
      "text": "会偷问概念嘛啊"
    },
    {
      "ordinal": 255,
      "start_ms": 619890,
      "end_ms": 622600,
      "text": "会把概念的特殊的特殊情况下使用"
    },
    {
      "ordinal": 256,
      "start_ms": 622600,
      "end_ms": 623890,
      "text": "和普遍情况下使用"
    },
    {
      "ordinal": 257,
      "start_ms": 623890,
      "end_ms": 626080,
      "text": "会把概念的形容词性能使用"
    },
    {
      "ordinal": 258,
      "start_ms": 626080,
      "end_ms": 628860,
      "text": "和一个实体化的名词的使用混淆起来吗"
    },
    {
      "ordinal": 259,
      "start_ms": 628860,
      "end_ms": 630150,
      "text": "那这不是辩证法"
    },
    {
      "ordinal": 260,
      "start_ms": 630150,
      "end_ms": 631590,
      "text": "这实际上是鬼变数了"
    },
    {
      "ordinal": 261,
      "start_ms": 631590,
      "end_ms": 633760,
      "text": "辩证法比这而复杂的多"
    },
    {
      "ordinal": 262,
      "start_ms": 633760,
      "end_ms": 636520,
      "text": "辩证法实质上它能够某种意义上能够"
    },
    {
      "ordinal": 263,
      "start_ms": 636520,
      "end_ms": 638260,
      "text": "辩证法没有过时"
    },
    {
      "ordinal": 264,
      "start_ms": 638720,
      "end_ms": 641200,
      "text": "当然法国的一些结构主义哲学家认为"
    },
    {
      "ordinal": 265,
      "start_ms": 641200,
      "end_ms": 641920,
      "text": "辩证法过时"
    },
    {
      "ordinal": 266,
      "start_ms": 641920,
      "end_ms": 643720,
      "text": "并且猛烈的批评辩证法"
    },
    {
      "ordinal": 267,
      "start_ms": 643720,
      "end_ms": 648239,
      "text": "但是现在也有一些哲学家认为"
    },
    {
      "ordinal": 268,
      "start_ms": 648239,
      "end_ms": 650699,
      "text": "包括分析哲学啊"
    },
    {
      "ordinal": 269,
      "start_ms": 650699,
      "end_ms": 653609,
      "text": "因为当代的分析哲学会回归到辩证法当中去"
    },
    {
      "ordinal": 270,
      "start_ms": 653609,
      "end_ms": 656780,
      "text": "去吸收一些整个符号系统本身运行"
    },
    {
      "ordinal": 271,
      "start_ms": 656780,
      "end_ms": 658040,
      "text": "我们的整个思维系统"
    },
    {
      "ordinal": 272,
      "start_ms": 658040,
      "end_ms": 658580,
      "text": "意识系统"
    },
    {
      "ordinal": 273,
      "start_ms": 658580,
      "end_ms": 660080,
      "text": "精准系统本身运行"
    },
    {
      "ordinal": 274,
      "start_ms": 660080,
      "end_ms": 661780,
      "text": "它会发生了一些固有矛盾"
    },
    {
      "ordinal": 275,
      "start_ms": 661780,
      "end_ms": 664090,
      "text": "那么辩证法就是利用这些固有矛盾"
    },
    {
      "ordinal": 276,
      "start_ms": 664090,
      "end_ms": 666700,
      "text": "他们这些固有矛盾中看到的这些系统"
    },
    {
      "ordinal": 277,
      "start_ms": 666700,
      "end_ms": 667980,
      "text": "他们运行的机制"
    },
    {
      "ordinal": 278,
      "start_ms": 667980,
      "end_ms": 671040,
      "text": "并且用一种方式去把这种极致表达出来"
    },
    {
      "ordinal": 279,
      "start_ms": 671040,
      "end_ms": 671760,
      "text": "这叫辩证法"
    },
    {
      "ordinal": 280,
      "start_ms": 671760,
      "end_ms": 675200,
      "text": "那么我们之后会比较仔细的去探讨"
    },
    {
      "ordinal": 281,
      "start_ms": 675200,
      "end_ms": 677390,
      "text": "何为辩证法啊"
    },
    {
      "ordinal": 282,
      "start_ms": 677390,
      "end_ms": 682629,
      "text": "what is dialectics啊啊当你了解了什么叫辩证法"
    },
    {
      "ordinal": 283,
      "start_ms": 682629,
      "end_ms": 684009,
      "text": "掌握了辩证法的内容之后"
    },
    {
      "ordinal": 284,
      "start_ms": 684009,
      "end_ms": 685860,
      "text": "辩证法的那种思维方法之后"
    },
    {
      "ordinal": 285,
      "start_ms": 685860,
      "end_ms": 688590,
      "text": "我觉得你才有资格去思考什么叫形而上学"
    },
    {
      "ordinal": 286,
      "start_ms": 688590,
      "end_ms": 690540,
      "text": "黑格尔并不觉得形而上学是一个"
    },
    {
      "ordinal": 287,
      "start_ms": 690540,
      "end_ms": 693739,
      "text": "而是一个和辩证法对立的是一个第第"
    },
    {
      "ordinal": 288,
      "start_ms": 693739,
      "end_ms": 696409,
      "text": "第第一件呢是一个低等的一个词汇变"
    },
    {
      "ordinal": 289,
      "start_ms": 696409,
      "end_ms": 698220,
      "text": "形而上学是一个非常高的词汇"
    },
    {
      "ordinal": 290,
      "start_ms": 698220,
      "end_ms": 701430,
      "text": "形而上学本身它研究的不是僵死的孤立等级"
    },
    {
      "ordinal": 291,
      "start_ms": 701430,
      "end_ms": 705800,
      "text": "形而上学研究的是其是一般方法"
    },
    {
      "ordinal": 292,
      "start_ms": 705800,
      "end_ms": 707180,
      "text": "没办法研究的东西"
    },
    {
      "ordinal": 293,
      "start_ms": 707180,
      "end_ms": 709640,
      "text": "你在形而上学当中可以运用辩证法的方式"
    },
    {
      "ordinal": 294,
      "start_ms": 709640,
      "end_ms": 711350,
      "text": "可以运用结构主义的方式"
    },
    {
      "ordinal": 295,
      "start_ms": 711350,
      "end_ms": 713000,
      "text": "可以运用存在主义的"
    },
    {
      "ordinal": 296,
      "start_ms": 713000,
      "end_ms": 715980,
      "text": "可以用现象学的方式在形而上学内部"
    },
    {
      "ordinal": 297,
      "start_ms": 715980,
      "end_ms": 718500,
      "text": "形而上学在海德格尔看来就是哲学的代名词"
    },
    {
      "ordinal": 298,
      "start_ms": 718500,
      "end_ms": 719100,
      "text": "哲学集"
    },
    {
      "ordinal": 299,
      "start_ms": 719100,
      "end_ms": 722900,
      "text": "形而上学就是我们在处理完的具体的这个框架"
    },
    {
      "ordinal": 300,
      "start_ms": 722900,
      "end_ms": 724040,
      "text": "内部的问题之后"
    },
    {
      "ordinal": 301,
      "start_ms": 724040,
      "end_ms": 726700,
      "text": "我现在要去分析这框架本身的问题了"
    },
    {
      "ordinal": 302,
      "start_ms": 726730,
      "end_ms": 729940,
      "text": "处理完这个事件具体的事物的时候"
    },
    {
      "ordinal": 303,
      "start_ms": 729940,
      "end_ms": 733259,
      "text": "我要去处理这个世界普遍都具有的问题了"
    },
    {
      "ordinal": 304,
      "start_ms": 733259,
      "end_ms": 734279,
      "text": "这叫形而上学"
    },
    {
      "ordinal": 305,
      "start_ms": 735359,
      "end_ms": 736949,
      "text": "形而上学追求的普遍性"
    },
    {
      "ordinal": 306,
      "start_ms": 736949,
      "end_ms": 739630,
      "text": "不代表他就是追求僵死的普遍性"
    },
    {
      "ordinal": 307,
      "start_ms": 739630,
      "end_ms": 740500,
      "text": "不代表将死"
    },
    {
      "ordinal": 308,
      "start_ms": 740500,
      "end_ms": 742850,
      "text": "因为普遍性具有内在的矛盾"
    },
    {
      "ordinal": 309,
      "start_ms": 742850,
      "end_ms": 746060,
      "text": "那么这个内在的矛盾是由辩证法揭露出来的"
    },
    {
      "ordinal": 310,
      "start_ms": 746060,
      "end_ms": 747620,
      "text": "一个好的形而上学家"
    },
    {
      "ordinal": 311,
      "start_ms": 747620,
      "end_ms": 751120,
      "text": "应该是喜欢喜欢去学习辩证法的"
    },
    {
      "ordinal": 312,
      "start_ms": 751120,
      "end_ms": 752260,
      "text": "一个好的辩证法家"
    },
    {
      "ordinal": 313,
      "start_ms": 752260,
      "end_ms": 754960,
      "text": "应该是非常热衷于去研究形而上学问题的"
    },
    {
      "ordinal": 314,
      "start_ms": 754960,
      "end_ms": 758640,
      "text": "因为如果你的思维不能够达到形而上学的高度"
    },
    {
      "ordinal": 315,
      "start_ms": 758640,
      "end_ms": 762020,
      "text": "你的内心分析就是你对于心灵内在啊"
    },
    {
      "ordinal": 316,
      "start_ms": 762020,
      "end_ms": 763220,
      "text": "一些观念啊"
    },
    {
      "ordinal": 317,
      "start_ms": 763220,
      "end_ms": 768820,
      "text": "一些呃概念系统的一些反省就不会是深刻的啊"
    },
    {
      "ordinal": 318,
      "start_ms": 768820,
      "end_ms": 772600,
      "text": "所以哲学本身并不存在"
    },
    {
      "ordinal": 319,
      "start_ms": 772600,
      "end_ms": 777400,
      "text": "形而上学和或者说辩证法这么一种对立的"
    },
    {
      "ordinal": 320,
      "start_ms": 777400,
      "end_ms": 778360,
      "text": "一种矛盾的"
    },
    {
      "ordinal": 321,
      "start_ms": 778360,
      "end_ms": 781540,
      "text": "它唯一存在的就是对这两个概念的同时的误解"
    },
    {
      "ordinal": 322,
      "start_ms": 781540,
      "end_ms": 783640,
      "text": "以及对对于概念本身的误解"
    },
    {
      "ordinal": 323,
      "start_ms": 783640,
      "end_ms": 785140,
      "text": "我觉得编这个教科书的人"
    },
    {
      "ordinal": 324,
      "start_ms": 785140,
      "end_ms": 787240,
      "text": "他可以连概念本身是什么"
    },
    {
      "ordinal": 325,
      "start_ms": 787240,
      "end_ms": 788920,
      "text": "他们都没有去思考过他"
    },
    {
      "ordinal": 326,
      "start_ms": 788920,
      "end_ms": 791320,
      "text": "他的思维停留在一个独断论的那"
    },
    {
      "ordinal": 327,
      "start_ms": 791320,
      "end_ms": 794360,
      "text": "考虑到当时的时代背景啊"
    },
    {
      "ordinal": 328,
      "start_ms": 794360,
      "end_ms": 795500,
      "text": "他的独断论"
    },
    {
      "ordinal": 329,
      "start_ms": 795500,
      "end_ms": 798740,
      "text": "他们认为这个背景可以使得主次矛盾转化"
    },
    {
      "ordinal": 330,
      "start_ms": 798740,
      "end_ms": 800060,
      "text": "他们有意识到背景本身"
    },
    {
      "ordinal": 331,
      "start_ms": 800060,
      "end_ms": 803540,
      "text": "就是这个矛盾当中的一个环节啊"
    },
    {
      "ordinal": 332,
      "start_ms": 803540,
      "end_ms": 807500,
      "text": "可以说呃有时代的局限"
    },
    {
      "ordinal": 333,
      "start_ms": 807500,
      "end_ms": 809780,
      "text": "那么我们这代人不能够停留在那个时代"
    },
    {
      "ordinal": 334,
      "start_ms": 809780,
      "end_ms": 811310,
      "text": "我们的思想要继续往前走"
    },
    {
      "ordinal": 335,
      "start_ms": 811310,
      "end_ms": 812710,
      "text": "他们就必须通过学习"
    },
    {
      "ordinal": 336,
      "start_ms": 812710,
      "end_ms": 813970,
      "text": "如果不学习的话"
    },
    {
      "ordinal": 337,
      "start_ms": 813970,
      "end_ms": 815860,
      "text": "时代会把你抛弃啊"
    },
    {
      "ordinal": 338,
      "start_ms": 815860,
      "end_ms": 816939,
      "text": "这么简单"
    },
    {
      "ordinal": 339,
      "start_ms": 817600,
      "end_ms": 818820,
      "text": "今天就讲到这里"
    }
