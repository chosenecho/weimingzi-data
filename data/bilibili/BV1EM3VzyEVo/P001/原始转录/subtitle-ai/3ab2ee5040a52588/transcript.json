{
  "bvid": "BV1EM3VzyEVo",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "3ab2ee5040a525880b9095b86276fd3045817cf0b15952292749def3ecf4489e",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 0,
      "end_ms": 7109,
      "text": "我非正式的讲一些其实非常具有什价值的"
    },
    {
      "ordinal": 1,
      "start_ms": 7109,
      "end_ms": 9969,
      "text": "但这个东西只有我同行可以听啊"
    },
    {
      "ordinal": 2,
      "start_ms": 9969,
      "end_ms": 13650,
      "text": "就是嗯在这个时代"
    },
    {
      "ordinal": 3,
      "start_ms": 13650,
      "end_ms": 19290,
      "text": "意识形态已经没有办法支撑剥夺性的权利了"
    },
    {
      "ordinal": 4,
      "start_ms": 19290,
      "end_ms": 21650,
      "text": "剥夺性的惩罚性的权利"
    },
    {
      "ordinal": 5,
      "start_ms": 21650,
      "end_ms": 24290,
      "text": "所以你既然意识形态没有"
    },
    {
      "ordinal": 6,
      "start_ms": 24290,
      "end_ms": 27510,
      "text": "或者说乌托邦嗯"
    },
    {
      "ordinal": 7,
      "start_ms": 27510,
      "end_ms": 30050,
      "text": "OLIVER这种"
    },
    {
      "ordinal": 8,
      "start_ms": 31960,
      "end_ms": 35640,
      "text": "把主体议政化地去征召质询的"
    },
    {
      "ordinal": 9,
      "start_ms": 35640,
      "end_ms": 37710,
      "text": "这种意识形态机器"
    },
    {
      "ordinal": 10,
      "start_ms": 37710,
      "end_ms": 41550,
      "text": "他没有办法在这个享乐时代"
    },
    {
      "ordinal": 11,
      "start_ms": 41550,
      "end_ms": 42550,
      "text": "享乐时代啊"
    },
    {
      "ordinal": 12,
      "start_ms": 42550,
      "end_ms": 46310,
      "text": "享乐主义时代支撑一种剥夺性的"
    },
    {
      "ordinal": 13,
      "start_ms": 46310,
      "end_ms": 48690,
      "text": "否定性的啊"
    },
    {
      "ordinal": 14,
      "start_ms": 48690,
      "end_ms": 50770,
      "text": "恐吓性的权利"
    },
    {
      "ordinal": 15,
      "start_ms": 50770,
      "end_ms": 53160,
      "text": "这个威能是支撑不了的"
    },
    {
      "ordinal": 16,
      "start_ms": 53160,
      "end_ms": 54180,
      "text": "这个时代啊"
    },
    {
      "ordinal": 17,
      "start_ms": 54180,
      "end_ms": 57220,
      "text": "就是那就是儿子不认父亲嘛"
    },
    {
      "ordinal": 18,
      "start_ms": 57220,
      "end_ms": 57880,
      "text": "简单来讲"
    },
    {
      "ordinal": 19,
      "start_ms": 57880,
      "end_ms": 61490,
      "text": "这样就是子女不认这个这种"
    },
    {
      "ordinal": 20,
      "start_ms": 64849,
      "end_ms": 67500,
      "text": "父权式的威能"
    },
    {
      "ordinal": 21,
      "start_ms": 68880,
      "end_ms": 75750,
      "text": "所以没有办法再去通过意识形态来生产纪律"
    },
    {
      "ordinal": 22,
      "start_ms": 75750,
      "end_ms": 80740,
      "text": "那么纪律是通过通过什么方式生产出来的"
    },
    {
      "ordinal": 23,
      "start_ms": 83040,
      "end_ms": 85360,
      "text": "即使是通过"
    },
    {
      "ordinal": 24,
      "start_ms": 91920,
      "end_ms": 93420,
      "text": "两个东西"
    },
    {
      "ordinal": 25,
      "start_ms": 93420,
      "end_ms": 95440,
      "text": "现代人类的纪律"
    },
    {
      "ordinal": 26,
      "start_ms": 96440,
      "end_ms": 99330,
      "text": "我指的是是呃"
    },
    {
      "ordinal": 27,
      "start_ms": 99330,
      "end_ms": 102760,
      "text": "经过了那个意识形态时代的"
    },
    {
      "ordinal": 28,
      "start_ms": 102760,
      "end_ms": 105660,
      "text": "这个二十二十世纪的后半叶的纪律"
    },
    {
      "ordinal": 29,
      "start_ms": 105660,
      "end_ms": 107020,
      "text": "它的发生学"
    },
    {
      "ordinal": 30,
      "start_ms": 107020,
      "end_ms": 111200,
      "text": "是通过现代国家的两个两大社会性建制"
    },
    {
      "ordinal": 31,
      "start_ms": 111200,
      "end_ms": 116150,
      "text": "市场和学校来生产的"
    },
    {
      "ordinal": 32,
      "start_ms": 119400,
      "end_ms": 124680,
      "text": "市场保证的自由学校塑造的人格"
    },
    {
      "ordinal": 33,
      "start_ms": 132140,
      "end_ms": 133900,
      "text": "塑造了活动的轨道"
    },
    {
      "ordinal": 34,
      "start_ms": 135020,
      "end_ms": 137680,
      "text": "在这些轨道网络当中嗯"
    },
    {
      "ordinal": 35,
      "start_ms": 137680,
      "end_ms": 141530,
      "text": "仍按照特定的纪律啊"
    },
    {
      "ordinal": 36,
      "start_ms": 141530,
      "end_ms": 144980,
      "text": "相对自由的在这轨道中滑动啊"
    },
    {
      "ordinal": 37,
      "start_ms": 144980,
      "end_ms": 145880,
      "text": "做交易"
    },
    {
      "ordinal": 38,
      "start_ms": 145880,
      "end_ms": 149340,
      "text": "那是现代人类的一个主要模式"
    },
    {
      "ordinal": 39,
      "start_ms": 149340,
      "end_ms": 151460,
      "text": "主要生存模式"
    },
    {
      "ordinal": 40,
      "start_ms": 153640,
      "end_ms": 157610,
      "text": "所以要生产纪律就要生产认同"
    },
    {
      "ordinal": 41,
      "start_ms": 157610,
      "end_ms": 160610,
      "text": "生产人格只是一方面"
    },
    {
      "ordinal": 42,
      "start_ms": 160610,
      "end_ms": 164290,
      "text": "另外一方面要生产一个交易体系"
    },
    {
      "ordinal": 43,
      "start_ms": 166040,
      "end_ms": 169420,
      "text": "你生产出来的人格认同"
    },
    {
      "ordinal": 44,
      "start_ms": 169420,
      "end_ms": 173779,
      "text": "你和你的教育对象共同相处"
    },
    {
      "ordinal": 45,
      "start_ms": 173779,
      "end_ms": 175899,
      "text": "陪伴的这个年份"
    },
    {
      "ordinal": 46,
      "start_ms": 175899,
      "end_ms": 179079,
      "text": "这样一种亲缘关系"
    },
    {
      "ordinal": 47,
      "start_ms": 179599,
      "end_ms": 187059,
      "text": "能够在一个体系当中交易成他现实的生活利益"
    },
    {
      "ordinal": 48,
      "start_ms": 187059,
      "end_ms": 188730,
      "text": "生活方式"
    },
    {
      "ordinal": 49,
      "start_ms": 188730,
      "end_ms": 195560,
      "text": "现实的群体间的关系和他个人的地位啊"
    },
    {
      "ordinal": 50,
      "start_ms": 195560,
      "end_ms": 197960,
      "text": "他和他的个人和群体的关系啊"
    },
    {
      "ordinal": 51,
      "start_ms": 197960,
      "end_ms": 200320,
      "text": "以及他他他个人的地位"
    },
    {
      "ordinal": 52,
      "start_ms": 200320,
      "end_ms": 204100,
      "text": "那么就能生成纪律"
    },
    {
      "ordinal": 53,
      "start_ms": 204380,
      "end_ms": 207320,
      "text": "这样一种纪律不是出于恐惧"
    },
    {
      "ordinal": 54,
      "start_ms": 207320,
      "end_ms": 208840,
      "text": "不是出于剥夺"
    },
    {
      "ordinal": 55,
      "start_ms": 208840,
      "end_ms": 210740,
      "text": "不是出于惩罚"
    },
    {
      "ordinal": 56,
      "start_ms": 210740,
      "end_ms": 214360,
      "text": "不是出于嗯未发生的枪害呀"
    },
    {
      "ordinal": 57,
      "start_ms": 214360,
      "end_ms": 218319,
      "text": "然后去让他迫使他服从这样的纪律"
    },
    {
      "ordinal": 58,
      "start_ms": 218319,
      "end_ms": 220759,
      "text": "来自于他的认同"
    },
    {
      "ordinal": 59,
      "start_ms": 220759,
      "end_ms": 224910,
      "text": "也就是说在军事上我们都讲了呃"
    },
    {
      "ordinal": 60,
      "start_ms": 224910,
      "end_ms": 227360,
      "text": "军队有呃"
    },
    {
      "ordinal": 61,
      "start_ms": 227360,
      "end_ms": 229600,
      "text": "古典古代军队士气战"
    },
    {
      "ordinal": 62,
      "start_ms": 229600,
      "end_ms": 230700,
      "text": "勇气战啊"
    },
    {
      "ordinal": 63,
      "start_ms": 230700,
      "end_ms": 234340,
      "text": "然后是这个近代军队是纪律战"
    },
    {
      "ordinal": 64,
      "start_ms": 234340,
      "end_ms": 235940,
      "text": "惩罚性的纪律战"
    },
    {
      "ordinal": 65,
      "start_ms": 235940,
      "end_ms": 240420,
      "text": "现现代军队呢那就是这个信仰战"
    },
    {
      "ordinal": 66,
      "start_ms": 240660,
      "end_ms": 242380,
      "text": "认同战"
    },
    {
      "ordinal": 67,
      "start_ms": 243480,
      "end_ms": 247800,
      "text": "啊那我们认为目前"
    },
    {
      "ordinal": 68,
      "start_ms": 248960,
      "end_ms": 252420,
      "text": "所以所以我们看到就是还具有某种这个"
    },
    {
      "ordinal": 69,
      "start_ms": 252420,
      "end_ms": 256839,
      "text": "社运动能的这个民间团体啊"
    },
    {
      "ordinal": 70,
      "start_ms": 257000,
      "end_ms": 259140,
      "text": "它都来自于学校系统"
    },
    {
      "ordinal": 71,
      "start_ms": 259140,
      "end_ms": 260519,
      "text": "都来自于教育系统"
    },
    {
      "ordinal": 72,
      "start_ms": 260519,
      "end_ms": 266090,
      "text": "但是呢他们试图是使得他们的社运当中产生的"
    },
    {
      "ordinal": 73,
      "start_ms": 266090,
      "end_ms": 267590,
      "text": "这种师徒关系"
    },
    {
      "ordinal": 74,
      "start_ms": 267590,
      "end_ms": 271290,
      "text": "教育关系产生出来的这些符号"
    },
    {
      "ordinal": 75,
      "start_ms": 271290,
      "end_ms": 273850,
      "text": "这价值能够被交易"
    },
    {
      "ordinal": 76,
      "start_ms": 273850,
      "end_ms": 277050,
      "text": "或者说至少被额市场啊"
    },
    {
      "ordinal": 77,
      "start_ms": 277050,
      "end_ms": 278885,
      "text": "或者说呃就是"
    },
    {
      "ordinal": 78,
      "start_ms": 280900,
      "end_ms": 287500,
      "text": "那些western forces被这些势力啊"
    },
    {
      "ordinal": 79,
      "start_ms": 287500,
      "end_ms": 289440,
      "text": "他们所认可"
    },
    {
      "ordinal": 80,
      "start_ms": 289440,
      "end_ms": 291100,
      "text": "他们有交交易的价值"
    },
    {
      "ordinal": 81,
      "start_ms": 291100,
      "end_ms": 293480,
      "text": "但是玩脱了他"
    },
    {
      "ordinal": 82,
      "start_ms": 293480,
      "end_ms": 295560,
      "text": "他没有交易价值"
    },
    {
      "ordinal": 83,
      "start_ms": 295560,
      "end_ms": 296480,
      "text": "他换不了那些东西"
    },
    {
      "ordinal": 84,
      "start_ms": 296480,
      "end_ms": 300810,
      "text": "或者说他换出来这些交易价值是有价无市啊"
    },
    {
      "ordinal": 85,
      "start_ms": 300810,
      "end_ms": 303510,
      "text": "他也换不了他的生存利益"
    },
    {
      "ordinal": 86,
      "start_ms": 304719,
      "end_ms": 306839,
      "text": "所以他就算有教育端"
    },
    {
      "ordinal": 87,
      "start_ms": 306839,
      "end_ms": 307959,
      "text": "它没有市场端"
    },
    {
      "ordinal": 88,
      "start_ms": 307959,
      "end_ms": 308939,
      "text": "没有交易端"
    },
    {
      "ordinal": 89,
      "start_ms": 308939,
      "end_ms": 312069,
      "text": "他的纪律是不彻底的"
    },
    {
      "ordinal": 90,
      "start_ms": 312069,
      "end_ms": 313989,
      "text": "它不能循环起来的"
    },
    {
      "ordinal": 91,
      "start_ms": 315229,
      "end_ms": 316549,
      "text": "这个是比较典型的"
    },
    {
      "ordinal": 92,
      "start_ms": 316549,
      "end_ms": 319060,
      "text": "就是说噔噔噔噔噔噔"
    },
    {
      "ordinal": 93,
      "start_ms": 319060,
      "end_ms": 320540,
      "text": "这是个知识分子群体"
    },
    {
      "ordinal": 94,
      "start_ms": 320540,
      "end_ms": 323100,
      "text": "是个教育教育关系扭结起来的群体"
    },
    {
      "ordinal": 95,
      "start_ms": 323100,
      "end_ms": 325180,
      "text": "还有这个嗯"
    },
    {
      "ordinal": 96,
      "start_ms": 326960,
      "end_ms": 328440,
      "text": "什么什么什么主权"
    },
    {
      "ordinal": 97,
      "start_ms": 328440,
      "end_ms": 330680,
      "text": "还有包括这个球呃"
    },
    {
      "ordinal": 98,
      "start_ms": 330680,
      "end_ms": 333660,
      "text": "这个仇士系的这帮啊"
    },
    {
      "ordinal": 99,
      "start_ms": 333660,
      "end_ms": 337920,
      "text": "这这主要他们成员都是中高级知识分子"
    },
    {
      "ordinal": 100,
      "start_ms": 338650,
      "end_ms": 340610,
      "text": "和一些就学生"
    },
    {
      "ordinal": 101,
      "start_ms": 342250,
      "end_ms": 347650,
      "text": "大学学生就是我们要清醒地意识到"
    },
    {
      "ordinal": 102,
      "start_ms": 347650,
      "end_ms": 352080,
      "text": "反抗需要在形式上模仿统治"
    },
    {
      "ordinal": 103,
      "start_ms": 352080,
      "end_ms": 358550,
      "text": "统治是通过自由和认同自由和服从啊"
    },
    {
      "ordinal": 104,
      "start_ms": 358550,
      "end_ms": 366170,
      "text": "或者说自由和这个啊人格persona就是个面具"
    },
    {
      "ordinal": 105,
      "start_ms": 366170,
      "end_ms": 368490,
      "text": "伪装啊"
    },
    {
      "ordinal": 106,
      "start_ms": 368490,
      "end_ms": 371470,
      "text": "活动空间和伪装交易空间"
    },
    {
      "ordinal": 107,
      "start_ms": 371470,
      "end_ms": 376430,
      "text": "交易机会和伪装和特定的伪装来促成的"
    },
    {
      "ordinal": 108,
      "start_ms": 376430,
      "end_ms": 381410,
      "text": "对他的服从统治是经由市场和学校来促成"
    },
    {
      "ordinal": 109,
      "start_ms": 381410,
      "end_ms": 383360,
      "text": "促成服服从的"
    },
    {
      "ordinal": 110,
      "start_ms": 383360,
      "end_ms": 387440,
      "text": "那你知道不能比你的敌人差"
    },
    {
      "ordinal": 111,
      "start_ms": 388200,
      "end_ms": 390200,
      "text": "你也必须要有交易规则"
    },
    {
      "ordinal": 112,
      "start_ms": 390200,
      "end_ms": 390880,
      "text": "交易空间"
    },
    {
      "ordinal": 113,
      "start_ms": 391880,
      "end_ms": 396370,
      "text": "你也必须要有你的教育啊"
    },
    {
      "ordinal": 114,
      "start_ms": 396370,
      "end_ms": 399210,
      "text": "你必须要有你的学校"
    },
    {
      "ordinal": 115,
      "start_ms": 400370,
      "end_ms": 404790,
      "text": "必须要有你的这种身份认同面子"
    },
    {
      "ordinal": 116,
      "start_ms": 404790,
      "end_ms": 407850,
      "text": "personal翻译成面子比较好"
    },
    {
      "ordinal": 117,
      "start_ms": 408990,
      "end_ms": 409550,
      "text": "所以"
    },
    {
      "ordinal": 118,
      "start_ms": 411950,
      "end_ms": 413890,
      "text": "这是破局的某种影响是关键"
    },
    {
      "ordinal": 119,
      "start_ms": 413890,
      "end_ms": 415710,
      "text": "但是"
    },
    {
      "ordinal": 120,
      "start_ms": 416590,
      "end_ms": 423340,
      "text": "其实就是当时那孙权在那工人大学啥的啊"
    },
    {
      "ordinal": 121,
      "start_ms": 423340,
      "end_ms": 424660,
      "text": "没有起到这个作用"
    },
    {
      "ordinal": 122,
      "start_ms": 424660,
      "end_ms": 428790,
      "text": "他这个东西是没有办法实现交易的"
    },
    {
      "ordinal": 123,
      "start_ms": 428790,
      "end_ms": 430590,
      "text": "没办法循环起来啊"
    },
    {
      "ordinal": 124,
      "start_ms": 430590,
      "end_ms": 432490,
      "text": "没有那个功能的"
    },
    {
      "ordinal": 125,
      "start_ms": 432490,
      "end_ms": 434730,
      "text": "但他他就所在那个时代的话"
    },
    {
      "ordinal": 126,
      "start_ms": 434730,
      "end_ms": 437820,
      "text": "其实也没有这个交易市场的存在"
    },
    {
      "ordinal": 127,
      "start_ms": 439800,
      "end_ms": 440960,
      "text": "反正我就讲这么多"
    },
    {
      "ordinal": 128,
      "start_ms": 443400,
      "end_ms": 446000,
      "text": "我觉得我讲的已经够多了"
    },
    {
      "ordinal": 129,
      "start_ms": 447460,
      "end_ms": 449260,
      "text": "我也困倦"
    },
    {
      "ordinal": 130,
      "start_ms": 450230,
      "end_ms": 451710,
      "text": "但是休息完了之后"
    },
    {
      "ordinal": 131,
      "start_ms": 451710,
      "end_ms": 454910,
      "text": "我还是得去重新恢复起来"
    },
    {
      "ordinal": 132,
      "start_ms": 454910,
      "end_ms": 456690,
      "text": "振作振作起来啊"
    },
    {
      "ordinal": 133,
      "start_ms": 456690,
      "end_ms": 458710,
      "text": "去思考这些东西"
    },
    {
      "ordinal": 134,
      "start_ms": 459310,
      "end_ms": 459830,
      "text": "好吧"
    },
    {
      "ordinal": 135,
      "start_ms": 460830,
      "end_ms": 463100,
      "text": "这个"
    },
    {
      "ordinal": 136,
      "start_ms": 465480,
      "end_ms": 466400,
      "text": "意识形态"
    },
    {
      "ordinal": 137,
      "start_ms": 467560,
      "end_ms": 470909,
      "text": "但是意识形态也很重要啊"
    },
    {
      "ordinal": 138,
      "start_ms": 470909,
      "end_ms": 472169,
      "text": "意识形态也很重要"
    },
    {
      "ordinal": 139,
      "start_ms": 472169,
      "end_ms": 475929,
      "text": "意识形态是短平快的东西啊"
    },
    {
      "ordinal": 140,
      "start_ms": 475929,
      "end_ms": 478320,
      "text": "意识形态是呃"
    },
    {
      "ordinal": 141,
      "start_ms": 478320,
      "end_ms": 480250,
      "text": "稍微有点"
    },
    {
      "ordinal": 142,
      "start_ms": 480250,
      "end_ms": 482650,
      "text": "我本来认为纪律是硬的东西"
    },
    {
      "ordinal": 143,
      "start_ms": 482650,
      "end_ms": 484050,
      "text": "意识形态是软的东西"
    },
    {
      "ordinal": 144,
      "start_ms": 484050,
      "end_ms": 486050,
      "text": "现在我感觉是反过来的"
    },
    {
      "ordinal": 145,
      "start_ms": 486050,
      "end_ms": 488500,
      "text": "意识形态是锋锐的东西"
    },
    {
      "ordinal": 146,
      "start_ms": 488500,
      "end_ms": 489980,
      "text": "是要站队的"
    },
    {
      "ordinal": 147,
      "start_ms": 489980,
      "end_ms": 494020,
      "text": "而纪律呢啊普遍来讲都有纪律"
    },
    {
      "ordinal": 148,
      "start_ms": 494020,
      "end_ms": 496820,
      "text": "现在现在还存在这种战队"
    },
    {
      "ordinal": 149,
      "start_ms": 496820,
      "end_ms": 497540,
      "text": "不是战队"
    },
    {
      "ordinal": 150,
      "start_ms": 497540,
      "end_ms": 498540,
      "text": "现在存在的战队"
    },
    {
      "ordinal": 151,
      "start_ms": 498540,
      "end_ms": 501700,
      "text": "是有纪律和无纪纪律者之中的一个选择"
    },
    {
      "ordinal": 152,
      "start_ms": 501700,
      "end_ms": 502640,
      "text": "但这不是战队"
    },
    {
      "ordinal": 153,
      "start_ms": 502640,
      "end_ms": 503880,
      "text": "聪明人都会选择有纪律"
    },
    {
      "ordinal": 154,
      "start_ms": 503880,
      "end_ms": 506470,
      "text": "无纪律就或者是懦夫啊"
    },
    {
      "ordinal": 155,
      "start_ms": 506470,
      "end_ms": 507190,
      "text": "这不是选择"
    },
    {
      "ordinal": 156,
      "start_ms": 507190,
      "end_ms": 508680,
      "text": "是逃避选择"
    },
    {
      "ordinal": 157,
      "start_ms": 508680,
      "end_ms": 511580,
      "text": "无纪律的那部分人并不是在选择"
    },
    {
      "ordinal": 158,
      "start_ms": 511580,
      "end_ms": 512659,
      "text": "而是在逃避"
    },
    {
      "ordinal": 159,
      "start_ms": 512659,
      "end_ms": 513880,
      "text": "并不是在站队"
    },
    {
      "ordinal": 160,
      "start_ms": 513880,
      "end_ms": 515880,
      "text": "而是在叛离"
    },
    {
      "ordinal": 161,
      "start_ms": 517200,
      "end_ms": 519520,
      "text": "所以都谈不上是战队问题"
    },
    {
      "ordinal": 162,
      "start_ms": 519520,
      "end_ms": 522120,
      "text": "而意识形态则是锋锐的"
    },
    {
      "ordinal": 163,
      "start_ms": 523520,
      "end_ms": 525630,
      "text": "是致命的"
    },
    {
      "ordinal": 164,
      "start_ms": 526290,
      "end_ms": 529790,
      "text": "是有实质的冲突性的"
    },
    {
      "ordinal": 165,
      "start_ms": 529790,
      "end_ms": 530890,
      "text": "平等的"
    },
    {
      "ordinal": 166,
      "start_ms": 530890,
      "end_ms": 533990,
      "text": "同等的纪律水准的啊"
    },
    {
      "ordinal": 167,
      "start_ms": 533990,
      "end_ms": 534950,
      "text": "互相排斥"
    },
    {
      "ordinal": 168,
      "start_ms": 534950,
      "end_ms": 538370,
      "text": "团体的竞争关系"
    },
    {
      "ordinal": 169,
      "start_ms": 541050,
      "end_ms": 542170,
      "text": "有你没我"
    },
    {
      "ordinal": 170,
      "start_ms": 542170,
      "end_ms": 544450,
      "text": "所以意识形态是非常残酷的"
    },
    {
      "ordinal": 171,
      "start_ms": 544450,
      "end_ms": 547540,
      "text": "其实我误判了"
    },
    {
      "ordinal": 172,
      "start_ms": 547540,
      "end_ms": 549480,
      "text": "我在一段时间内"
    },
    {
      "ordinal": 173,
      "start_ms": 549480,
      "end_ms": 554890,
      "text": "可能在差不多六个月左右的时间里面"
    },
    {
      "ordinal": 174,
      "start_ms": 554890,
      "end_ms": 558870,
      "text": "把这两者那个关系搞混了"
    },
    {
      "ordinal": 175,
      "start_ms": 558870,
      "end_ms": 561440,
      "text": "哪个硬哪个软没有弄特别清楚"
    },
    {
      "ordinal": 176,
      "start_ms": 561440,
      "end_ms": 564120,
      "text": "但是所以我们讲的就是说"
    },
    {
      "ordinal": 177,
      "start_ms": 564120,
      "end_ms": 567020,
      "text": "那你对于不是纪律性团体的"
    },
    {
      "ordinal": 178,
      "start_ms": 567020,
      "end_ms": 568180,
      "text": "他的意识形态问题"
    },
    {
      "ordinal": 179,
      "start_ms": 568180,
      "end_ms": 570150,
      "text": "那是那是胡闹"
    },
    {
      "ordinal": 180,
      "start_ms": 570510,
      "end_ms": 571230,
      "text": "那是胡闹"
    },
    {
      "ordinal": 181,
      "start_ms": 571230,
      "end_ms": 573270,
      "text": "所以我的基本分类他还是正确的"
    },
    {
      "ordinal": 182,
      "start_ms": 573270,
      "end_ms": 576589,
      "text": "我把团体分为意识形态团体和纪律团体"
    },
    {
      "ordinal": 183,
      "start_ms": 576589,
      "end_ms": 578009,
      "text": "软的和硬的"
    },
    {
      "ordinal": 184,
      "start_ms": 578009,
      "end_ms": 579989,
      "text": "那么这些意识形态团体"
    },
    {
      "ordinal": 185,
      "start_ms": 579989,
      "end_ms": 584650,
      "text": "他实际上不具有一个有纪律支撑的意识形态"
    },
    {
      "ordinal": 186,
      "start_ms": 584650,
      "end_ms": 586490,
      "text": "不具有实质的意识形态"
    },
    {
      "ordinal": 187,
      "start_ms": 586490,
      "end_ms": 588610,
      "text": "他的意识形态是假意识形态"
    },
    {
      "ordinal": 188,
      "start_ms": 588610,
      "end_ms": 593330,
      "text": "弱小是不成机器的意识形态啊"
    },
    {
      "ordinal": 189,
      "start_ms": 593330,
      "end_ms": 598320,
      "text": "他他其实说的就把其实是"
    },
    {
      "ordinal": 190,
      "start_ms": 599640,
      "end_ms": 600880,
      "text": "他意识代征召"
    },
    {
      "ordinal": 191,
      "start_ms": 600880,
      "end_ms": 605870,
      "text": "没有把人就是真正的就是神圣化啊"
    },
    {
      "ordinal": 192,
      "start_ms": 605870,
      "end_ms": 608240,
      "text": "他没做到这一点"
    },
    {
      "ordinal": 193,
      "start_ms": 609740,
      "end_ms": 612340,
      "text": "就是他们还是虚的"
    },
    {
      "ordinal": 194,
      "start_ms": 612340,
      "end_ms": 614540,
      "text": "还是假的玩的"
    },
    {
      "ordinal": 195,
      "start_ms": 615750,
      "end_ms": 619670,
      "text": "嗯所以就是我们会对于这些群体"
    },
    {
      "ordinal": 196,
      "start_ms": 619670,
      "end_ms": 622280,
      "text": "重新做一个分类和考量"
    },
    {
      "ordinal": 197,
      "start_ms": 622280,
      "end_ms": 626839,
      "text": "然后分类的标准大体不会有太大差别"
    },
    {
      "ordinal": 198,
      "start_ms": 626839,
      "end_ms": 631039,
      "text": "但是我要赤夺掉他们的意识形态的锋锐性"
    },
    {
      "ordinal": 199,
      "start_ms": 631039,
      "end_ms": 633130,
      "text": "他们的意识形态没有锋锐性"
    },
    {
      "ordinal": 200,
      "start_ms": 633130,
      "end_ms": 635010,
      "text": "他的意识形态是无根之木"
    },
    {
      "ordinal": 201,
      "start_ms": 635010,
      "end_ms": 635770,
      "text": "无源之水"
    },
    {
      "ordinal": 202,
      "start_ms": 635770,
      "end_ms": 637570,
      "text": "然后所以在这一上讲"
    },
    {
      "ordinal": 203,
      "start_ms": 637570,
      "end_ms": 638970,
      "text": "单游那种意识形态的话"
    },
    {
      "ordinal": 204,
      "start_ms": 638970,
      "end_ms": 641750,
      "text": "是没有办法生产出纪律来的"
    },
    {
      "ordinal": 205,
      "start_ms": 641750,
      "end_ms": 642870,
      "text": "或者反过来讲"
    },
    {
      "ordinal": 206,
      "start_ms": 642870,
      "end_ms": 646270,
      "text": "就只有纪律可以生产意识形态"
    },
    {
      "ordinal": 207,
      "start_ms": 646270,
      "end_ms": 648330,
      "text": "意识形态无法生产纪律"
    },
    {
      "ordinal": 208,
      "start_ms": 648330,
      "end_ms": 652110,
      "text": "而由纪律作为基本来生产出来的"
    },
    {
      "ordinal": 209,
      "start_ms": 652110,
      "end_ms": 655069,
      "text": "意识形态是非常坚硬的东西"
    },
    {
      "ordinal": 210,
      "start_ms": 655069,
      "end_ms": 657229,
      "text": "是非常非常坚硬的东西"
    },
    {
      "ordinal": 211,
      "start_ms": 658709,
      "end_ms": 660469,
      "text": "是你死我活的东西"
    },
    {
      "ordinal": 212,
      "start_ms": 660469,
      "end_ms": 662820,
      "text": "什么啊"
    },
    {
      "ordinal": 213,
      "start_ms": 662820,
      "end_ms": 665340,
      "text": "是生死攸关的东西"
    },
    {
      "ordinal": 214,
      "start_ms": 666360,
      "end_ms": 667900,
      "text": "好吧"
    },
    {
      "ordinal": 215,
      "start_ms": 667900,
      "end_ms": 673400,
      "text": "那这里我们这些今天的这两个视频还是主导的"
    },
    {
      "ordinal": 216,
      "start_ms": 673400,
      "end_ms": 675050,
      "text": "是讨论纪律问题"
    },
    {
      "ordinal": 217,
      "start_ms": 675050,
      "end_ms": 676490,
      "text": "讨论意识形态啊"
    },
    {
      "ordinal": 218,
      "start_ms": 676490,
      "end_ms": 677790,
      "text": "讨论意识问题"
    },
    {
      "ordinal": 219,
      "start_ms": 677790,
      "end_ms": 680720,
      "text": "没有讨论权利问题啊"
    },
    {
      "ordinal": 220,
      "start_ms": 680720,
      "end_ms": 684710,
      "text": "这这一讲讲在在这个基本的理论框架"
    },
    {
      "ordinal": 221,
      "start_ms": 684710,
      "end_ms": 686050,
      "text": "在意识形态和纪律的"
    },
    {
      "ordinal": 222,
      "start_ms": 686050,
      "end_ms": 689070,
      "text": "在生活纪律和组织纪律的这个理论框架之下呢"
    },
    {
      "ordinal": 223,
      "start_ms": 690190,
      "end_ms": 690540,
      "text": "啊"
    },
    {
      "ordinal": 224,
      "start_ms": 694000,
      "end_ms": 699860,
      "text": "权力的不对称的两侧是平等的"
    },
    {
      "ordinal": 225,
      "start_ms": 699860,
      "end_ms": 702680,
      "text": "但这个东西里面他有这个铁印的逻辑"
    },
    {
      "ordinal": 226,
      "start_ms": 702680,
      "end_ms": 705170,
      "text": "束缚着权利啊"
    },
    {
      "ordinal": 227,
      "start_ms": 705170,
      "end_ms": 708430,
      "text": "或者说权力的拥有者只是工具"
    },
    {
      "ordinal": 228,
      "start_ms": 708430,
      "end_ms": 712280,
      "text": "只是这整个运动过程的工具嗯"
    },
    {
      "ordinal": 229,
      "start_ms": 712280,
      "end_ms": 713780,
      "text": "我们要清晰地意识到这一点"
    },
    {
      "ordinal": 230,
      "start_ms": 713780,
      "end_ms": 721940,
      "text": "所以不不摆脱关于权力的迷狂和妄想"
    },
    {
      "ordinal": 231,
      "start_ms": 721940,
      "end_ms": 726040,
      "text": "是没有办法进一步进展到看到呃"
    },
    {
      "ordinal": 232,
      "start_ms": 726040,
      "end_ms": 728249,
      "text": "历史进展的团队"
    },
    {
      "ordinal": 233,
      "start_ms": 728249,
      "end_ms": 731790,
      "text": "发展中间的核心关键要素的"
    },
    {
      "ordinal": 234,
      "start_ms": 731990,
      "end_ms": 735170,
      "text": "要不停不停地克服压制"
    },
    {
      "ordinal": 235,
      "start_ms": 735170,
      "end_ms": 736470,
      "text": "消解阳气"
    },
    {
      "ordinal": 236,
      "start_ms": 736470,
      "end_ms": 738380,
      "text": "自己的权力欲"
    },
    {
      "ordinal": 237,
      "start_ms": 738380,
      "end_ms": 744540,
      "text": "以及是意识到权力本身的奴役压迫性啊"
    },
    {
      "ordinal": 238,
      "start_ms": 744540,
      "end_ms": 749180,
      "text": "拥有权力的人实际上是最大的奴隶啊"
    },
    {
      "ordinal": 239,
      "start_ms": 749180,
      "end_ms": 749900,
      "text": "我是奴隶"
    },
    {
      "ordinal": 240,
      "start_ms": 749900,
      "end_ms": 752660,
      "text": "投资不代表我是奴隶的主人"
    },
    {
      "ordinal": 241,
      "start_ms": 752660,
      "end_ms": 755500,
      "text": "但是我是最大的那个奴隶好吧"
    },
    {
      "ordinal": 242,
      "start_ms": 755500,
      "end_ms": 756580,
      "text": "那讲到这里啊"
    },
    {
      "ordinal": 243,
      "start_ms": 756580,
      "end_ms": 757660,
      "text": "讲这里"
