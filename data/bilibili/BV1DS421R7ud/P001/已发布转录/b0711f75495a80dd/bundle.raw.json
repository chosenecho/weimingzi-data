{"segments":[{"start":0.38,"end":4.04,"text":"我们有明确可靠的消息源啊"},{"start":4.04,"end":8.7,"text":"向我们透露某人的国籍啊"},{"start":8.7,"end":12.5,"text":"首先某人的护照是持有的是中国护照"},{"start":12.5,"end":15.03,"text":"其次按照国际法的规定"},{"start":15.03,"end":16.28,"text":"你必须入籍"},{"start":16.28,"end":19.56,"text":"你才能领申请领取中国护照"},{"start":19.56,"end":20.8,"text":"所以他的国籍"},{"start":20.8,"end":22.68,"text":"而且中国不承认双重国籍"},{"start":22.68,"end":25.28,"text":"所以他的国籍一定是中国国籍"},{"start":26.94,"end":30.34,"text":"第二点某人的啊"},{"start":30.34,"end":32.98,"text":"就按照我们的消息源的原话"},{"start":32.98,"end":36.18,"text":"某人可以100%确定这个某人"},{"start":36.18,"end":38.98,"text":"他是为我国政府做事情的"},{"start":38.98,"end":40.58,"text":"效忠于我国政府的"},{"start":42.98,"end":45.34,"text":"可以100%的确定"},{"start":51.12,"end":53.9,"text":"好那你要知道这个消息源啊"},{"start":53.9,"end":55.84,"text":"好你可以知道这个消息源"},{"start":55.84,"end":60.51,"text":"但是有前提一我们告诉你吧"},{"start":60.51,"end":62.61,"text":"我可可可以有限的告诉你"},{"start":62.61,"end":66.16,"text":"我们的消息源是在东南亚活动"},{"start":66.16,"end":70.78,"text":"但是它是嗯到处飞嘛"},{"start":71.51,"end":72.63,"text":"是回欧洲的"},{"start":73.75,"end":77.59,"text":"只要你是一个能够去东南亚活动"},{"start":77.59,"end":80.33,"text":"并且去欧洲的"},{"start":80.33,"end":84.63,"text":"或者说你可以去欧洲的一个活动人士"},{"start":85.31,"end":87.03,"text":"我可以把这个消息源告诉你"},{"start":88.91,"end":90.51,"text":"就是这个门槛"},{"start":92.48,"end":95.56,"text":"其他的孩子知道这个这个消息源没有任何用处"},{"start":95.56,"end":97.28,"text":"没有任何意义"},{"start":98.16,"end":99.8,"text":"我们可以确定啊"},{"start":99.8,"end":100.52,"text":"我们可以确定"},{"start":101.8,"end":104.81,"text":"所以我们就是相当于回应一下"},{"start":104.81,"end":109.51,"text":"最近对我本人的一个侮辱污蔑啊"},{"start":109.51,"end":111.81,"text":"一个造谣"},{"start":113.22,"end":117.44,"text":"当你们指控我欲做某某资产阶级集团"},{"start":117.44,"end":118.98,"text":"什么什么集团"},{"start":118.98,"end":122.55,"text":"某某在你们眼中的什么什么啊"},{"start":122.55,"end":126.61,"text":"邪恶势力在你们眼中的伐走狗的时候"},{"start":127.42,"end":130.259,"text":"你指控我是欲做法子狗而不得啊"},{"start":131.46,"end":133.14,"text":"那首先"},{"start":142.06,"end":145.709,"text":"首先去骂那些已经是乏走狗的人"},{"start":145.709,"end":148.749,"text":"我并没有说某人就一定是伐走狗啊"},{"start":148.749,"end":150.429,"text":"如果某人他效忠的团体"},{"start":150.429,"end":152.35,"text":"是具有历史的先进性的话"},{"start":152.35,"end":156.19,"text":"他不一定一定会被称之为是法斗狗"},{"start":160.42,"end":162.24,"text":"啊是不是法走狗"},{"start":162.24,"end":164.14,"text":"你们自己去鉴别啊"},{"start":164.14,"end":167.22,"text":"你们自己去这个辨别鉴定"},{"start":168.22,"end":169.44,"text":"你们自己去问"},{"start":172.52,"end":173.84,"text":"好吧"},{"start":174.88,"end":176.8,"text":"那我有的时候我就在想"},{"start":178.08,"end":179.72,"text":"这个东西到底是个什么啊"},{"start":179.72,"end":184.0,"text":"就是说欲做什么什么而不得"},{"start":184.0,"end":186.52,"text":"这个是你投射在我身上的"},{"start":186.52,"end":190.35,"text":"是你们这个团体投射在我身上的"},{"start":190.35,"end":193.89,"text":"是不是你你们已经是吃了这口饭"},{"start":193.89,"end":195.59,"text":"然后害怕我抢你们的饭"},{"start":196.99,"end":198.95,"text":"那我只能说"},{"start":199.79,"end":201.47,"text":"这叫做"},{"start":205.48,"end":206.92,"text":"不知腐鼠成滋味"},{"start":208.24,"end":209.32,"text":"我不要吃这口饭"},{"start":209.32,"end":211.8,"text":"我不要吃你们吃的这口饭"},{"start":214.32,"end":216.6,"text":"啊你们欲做什么什么而不得"},{"start":216.6,"end":218.96,"text":"这种指控往我头上甩"},{"start":218.96,"end":221.38,"text":"就是害怕我抢了你的饭呗"},{"start":221.38,"end":223.29,"text":"那你吃呗"},{"start":223.49,"end":227.81,"text":"那我两个明确的信息告诉你们了"},{"start":227.81,"end":229.73,"text":"希望你们以后所有的讨论"},{"start":229.73,"end":232.16,"text":"都以这个信息作为前提"},{"start":232.44,"end":235.24,"text":"然后希望你们有自己的能力去确认"},{"start":235.24,"end":237.09,"text":"确定这样的信息"},{"start":237.17,"end":239.29,"text":"否则我是看不起你们的"},{"start":239.29,"end":240.91,"text":"我已经明确告诉你了"},{"start":240.91,"end":242.21,"text":"信息源是来自于"},{"start":242.21,"end":245.45,"text":"在东南亚活动的某位欧洲活动家"},{"start":250.28,"end":252.26,"text":"你们只要在东南亚去问一问"},{"start":252.26,"end":253.9,"text":"或者去欧洲问一问"},{"start":253.9,"end":255.92,"text":"你们就能得到答案"},{"start":261.399,"end":264.019,"text":"啊好吧"},{"start":264.019,"end":265.68,"text":"就讲到这里啊"}],"source":"subtitle"}
