{"segments":[{"start":0.14,"end":4.14,"text":"好我们准备在省内开第二家俱乐部"},{"start":7.26,"end":9.14,"text":"准备开在徐州"},{"start":11.18,"end":14.86,"text":"他是五省通衢"},{"start":16.04,"end":18.74,"text":"江苏安徽"},{"start":18.74,"end":21.74,"text":"河南河北山东"},{"start":22.22,"end":24.74,"text":"而且从这里出发"},{"start":24.74,"end":29.11,"text":"主要的北方省份"},{"start":29.11,"end":33.76,"text":"甚至说是湖北武汉嗯"},{"start":33.76,"end":35.26,"text":"开车的话五六个小时"},{"start":35.26,"end":36.64,"text":"六七个小时就能到"},{"start":36.64,"end":39.4,"text":"当天可来回"},{"start":40.86,"end":45.35,"text":"呃然后呢是这个地方嗯"},{"start":46.19,"end":50.59,"text":"工资比环太湖啊"},{"start":50.59,"end":52.93,"text":"反正比这个一二线"},{"start":53.21,"end":56.09,"text":"平均要低个40%到60"},{"start":56.09,"end":58.77,"text":"但是呢他吃东西农产品便宜"},{"start":58.77,"end":62.01,"text":"周围全是大平原"},{"start":63.35,"end":65.98,"text":"我们准备把一些"},{"start":67.24,"end":69.24,"text":"我们的产业移到那边去啊"},{"start":69.24,"end":72.78,"text":"当然这个东西是待发展的产业"},{"start":72.78,"end":75.2,"text":"由于它是"},{"start":76.5,"end":82.99,"text":"中原大平原周围很多农业省啊"},{"start":82.99,"end":87.71,"text":"我们准备把郑和的农产品的采购和销售基地"},{"start":87.71,"end":89.35,"text":"放到那边去"},{"start":90.5,"end":96.1,"text":"更为有效地直接地去带动中原农业的发展"},{"start":97.2,"end":98.88,"text":"用我们的电击的力量"},{"start":100.0,"end":103.91,"text":"另外一方面我们可能会额重点什么"},{"start":103.91,"end":108.49,"text":"然后再重点一些特色农产品吧"},{"start":108.49,"end":112.03,"text":"啊就是往农业方向去发展一下"},{"start":112.26,"end":117.64,"text":"还有一点这个是北边很多俱乐部他没办下来"},{"start":117.64,"end":122.76,"text":"很多这个治世能人啊"},{"start":123.609,"end":129.449,"text":"啊他们纷纷去了一些嗯"},{"start":129.449,"end":133.79,"text":"没有能够让他们发挥到自己的光和热的地方"},{"start":133.79,"end":136.85,"text":"有的地方甚至还发生了一些狗血剧啊"},{"start":136.85,"end":138.515,"text":"狗血剧"},{"start":139.9,"end":145.7,"text":"我们对于近来发生的一些事情看在眼里"},{"start":146.989,"end":150.4,"text":"那么徐州这个俱乐部啊"},{"start":150.4,"end":155.82,"text":"啊我准备是至少在年内把他筹办起来"},{"start":156.18,"end":160.68,"text":"额会和苏州这边采用相同的收费模式"},{"start":160.68,"end":165.67,"text":"然后相同的餐饮标准不是金额上的"},{"start":165.67,"end":167.37,"text":"是那个营养水平上的"},{"start":167.37,"end":171.28,"text":"然后也是提供相应的啊"},{"start":171.28,"end":181.14,"text":"对于年轻人回归主流正常生活的一个帮扶啊"},{"start":182.8,"end":184.36,"text":"他的地租相对会便宜一些"},{"start":185.48,"end":190.73,"text":"那么我们这次支教的点有啊"},{"start":190.73,"end":195.2,"text":"有学校就在徐州这个呃"},{"start":195.2,"end":198.83,"text":"派人把支教志愿者送过去的过程"},{"start":198.83,"end":200.63,"text":"还有支教志愿者在地的时候"},{"start":200.63,"end":202.67,"text":"他们其实可以帮我们考察考察"},{"start":202.67,"end":204.85,"text":"哪里有合适的地方"},{"start":206.76,"end":216.26,"text":"啊那么还有一个更大的一个原因是直亲的理念"},{"start":216.74,"end":221.27,"text":"你在这个温室当中已经培植的差不多了啊"},{"start":221.27,"end":225.07,"text":"您那要去有能力去接受挑战了"},{"start":225.07,"end":231.989,"text":"在一些呃呃水土不那么舒服的地方"},{"start":231.989,"end":234.509,"text":"你也能够茁壮生长"},{"start":237.48,"end":240.29,"text":"嗯嗯孔雀东南飞"},{"start":240.65,"end":243.05,"text":"有很多年轻人会往越往南越往南"},{"start":243.05,"end":246.73,"text":"或者去那些强的一线二线城市"},{"start":247.23,"end":249.77,"text":"那我们有点反其道而行之"},{"start":249.77,"end":253.55,"text":"但是呢没有出神"},{"start":255.94,"end":257.22,"text":"你也知道为什么呢"},{"start":257.22,"end":260.709,"text":"啊这已经是最北边了"},{"start":260.709,"end":267.34,"text":"我也是最能够让周围的这个朋友们啊"},{"start":268.98,"end":271.18,"text":"得到帮助的一个点了"},{"start":274.41,"end":275.25,"text":"某种意义上讲"},{"start":275.25,"end":279.92,"text":"是我本人的所争取的能力的一个极限了"},{"start":281.48,"end":288.46,"text":"嘶来的话也是要好好的去激进化学习技能啊"},{"start":288.46,"end":291.2,"text":"然后这个培养真正的这个"},{"start":292.62,"end":295.26,"text":"性情和气概"},{"start":296.58,"end":299.38,"text":"还有硬骨头啊"},{"start":299.38,"end":303.19,"text":"我们不欢迎这个呃软骨头"},{"start":303.19,"end":305.65,"text":"不欢迎心术不正的"},{"start":305.65,"end":312.06,"text":"不欢迎这个膝盖很容易弯曲的人啊"},{"start":312.06,"end":317.85,"text":"这个这个这个这就是腿腿脚受伤不便的除外啊"},{"start":318.05,"end":320.21,"text":"啊这个越腿脚受伤不变的"},{"start":320.21,"end":322.29,"text":"应该是越越早能弯曲越好啊"},{"start":322.29,"end":325.1,"text":"嗯嗯方便坐卧啊"},{"start":325.1,"end":328.16,"text":"我说就说我们不欢迎下跪的人"},{"start":328.93,"end":331.12,"text":"我们怀疑宁死不屈的人"},{"start":331.4,"end":334.62,"text":"我们欢迎硬硬骨头啊"},{"start":334.62,"end":340.31,"text":"我们欢迎这个在生活的挫折困顿当中跌倒"},{"start":340.31,"end":341.89,"text":"爬起来反复跌倒"},{"start":341.89,"end":343.03,"text":"反复爬起来"},{"start":343.03,"end":344.71,"text":"始终追求希望"},{"start":344.71,"end":347.93,"text":"始终坚守理想"},{"start":350.25,"end":353.91,"text":"绝不认掉队的人好了"},{"start":353.91,"end":356.87,"text":"我们是尽我们的能力"},{"start":357.48,"end":362.92,"text":"可能这个这个倡议要再提前20天"},{"start":362.92,"end":364.9,"text":"8月初的时候就提出来"},{"start":364.9,"end":370.17,"text":"甚至能够挽救很多人的这个啊心理健康"},{"start":371.33,"end":373.61,"text":"但这算什么啊"},{"start":373.61,"end":376.539,"text":"这是我在这个想法"},{"start":376.539,"end":378.139,"text":"是我在几月几号提出来的"},{"start":378.139,"end":379.699,"text":"我看一下"},{"start":385.12,"end":394.84,"text":"周三是这个8月2号提出来的哈"},{"start":403.0,"end":404.84,"text":"当天有一对小情侣过生日"},{"start":404.84,"end":409.28,"text":"我还说要给他们送这个生日礼物啊"},{"start":411.0,"end":413.4,"text":"今天这两人还某种样"},{"start":413.4,"end":415.64,"text":"还被我批评了一大通"},{"start":420.04,"end":424.0,"text":"这个倡议就当时的礼物送给他们"},{"start":424.6,"end":429.44,"text":"这个计划呢是我们要去落实的啊"},{"start":429.44,"end":431.02,"text":"要去想想办法"},{"start":431.02,"end":434.44,"text":"这个选择这个地方啊"},{"start":434.44,"end":436.18,"text":"除了刚刚说交通的原因"},{"start":436.18,"end":440.88,"text":"除了刚刚说的能够就是说让更多的周围的啊"},{"start":440.88,"end":444.53,"text":"我们的支持者得到帮助啊"},{"start":444.53,"end":448.63,"text":"他除了他他那个他的本地的这个形态啊"},{"start":448.63,"end":451.99,"text":"稍微就更贴合普遍状况"},{"start":451.99,"end":454.95,"text":"更贴合这个国家的普遍状态状况"},{"start":458.159,"end":462.76,"text":"那这个苏州像个所谓的天堂一样的啊"},{"start":462.76,"end":465.02,"text":"日子太好过了啊"},{"start":465.14,"end":467.74,"text":"都被消磨掉了"},{"start":467.74,"end":469.62,"text":"他的锐气了"},{"start":470.23,"end":471.91,"text":"而且一直待在这里"},{"start":473.51,"end":476.45,"text":"被天下人耻笑啊"},{"start":476.45,"end":483.37,"text":"没有这个大丈夫进取慷慨的气概"},{"start":483.93,"end":486.17,"text":"不应当如此"},{"start":488.34,"end":490.02,"text":"怎么能未老先衰呢"},{"start":491.3,"end":493.3,"text":"首先要成熟起来"},{"start":493.819,"end":495.159,"text":"所以我们不能被"},{"start":495.159,"end":497.669,"text":"而且我最近搞的这些什么啊"},{"start":497.909,"end":499.749,"text":"带动女性就业的啊"},{"start":499.749,"end":501.109,"text":"这个什么直播间呀"},{"start":501.109,"end":504.349,"text":"咨询室很多人会笑话我"},{"start":504.349,"end":506.78,"text":"那是那你"},{"start":508.52,"end":510.44,"text":"对对于我们了解的太少了"},{"start":511.52,"end":515.659,"text":"我最近还被人臭骂的狗血淋头呢"},{"start":515.659,"end":516.52,"text":"未明子"},{"start":516.52,"end":517.818,"text":"你怎么回事"},{"start":519.23,"end":520.75,"text":"想不想好好活着了"},{"start":522.19,"end":523.47,"text":"唉我想好好活着"},{"start":523.47,"end":524.83,"text":"我会好好活着"},{"start":524.83,"end":528.23,"text":"我会活得尽可能的好了"},{"start":529.16,"end":530.88,"text":"不该做的事情我不会做的"},{"start":533.24,"end":534.89,"text":"向南啊"},{"start":534.89,"end":536.43,"text":"不敢越雷池一步"},{"start":536.43,"end":538.97,"text":"那么实事求是讲"},{"start":538.97,"end":545.17,"text":"我们去投身这个相对这个苏南环太湖地区"},{"start":545.17,"end":547.909,"text":"有点啊"},{"start":547.909,"end":553.969,"text":"经济尚待进一步更发达的这个中原地带"},{"start":553.969,"end":556.605,"text":"反而是鹏程万里"},{"start":558.0,"end":559.7,"text":"我不怕受挑战"},{"start":559.7,"end":562.38,"text":"我不怕这个啊"},{"start":562.38,"end":563.64,"text":"遇到挫折和磨难"},{"start":563.64,"end":570.66,"text":"我就怕啊陷于这个温存和"},{"start":572.1,"end":573.86,"text":"懈怠之中"},{"start":575.18,"end":576.18,"text":"不思进取"},{"start":577.26,"end":581.12,"text":"那就会被真的被天下人耻笑啊"},{"start":581.12,"end":588.32,"text":"被这个下位者图谋这个那些下那些家伙玩"},{"start":588.32,"end":589.9,"text":"尼玛的"},{"start":589.9,"end":592.86,"text":"真的觉得我昏愧可期吗"},{"start":592.86,"end":597.32,"text":"怎么可能老夫正当壮年啊"},{"start":597.32,"end":601.27,"text":"就小荷才露尖尖角"},{"start":602.22,"end":606.86,"text":"哎呀这个我尼玛才33岁"},{"start":606.86,"end":609.65,"text":"好吧嗯"},{"start":610.09,"end":614.29,"text":"哦韩信被捕的时候也才30岁"},{"start":614.999,"end":618.879,"text":"唉不回过头来讲"},{"start":618.879,"end":620.639,"text":"我说的就是"},{"start":622.76,"end":624.2,"text":"那个地儿啊是什么"},{"start":624.2,"end":628.13,"text":"刘邦项羽韩信反正都打过交道的地儿啊"},{"start":628.13,"end":629.65,"text":"古来就是英雄地"},{"start":629.65,"end":632.309,"text":"有英雄气啊"},{"start":632.309,"end":635.809,"text":"也是当然我也是所谓盐碱地里面出来的人"},{"start":635.809,"end":638.829,"text":"但是我老家在那个时代还没有呢"},{"start":638.829,"end":639.629,"text":"还是大海呢"},{"start":639.629,"end":642.069,"text":"海里面出来的人啊"},{"start":642.069,"end":644.569,"text":"哈不是没有双关的意味在里面啊"},{"start":644.569,"end":647.049,"text":"就真的这个字面意义上的海里面出来的"},{"start":647.049,"end":651.67,"text":"就是不就是贪图冲出来的地里面出来的人"},{"start":652.19,"end":655.01,"text":"所以我就更有一种大海的气概"},{"start":655.01,"end":658.24,"text":"气魄汪洋自肆"},{"start":658.24,"end":659.4,"text":"那在古代的时候"},{"start":659.4,"end":662.86,"text":"那彭城他也是靠海的嘛啊"},{"start":665.1,"end":666.8,"text":"所以我不跟你们扯这么多了"},{"start":666.8,"end":668.98,"text":"这个事情呢"},{"start":668.98,"end":674.62,"text":"这个计划呢我已经很正式的向我的同事朋友啊"},{"start":674.62,"end":676.56,"text":"支持者都传达了啊"},{"start":676.56,"end":678.6,"text":"核心的支持者都传达了这个计划"},{"start":679.76,"end":682.78,"text":"这是恰当的合理的"},{"start":682.78,"end":687.74,"text":"这是饱含着希望和热忱的一个计划"},{"start":687.74,"end":690.96,"text":"就是让我们的试验田"},{"start":690.96,"end":695.12,"text":"让我们直亲的理念在相对值相对"},{"start":695.12,"end":696.12,"text":"而能相比全国"},{"start":696.12,"end":697.5,"text":"他条件也是很好的"},{"start":697.5,"end":700.05,"text":"相对稍稍啊"},{"start":700.05,"end":705.51,"text":"这个条件不那么那么那么完美的地方"},{"start":705.51,"end":707.63,"text":"得到一些试炼"},{"start":708.92,"end":712.46,"text":"嗯除了这个镇和这个农业"},{"start":712.46,"end":715.64,"text":"还有什么下乡的这些东西"},{"start":715.64,"end":719.72,"text":"我们可能还会把一些其他的一些产业行业"},{"start":719.72,"end":722.219,"text":"放到那边去啊"},{"start":722.219,"end":726.519,"text":"比如说他是那个五省通通渠嘛"},{"start":726.519,"end":731.07,"text":"所以说交通业公路运输业很发达"},{"start":731.07,"end":731.83,"text":"对不对"},{"start":731.83,"end":734.37,"text":"我们会会把一些比如说车队啊"},{"start":734.37,"end":736.71,"text":"或者说什么汽修啊"},{"start":736.71,"end":738.71,"text":"将来有可能放那边去啊"},{"start":738.71,"end":742.969,"text":"然后呢他是周围他是教培"},{"start":742.969,"end":744.369,"text":"好像也也有点总归"},{"start":744.369,"end":746.729,"text":"我们会因地制宜的啊"},{"start":746.729,"end":750.25,"text":"我们已经我个人已经就花了几个晚上啊"},{"start":750.25,"end":754.2,"text":"对他进行一个嘶细致的梳理和了解"},{"start":754.2,"end":756.88,"text":"那么很多还要靠口耳相传"},{"start":756.88,"end":759.35,"text":"还要靠本地人的帮助啊"},{"start":759.35,"end":762.36,"text":"这个东西是我们的"},{"start":764.52,"end":766.72,"text":"南赢北赢啊"},{"start":766.72,"end":768.2,"text":"是我们这个最北端啊"},{"start":768.2,"end":769.72,"text":"我靠嗯"},{"start":769.72,"end":774.15,"text":"我很知道我的这个界限的好吧"},{"start":774.15,"end":777.13,"text":"那就是这样一个计划"},{"start":781.24,"end":783.43,"text":"努力做到这一点啊"},{"start":783.43,"end":784.53,"text":"那我个人的话"},{"start":784.53,"end":787.55,"text":"以后很有可能就是说不停的会奔波啊"},{"start":787.55,"end":789.69,"text":"坐车五个半小时"},{"start":789.69,"end":796.31,"text":"或者说是哦坐高铁两个多小时嗯"},{"start":796.31,"end":797.71,"text":"这个高铁贵啊"},{"start":797.71,"end":801.93,"text":"车的话还就是you know哇"},{"start":801.93,"end":806.31,"text":"可以顺便多回我苏北老家去看一看呵"},{"start":806.91,"end":809.59,"text":"这个男儿得志不归乡啊"},{"start":809.59,"end":810.83,"text":"如同锦衣夜行啊"},{"start":810.83,"end":812.39,"text":"啊不能学项羽"},{"start":812.39,"end":813.51,"text":"不可沽名"},{"start":813.51,"end":815.64,"text":"学霸王啊"},{"start":815.64,"end":816.82,"text":"是忍住啊"},{"start":816.82,"end":818.6,"text":"我觉得这种错误年轻时候犯一犯"},{"start":818.6,"end":819.92,"text":"年纪大了就不用犯了"},{"start":819.92,"end":822.32,"text":"忍住嗯"},{"start":822.32,"end":825.66,"text":"我更多的是在有一些北方的朋友身上啊"},{"start":825.66,"end":827.34,"text":"特别来自徐州的朋友身上"},{"start":827.34,"end":832.39,"text":"看到了一些值得我学习思考借鉴的一些优点"},{"start":832.39,"end":834.3,"text":"或者说其实我本来就有"},{"start":834.3,"end":835.9,"text":"我们在南方待的时间久了"},{"start":835.9,"end":837.14,"text":"我本来是冈波宁啊"},{"start":837.14,"end":838.319,"text":"本来是苏北人"},{"start":838.319,"end":839.919,"text":"我在南方待久了之后"},{"start":839.919,"end":843.259,"text":"身上的这种气概我就被消折了"},{"start":843.259,"end":846.34,"text":"哼我现在慢慢慢回来了啊"},{"start":846.34,"end":847.22,"text":"越来越狂野了"},{"start":847.22,"end":848.06,"text":"我靠啊"},{"start":848.06,"end":851.26,"text":"不越来越有尺度分寸啊"},{"start":851.66,"end":853.3,"text":"那反正这话就说到这里"},{"start":853.3,"end":855.62,"text":"讲到这边好吧"}],"source":"subtitle"}
