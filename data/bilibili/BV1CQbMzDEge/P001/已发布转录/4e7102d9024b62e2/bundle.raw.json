{"segments":[{"start":0.0,"end":1.83,"text":"放了过去"},{"start":2.55,"end":6.47,"text":"我们上讲以一个最尖锐的最快速的方式"},{"start":6.47,"end":13.35,"text":"经过了这个所谓的呃一个迂回"},{"start":13.35,"end":15.05,"text":"凯格尔的迂回"},{"start":15.05,"end":18.619,"text":"他是被看成是20世纪最伟大的哲学家"},{"start":18.619,"end":20.779,"text":"那他提出了一个哲学范式"},{"start":20.779,"end":21.739,"text":"在那个当中"},{"start":21.739,"end":24.39,"text":"在至少在早期的排队的人当中"},{"start":24.83,"end":27.35,"text":"哲学是一个什么样的过程"},{"start":28.1,"end":30.18,"text":"嗯是一个先遗忘"},{"start":30.18,"end":30.9,"text":"对不对"},{"start":30.9,"end":33.789,"text":"然后再回忆起来"},{"start":33.789,"end":34.469,"text":"实际上"},{"start":34.469,"end":35.749,"text":"海德格尔那里"},{"start":35.749,"end":38.509,"text":"重复的是一种柏拉图主义的老调啊"},{"start":38.509,"end":39.349,"text":"早期海那个"},{"start":39.349,"end":45.879,"text":"那但是到了晚期还这就不是这么个叙事了"},{"start":45.879,"end":49.739,"text":"就他甚至就是反不叫反哲学"},{"start":49.739,"end":54.5,"text":"后哲学某种超越先生上学的意思"},{"start":54.539,"end":56.34,"text":"但是那个岔路啊"},{"start":56.34,"end":57.48,"text":"我们不走深了啊"},{"start":57.48,"end":59.62,"text":"我们直接是从"},{"start":60.59,"end":62.51,"text":"我们上次说的那个契机"},{"start":62.51,"end":63.87,"text":"历史当中"},{"start":64.95,"end":69.645,"text":"那我们从海瑞尔那里得知历史有几个样派对"},{"start":76.42,"end":79.5,"text":"哪几个状态你们还记得吗"},{"start":81.16,"end":82.58,"text":"绝对者堕落实"},{"start":82.58,"end":84.88,"text":"绝对者的堕落实对不对"},{"start":90.38,"end":92.78,"text":"我是神的堕落史绝对者"},{"start":92.78,"end":94.06,"text":"堕落使"},{"start":97.84,"end":100.78,"text":"还有一个是什么回忆史"},{"start":100.78,"end":101.96,"text":"还有一个是回忆史"},{"start":101.96,"end":103.92,"text":"是不是哲学家的回忆史"},{"start":105.4,"end":107.84,"text":"哲人的哲学家的回忆史"},{"start":112.52,"end":115.92,"text":"那么第三个是人类的遗忘史"},{"start":124.3,"end":126.22,"text":"你最近俱乐部里面是什么"},{"start":127.54,"end":129.83,"text":"有一个会员救了个人"},{"start":129.99,"end":130.75,"text":"他说什么"},{"start":130.75,"end":133.87,"text":"过马路的时候没看到车的车把他撞飞了"},{"start":133.87,"end":135.35,"text":"然后落掉下来"},{"start":135.35,"end":138.37,"text":"掉下来之后不停的问我是谁"},{"start":138.37,"end":139.07,"text":"我在哪"},{"start":139.07,"end":140.53,"text":"我为什么在这啊"},{"start":140.53,"end":143.03,"text":"我为什么在这瞬间变成追加了"},{"start":143.03,"end":150.01,"text":"那么还是他的起手式就是人类的遗忘时啊"},{"start":150.01,"end":153.95,"text":"人类遗忘是人类遗忘了存在的使命"},{"start":153.95,"end":156.29,"text":"死在的某种天命啊"},{"start":156.29,"end":163.37,"text":"不要让生命真正意义上的本尊的生存方式"},{"start":163.37,"end":165.61,"text":"他后来详细说道"},{"start":165.61,"end":167.01,"text":"说的是四四字方式"},{"start":167.01,"end":168.05,"text":"叫什么灵说啊"},{"start":168.05,"end":169.17,"text":"接受赠礼啊"},{"start":169.17,"end":170.13,"text":"什么七八糟的"},{"start":170.13,"end":174.57,"text":"其实呢导向的是一个原教主义主义的基督教师"},{"start":176.74,"end":180.92,"text":"那么无论是哪一种这种历史"},{"start":180.92,"end":185.56,"text":"他都只是有的观念中的历史"},{"start":186.68,"end":187.96,"text":"都只是一种观念史"},{"start":189.52,"end":194.86,"text":"或者说它都是观念作为历史的运动"},{"start":194.86,"end":196.74,"text":"或者我们再精确一点"},{"start":196.74,"end":201.18,"text":"它都是一种什么神精神实"},{"start":207.64,"end":209.82,"text":"这是一种精神使"},{"start":209.82,"end":211.08,"text":"或者说精神"},{"start":211.08,"end":211.88,"text":"什么是精神"},{"start":211.88,"end":214.04,"text":"精神就是观念的历史"},{"start":214.76,"end":218.44,"text":"作为历史的观念在历史当中变化"},{"start":219.84,"end":220.84,"text":"在历史当中实现"},{"start":220.84,"end":223.66,"text":"他自身的观念叫做精神"},{"start":225.3,"end":230.7,"text":"所以我们哪怕我们官方去这个推崇英雄的时候"},{"start":230.7,"end":232.36,"text":"都说这英雄死了怎么样"},{"start":232.36,"end":233.74,"text":"精神永垂不朽"},{"start":233.74,"end":234.73,"text":"对不对"},{"start":234.73,"end":236.99,"text":"据说我们是无神论者"},{"start":236.99,"end":241.27,"text":"无神论者应该是说不不承认这种什么灵魂啊"},{"start":241.27,"end":243.129,"text":"什么精灵啊"},{"start":243.129,"end":245.429,"text":"这种东西死了之后还能长存的"},{"start":245.429,"end":250.369,"text":"但是为什么非非说精神永生就是合法的"},{"start":251.3,"end":253.1,"text":"啊这就是整个马克思主义的"},{"start":253.1,"end":255.9,"text":"他的哲学道统的来源"},{"start":255.9,"end":257.7,"text":"还是黑格尔主义了"},{"start":258.29,"end":262.089,"text":"他们会假设有一种宇宙精神"},{"start":263.46,"end":265.74,"text":"或者说作为历史的精神"},{"start":266.32,"end":268.24,"text":"在这种作为历史的精神当中"},{"start":269.56,"end":273.62,"text":"所有的牺牲挫败悲剧死亡"},{"start":273.62,"end":275.95,"text":"这有它特定的意义"},{"start":276.39,"end":277.83,"text":"这样一种精神史呢"},{"start":279.23,"end":282.44,"text":"它是借由哲学生成出来的"},{"start":282.8,"end":286.12,"text":"哲学孕育了精神时代"},{"start":294.34,"end":299.09,"text":"所以我们这个时候我们把哲学看成是一个好"},{"start":299.09,"end":301.72,"text":"真正意向的是一个"},{"start":303.16,"end":304.06,"text":"爱智慧"},{"start":304.06,"end":306.26,"text":"那么结合这几个"},{"start":306.26,"end":308.12,"text":"我们对于历史的把握"},{"start":308.12,"end":310.32,"text":"现在又有第四重把握了"},{"start":310.32,"end":313.76,"text":"我是说对于这三重把握一个总结"},{"start":314.73,"end":318.93,"text":"要做什么精神使"},{"start":320.33,"end":322.01,"text":"精神的孕育"},{"start":322.01,"end":325.51,"text":"精神作为历史被孕育出来了"},{"start":325.51,"end":328.57,"text":"我们可以在这个时候把哲学的爱"},{"start":328.57,"end":330.27,"text":"说成是一种什么爱"},{"start":331.22,"end":334.6,"text":"你们在场的只有男人和年轻的女性"},{"start":334.6,"end":336.3,"text":"未婚女性"},{"start":336.75,"end":339.83,"text":"你知道这是一种爱吧"},{"start":340.76,"end":344.84,"text":"这是一种孕妇对于胎儿的爱"},{"start":345.86,"end":347.12,"text":"把它记住啊"},{"start":347.12,"end":349.44,"text":"这种孕妇对于胎儿的爱"},{"start":349.44,"end":351.36,"text":"所以现在孕育一种精神"},{"start":351.36,"end":354.59,"text":"如同一个孕妇在爱她的胎儿"},{"start":356.22,"end":361.29,"text":"所以这个胎儿降生了之后才会有所谓的堕落"},{"start":361.65,"end":364.93,"text":"然后才会有一开始是处在遗忘"},{"start":364.93,"end":369.05,"text":"然后开始回忆这些阶段"},{"start":370.16,"end":373.18,"text":"那么我们说的再明确一点"},{"start":373.18,"end":377.84,"text":"这个被孕育出来的精神堕落下来"},{"start":377.84,"end":380.54,"text":"在哲学家的观念史当中"},{"start":380.54,"end":382.31,"text":"在哲学家"},{"start":382.31,"end":388.07,"text":"所以观念化的视角去看待这个世界的过程当中"},{"start":388.07,"end":389.31,"text":"他看到的是什么"},{"start":389.31,"end":390.95,"text":"到底是哪个婴儿"},{"start":390.95,"end":394.31,"text":"哪个胎儿作为绝对精神"},{"start":394.31,"end":395.83,"text":"他堕落的"},{"start":397.9,"end":400.5,"text":"有人可以给我答案吗"},{"start":401.86,"end":402.92,"text":"报一个名字出来"},{"start":402.92,"end":404.84,"text":"Number one"},{"start":406.58,"end":410.2,"text":"金州人总结tire啊"},{"start":410.2,"end":412.98,"text":"金州人是贯穿始终的"},{"start":413.28,"end":416.76,"text":"这些斗争可以看成是他的大鱼吗"},{"start":417.83,"end":419.31,"text":"周期性的大意吗"},{"start":419.31,"end":425.02,"text":"作为胎儿在近现代诞生出来的这个胎儿是什么"},{"start":425.02,"end":431.22,"text":"嗯啊五彩联对哲学孕育了五彩联"},{"start":433.6,"end":435.95,"text":"但是是作为什么"},{"start":436.55,"end":441.39,"text":"作为一个观念的无产阶级被孕育出来了"},{"start":443.52,"end":447.36,"text":"无产阶级一开始是作为观念被孕育出来的"},{"start":447.36,"end":451.76,"text":"是从哲学当中孕育了其作为观念的阶级性"},{"start":452.08,"end":454.44,"text":"我不是说他实体明白吗"},{"start":454.44,"end":456.51,"text":"我没有说他是实体"},{"start":456.51,"end":461.99,"text":"我没有说他的这个现实的具体测这种孕育过程"},{"start":462.7,"end":465.1,"text":"谁把孕育出来"},{"start":469.72,"end":470.52,"text":"是哲学"},{"start":470.52,"end":470.84,"text":"对不对"},{"start":472.0,"end":474.64,"text":"而且很明确的是什么样的哲学"},{"start":475.229,"end":477.189,"text":"资产阶级哲学"},{"start":477.73,"end":479.35,"text":"资本主义哲学"},{"start":479.35,"end":480.77,"text":"资本主义哲学"},{"start":481.89,"end":483.28,"text":"他"},{"start":484.76,"end":486.16,"text":"把绝对者"},{"start":488.16,"end":490.35,"text":"生养出来"},{"start":491.19,"end":493.75,"text":"以此实现了一个什么目的"},{"start":495.01,"end":498.61,"text":"实现了资本主义的革命胜利的目"},{"start":499.42,"end":502.06,"text":"资本主义革命的胜利是靠什么"},{"start":502.06,"end":504.1,"text":"是典型的靠法国大革命"},{"start":504.1,"end":504.92,"text":"对不对"},{"start":504.92,"end":507.38,"text":"是靠混乱的"},{"start":507.62,"end":512.36,"text":"就有了统治秩序无法囊括的暴烈的阶级革命"},{"start":512.679,"end":517.98,"text":"那么这些暴烈的暴力是由谁输出呢"},{"start":518.539,"end":521.26,"text":"法国巴黎的底层的贫苦市民"},{"start":522.74,"end":524.66,"text":"或者说是他的无产阶级"},{"start":529.96,"end":533.58,"text":"所以我们今天要讲的就是"},{"start":534.54,"end":536.7,"text":"作为革命的哲学"},{"start":550.34,"end":552.38,"text":"播格骗者权"},{"start":553.82,"end":557.22,"text":"哲学在这个时候被看成是这样一个过渡"},{"start":559.74,"end":561.62,"text":"爱智慧"},{"start":564.2,"end":566.34,"text":"通过爱来抵达智慧"},{"start":566.34,"end":570.12,"text":"或者说我们说的更确切一点的"},{"start":570.98,"end":572.2,"text":"既然它是一个过渡"},{"start":572.2,"end":573.94,"text":"那意味着什么"},{"start":575.22,"end":576.82,"text":"意味着抛弃前者"},{"start":576.82,"end":578.38,"text":"拥抱后者"},{"start":581.82,"end":583.54,"text":"所以作为革命的哲学"},{"start":583.54,"end":584.42,"text":"它的特点是"},{"start":586.58,"end":590.73,"text":"I然后经由对于爱的取消"},{"start":592.85,"end":595.21,"text":"然后获得智慧"},{"start":599.98,"end":603.96,"text":"那么对于爱的取消它是怎样发生的"},{"start":603.96,"end":605.96,"text":"如何取消爱"},{"start":605.96,"end":608.34,"text":"爱是种什么东西啊"},{"start":609.41,"end":612.29,"text":"爱在基督教时代不在中世纪"},{"start":612.29,"end":613.81,"text":"什么是爱"},{"start":614.46,"end":619.74,"text":"你说我们有没有看过那个什么福克"},{"start":619.74,"end":623.69,"text":"好像写过那个中世纪酷刑酷刑史啊"},{"start":623.69,"end":628.15,"text":"而且写过这个里面有那种是犯了极大罪恶的人"},{"start":628.15,"end":632.09,"text":"被非常残忍的酷刑折磨"},{"start":633.66,"end":636.86,"text":"我记得是什么穿过他的眼睛啊"},{"start":636.86,"end":639.06,"text":"还是说是把他的长度挖出来"},{"start":639.06,"end":640.18,"text":"但是这个过程中"},{"start":640.18,"end":642.9,"text":"既然他在临终的时候"},{"start":643.629,"end":647.429,"text":"他祈求有神父过来把十字架给他亲吻"},{"start":647.429,"end":648.889,"text":"然后父亲跟他说"},{"start":648.889,"end":650.53,"text":"上帝爱你"},{"start":650.89,"end":651.73,"text":"主爱你"},{"start":652.77,"end":653.67,"text":"他也会回应"},{"start":653.67,"end":654.95,"text":"不会爱你"},{"start":654.95,"end":656.29,"text":"等他死掉"},{"start":656.29,"end":658.41,"text":"所以这个爱呢"},{"start":658.65,"end":662.49,"text":"这分其实这个这种爱其实也分两重啊"},{"start":662.49,"end":666.19,"text":"如果说是单纯的肉体性的"},{"start":666.19,"end":671.95,"text":"也就是说人类所依然处于那种自然性啊"},{"start":671.95,"end":674.15,"text":"自然的爱与关联"},{"start":674.15,"end":676.54,"text":"黏腻的这个血缘关联"},{"start":676.54,"end":679.42,"text":"如果说讲究比较"},{"start":682.68,"end":683.88,"text":"如果说我们讲的比较"},{"start":683.88,"end":686.84,"text":"就是说高效的关键性的收缩起来的"},{"start":686.84,"end":688.44,"text":"那就是宗教"},{"start":696.12,"end":699.58,"text":"那么通过对于这种爱的取消"},{"start":699.58,"end":702.36,"text":"或者说作为这种对爱的取消的这个历史运动"},{"start":702.36,"end":703.59,"text":"叫做什么"},{"start":703.59,"end":705.91,"text":"叫做启蒙运动"},{"start":711.94,"end":719.42,"text":"资产阶级在动员他自身和他的无产这一测啊"},{"start":719.42,"end":721.14,"text":"和他的这个克里测的过程"},{"start":721.14,"end":726.26,"text":"就是通过几部运动要取消掉一种黏腻的"},{"start":727.09,"end":731.05,"text":"然后对于罪恶有无限兜底能力的爱"},{"start":731.38,"end":736.569,"text":"不是说刚刚说对于那个罪犯进行酷刑"},{"start":736.569,"end":738.889,"text":"然后这个罪犯是罪恶的"},{"start":738.889,"end":740.61,"text":"是这个酷刑是罪恶的"},{"start":740.61,"end":743.83,"text":"他们竟然在对一个人施加如此丑陋"},{"start":743.83,"end":745.37,"text":"肮脏痛苦的酷刑之后"},{"start":745.37,"end":749.16,"text":"还能刻意去表演一种温情"},{"start":749.16,"end":750.04,"text":"表演一种爱"},{"start":752.12,"end":753.62,"text":"所以基督教"},{"start":753.62,"end":756.88,"text":"宗教在那个时代所生产出来的这种爱呀"},{"start":756.88,"end":759.0,"text":"爱欲的激发"},{"start":759.0,"end":764.21,"text":"他是能够对于无限的痛苦加以镇定的"},{"start":764.21,"end":768.31,"text":"马克思在黑格尔法律学批判导言里面直接说了"},{"start":768.31,"end":771.27,"text":"宗教是两片"},{"start":771.539,"end":773.099,"text":"鸦片的基本作用是什么"},{"start":773.099,"end":773.919,"text":"不是成瘾"},{"start":773.919,"end":775.22,"text":"是镇痛"},{"start":775.22,"end":777.04,"text":"而且是即刻阵痛"},{"start":777.04,"end":778.46,"text":"在马克思所处时代"},{"start":778.46,"end":781.93,"text":"鸦片并不是首先被看成是成瘾品"},{"start":781.93,"end":784.8,"text":"而是被看成是镇痛药"},{"start":785.08,"end":786.62,"text":"一颗有效的镇痛药"},{"start":786.62,"end":789.27,"text":"它可以让人忍受酷刑"},{"start":789.27,"end":791.81,"text":"但是马克思没有说的很清楚"},{"start":791.81,"end":794.53,"text":"这里面重要的不是宗教"},{"start":794.53,"end":795.59,"text":"不是它的形式"},{"start":795.59,"end":796.63,"text":"不是它的那些外壳"},{"start":796.63,"end":799.17,"text":"那东西是爱"},{"start":800.06,"end":806.68,"text":"是一个在那个时代的生产和教育水准下面啊"},{"start":806.68,"end":809.98,"text":"浦发的一种爱欲享乐的方式"},{"start":809.98,"end":813.64,"text":"就跟我们这个时代男人不管女人买东西"},{"start":813.64,"end":817.88,"text":"但那个时候爱云是怎么发现的"},{"start":818.96,"end":821.88,"text":"因为那个时候并不是压抑"},{"start":822.86,"end":823.66,"text":"明白吗"},{"start":823.66,"end":827.82,"text":"底层平民之间的这个这个这个肉想的欲望"},{"start":828.9,"end":829.78,"text":"平静度而言的话"},{"start":829.78,"end":831.46,"text":"不是特别压抑"},{"start":831.94,"end":833.46,"text":"他们真正压抑的是什么"},{"start":833.46,"end":838.26,"text":"但是那个社会又不足够去生产足够多的享乐"},{"start":838.26,"end":840.95,"text":"足够多的光怪陆离的东西"},{"start":840.95,"end":845.56,"text":"去满足他们的神经系统对于兴奋和刺激的需求"},{"start":845.84,"end":850.16,"text":"所以他们要生产对于超绝者的爱"},{"start":850.16,"end":851.22,"text":"那就是幻想"},{"start":851.22,"end":852.72,"text":"妄想与超绝者"},{"start":852.72,"end":855.4,"text":"那个时候处在普遍的蒙昧状态"},{"start":855.4,"end":856.08,"text":"法医界"},{"start":856.08,"end":859.27,"text":"自然界的各种声光电啊"},{"start":859.27,"end":860.17,"text":"下大雨"},{"start":860.17,"end":860.79,"text":"什么东西"},{"start":860.79,"end":861.49,"text":"看人上帝"},{"start":861.49,"end":862.75,"text":"上帝在愤怒我这东西"},{"start":863.87,"end":865.43,"text":"比如说"},{"start":866.48,"end":867.48,"text":"对于父亲的爱"},{"start":868.96,"end":873.38,"text":"对于一个所有人共同的父亲的爱"},{"start":874.02,"end":876.62,"text":"这个东西我们并不陌生"},{"start":878.66,"end":882.3,"text":"我们这国家这民族并不陌生"},{"start":884.52,"end":887.54,"text":"你们知道我说的是什么吧"},{"start":887.54,"end":891.599,"text":"就是这是即将进入工业化"},{"start":891.599,"end":894.59,"text":"要就是这也是一种工业化的方式"},{"start":894.59,"end":896.63,"text":"来普及某种享乐模式"},{"start":896.63,"end":898.57,"text":"而且是廉价的普及想模式"},{"start":898.57,"end":901.26,"text":"朝向一个复兴的一个形象"},{"start":901.26,"end":904.0,"text":"复兴的一个课程呢"},{"start":904.44,"end":906.04,"text":"一个脸谱宣泄爱语"},{"start":906.04,"end":908.0,"text":"这是全民的恋物癖"},{"start":908.28,"end":908.92,"text":"明白吗"},{"start":910.0,"end":911.76,"text":"虽然基督教禁绝恋物癖"},{"start":911.76,"end":914.58,"text":"但实际上他就是相当于禁绝其他所有的恋物癖"},{"start":914.58,"end":916.64,"text":"只保留一个恋物癖"},{"start":919.26,"end":924.38,"text":"对着一个禁欲主义的一个复兴的一个形象制度"},{"start":925.68,"end":926.52,"text":"就是"},{"start":928.0,"end":932.65,"text":"那么这种爱呢是被启蒙运动啊"},{"start":932.65,"end":933.73,"text":"给他逐步拆解的"},{"start":933.73,"end":935.55,"text":"那么启蒙运动在运行之初"},{"start":935.55,"end":936.47,"text":"它是什么"},{"start":936.47,"end":939.795,"text":"它是神职的臂与"},{"start":944.3,"end":947.86,"text":"他是用爱欲收买了神学"},{"start":949.26,"end":952.14,"text":"什么运动一开始是作为什么东西出现的"},{"start":952.14,"end":956.31,"text":"哲学一开始作为什么东西出现的就是萌妹的人"},{"start":956.31,"end":957.51,"text":"就是设想上帝好吊"},{"start":957.51,"end":959.39,"text":"但我只只管去爱他就行了"},{"start":959.39,"end":961.27,"text":"狂热的去发泄欲望"},{"start":961.27,"end":966.06,"text":"甚至性欲望朝向那个不可名状的主主宰"},{"start":967.3,"end":969.77,"text":"哲学一开始的功能是什么"},{"start":970.05,"end":974.37,"text":"就是为这个主宰的小魔法做辩护"},{"start":974.73,"end":980.73,"text":"他想方设法的去把这个至高主宰流露出来的"},{"start":980.73,"end":983.02,"text":"一点点威能加以解释"},{"start":983.02,"end":986.82,"text":"然后让那些不不太蒙昧的个体"},{"start":986.82,"end":990.88,"text":"开始从这种解释当中去领会到我"},{"start":990.88,"end":993.689,"text":"原来它不仅仅是威能"},{"start":993.689,"end":995.649,"text":"他是智慧的睿智"},{"start":995.649,"end":996.229,"text":"哲学"},{"start":996.229,"end":998.36,"text":"一开始就作为一个闭喻"},{"start":998.36,"end":1006.36,"text":"给这个喜怒无常的主人的狂暴任意去加以辩护"},{"start":1008.22,"end":1011.08,"text":"那么这个B与最后是成功了"},{"start":1011.44,"end":1013.64,"text":"他成功的取代了这个主人"},{"start":1014.8,"end":1019.76,"text":"并且他成功的撤销了人类"},{"start":1020.41,"end":1022.01,"text":"对于这么一个主宰的爱"},{"start":1023.05,"end":1024.81,"text":"这个撤销过程"},{"start":1026.599,"end":1029.079,"text":"还发生了宗教内部"},{"start":1030.919,"end":1032.118,"text":"只有本来这种爱"},{"start":1032.118,"end":1037.25,"text":"甚至都是你私自不能去爱上帝的"},{"start":1037.65,"end":1041.49,"text":"你私自不能够去在阅读这个圣经的过程当中"},{"start":1041.49,"end":1044.388,"text":"去和上帝进行通信的"},{"start":1044.949,"end":1046.829,"text":"你必须加以中介"},{"start":1046.829,"end":1050.989,"text":"需要节制这种玩在这个电子调时期啊"},{"start":1050.989,"end":1057.26,"text":"在以前的那个还受这个叫停支配的事情"},{"start":1057.26,"end":1060.66,"text":"后来实在是他的农业经济发展到后面的话"},{"start":1060.66,"end":1064.159,"text":"这个爱玉的需求太旺盛了"},{"start":1064.159,"end":1068.319,"text":"他的封建地主的统治世系"},{"start":1069.4,"end":1072.36,"text":"需要越来越多的享乐模式"},{"start":1072.36,"end":1078.42,"text":"所以他必须要把这个原来的天主教的调停分发"},{"start":1078.42,"end":1081.48,"text":"爱欲享乐的这个基石要打碎"},{"start":1082.46,"end":1087.66,"text":"用一种快速工业化的方式来实现"},{"start":1087.66,"end":1091.72,"text":"对于底层未受教育的蒙昧人口的"},{"start":1092.88,"end":1096.88,"text":"性贿赂我们前面加个字稍微好一点"},{"start":1096.88,"end":1100.96,"text":"智信贿赂有做记录吗"},{"start":1100.96,"end":1105.08,"text":"这就是为什么基督教学校的天主教"},{"start":1107.18,"end":1109.02,"text":"这出这是出于什么"},{"start":1109.02,"end":1113.679,"text":"出于人口动员区的硬性需求"},{"start":1113.679,"end":1115.899,"text":"那么人口动物园学为什么会有这种需求呢"},{"start":1115.899,"end":1118.86,"text":"因为军阀和封建地主"},{"start":1118.86,"end":1119.76,"text":"他有这种需求"},{"start":1119.76,"end":1120.94,"text":"还有战争的需求"},{"start":1120.94,"end":1122.04,"text":"还有倾轧的需求"},{"start":1122.04,"end":1125.11,"text":"还有组织农业和商业的生产需求"},{"start":1125.11,"end":1130.27,"text":"他有去建构起更精细的都市大庄园"},{"start":1130.27,"end":1131.15,"text":"自给自足的"},{"start":1131.15,"end":1138.74,"text":"而是在村镇城市网络当中进行快速交易的"},{"start":1138.74,"end":1141.32,"text":"商业和这个农业的高效"},{"start":1141.32,"end":1145.86,"text":"二元运转的经济体系的需求对吧"},{"start":1145.86,"end":1148.189,"text":"就是还好"},{"start":1148.189,"end":1150.429,"text":"反正你们自己回去听录音"},{"start":1150.429,"end":1151.509,"text":"逐字逐句的去"},{"start":1151.509,"end":1154.549,"text":"到时候去结合那个什么历史来考察"},{"start":1155.47,"end":1157.71,"text":"那么在这上讲这种爱呢"},{"start":1157.71,"end":1162.51,"text":"他是对于宗教和自然性"},{"start":1162.51,"end":1167.17,"text":"当中的享乐模式的一个去除"},{"start":1168.31,"end":1174.9,"text":"但是我们会看到在这里面启蒙运动的话是"},{"start":1177.0,"end":1178.88,"text":"处在一个相对比较暧昧的"},{"start":1178.88,"end":1182.48,"text":"就是自然性这个角度"},{"start":1195.36,"end":1196.14,"text":"罗瑞do"},{"start":1196.14,"end":1203.37,"text":"他否定了这个个体在这个世族或者家庭当中的"},{"start":1203.37,"end":1204.65,"text":"那种黏腻的爱"},{"start":1209.45,"end":1211.77,"text":"有原子化的一个思想者"},{"start":1211.77,"end":1212.23,"text":"一个人"},{"start":1212.23,"end":1215.71,"text":"并且呢对于呃感性世界的享乐"},{"start":1215.71,"end":1218.615,"text":"持一个总体的统一态度"},{"start":1219.27,"end":1221.12,"text":"但是另外一方面"},{"start":1221.52,"end":1224.94,"text":"他又强调对于个人的身体的完全支配"},{"start":1224.94,"end":1228.12,"text":"我们对个别的个人的他的"},{"start":1229.54,"end":1231.44,"text":"自制的想这个关系"},{"start":1231.44,"end":1234.66,"text":"他是可以理性的去求化的"},{"start":1235.43,"end":1238.87,"text":"他又抵达一种最基本的智慧"},{"start":1242.2,"end":1245.36,"text":"把自己的身体当成一个物来支配"},{"start":1246.84,"end":1249.12,"text":"在自然性上面讲"},{"start":1250.51,"end":1252.79,"text":"启蒙运动的这个或者说哲学吧"},{"start":1252.79,"end":1256.78,"text":"我们等会就会近代哲学啊"},{"start":1256.78,"end":1257.96,"text":"作为启蒙的哲学"},{"start":1257.96,"end":1259.14,"text":"理性主义的运动"},{"start":1259.14,"end":1263.97,"text":"它实际上就是说使得这个身体转化为无"},{"start":1266.36,"end":1269.12,"text":"好物来来来来利用"},{"start":1269.12,"end":1273.62,"text":"那自然性在这里是作为物来得到保存的"},{"start":1273.62,"end":1274.97,"text":"所以"},{"start":1278.52,"end":1281.02,"text":"我们会看到有一种齐头并进啊"},{"start":1281.02,"end":1282.52,"text":"所以我们在情况运动过程中"},{"start":1282.52,"end":1285.44,"text":"我们看到有一种齐齐头并进"},{"start":1293.8,"end":1296.48,"text":"一方面是文艺复兴"},{"start":1296.48,"end":1300.29,"text":"自然界被讴歌是吧"},{"start":1300.29,"end":1302.23,"text":"自然界本身获得它的独立性"},{"start":1302.23,"end":1303.39,"text":"被讴歌"},{"start":1303.39,"end":1305.03,"text":"还有美妙的地方"},{"start":1305.03,"end":1306.99,"text":"还有它内在的和谐的地方"},{"start":1306.99,"end":1308.699,"text":"人的身体"},{"start":1308.979,"end":1310.619,"text":"或者说人类的这种美好"},{"start":1310.619,"end":1311.999,"text":"高洁的这种品质"},{"start":1311.999,"end":1313.579,"text":"不经由上帝的赏赐"},{"start":1313.579,"end":1319.84,"text":"不经由这个神权的许可而独立的显露出来"},{"start":1323.38,"end":1326.2,"text":"但是"},{"start":1327.12,"end":1329.42,"text":"但是他会有一个共同的基底吧"},{"start":1329.42,"end":1330.84,"text":"虽然是齐头并进"},{"start":1330.84,"end":1332.88,"text":"但是他有共同的基底"},{"start":1337.58,"end":1339.58,"text":"所有这个文艺复兴当中的"},{"start":1339.58,"end":1342.2,"text":"这个主要是绘画和音乐了"},{"start":1342.2,"end":1343.58,"text":"他们都有一个共同记忆"},{"start":1343.58,"end":1346.4,"text":"这共同记忆有人说是什么"},{"start":1347.5,"end":1349.98,"text":"我觉得是报答案是立"},{"start":1351.82,"end":1356.56,"text":"或者说我们就说啊有理性"},{"start":1356.56,"end":1360.59,"text":"合理性或者有理性主要是什么"},{"start":1360.59,"end":1362.43,"text":"数学和比例关系"},{"start":1362.43,"end":1364.41,"text":"数字和比例关系"},{"start":1364.73,"end":1367.09,"text":"这是他们共同记忆"},{"start":1369.9,"end":1372.76,"text":"自然和身体作为物物"},{"start":1372.76,"end":1374.6,"text":"不是作为一般的物"},{"start":1374.6,"end":1379.62,"text":"而是作为在这个有理性的基底下被把握的"},{"start":1379.62,"end":1385.32,"text":"被当成是需要通过透视关系复现的物"},{"start":1385.32,"end":1389.65,"text":"他并不能就说文艺复兴当中啊"},{"start":1389.65,"end":1392.29,"text":"你看那些是艺术家啊"},{"start":1392.29,"end":1393.33,"text":"华家啊"},{"start":1393.33,"end":1395.63,"text":"或者说那些音乐家"},{"start":1395.63,"end":1398.98,"text":"他们编制出来的杰作"},{"start":1398.98,"end":1402.56,"text":"没有一个是通过直觉"},{"start":1404.24,"end":1406.52,"text":"制作出来的"},{"start":1408.68,"end":1410.56,"text":"直觉只是激情"},{"start":1410.56,"end":1412.08,"text":"只是一点点种子"},{"start":1412.08,"end":1418.75,"text":"或者说一点点这里面的调色的点缀"},{"start":1419.75,"end":1422.49,"text":"他所有的记忆都是在流理性"},{"start":1422.49,"end":1425.43,"text":"在数学和比例的关系当中诞生的"},{"start":1425.43,"end":1427.185,"text":"所以啊"},{"start":1428.88,"end":1429.64,"text":"在这个过程中"},{"start":1429.64,"end":1430.84,"text":"我们看到什么"},{"start":1430.84,"end":1435.72,"text":"看到这个是一个某种智慧"},{"start":1438.34,"end":1439.18,"text":"懂我意思吧"},{"start":1440.66,"end":1442.44,"text":"Homemade"},{"start":1443.32,"end":1447.2,"text":"而且是什么可控的煤"},{"start":1447.75,"end":1449.95,"text":"可控的可生产的美"},{"start":1452.47,"end":1454.4,"text":"诞生出来的"},{"start":1454.42,"end":1459.52,"text":"这就是这个文艺复兴的基调"},{"start":1459.52,"end":1460.4,"text":"我记下"},{"start":1460.4,"end":1461.48,"text":"我们讲这个基础"},{"start":1461.48,"end":1462.76,"text":"我给你讲几大思想"},{"start":1462.76,"end":1463.48,"text":"解放运动啊"},{"start":1463.48,"end":1465.2,"text":"文艺复兴的基调"},{"start":1467.36,"end":1469.02,"text":"一种可控的"},{"start":1469.02,"end":1472.62,"text":"可以去通过数理体系"},{"start":1472.62,"end":1476.39,"text":"这个共同基底生产出来的美"},{"start":1477.63,"end":1479.87,"text":"他这个时候是智慧的"},{"start":1479.87,"end":1486.38,"text":"什么伪装智慧把自己伪装成美"},{"start":1489.46,"end":1491.5,"text":"出现在这个世界的那个节奏"},{"start":1491.5,"end":1492.38,"text":"什么阿波罗尼蒂"},{"start":1492.38,"end":1493.08,"text":"对不对"},{"start":1493.08,"end":1494.02,"text":"你们看过没有"},{"start":1494.02,"end":1494.7,"text":"说贝壳"},{"start":1494.7,"end":1498.15,"text":"贝壳里面长出一个美神"},{"start":1498.889,"end":1500.329,"text":"他说什么是什么"},{"start":1501.529,"end":1505.28,"text":"宙斯的精液和大海孕育出来的"},{"start":1512.48,"end":1516.139,"text":"但是这种齐头并进的"},{"start":1516.819,"end":1517.699,"text":"他是有他的"},{"start":1517.699,"end":1521.379,"text":"剩余的是有东西被甩在后面的"},{"start":1528.6,"end":1532.36,"text":"这个就是没有进入教科书体系的啊"},{"start":1532.36,"end":1536.12,"text":"就是那个同时代普遍发生的事情"},{"start":1537.089,"end":1541.48,"text":"就是一些依然停留在宗教华语当中的"},{"start":1541.84,"end":1548.64,"text":"在黑死病的高潮当中显现出来的"},{"start":1549.24,"end":1551.28,"text":"就是底层的无产斗"},{"start":1551.28,"end":1554.54,"text":"或者说它里面很多游牧德牧部落"},{"start":1554.54,"end":1558.6,"text":"那个时候有几个没有进入人类思想史的"},{"start":1558.6,"end":1560.56,"text":"有大屠杀"},{"start":1562.38,"end":1564.52,"text":"欧洲的这个大屠杀啊"},{"start":1564.52,"end":1565.74,"text":"我靠"},{"start":1567.0,"end":1569.64,"text":"湿热下北大52"},{"start":1572.74,"end":1576.02,"text":"二普遍的迷信"},{"start":1576.6,"end":1578.0,"text":"底层的普遍的迷信"},{"start":1578.0,"end":1579.28,"text":"深重的普遍的迷信"},{"start":1579.28,"end":1581.84,"text":"这个时候这些迷信不是宗教"},{"start":1593.4,"end":1595.32,"text":"第三点是什么"},{"start":1604.94,"end":1606.94,"text":"狂热的交易党"},{"start":1610.08,"end":1613.73,"text":"狂热效应首先出现的是大屠杀"},{"start":1613.73,"end":1617.59,"text":"你们不要以为欧洲人或者说这个开化的现代人"},{"start":1617.59,"end":1618.97,"text":"逐步开化的现代人"},{"start":1618.97,"end":1619.65,"text":"直到了一战"},{"start":1619.65,"end":1621.82,"text":"二战时候才变得邪恶起来"},{"start":1621.82,"end":1622.82,"text":"通过战争机器"},{"start":1622.82,"end":1625.06,"text":"现代战争机器一杀杀几10万人"},{"start":1625.06,"end":1629.45,"text":"那个时候天主教和新教徒的相互残杀"},{"start":1629.45,"end":1632.55,"text":"整村整镇整个城市的就灭口"},{"start":1632.55,"end":1635.88,"text":"都是以十数万人计的"},{"start":1636.52,"end":1638.42,"text":"他没有被写写入历史"},{"start":1638.42,"end":1640.56,"text":"然后普遍的迷信"},{"start":1642.3,"end":1645.2,"text":"所有这些启蒙运动当中的哲学"},{"start":1645.2,"end":1651.26,"text":"都只是这些迷信的东西当中"},{"start":1651.26,"end":1653.42,"text":"最后还有点价值"},{"start":1653.42,"end":1654.82,"text":"不太逆行的"},{"start":1654.82,"end":1656.6,"text":"所以你一定是主流"},{"start":1656.6,"end":1658.14,"text":"在那个时代"},{"start":1658.81,"end":1664.25,"text":"在神学对于新的生产装置产生出来的"},{"start":1664.25,"end":1665.55,"text":"可预测关系"},{"start":1665.55,"end":1672.11,"text":"产生出来的这个啊输入输出的那个黑箱"},{"start":1673.4,"end":1675.6,"text":"失去解释效力的时候"},{"start":1675.6,"end":1679.7,"text":"然后呢现代科学又没有及时填补起来的时候"},{"start":1679.7,"end":1681.75,"text":"迷信是最普遍的"},{"start":1681.75,"end":1684.11,"text":"在这个18世纪"},{"start":1684.11,"end":1685.35,"text":"十七十八世纪"},{"start":1685.35,"end":1686.27,"text":"那个时候"},{"start":1686.27,"end":1688.03,"text":"欧洲人相信什么时空来意"},{"start":1688.03,"end":1689.31,"text":"可以治什么病"},{"start":1689.31,"end":1691.45,"text":"不过阳阳痿啊"},{"start":1691.45,"end":1695.09,"text":"就是说各式样的是神秘学"},{"start":1695.09,"end":1696.93,"text":"各式各样的炼金术啊"},{"start":1696.93,"end":1701.79,"text":"然后科学是从这个土壤当中挣扎着的"},{"start":1701.79,"end":1705.01,"text":"或者说有无数的迷信才筛出了"},{"start":1705.01,"end":1707.65,"text":"才最后大批量的淘汰"},{"start":1707.65,"end":1709.03,"text":"用工业效率"},{"start":1709.03,"end":1711.33,"text":"或者用这个呵搞特效率"},{"start":1711.33,"end":1712.65,"text":"达尔文主义啊"},{"start":1712.65,"end":1717.86,"text":"人类达尔文主义淘汰了大量错误的医学范式"},{"start":1717.86,"end":1720.18,"text":"你就看看医学当中的麻醉剂"},{"start":1720.18,"end":1722.28,"text":"手术什么这些东西"},{"start":1722.8,"end":1726.4,"text":"中世纪的或中世纪末期啊"},{"start":1726.4,"end":1729.02,"text":"启蒙时代早期的普遍的残忍"},{"start":1729.02,"end":1734.61,"text":"那个时候的医生为了探索医学"},{"start":1734.61,"end":1736.53,"text":"就是对于一些疑难杂症"},{"start":1736.53,"end":1737.39,"text":"就是直接锯"},{"start":1737.39,"end":1738.97,"text":"直接上手去寄语啊"},{"start":1738.97,"end":1739.71,"text":"上去锯"},{"start":1739.71,"end":1744.87,"text":"那个时候的就是说科学医学和迷信的拉不出差"},{"start":1744.87,"end":1746.53,"te