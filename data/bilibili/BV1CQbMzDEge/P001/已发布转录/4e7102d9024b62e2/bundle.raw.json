:2084.539,"end":2085.779,"text":"我能把你当奴隶卖了"},{"start":2085.779,"end":2087.059,"text":"不用杀人了"},{"start":2087.059,"end":2088.619,"text":"我能奴役你"},{"start":2088.619,"end":2093.83,"text":"或者说我能以交易的方式不直接读取"},{"start":2097.1,"end":2098.82,"text":"我们要记住这个过渡啊"},{"start":2098.82,"end":2102.399,"text":"这个是在现实当中的过度普遍的残忍"},{"start":2102.399,"end":2105.559,"text":"或者说是比封建时代"},{"start":2105.559,"end":2109.48,"text":"比中世纪更为直接的残忍"},{"start":2109.48,"end":2111.12,"text":"更为高效的残忍"},{"start":2111.12,"end":2112.94,"text":"工业化的残忍"},{"start":2114.26,"end":2119.62,"text":"最终阳气自身到达了一个什么样的"},{"start":2120.26,"end":2121.46,"text":"什么样的一个程度"},{"start":2121.46,"end":2122.98,"text":"就是一个"},{"start":2124.36,"end":2127.96,"text":"物的关系支配一切的一个什么啊"},{"start":2131.36,"end":2133.2,"text":"或者说我们说普遍的交易性"},{"start":2133.2,"end":2134.12,"text":"交易性的关系"},{"start":2135.68,"end":2137.36,"text":"交易性的逻辑"},{"start":2139.0,"end":2140.64,"text":"是可以解的"},{"start":2140.64,"end":2143.04,"text":"那要交易就要去计算"},{"start":2143.04,"end":2143.62,"text":"对不对"},{"start":2143.62,"end":2146.89,"text":"你知道有理性有理性的算这个逻辑"},{"start":2147.33,"end":2149.81,"text":"作为算计的理解啊"},{"start":2159.06,"end":2160.58,"text":"那么这个东西呢就是什么"},{"start":2161.9,"end":2163.68,"text":"就是作为阳气了"},{"start":2163.68,"end":2165.38,"text":"爱的智慧"},{"start":2166.02,"end":2167.66,"text":"要冷酷的社会"},{"start":2167.66,"end":2168.66,"text":"我不要冷酷"},{"start":2168.66,"end":2171.44,"text":"他甚至都不冷酷了哈"},{"start":2173.3,"end":2180.34,"text":"那么这个这种哲学就是请记住哦"},{"start":2180.86,"end":2183.06,"text":"这个哲学就是现实的哲学"},{"start":2183.06,"end":2187.5,"text":"或者说这是哲学本身作为自然阶级统治的"},{"start":2187.5,"end":2189.54,"text":"最积极的意识形态"},{"start":2203.38,"end":2204.86,"text":"然后我们或换言之"},{"start":2204.86,"end":2207.74,"text":"我们说从如果说从黑格尔主义的角度来想"},{"start":2207.74,"end":2208.72,"text":"就是什么"},{"start":2208.72,"end":2215.42,"text":"就是嘶绝对绝对精神的运行停留在了量"},{"start":2215.42,"end":2216.92,"text":"或者其实不是量的"},{"start":2216.92,"end":2220.12,"text":"应该是那个交易啊"},{"start":2220.12,"end":2226.989,"text":"交换率同一性往里边可能卡在了本质论上面"},{"start":2226.989,"end":2229.429,"text":"本质论上某个环节"},{"start":2230.45,"end":2231.73,"text":"卡在本质上不"},{"start":2233.13,"end":2237.4,"text":"还有的论者称为卡在了这个量的这个词上"},{"start":2241.96,"end":2244.66,"text":"那你说这样的哲学就是作为革命的哲学了吗"},{"start":2244.66,"end":2245.74,"text":"是的没错"},{"start":2245.74,"end":2247.21,"text":"他就是革命啊"},{"start":2247.21,"end":2249.81,"text":"革命已经可以这种形态来产生了"},{"start":2249.81,"end":2252.16,"text":"我们刚刚说的什么诶"},{"start":2257.7,"end":2259.78,"text":"革命包括什么"},{"start":2262.14,"end":2264.98,"text":"人口的清除"},{"start":2272.68,"end":2274.56,"text":"革命难道不要杀人吗"},{"start":2274.56,"end":2276.0,"text":"有计划的"},{"start":2276.0,"end":2282.66,"text":"有目的的设定运动的仇恨对象要进大屠杀"},{"start":2284.26,"end":2286.22,"text":"第二点是什么"},{"start":2289.86,"end":2294.12,"text":"国王的总体的"},{"start":2294.74,"end":2300.55,"text":"不知道这个时候革命式的乌托邦式是怎样的"},{"start":2301.75,"end":2303.59,"text":"没见过的"},{"start":2305.2,"end":2306.36,"text":"越稀奇越好"},{"start":2308.32,"end":2310.24,"text":"无从验证啊"},{"start":2311.74,"end":2315.24,"text":"不存在的乌托邦和理想国"},{"start":2315.24,"end":2319.18,"text":"它是两种两种的噗"},{"start":2319.18,"end":2321.96,"text":"他和刚刚那个迷信在结构上是一样的"},{"start":2321.96,"end":2324.58,"text":"一对没见过的稀奇"},{"start":2324.58,"end":2328.81,"text":"然后有个权威莫名其妙的给他做个背书啊"},{"start":2328.81,"end":2332.68,"text":"用一些理性的隐秘的逻辑"},{"start":2332.68,"end":2335.8,"text":"长线条的再加一个论证"},{"start":2337.8,"end":2339.83,"text":"第三点是什么"},{"start":2340.27,"end":2342.51,"text":"那这个时候的交易变成了什么"},{"start":2342.51,"end":2344.71,"text":"这边的交易变成了"},{"start":2346.94,"end":2349.98,"text":"哎新的秩序的产生"},{"start":2356.66,"end":2358.5,"text":"这个秩序"},{"start":2360.7,"end":2362.46,"text":"再明确一点"},{"start":2364.72,"end":2366.92,"text":"现代经济秩序啊"},{"start":2369.62,"end":2375.42,"text":"革命的目的是去建构一个突破了自然交易关系"},{"start":2375.42,"end":2378.29,"text":"自然经济体系的一个新的经济秩序"},{"start":2380.0,"end":2381.48,"text":"中世纪的混乱"},{"start":2381.48,"end":2382.08,"text":"哦不对"},{"start":2382.08,"end":2384.28,"text":"中世纪抵达启蒙时代的"},{"start":2384.28,"end":2386.2,"text":"或者说我们是伴随着启蒙运动"},{"start":2386.2,"end":2391.0,"text":"伴随着这个宗教改革过程当中的"},{"start":2392.3,"end":2394.94,"text":"不不被历史的文献所记载的"},{"start":2394.94,"end":2396.82,"text":"那下了也也记载了"},{"start":2396.82,"end":2401.03,"text":"为教科书所愿意目睹面对的这三种混乱"},{"start":2402.47,"end":2407.35,"text":"现在就被视为是推行一个革命计划必备的"},{"start":2407.35,"end":2409.82,"text":"什么人口清楚"},{"start":2409.82,"end":2411.86,"text":"这乱起来乱起来啊"},{"start":2411.86,"end":2413.82,"text":"要乱起来"},{"start":2416.66,"end":2420.16,"text":"这叫布朗基主义"},{"start":2420.2,"end":2424.12,"text":"就法国所设想的那种真正激进的"},{"start":2424.12,"end":2426.32,"text":"暴力式的那种革命"},{"start":2426.74,"end":2428.3,"text":"就地球这三个要素"},{"start":2428.3,"end":2434.09,"text":"那么反过来就是然后经济秩序稳固了"},{"start":2434.09,"end":2436.59,"text":"乌托邦幻想被戳破了"},{"start":2436.59,"end":2438.71,"text":"然后就不需要再打骨折了"},{"start":2438.71,"end":2440.81,"text":"又又又恢复稳态了啊"},{"start":2440.81,"end":2442.59,"text":"社会又恢复稳态"},{"start":2442.79,"end":2445.41,"text":"那么我们讲这种革命观呢"},{"start":2445.41,"end":2448.17,"text":"他是资产阶级革命观"},{"start":2448.17,"end":2449.88,"text":"资本主义革命观"},{"start":2449.88,"end":2454.52,"text":"那我们甚至还要把这话说的更生动一点"},{"start":2462.08,"end":2464.569,"text":"但是他依然是"},{"start":2466.0,"end":2467.24,"text":"也就是说10月革命"},{"start":2470.08,"end":2471.76,"text":"他从性质上"},{"start":2471.76,"end":2474.9,"text":"从客观的历史条件上"},{"start":2474.9,"end":2477.72,"text":"他依然是一个由无产地的先锋队"},{"start":2485.25,"end":2488.47,"text":"他依然是以这种方式在进行的"},{"start":2489.19,"end":2490.71,"text":"他的革命胜利了之后"},{"start":2496.459,"end":2498.899,"text":"而是建构起国营资本主义"},{"start":2498.899,"end":2500.519,"text":"它实际上是资本主义革命"},{"start":2500.519,"end":2502.979,"text":"或者说我们说他是官僚自然界革命"},{"start":2502.979,"end":2504.88,"text":"国营资本主义革命"},{"start":2506.48,"end":2507.32,"text":"所以历史"},{"start":2509.6,"end":2512.65,"text":"大家只能最多"},{"start":2512.65,"end":2516.71,"text":"最多会把它说成是某种社会主义主义社会主义"},{"start":2516.71,"end":2518.53,"text":"这不是共产主义"},{"start":2521.66,"end":2524.94,"text":"它保留了绝大部分的资本主义的形态"},{"start":2526.76,"end":2529.5,"text":"以及它的基本的革命要素啊"},{"start":2529.5,"end":2531.86,"text":"这三个要素基本能保留"},{"start":2531.86,"end":2535.72,"text":"而且基本上还是用这种动力学驱动器来"},{"start":2541.37,"end":2544.88,"text":"共产主义本身已经不是哲学了"},{"start":2544.88,"end":2546.82,"text":"在理论准备上来讲"},{"start":2546.82,"end":2550.12,"text":"马克思主义认为他已经扬起了之前所有的哲学"},{"start":2550.12,"end":2552.54,"text":"不再是一种资产阶级的意识形态的"},{"start":2552.54,"end":2556.0,"text":"但是从现实落地的角度来讲"},{"start":2558.6,"end":2559.32,"text":"我们说"},{"start":2561.44,"end":2562.88,"text":"作为一个"},{"start":2566.36,"end":2567.56,"text":"哲学的革命啊"},{"start":2568.84,"end":2571.24,"text":"作为一种哲学的革命"},{"start":2580.84,"end":2582.76,"text":"马是共产主义革命"},{"start":2587.5,"end":2591.36,"text":"依然是依然经历了这么一个致命的辩证法"},{"start":2591.36,"end":2596.27,"text":"先要把个体从爱欲当中剥离出来"},{"start":2597.29,"end":2600.57,"text":"中间过渡的是什么阶级仇恨"},{"start":2601.72,"end":2605.12,"text":"清除性的断绝性的仇恨运动"},{"start":2605.12,"end":2608.66,"text":"最后抵达的是智慧"},{"start":2608.94,"end":2613.26,"text":"底下的是这个先锋队对于历史必然性的零售"},{"start":2613.97,"end":2617.65,"text":"那么来现在几点"},{"start":2619.1,"end":2619.94,"text":"45啊"},{"start":2621.58,"end":2623.46,"text":"所以我们这个时候"},{"start":2628.56,"end":2630.68,"text":"要去设想的"},{"start":2631.7,"end":2636.42,"text":"从爱到非爱"},{"start":2639.06,"end":2641.7,"text":"再到这个智慧"},{"start":2647.62,"end":2649.62,"text":"呃这个过渡"},{"start":2654.16,"end":2657.08,"text":"他有没有休整的可能性"},{"start":2659.36,"end":2661.72,"text":"他能不能不这样不这样"},{"start":2661.72,"end":2664.49,"text":"你就朗西埃主义就会说"},{"start":2664.93,"end":2668.37,"text":"中间这个中介应该是非智慧"},{"start":2673.14,"end":2675.58,"text":"啊这样过渡要通过"},{"start":2676.7,"end":2680.88,"text":"就是西方马思主义的所有的路径都加长"},{"start":2680.88,"end":2683.62,"text":"不过爱爱是神圣的"},{"start":2683.62,"end":2685.01,"text":"I是绝对的"},{"start":2685.01,"end":2686.19,"text":"I就是真理性"},{"start":2686.19,"end":2687.55,"text":"爱本身就有真理性了"},{"start":2687.55,"end":2690.07,"text":"这种真理性是超出平凡的智慧"},{"start":2690.07,"end":2691.94,"text":"算计了理性的智慧的"},{"start":2691.94,"end":2696.62,"text":"然后通过这种绝对的真诚的本真的"},{"start":2696.62,"end":2698.84,"text":"美好的而富足到智慧"},{"start":2698.84,"end":2702.7,"text":"一种新的团结的共同体和新的造反模式"},{"start":2703.02,"end":2704.46,"text":"这个通路走得通吗"},{"start":2705.9,"end":2706.76,"text":"走不通啊"},{"start":2706.76,"end":2708.26,"text":"因为"},{"start":2709.36,"end":2711.0,"text":"非智慧不是作为中介"},{"start":2711.0,"end":2712.44,"text":"非智慧在这里吧"},{"start":2712.44,"end":2715.2,"text":"非智慧在这里"},{"start":2717.02,"end":2721.6,"text":"这个过度他遭遇到的是无知者的无动于衷"},{"start":2721.6,"end":2723.67,"text":"无知者先要爱"},{"start":2723.67,"end":2726.39,"text":"先要激起爱欲上的昂扬"},{"start":2726.39,"end":2729.4,"text":"迷茫和焦虑"},{"start":2729.4,"end":2733.34,"text":"他才有可能进入革命的辩证法里面去"},{"start":2733.919,"end":2736.62,"text":"那你说作为中介"},{"start":2736.62,"end":2738.86,"text":"这个非爱过于残酷"},{"start":2738.86,"end":2741.82,"text":"肮脏或者过于不现实"},{"start":2742.98,"end":2744.43,"text":"或者说"},{"start":2745.92,"end":2746.76,"text":"作为中介"},{"start":2746.76,"end":2749.06,"text":"这个飞燕往往会落入资本主义的渴求"},{"start":2749.06,"end":2752.3,"text":"资产阶级的冷静盘算的理性的扭曲"},{"start":2752.3,"end":2754.83,"text":"然后就梦想背锅啊"},{"start":2754.899,"end":2756.219,"text":"搞个工会啊"},{"start":2756.219,"end":2756.899,"text":"工团呀"},{"start":2756.899,"end":2758.899,"text":"你拿到智慧"},{"start":2758.899,"end":2759.779,"text":"实际上是还是算计"},{"start":2759.779,"end":2764.18,"text":"就是嗯嗯咱们要以什么作为过渡呢"},{"start":2765.22,"end":2766.14,"text":"爱不与非"},{"start":2766.14,"end":2770.87,"text":"爱就是爱护你自己的一个驱逐行为"},{"start":2770.87,"end":2771.77,"text":"驱逐自身"},{"start":2772.85,"end":2774.37,"text":"叛逆自身"},{"start":2775.54,"end":2778.1,"text":"有的后现代"},{"start":2778.1,"end":2780.29,"text":"其他的后现代就是通过享乐"},{"start":2780.57,"end":2781.69,"text":"爱就是享乐"},{"start":2781.69,"end":2785.11,"text":"然后直接获得后现代社会要什么"},{"start":2785.11,"end":2786.41,"text":"我要保证这个享乐"},{"start":2786.41,"end":2787.51,"text":"那这个社会要什么"},{"start":2787.51,"end":2789.535,"text":"要包容"},{"start":2791.5,"end":2793.42,"text":"要离近拍照"},{"start":2794.29,"end":2796.79,"text":"要相信残影"},{"start":2796.79,"end":2801.94,"text":"而不是相信实体等等等等这些机会呢"},{"start":2802.46,"end":2804.78,"text":"什么德里达这些结构主义的这种智慧"},{"start":2805.78,"end":2809.27,"text":"他又不足以去整体的"},{"start":2809.27,"end":2812.43,"text":"去对自主义社会进行一种颠覆"},{"start":2813.77,"end":2815.73,"text":"这个中介项"},{"start":2817.36,"end":2818.6,"text":"是什么"},{"start":2821.32,"end":2823.6,"text":"我们会想到"},{"start":2828.56,"end":2830.34,"text":"爱一个有智慧的人"},{"start":2830.34,"end":2832.22,"text":"爱智者"},{"start":2832.42,"end":2834.92,"text":"爱一个有智慧的人"},{"start":2834.92,"end":2837.439,"text":"但是智者是非法的"},{"start":2837.439,"end":2839.139,"text":"在古相的传统当中"},{"start":2839.139,"end":2844.75,"text":"智者是见称自己有智慧的人啊"},{"start":2844.75,"end":2846.83,"text":"有没有其他的可能性"},{"start":2858.22,"end":2861.48,"text":"当然有爱无质的人"},{"start":2861.48,"end":2863.04,"text":"爱蠢人"},{"start":2863.04,"end":2865.3,"text":"爱愚蠢的人"},{"start":2868.0,"end":2869.48,"text":"爱疯子"},{"start":2869.48,"end":2877.07,"text":"或者说爱无法并入到算计算计体系当中的人"},{"start":2877.07,"end":2878.63,"text":"他的所作所为"},{"start":2878.63,"end":2884.24,"text":"不被看成是有可能划入到算计的框架当中"},{"start":2887.1,"end":2890.44,"text":"从而超出一般的困人智慧"},{"start":2890.44,"end":2891.5,"text":"爱精神病人"},{"start":2891.5,"end":2892.42,"text":"爱疯子"},{"start":2892.42,"end":2895.18,"text":"这是分析师共同体的策略"},{"start":2896.01,"end":2898.53,"text":"但是分析师共同体没有做到的"},{"start":2898.53,"end":2899.77,"text":"就是他应该爱他们"},{"start":2899.77,"end":2902.65,"text":"但他们普遍执行反应性策略"},{"start":2905.2,"end":2907.26,"text":"啧不知是不爱"},{"start":2907.26,"end":2909.6,"text":"然后不爱那些不智者"},{"start":2909.6,"end":2910.82,"text":"不爱不智者"},{"start":2910.82,"end":2911.59,"text":"对"},{"start":2912.39,"end":2915.11,"text":"通过如何去阻碍他们"},{"start":2915.11,"end":2919.44,"text":"来获得一种还是一种资本主义的冷酷的职责"},{"start":2924.72,"end":2928.16,"text":"那么还有一种可能性是什么呢"},{"start":2932.1,"end":2934.78,"text":"被无知者爱"},{"start":2938.74,"end":2941.42,"text":"不是主动去他爱他们"},{"start":2941.42,"end":2946.22,"text":"而是被爱这个过程被无知者爱你是非爱你"},{"start":2946.22,"end":2948.16,"text":"这种对爱的否定"},{"start":2949.26,"end":2951.9,"text":"你说你不去主动去卖别人"},{"start":2951.9,"end":2954.55,"text":"而是任由别人爱上你"},{"start":2954.55,"end":2956.75,"text":"另外一方面就是不智者"},{"start":2956.75,"end":2961.9,"text":"不智者是对于自信的凡俗之性的超越"},{"start":2962.3,"end":2963.86,"text":"89"},{"start":2968.52,"end":2971.42,"text":"还有这种偶然的必然性降低下来"},{"start":2971.42,"end":2974.26,"text":"那么这个范式呢"},{"start":2975.92,"end":2982.019,"text":"这个方式就是粉丝经济追星的那个范思办"},{"start":2982.019,"end":2983.639,"text":"什么追星的"},{"start":2983.639,"end":2985.12,"text":"娱乐追星的反"},{"start":2985.12,"end":2988.22,"text":"那么这个办事也被征召了"},{"start":2988.22,"end":2991.26,"text":"也被普遍地征召起来啊"},{"start":2992.02,"end":2993.54,"text":"用来给日本人续命吗"},{"start":2994.62,"end":2996.7,"text":"哪还有没有其他的坏事"},{"start":2997.98,"end":3004.44,"text":"我们现在已经走到了一个哲学计划的深水区了"},{"start":3018.48,"end":3021.77,"text":"我个人采取的策略是什么"},{"start":3022.41,"end":3028.81,"text":"我个人裁决策略是克制对于不治者的爱"},{"start":3032.58,"end":3033.7,"text":"爱的迁移"},{"start":3033.7,"end":3034.78,"text":"爱的克制"},{"start":3034.78,"end":3035.74,"text":"对于肉"},{"start":3035.74,"end":3038.22,"text":"那么这个过程中会生产出一种智慧"},{"start":3038.22,"end":3039.48,"text":"如何去克制"},{"start":3039.48,"end":3043.56,"text":"不是不是执行严酷的反应性策略"},{"start":3043.56,"end":3044.12,"text":"反应性策略"},{"start":3044.12,"end":3046.109,"text":"他不是不爱你的"},{"start":3046.389,"end":3047.849,"text":"你把它取消掉"},{"start":3047.849,"end":3051.509,"text":"那就维持着不智者对你的爱的同时克制"},{"start":3051.509,"end":3055.269,"text":"不要让自己陷入对他们的爱"},{"start":3055.519,"end":3059.999,"text":"这个过程能产生出某种软新的"},{"start":3060.24,"end":3063.62,"text":"我不能再给我两心的治愈啊"},{"start":3064.68,"end":3067.98,"text":"他导向一个另一种严酷的"},{"start":3067.98,"end":3072.32,"text":"整体的社会的运行机理"}],"source":"subtitle"}
