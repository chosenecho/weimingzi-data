{
  "bvid": "BV1EM4m1C7B8",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "726a7b789a3f103e755758c66a5bfc5eee056a463f97e97a93f99cd427ee1a49",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 1220,
      "end_ms": 3560,
      "text": "什么你这么看麦当海姆问题太大"
    },
    {
      "ordinal": 1,
      "start_ms": 3560,
      "end_ms": 5360,
      "text": "人家找中间不是法西斯"
    },
    {
      "ordinal": 2,
      "start_ms": 5360,
      "end_ms": 6580,
      "text": "是这样的吗"
    },
    {
      "ordinal": 3,
      "start_ms": 6580,
      "end_ms": 8200,
      "text": "敌对是男人啊"
    },
    {
      "ordinal": 4,
      "start_ms": 8200,
      "end_ms": 8860,
      "text": "然后呢"
    },
    {
      "ordinal": 5,
      "start_ms": 8860,
      "end_ms": 10360,
      "text": "什么什么斯大林啊"
    },
    {
      "ordinal": 6,
      "start_ms": 10360,
      "end_ms": 12960,
      "text": "什么什么什么什么"
    },
    {
      "ordinal": 7,
      "start_ms": 12960,
      "end_ms": 16170,
      "text": "出现了简单的怀疑主义是什么"
    },
    {
      "ordinal": 8,
      "start_ms": 16170,
      "end_ms": 22020,
      "text": "怀疑主义是什么啊"
    },
    {
      "ordinal": 9,
      "start_ms": 28390,
      "end_ms": 31230,
      "text": "你看A问题太大了"
    },
    {
      "ordinal": 10,
      "start_ms": 31230,
      "end_ms": 33460,
      "text": "人家A其实是A撇"
    },
    {
      "ordinal": 11,
      "start_ms": 33460,
      "end_ms": 36400,
      "text": "然后呢你你看A这样看"
    },
    {
      "ordinal": 12,
      "start_ms": 36400,
      "end_ms": 37330,
      "text": "你就是B"
    },
    {
      "ordinal": 13,
      "start_ms": 37330,
      "end_ms": 39580,
      "text": "然后你这个如果你是B的话"
    },
    {
      "ordinal": 14,
      "start_ms": 39580,
      "end_ms": 40540,
      "text": "你就会变成C"
    },
    {
      "ordinal": 15,
      "start_ms": 40540,
      "end_ms": 41620,
      "text": "如果你是C的话"
    },
    {
      "ordinal": 16,
      "start_ms": 41620,
      "end_ms": 43930,
      "text": "你就会变成D啊"
    },
    {
      "ordinal": 17,
      "start_ms": 45250,
      "end_ms": 46450,
      "text": "如果你是D的话"
    },
    {
      "ordinal": 18,
      "start_ms": 46450,
      "end_ms": 48170,
      "text": "是什么什么"
    },
    {
      "ordinal": 19,
      "start_ms": 48170,
      "end_ms": 50210,
      "text": "你这种怀疑主义根基"
    },
    {
      "ordinal": 20,
      "start_ms": 50210,
      "end_ms": 51770,
      "text": "恰恰是一种不可怀疑的东西"
    },
    {
      "ordinal": 21,
      "start_ms": 51770,
      "end_ms": 52610,
      "text": "这种不可怀疑的东西"
    },
    {
      "ordinal": 22,
      "start_ms": 52610,
      "end_ms": 54980,
      "text": "就是曼纳海姆是个撤离法西斯的叙事"
    },
    {
      "ordinal": 23,
      "start_ms": 54980,
      "end_ms": 59390,
      "text": "对叙事的怀疑恰好不是这个不是叙事"
    },
    {
      "ordinal": 24,
      "start_ms": 59390,
      "end_ms": 60890,
      "text": "这就是我们的命令体系"
    },
    {
      "ordinal": 25,
      "start_ms": 60890,
      "end_ms": 64530,
      "text": "我们通过这样的叙事能创造权利啊"
    },
    {
      "ordinal": 26,
      "start_ms": 64930,
      "end_ms": 66570,
      "text": "你管我问题太大了"
    },
    {
      "ordinal": 27,
      "start_ms": 66570,
      "end_ms": 67890,
      "text": "我通过这样的叙事"
    },
    {
      "ordinal": 28,
      "start_ms": 67890,
      "end_ms": 70290,
      "text": "我可以获得现实权利就可以了"
    },
    {
      "ordinal": 29,
      "start_ms": 70290,
      "end_ms": 74850,
      "text": "OK我们不认同那种那种建国方式"
    },
    {
      "ordinal": 30,
      "start_ms": 74850,
      "end_ms": 76380,
      "text": "分离主义的建国方式"
    },
    {
      "ordinal": 31,
      "start_ms": 76380,
      "end_ms": 81539,
      "text": "不认同从一个多民族民族国家身上撕一块下来"
    },
    {
      "ordinal": 32,
      "start_ms": 81539,
      "end_ms": 83549,
      "text": "然后还和红军打内战"
    },
    {
      "ordinal": 33,
      "start_ms": 83549,
      "end_ms": 86039,
      "text": "我们不认同我们如果有这样的敌人"
    },
    {
      "ordinal": 34,
      "start_ms": 86039,
      "end_ms": 88710,
      "text": "我们和我们会杀掉这些人"
    },
    {
      "ordinal": 35,
      "start_ms": 88990,
      "end_ms": 91530,
      "text": "他就是我们定义的法西斯"
    },
    {
      "ordinal": 36,
      "start_ms": 91530,
      "end_ms": 96090,
      "text": "用一种民族分裂的方式传一个小朝廷出来"
    },
    {
      "ordinal": 37,
      "start_ms": 96090,
      "end_ms": 97630,
      "text": "和中央政权对着干"
    },
    {
      "ordinal": 38,
      "start_ms": 97630,
      "end_ms": 101580,
      "text": "哪怕是新兴的解放性的无产阶级中央政权"
    },
    {
      "ordinal": 39,
      "start_ms": 101580,
      "end_ms": 106720,
      "text": "他传小商店的方式也是通过和社会上层精英"
    },
    {
      "ordinal": 40,
      "start_ms": 107360,
      "end_ms": 107920,
      "text": "统治"
    },
    {
      "ordinal": 41,
      "start_ms": 107920,
      "end_ms": 110280,
      "text": "集团贵族"
    },
    {
      "ordinal": 42,
      "start_ms": 110860,
      "end_ms": 112920,
      "text": "还有小工商业者合作"
    },
    {
      "ordinal": 43,
      "start_ms": 112920,
      "end_ms": 113760,
      "text": "所以你跟我说"
    },
    {
      "ordinal": 44,
      "start_ms": 113760,
      "end_ms": 115080,
      "text": "这问题太大了不"
    },
    {
      "ordinal": 45,
      "start_ms": 115080,
      "end_ms": 116920,
      "text": "我们不是问题太大了"
    },
    {
      "ordinal": 46,
      "start_ms": 116920,
      "end_ms": 118090,
      "text": "你应该这样说"
    },
    {
      "ordinal": 47,
      "start_ms": 118090,
      "end_ms": 121940,
      "text": "你这么看待曼纳海姆对我的敌意"
    },
    {
      "ordinal": 48,
      "start_ms": 121940,
      "end_ms": 124490,
      "text": "对我们这种人的敌意太大了"
    },
    {
      "ordinal": 49,
      "start_ms": 124490,
      "end_ms": 126620,
      "text": "你看到的不是我的问题"
    },
    {
      "ordinal": 50,
      "start_ms": 126620,
      "end_ms": 128490,
      "text": "你看到的是我的敌意"
    },
    {
      "ordinal": 51,
      "start_ms": 128490,
      "end_ms": 130770,
      "text": "我们不再讨论一个历史的问题"
    },
    {
      "ordinal": 52,
      "start_ms": 130770,
      "end_ms": 132930,
      "text": "我们我们讨论曼纳海姆"
    },
    {
      "ordinal": 53,
      "start_ms": 132930,
      "end_ms": 135000,
      "text": "只是说如果在中国"
    },
    {
      "ordinal": 54,
      "start_ms": 135820,
      "end_ms": 139410,
      "text": "如果国家民族陷于不幸的境地"
    },
    {
      "ordinal": 55,
      "start_ms": 139410,
      "end_ms": 142790,
      "text": "有那么一种类似曼纳海姆的人物出现的时候"
    },
    {
      "ordinal": 56,
      "start_ms": 142790,
      "end_ms": 145130,
      "text": "干类似曼纳海姆的事情的时候"
    },
    {
      "ordinal": 57,
      "start_ms": 145130,
      "end_ms": 146839,
      "text": "比如说他在哪个山区"
    },
    {
      "ordinal": 58,
      "start_ms": 146839,
      "end_ms": 149059,
      "text": "或者他在那个边边陲省份"
    },
    {
      "ordinal": 59,
      "start_ms": 149059,
      "end_ms": 150619,
      "text": "要做类似的事情的时候"
    },
    {
      "ordinal": 60,
      "start_ms": 150619,
      "end_ms": 152870,
      "text": "我们要杀掉他"
    },
    {
      "ordinal": 61,
      "start_ms": 153270,
      "end_ms": 156770,
      "text": "然后这个曼无论曼纳海姆在他那个边陲省份"
    },
    {
      "ordinal": 62,
      "start_ms": 156770,
      "end_ms": 159020,
      "text": "或在那个山区或者那个岛屿上面"
    },
    {
      "ordinal": 63,
      "start_ms": 159020,
      "end_ms": 164380,
      "text": "多受它所在的那一片地方的那个少数民族"
    },
    {
      "ordinal": 64,
      "start_ms": 164380,
      "end_ms": 169230,
      "text": "或者说某个新造出来的新兴民族的啊"
    },
    {
      "ordinal": 65,
      "start_ms": 169230,
      "end_ms": 170640,
      "text": "中上层的支持"
    },
    {
      "ordinal": 66,
      "start_ms": 170640,
      "end_ms": 172050,
      "text": "无论他多受这个支持"
    },
    {
      "ordinal": 67,
      "start_ms": 172050,
      "end_ms": 174120,
      "text": "我们都要杀掉他"
    },
    {
      "ordinal": 68,
      "start_ms": 174520,
      "end_ms": 176780,
      "text": "我们要杀掉这种人"
    },
    {
      "ordinal": 69,
      "start_ms": 177120,
      "end_ms": 178430,
      "text": "我们要干掉这种人"
    },
    {
      "ordinal": 70,
      "start_ms": 178430,
      "end_ms": 180560,
      "text": "并且我们还会说他是个法西斯"
    },
    {
      "ordinal": 71,
      "start_ms": 180560,
      "end_ms": 182070,
      "text": "然后把他干掉"
    },
    {
      "ordinal": 72,
      "start_ms": 182070,
      "end_ms": 183870,
      "text": "我们客观现实的"
    },
    {
      "ordinal": 73,
      "start_ms": 183870,
      "end_ms": 186180,
      "text": "如果历史发生这么一种情形"
    },
    {
      "ordinal": 74,
      "start_ms": 186180,
      "end_ms": 187860,
      "text": "我们会做这样的选择"
    },
    {
      "ordinal": 75,
      "start_ms": 187860,
      "end_ms": 189990,
      "text": "我们会这样去组织动员"
    },
    {
      "ordinal": 76,
      "start_ms": 189990,
      "end_ms": 191930,
      "text": "我们可以组织动员的力量"
    },
    {
      "ordinal": 77,
      "start_ms": 191930,
      "end_ms": 193760,
      "text": "让他成为军事力量"
    },
    {
      "ordinal": 78,
      "start_ms": 193760,
      "end_ms": 199280,
      "text": "然后去和类似曼纳海姆这样的分裂国家的戕害"
    },
    {
      "ordinal": 79,
      "start_ms": 199280,
      "end_ms": 200840,
      "text": "无产阶级的镇压"
    },
    {
      "ordinal": 80,
      "start_ms": 200840,
      "end_ms": 203240,
      "text": "红色力量的这样的势力"
    },
    {
      "ordinal": 81,
      "start_ms": 203240,
      "end_ms": 204800,
      "text": "我们会干掉他"
    },
    {
      "ordinal": 82,
      "start_ms": 204800,
      "end_ms": 208250,
      "text": "我们会组织动员起我们的军事力量去杀掉他们"
    },
    {
      "ordinal": 83,
      "start_ms": 208250,
      "end_ms": 210140,
      "text": "明白吗"
    },
    {
      "ordinal": 84,
      "start_ms": 210540,
      "end_ms": 212420,
      "text": "所以我这么看待曼纳海姆"
    },
    {
      "ordinal": 85,
      "start_ms": 212420,
      "end_ms": 213740,
      "text": "不是问题太大了"
    },
    {
      "ordinal": 86,
      "start_ms": 213740,
      "end_ms": 216380,
      "text": "是我对待类似于曼纳海姆"
    },
    {
      "ordinal": 87,
      "start_ms": 216380,
      "end_ms": 218720,
      "text": "以曼纳海姆类似的方式发迹的"
    },
    {
      "ordinal": 88,
      "start_ms": 222380,
      "end_ms": 224540,
      "text": "我看到他没有什么问题"
    },
    {
      "ordinal": 89,
      "start_ms": 224540,
      "end_ms": 227589,
      "text": "我的敌意可能在你眼里是问题"
    },
    {
      "ordinal": 90,
      "start_ms": 227869,
      "end_ms": 229570,
      "text": "明白吗"
    },
    {
      "ordinal": 91,
      "start_ms": 230030,
      "end_ms": 232360,
      "text": "什么问题在搞笑"
    },
    {
      "ordinal": 92,
      "start_ms": 232360,
      "end_ms": 234580,
      "text": "这是政治立场的问题啊"
    },
    {
      "ordinal": 93,
      "start_ms": 234580,
      "end_ms": 235990,
      "text": "他就是个法西斯啊"
    },
    {
      "ordinal": 94,
      "start_ms": 235990,
      "end_ms": 241179,
      "text": "这么看来传从而且利用语言"
    },
    {
      "ordinal": 95,
      "start_ms": 241179,
      "end_ms": 243489,
      "text": "利用一些文化"
    },
    {
      "ordinal": 96,
      "start_ms": 243489,
      "end_ms": 245169,
      "text": "民族生活方式"
    },
    {
      "ordinal": 97,
      "start_ms": 245169,
      "end_ms": 245949,
      "text": "语言"
    },
    {
      "ordinal": 98,
      "start_ms": 245949,
      "end_ms": 248200,
      "text": "历史传统的差异"
    },
    {
      "ordinal": 99,
      "start_ms": 248200,
      "end_ms": 252310,
      "text": "直接用这个矛盾掩盖阶级矛盾"
    },
    {
      "ordinal": 100,
      "start_ms": 252310,
      "end_ms": 254260,
      "text": "反抗红色力量"
    },
    {
      "ordinal": 101,
      "start_ms": 254260,
      "end_ms": 256079,
      "text": "反抗红色革命"
    },
    {
      "ordinal": 102,
      "start_ms": 256079,
      "end_ms": 258659,
      "text": "然后船这种小朝廷出来的"
    },
    {
      "ordinal": 103,
      "start_ms": 258659,
      "end_ms": 260640,
      "text": "就是干掉他"
    },
    {
      "ordinal": 104,
      "start_ms": 260738,
      "end_ms": 262260,
      "text": "这还留着干什么"
    },
    {
      "ordinal": 105,
      "start_ms": 262260,
      "end_ms": 263220,
      "text": "留着过年啊"
    },
    {
      "ordinal": 106,
      "start_ms": 263220,
      "end_ms": 264250,
      "text": "留着吃饭啊"
    },
    {
      "ordinal": 107,
      "start_ms": 264250,
      "end_ms": 266140,
      "text": "斯大林够仁慈了"
    },
    {
      "ordinal": 108,
      "start_ms": 266140,
      "end_ms": 267490,
      "text": "你不要说什么斯大林主义"
    },
    {
      "ordinal": 109,
      "start_ms": 267490,
      "end_ms": 268510,
      "text": "斯大林够仁慈了"
    },
    {
      "ordinal": 110,
      "start_ms": 268510,
      "end_ms": 271090,
      "text": "最后只是把曼纳海姆放逐而已"
    },
    {
      "ordinal": 111,
      "start_ms": 271090,
      "end_ms": 272980,
      "text": "最后"
    },
    {
      "ordinal": 112,
      "start_ms": 275120,
      "end_ms": 281140,
      "text": "成为这个是成为他的这个呃这个卫星国了啊"
    },
    {
      "ordinal": 113,
      "start_ms": 281140,
      "end_ms": 284000,
      "text": "最后成为苏联的卫星国了"
    },
    {
      "ordinal": 114,
      "start_ms": 284640,
      "end_ms": 285470,
      "text": "对不对"
    },
    {
      "ordinal": 115,
      "start_ms": 285470,
      "end_ms": 287720,
      "text": "是作为苏联的卫星国"
    },
    {
      "ordinal": 116,
      "start_ms": 288060,
      "end_ms": 290000,
      "text": "苏联非常仁慈"
    },
    {
      "ordinal": 117,
      "start_ms": 290000,
      "end_ms": 292010,
      "text": "没有没有把它吞并"
    },
    {
      "ordinal": 118,
      "start_ms": 292010,
      "end_ms": 293740,
      "text": "把它作为缓冲区"
    },
    {
      "ordinal": 119,
      "start_ms": 293740,
      "end_ms": 295840,
      "text": "傀儡战略缓冲区"
    },
    {
      "ordinal": 120,
      "start_ms": 295840,
      "end_ms": 297880,
      "text": "然后曼纳海姆也没有杀掉"
    },
    {
      "ordinal": 121,
      "start_ms": 297880,
      "end_ms": 300580,
      "text": "只是流放"
    },
    {
      "ordinal": 122,
      "start_ms": 300920,
      "end_ms": 307440,
      "text": "因为这样可以笼络安抚利用一些旧的精英啊"
    },
    {
      "ordinal": 123,
      "start_ms": 307440,
      "end_ms": 310380,
      "text": "旧的一些呃统治集团的中上层可用"
    },
    {
      "ordinal": 124,
      "start_ms": 310380,
      "end_ms": 311790,
      "text": "这种人还能用"
    },
    {
      "ordinal": 125,
      "start_ms": 311790,
      "end_ms": 313380,
      "text": "我告诉你"
    },
    {
      "ordinal": 126,
      "start_ms": 313380,
      "end_ms": 316680,
      "text": "为什么你觉得我看待曼纳海姆问题太大"
    },
    {
      "ordinal": 127,
      "start_ms": 316680,
      "end_ms": 317940,
      "text": "因为你根本不知道"
    },
    {
      "ordinal": 128,
      "start_ms": 317940,
      "end_ms": 321540,
      "text": "政治的赤裸裸的一种实操的实用主义"
    },
    {
      "ordinal": 129,
      "start_ms": 321540,
      "end_ms": 322200,
      "text": "就是这样的"
    },
    {
      "ordinal": 130,
      "start_ms": 324180,
      "end_ms": 325760,
      "text": "最搞笑"
    },
    {
      "ordinal": 131,
      "start_ms": 326220,
      "end_ms": 329450,
      "text": "历史上的曼纳海姆在我眼里就是类似这种人"
    },
    {
      "ordinal": 132,
      "start_ms": 329450,
      "end_ms": 332390,
      "text": "历史上的斯大林可能做的选择跟我不一样"
    },
    {
      "ordinal": 133,
      "start_ms": 332390,
      "end_ms": 333680,
      "text": "他喊仁慈"
    },
    {
      "ordinal": 134,
      "start_ms": 333680,
      "end_ms": 335340,
      "text": "饶了他一命"
    },
    {
      "ordinal": 135,
      "start_ms": 335730,
      "end_ms": 336830,
      "text": "斯大林想杀他"
    },
    {
      "ordinal": 136,
      "start_ms": 336830,
      "end_ms": 337850,
      "text": "难道不能杀吗"
    },
    {
      "ordinal": 137,
      "start_ms": 339170,
      "end_ms": 344975,
      "text": "托洛茨基在远在那么远的地方造假照耀就宰了"
    },
    {
      "ordinal": 138,
      "start_ms": 346340,
      "end_ms": 348550,
      "text": "历史人物做不同的选择罢了"
    },
    {
      "ordinal": 139,
      "start_ms": 348550,
      "end_ms": 351640,
      "text": "那我为什么要去叙述曼纳海姆这件事情"
    },
    {
      "ordinal": 140,
      "start_ms": 351640,
      "end_ms": 353260,
      "text": "那我只是表明一个姿态啊"
    },
    {
      "ordinal": 141,
      "start_ms": 353260,
      "end_ms": 357140,
      "text": "我跟像曼纳海姆一样发迹起来的力量"
    },
    {
      "ordinal": 142,
      "start_ms": 357140,
      "end_ms": 360170,
      "text": "无论它是依据一些港口城市"
    },
    {
      "ordinal": 143,
      "start_ms": 360170,
      "end_ms": 361070,
      "text": "一个岛屿"
    },
    {
      "ordinal": 144,
      "start_ms": 361070,
      "end_ms": 362250,
      "text": "一个山川"
    },
    {
      "ordinal": 145,
      "start_ms": 362250,
      "end_ms": 364870,
      "text": "一个高原还是边陲省份"
    },
    {
      "ordinal": 146,
      "start_ms": 364870,
      "end_ms": 365800,
      "text": "还是个盆地"
    },
    {
      "ordinal": 147,
      "start_ms": 365800,
      "end_ms": 367630,
      "text": "无论他在哪里"
    },
    {
      "ordinal": 148,
      "start_ms": 367630,
      "end_ms": 370360,
      "text": "利用挑拨起民族差异"
    },
    {
      "ordinal": 149,
      "start_ms": 370360,
      "end_ms": 375549,
      "text": "民族矛盾来搞所谓的自治建国这样的方式"
    },
    {
      "ordinal": 150,
      "start_ms": 375549,
      "end_ms": 380499,
      "text": "然后不管他多受他本地所在的小生产者"
    },
    {
      "ordinal": 151,
      "start_ms": 380499,
      "end_ms": 383960,
      "text": "曾是小市民啊"
    },
    {
      "ordinal": 152,
      "start_ms": 383960,
      "end_ms": 385400,
      "text": "还包括一些统治精英贵族"
    },
    {
      "ordinal": 153,
      "start_ms": 385400,
      "end_ms": 389240,
      "text": "还有其他从那个什么旧的大本营流窜到这里了"
    },
    {
      "ordinal": 154,
      "start_ms": 389240,
      "end_ms": 390440,
      "text": "新的这些精英"
    },
    {
      "ordinal": 155,
      "start_ms": 390440,
      "end_ms": 392610,
      "text": "不管他多受这些人的支持"
    },
    {
      "ordinal": 156,
      "start_ms": 393370,
      "end_ms": 395910,
      "text": "有机会就干掉了"
    },
    {
      "ordinal": 157,
      "start_ms": 401240,
      "end_ms": 403150,
      "text": "这不是个历史问题"
    },
    {
      "ordinal": 158,
      "start_ms": 403150,
      "end_ms": 404920,
      "text": "这是个政治问题啊"
    },
    {
      "ordinal": 159,
      "start_ms": 404920,
      "end_ms": 408040,
      "text": "朋友我看到曼纳海姆"
    },
    {
      "ordinal": 160,
      "start_ms": 408040,
      "end_ms": 409960,
      "text": "就是如果将来出类似的人物"
    },
    {
      "ordinal": 161,
      "start_ms": 409960,
      "end_ms": 411460,
      "text": "我们要干掉他"
    },
    {
      "ordinal": 162,
      "start_ms": 411460,
      "end_ms": 412659,
      "text": "明白吧"
    },
    {
      "ordinal": 163,
      "start_ms": 416139,
      "end_ms": 418179,
      "text": "的历史的力量的一部分"
    },
    {
      "ordinal": 164,
      "start_ms": 418179,
      "end_ms": 420279,
      "text": "一个组成部分"
    },
    {
      "ordinal": 165,
      "start_ms": 422520,
      "end_ms": 423800,
      "text": "可以吧"
    },
    {
      "ordinal": 166,
      "start_ms": 423800,
      "end_ms": 424760,
      "text": "没问题吧"
    },
    {
      "ordinal": 167,
      "start_ms": 429780,
      "end_ms": 432060,
      "text": "发下这么一种承诺"
    },
    {
      "ordinal": 168,
      "start_ms": 432060,
      "end_ms": 433200,
      "text": "消灭你的承诺"
    },
    {
      "ordinal": 169,
      "start_ms": 433200,
      "end_ms": 435289,
      "text": "我觉得没什么问题"
    },
    {
      "ordinal": 170,
      "start_ms": 435509,
      "end_ms": 436309,
      "text": "不亏吧"
    },
    {
      "ordinal": 171,
      "start_ms": 437929,
      "end_ms": 439960,
      "text": "很正常吧"
    },
    {
      "ordinal": 172,
      "start_ms": 440360,
      "end_ms": 442060,
      "text": "这不是个历史问题啊"
    },
    {
      "ordinal": 173,
      "start_ms": 442060,
      "end_ms": 446840,
      "text": "大哥边陲省份分离主义盛行的地区"
    },
    {
      "ordinal": 174,
      "start_ms": 446840,
      "end_ms": 448460,
      "text": "在西方势力"
    },
    {
      "ordinal": 175,
      "start_ms": 448460,
      "end_ms": 450680,
      "text": "或者在某些whatever野心家"
    },
    {
      "ordinal": 176,
      "start_ms": 450680,
      "end_ms": 452730,
      "text": "whatever这些力量的撺掇下"
    },
    {
      "ordinal": 177,
      "start_ms": 452730,
      "end_ms": 454050,
      "text": "是不可能冒出这些东西的"
    },
    {
      "ordinal": 178,
      "start_ms": 454050,
      "end_ms": 456150,
      "text": "冒出来就冒出去干掉一个"
    },
    {
      "ordinal": 179,
      "start_ms": 456150,
      "end_ms": 457410,
      "text": "可以吧"
    },
    {
      "ordinal": 180,
      "start_ms": 457410,
      "end_ms": 459650,
      "text": "没问题吧"
    },
    {
      "ordinal": 181,
      "start_ms": 459930,
      "end_ms": 463360,
      "text": "怎么到你这就有问题了"
    },
    {
      "ordinal": 182,
      "start_ms": 465060,
      "end_ms": 468260,
      "text": "在搞笑曼纳海姆有个好形象"
    },
    {
      "ordinal": 183,
      "start_ms": 468260,
      "end_ms": 471620,
      "text": "是因为后来苏联没有吞并"
    },
    {
      "ordinal": 184,
      "start_ms": 471620,
      "end_ms": 472310,
      "text": "他"
    },
    {
      "ordinal": 185,
      "start_ms": 472310,
      "end_ms": 473950,
      "text": "没有闪"
    },
    {
      "ordinal": 186,
      "start_ms": 474039,
      "end_ms": 475599,
      "text": "没有干脏事儿"
    },
    {
      "ordinal": 187,
      "start_ms": 475599,
      "end_ms": 477039,
      "text": "或者说没有斩钉截铁"
    },
    {
      "ordinal": 188,
      "start_ms": 478179,
      "end_ms": 480219,
      "text": "明白吗"
    },
    {
      "ordinal": 189,
      "start_ms": 483680,
      "end_ms": 487640,
      "text": "我们讨论的不是历史学的问题"
    },
    {
      "ordinal": 190,
      "start_ms": 487640,
      "end_ms": 489020,
      "text": "不是史学的问题"
    },
    {
      "ordinal": 191,
      "start_ms": 489020,
      "end_ms": 491240,
      "text": "我们讨论的是历史和政治的问题"
    },
    {
      "ordinal": 192,
      "start_ms": 491240,
      "end_ms": 492760,
      "text": "是选择的问题"
    },
    {
      "ordinal": 193,
      "start_ms": 492760,
      "end_ms": 494860,
      "text": "是我将来如果将来某一天"
    },
    {
      "ordinal": 194,
      "start_ms": 494860,
      "end_ms": 496600,
      "text": "我要把我头发剃掉去充军"
    },
    {
      "ordinal": 195,
      "start_ms": 496600,
      "end_ms": 499030,
      "text": "我要去参加哪一支队伍的问题"
    },
    {
      "ordinal": 196,
      "start_ms": 499030,
      "end_ms": 502830,
      "text": "我要死在哪一个战场上的问题"
    },
    {
      "ordinal": 197,
      "start_ms": 503590,
      "end_ms": 505500,
      "text": "我和我的支持者"
    },
    {
      "ordinal": 198,
      "start_ms": 505500,
      "end_ms": 508140,
      "text": "关注者要死在哪个战场上的问题"
    },
    {
      "ordinal": 199,
      "start_ms": 508140,
      "end_ms": 511140,
      "text": "要效忠哪一种颜色的问题啊"
    },
    {
      "ordinal": 200,
      "start_ms": 511140,
      "end_ms": 515058,
      "text": "不是个不是个历史学的问题啊"
    },
    {
      "ordinal": 201,
      "start_ms": 515299,
      "end_ms": 516979,
      "text": "明白了"
    },
    {
      "ordinal": 202,
      "start_ms": 516979,
      "end_ms": 520999,
      "text": "这是个历史阵营的选择的问题啊"
    },
    {
      "ordinal": 203,
      "start_ms": 520999,
      "end_ms": 523580,
      "text": "你选择投加入哪个阵营啊"
    },
    {
      "ordinal": 204,
      "start_ms": 523580,
      "end_ms": 526310,
      "text": "朋友你选择加入曼纳海姆"
    },
    {
      "ordinal": 205,
      "start_ms": 526310,
      "end_ms": 527360,
      "text": "用个小立牌"
    },
    {
      "ordinal": 206,
      "start_ms": 527360,
      "end_ms": 530690,
      "text": "然后传一个新的民族认同出来"
    },
    {
      "ordinal": 207,
      "start_ms": 530850,
      "end_ms": 531710,
      "text": "的"
    },
    {
      "ordinal": 208,
      "start_ms": 531710,
      "end_ms": 535790,
      "text": "那你这现在最像曼纳海姆的人是谁呀"
    },
    {
      "ordinal": 209,
      "start_ms": 536320,
      "end_ms": 537600,
      "text": "他应该姓赖吧"
    },
    {
      "ordinal": 210,
      "start_ms": 537600,
      "end_ms": 541860,
      "text": "朋友那就傻跳跳"
    },
    {
      "ordinal": 211,
      "start_ms": 545940,
      "end_ms": 548000,
      "text": "最想成为新的曼纳海姆的人"
    },
    {
      "ordinal": 212,
      "start_ms": 548000,
      "end_ms": 549200,
      "text": "你告诉我是谁"
    },
    {
      "ordinal": 213,
      "start_ms": 549200,
      "end_ms": 549860,
      "text": "在东亚"
    },
    {
      "ordinal": 214,
      "start_ms": 551420,
      "end_ms": 553060,
      "text": "在我国"
    },
    {
      "ordinal": 215,
      "start_ms": 554990,
      "end_ms": 556180,
      "text": "Please tell me"
    },
    {
      "ordinal": 216,
      "start_ms": 556180,
      "end_ms": 558910,
      "text": "最想搞这样一种新的族裔"
    },
    {
      "ordinal": 217,
      "start_ms": 558910,
      "end_ms": 562460,
      "text": "民族认同的传这么一个凝聚啊"
    },
    {
      "ordinal": 218,
      "start_ms": 562460,
      "end_ms": 565390,
      "text": "这么一个凝聚点的是谁啊"
    },
    {
      "ordinal": 219,
      "start_ms": 565790,
      "end_ms": 567190,
      "text": "是赖啊"
    },
    {
      "ordinal": 220,
      "start_ms": 567190,
      "end_ms": 570070,
      "text": "他不该死吗"
    },
    {
      "ordinal": 221,
      "start_ms": 576000,
      "end_ms": 577460,
      "text": "还跟我搁这骂"
    },
    {
      "ordinal": 222,
      "start_ms": 577460,
      "end_ms": 579640,
      "text": "那还他当然是在我眼里"
    },
    {
      "ordinal": 223,
      "start_ms": 579640,
      "end_ms": 580660,
      "text": "他当然是个法西斯"
    },
    {
      "ordinal": 224,
      "start_ms": 580660,
      "end_ms": 582940,
      "text": "如果说他到时候通过这种民族主义叙事"
    },
    {
      "ordinal": 225,
      "start_ms": 582940,
      "end_ms": 583900,
      "text": "煽动底层"
    },
    {
      "ordinal": 226,
      "start_ms": 583900,
      "end_ms": 585310,
      "text": "无视阶级矛盾"
    },
    {
      "ordinal": 227,
      "start_ms": 585310,
      "end_ms": 589740,
      "text": "无视帝国主义对于无产阶级的压迫"
    },
    {
      "ordinal": 228,
      "start_ms": 594540,
      "end_ms": 595820,
      "text": "理解吗"
    },
    {
      "ordinal": 229,
      "start_ms": 595820,
      "end_ms": 596960,
      "text": "懂吗"
    },
    {
      "ordinal": 230,
      "start_ms": 596960,
      "end_ms": 598640,
      "text": "你愿意投靠那个阵营"
    },
    {
      "ordinal": 231,
      "start_ms": 598640,
      "end_ms": 600339,
      "text": "是你的事"
    },
    {
      "ordinal": 232,
      "start_ms": 600679,
      "end_ms": 604740,
      "text": "我们这边叫汉贼不两立好吧"
    },
    {
      "ordinal": 233,
      "start_ms": 609840,
      "end_ms": 612320,
      "text": "大概明白了吧"
    },
    {
      "ordinal": 234,
      "start_ms": 614320,
      "end_ms": 617520,
      "text": "这种人这种人只是时候未到而已"
    },
    {
      "ordinal": 235,
      "start_ms": 617520,
      "end_ms": 620580,
      "text": "到时候就是斩首导弹发过去直接炸死"
    },
    {
      "ordinal": 236,
      "start_ms": 620580,
      "end_ms": 621900,
      "text": "我靠"
    },
    {
      "ordinal": 237,
      "start_ms": 621900,
      "end_ms": 623820,
      "text": "别废话了"
    },
    {
      "ordinal": 238,
      "start_ms": 623820,
      "end_ms": 626820,
      "text": "还真以为他还能给他们一个好下场"
    },
    {
      "ordinal": 239,
      "start_ms": 626820,
      "end_ms": 628860,
      "text": "好结局呢"
    },
    {
      "ordinal": 240,
      "start_ms": 633960,
      "end_ms": 635300,
      "text": "斯大林是仁慈啊"
    },
    {
      "ordinal": 241,
      "start_ms": 635300,
      "end_ms": 637740,
      "text": "我们所以说斯大林很仁慈哎"
    }
  ],
