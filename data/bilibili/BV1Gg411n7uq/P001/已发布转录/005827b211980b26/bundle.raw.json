{"segments":[{"start":0.54,"end":4.77,"text":"这个是是一首老词啊啊啊应该是17年写的啊"},{"start":4.77,"end":6.1,"text":"我们来听一下"},{"start":7.86,"end":8.72,"text":"还是18年"},{"start":8.72,"end":12.18,"text":"我记不得了"},{"start":14.32,"end":16.6,"text":"年少季的遗物呀"},{"start":16.88,"end":21.26,"text":"如此陪你看春花依你"},{"start":21.26,"end":24.38,"text":"谁找到年少记忆的遗物"},{"start":25.94,"end":28.09,"text":"唱歌难诉"},{"start":28.09,"end":31.33,"text":"这四点如露在指尖"},{"start":31.33,"end":34.379,"text":"有被风悄悄清除"},{"start":34.86,"end":39.29,"text":"独自回忆着波光宁静"},{"start":39.29,"end":43.62,"text":"在明媚夏日炫目的痕迹"},{"start":43.84,"end":48.4,"text":"朵朵浪花在心头回荡"},{"start":48.4,"end":52.7,"text":"碎成了片片白色的忧伤"},{"start":52.92,"end":54.56,"text":"在那匆匆离去"},{"start":54.56,"end":56.06,"text":"依稀时光里"},{"start":57.68,"end":61.38,"text":"有谁在风中寄托了期许"},{"start":61.72,"end":69.16,"text":"这摇动的思绪陪伴也不知不觉地回忆着自己"},{"start":72.58,"end":76.62,"text":"无论明天是否能如愿"},{"start":76.62,"end":82.27,"text":"趁着脸颊笑容映在窗前哒哒"},{"start":82.27,"end":86.3,"text":"既然梦依然还在心"},{"start":86.3,"end":89.98,"text":"努力守护心中的小孩"},{"start":108.56,"end":110.86,"text":"这么长吗"},{"start":110.86,"end":112.6,"text":"这个建筑"},{"start":126.6,"end":131.0,"text":"一道走过满街的角落"},{"start":131.0,"end":132.08,"text":"是雨水"},{"start":132.08,"end":135.24,"text":"初次见面的秋季"},{"start":135.58,"end":140.01,"text":"也或许多了温柔气息"},{"start":140.01,"end":143.96,"text":"让整片夕阳融化了孤寂"},{"start":144.6,"end":149.12,"text":"曾落下多少洁白水晶"},{"start":149.12,"end":150.74,"text":"轻吻着寒风"},{"start":150.74,"end":153.32,"text":"吹凉的手心"},{"start":153.6,"end":158.28,"text":"恰似泪滴与温暖相遇"},{"start":158.28,"end":162.42,"text":"不计较冬天无心的恶意"},{"start":162.64,"end":163.86,"text":"握着幸福"},{"start":163.86,"end":165.78,"text":"踌躇彷徨的你"},{"start":167.34,"end":171.36,"text":"已经把幸福装在了怀里"},{"start":171.76,"end":180.5,"text":"这转动的四季回忆也不知不觉地改变了自己"},{"start":182.06,"end":186.46,"text":"无论明天是否是春天"},{"start":186.46,"end":195.47,"text":"随着微风轻轻吹进窗帘啊哈既然梦里可要来"},{"start":195.47,"end":199.58,"text":"让我们一起准备好舞台"}],"source":"subtitle"}
