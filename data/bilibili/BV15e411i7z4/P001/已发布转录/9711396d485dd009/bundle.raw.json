{"segments":[{"start":1.72,"end":3.99,"text":"他是高中生"},{"start":4.63,"end":7.71,"text":"有关反抗前沿的家庭和受教育路径啊"},{"start":7.71,"end":10.47,"text":"它来自于西南某欠发达省份"},{"start":10.47,"end":12.45,"text":"西南某省"},{"start":13.03,"end":16.17,"text":"就读于高二理科班"},{"start":16.17,"end":17.85,"text":"平时成绩中上"},{"start":17.85,"end":21.439,"text":"然后开学哲学比较稳定"},{"start":21.439,"end":22.969,"text":"不是3分钟热度"},{"start":22.969,"end":25.89,"text":"然后先把叔本华读完"},{"start":25.89,"end":27.51,"text":"然后现在学气象学"},{"start":27.51,"end":29.49,"text":"他觉得随便乱读是不对的"},{"start":29.49,"end":34.17,"text":"现在重新回康德那把纯粹统觉读完"},{"start":34.17,"end":36.69,"text":"然后有叔本华的基础"},{"start":36.69,"end":37.92,"text":"觉得康德不太难"},{"start":37.92,"end":39.57,"text":"觉得很好理解"},{"start":39.57,"end":40.62,"text":"不搞见证"},{"start":40.62,"end":41.31,"text":"不魔怔"},{"start":41.31,"end":42.21,"text":"不看网哲"},{"start":42.21,"end":43.35,"text":"不搞小团体"},{"start":43.35,"end":44.91,"text":"平时就老老实实读原著"},{"start":44.91,"end":46.62,"text":"不搞那些虚的家庭情况"},{"start":46.62,"end":49.19,"text":"大自然阶级条件富裕"},{"start":50.21,"end":52.87,"text":"但是钱现在色彩非常浓烈"},{"start":52.87,"end":55.39,"text":"但由于对他上高中了"},{"start":55.39,"end":56.91,"text":"所以对他管理不严"},{"start":56.91,"end":58.68,"text":"他高中在城里"},{"start":58.68,"end":61.05,"text":"家里在城外形成一定物理距离"},{"start":61.05,"end":63.72,"text":"所以他一个人住在城市里面"},{"start":63.72,"end":66.0,"text":"然后干什么都是背着他们干"},{"start":66.0,"end":68.35,"text":"所以在父母面前伪装的不错"},{"start":68.35,"end":69.67,"text":"学哲学什么的"},{"start":69.67,"end":70.51,"text":"他们都不知情"},{"start":70.51,"end":71.77,"text":"以为他是个乖小孩"},{"start":71.77,"end":72.85,"text":"并且完全听从他们"},{"start":72.85,"end":75.27,"text":"然后父母的封建家族观念很重"},{"start":75.27,"end":77.55,"text":"经常将笑之类的挂在嘴边"},{"start":77.55,"end":78.59,"text":"妄图洗脑"},{"start":78.59,"end":80.15,"text":"他会假装配合他们"},{"start":80.15,"end":81.17,"text":"对香火继承"},{"start":81.17,"end":82.43,"text":"生育后代很看重"},{"start":82.43,"end":83.6,"text":"控制欲强"},{"start":83.6,"end":84.83,"text":"他有烂毛病"},{"start":84.83,"end":89.47,"text":"就是说呃他说不不赖体力劳动"},{"start":89.47,"end":90.729,"text":"贪图安逸"},{"start":90.729,"end":92.589,"text":"然后似乎很难改掉"},{"start":92.589,"end":93.789,"text":"然后有必要说"},{"start":93.789,"end":95.949,"text":"从来没有鄙视劳动和劳动者心态啊"},{"start":95.949,"end":96.669,"text":"同时还有一个问题"},{"start":96.669,"end":99.84,"text":"就是如果一门学科啊进入了教育体系"},{"start":99.84,"end":101.04,"text":"就变成强制性的任务"},{"start":101.04,"end":101.82,"text":"变成必修的时候"},{"start":101.82,"end":104.16,"text":"就会降低对这门学科的喜欢"},{"start":104.16,"end":105.6,"text":"甚至产生厌恶"},{"start":105.6,"end":107.04,"text":"就不喜欢必修"},{"start":107.04,"end":108.12,"text":"他喜欢选修"},{"start":109.32,"end":110.94,"text":"他认为他喜欢哲学的原因"},{"start":110.94,"end":114.19,"text":"就是因为啊不用考试啊"},{"start":114.19,"end":115.21,"text":"不是必修"},{"start":115.21,"end":116.29,"text":"那么它的优点"},{"start":116.29,"end":118.06,"text":"他说长期独自生活"},{"start":118.06,"end":119.27,"text":"独立性很强"},{"start":119.27,"end":120.65,"text":"解决能力问题也不错"},{"start":120.65,"end":122.75,"text":"基本生存技能也比同龄人要强"},{"start":122.75,"end":125.81,"text":"但他的想法很厌恶前现代家庭环境"},{"start":125.81,"end":128.169,"text":"想彻底摆脱这种前现代生活"},{"start":128.169,"end":130.33,"text":"他的理想是可以搞学术研究"},{"start":130.33,"end":133.69,"text":"或者至少可以做他喜欢的啦"},{"start":134.56,"end":136.56,"text":"然后不想一辈子打工"},{"start":136.56,"end":139.47,"text":"害怕会使他失去创造的机会"},{"start":139.47,"end":142.87,"text":"然后他没有生育的欲望啊"},{"start":146.38,"end":147.52,"text":"我没有生育的欲望"},{"start":147.52,"end":149.11,"text":"但不代表没有性欲啊"},{"start":149.11,"end":152.52,"text":"然后初步考虑是一个理想"},{"start":152.52,"end":153.42,"text":"是搞学术研究"},{"start":153.42,"end":155.34,"text":"又很讨厌自己的喜欢的科目"},{"start":155.34,"end":156.93,"text":"编程必须完成的任务"},{"start":156.93,"end":160.71,"text":"他就想要又想要就是维持哲学的业余状态"},{"start":160.71,"end":162.09,"text":"不想有人告诉我"},{"start":162.09,"end":163.53,"text":"这是哲学的标准答案"},{"start":163.53,"end":164.85,"text":"考试必须这样写"},{"start":164.85,"end":165.81,"text":"其他想法都是错的"},{"start":165.81,"end":167.67,"text":"也不喜欢在他的论文里面搞什么"},{"start":167.67,"end":168.75,"text":"致谢别人"},{"start":168.75,"end":171.48,"text":"他只想让他创造的东西独属于他自己"},{"start":171.48,"end":172.74,"text":"或者他的朋友"},{"start":172.74,"end":173.79,"text":"而不是老师"},{"start":173.79,"end":174.3,"text":"教授"},{"start":174.3,"end":174.93,"text":"不想学"},{"start":174.93,"end":175.83,"text":"他想要做"},{"start":175.83,"end":179.59,"text":"要做那个就是圣是"},{"start":179.59,"end":183.43,"text":"就是就是他是那种独立觉醒的"},{"start":183.43,"end":184.39,"text":"不要别人教他"},{"start":184.39,"end":185.65,"text":"那你为什要看这些书啊"},{"start":185.65,"end":187.11,"text":"那就明哲了"},{"start":187.11,"end":191.07,"text":"那二他怎么来反抗前沿的家庭呢"},{"start":191.07,"end":192.03,"text":"他喜欢自由的感觉"},{"start":192.03,"end":195.11,"text":"但是和他们多呆一秒都会感到窒息和恶心"},{"start":195.11,"end":197.889,"text":"然后就像所有的日子"},{"start":197.889,"end":199.809,"text":"都不用进入那个前现代家庭的地狱"},{"start":199.809,"end":201.369,"text":"就算是在任何节日"},{"start":201.369,"end":203.229,"text":"我都想一个人待着"},{"start":203.229,"end":207.99,"text":"总之要使我朝着对社会无害化和有利化的方向"},{"start":207.99,"end":209.25,"text":"他的疑惑困惑"},{"start":209.25,"end":210.45,"text":"现在暂时能想到两个方向"},{"start":210.45,"end":212.37,"text":"一直保持内心的初心和激情"},{"start":212.37,"end":214.06,"text":"然后表面上顺从他们"},{"start":214.06,"end":215.08,"text":"顺从家庭啊"},{"start":215.08,"end":217.3,"text":"借此获得搞理想的条件"},{"start":217.3,"end":220.7,"text":"经济条件伪装的期间不会堕落成资本家"},{"start":220.7,"end":221.87,"text":"他不想做资本家"},{"start":221.87,"end":223.7,"text":"而仅仅是远离他们"},{"start":223.7,"end":224.42,"text":"搬离他们啊"},{"start":224.42,"end":225.29,"text":"一个人搞学术"},{"start":225.29,"end":228.329,"text":"并且经济全部由这些人提供"},{"start":228.329,"end":229.889,"text":"不要啃他父母的老"},{"start":229.889,"end":232.349,"text":"死了之后还可以继承他们的遗产房"},{"start":232.349,"end":234.809,"text":"到时候就可以斩断他们的资本链条"},{"start":234.809,"end":237.51,"text":"让他们资本不要再祸害人了"},{"start":239.77,"end":241.95,"text":"然后继续为社会贡献一些价值"},{"start":241.95,"end":243.8,"text":"二是借助大学这跳板"},{"start":243.8,"end":245.12,"text":"毕业后直接远走高飞"},{"start":245.12,"end":246.14,"text":"彻底跟他们决裂"},{"start":246.14,"end":248.06,"text":"然后在外省打工一段时间"},{"start":248.06,"end":249.59,"text":"积累一定生活所需的钱"},{"start":249.59,"end":251.24,"text":"跑到偏远地区"},{"start":251.24,"end":253.31,"text":"比如什么什么"},{"start":253.31,"end":257.57,"text":"然后去搞自己热爱的就是学哲学"},{"start":257.625,"end":259.25,"text":"他就想就说"},{"start":259.25,"end":261.149,"text":"反正反正弄弄呃"},{"start":261.149,"end":263.31,"text":"一个就是弄骗"},{"start":263.31,"end":264.21,"text":"有两种方法"},{"start":264.21,"end":264.99,"text":"一个远走高飞"},{"start":264.99,"end":265.71,"text":"一个就是骗嘛"},{"start":265.71,"end":267.15,"text":"骗家里人弄到钱"},{"start":267.15,"end":270.32,"text":"要么就是考大学获得自由"},{"start":270.32,"end":273.35,"text":"以上是他如何摆脱前现代家庭的问题"},{"start":273.35,"end":274.67,"text":"不论怎么选"},{"start":274.67,"end":276.59,"text":"近期都有一个问题摆在面前"},{"start":276.59,"end":278.81,"text":"就是未来大学教育路线的问题"},{"start":278.81,"end":281.06,"text":"现在最大的意向是学哲学"},{"start":281.06,"end":283.13,"text":"但正如他在初步考虑那样"},{"start":283.13,"end":286.6,"text":"他害怕到了GP之后产生了被骗了的感觉"},{"start":286.6,"end":289.06,"text":"那我对大学及以上的教育就完全不了解的"},{"start":289.06,"end":290.14,"text":"所以我的困惑就是说"},{"start":290.14,"end":293.08,"text":"我是否本科就应该选哲学系"},{"start":293.08,"end":296.28,"text":"未来研究生博士是不是还要读"},{"start":296.28,"end":298.02,"text":"可不可以选个理工科"},{"start":298.02,"end":302.02,"text":"然后使我上面的第二种计划就远走高飞啊"},{"start":302.02,"end":303.4,"text":"就是说选个理工科"},{"start":303.4,"end":306.28,"text":"他这个第二种计划就是念大学有跳板了"},{"start":306.28,"end":308.28,"text":"可以去其他城市工作了"},{"start":308.28,"end":310.38,"text":"就那边做自己热爱的了"},{"start":310.38,"end":311.28,"text":"积累资金时"},{"start":311.28,"end":312.54,"text":"就用我本科的方向"},{"start":312.54,"end":314.919,"text":"就也同时是哲学的学习和研究"},{"start":314.919,"end":317.139,"text":"完全独立于我国教育体制等等"},{"start":317.139,"end":318.279,"text":"这就是困扰他"},{"start":318.279,"end":321.539,"text":"就是这个东西"},{"start":324.16,"end":327.12,"text":"这个东西老说挺自私的"},{"start":327.12,"end":331.36,"text":"我说你这就哲学变成了一个自信游戏好玩"},{"start":331.36,"end":333.1,"text":"但你哲学有何意义呢"},{"start":333.1,"end":334.93,"text":"你就玩这个哲学玩一辈子了"},{"start":334.93,"end":335.83,"text":"没有任何意义啊"},{"start":335.83,"end":340.66,"text":"那你这那你这个哲学和这个游戏机里面"},{"start":340.66,"end":343.81,"text":"哪个游戏卡带不是一样吗"},{"start":343.97,"end":345.79,"text":"你的哲学没有意义啊"},{"start":345.79,"end":348.03,"text":"你的哲学不是哲学啊"},{"start":348.03,"end":351.57,"text":"就是我都说连连统治集团的哲学"},{"start":351.57,"end":352.53,"text":"当我说哲学的时候"},{"start":352.53,"end":353.94,"text":"就是统治集团的统治"},{"start":353.94,"end":356.7,"text":"统治术的抽象版本"},{"start":357.04,"end":359.13,"text":"统治集团统治术的抽象版本"},{"start":359.13,"end":360.18,"text":"当我们说哲学的时候"},{"start":360.18,"end":361.68,"text":"就哲学的实质就是这个啊"},{"start":363.66,"end":369.74,"text":"然后那个哲学的反面是就是革命理论"},{"start":369.74,"end":370.58,"text":"革命理论"},{"start":370.58,"end":371.48,"text":"斗争理论"},{"start":371.48,"end":375.8,"text":"解放理论就是就是马克思主义列宁主义的革命"},{"start":375.8,"end":377.66,"text":"解放的他的那个理论"},{"start":381.829,"end":384.909,"text":"这哲学的反面哲学是统治集团"},{"start":384.909,"end":388.57,"text":"统治术以及统治体系以及整个共同体"},{"start":388.57,"end":392.92,"text":"对于他的统治模式的想象认知的一个抽象版本"},{"start":392.92,"end":396.2,"text":"一个神学版本或者一个宇宙学版本"},{"start":396.48,"end":400.5,"text":"一个就是理念性的版本"},{"start":401.08,"end":403.08,"text":"就是哲学好玩是吧"},{"start":403.08,"end":407.13,"text":"那么我的建议就是说呃你想把自己解放出来"},{"start":407.13,"end":409.26,"text":"从这个大自然阶级家庭"},{"start":409.26,"end":412.65,"text":"但是又是个前现代大自然阶级当中解放出来"},{"start":412.65,"end":415.08,"text":"这个是可以理解的"},{"start":415.08,"end":417.25,"text":"我们可以理解这种欲望"},{"start":417.61,"end":418.96,"text":"可以理解这种欲望"},{"start":418.96,"end":421.21,"text":"也也这也某种"},{"start":421.21,"end":425.539,"text":"要鼓励青年从这种东西里面解放出来啊"},{"start":425.539,"end":428.359,"text":"上一个给我昨天给我写信的"},{"start":428.359,"end":430.039,"text":"昨天我读的那封信的那个"},{"start":430.039,"end":432.88,"text":"他是家里面就有个爹啊"},{"start":432.88,"end":433.36,"text":"是这样"},{"start":433.36,"end":434.92,"text":"你可能一个家族都是这样"},{"start":434.92,"end":435.88,"text":"那你可能搞不定了"},{"start":435.88,"end":436.96,"text":"家里面只有一个爹的话"},{"start":436.96,"end":438.82,"text":"那就把这个爹当练功机器人"},{"start":438.82,"end":439.81,"text":"天天跟他对线"},{"start":439.81,"end":441.47,"text":"可以把他对得过的"},{"start":441.47,"end":444.71,"text":"然后你又是如果你是个大家族里面"},{"start":444.71,"end":446.63,"text":"你可能就这整个环境压迫"},{"start":446.63,"end":448.48,"text":"你搞不定"},{"start":449.36,"end":452.38,"text":"但是实际上在我的感觉里面就说我操"},{"start":452.38,"end":453.62,"text":"你学了哲学了"},{"start":453.62,"end":454.34,"text":"学了哲学"},{"start":454.34,"end":455.99,"text":"对于什么道德伦理"},{"start":455.99,"end":457.7,"text":"对于什么财产关系"},{"start":457.7,"end":459.44,"text":"对于什么这些乱七八糟的东西"},{"start":459.44,"end":462.28,"text":"你应该是非常熟练的啊"},{"start":462.28,"end":465.04,"text":"非常善于去操纵"},{"start":465.04,"end":466.21,"text":"非常善于去"},{"start":466.21,"end":468.31,"text":"你这个瞬间变成少家主"},{"start":468.31,"end":468.73,"text":"你懂吗"},{"start":468.73,"end":469.87,"text":"你妈了个巴子"},{"start":469.87,"end":471.16,"text":"瞬间变成少家主"},{"start":471.16,"end":472.51,"text":"把你捏的死死的"},{"start":472.51,"end":474.619,"text":"把你这个什么爹妈呀"},{"start":474.619,"end":475.639,"text":"什么这种捏的死死的"},{"start":475.639,"end":477.859,"text":"把他们控制的牵线木偶一样的"},{"start":479.67,"end":480.51,"text":"但是做不到呀"},{"start":480.51,"end":481.29,"text":"做不到也做不到"},{"start":481.29,"end":482.67,"text":"做不到就做不到呀"},{"start":482.67,"end":484.52,"text":"这个事你是个务实的"},{"start":484.52,"end":488.42,"text":"务实的一个追求自己的个人解放的一个人"},{"start":488.42,"end":490.55,"text":"做不到做不到就这样偷他们钱"},{"start":490.55,"end":492.68,"text":"然后在他们面前伪装伪装个屁"},{"start":492.68,"end":496.12,"text":"我靠有的时候当时伪装个毛啊"},{"start":496.12,"end":497.56,"text":"装个屁啊"},{"start":497.56,"end":498.61,"text":"拐撞撞"},{"start":498.61,"end":499.72,"text":"多拿几毛钱"},{"start":499.72,"end":502.299,"text":"怎样装都不装"},{"start":502.299,"end":504.039,"text":"你知道吗"},{"start":505.58,"end":507.76,"text":"我师兄里装有什么好装啊"},{"start":507.76,"end":509.05,"text":"装超级吵闹"},{"start":509.05,"end":510.04,"text":"但他放屁好了"},{"start":510.04,"end":512.87,"text":"真的是我一直是这样想的"},{"start":512.87,"end":515.659,"text":"他如果是前一代家庭那边的家长"},{"start":515.659,"end":517.308,"text":"他能把你打你啊"},{"start":517.308,"end":518.599,"text":"把你锁起来"},{"start":518.599,"end":520.159,"text":"把你腿砍了"},{"start":520.159,"end":522.4,"text":"把眼睛给刺瞎"},{"start":522.4,"end":523.9,"text":"现代公民权"},{"start":523.9,"end":525.04,"text":"他不能这样对你的"},{"start":525.04,"end":525.52,"text":"是不是"},{"start":525.52,"end":527.26,"text":"那如果说真的能把你关起来"},{"start":527.26,"end":528.04,"text":"能不能抓起来"},{"start":528.04,"end":529.42,"text":"能够把扭送精神病院"},{"start":529.42,"end":530.44,"text":"那你就离他远远的"},{"start":530.44,"end":531.44,"text":"对不对"},{"start":531.44,"end":534.62,"text":"那你说你越要享受他们好处"},{"start":534.62,"end":537.92,"text":"在他面前表现的顺从好点钱"},{"start":538.68,"end":540.38,"text":"又又又要这样的话"},{"start":540.38,"end":542.18,"text":"那你可能就是得不到自由呀"},{"start":542.18,"end":543.8,"text":"对不对"},{"start":545.26,"end":546.72,"text":"你得不到你的自由"},{"start":546.72,"end":549.15,"text":"如果你如果说你真的能够"},{"start":549.15,"end":551.22,"text":"就是说在他们面前装都不用装"},{"start":551.22,"end":552.579,"text":"吊儿郎当的"},{"start":552.579,"end":553.689,"text":"有什么样的"},{"start":553.689,"end":557.199,"text":"你妈的老鬼就叫叫叫叫有用叫有用"},{"start":557.199,"end":560.53,"text":"你就可以在旁边挑衅性的气的高血压"},{"start":560.53,"end":562.33,"text":"他又不能把你怎么样"},{"start":562.33,"end":565.5,"text":"就说这个要看你对面的敌人有多恶"},{"start":565.5,"end":566.64,"text":"他如果很邪恶"},{"start":566.64,"end":567.66,"text":"真的能把你逮起来"},{"start":567.66,"end":569.46,"text":"卧槽给你搞个精神病证明"},{"start":569.46,"end":572.089,"text":"让的去做精神病的牢"},{"start":572.089,"end":573.409,"text":"你哦"},{"start":573.409,"end":575.929,"text":"老子他妈的只能躲得远远的是吧"},{"start":575.929,"end":576.769,"text":"那你真牛逼"},{"start":576.769,"end":577.189,"text":"你厉害"},{"start":577.189,"end":578.389,"text":"你吊我干不过"},{"start":578.389,"end":581.01,"text":"你要看你爹妈是不是还是不是"},{"start":581.01,"end":582.87,"text":"对你这个小孩还是有良心"},{"start":582.87,"end":583.35,"text":"对不对"},{"start":583.35,"end":584.31,"text":"你自己去判断吧"},{"start":584.31,"end":585.3,"text":"我不能判断的"},{"start":585.3,"end":587.28,"text":"如果你爹妈对你这个小孩还有良心"},{"start":587.28,"end":591.85,"text":"他不会说用很恶恶毒的手段把他捆起来啊"},{"start":591.85,"end":593.47,"text":"把你腿打断"},{"start":593.47,"end":594.67,"t