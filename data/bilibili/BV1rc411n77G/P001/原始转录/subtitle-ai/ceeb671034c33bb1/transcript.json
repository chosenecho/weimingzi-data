  "content_sha256": "ceeb671034c33bb1a1b6d825111f179845f3d5a18abdfd5a311945851887a19c",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 0,
      "end_ms": 3280,
      "text": "我今天要讲的叫做呃"
    },
    {
      "ordinal": 1,
      "start_ms": 7220,
      "end_ms": 8140,
      "text": "八个字"
    },
    {
      "ordinal": 2,
      "start_ms": 10300,
      "end_ms": 11300,
      "text": "八个字"
    },
    {
      "ordinal": 3,
      "start_ms": 12880,
      "end_ms": 15870,
      "text": "或者说16个字"
    },
    {
      "ordinal": 4,
      "start_ms": 15870,
      "end_ms": 17240,
      "text": "16个字"
    },
    {
      "ordinal": 5,
      "start_ms": 20300,
      "end_ms": 24680,
      "text": "就是当然这个你们可以会说我非常保守了"
    },
    {
      "ordinal": 6,
      "start_ms": 25760,
      "end_ms": 27340,
      "text": "这个16个字说出来"
    },
    {
      "ordinal": 7,
      "start_ms": 33820,
      "end_ms": 34800,
      "text": "刘总"
    },
    {
      "ordinal": 8,
      "start_ms": 36740,
      "end_ms": 38540,
      "text": "不要违法犯罪"
    },
    {
      "ordinal": 9,
      "start_ms": 44860,
      "end_ms": 45660,
      "text": "务必"
    },
    {
      "ordinal": 10,
      "start_ms": 48120,
      "end_ms": 50140,
      "text": "刻苦耐劳啊"
    },
    {
      "ordinal": 11,
      "start_ms": 58880,
      "end_ms": 63780,
      "text": "应该这个老哈不要违法犯罪"
    },
    {
      "ordinal": 12,
      "start_ms": 63780,
      "end_ms": 65500,
      "text": "务必刻苦耐劳"
    },
    {
      "ordinal": 13,
      "start_ms": 66620,
      "end_ms": 72700,
      "text": "这这两你们就会说我是最保守的啊"
    },
    {
      "ordinal": 14,
      "start_ms": 74580,
      "end_ms": 76460,
      "text": "啊最温和的"
    },
    {
      "ordinal": 15,
      "start_ms": 76460,
      "end_ms": 79440,
      "text": "但是我要讲的他各有反面人物"
    },
    {
      "ordinal": 16,
      "start_ms": 79820,
      "end_ms": 81200,
      "text": "不要违法犯罪"
    },
    {
      "ordinal": 17,
      "start_ms": 81200,
      "end_ms": 82800,
      "text": "反面人物张士诚"
    },
    {
      "ordinal": 18,
      "start_ms": 84420,
      "end_ms": 85880,
      "text": "务必刻苦耐劳"
    },
    {
      "ordinal": 19,
      "start_ms": 87860,
      "end_ms": 89000,
      "text": "朱元璋"
    },
    {
      "ordinal": 20,
      "start_ms": 91080,
      "end_ms": 93500,
      "text": "两个舞王啊"
    },
    {
      "ordinal": 21,
      "start_ms": 93500,
      "end_ms": 94280,
      "text": "都是吴王"
    },
    {
      "ordinal": 22,
      "start_ms": 97280,
      "end_ms": 98360,
      "text": "野心特大"
    },
    {
      "ordinal": 23,
      "start_ms": 99860,
      "end_ms": 103850,
      "text": "然后啊袁婷给他招安"
    },
    {
      "ordinal": 24,
      "start_ms": 103850,
      "end_ms": 105320,
      "text": "他稍微缓和一些"
    },
    {
      "ordinal": 25,
      "start_ms": 105320,
      "end_ms": 106700,
      "text": "继续称吴王"
    },
    {
      "ordinal": 26,
      "start_ms": 107220,
      "end_ms": 114140,
      "text": "朱元璋呢是啊淡定优势相对"
    },
    {
      "ordinal": 27,
      "start_ms": 114140,
      "end_ms": 115340,
      "text": "张士诚啊"
    },
    {
      "ordinal": 28,
      "start_ms": 115340,
      "end_ms": 122450,
      "text": "那高筑城广积粮缓称王"
    },
    {
      "ordinal": 29,
      "start_ms": 122450,
      "end_ms": 124360,
      "text": "他一直称的是吴国公"
    },
    {
      "ordinal": 30,
      "start_ms": 125640,
      "end_ms": 126920,
      "text": "成国公而已"
    },
    {
      "ordinal": 31,
      "start_ms": 128180,
      "end_ms": 129720,
      "text": "后来是称了武王"
    },
    {
      "ordinal": 32,
      "start_ms": 130220,
      "end_ms": 132470,
      "text": "然后很久一段时间都没有沉底"
    },
    {
      "ordinal": 33,
      "start_ms": 135580,
      "end_ms": 137340,
      "text": "那我们说不要违法犯罪"
    },
    {
      "ordinal": 34,
      "start_ms": 137340,
      "end_ms": 138930,
      "text": "务必刻苦耐劳"
    },
    {
      "ordinal": 35,
      "start_ms": 138930,
      "end_ms": 142280,
      "text": "就指的是作为行动者团体"
    },
    {
      "ordinal": 36,
      "start_ms": 148930,
      "end_ms": 150760,
      "text": "张士诚的严范的习气"
    },
    {
      "ordinal": 37,
      "start_ms": 150760,
      "end_ms": 151840,
      "text": "什么习气啊"
    },
    {
      "ordinal": 38,
      "start_ms": 155399,
      "end_ms": 157999,
      "text": "用违法犯罪赚人上山啊"
    },
    {
      "ordinal": 39,
      "start_ms": 159079,
      "end_ms": 160380,
      "text": "赚人上山"
    },
    {
      "ordinal": 40,
      "start_ms": 161240,
      "end_ms": 163870,
      "text": "违法犯罪手脏了"
    },
    {
      "ordinal": 41,
      "start_ms": 163870,
      "end_ms": 165100,
      "text": "他自己本人是个嫌犯"
    },
    {
      "ordinal": 42,
      "start_ms": 165100,
      "end_ms": 166840,
      "text": "也是因为违法犯罪嘛"
    },
    {
      "ordinal": 43,
      "start_ms": 166840,
      "end_ms": 172740,
      "text": "不得不马他这种不得不是一个因为犯罪杀人了"
    },
    {
      "ordinal": 44,
      "start_ms": 172740,
      "end_ms": 174300,
      "text": "不得不手脏了"
    },
    {
      "ordinal": 45,
      "start_ms": 174300,
      "end_ms": 175140,
      "text": "不得不"
    },
    {
      "ordinal": 46,
      "start_ms": 175140,
      "end_ms": 179160,
      "text": "所以等到他稍微符合点历史运动的趋势"
    },
    {
      "ordinal": 47,
      "start_ms": 179160,
      "end_ms": 181060,
      "text": "很快就腐化堕落"
    },
    {
      "ordinal": 48,
      "start_ms": 181660,
      "end_ms": 183580,
      "text": "它本身这个投机性极重"
    },
    {
      "ordinal": 49,
      "start_ms": 184960,
      "end_ms": 186300,
      "text": "投机性极重"
    },
    {
      "ordinal": 50,
      "start_ms": 187179,
      "end_ms": 191520,
      "text": "然后他在决策的时候往往非常荒废"
    },
    {
      "ordinal": 51,
      "start_ms": 192540,
      "end_ms": 195179,
      "text": "不实事求是啊"
    },
    {
      "ordinal": 52,
      "start_ms": 195179,
      "end_ms": 198479,
      "text": "容易腐化堕落啊"
    },
    {
      "ordinal": 53,
      "start_ms": 198479,
      "end_ms": 200900,
      "text": "急于求成啊"
    },
    {
      "ordinal": 54,
      "start_ms": 203300,
      "end_ms": 204980,
      "text": "啊急于求成"
    },
    {
      "ordinal": 55,
      "start_ms": 209300,
      "end_ms": 211390,
      "text": "虚荣啊"
    },
    {
      "ordinal": 56,
      "start_ms": 213040,
      "end_ms": 216119,
      "text": "而且投机性极重啊"
    },
    {
      "ordinal": 57,
      "start_ms": 216119,
      "end_ms": 217079,
      "text": "投机性太强"
    },
    {
      "ordinal": 58,
      "start_ms": 217079,
      "end_ms": 219200,
      "text": "投机性极重啊"
    },
    {
      "ordinal": 59,
      "start_ms": 219200,
      "end_ms": 223110,
      "text": "他的决策因为他不是逼到没办法的"
    },
    {
      "ordinal": 60,
      "start_ms": 223110,
      "end_ms": 225690,
      "text": "也就是说这个张士诚这些人呢"
    },
    {
      "ordinal": 61,
      "start_ms": 225690,
      "end_ms": 227280,
      "text": "他不是逼到没办法"
    },
    {
      "ordinal": 62,
      "start_ms": 227280,
      "end_ms": 230559,
      "text": "真的走投无路了啊"
    },
    {
      "ordinal": 63,
      "start_ms": 230559,
      "end_ms": 235089,
      "text": "那朱元璋呢啊朱元璋是农民起义领袖"
    },
    {
      "ordinal": 64,
      "start_ms": 235089,
      "end_ms": 239359,
      "text": "他是在元廷的腐败统治之下"
    },
    {
      "ordinal": 65,
      "start_ms": 239359,
      "end_ms": 242200,
      "text": "是可以说是穷尽一切"
    },
    {
      "ordinal": 66,
      "start_ms": 242860,
      "end_ms": 245910,
      "text": "穷尽一切啊"
    },
    {
      "ordinal": 67,
      "start_ms": 245910,
      "end_ms": 247520,
      "text": "合法方式了"
    },
    {
      "ordinal": 68,
      "start_ms": 247839,
      "end_ms": 249759,
      "text": "穷尽一切合法方式的追求"
    },
    {
      "ordinal": 69,
      "start_ms": 249759,
      "end_ms": 253560,
      "text": "只是吃饱就不饿死活下来"
    },
    {
      "ordinal": 70,
      "start_ms": 254279,
      "end_ms": 256039,
      "text": "等到他最终走投无路"
    },
    {
      "ordinal": 71,
      "start_ms": 256039,
      "end_ms": 257659,
      "text": "没路可走的时候"
    },
    {
      "ordinal": 72,
      "start_ms": 257659,
      "end_ms": 260478,
      "text": "那个时候you understand"
    },
    {
      "ordinal": 73,
      "start_ms": 260478,
      "end_ms": 262819,
      "text": "它代表的是一个历史大潮流"
    },
    {
      "ordinal": 74,
      "start_ms": 262819,
      "end_ms": 263599,
      "text": "大趋势"
    },
    {
      "ordinal": 75,
      "start_ms": 263599,
      "end_ms": 266060,
      "text": "这个最根底的那个力量"
    },
    {
      "ordinal": 76,
      "start_ms": 266180,
      "end_ms": 267680,
      "text": "所以说我们看朱元璋"
    },
    {
      "ordinal": 77,
      "start_ms": 267680,
      "end_ms": 271319,
      "text": "在在包括在军事对垒的时候啊"
    },
    {
      "ordinal": 78,
      "start_ms": 271319,
      "end_ms": 275459,
      "text": "他跟那个陈友谅打鄱阳湖海大战的时候"
    },
    {
      "ordinal": 79,
      "start_ms": 275459,
      "end_ms": 276599,
      "text": "不是海战"
    },
    {
      "ordinal": 80,
      "start_ms": 276599,
      "end_ms": 278160,
      "text": "水战的时候"
    },
    {
      "ordinal": 81,
      "start_ms": 278659,
      "end_ms": 281960,
      "text": "就是说他的力量是很巧"
    },
    {
      "ordinal": 82,
      "start_ms": 281960,
      "end_ms": 283160,
      "text": "但是他下决心啊"
    },
    {
      "ordinal": 83,
      "start_ms": 283160,
      "end_ms": 284360,
      "text": "因为他没路可走"
    },
    {
      "ordinal": 84,
      "start_ms": 284360,
      "end_ms": 285140,
      "text": "你知道吗"
    },
    {
      "ordinal": 85,
      "start_ms": 285140,
      "end_ms": 286910,
      "text": "因为他背后无路可走"
    },
    {
      "ordinal": 86,
      "start_ms": 286910,
      "end_ms": 288800,
      "text": "他能够下决断"
    },
    {
      "ordinal": 87,
      "start_ms": 288880,
      "end_ms": 293320,
      "text": "能够在千钧一发就是角色窗口期特别能够把握"
    },
    {
      "ordinal": 88,
      "start_ms": 293320,
      "end_ms": 297760,
      "text": "因为这是可以说是类似于求活性质的"
    },
    {
      "ordinal": 89,
      "start_ms": 298280,
      "end_ms": 302040,
      "text": "它不是求贵明白吗"
    },
    {
      "ordinal": 90,
      "start_ms": 302960,
      "end_ms": 304420,
      "text": "张士诚之类的人"
    },
    {
      "ordinal": 91,
      "start_ms": 304420,
      "end_ms": 305580,
      "text": "他叫裘贵"
    },
    {
      "ordinal": 92,
      "start_ms": 306259,
      "end_ms": 310119,
      "text": "而朱元璋所代表的是千千万万的被压迫者"
    },
    {
      "ordinal": 93,
      "start_ms": 310119,
      "end_ms": 313180,
      "text": "他的求活的意志啊"
    },
    {
      "ordinal": 94,
      "start_ms": 313180,
      "end_ms": 314170,
      "text": "求活的一致"
    },
    {
      "ordinal": 95,
      "start_ms": 314170,
      "end_ms": 316380,
      "text": "所以他的角色会更为灵敏"
    },
    {
      "ordinal": 96,
      "start_ms": 317160,
      "end_ms": 318260,
      "text": "嗯更为"
    },
    {
      "ordinal": 97,
      "start_ms": 318260,
      "end_ms": 320420,
      "text": "但是也同时更为慎重"
    },
    {
      "ordinal": 98,
      "start_ms": 320420,
      "end_ms": 321980,
      "text": "但是在无路可走的时候"
    },
    {
      "ordinal": 99,
      "start_ms": 321980,
      "end_ms": 323810,
      "text": "他不计较个人得失"
    },
    {
      "ordinal": 100,
      "start_ms": 323810,
      "end_ms": 325820,
      "text": "不计较个人得失"
    },
    {
      "ordinal": 101,
      "start_ms": 326240,
      "end_ms": 328280,
      "text": "不计较个人得失"
    },
    {
      "ordinal": 102,
      "start_ms": 329960,
      "end_ms": 332980,
      "text": "也就是说他的决心和意志是超个人的"
    },
    {
      "ordinal": 103,
      "start_ms": 332980,
      "end_ms": 334800,
      "text": "其决心和意志"
    },
    {
      "ordinal": 104,
      "start_ms": 334800,
      "end_ms": 336900,
      "text": "他的决心和意志是超越个人的"
    },
    {
      "ordinal": 105,
      "start_ms": 336900,
      "end_ms": 338160,
      "text": "是一个阶级意志的人"
    },
    {
      "ordinal": 106,
      "start_ms": 338160,
      "end_ms": 341200,
      "text": "是一整个被压迫阶级意志的体现"
    },
    {
      "ordinal": 107,
      "start_ms": 346120,
      "end_ms": 347430,
      "text": "举个他不愿乎"
    },
    {
      "ordinal": 108,
      "start_ms": 347430,
      "end_ms": 351030,
      "text": "就是那种下决心那样去拼死一搏的时候"
    },
    {
      "ordinal": 109,
      "start_ms": 351030,
      "end_ms": 352200,
      "text": "他是超越他个人"
    },
    {
      "ordinal": 110,
      "start_ms": 352200,
      "end_ms": 354030,
      "text": "因为他觉得我不这样"
    },
    {
      "ordinal": 111,
      "start_ms": 354030,
      "end_ms": 357030,
      "text": "我所代表的那个阶层阶级的利益"
    },
    {
      "ordinal": 112,
      "start_ms": 357030,
      "end_ms": 358230,
      "text": "我不这样去舒张"
    },
    {
      "ordinal": 113,
      "start_ms": 358230,
      "end_ms": 360190,
      "text": "不这样去呃"
    },
    {
      "ordinal": 114,
      "start_ms": 360190,
      "end_ms": 361680,
      "text": "奋死一搏的话"
    },
    {
      "ordinal": 115,
      "start_ms": 363259,
      "end_ms": 365319,
      "text": "这个整个世界是不公道的"
    },
    {
      "ordinal": 116,
      "start_ms": 365319,
      "end_ms": 367360,
      "text": "或者说我宁愿我死"
    },
    {
      "ordinal": 117,
      "start_ms": 367360,
      "end_ms": 370720,
      "text": "我要证明我们我们这个阶级的这种意志"
    },
    {
      "ordinal": 118,
      "start_ms": 370720,
      "end_ms": 372810,
      "text": "这种决心是绝对的"
    },
    {
      "ordinal": 119,
      "start_ms": 372810,
      "end_ms": 374430,
      "text": "也就是他的意志和决心"
    },
    {
      "ordinal": 120,
      "start_ms": 374430,
      "end_ms": 376050,
      "text": "是具有一种现实的绝对性"
    },
    {
      "ordinal": 121,
      "start_ms": 376050,
      "end_ms": 379320,
      "text": "所以我觉得具有一种绝对性"
    },
    {
      "ordinal": 122,
      "start_ms": 381600,
      "end_ms": 383300,
      "text": "明白绝对的意志"
    },
    {
      "ordinal": 123,
      "start_ms": 383300,
      "end_ms": 383840,
      "text": "绝对解析"
    },
    {
      "ordinal": 124,
      "start_ms": 383840,
      "end_ms": 386870,
      "text": "他的团队也会绝对的服从啊"
    },
    {
      "ordinal": 125,
      "start_ms": 386870,
      "end_ms": 387920,
      "text": "也就是这样"
    },
    {
      "ordinal": 126,
      "start_ms": 387920,
      "end_ms": 390540,
      "text": "他的意志力是极强的啊"
    },
    {
      "ordinal": 127,
      "start_ms": 390960,
      "end_ms": 394320,
      "text": "那么在历史的筛选过程当中"
    },
    {
      "ordinal": 128,
      "start_ms": 394320,
      "end_ms": 396360,
      "text": "淘汰过程当中啊"
    },
    {
      "ordinal": 129,
      "start_ms": 396360,
      "end_ms": 398460,
      "text": "当然有千千万个朱元璋"
    },
    {
      "ordinal": 130,
      "start_ms": 398460,
      "end_ms": 400140,
      "text": "有千千万万住院"
    },
    {
      "ordinal": 131,
      "start_ms": 400140,
      "end_ms": 401250,
      "text": "所以我们说了"
    },
    {
      "ordinal": 132,
      "start_ms": 401250,
      "end_ms": 403440,
      "text": "不要违法犯罪必啊"
    },
    {
      "ordinal": 133,
      "start_ms": 403440,
      "end_ms": 405480,
      "text": "务必刻苦耐劳"
    },
    {
      "ordinal": 134,
      "start_ms": 405480,
      "end_ms": 406860,
      "text": "是这个意思"
    },
    {
      "ordinal": 135,
      "start_ms": 407099,
      "end_ms": 408539,
      "text": "当然你看标题的话"
    },
    {
      "ordinal": 136,
      "start_ms": 408539,
      "end_ms": 409859,
      "text": "你会觉得不要违法犯罪"
    },
    {
      "ordinal": 137,
      "start_ms": 409859,
      "end_ms": 410639,
      "text": "务必刻苦耐劳"
    },
    {
      "ordinal": 138,
      "start_ms": 410639,
      "end_ms": 412480,
      "text": "你会觉得我非常保守"
    },
    {
      "ordinal": 139,
      "start_ms": 412480,
      "end_ms": 414160,
      "text": "当然我也觉得我是很保守的"
    },
    {
      "ordinal": 140,
      "start_ms": 414160,
      "end_ms": 414940,
      "text": "我是最保守的"
    },
    {
      "ordinal": 141,
      "start_ms": 414940,
      "end_ms": 416020,
      "text": "我全天下最保守的"
    },
    {
      "ordinal": 142,
      "start_ms": 416020,
      "end_ms": 417040,
      "text": "不要违法犯罪"
    },
    {
      "ordinal": 143,
      "start_ms": 417040,
      "end_ms": 418520,
      "text": "不要给张士诚"
    },
    {
      "ordinal": 144,
      "start_ms": 418820,
      "end_ms": 420710,
      "text": "务必刻苦耐劳"
    },
    {
      "ordinal": 145,
      "start_ms": 420710,
      "end_ms": 424250,
      "text": "那我们现在社会不会说像元廷那样"
    },
    {
      "ordinal": 146,
      "start_ms": 424250,
      "end_ms": 426020,
      "text": "元代那个时代一样"
    },
    {
      "ordinal": 147,
      "start_ms": 426020,
      "end_ms": 427420,
      "text": "你那样都要饿死了"
    },
    {
      "ordinal": 148,
      "start_ms": 427780,
      "end_ms": 430600,
      "text": "所以啊我叫你做朱元璋"
    },
    {
      "ordinal": 149,
      "start_ms": 430600,
      "end_ms": 435940,
      "text": "不是说叫你啊在一个元朝那样就起兵造反啊"
    },
    {
      "ordinal": 150,
      "start_ms": 435940,
      "end_ms": 440140,
      "text": "啊原朱元璋他是没办法无路可走"
    },
    {
      "ordinal": 151,
      "start_ms": 440140,
      "end_ms": 442180,
      "text": "他投军的啊"
    },
    {
      "ordinal": 152,
      "start_ms": 442180,
      "end_ms": 444640,
      "text": "而且投靠的是正义的起义军嘛"
    },
    {
      "ordinal": 153,
      "start_ms": 445880,
      "end_ms": 447220,
      "text": "我们在这个时代"
    },
    {
      "ordinal": 154,
      "start_ms": 447220,
      "end_ms": 449780,
      "text": "所以说我们要的公益团队"
    },
    {
      "ordinal": 155,
      "start_ms": 450579,
      "end_ms": 453220,
      "text": "公益团体啊"
    },
    {
      "ordinal": 156,
      "start_ms": 454079,
      "end_ms": 457639,
      "text": "不能涉嫌违法犯罪啊"
    },
    {
      "ordinal": 157,
      "start_ms": 457639,
      "end_ms": 459559,
      "text": "不做违法犯罪的事情"
    },
    {
      "ordinal": 158,
      "start_ms": 459559,
      "end_ms": 462100,
      "text": "因为它会让你的投机性上升"
    },
    {
      "ordinal": 159,
      "start_ms": 464180,
      "end_ms": 467500,
      "text": "啊上升明白"
    },
    {
      "ordinal": 160,
      "start_ms": 467500,
      "end_ms": 472780,
      "text": "但是我们对一些我举个例子"
    },
    {
      "ordinal": 161,
      "start_ms": 472780,
      "end_ms": 476080,
      "text": "美国美国的一些法律它是很不合理的"
    },
    {
      "ordinal": 162,
      "start_ms": 476080,
      "end_ms": 478180,
      "text": "一些资本主义性质的"
    },
    {
      "ordinal": 163,
      "start_ms": 480079,
      "end_ms": 482319,
      "text": "我们不是说我们是很温驯的"
    },
    {
      "ordinal": 164,
      "start_ms": 482319,
      "end_ms": 483039,
      "text": "很驯服的"
    },
    {
      "ordinal": 165,
      "start_ms": 483039,
      "end_ms": 485499,
      "text": "就是就是很很"
    },
    {
      "ordinal": 166,
      "start_ms": 485499,
      "end_ms": 488820,
      "text": "而是说我们这样做的目的"
    },
    {
      "ordinal": 167,
      "start_ms": 488820,
      "end_ms": 493680,
      "text": "是为了让这个公益团体能够更深沉"
    },
    {
      "ordinal": 168,
      "start_ms": 493680,
      "end_ms": 498510,
      "text": "广大的深沉的更深沉啊"
    },
    {
      "ordinal": 169,
      "start_ms": 498510,
      "end_ms": 502860,
      "text": "更长远的去发挥影响和作用啊"
    },
    {
      "ordinal": 170,
      "start_ms": 502860,
      "end_ms": 504580,
      "text": "发挥影响和作用"
    },
    {
      "ordinal": 171,
      "start_ms": 506300,
      "end_ms": 508900,
      "text": "以及更广泛的更广泛"
    },
    {
      "ordinal": 172,
      "start_ms": 508900,
      "end_ms": 509800,
      "text": "更深沉"
    },
    {
      "ordinal": 173,
      "start_ms": 509800,
      "end_ms": 511810,
      "text": "更长远的发挥影响和作用"
    },
    {
      "ordinal": 174,
      "start_ms": 511810,
      "end_ms": 514600,
      "text": "所以你必须存活下来啊"
    },
    {
      "ordinal": 175,
      "start_ms": 514600,
      "end_ms": 517240,
      "text": "必须杜绝张士诚这样的"
    },
    {
      "ordinal": 176,
      "start_ms": 517240,
      "end_ms": 518440,
      "text": "哪怕他能力很强"
    },
    {
      "ordinal": 177,
      "start_ms": 518440,
      "end_ms": 519460,
      "text": "像张成那样"
    },
    {
      "ordinal": 178,
      "start_ms": 519460,
      "end_ms": 521559,
      "text": "他研发当中最的那个了"
    },
    {
      "ordinal": 179,
      "start_ms": 521559,
      "end_ms": 522970,
      "text": "仗义疏财"
    },
    {
      "ordinal": 180,
      "start_ms": 522970,
      "end_ms": 526400,
      "text": "他们这些人往往这个特点是仗义疏财啊"
    },
    {
      "ordinal": 181,
      "start_ms": 529520,
      "end_ms": 530530,
      "text": "疏财"
    },
    {
      "ordinal": 182,
      "start_ms": 530530,
      "end_ms": 532900,
      "text": "同时我们也可以说他仗义疏财"
    },
    {
      "ordinal": 183,
      "start_ms": 532900,
      "end_ms": 534730,
      "text": "其实个人才干是有限的"
    },
    {
      "ordinal": 184,
      "start_ms": 534730,
      "end_ms": 539660,
      "text": "可能人格魅力把一群啊其实没有实质性的才能"
    },
    {
      "ordinal": 185,
      "start_ms": 539660,
      "end_ms": 541790,
      "text": "那是靠所谓的魅力啊"
    },
    {
      "ordinal": 186,
      "start_ms": 541790,
      "end_ms": 544120,
      "text": "江湖哥们一起这种吊东西"
    },
    {
      "ordinal": 187,
      "start_ms": 545640,
      "end_ms": 547220,
      "text": "疏于真正的才干"
    },
    {
      "ordinal": 188,
      "start_ms": 547220,
      "end_ms": 549620,
      "text": "但是喜欢就花钱收买人心啊"
    },
    {
      "ordinal": 189,
      "start_ms": 549620,
      "end_ms": 554200,
      "text": "这种人关于团体呢要多去帮助和关怀"
    },
    {
      "ordinal": 190,
      "start_ms": 554200,
      "end_ms": 556240,
      "text": "那些刻苦耐劳的"
    },
    {
      "ordinal": 191,
      "start_ms": 556340,
      "end_ms": 560780,
      "text": "或者说在生活中生活中穷困的生活中"
    },
    {
      "ordinal": 192,
      "start_ms": 560780,
      "end_ms": 561800,
      "text": "这个穷啊"
    },
    {
      "ordinal": 193,
      "start_ms": 561800,
      "end_ms": 565000,
      "text": "这个穷是不是贫穷"
    },
    {
      "ordinal": 194,
      "start_ms": 565000,
      "end_ms": 566320,
      "text": "是无路可走"
    },
    {
      "ordinal": 195,
      "start_ms": 566320,
      "end_ms": 567819,
      "text": "无路可走"
    },
    {
      "ordinal": 196,
      "start_ms": 568980,
      "end_ms": 570560,
      "text": "无路可走的"
    },
    {
      "ordinal": 197,
      "start_ms": 572140,
      "end_ms": 574680,
      "text": "这个这个路是走正道"
    },
    {
      "ordinal": 198,
      "start_ms": 574680,
      "end_ms": 576300,
      "text": "就是说他是想走正道的"
    },
    {
      "ordinal": 199,
      "start_ms": 576300,
      "end_ms": 578420,
      "text": "并且他本来是走正道的"
    },
    {
      "ordinal": 200,
      "start_ms": 578640,
      "end_ms": 580260,
      "text": "本来是他是劳动的"
    },
    {
      "ordinal": 201,
      "start_ms": 580260,
      "end_ms": 581460,
      "text": "他是赚钱的"
    },
    {
      "ordinal": 202,
      "start_ms": 581460,
      "end_ms": 582720,
      "text": "那么这种情况"
    },
    {
      "ordinal": 203,
      "start_ms": 582720,
      "end_ms": 585950,
      "text": "我们发通过公益团结的方式来帮助他"
    },
    {
      "ordinal": 204,
      "start_ms": 585950,
      "end_ms": 587270,
      "text": "大家抱团取暖"
    },
    {
      "ordinal": 205,
      "start_ms": 587270,
      "end_ms": 588710,
      "text": "让他继续走震荡"
    },
    {
      "ordinal": 206,
      "start_ms": 588710,
      "end_ms": 589250,
      "text": "无路可走"
    },
    {
      "ordinal": 207,
      "start_ms": 589250,
      "end_ms": 593110,
      "text": "那么继续走震荡啊"
    },
    {
      "ordinal": 208,
      "start_ms": 593110,
      "end_ms": 594220,
      "text": "继续走正道"
    },
    {
      "ordinal": 209,
      "start_ms": 594220,
      "end_ms": 596500,
      "text": "大家在这个团体里面互相帮助"
    },
    {
      "ordinal": 210,
      "start_ms": 596500,
      "end_ms": 597430,
      "text": "互相帮助"
    },
    {
      "ordinal": 211,
      "start_ms": 597430,
      "end_ms": 599020,
      "text": "也不违法犯罪"
    },
    {
      "ordinal": 212,
      "start_ms": 599340,
      "end_ms": 603080,
      "text": "也不纠集闹事儿都这样了"
    },
    {
      "ordinal": 213,
      "start_ms": 603080,
      "end_ms": 604160,
      "text": "你还过来欺负"
    },
    {
      "ordinal": 214,
      "start_ms": 604160,
      "end_ms": 605930,
      "text": "那这个是士可忍孰不可忍"
    },
    {
      "ordinal": 215,
      "start_ms": 605930,
      "end_ms": 608240,
      "text": "但是普遍来看啊"
    },
    {
      "ordinal": 216,
      "start_ms": 608240,
      "end_ms": 611690,
      "text": "没有发生这样的情况啊"
    },
    {
      "ordinal": 217,
      "start_ms": 611690,
      "end_ms": 614400,
      "text": "就现目前没有发生一例这样的情况呢"
    },
    {
      "ordinal": 218,
      "start_ms": 614400,
      "end_ms": 617340,
      "text": "啊这个打工的人互相保护啊"
    },
    {
      "ordinal": 219,
      "start_ms": 617340,
      "end_ms": 620040,
      "text": "说这个不不准你一起租房子"
    },
    {
      "ordinal": 220,
      "start_ms": 620040,
      "end_ms": 621600,
      "text": "不准你互相这个吃饭的时候"
    },
    {
      "ordinal": 221,
      "start_ms": 621600,
      "end_ms": 625470,
      "text": "互相大家平潭是省点钱啊"
    },
    {
      "ordinal": 222,
      "start_ms": 625470,
      "end_ms": 629520,
      "text": "所以这个公益团体呢是要着力去帮助"
    },
    {
      "ordinal": 223,
      "start_ms": 629520,
      "end_ms": 633680,
      "text": "团体内部的一些这个不一不一定是贫穷啊"
    },
    {
      "ordinal": 224,
      "start_ms": 633680,
      "end_ms": 635120,
      "text": "而是说无路可走"
    },
    {
      "ordinal": 225,
      "start_ms": 636200,
      "end_ms": 637500,
      "text": "无路可走"
    },
    {
      "ordinal": 226,
      "start_ms": 637960,
      "end_ms": 638920,
      "text": "回老家"
    },
    {
      "ordinal": 227,
      "start_ms": 638920,
      "end_ms": 640840,
      "text": "那就是一眼都看的就是绝望"
    },
    {
      "ordinal": 228,
      "start_ms": 640840,
      "end_ms": 642640,
      "text": "你知道吗啊"
    },
    {
      "ordinal": 229,
      "start_ms": 642880,
      "end_ms": 647620,
      "text": "或者说他家里人还还盼着他在城市里面赚点钱"
    },
    {
      "ordinal": 230,
      "start_ms": 647620,
      "end_ms": 648939,
      "text": "补贴老家"
    },
    {
      "ordinal": 231,
      "start_ms": 649300,
      "end_ms": 650650,
      "text": "那么公益团体的话"
    },
    {
      "ordinal": 232,
      "start_ms": 650650,
      "end_ms": 654340,
      "text": "要对于这样的比较困难的生活困难的啊"
    },
    {
      "ordinal": 233,
      "start_ms": 654340,
      "end_ms": 655270,
      "text": "同伴啊"
    },
    {
      "ordinal": 234,
      "start_ms": 655270,
      "end_ms": 657930,
      "text": "大家要是精神上"
    },
    {
      "ordinal": 235,
      "start_ms": 657930,
      "end_ms": 658890,
      "text": "心理上"
    },
    {
      "ordinal": 236,
      "start_ms": 658890,
      "end_ms": 660270,
      "text": "精神上要支持啊"
    },
    {
      "ordinal": 237,
      "start_ms": 660270,
      "end_ms": 661950,
      "text": "要支持啊"
    },
    {
      "ordinal": 238,
      "start_ms": 661950,
      "end_ms": 666520,
      "text": "情感上啊要彼此要体谅啊"
    },
    {
      "ordinal": 239,
      "start_ms": 666520,
      "end_ms": 668560,
      "text": "彼此要倾诉啊"
    },
    {
      "ordinal": 240,
      "start_ms": 668560,
      "end_ms": 669979,
      "text": "彼此要关怀"
    },
    {
      "ordinal": 241,
      "start_ms": 671720,
      "end_ms": 672670,
      "text": "明白吗"
    },
    {
      "ordinal": 242,
      "start_ms": 672670,
      "end_ms": 674440,
      "text": "然后尤其公益团体"
    },
    {
      "ordinal": 243,
      "start_ms": 674440,
      "end_ms": 678260,
      "text": "不要做成那种什么张士诚盐交贩子啊"
    },
    {
      "ordinal": 244,
      "start_ms": 678260,
      "end_ms": 680300,
      "text": "人他是不缺钱啊"
    },
    {
      "ordinal": 245,
      "start_ms": 680300,
      "end_ms": 681380,
      "text": "是不缺钱的"
    },
    {
      "ordinal": 246,
      "start_ms": 682460,
      "end_ms": 683500,
      "text": "但是呢"
    },
    {
      "ordinal": 247,
      "start_ms": 685160,
      "end_ms": 688120,
      "text": "但是呢好像是很忠诚推"
    },
    {
      "ordinal": 248,
      "start_ms": 688120,
      "end_ms": 689890,
      "text": "为什么张士诚那么早春地啊"
    },
    {
      "ordinal": 249,
      "start_ms": 689890,
      "end_ms": 691959,
      "text": "他下面的人要享受"
    },
    {
      "ordinal": 250,
      "start_ms": 693100,
      "end_ms": 693840,
      "text": "懂了吧"
    },
    {
      "ordinal": 251,
      "start_ms": 693840,
      "end_ms": 695500,
      "text": "下面的人要享受"
    },
    {
      "ordinal": 252,
      "start_ms": 695600,
      "end_ms": 698000,
      "text": "所以他可能一开始张士诚的团队"
    },
    {
      "ordinal": 253,
      "start_ms": 698000,
      "end_ms": 701300,
      "text": "那元宵团队一开始也是有点平等色彩的"
    },
    {
      "ordinal": 254,
      "start_ms": 701300,
      "end_ms": 704400,
      "text": "大家都是大哥吗啊"
    },
    {
      "ordinal": 255,
      "start_ms": 704880,
      "end_ms": 706320,
      "text": "都在军武当中"
    },
    {
      "ordinal": 256,
      "start_ms": 706320,
      "end_ms": 708390,
      "text": "一开始他创草创早期"
    },
    {
      "ordinal": 257,
      "start_ms": 708390,
      "end_ms": 711819,
      "text": "他的草创早期肯定也是同甘共苦的"
    },
    {
      "ordinal": 258,
      "start_ms": 711819,
      "end_ms": 715660,
      "text": "否则他不会说脱颖而出那么多盐香那么多啊"
    },
    {
      "ordinal": 259,
      "start_ms": 715660,
      "end_ms": 718600,
      "text": "各式各样的这个啊投机分子"
    },
    {
      "ordinal": 260,
      "start_ms": 718600,
      "end_ms": 720900,
      "text": "那张智成功了之后呢"
    },
    {
      "ordinal": 261,
      "start_ms": 721160,
      "end_ms": 726080,
      "text": "他一开始的那个他发家的那个忠诚链条"
    },
    {
      "ordinal": 262,
      "start_ms": 726080,
      "end_ms": 727880,
      "text": "产生的那个油头"
    },
    {
      "ordinal": 263,
      "start_ms": 727940,
      "end_ms": 731319,
      "text": "都是大家对违法犯罪的手脏了才上山的"
    },
    {
      "ordinal": 264,
      "start_ms": 731600,
      "end_ms": 733100,
      "text": "那么这个时候就不够用了"
    },
    {
      "ordinal": 265,
      "start_ms": 733100,
      "end_ms": 733580,
      "text": "对不对"
    },
    {
      "ordinal": 266,
      "start_ms": 733580,
      "end_ms": 736920,
      "text": "那这有一部分人就像我要娶三妻四妾"
    },
    {
      "ordinal": 267,
      "start_ms": 736920,
      "end_ms": 739140,
      "text": "但是大家军中都应当是平等的"
    },
    {
      "ordinal": 268,
      "start_ms": 739140,
      "end_ms": 739800,
      "text": "怎么办呢"
    },
    {
      "ordinal": 269,
      "start_ms": 739800,
      "end_ms": 742940,
      "text": "封爵位啊是吧"
    },
    {
      "ordinal": 270,
      "start_ms": 742940,
      "end_ms": 747810,
      "text": "那你最低一级的小特权军官张士诚造反"
    },
    {
      "ordinal": 271,
      "start_ms": 747810,
      "end_ms": 750150,
      "text": "部队里面说我要娶三个老婆"
    },
    {
      "ordinal": 272,
      "start_ms": 750150,
      "end_ms": 751940,
      "text": "或者说要弄两个奴婢"
    },
    {
      "ordinal": 273,
      "start_ms": 751940,
      "end_ms": 755120,
      "text": "那根据部队部队里面的普通的士兵就不一样了"
    },
    {
      "ordinal": 274,
      "start_ms": 755120,
      "end_ms": 758700,
      "text": "最最低级的那这个得封一个什么"
    },
    {
      "ordinal": 275,
      "start_ms": 758700,
      "end_ms": 759360,
      "text": "对不对"
    },
    {
      "ordinal": 276,
      "start_ms": 759360,
      "end_ms": 761220,
      "text": "得封一个什么什么爵位"
    },
    {
      "ordinal": 277,
      "start_ms": 761220,
      "end_ms": 762840,
      "text": "那比他高好多级的"
    },
    {
      "ordinal": 278,
      "start_ms": 762840,
      "end_ms": 765240,
      "text": "那他在往上堆堆堆堆堆堆到张士诚"
    },
    {
      "ordinal": 279,
      "start_ms": 765240,
      "end_ms": 766699,
      "text": "他不得不做皇帝了"
    },
    {
      "ordinal": 280,
      "start_ms": 767460,
      "end_ms": 769220,
      "text": "因为每一层都有享受特权"
    },
    {
      "ordinal": 281,
      "start_ms": 769220,
      "end_ms": 773579,
      "text": "这就是他享受特权的那一层的那一层人"
    },
    {
      "ordinal": 282,
      "start_ms": 775580,
      "end_ms": 779120,
      "text": "可能就只是一个什么小小的一个教授"
    },
    {
      "ordinal": 283,
      "start_ms": 779120,
      "end_ms": 779960,
      "text": "或者怎么样的"
    },
    {
      "ordinal": 284,
      "start_ms": 783020,
      "end_ms": 784280,
      "text": "你知道吗啊"
    },
    {
      "ordinal": 285,
      "start_ms": 784280,
      "end_ms": 790790,
      "text": "他的这个骨干等级里面不太高的一个等级"
    },
    {
      "ordinal": 286,
      "start_ms": 792810,
      "end_ms": 797070,
      "text": "那可能是他那个营销团伙的哪个成员的"
    },
    {
      "ordinal": 287,
      "start_ms": 797070,
      "end_ms": 798439,
      "text": "那个远房亲戚"
    },
    {
      "ordinal": 288,
      "start_ms": 798740,
      "end_ms": 801240,
      "text": "隔了两层表情的那种"
    },
    {
      "ordinal": 289,
      "start_ms": 802660,
      "end_ms": 803760,
      "text": "能推到上面去"
    },
    {
      "ordinal": 290,
      "start_ms": 806220,
      "end_ms": 808350,
      "text": "他这个这个老大爷封皇帝了"
    },
    {
      "ordinal": 291,
      "start_ms": 808350,
      "end_ms": 810120,
      "text": "所以张士诚这样的团伙"
    },
    {
      "ordinal": 292,
      "start_ms": 810120,
      "end_ms": 812920,
      "text": "他就是说他在草创之时呢"
    },
    {
      "ordinal": 293,
      "start_ms": 812920,
      "end_ms": 816820,
      "text": "他这个核心的大家的这个凝结核就弄错了"
    },
    {
      "ordinal": 294,
      "start_ms": 816820,
      "end_ms": 820470,
      "text": "这原法西斯团队啊"
    },
    {
      "ordinal": 295,
      "start_ms": 820470,
      "end_ms": 822420,
      "text": "那违法犯罪来这样拉起来"
    },
    {
      "ordinal": 296,
      "start_ms": 822420,
      "end_ms": 824760,
      "text": "这个队伍是绝对不行的"
    },
    {
      "ordinal": 297,
      "start_ms": 824760,
      "end_ms": 827370,
      "text": "当然我说的绝对不能违法犯罪"
    },
    {
      "ordinal": 298,
      "start_ms": 827370,
      "end_ms": 828560,
      "text": "因为这样"
    },
    {
      "ordinal": 299,
      "start_ms": 830360,
      "end_ms": 832630,
      "text": "你可能会一下子赚了很多钱"
    },
    {
      "ordinal": 300,
      "start_ms": 832630,
      "end_ms": 835090,
      "text": "但是你损害的是人民群众的长远利益"
    },
    {
      "ordinal": 301,
      "start_ms": 835090,
      "end_ms": 836080,
      "text": "你没有代表性"
    },
    {
      "ordinal": 302,
      "start_ms": 836080,
      "end_ms": 838360,
      "text": "你无法代表劳动群众啊"
    },
    {
      "ordinal": 303,
      "start_ms": 838360,
      "end_ms": 839380,
      "text": "没有代表性"
    },
    {
      "ordinal": 304,
      "start_ms": 842680,
      "end_ms": 843439,
      "text": "啊"
    },
    {
      "ordinal": 305,
      "start_ms": 846300,
      "end_ms": 848210,
      "text": "啊你无法代表劳动群众"
    },
    {
      "ordinal": 306,
      "start_ms": 848210,
      "end_ms": 850100,
      "text": "劳动群众绝对不是劳动群众"
    },
    {
      "ordinal": 307,
      "start_ms": 850100,
      "end_ms": 851960,
      "text": "是不会违法犯罪的"
    },
    {
      "ordinal": 308,
      "start_ms": 851960,
      "end_ms": 853700,
      "text": "那么公益团体呢"
    },
    {
      "ordinal": 309,
      "start_ms": 853700,
      "end_ms": 859240,
      "text": "啊他就不能说是靠他妈违法犯罪来这个"
    },
    {
      "ordinal": 310,
      "start_ms": 859240,
      "end_ms": 860860,
      "text": "然后多楼前拉队服"
    },
    {
      "ordinal": 311,
      "start_ms": 860860,
      "end_ms": 865359,
      "text": "这样搞起来永远不能永远像是代表一个啊"
    },
    {
      "ordinal": 312,
      "start_ms": 867360,
      "end_ms": 869060,
      "text": "能够吃苦耐劳的"
    },
    {
      "ordinal": 313,
      "start_ms": 871960,
      "end_ms": 874680,
      "text": "啊我把这刻苦耐劳改成吃苦耐劳吧"
    },
    {
      "ordinal": 314,
      "start_ms": 874680,
      "end_ms": 877420,
      "text": "吃苦耐劳的明白吧"
    },
    {
      "ordinal": 315,
      "start_ms": 878320,
      "end_ms": 880260,
      "text": "那么这就是我要说的"
    },
    {
      "ordinal": 316,
      "start_ms": 880260,
      "end_ms": 881790,
      "text": "这就是我要说的"
    },
    {
      "ordinal": 317,
      "start_ms": 881790,
      "end_ms": 884780,
      "text": "就你就想想项羽为什么他不能成事了"
    },
    {
      "ordinal": 318,
      "start_ms": 888840,
      "end_ms": 890640,
      "text": "非兵之罪也"
    },
    {
      "ordinal": 319,
      "start_ms": 890920,
      "end_ms": 894340,
      "text": "他就是靠把那个什么太守一家给宰了"
    },
    {
      "ordinal": 320,
      "start_ms": 894340,
      "end_ms": 898900,
      "text": "吴郡太守还什么的嚯嚯这个我都记不得了"
    },
    {
      "ordinal": 321,
      "start_ms": 904880,
      "end_ms": 907240,
      "text": "啊还还是鲁迅"
    },
    {
      "ordinal": 322,
      "start_ms": 907240,
      "end_ms": 909160,
      "text": "不是封鲁公吗"
    },
    {
      "ordinal": 323,
      "start_ms": 909160,
      "end_ms": 911980,
      "text": "他老家嗯"
    },
    {
      "ordinal": 324,
      "start_ms": 911980,
      "end_ms": 912400,
      "text": "完了吧"
    },
    {
      "ordinal": 325,
      "start_ms": 912400,
      "end_ms": 914680,
      "text": "我我历史有点记不太得了"
    },
    {
      "ordinal": 326,
      "start_ms": 914680,
      "end_ms": 916180,
      "text": "记不太得了啊"
    },
    {
      "ordinal": 327,
      "start_ms": 916180,
      "end_ms": 917020,
      "text": "我是告诉你"
    },
    {
      "ordinal": 328,
      "start_ms": 917020,
      "end_ms": 920980,
      "text": "就是说这样像张士诚这样的团队"
    },
    {
      "ordinal": 329,
      "start_ms": 920980,
      "end_ms": 923530,
      "text": "他炸起很快啊"
    },
    {
      "ordinal": 330,
      "start_ms": 923530,
      "end_ms": 928140,
      "text": "他起星野薄焉而亡也忽焉"
    },
    {
      "ordinal": 331,
      "start_ms": 928760,
      "end_ms": 931300,
      "text": "他是没有办法有"
    },
    {
      "ordinal": 332,
      "start_ms": 932060,
      "end_ms": 933940,
      "text": "他就没有持久政治生命力"
    },
    {
      "ordinal": 333,
      "start_ms": 933940,
      "end_ms": 934570,
      "text": "你知道吗"
    },
    {
      "ordinal": 334,
      "start_ms": 934570,
      "end_ms": 936240,
      "text": "这昙花一现的"
    },
    {
      "ordinal": 335,
      "start_ms": 936600,
      "end_ms": 939060,
      "text": "当然任何这样的团结起来啊"
    },
    {
      "ordinal": 336,
      "start_ms": 939060,
      "end_ms": 943920,
      "text": "在我我国目前治安治理环境下都是诈欺诈灭啊"
    },
    {
      "ordinal": 337,
      "start_ms": 943920,
      "end_ms": 944370,
      "text": "好吧"
    },
    {
      "ordinal": 338,
      "start_ms": 944370,
      "end_ms": 946260,
      "text": "为人民群众所唾弃"
    },
    {
      "ordinal": 339,
      "start_ms": 946260,
      "end_ms": 949270,
      "text": "他就是一个卑鄙的野心家团团体好吧"
    },
    {
      "ordinal": 340,
      "start_ms": 949270,
      "end_ms": 950530,
      "text": "那就讲到这里啊"
    },
    {
      "ordinal": 341,
      "start_ms": 950530,
      "end_ms": 951280,
      "text": "那就讲到这里"
    }
