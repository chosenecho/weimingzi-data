    {
      "ordinal": 126,
      "start_ms": 396530,
      "end_ms": 398240,
      "text": "这个点的运动趋势"
    },
    {
      "ordinal": 127,
      "start_ms": 398240,
      "end_ms": 401940,
      "text": "那么政治讲究的是运动"
