      "end_ms": 404890,
      "text": "对不对"
    },
    {
      "ordinal": 129,
      "start_ms": 404890,
      "end_ms": 406360,
      "text": "政治讲究的是运动"
    },
    {
      "ordinal": 130,
      "start_ms": 406360,
      "end_ms": 407920,
      "text": "政治讲究的是运动"
    },
    {
      "ordinal": 131,
      "start_ms": 407920,
      "end_ms": 409690,
      "text": "所以呢我们甚至可以说"
