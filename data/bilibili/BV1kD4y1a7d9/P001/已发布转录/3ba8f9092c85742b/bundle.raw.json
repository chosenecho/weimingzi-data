{"segments":[{"start":2.76,"end":4.019,"text":"还有一首老歌啊"},{"start":4.019,"end":4.98,"text":"唱一下啊"},{"start":4.98,"end":6.18,"text":"也比较有价值"},{"start":6.18,"end":27.68,"text":"啊啊啊啊啊呜呜呜"},{"start":50.96,"end":56.74,"text":"啊啊啊"},{"start":59.18,"end":63.08,"text":"心儿的影"},{"start":63.6,"end":72.24,"text":"月亮的心映在水中"},{"start":72.64,"end":76.62,"text":"嘴唇如玉"},{"start":77.12,"end":79.78,"text":"云海的冰"},{"start":81.76,"end":88.8,"text":"风儿的花映在眼中"},{"start":90.72,"end":94.14,"text":"去向何方"},{"start":94.78,"end":97.68,"text":"你曾说"},{"start":98.78,"end":105.34,"text":"天上有一颗这样一颗"},{"start":107.98,"end":110.32,"text":"一颗大树"},{"start":113.48,"end":115.66,"text":"他落下"},{"start":117.4,"end":120.3,"text":"冰雪般落叶"},{"start":121.86,"end":123.84,"text":"随着秋风"},{"start":125.68,"end":128.639,"text":"洒满天船"},{"start":131.16,"end":134.97,"text":"想着夜晚月摇寒"},{"start":134.97,"end":143.97,"text":"富庶苍茫与外双叶洒天窗"},{"start":143.97,"end":148.66,"text":"跳舞自风声凛冽"},{"start":148.66,"end":150.34,"text":"灯火灿烂"},{"start":151.48,"end":153.28,"text":"青与关"},{"start":153.28,"end":155.05,"text":"萤火灿烂"},{"start":155.05,"end":158.93,"text":"青玉关心中"},{"start":158.93,"end":161.98,"text":"1月牙寒"},{"start":161.98,"end":166.94,"text":"浮世无常与外"},{"start":167.04,"end":168.38,"text":"你还说"},{"start":171.02,"end":177.86,"text":"树上有一只这样一只"},{"start":179.9,"end":182.36,"text":"一只蜂乱"},{"start":184.66,"end":190.88,"text":"他不带你去离去到远方"},{"start":193.82,"end":199.18,"text":"他的身影明灭"},{"start":200.74,"end":201.7,"text":"可歌可白啊"},{"start":201.7,"end":202.69,"text":"那随意啊"},{"start":202.69,"end":205.78,"text":"天边那一刻"},{"start":206.72,"end":208.81,"text":"离离星火之中"},{"start":208.81,"end":215.92,"text":"一颗萤火在风波中不停留"},{"start":215.92,"end":217.78,"text":"青骓与关"},{"start":217.78,"end":221.66,"text":"青春与关心"},{"start":221.66,"end":225.5,"text":"戳眼月摇寒"},{"start":225.66,"end":227.81,"text":"浮世草"},{"start":227.81,"end":229.96,"text":"绿花"},{"start":230.0,"end":234.2,"text":"山河有卫星"},{"start":234.2,"end":236.93,"text":"簌簌飘零人间"},{"start":236.93,"end":242.76,"text":"如今好梦佳期难寻"},{"start":242.76,"end":248.84,"text":"谁不知我此心独身者"},{"start":248.84,"end":259.54,"text":"冥冥长夜啊"}],"source":"subtitle"}
