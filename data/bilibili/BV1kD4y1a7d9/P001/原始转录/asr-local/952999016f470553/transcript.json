{
  "bvid": "BV1kD4y1a7d9",
  "page": 1,
  "source": "asr-local",
  "language": "Chinese",
  "model": {
    "model_name": "source://production/models/Qwen3-ASR-1.7B-hf",
    "revision": "bcd2b5b7f32b480ab5790554cfa8347f246a14f3"
  },
  "content_sha256": "952999016f470553bf0af106fe0283c7af4e4f2905882e54290bc6590b438335",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 2960,
      "end_ms": 6320,
      "text": "啊，一首老歌啊，唱一下啊，比较有价值啊。"
    },
    {
      "ordinal": 1,
      "start_ms": 59360,
      "end_ms": 66240,
      "text": "星儿的影，月儿的心，"
    },
    {
      "ordinal": 2,
      "start_ms": 68480,
      "end_ms": 76000,
      "text": "影在水中，垂垂如云。"
    },
    {
      "ordinal": 3,
      "start_ms": 77520,
      "end_ms": 93200,
      "text": "云行的冰，风儿的花，影在眼中，去向何方？"
    },
    {
      "ordinal": 4,
      "start_ms": 95120,
      "end_ms": 102240,
      "text": "你曾说，天上有一棵，"
    },
    {
      "ordinal": 5,
      "start_ms": 104000,
      "end_ms": 109760,
      "text": "这样一棵，一棵大树。"
    },
    {
      "ordinal": 6,
      "start_ms": 113840,
      "end_ms": 118800,
      "text": "它落下，冰雪般"
    },
    {
      "ordinal": 7,
      "start_ms": 119840,
      "end_ms": 127200,
      "text": "落叶，随着秋风，洒满天川。"
    },
    {
      "ordinal": 8,
      "start_ms": 131760,
      "end_ms": 136960,
      "text": "星灼影，月摇寒，浮树藏"
    },
    {
      "ordinal": 9,
      "start_ms": 138240,
      "end_ms": 143600,
      "text": "雨外，霜叶洒天川。"
    },
    {
      "ordinal": 10,
      "start_ms": 144480,
      "end_ms": 148080,
      "text": "跳舞，此风声鸣灭，萤"
    },
    {
      "ordinal": 11,
      "start_ms": 149440,
      "end_ms": 152560,
      "text": "火成蓝，青玉冠，"
    },
    {
      "ordinal": 12,
      "start_ms": 153600,
      "end_ms": 157360,
      "text": "萤火成蓝，青玉冠。"
    },
    {
      "ordinal": 13,
      "start_ms": 158240,
      "end_ms": 167440,
      "text": "星灼影，月摇寒，浮树藏雨外。"
    },
    {
      "ordinal": 14,
      "start_ms": 167440,
      "end_ms": 174720,
      "text": "你还说，树上有一只，"
    },
    {
      "ordinal": 15,
      "start_ms": 176160,
      "end_ms": 181040,
      "text": "这样一只，一只蜂乱。"
    },
    {
      "ordinal": 16,
      "start_ms": 184930,
      "end_ms": 188290,
      "text": "他无奈离去，离"
    },
    {
      "ordinal": 17,
      "start_ms": 189490,
      "end_ms": 198850,
      "text": "去到远方，他的身影泯灭。"
    },
    {
      "ordinal": 18,
      "start_ms": 200850,
      "end_ms": 202370,
      "text": "可歌可白啊，你随意啊。"
    },
    {
      "ordinal": 19,
      "start_ms": 203170,
      "end_ms": 210530,
      "text": "天边那一颗，离离星火之中一颗萤火，"
    },
    {
      "ordinal": 20,
      "start_ms": 211570,
      "end_ms": 215490,
      "text": "在风波中不停留。"
    },
    {
      "ordinal": 21,
      "start_ms": 216130,
      "end_ms": 219330,
      "text": "晴追玉关，晴追玉关。"
    },
    {
      "ordinal": 22,
      "start_ms": 221330,
      "end_ms": 230210,
      "text": "星绰影，月遥寒，浮世苍云外。"
    },
    {
      "ordinal": 23,
      "start_ms": 230210,
      "end_ms": 235730,
      "text": "山河犹未醒，簌簌飘零。"
    },
    {
      "ordinal": 24,
      "start_ms": 236370,
      "end_ms": 241810,
      "text": "人间如镜，好梦佳期难寻。"
    },
    {
      "ordinal": 25,
      "start_ms": 243010,
      "end_ms": 246290,
      "text": "谁复知我此心？"
    },
    {
      "ordinal": 26,
      "start_ms": 247650,
      "end_ms": 251570,
      "text": "独身者冥冥长夜。"
    }
  ],
  "text": "啊，一首老歌啊，唱一下啊，比较有价值啊。\n星儿的影，月儿的心，\n影在水中，垂垂如云。\n云行的冰，风儿的花，影在眼中，去向何方？\n你曾说，天上有一棵，\n这样一棵，一棵大树。\n它落下，冰雪般\n落叶，随着秋风，洒满天川。\n星灼影，月摇寒，浮树藏\n雨外，霜叶洒天川。\n跳舞，此风声鸣灭，萤\n火成蓝，青玉冠，\n萤火成蓝，青玉冠。\n星灼影，月摇寒，浮树藏雨外。\n你还说，树上有一只，\n这样一只，一只蜂乱。\n他无奈离去，离\n去到远方，他的身影泯灭。\n可歌可白啊，你随意啊。\n天边那一颗，离离星火之中一颗萤火，\n在风波中不停留。\n晴追玉关，晴追玉关。\n星绰影，月遥寒，浮世苍云外。\n山河犹未醒，簌簌飘零。\n人间如镜，好梦佳期难寻。\n谁复知我此心？\n独身者冥冥长夜。",
  "timing_issue": null
}
