{
  "bvid": "BV1F84y1r74W",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "c9fdc00ab0dcaa5ad98e791b6663341bec97e1db78bcc070a8167b090365bf1e",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 340,
      "end_ms": 2760,
      "text": "啊这次活动的一个初检"
    },
    {
      "ordinal": 1,
      "start_ms": 6920,
      "end_ms": 8620,
      "text": "诶等会同意来"
    },
    {
      "ordinal": 2,
      "start_ms": 11619,
      "end_ms": 14579,
      "text": "等会的停一下"
    },
    {
      "ordinal": 3,
      "start_ms": 14579,
      "end_ms": 15400,
      "text": "不会吗"
    },
    {
      "ordinal": 4,
      "start_ms": 20140,
      "end_ms": 23280,
      "text": "我来看一下他这是播的是个什么效果"
    },
    {
      "ordinal": 5,
      "start_ms": 23280,
      "end_ms": 26430,
      "text": "我们要感谢我们的这个团队成员啊"
    },
    {
      "ordinal": 6,
      "start_ms": 26430,
      "end_ms": 30640,
      "text": "啊我们一个我的一个困难的一个老哥啊"
    },
    {
      "ordinal": 7,
      "start_ms": 30640,
      "end_ms": 32770,
      "text": "他也是我们团队的成员"
    },
    {
      "ordinal": 8,
      "start_ms": 32770,
      "end_ms": 36480,
      "text": "感谢他的无偿劳动"
    },
    {
      "ordinal": 9,
      "start_ms": 38760,
      "end_ms": 39800,
      "text": "我们看一下啊"
    },
    {
      "ordinal": 10,
      "start_ms": 39800,
      "end_ms": 40599,
      "text": "看一下"
    },
    {
      "ordinal": 11,
      "start_ms": 50180,
      "end_ms": 50750,
      "text": "扔掉"
    },
    {
      "ordinal": 12,
      "start_ms": 51740,
      "end_ms": 55240,
      "text": "我在拆开就掉草"
    },
    {
      "ordinal": 13,
      "start_ms": 55240,
      "end_ms": 58240,
      "text": "真的有什么空的啊"
    },
    {
      "ordinal": 14,
      "start_ms": 58240,
      "end_ms": 61260,
      "text": "搞不下有没有搞笑"
    },
    {
      "ordinal": 15,
      "start_ms": 84200,
      "end_ms": 88040,
      "text": "啧啧啧"
    },
    {
      "ordinal": 16,
      "start_ms": 89400,
      "end_ms": 92360,
      "text": "这就是这个厨房改造的过程"
    },
    {
      "ordinal": 17,
      "start_ms": 107880,
      "end_ms": 108860,
      "text": "多才多艺"
    },
    {
      "ordinal": 18,
      "start_ms": 108860,
      "end_ms": 109940,
      "text": "你知道吗"
    },
    {
      "ordinal": 19,
      "start_ms": 109940,
      "end_ms": 114830,
      "text": "你还会什么会的东西太多了哈哈"
    },
    {
      "ordinal": 20,
      "start_ms": 114830,
      "end_ms": 117620,
      "text": "六六口无所谓"
    },
    {
      "ordinal": 21,
      "start_ms": 117620,
      "end_ms": 119580,
      "text": "压杨安不会出手"
    },
    {
      "ordinal": 22,
      "start_ms": 119860,
      "end_ms": 121510,
      "text": "这个应该是第一次啊"
    },
    {
      "ordinal": 23,
      "start_ms": 121510,
      "end_ms": 123679,
      "text": "第一次试试吃了"
    },
    {
      "ordinal": 24,
      "start_ms": 132779,
      "end_ms": 133980,
      "text": "要等一点"
    },
    {
      "ordinal": 25,
      "start_ms": 139459,
      "end_ms": 141219,
      "text": "来了我来到一楼和你玩"
    },
    {
      "ordinal": 26,
      "start_ms": 141219,
      "end_ms": 141820,
      "text": "你"
    },
    {
      "ordinal": 27,
      "start_ms": 147119,
      "end_ms": 149359,
      "text": "我做的藤椒鸡啊"
    },
    {
      "ordinal": 28,
      "start_ms": 150919,
      "end_ms": 152329,
      "text": "炸土豆啊"
    },
    {
      "ordinal": 29,
      "start_ms": 152329,
      "end_ms": 155359,
      "text": "哦这个是我们自己团队内部的一个事实"
    },
    {
      "ordinal": 30,
      "start_ms": 155359,
      "end_ms": 159720,
      "text": "我们自己人内部的事情的那个样子"
    },
    {
      "ordinal": 31,
      "start_ms": 159720,
      "end_ms": 161000,
      "text": "一帮恶徒"
    },
    {
      "ordinal": 32,
      "start_ms": 170260,
      "end_ms": 171420,
      "text": "今天来了吗"
    },
    {
      "ordinal": 33,
      "start_ms": 171420,
      "end_ms": 172380,
      "text": "新来的新来的"
    },
    {
      "ordinal": 34,
      "start_ms": 172380,
      "end_ms": 173460,
      "text": "虽然我是这里常客"
    },
    {
      "ordinal": 35,
      "start_ms": 173460,
      "end_ms": 174690,
      "text": "老爷你在干嘛"
    },
    {
      "ordinal": 36,
      "start_ms": 174690,
      "end_ms": 176520,
      "text": "我在小窝去了啊"
    },
    {
      "ordinal": 37,
      "start_ms": 176520,
      "end_ms": 178400,
      "text": "虽然我也不知道这东西是不是叫莴苣啊"
    },
    {
      "ordinal": 38,
      "start_ms": 178700,
      "end_ms": 180830,
      "text": "为什么早上八点"
    },
    {
      "ordinal": 39,
      "start_ms": 180830,
      "end_ms": 183980,
      "text": "张师傅和叶师傅就开始了一天的忙碌"
    },
    {
      "ordinal": 40,
      "start_ms": 183980,
      "end_ms": 188349,
      "text": "今天他们的第一道工序是将土豆胡萝卜"
    },
    {
      "ordinal": 41,
      "start_ms": 188349,
      "end_ms": 190629,
      "text": "莴苣全部削干净"
    },
    {
      "ordinal": 42,
      "start_ms": 190629,
      "end_ms": 192159,
      "text": "消掉太多了"
    },
    {
      "ordinal": 43,
      "start_ms": 192159,
      "end_ms": 194229,
      "text": "淦你这你这样会喷"
    },
    {
      "ordinal": 44,
      "start_ms": 194229,
      "end_ms": 195420,
      "text": "会被喷的"
    },
    {
      "ordinal": 45,
      "start_ms": 195420,
      "end_ms": 197160,
      "text": "ok没事没事没事"
    },
    {
      "ordinal": 46,
      "start_ms": 197160,
      "end_ms": 198840,
      "text": "你把他正脸拍上"
    },
    {
      "ordinal": 47,
      "start_ms": 198840,
      "end_ms": 201420,
      "text": "这表情一层消掉就可以了"
    },
    {
      "ordinal": 48,
      "start_ms": 201420,
      "end_ms": 203580,
      "text": "这样你笑没了"
    },
    {
      "ordinal": 49,
      "start_ms": 205530,
      "end_ms": 206900,
      "text": "折腾了这么多米"
    },
    {
      "ordinal": 50,
      "start_ms": 209640,
      "end_ms": 213520,
      "text": "你花刀啊"
    },
    {
      "ordinal": 51,
      "start_ms": 220700,
      "end_ms": 222670,
      "text": "我是个第二刀是干什么的"
    },
    {
      "ordinal": 52,
      "start_ms": 222670,
      "end_ms": 223900,
      "text": "空切了一下"
    },
    {
      "ordinal": 53,
      "start_ms": 223900,
      "end_ms": 225620,
      "text": "看一下哪边效果更好"
    },
    {
      "ordinal": 54,
      "start_ms": 227480,
      "end_ms": 229660,
      "text": "那你悟到的手法又又变回来了"
    },
    {
      "ordinal": 55,
      "start_ms": 229660,
      "end_ms": 230380,
      "text": "你知道吗"
    },
    {
      "ordinal": 56,
      "start_ms": 248480,
      "end_ms": 250240,
      "text": "卧槽吓老子饭"
    },
    {
      "ordinal": 57,
      "start_ms": 250240,
      "end_ms": 254680,
      "text": "饿了饿了饿了饿了"
    },
    {
      "ordinal": 58,
      "start_ms": 260899,
      "end_ms": 264040,
      "text": "什么慢慢什么米拉德效应啊"
    },
    {
      "ordinal": 59,
      "start_ms": 264040,
      "end_ms": 265450,
      "text": "曼德拉效应"
    },
    {
      "ordinal": 60,
      "start_ms": 265450,
      "end_ms": 267860,
      "text": "美美美拉德效应"
    },
    {
      "ordinal": 61,
      "start_ms": 271120,
      "end_ms": 272670,
      "text": "哦呦这个声音"
    },
    {
      "ordinal": 62,
      "start_ms": 277500,
      "end_ms": 278840,
      "text": "要用那么多油吗"
    },
    {
      "ordinal": 63,
      "start_ms": 280639,
      "end_ms": 281319,
      "text": "搞一搞"
    },
    {
      "ordinal": 64,
      "start_ms": 281319,
      "end_ms": 283500,
      "text": "放保鲜膜"
    },
    {
      "ordinal": 65,
      "start_ms": 287880,
      "end_ms": 288960,
      "text": "这个很着急啊"
    },
    {
      "ordinal": 66,
      "start_ms": 288960,
      "end_ms": 292060,
      "text": "我没有说我是好人了没了呀"
    },
    {
      "ordinal": 67,
      "start_ms": 301560,
      "end_ms": 304520,
      "text": "我靠这都重开了"
    },
    {
      "ordinal": 68,
      "start_ms": 306040,
      "end_ms": 307920,
      "text": "这炒蛋怎么还扣上呢"
    },
    {
      "ordinal": 69,
      "start_ms": 307920,
      "end_ms": 309600,
      "text": "剩这么多土豆丝"
    },
    {
      "ordinal": 70,
      "start_ms": 309600,
      "end_ms": 310680,
      "text": "谁装一下"
    },
    {
      "ordinal": 71,
      "start_ms": 314580,
      "end_ms": 317000,
      "text": "那个蔬菜非常好好评"
    },
    {
      "ordinal": 72,
      "start_ms": 317000,
      "end_ms": 318260,
      "text": "我们吃了也觉得很棒"
    },
    {
      "ordinal": 73,
      "start_ms": 319520,
      "end_ms": 320300,
      "text": "胡萝卜丝"
    },
    {
      "ordinal": 74,
      "start_ms": 320300,
      "end_ms": 321320,
      "text": "西红柿鸡蛋"
    },
    {
      "ordinal": 75,
      "start_ms": 321320,
      "end_ms": 324170,
      "text": "然后那个呃就是他的口味"
    },
    {
      "ordinal": 76,
      "start_ms": 324170,
      "end_ms": 325280,
      "text": "我自己啊"
    },
    {
      "ordinal": 77,
      "start_ms": 325280,
      "end_ms": 326480,
      "text": "如果孩子们吃的"
    },
    {
      "ordinal": 78,
      "start_ms": 326480,
      "end_ms": 328580,
      "text": "我觉得是平淡适中啊"
    },
    {
      "ordinal": 79,
      "start_ms": 328580,
      "end_ms": 330470,
      "text": "酸甜可口很开胃"
    },
    {
      "ordinal": 80,
      "start_ms": 330470,
      "end_ms": 332180,
      "text": "然后米饭有点硬"
    },
    {
      "ordinal": 81,
      "start_ms": 332180,
      "end_ms": 334070,
      "text": "从我个人以及孩子的角度"
    },
    {
      "ordinal": 82,
      "start_ms": 334070,
      "end_ms": 337730,
      "text": "我不知道干活的人可能硬一点会好一些"
    },
    {
      "ordinal": 83,
      "start_ms": 337730,
      "end_ms": 341209,
      "text": "但是如果比如是一般的"
    },
    {
      "ordinal": 84,
      "start_ms": 341209,
      "end_ms": 343279,
      "text": "或者说或者如果是晚餐的话"
    },
    {
      "ordinal": 85,
      "start_ms": 343279,
      "end_ms": 345060,
      "text": "你们就尽量软一点"
    },
    {
      "ordinal": 86,
      "start_ms": 345060,
      "end_ms": 347220,
      "text": "那午餐可能硬点会好一点"
    },
    {
      "ordinal": 87,
      "start_ms": 347220,
      "end_ms": 350100,
      "text": "因为可能然后就是鸡腿很大"
    },
    {
      "ordinal": 88,
      "start_ms": 350100,
      "end_ms": 351270,
      "text": "诚意十足"
    },
    {
      "ordinal": 89,
      "start_ms": 351270,
      "end_ms": 352560,
      "text": "但是不太入味"
    },
    {
      "ordinal": 90,
      "start_ms": 352560,
      "end_ms": 354870,
      "text": "哈哈哈对"
    },
    {
      "ordinal": 91,
      "start_ms": 354870,
      "end_ms": 358590,
      "text": "然后就是呃孩子们是会觉得有很多血丝"
    },
    {
      "ordinal": 92,
      "start_ms": 358590,
      "end_ms": 361100,
      "text": "但那个一般做的梦也会这样啊"
    },
    {
      "ordinal": 93,
      "start_ms": 361100,
      "end_ms": 363080,
      "text": "所以我是说如果很大的话"
    },
    {
      "ordinal": 94,
      "start_ms": 363080,
      "end_ms": 366020,
      "text": "一定呃一个可能提前腌制更入味"
    },
    {
      "ordinal": 95,
      "start_ms": 366020,
      "end_ms": 367760,
      "text": "还有可能要再炸透一点"
    },
    {
      "ordinal": 96,
      "start_ms": 367760,
      "end_ms": 369140,
      "text": "会好一些"
    },
    {
      "ordinal": 97,
      "start_ms": 369140,
      "end_ms": 371090,
      "text": "好的对我觉得搭配啊"
    },
    {
      "ordinal": 98,
      "start_ms": 371090,
      "end_ms": 373490,
      "text": "色彩方面都都是还很有食欲的"
    },
    {
      "ordinal": 99,
      "start_ms": 373490,
      "end_ms": 374930,
      "text": "味道真的很不错"
    },
    {
      "ordinal": 100,
      "start_ms": 374930,
      "end_ms": 375710,
      "text": "腌制吧"
    },
    {
      "ordinal": 101,
      "start_ms": 375710,
      "end_ms": 376640,
      "text": "腌入味啊"
    },
    {
      "ordinal": 102,
      "start_ms": 376640,
      "end_ms": 379280,
      "text": "这豆腐皮等它凉拌的"
    },
    {
      "ordinal": 103,
      "start_ms": 379280,
      "end_ms": 381580,
      "text": "那小葱是做什么菜都要用到的"
    },
    {
      "ordinal": 104,
      "start_ms": 382819,
      "end_ms": 384039,
      "text": "这是白菜"
    },
    {
      "ordinal": 105,
      "start_ms": 385059,
      "end_ms": 389120,
      "text": "那明天要那个做那个酸辣大白菜的"
    },
    {
      "ordinal": 106,
      "start_ms": 391579,
      "end_ms": 392620,
      "text": "香菜"
    },
    {
      "ordinal": 107,
      "start_ms": 399340,
      "end_ms": 400320,
      "text": "这是茄子"
    },
    {
      "ordinal": 108,
      "start_ms": 403800,
      "end_ms": 404860,
      "text": "这是无损"
    },
    {
      "ordinal": 109,
      "start_ms": 405840,
      "end_ms": 409460,
      "text": "我明天不是要我们早上11点半"
    },
    {
      "ordinal": 110,
      "start_ms": 409460,
      "end_ms": 411650,
      "text": "要给星星家园的小朋友共餐"
    },
    {
      "ordinal": 111,
      "start_ms": 411650,
      "end_ms": 415340,
      "text": "然后中午啊"
    },
    {
      "ordinal": 112,
      "start_ms": 416400,
      "end_ms": 420170,
      "text": "中午要给我们的这边的一线的工作"
    },
    {
      "ordinal": 113,
      "start_ms": 420170,
      "end_ms": 422560,
      "text": "工作人员做领养"
    },
    {
      "ordinal": 114,
      "start_ms": 422560,
      "end_ms": 423580,
      "text": "星期四"
    },
    {
      "ordinal": 115,
      "start_ms": 423580,
      "end_ms": 427529,
      "text": "那总共准备了五个菜"
    },
    {
      "ordinal": 116,
      "start_ms": 427529,
      "end_ms": 428520,
      "text": "一个汤"
    },
    {
      "ordinal": 117,
      "start_ms": 431980,
      "end_ms": 432720,
      "text": "好了"
    },
    {
      "ordinal": 118,
      "start_ms": 433860,
      "end_ms": 434280,
      "text": "五个菜"
    },
    {
      "ordinal": 119,
      "start_ms": 434280,
      "end_ms": 436320,
      "text": "一个汤一个荤啊"
    },
    {
      "ordinal": 120,
      "start_ms": 436320,
      "end_ms": 437320,
      "text": "四个素材"
    },
    {
      "ordinal": 121,
      "start_ms": 440099,
      "end_ms": 444139,
      "text": "那我们下我们后天星期六啊"
    },
    {
      "ordinal": 122,
      "start_ms": 444139,
      "end_ms": 447520,
      "text": "其实应该是明天星期六那次就会有两个荤菜"
    },
    {
      "ordinal": 123,
      "start_ms": 464280,
      "end_ms": 466820,
      "text": "切姜片用得着拍这么多画面吗"
    },
    {
      "ordinal": 124,
      "start_ms": 469400,
      "end_ms": 475200,
      "text": "专业切出来就跟那个什么美工刀片一样的形状"
    },
    {
      "ordinal": 125,
      "start_ms": 477360,
      "end_ms": 478440,
      "text": "这要煮酱油了"
    },
    {
      "ordinal": 126,
      "start_ms": 478440,
      "end_ms": 480820,
      "text": "这是真鱼豉油"
    },
    {
      "ordinal": 127,
      "start_ms": 490639,
      "end_ms": 492320,
      "text": "这是黄酒"
    },
    {
      "ordinal": 128,
      "start_ms": 510780,
      "end_ms": 511910,
      "text": "很香是吧"
    },
    {
      "ordinal": 129,
      "start_ms": 511910,
      "end_ms": 512760,
      "text": "很香"
    },
    {
      "ordinal": 130,
      "start_ms": 534240,
      "end_ms": 536620,
      "text": "这姜片这样直接吃好吃吗"
    },
    {
      "ordinal": 131,
      "start_ms": 547780,
      "end_ms": 551359,
      "text": "这辣椒应该在它表面上应该摆着的那个"
    },
    {
      "ordinal": 132,
      "start_ms": 555760,
      "end_ms": 556980,
      "text": "你懂太做作了"
    },
    {
      "ordinal": 133,
      "start_ms": 556980,
      "end_ms": 558660,
      "text": "那真的变成美食博主了"
    },
    {
      "ordinal": 134,
      "start_ms": 558660,
      "end_ms": 559979,
      "text": "刚好是"
    },
    {
      "ordinal": 135,
      "start_ms": 576000,
      "end_ms": 578219,
      "text": "酸辣萝卜不是糖啊"
    },
    {
      "ordinal": 136,
      "start_ms": 590420,
      "end_ms": 591599,
      "text": "这人要来卖了"
    },
    {
      "ordinal": 137,
      "start_ms": 598400,
      "end_ms": 599320,
      "text": "这把就行"
    },
    {
      "ordinal": 138,
      "start_ms": 600520,
      "end_ms": 600940,
      "text": "加油"
    },
    {
      "ordinal": 139,
      "start_ms": 600940,
      "end_ms": 602290,
      "text": "这藤椒油也很贵"
    },
    {
      "ordinal": 140,
      "start_ms": 602290,
      "end_ms": 603599,
      "text": "你知道吧"
    },
    {
      "ordinal": 141,
      "start_ms": 604660,
      "end_ms": 608700,
      "text": "所以我省着点用藤椒粉吗"
    },
    {
      "ordinal": 142,
      "start_ms": 608700,
      "end_ms": 609640,
      "text": "好了"
    },
    {
      "ordinal": 143,
      "start_ms": 611820,
      "end_ms": 614640,
      "text": "轻点轻点再来点"
    },
    {
      "ordinal": 144,
      "start_ms": 622300,
      "end_ms": 623160,
      "text": "盐鸡腿"
    },
    {
      "ordinal": 145,
      "start_ms": 625500,
      "end_ms": 627260,
      "text": "好了"
    },
    {
      "ordinal": 146,
      "start_ms": 632060,
      "end_ms": 634439,
      "text": "咋了不行了怎么了"
    },
    {
      "ordinal": 147,
      "start_ms": 650580,
      "end_ms": 653480,
      "text": "你先把你说不用上学"
    },
    {
      "ordinal": 148,
      "start_ms": 653480,
      "end_ms": 654219,
      "text": "工商"
    },
    {
      "ordinal": 149,
      "start_ms": 656500,
      "end_ms": 659199,
      "text": "早上好呀"
    },
    {
      "ordinal": 150,
      "start_ms": 671120,
      "end_ms": 672250,
      "text": "拿水洗一遍"
    },
    {
      "ordinal": 151,
      "start_ms": 672250,
      "end_ms": 673380,
      "text": "再洗一洗"
    },
    {
      "ordinal": 152,
      "start_ms": 681260,
      "end_ms": 682319,
      "text": "还是"
    },
    {
      "ordinal": 153,
      "start_ms": 692700,
      "end_ms": 693560,
      "text": "早吃饱"
    },
    {
      "ordinal": 154,
      "start_ms": 693560,
      "end_ms": 695819,
      "text": "你嗯走啊走"
    },
    {
      "ordinal": 155,
      "start_ms": 696840,
      "end_ms": 699000,
      "text": "就挑在放在一边好了"
    },
    {
      "ordinal": 156,
      "start_ms": 699000,
      "end_ms": 702459,
      "text": "白色撕小条的那些还没有调料水"
    },
    {
      "ordinal": 157,
      "start_ms": 706800,
      "end_ms": 708560,
      "text": "他没有去吃过经验"
    },
    {
      "ordinal": 158,
      "start_ms": 718400,
      "end_ms": 719800,
      "text": "你现在在拍吗"
    },
    {
      "ordinal": 159,
      "start_ms": 730920,
      "end_ms": 732719,
      "text": "跟我登记一下"
    },
    {
      "ordinal": 160,
      "start_ms": 734680,
      "end_ms": 736480,
      "text": "我手机上记一下就行了"
    },
    {
      "ordinal": 161,
      "start_ms": 736480,
      "end_ms": 737640,
      "text": "你叫什么名字"
    },
    {
      "ordinal": 162,
      "start_ms": 747180,
      "end_ms": 749680,
      "text": "小孩子对小孩子都这"
    },
    {
      "ordinal": 163,
      "start_ms": 754640,
      "end_ms": 756599,
      "text": "但是后面这种辛苦"
    },
    {
      "ordinal": 164,
      "start_ms": 757420,
      "end_ms": 761710,
      "text": "那我们一楼那个吧台撤掉了"
    },
    {
      "ordinal": 165,
      "start_ms": 761710,
      "end_ms": 763079,
      "text": "改了桌子了"
    },
    {
      "ordinal": 166,
      "start_ms": 763100,
      "end_ms": 764840,
      "text": "萝卜在勾引你"
    },
    {
      "ordinal": 167,
      "start_ms": 764840,
      "end_ms": 767120,
      "text": "好妖娆的萝卜呀"
    },
    {
      "ordinal": 168,
      "start_ms": 770720,
      "end_ms": 776660,
      "text": "妖娆的萝卜不说不能洗澡洗"
    },
    {
      "ordinal": 169,
      "start_ms": 780320,
      "end_ms": 781479,
      "text": "让我来看"
    },
    {
      "ordinal": 170,
      "start_ms": 787100,
      "end_ms": 788459,
      "text": "好听真相"
    },
    {
      "ordinal": 171,
      "start_ms": 809620,
      "end_ms": 811599,
      "text": "爱的都出残影了"
    },
    {
      "ordinal": 172,
      "start_ms": 816560,
      "end_ms": 818160,
      "text": "这种青豆"
    },
    {
      "ordinal": 173,
      "start_ms": 833680,
      "end_ms": 835050,
      "text": "手上有道理"
    },
    {
      "ordinal": 174,
      "start_ms": 836820,
      "end_ms": 838579,
      "text": "多我发我肯定会呀"
    },
    {
      "ordinal": 175,
      "start_ms": 840260,
      "end_ms": 844780,
      "text": "平时是外卖为主才会"
    },
    {
      "ordinal": 176,
      "start_ms": 848120,
      "end_ms": 849719,
      "text": "一样的不一样"
    },
    {
      "ordinal": 177,
      "start_ms": 859180,
      "end_ms": 860620,
      "text": "我们放假都行"
    },
    {
      "ordinal": 178,
      "start_ms": 879240,
      "end_ms": 880460,
      "text": "找一下朋友"
    },
    {
      "ordinal": 179,
      "start_ms": 880460,
      "end_ms": 881339,
      "text": "找一下"
    },
    {
      "ordinal": 180,
      "start_ms": 884960,
      "end_ms": 885880,
      "text": "卧槽卧槽"
    },
    {
      "ordinal": 181,
      "start_ms": 887920,
      "end_ms": 888580,
      "text": "好了好了"
    },
    {
      "ordinal": 182,
      "start_ms": 888580,
      "end_ms": 889600,
      "text": "回到网吧"
    },
    {
      "ordinal": 183,
      "start_ms": 889600,
      "end_ms": 890180,
      "text": "到网"
    },
    {
      "ordinal": 184,
      "start_ms": 892060,
      "end_ms": 892860,
      "text": "没有点赞"
    },
    {
      "ordinal": 185,
      "start_ms": 892860,
      "end_ms": 894900,
      "text": "这个东西不赚钱吗"
    },
    {
      "ordinal": 186,
      "start_ms": 894900,
      "end_ms": 901099,
      "text": "你这个菜做的最后都没吃完啊"
    },
    {
      "ordinal": 187,
      "start_ms": 902000,
      "end_ms": 903670,
      "text": "还剩了1/3吧"
    },
    {
      "ordinal": 188,
      "start_ms": 903670,
      "end_ms": 908160,
      "text": "1/4那会小这个菜好评的"
    },
    {
      "ordinal": 189,
      "start_ms": 909540,
      "end_ms": 910440,
      "text": "还有花生嘛"
    },
    {
      "ordinal": 190,
      "start_ms": 910440,
      "end_ms": 911620,
      "text": "我不嘛"
    },
    {
      "ordinal": 191,
      "start_ms": 914580,
      "end_ms": 915860,
      "text": "手套在门口"
    },
    {
      "ordinal": 192,
      "start_ms": 917060,
      "end_ms": 919160,
      "text": "所以孩子要少拿点"
    },
    {
      "ordinal": 193,
      "start_ms": 923060,
      "end_ms": 925439,
      "text": "这个茄子他要是好"
    },
    {
      "ordinal": 194,
      "start_ms": 927680,
      "end_ms": 930340,
      "text": "但那些上手抓的会不会更上镜"
    },
    {
      "ordinal": 195,
      "start_ms": 930340,
      "end_ms": 931360,
      "text": "你这个没有问题"
    },
    {
      "ordinal": 196,
      "start_ms": 931360,
      "end_ms": 933040,
      "text": "但只要你手套就干净了"
    },
    {
      "ordinal": 197,
      "start_ms": 933040,
      "end_ms": 933760,
      "text": "就可以"
    },
    {
      "ordinal": 198,
      "start_ms": 945760,
      "end_ms": 947700,
      "text": "后面那个推喵也不错"
    },
    {
      "ordinal": 199,
      "start_ms": 947700,
      "end_ms": 950280,
      "text": "没事没事"
    },
    {
      "ordinal": 200,
      "start_ms": 955140,
      "end_ms": 957120,
      "text": "哪个世界都是一个免费吃饭的活计"
    },
    {
      "ordinal": 201,
      "start_ms": 957120,
      "end_ms": 957600,
      "text": "往里走"
    },
    {
      "ordinal": 202,
      "start_ms": 957600,
      "end_ms": 958699,
      "text": "那边有打饭的"
    },
    {
      "ordinal": 203,
      "start_ms": 960480,
      "end_ms": 964680,
      "text": "这是被一个小自然机器老板店主他妈混进来"
    },
    {
      "ordinal": 204,
      "start_ms": 964680,
      "end_ms": 965880,
      "text": "带金链子"
    },
    {
      "ordinal": 205,
      "start_ms": 965880,
      "end_ms": 966240,
      "text": "吃完了"
    },
    {
      "ordinal": 206,
      "start_ms": 973910,
      "end_ms": 975550,
      "text": "他比较喜欢做这个"
    },
    {
      "ordinal": 207,
      "start_ms": 975550,
      "end_ms": 977500,
      "text": "这个也特别适合这个配"
    },
    {
      "ordinal": 208,
      "start_ms": 977500,
      "end_ms": 979060,
      "text": "因为它很酸"
    },
    {
      "ordinal": 209,
      "start_ms": 979060,
      "end_ms": 982520,
      "text": "是一个大鸡腿就行"
    },
    {
      "ordinal": 210,
      "start_ms": 982820,
      "end_ms": 984620,
      "text": "吃个大还有点焦了吧"
    },
    {
      "ordinal": 211,
      "start_ms": 984620,
      "end_ms": 988640,
      "text": "朋友萝卜这个菜今天做焦了"
    },
    {
      "ordinal": 212,
      "start_ms": 988640,
      "end_ms": 990480,
      "text": "这也是凉拌菜哦"
    },
    {
      "ordinal": 213,
      "start_ms": 990480,
      "end_ms": 991560,
      "text": "不是他那个黑的"
    },
    {
      "ordinal": 214,
      "start_ms": 991560,
      "end_ms": 996890,
      "text": "应该是他可洋葱和那个他黑的"
    },
    {
      "ordinal": 215,
      "start_ms": 996890,
      "end_ms": 1004100,
      "text": "原因是他要和洋葱和胡萝卜一块炸了"
    },
    {
      "ordinal": 216,
      "start_ms": 1004100,
      "end_ms": 1010720,
      "text": "其他几个菜我觉得ok这个我在吃瓜超好吃"
    },
    {
      "ordinal": 217,
      "start_ms": 1010720,
      "end_ms": 1011200,
      "text": "觉得好吃"
    },
    {
      "ordinal": 218,
      "start_ms": 1011200,
      "end_ms": 1012880,
      "text": "刚才吃了一个会觉得有点硬"
    },
    {
      "ordinal": 219,
      "start_ms": 1012880,
      "end_ms": 1016030,
      "text": "但是太辣了"
    },
    {
      "ordinal": 220,
      "start_ms": 1016030,
      "end_ms": 1017050,
      "text": "很下饭的菜"
    },
    {
      "ordinal": 221,
      "start_ms": 1017050,
      "end_ms": 1018370,
      "text": "我觉得很好吃"
    },
    {
      "ordinal": 222,
      "start_ms": 1018370,
      "end_ms": 1021680,
      "text": "今天这个酱嗯可能味道不错"
    },
    {
      "ordinal": 223,
      "start_ms": 1021680,
      "end_ms": 1022520,
      "text": "看上去不好看"
    },
    {
      "ordinal": 224,
      "start_ms": 1022520,
      "end_ms": 1023900,
      "text": "但是味道应该蛮好吃的"
    },
    {
      "ordinal": 225,
      "start_ms": 1023900,
      "end_ms": 1028490,
      "text": "女王我喜欢你喜欢谁"
    },
    {
      "ordinal": 226,
      "start_ms": 1028490,
      "end_ms": 1030020,
      "text": "说不喜欢"
    },
    {
      "ordinal": 227,
      "start_ms": 1030020,
      "end_ms": 1032429,
      "text": "不喜欢我"
    },
    {
      "ordinal": 228,
      "start_ms": 1032429,
      "end_ms": 1033509,
      "text": "不吃肉的"
    },
    {
      "ordinal": 229,
      "start_ms": 1033509,
      "end_ms": 1035909,
      "text": "不能给优惠啊"
    },
    {
      "ordinal": 230,
      "start_ms": 1035909,
      "end_ms": 1036749,
      "text": "他不吃肉是吧"
    },
    {
      "ordinal": 231,
      "start_ms": 1036749,
      "end_ms": 1040040,
      "text": "一个小朋友他自己不吃肉的好吧"
    },
    {
      "ordinal": 232,
      "start_ms": 1041099,
      "end_ms": 1043030,
      "text": "因为是家长突然来了"
    },
    {
      "ordinal": 233,
      "start_ms": 1043030,
      "end_ms": 1046060,
      "text": "对面有专门的采访来记录一下您的意见"
    },
    {
      "ordinal": 234,
      "start_ms": 1046060,
      "end_ms": 1048790,
      "text": "采访一下保洁阿姨吧"
    },
    {
      "ordinal": 235,
      "start_ms": 1048790,
      "end_ms": 1050110,
      "text": "不是啥子个菜了"
    },
    {
      "ordinal": 236,
      "start_ms": 1050110,
      "end_ms": 1053120,
      "text": "做的人我们家乡的菜不太好吃"
    },
    {
      "ordinal": 237,
      "start_ms": 1053120,
      "end_ms": 1054870,
      "text": "就吃个菜好吃"
    },
    {
      "ordinal": 238,
      "start_ms": 1054870,
      "end_ms": 1057150,
      "text": "那么这种人都是吃辣的"
    },
    {
      "ordinal": 239,
      "start_ms": 1057150,
      "end_ms": 1058719,
      "text": "稍微加点辣"
    },
    {
      "ordinal": 240,
      "start_ms": 1059169,
      "end_ms": 1061089,
      "text": "好的口味再稍微重一点"
    },
    {
      "ordinal": 241,
      "start_ms": 1061089,
      "end_ms": 1062769,
      "text": "这一点点辣没有"
    },
    {
      "ordinal": 242,
      "start_ms": 1062769,
      "end_ms": 1064359,
      "text": "你们外地的人都不吃"
    },
    {
      "ordinal": 243,
      "start_ms": 1064359,
      "end_ms": 1066860,
      "text": "我们本地都喜欢吃啊"
    },
    {
      "ordinal": 244,
      "start_ms": 1066860,
      "end_ms": 1068150,
      "text": "对啊"
    },
    {
      "ordinal": 245,
      "start_ms": 1068150,
      "end_ms": 1069860,
      "text": "这个菜我也尝了"
    },
    {
      "ordinal": 246,
      "start_ms": 1069860,
      "end_ms": 1071540,
      "text": "你玩的这个萝卜不辣吗"
    },
    {
      "ordinal": 247,
      "start_ms": 1071540,
      "end_ms": 1072620,
      "text": "肯定不行"
    },
    {
      "ordinal": 248,
      "start_ms": 1072620,
      "end_ms": 1073820,
      "text": "不要吃的"
    },
    {
      "ordinal": 249,
      "start_ms": 1073820,
      "end_ms": 1074600,
      "text": "我不辣"
    },
    {
      "ordinal": 250,
      "start_ms": 1074600,
      "end_ms": 1077080,
      "text": "今天的菜品总体来说评价如何呢"
    },
    {
      "ordinal": 251,
      "start_ms": 1077080,
      "end_ms": 1078940,
      "text": "我评价是可以的"
    },
    {
      "ordinal": 252,
      "start_ms": 1078940,
      "end_ms": 1079480,
      "text": "能吃饱"
    },
    {
      "ordinal": 253,
      "start_ms": 1079480,
      "end_ms": 1080890,
      "text": "而且有肉有素"
    },
    {
      "ordinal": 254,
      "start_ms": 1080890,
      "end_ms": 1081700,
      "text": "可以的"
    },
    {
      "ordinal": 255,
      "start_ms": 1081700,
      "end_ms": 1082600,
      "text": "有荤有素"
    },
    {
      "ordinal": 256,
      "start_ms": 1082600,
      "end_ms": 1084400,
      "text": "还有汤还蛮好的"
    },
    {
      "ordinal": 257,
      "start_ms": 1084400,
      "end_ms": 1087230,
      "text": "我也安排怎么样的座位也挺好的啊"
    },
    {
      "ordinal": 258,
      "start_ms": 1087230,
      "end_ms": 1088100,
      "text": "行啊"
    },
    {
      "ordinal": 259,
      "start_ms": 1088100,
      "end_ms": 1089270,
      "text": "如果要改进的话"
    },
    {
      "ordinal": 260,
      "start_ms": 1089270,
      "end_ms": 1091830,
      "text": "那还有什么地方可以再调整一下"
    },
    {
      "ordinal": 261,
      "start_ms": 1091830,
      "end_ms": 1093660,
      "text": "我觉得米饭有点蒸的太糯了"
    },
    {
      "ordinal": 262,
      "start_ms": 1093660,
      "end_ms": 1096820,
      "text": "哈哈哈呃米饭可以再硬一点是吗对嗯"
    },
    {
      "ordinal": 263,
      "start_ms": 1096820,
      "end_ms": 1098800,
      "text": "口味的话稍微再甜一点"
    },
    {
      "ordinal": 264,
      "start_ms": 1098800,
      "end_ms": 1099820,
      "text": "改进的话"
    },
    {
      "ordinal": 265,
      "start_ms": 1101500,
      "end_ms": 1106060,
      "text": "那个素菜稍微有那么一点点咸啊"
    },
    {
      "ordinal": 266,
      "start_ms": 1106060,
      "end_ms": 1107620,
      "text": "口味稍微淡一点点"
    },
    {
      "ordinal": 267,
      "start_ms": 1109390,
      "end_ms": 1110980,
      "text": "那简单来说"
    },
    {
      "ordinal": 268,
      "start_ms": 1110980,
      "end_ms": 1112030,
      "text": "如果十分的话"
    },
    {
      "ordinal": 269,
      "start_ms": 1112030,
      "end_ms": 1115009,
      "text": "你愿意打几分八分啊"
    },
    {
      "ordinal": 270,
      "start_ms": 1115009,
      "end_ms": 1115849,
      "text": "这地菜啊"
    },
    {
      "ordinal": 271,
      "start_ms": 1115849,
      "end_ms": 1119030,
      "text": "这地菜呀八分八分9.9啊"
    },
    {
      "ordinal": 272,
      "start_ms": 1119030,
      "end_ms": 1122150,
      "text": "十分的话打九分达到99分"
    },
    {
      "ordinal": 273,
      "start_ms": 1122150,
      "end_ms": 1124610,
      "text": "嘿嘿嘿嘿嘿好啊"
