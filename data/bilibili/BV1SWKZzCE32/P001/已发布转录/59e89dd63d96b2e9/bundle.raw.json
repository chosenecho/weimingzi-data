{"segments":[{"start":0.16,"end":3.3,"text":"哎我们今天要讲的就是说职业革命家"},{"start":3.66,"end":7.58,"text":"额不是说在他获得了政权之后"},{"start":7.58,"end":8.46,"text":"他才掌权"},{"start":8.46,"end":11.399,"text":"职业革命家一定是"},{"start":12.239,"end":15.219,"text":"只要当他是成为职业革命家的一瞬间"},{"start":15.219,"end":17.079,"text":"他一定是有有权利的"},{"start":17.079,"end":18.239,"text":"只不过是非正式权利"},{"start":18.239,"end":20.04,"text":"或者说非法权利"},{"start":20.04,"end":21.8,"text":"他一定是掌握权力的"},{"start":21.8,"end":25.58,"text":"因为只要他是真的啊"},{"start":26.66,"end":27.42,"text":"这他是真的"},{"start":27.42,"end":28.82,"text":"那么既然他是真的的话"},{"start":28.82,"end":29.92,"text":"在这个前提之下"},{"start":29.92,"end":36.04,"text":"他一定会能够由于被压迫阶级存在的普遍性"},{"start":36.04,"end":37.06,"text":"广泛性"},{"start":37.06,"end":41.04,"text":"这些被压迫阶级一定会受到他的感召"},{"start":41.04,"end":42.7,"text":"就是他的动员"},{"start":42.7,"end":44.84,"text":"服从他的命令啊"},{"start":44.84,"end":46.58,"text":"那么至于一个职业革命家的职业性"},{"start":46.58,"end":48.16,"text":"到底啥叫职业性呢"},{"start":48.16,"end":49.84,"text":"就是"},{"start":51.44,"end":55.08,"text":"他其实整个生活附庸于他的革命活动"},{"start":55.08,"end":58.34,"text":"或者说他的革命活动作为他的主轴"},{"start":58.34,"end":60.32,"text":"贯穿于他整个生活"},{"start":60.74,"end":62.02,"text":"这只是一部分了"},{"start":63.02,"end":65.64,"text":"并且他要围绕这个主轴"},{"start":65.64,"end":69.91,"text":"将其个人的生活扩展为群体的生活啊"},{"start":69.91,"end":72.79,"text":"使得这个职业活动变成有组织的职业活动"},{"start":72.79,"end":78.44,"text":"甚至进一步呢呃这种扩展为组织的职业活动"},{"start":78.44,"end":82.74,"text":"还具有对于个人的情感伦理价值"},{"start":82.74,"end":83.99,"text":"道德包袱"},{"start":83.99,"end":87.13,"text":"还有各种其他的价值超越性"},{"start":87.13,"end":89.57,"text":"并且还重新去设定谁的价值"},{"start":89.57,"end":94.49,"text":"在群体组织当中创制新的这些价值的"},{"start":95.97,"end":99.17,"text":"新的历史版本看吧"},{"start":99.17,"end":100.17,"text":"简单来讲是这样的"},{"start":100.17,"end":101.45,"text":"职业性"},{"start":103.78,"end":106.26,"text":"由于只要你符合这种职业性"},{"start":106.26,"end":111.97,"text":"那你在这个围绕着这个呃标杆的"},{"start":111.97,"end":117.69,"text":"或者说这个主线的职业活动的职业社群"},{"start":117.69,"end":120.45,"text":"职业就是说职业性的那种团体组织当中"},{"start":120.45,"end":124.23,"text":"一定具有绝对的征召和动员能力"},{"start":124.23,"end":126.94,"text":"嗯甩都甩不掉"},{"start":126.94,"end":129.38,"text":"我现在来讲唉"},{"start":133.8,"end":136.92,"text":"所以我们要说的是呃"},{"start":140.02,"end":142.95,"text":"职业革命家在一开始"},{"start":142.95,"end":145.95,"text":"就已经处在和权力的缠斗当中了"},{"start":145.95,"end":148.19,"text":"不是和敌对性的什么"},{"start":148.19,"end":151.71,"text":"他就要反抗的这个呃"},{"start":151.71,"end":158.519,"text":"某些政治实体或者某些利益板结的呃群体"},{"start":158.519,"end":160.379,"text":"而首先就是和他自身"},{"start":160.379,"end":163.599,"text":"和他自身所淬炼凝聚出来的权力关系"},{"start":163.599,"end":167.54,"text":"这种权利本身肯定是异化性的"},{"start":168.51,"end":172.04,"text":"职业哥们家首要要做的其实是自我斗争"},{"start":172.04,"end":175.64,"text":"是自己和自己在权力关系网络当中的"},{"start":175.64,"end":180.1,"text":"异化出来的形象和身份的斗争"},{"start":180.1,"end":182.74,"text":"他必须要抽出额外的力量来"},{"start":185.8,"end":191.39,"text":"或者沦为一个交易性的宫廷"},{"start":191.39,"end":194.59,"text":"小型的宫廷啊"},{"start":195.59,"end":198.47,"text":"这些革命家需要不停的去"},{"start":198.47,"end":202.91,"text":"超出他自身的权力面相"},{"start":203.41,"end":205.05,"text":"在这个意义上讲"},{"start":205.05,"end":209.47,"text":"这革命家兼具君主先知呃"},{"start":209.47,"end":212.645,"text":"诗人和这个"},{"start":214.28,"end":217.2,"text":"辅佐信的贤哲"},{"start":219.16,"end":220.94,"text":"还有我还要扯扯一个什么"},{"start":220.94,"end":224.9,"text":"甚至说父亲甚至说是公共娼妓"},{"start":224.9,"end":227.99,"text":"就是那种神庙里面圣女啊"},{"start":227.99,"end":234.199,"text":"甚至说是啊啊孩子所有人的共同的孩子"},{"start":234.199,"end":235.719,"text":"最后一个孩子啊"},{"start":235.719,"end":239.86,"text":"类似这样一种所有这些形象的一个交底"},{"start":239.86,"end":243.18,"text":"那么职业革命家是要不停的超出这些"},{"start":243.18,"end":249.579,"text":"历史范式的这些局限性的这些形象的束缚的啊"},{"start":249.579,"end":256.47,"text":"他会要让自身的存在变成是一个呃开显性的场"},{"start":256.47,"end":258.69,"text":"然后是要让崭新的价值"},{"start":258.69,"end":260.2,"text":"崭新的绝对性的"},{"start":260.2,"end":262.44,"text":"个人情感性的关联性的啊"},{"start":262.44,"end":263.84,"text":"群体关联性的啊"},{"start":263.84,"end":267.27,"text":"以及个个体和公共事务的啊"},{"start":267.27,"end":269.74,"text":"正义忠诚啊"},{"start":269.76,"end":274.61,"text":"这些各个方向的各个层级的这些绝对性的价值"},{"start":274.61,"end":277.99,"text":"在他那里得到一些原型版本"},{"start":277.99,"end":281.06,"text":"更新出来的新的原型版本"},{"start":281.3,"end":281.98,"text":"也就是说"},{"start":281.98,"end":287.19,"text":"这职业革命家应当去有能力去创造新的婚姻"},{"start":287.19,"end":288.93,"text":"新的爱情"},{"start":288.93,"end":290.73,"text":"新的友谊"},{"start":290.73,"end":292.09,"text":"新的忠诚"},{"start":292.09,"end":293.01,"text":"新的服从"},{"start":293.01,"end":294.67,"text":"新的正义"},{"start":295.27,"end":296.29,"text":"新的偏袒"},{"start":296.29,"end":300.29,"text":"甚至说啊新的憎恨啊"},{"start":300.29,"end":303.26,"text":"新的安定性"},{"start":303.26,"end":304.42,"text":"新的秩序"},{"start":304.42,"end":306.36,"text":"新的幸福"},{"start":306.8,"end":309.04,"text":"他甚至有这种"},{"start":309.04,"end":313.58,"text":"他需要有这种气度和这样的一种忍耐"},{"start":313.58,"end":316.22,"text":"忍耐这些新的关联"},{"start":317.3,"end":322.61,"text":"新的范式诞生时降临时候的那无限的痛苦"},{"start":322.61,"end":325.75,"text":"他是一个妊娠者孕育者"},{"start":325.95,"end":326.75,"text":"所以某种人一样"},{"start":326.75,"end":330.39,"text":"他像个共同体的一个新的母亲呐"},{"start":330.39,"end":332.91,"text":"兽是第一个母亲"},{"start":332.91,"end":336.68,"text":"我那个人他有这样一种"},{"start":336.68,"end":339.22,"text":"我们讲的就是这个意义上的革命家"},{"start":339.22,"end":339.92,"text":"职业革命家"},{"start":339.92,"end":343.69,"text":"他不仅仅是政治革命家或者军事统领袖"},{"start":343.69,"end":344.09,"text":"意义上的"},{"start":344.09,"end":345.33,"text":"它是某种生活方式"},{"start":345.33,"end":348.45,"text":"或者某种存在的价值基准"},{"start":348.45,"end":354.709,"text":"的一个一个创制者和一个接生者"},{"start":354.709,"end":356.549,"text":"或者一个认生者"},{"start":356.549,"end":363.33,"text":"唉总之这个过程每一个绝对性的降临"},{"start":363.33,"end":366.09,"text":"或者说他的重新的结构和呈现"},{"start":366.09,"end":372.02,"text":"都包含着欲望的异化扭曲"},{"start":374.06,"end":378.35,"text":"啊一个解放性的一个努力"},{"start":378.35,"end":381.07,"text":"是试图去使得这样的异化和扭曲"},{"start":381.07,"end":386.02,"text":"为其更长远的计划所用的服从于这种计划"},{"start":386.02,"end":389.36,"text":"并且转化成组织的共同体的合力"},{"start":389.36,"end":397.63,"text":"以及和整个社会的共鸣和相互的包容啊"},{"start":397.63,"end":400.77,"text":"是能在现实当中生根落地的"},{"start":402.42,"end":405.02,"text":"所以我们并不惧怕与权力关"},{"start":405.02,"end":408.59,"text":"权力关系的扭结甚至扭曲"},{"start":408.59,"end":415.39,"text":"我们也并不惧怕于组织和这个活动当中的额"},{"start":415.52,"end":421.76,"text":"这个拥挤和散漫和"},{"start":424.8,"end":428.44,"text":"秩序本身所带来的一些倾轧和践踏"},{"start":428.44,"end":430.72,"text":"这东西就存在很正常啊"},{"start":430.72,"end":432.0,"text":"历史的某一个环节"},{"start":432.0,"end":433.6,"text":"每一个这"},{"start":436.12,"end":438.24,"text":"你哪怕洗澡的时候"},{"start":438.24,"end":440.76,"text":"你搓身上的哪块哪块这个污渍"},{"start":440.76,"end":443.669,"text":"你就感觉搓的差不多就行了"},{"start":443.669,"end":444.949,"text":"搓的太多的皮层"},{"start":444.949,"end":445.469,"text":"搓的太少了"},{"start":445.469,"end":446.269,"text":"感觉没搓干净"},{"start":446.269,"end":448.029,"text":"但是总体来讲差不多"},{"start":452.99,"end":455.21,"text":"给予活动家啊"},{"start":455.21,"end":456.19,"text":"作为职业革命家"},{"start":456.19,"end":463.68,"text":"存在和活动的机遇的窗口只有10~25年嗯"},{"start":463.68,"end":466.52,"text":"历史是非常残酷的"},{"start":466.52,"end":468.7,"text":"当你足够成熟的时候"},{"start":468.7,"end":470.12,"text":"你可能要到30多岁"},{"start":470.12,"end":470.98,"text":"40多岁"},{"start":470.98,"end":475.65,"text":"然后然后你要足够幸运的免幸免于难"},{"start":475.65,"end":479.63,"text":"不停的去发挥相应的影响和作用"},{"start":479.63,"end":482.034,"text":"那其实也就十几20年的时间"},{"start":483.8,"end":485.8,"text":"然后你会背弃你自身"},{"start":485.8,"end":490.52,"text":"然后你会失败或者被消灭"},{"start":491.38,"end":496.049,"text":"所以我要说的是呃"},{"start":496.889,"end":499.289,"text":"职业革命家不应当惧怕权力的异化"},{"start":500.329,"end":506.669,"text":"也不应当就是从这些斗争当中怯懦的退场"},{"start":506.669,"end":507.789,"text":"因为这个斗争"},{"start":507.789,"end":512.289,"text":"那是和自身的斗争和生存是一个底色的"},{"start":512.289,"end":516.049,"text":"他本来就是生存的职责"},{"start":516.049,"end":518.14,"text":"或者说"},{"start":523.159,"end":525.25,"text":"他就是本来就是啊"},{"start":525.25,"end":527.85,"text":"这就是本来就是不断的去设立"},{"start":527.85,"end":531.81,"text":"本来就是不断的去跳到时间之前"},{"start":531.81,"end":537.51,"text":"抢在时间之前去给出顺序"},{"start":537.51,"end":539.25,"text":"给出秩序"},{"start":539.25,"end":541.42,"text":"给出优先性"},{"start":541.82,"end":545.66,"text":"这个过程是每一个职业革命家"},{"start":545.66,"end":550.08,"text":"都需要去深思和创制的"},{"start":551.4,"end":553.28,"text":"或者说我们说去闯荡"},{"start":553.28,"end":555.2,"text":"甚至我说再夸张一点"},{"start":555.2,"end":558.04,"text":"是去流浪而被"},{"start":559.51,"end":565.019,"text":"而为幸运的获救的就是这个过程"},{"start":565.019,"end":566.539,"text":"他一定是如此的"},{"start":566.539,"end":570.4,"text":"那么如何才能增加获救的概率呢"},{"start":572.66,"end":574.98,"text":"应当坦诚的呼救"},{"start":575.46,"end":579.94,"text":"这种坦诚的呼救会成为最为热烈的"},{"start":581.1,"end":585.14,"text":"嘶就是你当当你去帮助救助别人的时候"},{"start":585.14,"end":587.06,"text":"实际上是职业革命在呼救啊"},{"start":587.06,"end":590.05,"text":"他在在进行一种于求"},{"start":590.05,"end":591.63,"text":"他在历史当中迷失"},{"start":591.63,"end":593.77,"text":"或者说在自身当中迷失了"},{"start":593.77,"end":596.01,"text":"在自身的扭结出来的这种权力"},{"start":596.01,"end":598.375,"text":"强力当中迷失了"},{"start":599.76,"end":601.76,"text":"呃我不是说我迷失了啊"},{"start":601.76,"end":603.16,"text":"我我还是比较坚定的"},{"start":603.16,"end":605.18,"text":"我能看清清楚各式各样的方向"},{"start":605.18,"end":606.94,"text":"我没有说我是迷失的"},{"start":606.94,"end":611.4,"text":"我只说是会不断的不断的有这样的环节啊"},{"start":611.4,"end":613.16,"text":"有这样的照面"},{"start":613.16,"end":614.92,"text":"有这样的遗忘之海"},{"start":614.92,"end":618.68,"text":"不断的会把你淹没好吧"},{"start":618.68,"end":620.36,"text":"那我作为过来人"},{"start":620.36,"end":622.62,"text":"或者说正在途中者"},{"start":622.62,"end":627.5,"text":"我有必要把历史的实情向你们袒露啊"},{"start":627.5,"end":630.98,"text":"这些东西是非常正常的"},{"start":630.98,"end":632.98,"text":"因为"},{"start":634.3,"end":635.7,"text":"一切都是必要的"},{"start":635.7,"end":636.36,"text":"好吧"},{"start":636.36,"end":637.58,"text":"讲到这里啊"}],"source":"subtitle"}
