{"segments":[{"start":26.56,"end":29.14,"text":"啊"},{"start":46.96,"end":48.36,"text":"白云悠悠"},{"start":48.36,"end":49.62,"text":"一路飞去"},{"start":49.62,"end":51.18,"text":"秋风起"},{"start":52.2,"end":54.2,"text":"花儿都谢了"},{"start":54.2,"end":56.18,"text":"燕子都去了"},{"start":57.2,"end":59.66,"text":"漫漫长夜黯然相思"},{"start":59.66,"end":61.92,"text":"秋风里"},{"start":61.92,"end":64.23,"text":"月儿都倦了"},{"start":64.23,"end":67.25,"text":"鱼儿都睡了"},{"start":67.65,"end":72.11,"text":"波月见诺言"},{"start":72.72,"end":75.41,"text":"搜云空余"},{"start":75.41,"end":81.92,"text":"闲在这般凄凉的午夜"},{"start":82.7,"end":87.16,"text":"苍白的语言"},{"start":89.32,"end":92.76,"text":"这秋风无依无靠"},{"start":92.76,"end":95.28,"text":"无端无聊"},{"start":95.28,"end":97.94,"text":"不说不笑"},{"start":98.4,"end":101.93,"text":"苦恼苦寂灭"},{"start":101.93,"end":104.63,"text":"道真难分"},{"start":104.63,"end":110.4,"text":"难料什么这么说"},{"start":110.74,"end":112.38,"text":"无需知道"},{"start":113.4,"end":115.82,"text":"几乎明了"},{"start":115.82,"end":117.92,"text":"早就分享"},{"start":117.92,"end":121.52,"text":"这秋风让目光"},{"start":121.52,"end":128.3,"text":"你个沙渗出了迷惘"},{"start":130.479,"end":131.879,"text":"你不肯说"},{"start":133.199,"end":135.46,"text":"你不肯说"},{"start":135.5,"end":140.14,"text":"你不肯说心底的思量"},{"start":140.46,"end":142.68,"text":"你不肯说"},{"start":142.96,"end":144.36,"text":"你不肯说"},{"start":145.68,"end":149.54,"text":"你不肯说心底的思量"},{"start":150.42,"end":155.46,"text":"白云悠悠一缕飞去千万里"},{"start":155.46,"end":158.04,"text":"花儿不见了"},{"start":158.04,"end":160.35,"text":"燕子不见了"},{"start":160.35,"end":161.94,"text":"漫漫长夜"},{"start":161.94,"end":164.96,"text":"伊人相思在梦里"},{"start":165.08,"end":167.72,"text":"月儿不见了"},{"start":167.72,"end":170.7,"text":"月儿不见了"},{"start":170.86,"end":172.26,"text":"到如今"},{"start":172.26,"end":173.52,"text":"秋风破"},{"start":174.72,"end":177.08,"text":"月渐落雁"},{"start":177.96,"end":182.04,"text":"搜云空余弦"},{"start":182.08,"end":187.08,"text":"只听见起亮的屋檐"},{"start":188.02,"end":192.9,"text":"苍白的语言若风"},{"start":192.9,"end":197.2,"text":"鼓楼战士长夜"},{"start":198.08,"end":201.82,"text":"天下竟无眠"},{"start":202.1,"end":203.56,"text":"下着飘零"},{"start":204.76,"end":212.02,"text":"躺好荒野上车挂林间"},{"start":215.96,"end":219.78,"text":"8月秋高风怒号"},{"start":219.78,"end":223.86,"text":"卷我屋上三重茅"},{"start":223.86,"end":227.38,"text":"入竹去归来"},{"start":227.38,"end":230.84,"text":"倚仗自叹叹息"},{"start":230.84,"end":236.42,"text":"安得广厦千万寒的光"},{"start":236.42,"end":238.16,"text":"杀千换"},{"start":238.16,"end":240.5,"text":"大悲天下"},{"start":240.5,"end":243.02,"text":"寒士俱欢"},{"start":243.02,"end":244.94,"text":"变俱欢"},{"start":244.94,"end":247.46,"text":"燕南村群童"},{"start":247.46,"end":254.8,"text":"人们对面为盗贼为盗贼"},{"start":256.0,"end":258.16,"text":"你不肯说"},{"start":258.32,"end":259.72,"text":"你不肯说"},{"start":261.04,"end":265.289,"text":"也不肯说心底的思量"},{"start":265.929,"end":268.06,"text":"你不肯说"},{"start":268.22,"end":269.68,"text":"你不肯说"},{"start":270.88,"end":274.68,"text":"你不肯说心底的思量"},{"start":275.74,"end":278.4,"text":"你不肯说"}],"source":"subtitle"}
