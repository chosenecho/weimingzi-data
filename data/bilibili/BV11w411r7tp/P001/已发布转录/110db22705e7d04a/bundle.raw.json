{"segments":[{"start":0.08,"end":2.66,"text":"我有许多问题想问一问"},{"start":2.66,"end":4.1,"text":"我学哲学的嘛"},{"start":4.1,"end":7.42,"text":"善问好学善问"},{"start":7.58,"end":9.4,"text":"那么我一个个问吧"},{"start":10.66,"end":12.64,"text":"就是说一个问题"},{"start":12.64,"end":16.49,"text":"就是说我有个朋友啊"},{"start":16.49,"end":17.36,"text":"非常经典的"},{"start":17.36,"end":18.32,"text":"我有个朋友"},{"start":18.32,"end":21.5,"text":"他住在某国某省某县"},{"start":21.5,"end":25.43,"text":"某市某县某个街道"},{"start":26.84,"end":28.42,"text":"某个区某个街道"},{"start":28.42,"end":35.01,"text":"那有一天呢啊他忽然被他所居住的"},{"start":35.01,"end":44.24,"text":"以及他主要他的就是另外隔壁另外一个街道的"},{"start":46.44,"end":49.04,"text":"把他给怎么样"},{"start":49.87,"end":51.99,"text":"隔壁另外一个街道的派出所"},{"start":51.99,"end":57.64,"text":"把他给强制强制传唤了"},{"start":58.22,"end":60.97,"text":"强制传唤强制传唤"},{"start":60.97,"end":63.33,"text":"那我们就想知道呃"},{"start":63.33,"end":65.37,"text":"说是有人报警"},{"start":65.37,"end":68.13,"text":"说这个人呢是我那个朋友呢"},{"start":68.13,"end":71.66,"text":"是侵犯了别人的隐私权"},{"start":72.12,"end":75.23,"text":"但是关键问题我就问你第一个问题啊"},{"start":75.23,"end":78.92,"text":"就是说据我们所知"},{"start":80.28,"end":86.11,"text":"据大家公就是他的周围人很多人所知啊"},{"start":86.63,"end":91.96,"text":"这个侵侵犯那个举报举报人的隐私权"},{"start":91.96,"end":94.18,"text":"就算有可能侵犯吧"},{"start":94.18,"end":95.74,"text":"那有这个嫌疑的"},{"start":95.74,"end":100.03,"text":"这些活动发生在他自己所居住的那个街道"},{"start":100.03,"end":100.96,"text":"也就他家里"},{"start":100.96,"end":107.37,"text":"他用的那台电脑上和要对这个人"},{"start":107.37,"end":109.47,"text":"就跟那个派出所没关系"},{"start":109.47,"end":111.6,"text":"派出所是隔壁街道的派出所"},{"start":111.6,"end":113.61,"text":"轮不到那个派出所呀"},{"start":113.61,"end":116.19,"text":"你就说他的犯罪实施地"},{"start":116.19,"end":118.94,"text":"他的居住地对不对"},{"start":118.94,"end":122.36,"text":"他的甚至说这个报案人的报案地"},{"start":122.36,"end":125.63,"text":"直接报案的那个派出所是他居住的那个派出所"},{"start":125.63,"end":130.15,"text":"竟然是另外一个派出所下了强制传唤令"},{"start":130.15,"end":133.16,"text":"把我这朋友给抓走了"},{"start":134.1,"end":135.53,"text":"这是第一个问题"},{"start":135.53,"end":137.24,"text":"怎么会出现这种问题呢"},{"start":137.24,"end":142.14,"text":"这个在执法上面是一个很严重的一个问题"},{"start":142.3,"end":145.32,"text":"你这你这你这个派出所又你又没有"},{"start":145.32,"end":147.78,"text":"又不是你接到的报案"},{"start":149.44,"end":150.66,"text":"啊是那个人"},{"start":150.66,"end":153.39,"text":"他是隔壁那派出所"},{"start":153.85,"end":155.97,"text":"犯罪行为又不是在你这实施的"},{"start":157.05,"end":157.89,"text":"有嫌疑的"},{"start":157.89,"end":158.49,"text":"有嫌疑的"},{"start":158.49,"end":159.39,"text":"也不是犯罪的"},{"start":159.39,"end":161.76,"text":"当然是派出所管的行政事件"},{"start":161.76,"end":164.46,"text":"他这个行政侵犯隐私权"},{"start":164.46,"end":167.16,"text":"是个治安管理处罚意义上的"},{"start":167.16,"end":169.23,"text":"这个行政的事由"},{"start":169.23,"end":172.52,"text":"也不发生在你这个派出所的辖区"},{"start":172.74,"end":177.23,"text":"那这为什么是你这个派出所去去啊"},{"start":177.75,"end":179.03,"text":"明白吗"},{"start":179.03,"end":180.8,"text":"这是第一点啊"},{"start":180.8,"end":184.42,"text":"第一个问题管辖地的问题"},{"start":184.42,"end":187.54,"text":"那么第二个问题是第二个问题"},{"start":187.54,"end":191.23,"text":"是这个侵犯隐私的这件事情"},{"start":191.23,"end":197.06,"text":"依然正在法律法院上进行审理"},{"start":197.06,"end":198.29,"text":"正在审理中"},{"start":198.29,"end":200.15,"text":"到底有没有侵犯隐私"},{"start":200.15,"end":201.5,"text":"有没有侵犯名誉"},{"start":201.5,"end":203.93,"text":"法院他有裁断的"},{"start":203.93,"end":206.18,"text":"有裁决的"},{"start":206.94,"end":211.6,"text":"在这个法院的判决裁判过程当中"},{"start":212.06,"end":217.69,"text":"你如果你的这个派出所直接说把人抓了逮起来"},{"start":217.69,"end":219.25,"text":"然后咱们施加处罚"},{"start":220.69,"end":227.0,"text":"最后司法机关判决没有侵犯没问题"},{"start":227.64,"end":229.82,"text":"那两个相互冲突啊"},{"start":229.82,"end":232.22,"text":"你用治安管理处罚法处罚了他"},{"start":232.22,"end":235.34,"text":"但是法院的判决认为他没问题"},{"start":235.34,"end":236.74,"text":"没有侵犯"},{"start":237.23,"end":238.57,"text":"相互冲突怎么办"},{"start":240.07,"end":241.15,"text":"这是第二个问题"},{"start":241.15,"end":243.67,"text":"他这个案子正在审理"},{"start":244.07,"end":246.76,"text":"当然按照治安管理处罚条例啊"},{"start":246.76,"end":249.67,"text":"治安管理处罚法里面好像是第42条"},{"start":249.67,"end":250.6,"text":"第一款"},{"start":250.6,"end":253.14,"text":"哪一条哪一款我记不得了"},{"start":253.14,"end":255.24,"text":"是可以是可以"},{"start":255.24,"end":257.1,"text":"这个公安机关是可以"},{"start":257.1,"end":259.38,"text":"就是有点像像检察院一样的"},{"start":259.38,"end":260.7,"text":"就提起公诉一样的"},{"start":260.7,"end":262.85,"text":"公安机关可以自己啊"},{"start":262.85,"end":264.95,"text":"就是说啊保境安民嘛"},{"start":264.95,"end":266.45,"text":"由此由此责任"},{"start":266.45,"end":268.75,"text":"由此义务也有此权利"},{"start":268.75,"end":270.49,"text":"甚至不需要有人"},{"start":271.63,"end":272.53,"text":"不需要有人举报"},{"start":272.53,"end":274.33,"text":"那你怎么掌握的这个办案线索呢"},{"start":274.33,"end":275.11,"text":"对不对啊"},{"start":275.11,"end":276.52,"text":"有得有人举报"},{"start":276.52,"end":278.2,"text":"那又回到前面有问题了"},{"start":278.2,"end":279.58,"text":"怎么管辖地的问题呢"},{"start":279.58,"end":280.42,"text":"你不归你管了"},{"start":280.42,"end":281.68,"text":"那应该是个派出所管"},{"start":281.68,"end":283.87,"text":"那就轮到你这个派出所"},{"start":283.87,"end":284.89,"text":"所以第二个问题"},{"start":284.89,"end":290.549,"text":"就是说他正在司法审理过程当中"},{"start":291.009,"end":293.189,"text":"正说这个一审当中"},{"start":293.189,"end":296.58,"text":"双方都提出是可以和解的"},{"start":296.98,"end":301.77,"text":"你竟然要直接对他进行一个治安处罚行政"},{"start":301.77,"end":306.709,"text":"甚至说这个治安处罚里面包括行政拘留哎"},{"start":306.709,"end":308.179,"text":"这是何道理"},{"start":309.319,"end":310.71,"text":"是道理"},{"start":311.11,"end":313.95,"text":"因为有可能出现相互冲突的啊"},{"start":315.03,"end":315.75,"text":"这第二个疑问"},{"start":315.75,"end":321.58,"text":"第三个疑问是为什么一上来就是强制传唤"},{"start":321.58,"end":323.53,"text":"强制传唤令上面写道"},{"start":323.53,"end":325.42,"text":"根据什么都这样管理"},{"start":325.42,"end":329.39,"text":"处罚条例第70几条还是多少多少条的第一款"},{"start":329.39,"end":331.19,"text":"在第一次传唤"},{"start":331.19,"end":332.99,"text":"第一次传唤不是强制传唤"},{"start":332.99,"end":336.05,"text":"是打电话叫你到那边派出所去啊"},{"start":336.05,"end":338.679,"text":"这个说清楚案情"},{"start":338.679,"end":341.439,"text":"第一次传唤不到的情况下"},{"start":341.439,"end":343.959,"text":"或者有意逃避第一次传唤的情况下"},{"start":343.959,"end":347.11,"text":"你才可以对它进行强制传唤"},{"start":