    {
      "ordinal": 78,
      "start_ms": 201630,
      "end_ms": 202890,
      "text": "吹嘘他"
    },
    {
      "ordinal": 79,
      "start_ms": 202890,
      "end_ms": 204330,
      "text": "那是他的社会地位"
    },
    {
      "ordinal": 80,
      "start_ms": 204330,
      "end_ms": 205650,
      "text": "那是他的自我"
    },
    {
      "ordinal": 81,
      "start_ms": 205650,
      "end_ms": 207060,
      "text": "那是他人生的骄傲"
    },
    {
      "ordinal": 82,
      "start_ms": 207060,
      "end_ms": 208560,
      "text": "他当然想回去啊"
    },
    {
      "ordinal": 83,
      "start_ms": 210260,
      "end_ms": 211840,
      "text": "所以他不能公开"
    },
    {
      "ordinal": 84,
      "start_ms": 211840,
      "end_ms": 214240,
      "text": "这个人不敢公开"
    },
    {
      "ordinal": 85,
      "start_ms": 214240,
      "end_ms": 216860,
      "text": "不敢让世人知道他是谁"
