    {
      "ordinal": 64,
      "start_ms": 170880,
      "end_ms": 173339,
      "text": "你度过这个危机了哦"
    },
    {
      "ordinal": 65,
      "start_ms": 173339,
      "end_ms": 174719,
      "text": "你现在可能40多岁吧"
    },
    {
      "ordinal": 66,
      "start_ms": 174719,
      "end_ms": 175709,
      "text": "40岁左右"
    },
    {
      "ordinal": 67,
      "start_ms": 175709,
      "end_ms": 177939,
      "text": "这个人40岁左右的"
