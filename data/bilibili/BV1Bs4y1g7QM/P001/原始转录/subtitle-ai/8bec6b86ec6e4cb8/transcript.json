    {
      "ordinal": 40,
      "start_ms": 98570,
      "end_ms": 100289,
      "text": "你得让别人知道你是谁"
    },
    {
      "ordinal": 41,
      "start_ms": 100289,
      "end_ms": 101519,
      "text": "你是谁"
    },
    {
      "ordinal": 42,
      "start_ms": 101519,
      "end_ms": 102929,
      "text": "你讲这些东西"
    },
    {
      "ordinal": 43,
      "start_ms": 102929,
      "end_ms": 104819,
      "text": "你自己说这些东西你要负责"
    },
    {
      "ordinal": 44,
      "start_ms": 104819,
      "end_ms": 107119,
      "text": "你要为你自己的言论负责"
    },
    {
      "ordinal": 45,
      "start_ms": 108320,
      "end_ms": 116220,
      "text": "我非常有理由去怀疑这个人还准备回去"
    },
    {
      "ordinal": 46,
      "start_ms": 116220,
      "end_ms": 117360,
      "text": "还想回去啊"
    },
    {
      "ordinal": 47,
      "start_ms": 117360,
      "end_ms": 118410,
      "text": "很想回去"
    },
    {
      "ordinal": 48,
      "start_ms": 118410,
      "end_ms": 122010,
      "text": "这这这这个没出息的人还很想回"
    },
    {
      "ordinal": 49,
      "start_ms": 122010,
      "end_ms": 123530,
      "text": "还很啊"
    },
    {
      "ordinal": 50,
      "start_ms": 123530,
      "end_ms": 125280,
      "text": "很想想回去"
    },
    {
      "ordinal": 51,
      "start_ms": 126100,
      "end_ms": 131550,
      "text": "所以他怕在互联网上公开实名地说那些话"
    },
    {
      "ordinal": 52,
      "start_ms": 131550,
      "end_ms": 134720,
      "text": "留下把柄啊"
    },
    {
      "ordinal": 53,
      "start_ms": 134720,
      "end_ms": 137520,
      "text": "这些把柄会让他回不去"
    },
    {
      "ordinal": 54,
      "start_ms": 138559,
      "end_ms": 139929,
      "text": "回哪里去"
    },
    {
      "ordinal": 55,
      "start_ms": 139929,
      "end_ms": 141939,
      "text": "回他们主子的世界"
    },
    {
      "ordinal": 56,
      "start_ms": 141939,
      "end_ms": 143379,
      "text": "回资产阶级的世界"
    },
    {
      "ordinal": 57,
      "start_ms": 143379,
      "end_ms": 144580,
      "text": "他想回去"
    },
    {
      "ordinal": 58,
      "start_ms": 145540,
      "end_ms": 148820,
      "text": "我没见过全天下没见过这么无耻的人"
    },
    {
      "ordinal": 59,
      "start_ms": 157800,
      "end_ms": 159740,
      "text": "你以前是干什么工作的"
    },
    {
      "ordinal": 60,
      "start_ms": 159740,
      "end_ms": 160940,
      "text": "你失了业了"
    },
    {
      "ordinal": 61,
      "start_ms": 160940,
      "end_ms": 162380,
      "text": "现在啊跑跑过"
    },
    {
      "ordinal": 62,
      "start_ms": 167430,
      "end_ms": 169650,
      "text": "文化小圈子里面乞讨"
    },
    {
      "ordinal": 63,
      "start_ms": 169650,
      "end_ms": 170880,
      "text": "乞讨完了"
