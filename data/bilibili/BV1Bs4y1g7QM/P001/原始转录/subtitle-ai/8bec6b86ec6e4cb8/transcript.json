    {
      "ordinal": 34,
      "start_ms": 86240,
      "end_ms": 87080,
      "text": "你直播"
    },
    {
      "ordinal": 35,
      "start_ms": 87080,
      "end_ms": 91800,
      "text": "哪怕你把你生产知识的那些过程给它显示出来"
