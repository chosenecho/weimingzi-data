    {
      "ordinal": 99,
      "start_ms": 259459,
      "end_ms": 260630,
      "text": "这就是募捐呀"
    },
    {
      "ordinal": 100,
      "start_ms": 260630,
      "end_ms": 262100,
      "text": "直接就是赤裸裸"
    },
    {
      "ordinal": 101,
      "start_ms": 262100,
      "end_ms": 262820,
      "text": "而且是私人"
    },
    {
      "ordinal": 102,
      "start_ms": 262820,
      "end_ms": 264440,
      "text": "为了他自己的私人利益"
    },
    {
      "ordinal": 103,
      "start_ms": 264440,
      "end_ms": 265820,
      "text": "为了自己的私人利益"
    },
    {
      "ordinal": 104,
      "start_ms": 265820,
      "end_ms": 266960,
      "text": "赤裸裸要钱"
    },
    {
      "ordinal": 105,
      "start_ms": 267360,
      "end_ms": 269220,
      "text": "你有手有脚不能去劳动吗"
    },
    {
      "ordinal": 106,
      "start_ms": 269220,
      "end_ms": 269850,
      "text": "我说了"
    },
    {
      "ordinal": 107,
      "start_ms": 269850,
      "end_ms": 271140,
      "text": "哪怕你开直播呀"
    },
    {
      "ordinal": 108,
      "start_ms": 271140,
      "end_ms": 272640,
      "text": "你开直播就行了"
    },
    {
      "ordinal": 109,
      "start_ms": 272640,
      "end_ms": 274580,
      "text": "你开直播就可以了"
    },
    {
      "ordinal": 110,
      "start_ms": 275560,
      "end_ms": 276360,
      "text": "你开直播"
    },
    {
      "ordinal": 111,
      "start_ms": 276360,
      "end_ms": 277320,
      "text": "你在b站不敢开直播"
    },
    {
      "ordinal": 112,
      "start_ms": 277320,
      "end_ms": 277620,
      "text": "你不行"
    },
    {
      "ordinal": 113,
      "start_ms": 277620,
      "end_ms": 279360,
      "text": "你在知乎开直播呀"
    },
    {
      "ordinal": 114,
      "start_ms": 279360,
      "end_ms": 280980,
      "text": "你让世人知道你是谁"
    },
    {
      "ordinal": 115,
      "start_ms": 280980,
      "end_ms": 282300,
      "text": "你承担你那些言论"
    },
    {
      "ordinal": 116,
      "start_ms": 282300,
      "end_ms": 284420,
      "text": "那真正的现实的代价"
    },
    {
      "ordinal": 117,
      "start_ms": 285300,
      "end_ms": 286580,
      "text": "你不承担这些代价"
    },
    {
      "ordinal": 118,
      "start_ms": 286580,
      "end_ms": 288080,
      "text": "那你怂恿忽悠别人去做"
    },
    {
      "ordinal": 119,
      "start_ms": 290420,
      "end_ms": 291520,
      "text": "你是谁啊"
    },
    {
      "ordinal": 120,
      "start_ms": 293000,
      "end_ms": 297199,
      "text": "这个是在我看来是最最最没出息的"
    },
    {
      "ordinal": 121,
      "start_ms": 297199,
      "end_ms": 298339,
      "text": "直接去乞讨"
    },
    {
      "ordinal": 122,
      "start_ms": 298339,
      "end_ms": 300409,
      "text": "那我要说我就发过的景区"
    },
    {
      "ordinal": 123,
      "start_ms": 300409,
      "end_ms": 302870,
      "text": "不要不要去买这个而已"
    },
    {
      "ordinal": 124,
      "start_ms": 302870,
      "end_ms": 306610,
      "text": "你鬼叫鬼叫这个有没有一个活生生的人鬼鲛"
    },
    {
      "ordinal": 125,
      "start_ms": 306610,
      "end_ms": 308050,
      "text": "有没有一个活生生的啊"
    },
    {
      "ordinal": 126,
      "start_ms": 308050,
      "end_ms": 310750,
      "text": "说什么40岁的一个一个学啊"
    },
    {
      "ordinal": 127,
      "start_ms": 310750,
      "end_ms": 312660,
      "text": "一个小知识分子啊"
    },
    {
      "ordinal": 128,
      "start_ms": 313520,
      "end_ms": 317040,
      "text": "啊没有有他所谓的左翼良心"
    },
    {
      "ordinal": 129,
      "start_ms": 319319,
      "end_ms": 321580,
      "text": "有在所谓的左翼良心这种"
    },
    {
      "ordinal": 130,
      "start_ms": 323759,
      "end_ms": 326240,
      "text": "你鬼知道他是不是一个机构啊"
    },
    {
      "ordinal": 131,
      "start_ms": 327740,
      "end_ms": 330280,
      "text": "他以前还发动态说他就是一个人"
    },
    {
      "ordinal": 132,
      "start_ms": 330280,
      "end_ms": 331060,
      "text": "不是一个人"
    },
    {
      "ordinal": 133,
      "start_ms": 331060,
      "end_ms": 332740,
      "text": "他立刻就什么删号走人"
    },
    {
      "ordinal": 134,
      "start_ms": 332740,
      "end_ms": 335840,
      "text": "后来挖出来他明显不是一个人"
    },
    {
      "ordinal": 135,
      "start_ms": 337240,
      "end_ms": 339450,
      "text": "他就是激流网团队里面的一个成员"
    },
    {
      "ordinal": 136,
