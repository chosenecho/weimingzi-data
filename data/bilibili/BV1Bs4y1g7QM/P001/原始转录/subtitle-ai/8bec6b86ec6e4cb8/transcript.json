    },
    {
      "ordinal": 28,
      "start_ms": 74340,
      "end_ms": 75660,
      "text": "他做直播都行啊"
    },
    {
      "ordinal": 29,
      "start_ms": 75660,
      "end_ms": 77259,
      "text": "他做直播都可以啊"
    },
    {
      "ordinal": 30,
      "start_ms": 78100,
      "end_ms": 79200,
      "text": "做直播都行"
    },
    {
      "ordinal": 31,
      "start_ms": 79200,
      "end_ms": 80700,
      "text": "他不是说他现在失业了吗"
