    {
      "ordinal": 2,
      "start_ms": 6350,
      "end_ms": 6920,
      "text": "哼"
    },
    {
      "ordinal": 3,
      "start_ms": 8060,
      "end_ms": 9220,
      "text": "太没出息了"
    },
    {
      "ordinal": 4,
      "start_ms": 12380,
      "end_ms": 13960,
      "text": "啊太没出息了"
    },
    {
      "ordinal": 5,
      "start_ms": 18080,
      "end_ms": 23720,
      "text": "我就说搞这个相当于失业了"
    },
    {
      "ordinal": 6,
