    {
      "ordinal": 95,
      "start_ms": 249819,
      "end_ms": 253570,
      "text": "它的内容完全是都是可以完全这个内容"
    },
    {
      "ordinal": 96,
      "start_ms": 253570,
      "end_ms": 256269,
      "text": "他说的人家只要加入这个星球内容都可以出去"
    },
    {
      "ordinal": 97,
      "start_ms": 256269,
      "end_ms": 257829,
      "text": "那就完全这就是目的"
    },
    {
      "ordinal": 98,
      "start_ms": 257829,
      "end_ms": 259459,
      "text": "这这就乞讨呀"
