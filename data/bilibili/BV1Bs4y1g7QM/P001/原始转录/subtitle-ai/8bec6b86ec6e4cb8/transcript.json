    {
      "ordinal": 92,
      "start_ms": 240999,
      "end_ms": 242319,
      "text": "这钱用作什么了"
    },
    {
      "ordinal": 93,
      "start_ms": 242319,
      "end_ms": 243820,
      "text": "这些钱干嘛去了"
    },
    {
      "ordinal": 94,
      "start_ms": 247999,
      "end_ms": 249819,
      "text": "啊这种知识付费的形式"
