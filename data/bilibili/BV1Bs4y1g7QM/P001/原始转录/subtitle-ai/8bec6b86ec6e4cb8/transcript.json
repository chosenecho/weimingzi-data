    {
      "ordinal": 69,
      "start_ms": 180159,
      "end_ms": 182080,
      "text": "你这个身不仁"
    },
    {
      "ordinal": 70,
      "start_ms": 182339,
      "end_ms": 183839,
      "text": "你掏了这笔钱"
