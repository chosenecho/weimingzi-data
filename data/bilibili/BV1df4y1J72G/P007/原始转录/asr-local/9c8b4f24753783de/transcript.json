  "segments": [
    {
      "ordinal": 0,
      "start_ms": 9360,
      "end_ms": 14560,
      "text": "人心路，迷梦似流长。"
    },
    {
      "ordinal": 1,
      "start_ms": 17440,
      "end_ms": 22560,
      "text": "琉璃风霜，风霜破面干。"
    },
    {
      "ordinal": 2,
      "start_ms": 25680,
      "end_ms": 31920,
      "text": "红尘里，迷梦有几多方向？"
    },
    {
      "ordinal": 3,
      "start_ms": 33520,
      "end_ms": 36800,
      "text": "找痴痴梦幻中，心"
    },
    {
      "ordinal": 4,
      "start_ms": 37920,
      "end_ms": 43760,
      "text": "外柳随人茫茫。"
    },
    {
      "ordinal": 5,
      "start_ms": 44160,
      "end_ms": 50640,
      "text": "人心事，迷梦与夜忙。"
    },
    {
      "ordinal": 6,
      "start_ms": 52080,
      "end_ms": 59040,
      "text": "梦里依稀依稀有丽光。"
    },
    {
      "ordinal": 7,
      "start_ms": 60240,
      "end_ms": 67360,
      "text": "何从何去，去觅我心中方向？"
    },
    {
      "ordinal": 8,
      "start_ms": 68240,
      "end_ms": 78400,
      "text": "风仿佛在梦中轻叹，柳和人茫茫。"
    },
    {
      "ordinal": 9,
      "start_ms": 78400,
      "end_ms": 87563,
      "text": "人间路，快乐少年郎。"
    },
    {
      "ordinal": 10,
      "start_ms": 87854,
      "end_ms": 162640,
      "text": "琉璃崎岖，崎岖不见阳光。"
    },
    {
      "ordinal": 11,
      "start_ms": 178087,
      "end_ms": 184487,
      "text": "泥尘里，快乐有几多方向？"
    },
    {
      "ordinal": 12,
      "start_ms": 186247,
      "end_ms": 193687,
      "text": "一丝丝梦幻般风雨，留随人茫茫。"
    },
    {
      "ordinal": 13,
      "start_ms": 193767,
      "end_ms": 207047,
      "text": "一丝丝梦幻般风雨，留随人茫茫。"
    }
