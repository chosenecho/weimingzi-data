  "content_sha256": "6d33df92fed583a273e5a1435423a53f8f68efdec7de72c060d8fc96cf33d7b9",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 28480,
      "end_ms": 32640,
      "text": "夜风冷冷，独回望旧事前尘。"
    },
    {
      "ordinal": 1,
      "start_ms": 34160,
      "end_ms": 37200,
      "text": "时荒的我，充满恼愤。"
    },
    {
      "ordinal": 2,
      "start_ms": 37200,
      "end_ms": 44763,
      "text": "无告与唧唧，精雅尽满斗去不忿。"
    },
    {
      "ordinal": 3,
      "start_ms": 44960,
      "end_ms": 48640,
      "text": "对谣言反应，心怀作梗。"
    },
    {
      "ordinal": 4,
      "start_ms": 51200,
      "end_ms": 55600,
      "text": "受了教训，得了书经的指"
    },
    {
      "ordinal": 5,
      "start_ms": 57040,
      "end_ms": 60080,
      "text": "引，仍易看得透，不再自困。"
    },
    {
      "ordinal": 6,
      "start_ms": 62720,
      "end_ms": 67920,
      "text": "但各有分数，不再像以往那般笨。"
    },
    {
      "ordinal": 7,
      "start_ms": 67920,
      "end_ms": 71520,
      "text": "没泪痕，轻化开笑着恨。"
    },
    {
      "ordinal": 8,
      "start_ms": 74240,
      "end_ms": 84000,
      "text": "冥冥中兜走住点起富和贫，是错永不对，正满自责。"
    },
    {
      "ordinal": 9,
      "start_ms": 85680,
      "end_ms": 96960,
      "text": "任你怎说，坚守我本份，始终相信沉默是金。"
    },
    {
      "ordinal": 10,
      "start_ms": 96960,
      "end_ms": 101360,
      "text": "是非有公理，心然莫冒犯别人。"
    },
    {
      "ordinal": 11,
      "start_ms": 102800,
      "end_ms": 105840,
      "text": "遇上冷风雨，又太认真。"
    },
    {
      "ordinal": 12,
      "start_ms": 108400,
      "end_ms": 112800,
      "text": "自信满心里，优礼为奉自质问。"
    },
    {
      "ordinal": 13,
      "start_ms": 113440,
      "end_ms": 120800,
      "text": "萧马游人，洒脱地做人。"
    },
    {
      "ordinal": 14,
      "start_ms": 120800,
      "end_ms": 122400,
      "text": "受了教训，得了"
    },
    {
      "ordinal": 15,
      "start_ms": 126577,
      "end_ms": 163040,
      "text": "书经的指引，仍易看得透，不再自困。"
    },
    {
      "ordinal": 16,
      "start_ms": 165760,
      "end_ms": 172640,
      "text": "但各有分数，不再像以往那般笨。"
    },
    {
      "ordinal": 17,
      "start_ms": 172740,
      "end_ms": 174400,
      "text": "没泪痕，轻化开笑着恨。"
    },
    {
      "ordinal": 18,
      "start_ms": 177141,
      "end_ms": 181221,
      "text": "冥冥中都就註定你富或"
    },
    {
      "ordinal": 19,
      "start_ms": 182741,
      "end_ms": 185941,
      "text": "貧，是錯永不對，真永是真。"
    },
    {
      "ordinal": 20,
      "start_ms": 188581,
      "end_ms": 200341,
      "text": "任你怎説，安守我本份，始終相信沉默是金。"
    },
    {
      "ordinal": 21,
      "start_ms": 200341,
      "end_ms": 204421,
      "text": "是非有公理，心平無冒犯別人。"
    },
    {
      "ordinal": 22,
      "start_ms": 205781,
      "end_ms": 208821,
      "text": "餘生忍風雨，又太人真。"
    },
    {
      "ordinal": 23,
      "start_ms": 211461,
      "end_ms": 220181,
      "text": "自信滿心裏，有禮為諷刺與質問，笑罵由人，灑脱地做人。"
    },
    {
      "ordinal": 24,
      "start_ms": 222101,
      "end_ms": 225941,
      "text": "少年人，灑脱地做人，"
    },
    {
      "ordinal": 25,
      "start_ms": 227941,
      "end_ms": 233141,
      "text": "繼續行，灑脱地做人。"
    }
  ],
  "text": "夜风冷冷，独回望旧事前尘。\n时荒的我，充满恼愤。\n无告与唧唧，精雅尽满斗去不忿。\n对谣言反应，心怀作梗。\n受了教训，得了书经的指\n引，仍易看得透，不再自困。\n但各有分数，不再像以往那般笨。\n没泪痕，轻化开笑着恨。\n冥冥中兜走住点起富和贫，是错永不对，正满自责。\n任你怎说，坚守我本份，始终相信沉默是金。\n是非有公理，心然莫冒犯别人。\n遇上冷风雨，又太认真。\n自信满心里，优礼为奉自质问。\n萧马游人，洒脱地做人。\n受了教训，得了\n书经的指引，仍易看得透，不再自困。\n但各有分数，不再像以往那般笨。\n没泪痕，轻化开笑着恨。\n冥冥中都就註定你富或\n貧，是錯永不對，真永是真。\n任你怎説，安守我本份，始終相信沉默是金。\n是非有公理，心平無冒犯別人。\n餘生忍風雨，又太人真。\n自信滿心裏，有禮為諷刺與質問，笑罵由人，灑脱地做人。\n少年人，灑脱地做人，\n繼續行，灑脱地做人。",
