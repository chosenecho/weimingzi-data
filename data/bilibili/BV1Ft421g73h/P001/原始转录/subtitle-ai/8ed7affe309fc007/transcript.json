{
  "bvid": "BV1Ft421g73h",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "8ed7affe309fc0076f3fbe73416043a9d4a1c3231ed7aa463279669931837cbb",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 5640,
      "end_ms": 7380,
      "text": "解决失恋的方法"
    },
    {
      "ordinal": 1,
      "start_ms": 7380,
      "end_ms": 9600,
      "text": "大哥谁都他妈失恋过"
    },
    {
      "ordinal": 2,
      "start_ms": 9600,
      "end_ms": 10560,
      "text": "失恋有啥嘛"
    },
    {
      "ordinal": 3,
      "start_ms": 10560,
      "end_ms": 14010,
      "text": "我靠谁都失恋过"
    },
    {
      "ordinal": 4,
      "start_ms": 14010,
      "end_ms": 15570,
      "text": "谁都单相思过"
    },
    {
      "ordinal": 5,
      "start_ms": 15570,
      "end_ms": 16350,
      "text": "谁都怎么样"
    },
    {
      "ordinal": 6,
      "start_ms": 16350,
      "end_ms": 18330,
      "text": "谁都这这幺蛾子"
    },
    {
      "ordinal": 7,
      "start_ms": 18330,
      "end_ms": 19830,
      "text": "有的没的全都体验过"
    },
    {
      "ordinal": 8,
      "start_ms": 19830,
      "end_ms": 23190,
      "text": "我靠就那样吧"
    },
    {
      "ordinal": 9,
      "start_ms": 24880,
      "end_ms": 28560,
      "text": "不是我就感觉吃臭豆腐一样"
    },
    {
      "ordinal": 10,
      "start_ms": 32460,
      "end_ms": 34040,
      "text": "不是能怎样嘛"
    },
    {
      "ordinal": 11,
      "start_ms": 34040,
      "end_ms": 37769,
      "text": "我都感觉我感觉这不能怎样"
    },
    {
      "ordinal": 12,
      "start_ms": 37769,
      "end_ms": 43670,
      "text": "就像我就说这个这个我就像我是个登山登山家"
    },
    {
      "ordinal": 13,
      "start_ms": 43670,
      "end_ms": 46490,
      "text": "然后你说你你那个走楼梯的时候"
    },
    {
      "ordinal": 14,
      "start_ms": 46490,
      "end_ms": 47510,
      "text": "被楼梯绊了一下"
    },
    {
      "ordinal": 15,
      "start_ms": 47510,
      "end_ms": 48290,
      "text": "膝盖很疼"
    },
    {
      "ordinal": 16,
      "start_ms": 48290,
      "end_ms": 52340,
      "text": "我说哦膝盖挺疼的疼呗"
    },
    {
      "ordinal": 17,
      "start_ms": 52340,
      "end_ms": 55760,
      "text": "我靠不是靠时间去治愈"
    },
    {
      "ordinal": 18,
      "start_ms": 55760,
      "end_ms": 57020,
      "text": "那是靠时间"
    },
    {
      "ordinal": 19,
      "start_ms": 57020,
      "end_ms": 61020,
      "text": "靠你自己成熟长大妈幼稚啊"
    },
    {
      "ordinal": 20,
      "start_ms": 61020,
      "end_ms": 63300,
      "text": "跟一个谈个恋爱算什么事儿"
    },
    {
      "ordinal": 21,
      "start_ms": 63300,
      "end_ms": 64920,
      "text": "我靠"
    },
    {
      "ordinal": 22,
      "start_ms": 65679,
      "end_ms": 67019,
      "text": "成年人不仅谈恋爱"
    },
    {
      "ordinal": 23,
      "start_ms": 67019,
      "end_ms": 68639,
      "text": "成年人还通奸呢"
    },
    {
      "ordinal": 24,
      "start_ms": 68639,
      "end_ms": 70319,
      "text": "成年人还殉情呢"
    },
    {
      "ordinal": 25,
      "start_ms": 70319,
      "end_ms": 72020,
      "text": "成年人还杀呢"
    },
    {
      "ordinal": 26,
      "start_ms": 72020,
      "end_ms": 75200,
      "text": "成年人很狂野的一个恋爱"
    },
    {
      "ordinal": 27,
      "start_ms": 75200,
      "end_ms": 75740,
      "text": "恋不恋"
    },
    {
      "ordinal": 28,
      "start_ms": 75740,
      "end_ms": 77240,
      "text": "这算什么叼毛玩意"
    },
    {
      "ordinal": 29,
      "start_ms": 77240,
      "end_ms": 79340,
      "text": "成年人还贪污腐败呢"
    },
    {
      "ordinal": 30,
      "start_ms": 79340,
      "end_ms": 80699,
      "text": "犯罪呢"
    },
    {
      "ordinal": 31,
      "start_ms": 80699,
      "end_ms": 82529,
      "text": "成年人还感恩呢"
    },
    {
      "ordinal": 32,
      "start_ms": 82529,
      "end_ms": 85439,
      "text": "成年人还做乱七八糟的很夸张的事情了"
    },
    {
      "ordinal": 33,
      "start_ms": 85439,
      "end_ms": 88310,
      "text": "成年人很狂野的失恋"
    },
    {
      "ordinal": 34,
      "start_ms": 88890,
      "end_ms": 90590,
      "text": "小小小卡拉米"
    },
    {
      "ordinal": 35,
      "start_ms": 90590,
      "end_ms": 94360,
      "text": "我靠成年人很野的"
    },
    {
      "ordinal": 36,
      "start_ms": 94360,
      "end_ms": 96340,
      "text": "成年人世界非常狂野的"
    },
    {
      "ordinal": 37,
      "start_ms": 96340,
      "end_ms": 100289,
      "text": "失恋是小小小小小小小卡拉米亚"
    },
    {
      "ordinal": 38,
      "start_ms": 100689,
      "end_ms": 102989,
      "text": "成人的世界很狂野的"
    },
    {
      "ordinal": 39,
      "start_ms": 104549,
      "end_ms": 108300,
      "text": "你这个小卡拉米子的东西是成年人"
    },
    {
      "ordinal": 40,
      "start_ms": 108300,
      "end_ms": 110160,
      "text": "根据爱情是甜美的"
    },
    {
      "ordinal": 41,
      "start_ms": 110160,
      "end_ms": 111320,
      "text": "是什么"
    },
    {
      "ordinal": 42,
      "start_ms": 111320,
      "end_ms": 114710,
      "text": "也是比较爱情叫什么啊"
    },
    {
      "ordinal": 43,
      "start_ms": 114710,
      "end_ms": 117380,
      "text": "爱情就像"
    },
    {
      "ordinal": 44,
      "start_ms": 118500,
      "end_ms": 123560,
      "text": "爱情就像那个什么一杆进洞那种感觉"
    },
    {
      "ordinal": 45,
      "start_ms": 123560,
      "end_ms": 124640,
      "text": "有十求"
    },
    {
      "ordinal": 46,
      "start_ms": 124640,
      "end_ms": 126200,
      "text": "这是非常稀缺的"
    },
    {
      "ordinal": 47,
      "start_ms": 126200,
      "end_ms": 128330,
      "text": "非常少有的懂吗"
    },
    {
      "ordinal": 48,
      "start_ms": 128330,
      "end_ms": 130910,
      "text": "行云流水啊"
    },
    {
      "ordinal": 49,
      "start_ms": 130910,
      "end_ms": 136550,
      "text": "斯诺克一杆140多分那种感觉"
    },
    {
      "ordinal": 50,
      "start_ms": 139260,
      "end_ms": 141080,
      "text": "你到了成人世界"
    },
    {
      "ordinal": 51,
      "start_ms": 141080,
      "end_ms": 142400,
      "text": "成年人的世界之后"
    },
    {
      "ordinal": 52,
      "start_ms": 142400,
      "end_ms": 147090,
      "text": "知道爱情是一个不是一个现实的东西"
    },
    {
      "ordinal": 53,
      "start_ms": 147090,
      "end_ms": 151460,
      "text": "是一个处在两个人的理想当中的东西"
    },
    {
      "ordinal": 54,
      "start_ms": 153380,
      "end_ms": 155380,
      "text": "是一个爱情是不可能的东西"
    },
    {
      "ordinal": 55,
      "start_ms": 155380,
      "end_ms": 157550,
      "text": "得不到东西啊"
    },
    {
      "ordinal": 56,
      "start_ms": 157890,
      "end_ms": 158990,
      "text": "You can't get it"
    },
    {
      "ordinal": 57,
      "start_ms": 158990,
      "end_ms": 160660,
      "text": "You know"
    },
    {
      "ordinal": 58,
      "start_ms": 160940,
      "end_ms": 162670,
      "text": "你弄不到的东西"
    },
    {
      "ordinal": 59,
      "start_ms": 162670,
      "end_ms": 165340,
      "text": "所以就没有失恋这种东西存在啊"
    },
    {
      "ordinal": 60,
      "start_ms": 165340,
      "end_ms": 167110,
      "text": "这怎么存在失恋呢"
    },
    {
      "ordinal": 61,
      "start_ms": 167110,
      "end_ms": 169840,
      "text": "搞笑什么叫失恋啊"
    },
    {
      "ordinal": 62,
      "start_ms": 171180,
      "end_ms": 172580,
      "text": "失恋是不可能的呀"
    },
    {
      "ordinal": 63,
      "start_ms": 172580,
      "end_ms": 175010,
      "text": "我总觉得你怎么会失恋呢"
    },
    {
      "ordinal": 64,
      "start_ms": 175010,
      "end_ms": 177080,
      "text": "因为你不可能实现爱情呀"
    },
    {
      "ordinal": 65,
      "start_ms": 177080,
      "end_ms": 178280,
      "text": "实现啥爱情啊"
    },
    {
      "ordinal": 66,
      "start_ms": 178280,
      "end_ms": 180070,
      "text": "你跟他怎么个爱法啊"
    },
    {
      "ordinal": 67,
      "start_ms": 180120,
      "end_ms": 181140,
      "text": "你们两个人爱上"
    },
    {
      "ordinal": 68,
      "start_ms": 181140,
      "end_ms": 182580,
      "text": "然后他们承接了飞升啊"
    },
    {
      "ordinal": 69,
      "start_ms": 182580,
      "end_ms": 183690,
      "text": "上天啊"
    },
    {
      "ordinal": 70,
      "start_ms": 183690,
      "end_ms": 187120,
      "text": "你们爱上你不是还得他妈的结婚生子"
    },
    {
      "ordinal": 71,
      "start_ms": 187120,
      "end_ms": 188380,
      "text": "后面还在吵架"
    },
    {
      "ordinal": 72,
      "start_ms": 188380,
      "end_ms": 189190,
      "text": "那么近"
    },
    {
      "ordinal": 73,
      "start_ms": 189190,
      "end_ms": 191560,
      "text": "你它拉屎那个屎你愿意吃吗"
    },
    {
      "ordinal": 74,
      "start_ms": 191560,
      "end_ms": 192800,
      "text": "不会吧"
    },
    {
      "ordinal": 75,
      "start_ms": 192800,
      "end_ms": 193700,
      "text": "对不对"
    },
    {
      "ordinal": 76,
      "start_ms": 193700,
      "end_ms": 195320,
      "text": "他忽然变得非常懒惰"
    },
    {
      "ordinal": 77,
      "start_ms": 195320,
      "end_ms": 196520,
      "text": "你天天给他换尿布嘛"
    },
    {
      "ordinal": 78,
      "start_ms": 196520,
      "end_ms": 197360,
      "text": "也不至于吧"
    },
    {
      "ordinal": 79,
      "start_ms": 197360,
      "end_ms": 198200,
      "text": "啥叫爱呀"
    },
    {
      "ordinal": 80,
      "start_ms": 198200,
      "end_ms": 200240,
      "text": "我靠大哥爱啥呀"
    },
    {
      "ordinal": 81,
      "start_ms": 200240,
      "end_ms": 200900,
      "text": "爱你妈呀"
    },
    {
      "ordinal": 82,
      "start_ms": 200900,
      "end_ms": 202320,
      "text": "我靠"
    },
    {
      "ordinal": 83,
      "start_ms": 207160,
      "end_ms": 209400,
      "text": "这玩意又不好"
    },
    {
      "ordinal": 84,
      "start_ms": 209400,
      "end_ms": 210060,
      "text": "难以理解"
    },
    {
      "ordinal": 85,
      "start_ms": 210060,
      "end_ms": 210900,
      "text": "我靠大哥"
    },
    {
      "ordinal": 86,
      "start_ms": 210900,
      "end_ms": 212100,
      "text": "至少我理解不了啥"
    },
    {
      "ordinal": 87,
      "start_ms": 212100,
      "end_ms": 214840,
      "text": "你们爱情靠后呢"
    },
    {
      "ordinal": 88,
      "start_ms": 215480,
      "end_ms": 217000,
      "text": "你最后活到八九十岁"
    },
    {
      "ordinal": 89,
      "start_ms": 217000,
      "end_ms": 217960,
      "text": "非要一块拔管"
    },
    {
      "ordinal": 90,
      "start_ms": 217960,
      "end_ms": 220120,
      "text": "一起登西方极乐"
    },
    {
      "ordinal": 91,
      "start_ms": 220120,
      "end_ms": 223180,
      "text": "非要这样爱钱爱啥"
    },
    {
      "ordinal": 92,
      "start_ms": 224510,
      "end_ms": 227920,
      "text": "这这你最好不要把这东西给专题化"
    },
    {
      "ordinal": 93,
      "start_ms": 227920,
      "end_ms": 230340,
      "text": "日子就围绕着这东西过"
    },
    {
      "ordinal": 94,
      "start_ms": 230340,
      "end_ms": 231480,
      "text": "很没劲的"
    },
    {
      "ordinal": 95,
      "start_ms": 231480,
      "end_ms": 232350,
      "text": "你知道吗"
    },
    {
      "ordinal": 96,
      "start_ms": 232350,
      "end_ms": 235180,
      "text": "很没意思的"
    },
    {
      "ordinal": 97,
      "start_ms": 243260,
      "end_ms": 245620,
      "text": "就是小孩儿不关心这种东西"
    },
    {
      "ordinal": 98,
      "start_ms": 247060,
      "end_ms": 249880,
      "text": "精神上没成熟的"
    },
    {
      "ordinal": 99,
      "start_ms": 250760,
      "end_ms": 255220,
      "text": "我说我的意思就是说这东西就就挺次要的"
    },
    {
      "ordinal": 100,
      "start_ms": 255220,
      "end_ms": 257019,
      "text": "你知道吗"
    },
    {
      "ordinal": 101,
      "start_ms": 257858,
      "end_ms": 259168,
      "text": "蛮次要的"
    },
    {
      "ordinal": 102,
      "start_ms": 259168,
      "end_ms": 261839,
      "text": "他在哪里组织他的生活啊"
    },
    {
      "ordinal": 103,
      "start_ms": 261839,
      "end_ms": 263789,
      "text": "重新构造他的社交圈"
    },
    {
      "ordinal": 104,
      "start_ms": 263789,
      "end_ms": 264419,
      "text": "怎么怎么样的"
    },
    {
      "ordinal": 105,
      "start_ms": 264419,
      "end_ms": 265920,
      "text": "认识什么什么体验生"
    },
    {
      "ordinal": 106,
      "start_ms": 265920,
      "end_ms": 266820,
      "text": "关你屁事"
    },
    {
      "ordinal": 107,
      "start_ms": 266820,
      "end_ms": 268140,
      "text": "你本来也不是你"
    },
    {
      "ordinal": 108,
      "start_ms": 268140,
      "end_ms": 269940,
      "text": "本来你也没办法怎么干涉"
    },
    {
      "ordinal": 109,
      "start_ms": 269940,
      "end_ms": 273840,
      "text": "怎么混到一个圈子共同生活"
    },
    {
      "ordinal": 110,
      "start_ms": 274620,
      "end_ms": 276620,
      "text": "而且而且再怎么样"
    },
    {
      "ordinal": 111,
      "start_ms": 276620,
      "end_ms": 278690,
      "text": "你与一切共同命运逃避不了的呀"
    },
    {
      "ordinal": 112,
      "start_ms": 278690,
      "end_ms": 280299,
      "text": "你打世界大战"
    },
    {
      "ordinal": 113,
      "start_ms": 280299,
      "end_ms": 283239,
      "text": "或者说你总体性的一些危机"
    },
    {
      "ordinal": 114,
      "start_ms": 283239,
      "end_ms": 286679,
      "text": "你就是说哦他这个他到了另外一个世界"
    },
    {
      "ordinal": 115,
      "start_ms": 286679,
      "end_ms": 287699,
      "text": "我触摸不到"
    },
    {
      "ordinal": 116,
      "start_ms": 287699,
      "end_ms": 287939,
      "text": "哎"
    },
    {
      "ordinal": 117,
      "start_ms": 287939,
      "end_ms": 288779,
      "text": "不是不好意思"
    },
    {
      "ordinal": 118,
      "start_ms": 288779,
      "end_ms": 289799,
      "text": "那是核战争"
    },
    {
      "ordinal": 119,
      "start_ms": 289799,
      "end_ms": 291119,
      "text": "我靠核辐射"
    },
    {
      "ordinal": 120,
      "start_ms": 291119,
      "end_ms": 293280,
      "text": "他总归他也要碰到了呗"
    },
    {
      "ordinal": 121,
      "start_ms": 293620,
      "end_ms": 299400,
      "text": "是不是有一些普遍性的位面呀"
    },
    {
      "ordinal": 122,
      "start_ms": 301100,
      "end_ms": 303040,
      "text": "除了跟爱情没关系的"
    },
    {
      "ordinal": 123,
      "start_ms": 303040,
      "end_ms": 305000,
      "text": "有普遍性的行动的位面"
    },
    {
      "ordinal": 124,
      "start_ms": 305000,
      "end_ms": 307760,
      "text": "你们他妈离这个位面是没有这个位面啊"
    },
    {
      "ordinal": 125,
      "start_ms": 307760,
      "end_ms": 309920,
      "text": "所以就就觉得啊我离开了他"
    },
    {
      "ordinal": 126,
      "start_ms": 309920,
      "end_ms": 312370,
      "text": "这个世界再也没有他"
    },
    {
      "ordinal": 127,
      "start_ms": 312370,
      "end_ms": 315640,
      "text": "我靠我再也不能对他产生影响"
    },
    {
      "ordinal": 128,
      "start_ms": 315640,
      "end_ms": 316240,
      "text": "什么这种感觉"
    },
    {
      "ordinal": 129,
      "start_ms": 316240,
      "end_ms": 316780,
      "text": "哎呦呦"
    },
    {
      "ordinal": 130,
      "start_ms": 316780,
      "end_ms": 317560,
      "text": "啥玩意"
    },
    {
      "ordinal": 131,
      "start_ms": 317560,
      "end_ms": 318310,
      "text": "我靠"
    },
    {
      "ordinal": 132,
      "start_ms": 318310,
      "end_ms": 319450,
      "text": "这很重要吗"
    },
    {
      "ordinal": 133,
      "start_ms": 321790,
      "end_ms": 322810,
      "text": "这是啥呀"
    },
    {
      "ordinal": 134,
      "start_ms": 322810,
      "end_ms": 324420,
      "text": "我靠"
    },
    {
      "ordinal": 135,
      "start_ms": 327500,
      "end_ms": 328480,
      "text": "我腰都疼了"
    },
    {
      "ordinal": 136,
      "start_ms": 328480,
      "end_ms": 329800,
