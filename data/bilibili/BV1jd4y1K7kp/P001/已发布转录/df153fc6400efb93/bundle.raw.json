{"segments":[{"start":0.0,"end":1.56,"text":"今天要讲的就是"},{"start":3.64,"end":6.0,"text":"行动的初步目的"},{"start":6.0,"end":8.28,"text":"行动的啊"},{"start":8.28,"end":10.36,"text":"一个初步目的"},{"start":12.659,"end":16.549,"text":"而且也是他的某种意义上是他的终极目的啊"},{"start":16.549,"end":23.41,"text":"但是他初期的一个目的就是说很多网上的自以为是行动派的人"},{"start":23.41,"end":24.91,"text":"或者说根本没行动的"},{"start":24.91,"end":26.56,"text":"想要有所行动的人"},{"start":26.56,"end":27.94,"text":"我告诉你"},{"start":28.259,"end":29.579,"text":"你谈恋爱的时候"},{"start":29.579,"end":31.259,"text":"你知道行动的目的是啥"},{"start":32.279,"end":33.459,"text":"确定关系"},{"start":34.72,"end":36.06,"text":"追求一个人的时候"},{"start":36.06,"end":37.74,"text":"你知道行动的目的是啥"},{"start":37.74,"end":38.22,"text":"对不对"},{"start":38.22,"end":41.329,"text":"或者说你想要获得买一个东西"},{"start":41.329,"end":43.29,"text":"或者你要买一个笔记本电脑"},{"start":43.29,"end":44.73,"text":"或者说你想买个房子"},{"start":44.73,"end":46.95,"text":"你就你就知道你的行动的目的是什么"},{"start":50.31,"end":52.279,"text":"你就不知道行动的目的是什么了吗"},{"start":52.42,"end":54.7,"text":"啊我们现在非常明确的告诉你"},{"start":54.7,"end":58.2,"text":"行动的目的是取得名义"},{"start":58.2,"end":61.519,"text":"取得一个合法正当的名义"},{"start":66.14,"end":69.49,"text":"它贯穿你的始终行动的目的啊"},{"start":69.49,"end":73.88,"text":"行动的或者起手式应当是取得名义合法正当的名义"},{"start":74.0,"end":77.72,"text":"那么我们先告诉你什么是错误的"},{"start":77.72,"end":79.5,"text":"为了行动而行动"},{"start":83.52,"end":86.2,"text":"这个叫这是盲动主义"},{"start":87.66,"end":89.24,"text":"这是标准的盲动主义"},{"start":89.24,"end":90.08,"text":"为了行动而行动"},{"start":90.08,"end":95.5,"text":"他不管他不知道这个行动会产生什么样的呃一形态上的影响啊"},{"start":95.5,"end":97.33,"text":"这个力量对比上的影响"},{"start":97.33,"end":98.17,"text":"他不反思"},{"start":98.17,"end":100.54,"text":"没有能力反思弱小肺腑啊"},{"start":100.54,"end":101.44,"text":"它是一种盲种主义"},{"start":101.44,"end":102.729,"text":"是宣泄性的"},{"start":107.469,"end":110.349,"text":"或者变成一种这个失控的激进主义"},{"start":115.31,"end":116.88,"text":"它是那种啊"},{"start":116.88,"end":118.38,"text":"它是一种政治乌托邦"},{"start":118.38,"end":123.8,"text":"幻想没法实现之后就自暴自弃的一种精神病理化的宣泄"},{"start":123.9,"end":127.02,"text":"这里面的人的实际上他是失败主义者"},{"start":127.02,"end":130.4,"text":"这里面的人实际上他的实质是一种失败主义"},{"start":131.279,"end":132.199,"text":"是一种头"},{"start":132.199,"end":133.579,"text":"是一种失败主义啊"},{"start":133.579,"end":134.569,"text":"是一种失败主义"},{"start":134.569,"end":137.239,"text":"但失败主义他就刻意的去为行动而行"},{"start":137.239,"end":137.419,"text":"动"},{"start":137.419,"end":138.259,"text":"去制造悲剧"},{"start":138.259,"end":139.4,"text":"来自我感动"},{"start":139.4,"end":142.4,"text":"制造悲剧来来和创伤"},{"start":142.4,"end":144.38,"text":"让自己在痛中爽啊"},{"start":144.38,"end":145.82,"text":"他这样是一种病态的快感"},{"start":145.82,"end":147.56,"text":"来享受一种病态快感"},{"start":147.56,"end":148.88,"text":"病态的快感"},{"start":148.88,"end":150.62,"text":"肮脏的病态快感"},{"start":153.399,"end":154.739,"text":"这种盲动出去"},{"start":154.739,"end":156.16,"text":"还有一个是"},{"start":157.959,"end":160.139,"text":"为了理论"},{"start":162.359,"end":164.38,"text":"而不行动"},{"start":165.86,"end":167.77,"text":"或者为了一个名头"},{"start":167.77,"end":171.1,"text":"为了一个为了自居一个名头"},{"start":171.1,"end":174.8,"text":"为了自居一个名头而不心动"},{"start":176.1,"end":177.71,"text":"为了占住一个名头"},{"start":177.71,"end":179.18,"text":"占住一个名头"},{"start":179.18,"end":180.92,"text":"因为他如果去行动的话"},{"start":180.92,"end":182.32,"text":"他就破功了"},{"start":182.739,"end":183.879,"text":"第二种人啊"},{"start":183.879,"end":185.409,"text":"在知乎上面好多这种人"},{"start":185.409,"end":186.699,"text":"如果他是行动"},{"start":186.699,"end":188.259,"text":"他妈的立刻走向破功"},{"start":188.259,"end":190.56,"text":"因为现实会告诉他"},{"start":190.56,"end":192.06,"text":"你不配站那个名头"},{"start":192.06,"end":193.71,"text":"你没有力量站那个名头"},{"start":193.71,"end":195.6,"text":"你不配去践行这个理论"},{"start":195.6,"end":196.8,"text":"没力量"},{"start":196.8,"end":199.21,"text":"你没有做好任何的准备工作"},{"start":199.21,"end":201.94,"text":"你没有你没有做任何的工作"},{"start":201.94,"end":203.77,"text":"你这个你站这个理论"},{"start":203.77,"end":208.14,"text":"你这个理论什么什么什么主义者而自居"},{"start":208.14,"end":210.72,"text":"这个是你没有付出任何成本的代价"},{"start":210.72,"end":212.46,"text":"你完全是自我感动"},{"start":212.78,"end":216.02,"text":"这个东西是标准的"},{"start":216.44,"end":218.0,"text":"这是一种标准的"},{"start":218.0,"end":218.9,"text":"我们说是一种"},{"start":218.9,"end":221.0,"text":"我都不好意思说是主观主义的"},{"start":221.0,"end":221.94,"text":"你明白吧"},{"start":223.98,"end":225.5,"text":"这也是标准的"},{"start":225.5,"end":227.7,"text":"我们可以说完美主义者"},{"start":228.8,"end":231.01,"text":"那么实质他是投降主义"},{"start":231.01,"end":234.6,"text":"完美主义实质是投降主义"},{"start":234.6,"end":237.24,"text":"完美主义的话就是现实的"},{"start":237.24,"end":239.62,"text":"或者说他是虚无主义啊"},{"start":240.019,"end":242.299,"text":"虚无主义或者说反现实主义"},{"start":242.299,"end":243.889,"text":"它是一种反现实主义"},{"start":243.889,"end":246.1,"text":"反现实的完美主义者"},{"start":246.66,"end":251.19,"text":"他要追求一个理论上名头上最光鲜亮丽的"},{"start":251.19,"end":256.11,"text":"就是就像什么神仙姐姐一样美艳不可方物的一个一个名头"},{"start":256.11,"end":257.13,"text":"他妈的站住"},{"start":257.13,"end":258.54,"text":"但实际上他在梦萦"},{"start":258.54,"end":260.899,"text":"他在意淫他能做春梦"},{"start":261.219,"end":262.839,"text":"他为了占这个理论"},{"start":262.839,"end":264.819,"text":"以这种主义者自居"},{"start":264.819,"end":266.739,"text":"他他妈的永远不行动"},{"start":266.739,"end":267.579,"text":"不会做任何事情"},{"start":267.579,"end":269.46,"text":"或者他的行动完全就是反动"},{"start":269.46,"end":270.81,"text":"他要么就是不行动"},{"start":270.81,"end":271.86,"text":"要么就是反动"},{"start":271.86,"end":273.48,"text":"就是为了理论而反动"},{"start":273.48,"end":275.79,"text":"甚至可以说他这种不行动还占着位置"},{"start":275.79,"end":277.38,"text":"所以他这个不行动已经是反动了"},{"start":277.38,"end":278.6,"text":"他把位置占住了"},{"start":279.28,"end":281.16,"text":"为了理论来反动啊"},{"start":281.16,"end":282.33,"text":"为了理论来反动"},{"start":282.33,"end":286.939,"text":"那么这两个啊它就是形成两极震荡的"},{"start":286.939,"end":290.38,"text":"他有的甚至说在一些人身上会有这种两极震荡的"},{"start":290.84,"end":294.71,"text":"不停的有理论癖或者主义批名头皮"},{"start":294.71,"end":296.15,"text":"他就什么都不敢做"},{"start":296.15,"end":297.17,"text":"当他去做的时候"},{"start":297.17,"end":299.99,"text":"他又他又不去衡量他做的这个事情"},{"start":299.99,"end":302.51,"text":"也不去用理论来批判来反思"},{"start":302.51,"end":305.36,"text":"他说他的理论层和他的行政层是隔绝的"},{"start":305.36,"end":306.8,"text":"因为他根本不想成功"},{"start":306.8,"end":308.12,"text":"他不想做成任何事"},{"start":308.12,"end":309.789,"text":"这些人都是自暴自弃者"},{"start":309.789,"end":310.749,"text":"都是投降主义"},{"start":310.749,"end":311.86,"text":"失败主义者"},{"start":311.96,"end":318.32,"text":"这个投降主义它意味着他就是要把自己要让自己变成唯一的喜剧"},{"start":318.32,"end":319.22,"text":"整个世界都是悲剧"},{"start":319.22,"end":321.18,"text":"而他自己是唯一的喜剧"},{"start":321.28,"end":322.84,"text":"或者说不是喜剧"},{"start":322.84,"end":325.33,"text":"他把自己以证据自居"},{"start":325.33,"end":327.61,"text":"我是证据啊自居"},{"start":327.61,"end":328.09,"text":"我是妈"},{"start":328.09,"end":328.99,"text":"我是他妈"},{"start":331.26,"end":334.32,"text":"我我是20年后的什么什么什么他妈的"},{"start":334.32,"end":336.6,"text":"他以他在20岁的时候说"},{"start":338.58,"end":340.96,"text":"那你请问你现在做的什么"},{"start":341.579,"end":342.799,"text":"他们就自居啊"},{"start":342.799,"end":345.139,"text":"他这个我不是指指刘思墨"},{"start":345.139,"end":345.799,"text":"只为名字啊"},{"start":345.799,"end":347.64,"text":"他指的是这个人自己啊"},{"start":347.64,"end":351.0,"text":"他就把自己看成视为是唯一的证据"},{"start":351.0,"end":352.32,"text":"只要他不行动"},{"start":352.32,"end":355.36,"text":"那么历史的历史的剧本就不会走"},{"start":355.719,"end":358.179,"text":"这些人会有一种完美主义幻想"},{"start":358.179,"end":361.599,"text":"觉得觉得我所以说他也是主观主义"},{"start":361.599,"end":363.999,"text":"这些人就觉得他妈的只要他不行动"},{"start":363.999,"end":365.08,"text":"世界就不动"},{"start":365.32,"end":366.58,"text":"就世界就不会动"},{"start":366.58,"end":370.03,"text":"这个剧本就不会按照历史真正应该走的剧本走"},{"start":370.03,"end":373.27,"text":"然后由因为他占住了理论的名头嘛"},{"start":373.27,"end":377.28,"text":"因为他就以为他已经是他妈理论上最完美的人"},{"start":377.28,"end":379.56,"text":"他他已经得到历史的答案了"},{"start":379.56,"end":381.9,"text":"或者说只有他的内在的自由新政"},{"start":381.9,"end":384.11,"text":"他内在伦理侧成"},{"start":384.11,"end":387.34,"text":"或者说卧槽政治的那种高瞻远瞩"},{"start":387.34,"end":389.8,"text":"只有他把握到了时代的脉搏"},{"start":389.8,"end":390.52,"text":"所以他不行动"},{"start":390.52,"end":391.42,"text":"只要他不行动"},{"start":391.42,"end":393.46,"text":"其他人所有的路都是他妈错的"},{"start":393.46,"end":395.02,"text":"唉只要他的吗"},{"start":395.02,"end":396.28,"text":"或者说他会演石猪"},{"start":396.28,"end":397.88,"text":"看到哪些地方"},{"start":397.88,"end":398.66,"text":"哪些路径"},{"start":398.66,"end":400.9,"text":"那那是他的这个"},{"start":403.04,"end":405.94,"text":"那那些人无非是他的先驱先行者"},{"start":405.94,"end":408.54,"text":"他他准备摘大桃子啊"},{"start":408.54,"end":410.7,"text":"就这种是变态的完美主义啊"},{"start":410.7,"end":411.78,"text":"这是变态的幻想"},{"start":411.78,"end":413.17,"text":"很病态的啊"},{"start":413.17,"end":414.13,"text":"一种投降主义"},{"start":414.13,"end":416.53,"text":"他把自己视为是唯一的历史证据"},{"start":416.53,"end":418.09,"text":"里面的主要主角"},{"start":418.09,"end":419.05,"text":"这些废物啊"},{"start":419.05,"end":420.839,"text":"他是这样想的啊"},{"start":420.839,"end":422.819,"text":"这两种都是我说的"},{"start":422.819,"end":426.88,"text":"都是都是根本不是合格的行动者"},{"start":426.88,"end":427.96,"text":"都是不合格"},{"start":427.96,"end":429.61,"text":"这两者都不合格"},{"start":429.61,"end":430.9,"text":"都很卑劣"},{"start":430.9,"end":431.83,"text":"可鄙视"},{"start":431.83,"end":432.9,"text":"很糟糕"},{"start":432.9,"end":435.21,"text":"下面这个尤其肮脏可耻"},{"start":435.21,"end":437.87,"text":"上面这个幼稚啊"},{"start":437.87,"end":439.88,"text":"幼稚愚蠢"},{"start":440.639,"end":443.059,"text":"他如果刻意地追求悲剧性"},{"start":443.059,"end":443.89,"text":"创伤性"},{"start":443.89,"end":446.47,"text":"限于病态快感而不能自拔"},{"start":446.47,"end":448.09,"text":"甚至说他陷于病态快感"},{"start":448.09,"end":449.35,"text":"还固步自封"},{"start":449.35,"end":450.55,"text":"把它做成一个乐子"},{"start":450.55,"end":453.43,"text":"那就是不仅仅是愚蠢和幼稚的"},{"start":453.43,"end":455.29,"text":"也是邪恶和肮脏"},{"start":455.29,"end":457.69,"text":"下面这个直接是邪恶螳螂肮脏"},{"start":457.69,"end":459.76,"text":"但在行动当中是愚蠢幼稚"},{"start":459.76,"end":463.21,"text":"上面这个是在行动当中愚蠢幼稚"},{"start":463.21,"end":468.04,"text":"但是它有可能抵达这个邪恶和肮脏"},{"start":468.04,"end":468.61,"text":"懂吗"},{"start":468.61,"end":470.05,"text":"这个是以邪恶肮呃"},{"start":470.05,"end":472.15,"text":"这个是以愚蠢幼稚作为起点"},{"start":472.15,"end":474.949,"text":"可能导向邪恶和肮脏"},{"start":474.949,"end":477.829,"text":"