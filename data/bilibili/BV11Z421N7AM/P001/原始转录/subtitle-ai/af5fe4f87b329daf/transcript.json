{
  "bvid": "BV11Z421N7AM",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "af5fe4f87b329daf3bd073de7dc5b19f8fb95390ba3fa993a2588a85cc944b54",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 40,
      "end_ms": 1720,
      "text": "我们要做好一个工作"
    },
    {
      "ordinal": 1,
      "start_ms": 1720,
      "end_ms": 3360,
      "text": "就是"
    },
    {
      "ordinal": 2,
      "start_ms": 4700,
      "end_ms": 9340,
      "text": "一所有核"
    },
    {
      "ordinal": 3,
      "start_ms": 10600,
      "end_ms": 14640,
      "text": "某流系的"
    },
    {
      "ordinal": 4,
      "start_ms": 15860,
      "end_ms": 23220,
      "text": "老一派的那些激进煽动分子有同群组关系"
    },
    {
      "ordinal": 5,
      "start_ms": 27070,
      "end_ms": 27870,
      "text": "初高中"
    },
    {
      "ordinal": 6,
      "start_ms": 28910,
      "end_ms": 33070,
      "text": "那么这个线把它划到这个高中"
    },
    {
      "ordinal": 7,
      "start_ms": 34860,
      "end_ms": 36160,
      "text": "的这些人"
    },
    {
      "ordinal": 8,
      "start_ms": 36160,
      "end_ms": 39300,
      "text": "高中生以上的人"
    },
    {
      "ordinal": 9,
      "start_ms": 43140,
      "end_ms": 46320,
      "text": "统统拉黑啊"
    },
    {
      "ordinal": 10,
      "start_ms": 46320,
      "end_ms": 47400,
      "text": "通通拉黑"
    },
    {
      "ordinal": 11,
      "start_ms": 47400,
      "end_ms": 52310,
      "text": "然后是这个在不同的这些群组里面"
    },
    {
      "ordinal": 12,
      "start_ms": 52310,
      "end_ms": 54250,
      "text": "比如说红贝啊啊"
    },
    {
      "ordinal": 13,
      "start_ms": 54250,
      "end_ms": 62190,
      "text": "比如说三毛他们组织的群组当中的这些少年啊"
    },
    {
      "ordinal": 14,
      "start_ms": 64470,
      "end_ms": 68919,
      "text": "我们会啊通通拉黑"
    },
    {
      "ordinal": 15,
      "start_ms": 69239,
      "end_ms": 71699,
      "text": "然后并且我们会对这些人的呃"
    },
    {
      "ordinal": 16,
      "start_ms": 71699,
      "end_ms": 73719,
      "text": "这个只是QQ号啊"
    },
    {
      "ordinal": 17,
      "start_ms": 73719,
      "end_ms": 75859,
      "text": "QQ号啊"
    },
    {
      "ordinal": 18,
      "start_ms": 75859,
      "end_ms": 81190,
      "text": "我们会呃统一统计一下"
    },
    {
      "ordinal": 19,
      "start_ms": 81190,
      "end_ms": 83530,
      "text": "然后这些人都在我们的黑名单里面"
    },
    {
      "ordinal": 20,
      "start_ms": 83530,
      "end_ms": 85870,
      "text": "就是说线下活动"
    },
    {
      "ordinal": 21,
      "start_ms": 87280,
      "end_ms": 89880,
      "text": "通通不允许这些人参加"
    },
    {
      "ordinal": 22,
      "start_ms": 91210,
      "end_ms": 92370,
      "text": "这是一点"
    },
    {
      "ordinal": 23,
      "start_ms": 92370,
      "end_ms": 94010,
      "text": "然后呢在B站"
    },
    {
      "ordinal": 24,
      "start_ms": 95090,
      "end_ms": 100150,
      "text": "在那个这些人的注册的"
    },
    {
      "ordinal": 25,
      "start_ms": 100150,
      "end_ms": 104260,
      "text": "各种这种煽动性的账号下面啊"
    },
    {
      "ordinal": 26,
      "start_ms": 104260,
      "end_ms": 106840,
      "text": "说要宽容对待他们"
    },
    {
      "ordinal": 27,
      "start_ms": 106840,
      "end_ms": 109140,
      "text": "说要包容他们"
    },
    {
      "ordinal": 28,
      "start_ms": 109140,
      "end_ms": 111030,
      "text": "说要支持他们"
    },
    {
      "ordinal": 29,
      "start_ms": 111030,
      "end_ms": 117239,
      "text": "那支持这些和某流系就学院派啊"
    },
    {
      "ordinal": 30,
      "start_ms": 117239,
      "end_ms": 123890,
      "text": "学院派学院派就红贝泰晤石什么这种三毛啊"
    },
    {
      "ordinal": 31,
      "start_ms": 123890,
      "end_ms": 130570,
      "text": "还报说这个韩流基这些人和他们有共群组关系"
    },
    {
      "ordinal": 32,
      "start_ms": 130570,
      "end_ms": 135970,
      "text": "或者说啊和他们有这个上下级关系的"
    },
    {
      "ordinal": 33,
      "start_ms": 139030,
      "end_ms": 142150,
      "text": "他们做的一些自媒体"
    },
    {
      "ordinal": 34,
      "start_ms": 142150,
      "end_ms": 146860,
      "text": "然后在那些媒体下面有过支持的评价"
    },
    {
      "ordinal": 35,
      "start_ms": 146860,
      "end_ms": 148980,
      "text": "评论就在B站了"
    },
    {
      "ordinal": 36,
      "start_ms": 148980,
      "end_ms": 155080,
      "text": "支持过这些内容的评论的人通通拉黑啊"
    },
    {
      "ordinal": 37,
      "start_ms": 156280,
      "end_ms": 159600,
      "text": "通通就是"
    },
    {
      "ordinal": 38,
      "start_ms": 162480,
      "end_ms": 166269,
      "text": "不允许他们参加任何意义的线下活动"
    },
    {
      "ordinal": 39,
      "start_ms": 166269,
      "end_ms": 169069,
      "text": "然后不和他们打任何的交道"
    },
    {
      "ordinal": 40,
      "start_ms": 169069,
      "end_ms": 171829,
      "text": "这些人通通打入另册"
    },
    {
      "ordinal": 41,
      "start_ms": 172380,
      "end_ms": 173900,
      "text": "话说到这个份上了啊"
    },
    {
      "ordinal": 42,
      "start_ms": 173900,
      "end_ms": 175620,
      "text": "这些人通通打入另一侧"
    },
    {
      "ordinal": 43,
      "start_ms": 177420,
      "end_ms": 181240,
      "text": "就是直接的这些这些青少年"
    },
    {
      "ordinal": 44,
      "start_ms": 181240,
      "end_ms": 186000,
      "text": "在这些老老老一派的这些煽动家"
    },
    {
      "ordinal": 45,
      "start_ms": 186120,
      "end_ms": 191280,
      "text": "老一派山东家就明确就是某流系啊"
    },
    {
      "ordinal": 46,
      "start_ms": 191280,
      "end_ms": 193200,
      "text": "某流系啊"
    },
    {
      "ordinal": 47,
      "start_ms": 193200,
      "end_ms": 194400,
      "text": "红贝太湖石啊"
    },
    {
      "ordinal": 48,
      "start_ms": 194400,
      "end_ms": 195200,
      "text": "韩流基啊"
    },
    {
      "ordinal": 49,
      "start_ms": 199760,
      "end_ms": 201040,
      "text": "黄某教授啊"
    },
    {
      "ordinal": 50,
      "start_ms": 201040,
      "end_ms": 202060,
      "text": "什么"
    },
    {
      "ordinal": 51,
      "start_ms": 202060,
      "end_ms": 208030,
      "text": "还有这个他们可能这些线下的这些中灯啊"
    },
    {
      "ordinal": 52,
      "start_ms": 208030,
      "end_ms": 212790,
      "text": "基因分子他们摸不到嗯"
    },
    {
      "ordinal": 53,
      "start_ms": 212790,
      "end_ms": 216420,
      "text": "然后这些学生往往这些学生"
    },
    {
      "ordinal": 54,
      "start_ms": 216420,
      "end_ms": 220150,
      "text": "这些学生呢是额要参加活动之前"
    },
    {
      "ordinal": 55,
      "start_ms": 220150,
      "end_ms": 222270,
      "text": "你是要看他的社交账户的发言记录"
    },
    {
      "ordinal": 56,
      "start_ms": 222270,
      "end_ms": 223270,
      "text": "什么这些东西的"
    },
    {
      "ordinal": 57,
      "start_ms": 223270,
      "end_ms": 226050,
      "text": "发现他是在这种群里面的"
    },
    {
      "ordinal": 58,
      "start_ms": 226050,
      "end_ms": 227830,
      "text": "立即踢掉"
    },
    {
      "ordinal": 59,
      "start_ms": 228620,
      "end_ms": 233100,
      "text": "发现她在这类似这种群里面立即踢掉"
    },
    {
      "ordinal": 60,
      "start_ms": 233670,
      "end_ms": 235230,
      "text": "不允许他们参加活动"
    },
    {
      "ordinal": 61,
      "start_ms": 236550,
      "end_ms": 239170,
      "text": "然后我们原则上是不带高中生参加活动的"
    },
    {
      "ordinal": 62,
      "start_ms": 239170,
      "end_ms": 242030,
      "text": "那么我们这个就是说打个预防针"
    },
    {
      "ordinal": 63,
      "start_ms": 242030,
      "end_ms": 244370,
      "text": "这些高中生过了两三年"
    },
    {
      "ordinal": 64,
      "start_ms": 244370,
      "end_ms": 245590,
      "text": "他到大学里面了"
    },
    {
      "ordinal": 65,
      "start_ms": 245590,
      "end_ms": 246930,
      "text": "或者说他毕业了"
    },
    {
      "ordinal": 66,
      "start_ms": 246930,
      "end_ms": 248210,
      "text": "高中毕业"
    },
    {
      "ordinal": 67,
      "start_ms": 248210,
      "end_ms": 249210,
      "text": "然后不不念大学"
    },
    {
      "ordinal": 68,
      "start_ms": 249210,
      "end_ms": 250490,
      "text": "反正工作了怎么样的"
    },
    {
      "ordinal": 69,
      "start_ms": 250490,
      "end_ms": 254579,
      "text": "这些人只要查到他有这个历史的"
    },
    {
      "ordinal": 70,
      "start_ms": 254579,
      "end_ms": 257219,
      "text": "那么请请他出去"
    },
    {
      "ordinal": 71,
      "start_ms": 257640,
      "end_ms": 260279,
      "text": "只要查到他有这个在"
    },
    {
      "ordinal": 72,
      "start_ms": 260279,
      "end_ms": 262560,
      "text": "我们可以定义为这种通敌历史的"
    },
    {
      "ordinal": 73,
      "start_ms": 263840,
      "end_ms": 264340,
      "text": "请走"
    },
    {
      "ordinal": 74,
      "start_ms": 264340,
      "end_ms": 266560,
      "text": "只要发现请走"
    },
    {
      "ordinal": 75,
      "start_ms": 268660,
      "end_ms": 270140,
      "text": "啊我们做好这个工作"
    },
    {
      "ordinal": 76,
      "start_ms": 270140,
      "end_ms": 275260,
      "text": "不允许和这个某流系以及这些学院派知识分子"
    },
    {
      "ordinal": 77,
      "start_ms": 275260,
      "end_ms": 277900,
      "text": "其实他是亲西方资本的"
    },
    {
      "ordinal": 78,
      "start_ms": 278100,
      "end_ms": 283620,
      "text": "然后另外一方面又是和啊一些资产阶级合作的"
    },
    {
      "ordinal": 79,
      "start_ms": 283620,
      "end_ms": 284980,
      "text": "这群人"
    },
    {
      "ordinal": 80,
      "start_ms": 285380,
      "end_ms": 287650,
      "text": "只要他和他们同群组"
    },
    {
      "ordinal": 81,
      "start_ms": 287650,
      "end_ms": 288910,
      "text": "那么查到"
    },
    {
      "ordinal": 82,
      "start_ms": 288910,
      "end_ms": 292330,
      "text": "只要我们发现这些人宣扬啊"
    },
    {
      "ordinal": 83,
      "start_ms": 292330,
      "end_ms": 293450,
      "text": "这些道理或怎么样的"
    },
    {
      "ordinal": 84,
      "start_ms": 293450,
      "end_ms": 296190,
      "text": "这样的青少年在过了几年之后"
    },
    {
      "ordinal": 85,
      "start_ms": 296190,
      "end_ms": 298680,
      "text": "他是呃成年人"
    },
    {
      "ordinal": 86,
      "start_ms": 298680,
      "end_ms": 302230,
      "text": "他是这个本科生啊"
    },
    {
      "ordinal": 87,
      "start_ms": 303070,
      "end_ms": 305470,
      "text": "要把这些人都开掉"
    },
    {
      "ordinal": 88,
      "start_ms": 306300,
      "end_ms": 307820,
      "text": "那我们现在也可以查一查"
    },
    {
      "ordinal": 89,
      "start_ms": 307820,
      "end_ms": 310720,
      "text": "就是说呃不同俱乐部的"
    },
    {
      "ordinal": 90,
      "start_ms": 310720,
      "end_ms": 314710,
      "text": "有没有这种曾经是他们的拥趸的啊"
    },
    {
      "ordinal": 91,
      "start_ms": 314710,
      "end_ms": 316450,
      "text": "那要是要做好这个工作"
    },
    {
      "ordinal": 92,
      "start_ms": 317530,
      "end_ms": 321650,
      "text": "这些人我觉得是要至少要向我们坦白呀"
    },
    {
      "ordinal": 93,
      "start_ms": 321650,
      "end_ms": 324630,
      "text": "你在他们群组里面混什么目的"
    },
    {
      "ordinal": 94,
      "start_ms": 324630,
      "end_ms": 327600,
      "text": "是不是认同他们那一套啊"
    },
    {
      "ordinal": 95,
      "start_ms": 330720,
      "end_ms": 334600,
      "text": "或者说就是制造丑闻给西方媒体"
    },
    {
      "ordinal": 96,
      "start_ms": 334600,
      "end_ms": 335760,
      "text": "境外媒体利用那一套"
    },
    {
      "ordinal": 97,
      "start_ms": 335760,
      "end_ms": 337480,
      "text": "你是不是认同这一套"
    },
    {
      "ordinal": 98,
      "start_ms": 338290,
      "end_ms": 342950,
      "text": "你要如果发现有现在的这个学生成员"
    },
    {
      "ordinal": 99,
      "start_ms": 342950,
      "end_ms": 345610,
      "text": "他们几年前是初高中的时候"
    },
    {
      "ordinal": 100,
      "start_ms": 345610,
      "end_ms": 347280,
      "text": "是在那种群里面的"
    },
    {
      "ordinal": 101,
      "start_ms": 347280,
      "end_ms": 349840,
      "text": "这些人要做检讨"
    },
    {
      "ordinal": 102,
      "start_ms": 350069,
      "end_ms": 353269,
      "text": "要清清白白不清白的清掉"
    },
    {
      "ordinal": 103,
      "start_ms": 354429,
      "end_ms": 355269,
      "text": "这是一件事"
    },
    {
      "ordinal": 104,
      "start_ms": 355269,
      "end_ms": 359880,
      "text": "第二件事就是说还有一些是成年人"
    },
    {
      "ordinal": 105,
      "start_ms": 360280,
      "end_ms": 360840,
      "text": "对不对"
    },
    {
      "ordinal": 106,
      "start_ms": 360840,
      "end_ms": 362360,
      "text": "还有一些是已经有工作的"
    },
    {
      "ordinal": 107,
      "start_ms": 362360,
      "end_ms": 363440,
      "text": "有工作的这批人"
    },
    {
      "ordinal": 108,
      "start_ms": 364480,
      "end_ms": 369450,
      "text": "发现他们在刚刚我说的第一批人做的自媒体"
    },
    {
      "ordinal": 109,
      "start_ms": 369450,
      "end_ms": 370970,
      "text": "或者是什么燎原"
    },
    {
      "ordinal": 110,
      "start_ms": 370970,
      "end_ms": 373270,
      "text": "或者说是什么这些啊"
    },
    {
      "ordinal": 111,
      "start_ms": 373270,
      "end_ms": 376770,
      "text": "这种就是亲啊"
    },
    {
      "ordinal": 112,
      "start_ms": 376770,
      "end_ms": 379640,
      "text": "就是清某流系"
    },
    {
      "ordinal": 113,
      "start_ms": 379640,
      "end_ms": 384880,
      "text": "清那些学院派的那些搞西方式的啊"
    },
    {
      "ordinal": 114,
      "start_ms": 389720,
      "end_ms": 391640,
      "text": "就是所谓的网左自媒体了"
    },
    {
      "ordinal": 115,
      "start_ms": 391640,
      "end_ms": 393480,
      "text": "好多是这种幼稚的网左"
    },
    {
      "ordinal": 116,
      "start_ms": 393480,
      "end_ms": 395820,
      "text": "在下面给他说好话的"
    },
    {
      "ordinal": 117,
      "start_ms": 395820,
      "end_ms": 398060,
      "text": "有一些是啊"
    },
    {
      "ordinal": 118,
      "start_ms": 398060,
      "end_ms": 400860,
      "text": "20多岁的是还成年了工作的"
    },
    {
      "ordinal": 119,
      "start_ms": 400860,
      "end_ms": 402570,
      "text": "这没社交账号"
    },
    {
      "ordinal": 120,
      "start_ms": 402570,
      "end_ms": 404650,
      "text": "如果发现成年用户"
    },
    {
      "ordinal": 121,
      "start_ms": 404650,
      "end_ms": 407250,
      "text": "社交账号竟然在给这个东西说好话"
    },
    {
      "ordinal": 122,
      "start_ms": 407250,
      "end_ms": 408170,
      "text": "也就是说你在看"
    },
    {
      "ordinal": 123,
      "start_ms": 408170,
      "end_ms": 410880,
      "text": "比如说看我最近那几个小孩"
    },
    {
      "ordinal": 124,
      "start_ms": 411080,
      "end_ms": 413120,
      "text": "小孩的那个什么自媒体"
    },
    {
      "ordinal": 125,
      "start_ms": 413120,
      "end_ms": 414600,
      "text": "下面你看到一个B站账号"
    },
    {
      "ordinal": 126,
      "start_ms": 414600,
      "end_ms": 415680,
      "text": "你很眼熟"
    },
    {
      "ordinal": 127,
      "start_ms": 415680,
      "end_ms": 418580,
      "text": "竟然是你们自己俱乐部里面的人"
    },
    {
      "ordinal": 128,
      "start_ms": 418580,
      "end_ms": 420860,
      "text": "这个人竟然在给他说好话"
    },
    {
      "ordinal": 129,
      "start_ms": 422540,
      "end_ms": 424100,
      "text": "把他开掉啊"
    },
    {
      "ordinal": 130,
      "start_ms": 424100,
      "end_ms": 425260,
      "text": "这是我的建议啊"
    },
    {
      "ordinal": 131,
      "start_ms": 425260,
      "end_ms": 426780,
      "text": "或者说让他做检讨"
    },
    {
      "ordinal": 132,
      "start_ms": 426780,
      "end_ms": 428169,
      "text": "你在干嘛"
    },
    {
      "ordinal": 133,
      "start_ms": 428169,
      "end_ms": 431369,
      "text": "这小孩在邪路上已经走到这个地步了"
    },
    {
      "ordinal": 134,
      "start_ms": 431369,
      "end_ms": 432569,
      "text": "你还鼓励他"
    },
    {
      "ordinal": 135,
      "start_ms": 432569,
      "end_ms": 435490,
      "text": "还包容他啊"
    },
    {
      "ordinal": 136,
      "start_ms": 435490,
      "end_ms": 436690,
      "text": "就这两类人啊"
    },
    {
      "ordinal": 137,
      "start_ms": 436690,
      "end_ms": 439130,
      "text": "前面一类现在还不是成年人"
    },
    {
      "ordinal": 138,
      "start_ms": 439130,
      "end_ms": 440250,
      "text": "学生"
    },
    {
      "ordinal": 139,
      "start_ms": 440250,
      "end_ms": 444340,
      "text": "如果发现他有这个这个不干净的历史"
    },
    {
      "ordinal": 140,
      "start_ms": 445700,
      "end_ms": 446740,
      "text": "Goodbye"
    },
    {
      "ordinal": 141,
      "start_ms": 446740,
      "end_ms": 451550,
      "text": "那么如果说是这叫做什么"
    },
    {
      "ordinal": 142,
      "start_ms": 452710,
      "end_ms": 453770,
      "text": "改弦更张了"
    },
    {
      "ordinal": 143,
      "start_ms": 453770,
      "end_ms": 456230,
      "text": "悔过自新啊"
    },
    {
      "ordinal": 144,
      "start_ms": 456860,
      "end_ms": 459500,
      "text": "做一个明确的表态做检讨"
    },
    {
      "ordinal": 145,
      "start_ms": 459500,
      "end_ms": 462540,
      "text": "对之前那个做一个明确的表态做检讨"
    },
    {
      "ordinal": 146,
      "start_ms": 463050,
      "end_ms": 465130,
      "text": "然后这是第一类"
    },
    {
      "ordinal": 147,
      "start_ms": 465130,
      "end_ms": 467130,
      "text": "第二类"
    },
    {
      "ordinal": 148,
      "start_ms": 469500,
      "end_ms": 473220,
      "text": "讲清楚你两面派啊"
    },
    {
      "ordinal": 149,
      "start_ms": 473220,
      "end_ms": 475040,
      "text": "你是在做点两面派"
    },
    {
      "ordinal": 150,
      "start_ms": 477080,
      "end_ms": 479320,
      "text": "啊你发现的话"
    },
    {
      "ordinal": 151,
      "start_ms": 480520,
      "end_ms": 484360,
      "text": "这种人他还抱抱有这种政治投机的野心诶"
    },
    {
      "ordinal": 152,
      "start_ms": 484360,
      "end_ms": 487760,
      "text": "他不是实实在在做实际工作的"
    },
    {
      "ordinal": 153,
      "start_ms": 487760,
      "end_ms": 491790,
      "text": "那么这种人呢要把他清掉好吧"
    },
    {
      "ordinal": 154,
      "start_ms": 491790,
      "end_ms": 493830,
      "text": "我们能做的就是这个东西了啊"
    },
    {
      "ordinal": 155,
      "start_ms": 493830,
      "end_ms": 494330,
      "text": "我们能做"
    },
    {
      "ordinal": 156,
      "start_ms": 494330,
      "end_ms": 497730,
      "text": "我们不能说对这些什么那些什么群组啊"
    },
    {
      "ordinal": 157,
      "start_ms": 497730,
      "end_ms": 499290,
      "text": "发起什么侦查呀"
    },
    {
      "ordinal": 158,
      "start_ms": 499290,
      "end_ms": 500850,
      "text": "什么把他什么端掉什么"
    },
    {
      "ordinal": 159,
      "start_ms": 500850,
      "end_ms": 501450,
      "text": "这我们做不了"
    },
    {
      "ordinal": 160,
      "start_ms": 501450,
      "end_ms": 503850,
      "text": "但是我们做好自己的工作"
    },
    {
      "ordinal": 161,
      "start_ms": 503850,
      "end_ms": 505410,
      "text": "我们让自己干干净净"
    },
    {
      "ordinal": 162,
      "start_ms": 505410,
      "end_ms": 507909,
      "text": "不要跟他们扯上这种关系"
    },
    {
      "ordinal": 163,
      "start_ms": 508109,
      "end_ms": 511820,
      "text": "他们洗了一批是高中生洗脑洗出来了"
    },
    {
      "ordinal": 164,
      "start_ms": 511820,
      "end_ms": 514460,
      "text": "然后还有一批这个成年人"
    },
    {
      "ordinal": 165,
      "start_ms": 514460,
      "end_ms": 519740,
      "text": "不明就里的对这些高中生表达同情和支持"
    },
    {
      "ordinal": 166,
      "start_ms": 520320,
      "end_ms": 521539,
      "text": "我们不同情"
    },
    {
      "ordinal": 167,
      "start_ms": 521539,
      "end_ms": 522760,
      "text": "没什么好同情的"
    },
    {
      "ordinal": 168,
      "start_ms": 524039,
      "end_ms": 527160,
      "text": "瞎搞胡搞乱搞"
    },
    {
      "ordinal": 169,
      "start_ms": 528580,
      "end_ms": 534220,
      "text": "扯后腿帮倒忙说屁话"
    },
    {
      "ordinal": 170,
      "start_ms": 535500,
      "end_ms": 539060,
      "text": "毛用也没有一边去"
    },
    {
      "ordinal": 171,
      "start_ms": 540150,
      "end_ms": 541150,
      "text": "好吧"
    },
    {
      "ordinal": 172,
      "start_ms": 541150,
      "end_ms": 542890,
      "text": "做居心叵测"
    },
    {
      "ordinal": 173,
      "start_ms": 542890,
      "end_ms": 544710,
      "text": "行为逻辑非常诡异"
    },
    {
      "ordinal": 174,
      "start_ms": 544710,
      "end_ms": 546270,
      "text": "无用"
    },
    {
      "ordinal": 175,
      "start_ms": 547780,
      "end_ms": 550300,
      "text": "啊这么一种状态"
    },
    {
      "ordinal": 176,
      "start_ms": 551080,
      "end_ms": 553040,
      "text": "做好自我管理"
    },
    {
      "ordinal": 177,
      "start_ms": 553040,
      "end_ms": 555560,
      "text": "自我清洁啊"
    },
    {
      "ordinal": 178,
      "start_ms": 555560,
      "end_ms": 561090,
      "text": "这两类人一定是不能够以任何形式干扰"
    },
    {
      "ordinal": 179,
      "start_ms": 561090,
      "end_ms": 562310,
      "text": "妨碍我们的工作的"
    },
    {
      "ordinal": 180,
      "start_ms": 562310,
