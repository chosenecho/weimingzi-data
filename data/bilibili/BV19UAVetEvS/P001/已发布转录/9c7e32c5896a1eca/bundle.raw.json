{"segments":[{"start":0.22,"end":1.38,"text":"4.44了"},{"start":2.58,"end":4.1,"text":"我这还有时间哦"},{"start":4.1,"end":6.189,"text":"我也有时间不行"},{"start":6.949,"end":8.98,"text":"看一下这一"},{"start":12.38,"end":15.28,"text":"就说他想澄清的几点"},{"start":15.28,"end":18.97,"text":"就是说不是说见面前聊的比较少"},{"start":18.97,"end":20.79,"text":"见面后你们开始聊的多"},{"start":20.79,"end":22.37,"text":"没有见面前我也跟他聊过"},{"start":22.37,"end":24.29,"text":"他说网络上聊一些对对"},{"start":24.29,"end":28.09,"text":"但见面后他开始跟你聊天更加多了对"},{"start":28.09,"end":30.25,"text":"然后他的意思是说"},{"start":30.25,"end":36.96,"text":"见面前就是呃大家接触的程度还是更浅的"},{"start":36.96,"end":38.64,"text":"就是说没有那么信任"},{"start":38.64,"end":40.08,"text":"就是线上一些工作"},{"start":40.08,"end":43.54,"text":"他说见面后才基本上线下转成线下"},{"start":43.54,"end":46.04,"text":"见面以后才有更加多的新人"},{"start":46.04,"end":48.17,"text":"就是可以聊更加多的东西"},{"start":48.17,"end":50.91,"text":"所以他对这个转变是这样说的"},{"start":50.91,"end":52.55,"text":"不是因为外貌啊什么"},{"start":52.55,"end":53.61,"text":"不是开始"},{"start":53.61,"end":54.33,"text":"对不起"},{"start":54.33,"end":56.89,"text":"我觉得他就是他说的这些话"},{"start":56.89,"end":58.77,"text":"都是让专业套房就是正常的嘛"},{"start":58.77,"end":59.61,"text":"线下信任了之后"},{"start":59.61,"end":61.85,"text":"但是线我是线上更信任他多一点"},{"start":61.85,"end":63.05,"text":"线下接触过之后"},{"start":63.05,"end":64.05,"text":"我反而不信任他了"},{"start":64.05,"end":65.99,"text":"就是因为他跟我聊的东西尺度"},{"start":65.99,"end":67.64,"text":"从而打破了原来的平衡"},{"start":67.64,"end":69.78,"text":"以前是工作的同事之间的关系"},{"start":69.78,"end":73.14,"text":"后面聊着东西就可以看到乱七八糟的"},{"start":73.14,"end":75.33,"text":"所以我不信任他了"},{"start":75.45,"end":77.61,"text":"嗯他也给我看了一些"},{"start":77.61,"end":80.87,"text":"他就是在变变成爹味很浓对吧"},{"start":80.87,"end":82.61,"text":"说你是什么傻孩子"},{"start":82.61,"end":84.26,"text":"还有什么啊"},{"start":84.26,"end":86.12,"text":"他有那他有聊天记录是吗"},{"start":86.12,"end":89.14,"text":"就是你发的那些到时给我看了一遍"},{"start":89.14,"end":90.3,"text":"就是微信上的那些"},{"start":90.3,"end":91.31,"text":"还有的啊"},{"start":91.31,"end":92.07,"text":"还有一对"},{"start":92.07,"end":93.79,"text":"那是已经是后面比较后面了"},{"start":93.79,"end":95.27,"text":"更早的一些聊天记录我没有了"},{"start":95.27,"end":97.37,"text":"他说是10月份的那些"},{"start":97.37,"end":98.93,"text":"10月份就要线下见面啊"},{"start":98.93,"end":101.37,"text":"就是线下见面之后我不信任他"},{"start":101.37,"end":102.85,"text":"但是他对我穷追不舍的"},{"start":102.85,"end":104.21,"text":"就是到现象"},{"start":104.21,"end":105.83,"text":"这个是马上就不信任"},{"start":105.83,"end":110.13,"text":"不是是线下见面之后没有马上不见人信任"},{"start":110.13,"end":111.73,"text":"是在合肥上市之后"},{"start":112.93,"end":115.25,"text":"合肥的比亚迪是吗"},{"start":115.25,"end":117.35,"text":"对那就是11月初的时候"},{"start":117.35,"end":119.03,"text":"10月23号吧"},{"start":119.03,"end":120.43,"text":"10月23号对"},{"start":120.43,"end":122.41,"text":"是10月23号哦对了"},{"start":122.41,"end":123.37,"text":"你们先去比亚迪"},{"start":123.37,"end":124.93,"text":"然后去了宜兴会哦"},{"start":124.93,"end":125.81,"text":"我自己去的宜兴"},{"start":125.81,"end":126.87,"text":"你自己去的宜兴会"},{"start":126.87,"end":129.279,"text":"那就是咳咳咳"},{"start":129.279,"end":130.859,"text":"好的香炮是狗"},{"start":130.859,"end":132.629,"text":"嗯咳咳"},{"start":132.629,"end":136.129,"text":"他说他跟我聊的多是因为线上转线下了"},{"start":136.129,"end":137.229,"text":"但是我不信任他"},{"start":137.229,"end":138.389,"text":"也是因为线上转线下了"},{"start":138.389,"end":140.54,"text":"发现这个人有点逗猫人"},{"start":140.9,"end":144.1,"text":"你是那你说你开始对他不信任"},{"start":144.1,"end":146.1,"text":"是比亚迪的时候"},{"start":146.1,"end":148.44,"text":"真正不幸的是比亚迪的事情对"},{"start":148.44,"end":150.02,"text":"就是对初次见面"},{"start":150.02,"end":150.92,"text":"然后你和六"},{"start":150.92,"end":155.54,"text":"你和阿浩也是比亚迪比亚迪的时候认识的对"},{"start":156.26,"end":159.62,"text":"然后他是不是就是在这个时候"},{"start":159.62,"end":161.98,"text":"在10月20几号的时候"},{"start":161.98,"end":167.22,"text":"他就开始谈到阿浩的什么小资产阶级性"},{"start":167.54,"end":170.519,"text":"那个时候他就已经开始有点自"},{"start":170.519,"end":174.919,"text":"他说他小资产这一届好像没没有"},{"start":174.919,"end":175.759,"text":"不是比亚迪"},{"start":175.759,"end":176.939,"text":"比亚迪好像没怎么谈"},{"start":176.939,"end":178.279,"text":"他就是之后那几天吧"},{"start":178.279,"end":179.19,"text":"我在北京的时候"},{"start":179.294,"end":182.16,"text":"北京那是很久以后了"},{"start":182.76,"end":184.92,"text":"反正从我开始跟他聊到"},{"start":187.5,"end":189.52,"text":"就是说他就开始烦讨厌他"},{"start":189.52,"end":193.189,"text":"就是说那个比亚迪之前你们都相"},{"start":193.189,"end":194.729,"text":"也是线下见过面了"},{"start":194.729,"end":196.969,"text":"但这之前你对他还是十分信任的"},{"start":196.969,"end":200.409,"text":"也觉得他说的话有点没有十分信任"},{"start":200.409,"end":202.84,"text":"但是没有信任是慢慢的削弱了"},{"start":202.84,"end":205.24,"text":"但是比亚迪之后就很有点反感了"},{"start":205.24,"end":206.0,"text":"有点反感"},{"start":206.0,"end":206.8,"text":"为什么反感"},{"start":206.8,"end":208.58,"text":"就是觉得他工作态度不积极"},{"start":208.58,"end":209.44,"text":"很摆烂"},{"start":209.44,"end":213.94,"text":"是就是主要是也不是也没有想到这个性骚扰啊"},{"start":213.94,"end":214.26,"text":"什么"},{"start":215.82,"end":217.42,"text":"还有一个就是我跟你讲的"},{"start":217.42,"end":218.92,"text":"他那天你自己看到的"},{"start":218.92,"end":220.28,"text":"我说了他不太好的"},{"start":220.28,"end":221.2,"text":"我批评了他之后"},{"start":221.2,"end":222.6,"text":"我就是就就跟你批评"},{"start":222.6,"end":223.56,"text":"我自己发网上"},{"start":223.56,"end":224.92,"text":"就像你刚刚批评我们俩"},{"start":224.92,"end":225.96,"text":"说我俩那个态度"},{"start":225.96,"end":226.9,"text":"工作态度不积极"},{"start":226.9,"end":227.88,"text":"我也批评了他"},{"start":227.88,"end":230.25,"text":"那天晚上他当时还接受了我的批评"},{"start":230.25,"end":233.32,"text":"结果第二天失魂落魄的坐在那调研"},{"start":233.32,"end":234.4,"text":"最后一天对吧"},{"start":234.4,"end":235.26,"text":"对装逼"},{"start":235.26,"end":237.24,"text":"他妈的都说一天一个晚上没睡觉"},{"start":237.24,"end":238.6,"text":"被我说了很难受"},{"start":238.6,"end":240.46,"text":"回来一直给我发那种骚话"},{"start":240.46,"end":242.5,"text":"就想我那种什么类似这种话"},{"start":242.5,"end":243.4,"text":"火车上睡不着觉"},{"start":243.4,"end":243.9,"text":"想我"},{"start":243.9,"end":245.899,"text":"我突然就觉得很恶心啊"},{"start":245.899,"end":247.139,"text":"哇你真恶心"},{"start":247.139,"end":247.619,"text":"我"},{"start":247.619,"end":248.859,"text":"他那天还很装逼"},{"start":248.859,"end":250.179,"text":"头发梳的整整齐齐"},{"start":250.179,"end":250.899,"text":"坐在那边"},{"start":250.899,"end":254.139,"text":"然后手叉着腰他妈的坐那不动"},{"start":254.429,"end":255.449,"text":"出来跟他打电"},{"start":255.449,"end":255.909,"text":"打个招呼"},{"start":255.909,"end":256.829,"text":"还爱理不理的"},{"start":256.829,"end":257.428,"text":"对啊对啊"},{"start":257.428,"end":259.069,"text":"就会坏掉"},{"start":259.069,"end":260.709,"text":"不是你在干活来干嘛的"},{"start":260.709,"end":262.36,"text":"反正就感觉那个人很怪"},{"start":262.36,"end":264.2,"text":"他回来又给我发了一种奇怪的东西"},{"start":264.2,"end":265.54,"text":"在演戏呢"},{"start":265.54,"end":267.18,"text":"等一下记一下"},{"start":267.18,"end":269.5,"text":"我记我有两份"},{"start":269.5,"end":272.66,"text":"你就说见面后信任度下降了"},{"start":272.66,"end":276.7,"text":"对就越来越不信任他了"},{"start":277.38,"end":280.46,"text":"然后是比亚迪调研室最后一天对吧"},{"start":280.46,"end":285.64,"text":"对表现出的这奇怪的就很奇怪"},{"start":285.64,"end":288.54,"text":"这种好嘶"},{"start":288.54,"end":291.3,"text":"最后一天他行为奇怪奇怪"},{"start":291.3,"end":292.2,"text":"在什么地方"},{"start":292.2,"end":293.22,"text":"就是跟你讲什么"},{"start":293.22,"end":295.56,"text":"你就是你批评了他作风上的问题"},{"start":295.56,"end":295.88,"text":"对呀"},{"start":295.88,"end":296.88,"text":"工作态度不积极啊"},{"start":296.88,"end":298.3,"text":"我说还不如我们俩呢"},{"start":298.3,"end":299.62,"text":"我说他有点小自信"},{"start":299.62,"end":300.74,"text":"然后他就受不了了"},{"start":300.74,"end":301.74,"text":"一晚上没睡觉"},{"start":301.74,"end":303.34,"text":"失魂落魄的吐了一夜"},{"start":303.34,"end":305.84,"text":"等下等下你是不慢的"},{"start":305.84,"end":306.88,"text":"就是批评了他"},{"start":306.88,"end":308.48,"text":"然后张涛呢就表示"},{"start":308.48,"end":311.059,"text":"因为你的批评导致我一夜没睡嗯"},{"start":311.059,"end":312.619,"text":"人说了一些奇奇怪怪的话"},{"start":312.619,"end":316.83,"text":"对他这奇奇怪怪话是说什么"},{"start":316.83,"end":317.89,"text":"就是说你批评我"},{"start":317.89,"end":318.63,"text":"我很难受"},{"start":318.63,"end":321.09,"text":"我心里很难受不啊"},{"start":321.09,"end":323.84,"text":"怎么样对这样说奇怪的话"},{"start":323.84,"end":325.32,"text":"什么什么样奇怪的话"},{"start":325.32,"end":328.659,"text":"就是线上说还是线下说线上说的"},{"start":328.659,"end":330.659,"text":"线上说他妈的还不如线下说"},{"start":330.659,"end":331.059,"text":"我跟你讲"},{"start":331.059,"end":332.079,"text":"线下说还能说开"},{"start":332.079,"end":333.459,"text":"那线下他不好意思说啊"},{"start":333.459,"end":335.22,"text":"对他线上没这逼胆子"},{"start":335.22,"end":336.78,"text":"现在是分别了之后说的"},{"start":336.78,"end":338.46,"text":"还是他说了哪些话"},{"start":338.46,"end":341.25,"text":"他就反正就是现在消息记录没了吧"},{"start":341.25,"end":342.21,"text":"没了就是因为没了"},{"start":342.21,"end":342.93,"text":"我的"},{"start":342.93,"end":344.49,"text":"那你跟我说一下他说的什么样的"},{"start":344.49,"end":345.53,"text":"慢慢被我批评了"},{"start":345.53,"end":346.46,"text":"很难受"},{"start":346.46,"end":348.24,"text":"对一晚上都在想人"},{"start":348.24,"end":348.82,"text":"想我了吧"},{"start":348.82,"end":349.98,"text":"大概什么意思"},{"start":349.98,"end":350.82,"text":"想什么"},{"start":350.82,"end":352.06,"text":"想你还是对呀"},{"start":352.06,"end":354.19,"text":"想你的批评还是想你想我"},{"start":354.19,"end":356.19,"text":"我想我想问他想我干嘛"},{"start":356.19,"end":357.19,"text":"就想我"},{"start":357.19,"end":358.81,"text":"了操了"},{"start":358.81,"end":360.61,"text":"老贼大概就这个意思吧"},{"start":360.61,"end":362.41,"text":"然后火车上回回北京的火车"},{"start":362.41,"end":364.03,"text":"他就在回北京的火车上说的"},{"start":364.03,"end":365.49,"text":"还不是当天说的吗"},{"start":365.49,"end":366.81,"text":"当天你说清楚就好了"},{"start":366.81,"end":367.79,"text":"我给你解释一遍"},{"start":367.79,"end":368.41,"text":"他妈这种话"},{"start":368.41,"end":370.63,"text":"他不当面说在想你"},{"start":370.63,"end":371.01,"text":"诶"},{"start":371.01,"end":372.4,"text":"诶你还做笔录呢"},{"start":372.4,"end":373.4,"text":"不是我要记一下"},{"start":373.4,"end":374.24,"text":"不然我记不清楚"},{"start":374.24,"end":375.52,"text":"我还得前后对比一下"},{"start":375.52,"end":377.0,"text":"就好好对比"},{"start":377.0,"end":378.36,"text":"我做事认真一点"},{"start":378.36,"end":378.72,"text":"可以吗"},{"start":378.72,"end":379.2,"text":"对对对"},{"start":379.2,"end":381.089,"text":"可以可以可以怎么原话"},{"start":381.089,"end":383.049,"text":"他到底原话我也不太记得了"},{"start":383.049,"end":385.449,"text":"反正就是说他一晚上就因为你的批评"},{"start":385.449,"end":386.4