{"segments":[{"start":0.06,"end":0.9,"text":"再强调一遍"},{"start":0.9,"end":2.76,"text":"我唱的所有爱情歌曲"},{"start":2.76,"end":5.04,"text":"他的实质都是革命歌曲啊"},{"start":5.04,"end":5.93,"text":"你们可以"},{"start":5.93,"end":11.74,"text":"我说的还有一首也是178年写的啊"},{"start":12.08,"end":14.02,"text":"可能是16年写的"},{"start":47.32,"end":50.7,"text":"人生似水花转无影"},{"start":50.7,"end":53.62,"text":"问落英谁人心"},{"start":53.62,"end":57.34,"text":"春风中沉吟不语"},{"start":58.78,"end":61.24,"text":"明月照飞花成梦"},{"start":61.24,"end":62.08,"text":"影"},{"start":62.08,"end":64.78,"text":"如你容颜薄浅"},{"start":64.78,"end":66.94,"text":"笑我无处"},{"start":66.94,"end":70.06,"text":"你游戏"},{"start":92.78,"end":97.6,"text":"茫然群寻无边沉醉秋色"},{"start":97.6,"end":99.39,"text":"云烟凌波"},{"start":99.39,"end":101.97,"text":"横塘旧路深"},{"start":101.97,"end":104.13,"text":"残阳万顷"},{"start":104.13,"end":106.9,"text":"几度春风拂面"},{"start":106.9,"end":108.85,"text":"宛若多情"},{"start":108.85,"end":116.52,"text":"人间耳畔凄凄低语俗语谁听"},{"start":126.62,"end":129.37,"text":"时光穿梭间"},{"start":129.37,"end":132.42,"text":"草木青携相依"},{"start":132.42,"end":135.87,"text":"黄昏中怕死无辜"},{"start":135.87,"end":138.08,"text":"美柔似水"},{"start":138.08,"end":140.69,"text":"与君别离之心"},{"start":140.69,"end":143.51,"text":"与君相约之心"},{"start":143.51,"end":145.87,"text":"柳梢上明月"},{"start":145.87,"end":148.33,"text":"秋雨当影为夜戏"},{"start":148.33,"end":150.04,"text":"曾经"},{"start":152.02,"end":155.24,"text":"残花旧人曾失去"},{"start":155.24,"end":155.69,"text":"藏"},{"start":155.69,"end":157.82,"text":"装下谁来骑"},{"start":157.82,"end":162.98,"text":"无奈往事在梦里"},{"start":162.98,"end":164.54,"text":"待明日飞"},{"start":164.54,"end":164.9,"text":"花"},{"start":164.9,"end":169.0,"text":"春风里催泪滴落凤梨"},{"start":169.0,"end":174.34,"text":"恰似你说的是你"},{"start":176.88,"end":182.42,"text":"啊啊啊啊"},{"start":200.04,"end":205.59,"text":"孤独便分钟何物在闪耀"},{"start":205.59,"end":211.22,"text":"在孤单风中独自迎接未来"},{"start":211.22,"end":215.84,"text":"在明月圆满中盛开"},{"start":217.1,"end":226.5,"text":"将那遥远遥远光明带来到人间"},{"start":226.78,"end":229.83,"text":"多少落花要无痕"},{"start":229.83,"end":232.7,"text":"有多少痴情人"},{"start":232.7,"end":236.42,"text":"此处飘零在红尘"},{"start":237.92,"end":241.28,"text":"而如今忽略了纷尘"},{"start":241.28,"end":248.72,"text":"只留下这份真与我身影重合的时分"}],"source":"subtitle"}
