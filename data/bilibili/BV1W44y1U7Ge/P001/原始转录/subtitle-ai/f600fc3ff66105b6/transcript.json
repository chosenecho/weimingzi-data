  "content_sha256": "f600fc3ff66105b696060e36296ece03724b848540d131ee995a15e7154de401",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 60,
      "end_ms": 900,
      "text": "再强调一遍"
    },
    {
      "ordinal": 1,
      "start_ms": 900,
      "end_ms": 2760,
      "text": "我唱的所有爱情歌曲"
    },
    {
      "ordinal": 2,
      "start_ms": 2760,
      "end_ms": 5040,
      "text": "他的实质都是革命歌曲啊"
    },
    {
      "ordinal": 3,
      "start_ms": 5040,
      "end_ms": 5930,
      "text": "你们可以"
    },
    {
      "ordinal": 4,
      "start_ms": 5930,
      "end_ms": 11740,
      "text": "我说的还有一首也是178年写的啊"
    },
    {
      "ordinal": 5,
      "start_ms": 12080,
      "end_ms": 14020,
      "text": "可能是16年写的"
    },
    {
      "ordinal": 6,
      "start_ms": 47320,
      "end_ms": 50700,
      "text": "人生似水花转无影"
    },
    {
      "ordinal": 7,
      "start_ms": 50700,
      "end_ms": 53620,
      "text": "问落英谁人心"
    },
    {
      "ordinal": 8,
      "start_ms": 53620,
      "end_ms": 57340,
      "text": "春风中沉吟不语"
    },
    {
      "ordinal": 9,
      "start_ms": 58780,
      "end_ms": 61240,
      "text": "明月照飞花成梦"
    },
    {
      "ordinal": 10,
      "start_ms": 61240,
      "end_ms": 62080,
      "text": "影"
    },
    {
      "ordinal": 11,
      "start_ms": 62080,
      "end_ms": 64780,
      "text": "如你容颜薄浅"
    },
    {
      "ordinal": 12,
      "start_ms": 64780,
      "end_ms": 66940,
      "text": "笑我无处"
    },
    {
      "ordinal": 13,
      "start_ms": 66940,
      "end_ms": 70060,
      "text": "你游戏"
    },
    {
      "ordinal": 14,
      "start_ms": 92780,
      "end_ms": 97600,
      "text": "茫然群寻无边沉醉秋色"
    },
    {
      "ordinal": 15,
      "start_ms": 97600,
      "end_ms": 99390,
      "text": "云烟凌波"
    },
    {
      "ordinal": 16,
      "start_ms": 99390,
      "end_ms": 101970,
      "text": "横塘旧路深"
    },
    {
      "ordinal": 17,
      "start_ms": 101970,
      "end_ms": 104130,
      "text": "残阳万顷"
    },
    {
      "ordinal": 18,
      "start_ms": 104130,
      "end_ms": 106900,
      "text": "几度春风拂面"
    },
    {
      "ordinal": 19,
      "start_ms": 106900,
      "end_ms": 108850,
      "text": "宛若多情"
    },
    {
      "ordinal": 20,
      "start_ms": 108850,
      "end_ms": 116520,
      "text": "人间耳畔凄凄低语俗语谁听"
    },
    {
      "ordinal": 21,
      "start_ms": 126620,
      "end_ms": 129370,
      "text": "时光穿梭间"
    },
    {
      "ordinal": 22,
      "start_ms": 129370,
      "end_ms": 132420,
      "text": "草木青携相依"
    },
    {
      "ordinal": 23,
      "start_ms": 132420,
      "end_ms": 135870,
      "text": "黄昏中怕死无辜"
    },
    {
      "ordinal": 24,
      "start_ms": 135870,
      "end_ms": 138080,
      "text": "美柔似水"
    },
    {
      "ordinal": 25,
      "start_ms": 138080,
      "end_ms": 140690,
      "text": "与君别离之心"
    },
    {
      "ordinal": 26,
      "start_ms": 140690,
      "end_ms": 143510,
      "text": "与君相约之心"
    },
    {
      "ordinal": 27,
      "start_ms": 143510,
      "end_ms": 145870,
      "text": "柳梢上明月"
    },
    {
      "ordinal": 28,
      "start_ms": 145870,
      "end_ms": 148330,
      "text": "秋雨当影为夜戏"
    },
    {
      "ordinal": 29,
      "start_ms": 148330,
      "end_ms": 150040,
      "text": "曾经"
    },
    {
      "ordinal": 30,
      "start_ms": 152020,
      "end_ms": 155240,
      "text": "残花旧人曾失去"
    },
    {
      "ordinal": 31,
      "start_ms": 155240,
      "end_ms": 155690,
      "text": "藏"
    },
    {
      "ordinal": 32,
      "start_ms": 155690,
      "end_ms": 157820,
      "text": "装下谁来骑"
    },
    {
      "ordinal": 33,
      "start_ms": 157820,
      "end_ms": 162980,
      "text": "无奈往事在梦里"
    },
    {
      "ordinal": 34,
      "start_ms": 162980,
      "end_ms": 164540,
      "text": "待明日飞"
    },
    {
      "ordinal": 35,
      "start_ms": 164540,
      "end_ms": 164900,
      "text": "花"
    },
    {
      "ordinal": 36,
      "start_ms": 164900,
      "end_ms": 169000,
      "text": "春风里催泪滴落凤梨"
    },
    {
      "ordinal": 37,
      "start_ms": 169000,
      "end_ms": 174340,
      "text": "恰似你说的是你"
    },
    {
      "ordinal": 38,
      "start_ms": 176880,
      "end_ms": 182420,
      "text": "啊啊啊啊"
    },
    {
      "ordinal": 39,
      "start_ms": 200040,
      "end_ms": 205590,
      "text": "孤独便分钟何物在闪耀"
    },
    {
      "ordinal": 40,
      "start_ms": 205590,
      "end_ms": 211220,
      "text": "在孤单风中独自迎接未来"
    },
    {
      "ordinal": 41,
      "start_ms": 211220,
      "end_ms": 215840,
      "text": "在明月圆满中盛开"
    },
    {
      "ordinal": 42,
      "start_ms": 217100,
      "end_ms": 226500,
      "text": "将那遥远遥远光明带来到人间"
    },
    {
      "ordinal": 43,
      "start_ms": 226780,
      "end_ms": 229830,
      "text": "多少落花要无痕"
    },
    {
      "ordinal": 44,
      "start_ms": 229830,
      "end_ms": 232700,
      "text": "有多少痴情人"
    },
    {
      "ordinal": 45,
      "start_ms": 232700,
      "end_ms": 236420,
      "text": "此处飘零在红尘"
    },
    {
      "ordinal": 46,
      "start_ms": 237920,
      "end_ms": 241280,
      "text": "而如今忽略了纷尘"
    },
    {
      "ordinal": 47,
      "start_ms": 241280,
      "end_ms": 248720,
      "text": "只留下这份真与我身影重合的时分"
    }
  ],
  "text": "再强调一遍\n我唱的所有爱情歌曲\n他的实质都是革命歌曲啊\n你们可以\n我说的还有一首也是178年写的啊\n可能是16年写的\n人生似水花转无影\n问落英谁人心\n春风中沉吟不语\n明月照飞花成梦\n影\n如你容颜薄浅\n笑我无处\n你游戏\n茫然群寻无边沉醉秋色\n云烟凌波\n横塘旧路深\n残阳万顷\n几度春风拂面\n宛若多情\n人间耳畔凄凄低语俗语谁听\n时光穿梭间\n草木青携相依\n黄昏中怕死无辜\n美柔似水\n与君别离之心\n与君相约之心\n柳梢上明月\n秋雨当影为夜戏\n曾经\n残花旧人曾失去\n藏\n装下谁来骑\n无奈往事在梦里\n待明日飞\n花\n春风里催泪滴落凤梨\n恰似你说的是你\n啊啊啊啊\n孤独便分钟何物在闪耀\n在孤单风中独自迎接未来\n在明月圆满中盛开\n将那遥远遥远光明带来到人间\n多少落花要无痕\n有多少痴情人\n此处飘零在红尘\n而如今忽略了纷尘\n只留下这份真与我身影重合的时分",
  "timing_issue": null
}
