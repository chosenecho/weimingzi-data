  "segments": [
    {
      "ordinal": 0,
      "start_ms": 120,
      "end_ms": 2070,
      "text": "我们说关于知识付费呀"
    },
    {
      "ordinal": 1,
      "start_ms": 2070,
      "end_ms": 3960,
      "text": "公益小组应该有个立场"
    },
    {
      "ordinal": 2,
      "start_ms": 3960,
      "end_ms": 11380,
      "text": "就是说绝对不进行关于就是说啊我们的呃"
    },
    {
      "ordinal": 3,
      "start_ms": 13200,
      "end_ms": 15560,
      "text": "啊就绝对不要搞什么知识付费了"
    },
    {
      "ordinal": 4,
      "start_ms": 15560,
      "end_ms": 16340,
      "text": "就简单来讲"
    },
    {
      "ordinal": 5,
      "start_ms": 16340,
      "end_ms": 17840,
      "text": "不要搞啥知识付费"
    },
    {
      "ordinal": 6,
      "start_ms": 20660,
      "end_ms": 23230,
      "text": "搞任何形式的知识付费啊"
    },
    {
      "ordinal": 7,
      "start_ms": 26770,
      "end_ms": 27310,
      "text": "啊"
    },
    {
      "ordinal": 8,
      "start_ms": 27310,
      "end_ms": 30430,
      "text": "关于历史和经济观察分析"
    },
    {
      "ordinal": 9,
      "start_ms": 30430,
      "end_ms": 36120,
      "text": "以及行动路线的制定和导向的这些啊"
    },
    {
      "ordinal": 10,
      "start_ms": 36120,
      "end_ms": 40670,
      "text": "对于我们自己追求的事业啊"
    },
    {
      "ordinal": 11,
      "start_ms": 40670,
      "end_ms": 45580,
      "text": "本身就是一个啊内在反思和外在践行的"
    },
    {
      "ordinal": 12,
      "start_ms": 45580,
      "end_ms": 46240,
      "text": "一个关系的"
    },
    {
      "ordinal": 13,
      "start_ms": 46240,
      "end_ms": 49779,
      "text": "这些内容绝对不去卖它"
    },
    {
      "ordinal": 14,
      "start_ms": 50780,
      "end_ms": 54610,
      "text": "不搞任何的知识付费啊"
    },
    {
      "ordinal": 15,
      "start_ms": 54610,
      "end_ms": 57500,
      "text": "就我本人我向来承诺的"
    },
    {
      "ordinal": 16,
      "start_ms": 57980,
      "end_ms": 60720,
      "text": "在互联网上产出的内容"
    },
    {
      "ordinal": 17,
      "start_ms": 61160,
      "end_ms": 66680,
      "text": "绝对不搞什么三六九等的知识付费啊"
    },
    {
      "ordinal": 18,
      "start_ms": 66680,
      "end_ms": 70400,
      "text": "就是在公开平台上都是你谁都可以看"
    },
    {
      "ordinal": 19,
      "start_ms": 70400,
      "end_ms": 71180,
      "text": "谁都免费看"
    },
    {
      "ordinal": 20,
      "start_ms": 71180,
      "end_ms": 73400,
      "text": "绝对不搞知识付费啊"
    },
    {
      "ordinal": 21,
      "start_ms": 73400,
      "end_ms": 75080,
      "text": "我从来不搞什么会员制"
    },
    {
      "ordinal": 22,
      "start_ms": 75080,
      "end_ms": 77800,
      "text": "什么独享内容啊"
    },
    {
      "ordinal": 23,
      "start_ms": 77800,
      "end_ms": 80620,
      "text": "我也不给什么什么谁开什么狗屁书单啊"
    },
    {
      "ordinal": 24,
      "start_ms": 80620,
      "end_ms": 81610,
      "text": "什么搞什么"
    },
    {
      "ordinal": 25,
      "start_ms": 81610,
      "end_ms": 83560,
      "text": "我也不搞什么研讨班"
    },
    {
      "ordinal": 26,
      "start_ms": 83560,
      "end_ms": 85549,
      "text": "什么私人研讨班啊"
    },
    {
      "ordinal": 27,
      "start_ms": 85549,
      "end_ms": 86419,
      "text": "什么啊"
    },
    {
      "ordinal": 28,
      "start_ms": 86419,
      "end_ms": 89060,
      "text": "线下讲座收钱这种东西从来不搞"
    },
    {
      "ordinal": 29,
      "start_ms": 91020,
      "end_ms": 93680,
      "text": "那么公益小组啊"
    },
    {
      "ordinal": 30,
      "start_ms": 93680,
      "end_ms": 96320,
      "text": "和这个形式比较类似的就是学生啊"
    },
    {
      "ordinal": 31,
      "start_ms": 96320,
      "end_ms": 98820,
      "text": "或者说一些知识分子"
    },
    {
      "ordinal": 32,
      "start_ms": 99020,
      "end_ms": 101100,
      "text": "你要做家教啊"
    },
    {
      "ordinal": 33,
      "start_ms": 101100,
      "end_ms": 102420,
      "text": "那我说了啊"
    },
    {
      "ordinal": 34,
      "start_ms": 102420,
      "end_ms": 106140,
      "text": "这个和知识付费啊好像很贴近啊"
    },
    {
      "ordinal": 35,
      "start_ms": 106140,
      "end_ms": 110500,
      "text": "但是他不是一个可复制的一个呃"
    },
    {
      "ordinal": 36,
      "start_ms": 110500,
      "end_ms": 115010,
      "text": "互联网上的一个呃资讯内容啊"
    },
    {
      "ordinal": 37,
      "start_ms": 115010,
      "end_ms": 118969,
      "text": "视讯内容或者音频内容它的一个售卖"
    },
    {
      "ordinal": 38,
      "start_ms": 118969,
      "end_ms": 120680,
      "text": "而是家教"
    },
    {
      "ordinal": 39,
      "start_ms": 120680,
      "end_ms": 121820,
      "text": "都是线下一对一的"
    },
    {
      "ordinal": 40,
      "start_ms": 121820,
      "end_ms": 122900,
      "text": "对不对啊"
    },
    {
      "ordinal": 41,
      "start_ms": 122900,
      "end_ms": 126080,
      "text": "都是一个体力劳动和脑力劳动同时在里面的"
    },
    {
      "ordinal": 42,
      "start_ms": 126080,
      "end_ms": 130068,
      "text": "而且是一个啊可以说是贴身的啊"
    },
    {
      "ordinal": 43,
      "start_ms": 130068,
      "end_ms": 132349,
      "text": "就是一对一的一个服务业"
    },
    {
      "ordinal": 44,
      "start_ms": 132349,
      "end_ms": 136349,
      "text": "所以在这个意义上讲是可以赚钱的"
    },
    {
      "ordinal": 45,
      "start_ms": 136349,
      "end_ms": 138240,
      "text": "但是有一个原则"
    },
    {
      "ordinal": 46,
      "start_ms": 141750,
      "end_ms": 143070,
      "text": "打着公益的喜好"
    },
    {
      "ordinal": 47,
      "start_ms": 143070,
      "end_ms": 144200,
      "text": "这不能收钱"
    },
    {
      "ordinal": 48,
      "start_ms": 144579,
      "end_ms": 145920,
      "text": "不能收钱"
    },
    {
      "ordinal": 49,
      "start_ms": 146719,
      "end_ms": 148479,
      "text": "明白吗啊"
    },
    {
      "ordinal": 50,
      "start_ms": 148479,
      "end_ms": 151899,
      "text": "他爸爸妈妈如果是做产产线工人啊"
    },
    {
      "ordinal": 51,
      "start_ms": 151899,
      "end_ms": 154080,
      "text": "做这个服务业工人啊"
    },
    {
      "ordinal": 52,
      "start_ms": 155040,
      "end_ms": 156740,
      "text": "他不劳动不得食"
    },
    {
      "ordinal": 53,
      "start_ms": 157000,
      "end_ms": 159880,
      "text": "不劳动就要饿死不得食"
    },
    {
      "ordinal": 54,
      "start_ms": 161140,
      "end_ms": 162020,
      "text": "然后呢"
    },
    {
      "ordinal": 55,
      "start_ms": 162939,
      "end_ms": 166199,
      "text": "他的这个劳动份额"
    },
    {
      "ordinal": 56,
      "start_ms": 166199,
      "end_ms": 170819,
      "text": "很大程度上是被小代理资产阶级给剥夺走的啊"
    },
    {
      "ordinal": 57,
      "start_ms": 170819,
      "end_ms": 173499,
      "text": "是受压迫受剥削的啊"
    },
    {
      "ordinal": 58,
      "start_ms": 173499,
      "end_ms": 175059,
      "text": "这样的啊"
    },
    {
      "ordinal": 59,
      "start_ms": 180459,
      "end_ms": 181900,
      "text": "廉价的"
    },
    {
      "ordinal": 60,
      "start_ms": 186380,
      "end_ms": 189019,
      "text": "只要他们的爸爸是这样的人啊"
    },
    {
      "ordinal": 61,
      "start_ms": 197820,
      "end_ms": 204550,
      "text": "那么他们的子女原则上是要免费辅导的"
    },
    {
      "ordinal": 62,
      "start_ms": 204550,
      "end_ms": 206620,
      "text": "就是公益活动可以有一种方式"
    },
    {
      "ordinal": 63,
      "start_ms": 206620,
      "end_ms": 210910,
      "text": "就是免对他们进行免费辅导啊"
    },
    {
      "ordinal": 64,
      "start_ms": 210910,
      "end_ms": 214220,
      "text": "甚至说人家爸妈打工打得晚"
    },
    {
      "ordinal": 65,
      "start_ms": 214420,
      "end_ms": 215470,
      "text": "回来玩"
    },
    {
      "ordinal": 66,
      "start_ms": 215470,
      "end_ms": 217030,
      "text": "小朋友没饭吃"
    },
    {
      "ordinal": 67,
      "start_ms": 217030,
      "end_ms": 220940,
      "text": "公益小组还要负责为这个小朋友准备晚饭"
    },
    {
      "ordinal": 68,
      "start_ms": 221060,
      "end_ms": 223779,
      "text": "但一定要注意食品安全啊"
    },
    {
      "ordinal": 69,
      "start_ms": 223779,
      "end_ms": 224679,
      "text": "一定要注意食品安全"
    },
    {
      "ordinal": 70,
      "start_ms": 224679,
      "end_ms": 226659,
      "text": "你可以其他几个人先吃两个小时"
    },
    {
      "ordinal": 71,
      "start_ms": 226659,
      "end_ms": 228480,
      "text": "肚子没闹肚子啊"
    },
    {
      "ordinal": 72,
      "start_ms": 228480,
      "end_ms": 229800,
      "text": "然后再再带过去送"
    },
    {
      "ordinal": 73,
      "start_ms": 229800,
      "end_ms": 234000,
      "text": "就是送到他那个家教的那个那个那个地方去"
    },
    {
      "ordinal": 74,
      "start_ms": 234239,
      "end_ms": 235390,
      "text": "明白吗"
    },
    {
      "ordinal": 75,
      "start_ms": 235390,
      "end_ms": 238030,
      "text": "但是赚钱呢是可以赚的"
    },
    {
      "ordinal": 76,
      "start_ms": 238030,
      "end_ms": 239830,
      "text": "学生你说我这样搞"
    },
    {
      "ordinal": 77,
      "start_ms": 239830,
      "end_ms": 242410,
      "text": "就不允许学生用专家教来赚钱了"
    },
    {
      "ordinal": 78,
      "start_ms": 242410,
      "end_ms": 244820,
      "text": "那你赚钱就不要打着公益的形式"
    },
    {
      "ordinal": 79,
      "start_ms": 244920,
      "end_ms": 248100,
      "text": "但而且赚钱的家教啊"
    },
    {
      "ordinal": 80,
      "start_ms": 248100,
      "end_ms": 251710,
      "text": "赚钱的家教一般是面向小在人类家庭"
    },
    {
      "ordinal": 81,
      "start_ms": 251710,
      "end_ms": 252490,
      "text": "小妇人"
    },
    {
      "ordinal": 82,
      "start_ms": 252490,
      "end_ms": 253480,
      "text": "小游产者"
    },
    {
      "ordinal": 83,
      "start_ms": 253480,
      "end_ms": 256120,
      "text": "有产者家庭或者自身家庭的"
    },
    {
      "ordinal": 84,
      "start_ms": 256120,
      "end_ms": 257560,
      "text": "那就按照市场价"
    },
    {
      "ordinal": 85,
      "start_ms": 257959,
      "end_ms": 259189,
      "text": "那如果他在"
    },
    {
      "ordinal": 86,
      "start_ms": 259189,
      "end_ms": 262369,
      "text": "他是那种不劳而获的资产阶级家庭啊"
    },
    {
      "ordinal": 87,
      "start_ms": 262369,
      "end_ms": 266140,
      "text": "通过股权或者通过某种优势地位不劳而获的"
    },
    {
      "ordinal": 88,
      "start_ms": 266240,
      "end_ms": 269270,
      "text": "你甚至可以说可以啊"
    },
    {
      "ordinal": 89,
      "start_ms": 269270,
      "end_ms": 270720,
      "text": "要多赚一点"
    },
    {
      "ordinal": 90,
      "start_ms": 270720,
      "end_ms": 273570,
      "text": "要寻得高价赚到这些钱呢"
    },
    {
      "ordinal": 91,
      "start_ms": 273570,
      "end_ms": 279620,
      "text": "这工艺啊是你这个公益团体的大家这个啊啊啊"
    },
    {
      "ordinal": 92,
      "start_ms": 279620,
      "end_ms": 280220,
      "text": "你这个学生"
    },
    {
      "ordinal": 93,
      "start_ms": 280220,
      "end_ms": 281600,
      "text": "如果说你做家教赚的多"
    },
    {
      "ordinal": 94,
      "start_ms": 281600,
      "end_ms": 282500,
      "text": "某种意义上讲"
    },
    {
      "ordinal": 95,
      "start_ms": 282500,
      "end_ms": 285940,
      "text": "我们之前还说学生出一半钱的一个呃"
    },
    {
      "ordinal": 96,
      "start_ms": 285940,
      "end_ms": 286600,
      "text": "上班了"
    },
    {
      "ordinal": 97,
      "start_ms": 286600,
      "end_ms": 288820,
      "text": "打工的出一份钱"
    },
    {
      "ordinal": 98,
      "start_ms": 289520,
      "end_ms": 290860,
      "text": "打工人出一分钱"
    },
    {
      "ordinal": 99,
      "start_ms": 290860,
      "end_ms": 291280,
      "text": "打工的"
    },
    {
      "ordinal": 100,
      "start_ms": 291280,
      "end_ms": 292720,
      "text": "我一直说打工也是个一形态"
    },
    {
      "ordinal": 101,
      "start_ms": 292720,
      "end_ms": 293860,
      "text": "我一直他妈的"
    },
    {
      "ordinal": 102,
      "start_ms": 293860,
      "end_ms": 296040,
      "text": "当然现在说顺嘴了"
    },
    {
      "ordinal": 103,
      "start_ms": 296200,
      "end_ms": 298720,
      "text": "那我要说的就是说你甚至你赚的多"
    },
    {
      "ordinal": 104,
      "start_ms": 298720,
      "end_ms": 300250,
      "text": "你也可以出一分钱"
    },
    {
      "ordinal": 105,
      "start_ms": 300250,
      "end_ms": 303740,
      "text": "大家就把你当成是一个成熟的社会人来对待"
    },
    {
      "ordinal": 106,
      "start_ms": 304200,
      "end_ms": 305880,
      "text": "但是你们决策权是不变的"
    },
    {
      "ordinal": 107,
      "start_ms": 305880,
      "end_ms": 307140,
      "text": "还是还是一票啊"
    },
    {
      "ordinal": 108,
      "start_ms": 307140,
      "end_ms": 309860,
      "text": "那么我们讲的就是说啊"
    },
    {
      "ordinal": 109,
      "start_ms": 309860,
      "end_ms": 311180,
      "text": "做家教可以赚"
    },
    {
      "ordinal": 110,
      "start_ms": 311180,
      "end_ms": 312110,
      "text": "可以赚钱"
    },
    {
      "ordinal": 111,
      "start_ms": 312110,
      "end_ms": 313160,
      "text": "不担心的"
    },
    {
      "ordinal": 112,
      "start_ms": 313160,
      "end_ms": 314450,
      "text": "但是你做公益的时候"
    },
    {
      "ordinal": 113,
      "start_ms": 314450,
      "end_ms": 315950,
      "text": "做家教辅导一分钱不能收"
    },
    {
      "ordinal": 114,
      "start_ms": 315950,
      "end_ms": 320259,
      "text": "甚至你还去啊给人家小朋友带带份饭好"
    },
    {
      "ordinal": 115,
      "start_ms": 320259,
      "end_ms": 321879,
      "text": "那么关系出了好了"
    },
    {
      "ordinal": 116,
      "start_ms": 321879,
      "end_ms": 324440,
      "text": "人家爸爸在家里要请你吃顿饭"
    },
    {
      "ordinal": 117,
      "start_ms": 324440,
      "end_ms": 327020,
      "text": "你这个也可以欣然接受"
    },
    {
      "ordinal": 118,
      "start_ms": 327020,
      "end_ms": 328060,
      "text": "没事的"
    },
    {
      "ordinal": 119,
      "start_ms": 328659,
      "end_ms": 331400,
      "text": "明白吗啊real standard"
    },
    {
      "ordinal": 120,
      "start_ms": 331400,
      "end_ms": 333710,
      "text": "这个就是一个知识付费的"
    },
    {
      "ordinal": 121,
      "start_ms": 333710,
      "end_ms": 336950,
      "text": "和这个做家教的这两件事的一个立场啊"
    },
    {
      "ordinal": 122,
      "start_ms": 336950,
      "end_ms": 338150,
      "text": "一个一个立场"
    },
    {
      "ordinal": 123,
      "start_ms": 338150,
      "end_ms": 341750,
      "text": "那么我们现在就是说我不失望啊"
    },
    {
      "ordinal": 124,
      "start_ms": 341750,
      "end_ms": 342890,
      "text": "有一件事情发生了"
    },
    {
      "ordinal": 125,
      "start_ms": 342890,
      "end_ms": 344750,
      "text": "我对这个事情并不吃惊"
    },
    {
      "ordinal": 126,
      "start_ms": 344750,
      "end_ms": 345909,
      "text": "也不感到失望"
    },
    {
      "ordinal": 127,
      "start_ms": 345909,
      "end_ms": 349629,
      "text": "就是说有之前被我批评了某个团体啊"
    },
    {
      "ordinal": 128,
      "start_ms": 349629,
      "end_ms": 352360,
      "text": "一个匿名的小角色"
    },
    {
      "ordinal": 129,
      "start_ms": 354120,
      "end_ms": 356000,
      "text": "啊搞这个知识付费啊"
    },
    {
      "ordinal": 130,
      "start_ms": 356000,
      "end_ms": 361500,
      "text": "很明显我从来不认为这个啊他的老板"
    },
    {
      "ordinal": 131,
      "start_ms": 361560,
      "end_ms": 366240,
      "text": "他在这个上面的头头都知道他姓甚名谁啊"
    },
    {
      "ordinal": 132,
      "start_ms": 366240,
      "end_ms": 367920,
      "text": "搞什么研究的啊"
    },
    {
      "ordinal": 133,
      "start_ms": 367920,
      "end_ms": 369240,
      "text": "家里住哪里的"
    },
    {
      "ordinal": 134,
      "start_ms": 369479,
      "end_ms": 374309,
      "text": "他绝对不是一个呃所谓的地下的隐秘的活动家"
    },
    {
      "ordinal": 135,
      "start_ms": 374309,
      "end_ms": 376079,
      "text": "他弄这些钱是为了什么"
    },
    {
      "ordinal": 136,
      "start_ms": 376079,
      "end_ms": 377879,
      "text": "无非就是他个人消费吧"
    },
    {
      "ordinal": 137,
      "start_ms": 377879,
      "end_ms": 379380,
      "text": "或者说瓦雷啊"
    },
    {
      "ordinal": 138,
      "start_ms": 379380,
      "end_ms": 381780,
      "text": "当然它也是合法经营啊"
    },
    {
      "ordinal": 139,
      "start_ms": 381780,
      "end_ms": 383720,
      "text": "合法的一个一个一个一"
    },
    {
      "ordinal": 140,
      "start_ms": 383720,
      "end_ms": 386360,
      "text": "所以说在这个上下这个个体呢"
    },
    {
      "ordinal": 141,
      "start_ms": 386360,
      "end_ms": 387020,
      "text": "在我们眼里"
    },
    {
      "ordinal": 142,
      "start_ms": 387020,
      "end_ms": 391600,
      "text": "它只是一个小段阶级的一个文化产品的生产者"
    },
    {
      "ordinal": 143,
      "start_ms": 391740,
      "end_ms": 392940,
      "text": "仅此而已"
    },
    {
      "ordinal": 144,
      "start_ms": 392940,
      "end_ms": 394860,
      "text": "我没有降低它的负面评啊"
    },
    {
      "ordinal": 145,
      "start_ms": 394860,
      "end_ms": 396299,
      "text": "没有降低他的社会评价"
    },
    {
      "ordinal": 146,
      "start_ms": 396299,
      "end_ms": 397289,
      "text": "仅此而已"
    },
    {
      "ordinal": 147,
      "start_ms": 397289,
      "end_ms": 398459,
      "text": "不要把他幻想成他"
    },
    {
      "ordinal": 148,
      "start_ms": 398459,
      "end_ms": 402419,
      "text": "好像说啊他弄的这些钱要要去什么啊"
    },
    {
      "ordinal": 149,
      "start_ms": 402419,
      "end_ms": 403139,
      "text": "资助革命"
    },
    {
      "ordinal": 150,
      "start_ms": 403139,
      "end_ms": 404780,
      "text": "怎么可能他没有"
    },
    {
      "ordinal": 151,
      "start_ms": 405800,
      "end_ms": 407500,
      "text": "就是个小小文人"
    },
    {
      "ordinal": 152,
      "start_ms": 407500,
      "end_ms": 409150,
      "text": "或者说是个知识分子"
    },
    {
      "ordinal": 153,
      "start_ms": 409150,
      "end_ms": 413220,
      "text": "小知识分子啊啊这个就在眼皮子底下"
    },
    {
      "ordinal": 154,
      "start_ms": 413280,
      "end_ms": 415020,
      "text": "一点独立性都没有的"
    },
    {
      "ordinal": 155,
      "start_ms": 415020,
      "end_ms": 417540,
      "text": "一点活动的空间都没有的啊"
    },
    {
      "ordinal": 156,
      "start_ms": 417540,
      "end_ms": 420320,
      "text": "这么一个小年轻啊啊"
    },
    {
      "ordinal": 157,
      "start_ms": 420320,
      "end_ms": 423920,
      "text": "他周围还有几个什么什么什么静静啊"
    },
    {
      "ordinal": 158,
      "start_ms": 423920,
      "end_ms": 425300,
      "text": "还有他的几个几个同学"
    },
    {
      "ordinal": 159,
      "start_ms": 425300,
      "end_ms": 425900,
      "text": "几个朋友"
    },
    {
      "ordinal": 160,
      "start_ms": 425900,
      "end_ms": 428709,
      "text": "这种玩意也就这样明白吗"
    },
    {
      "ordinal": 161,
      "start_ms": 428709,
      "end_ms": 434220,
      "text": "哎我们原则上对于这样的一个呃"
    },
    {
      "ordinal": 162,
      "start_ms": 434220,
      "end_ms": 438620,
      "text": "资本主义景观体系当中去生产这类文化产品的"
    },
    {
      "ordinal": 163,
      "start_ms": 438620,
      "end_ms": 440660,
      "text": "我们不反对啊"
    },
    {
      "ordinal": 164,
      "start_ms": 440660,
      "end_ms": 442790,
      "text": "我们也不想评价他"
    },
    {
      "ordinal": 165,
      "start_ms": 442790,
      "end_ms": 443870,
      "text": "他就那样呗"
    },
    {
      "ordinal": 166,
      "start_ms": 443870,
      "end_ms": 444970,
      "text": "还能怎样"
    },
    {
      "ordinal": 167,
      "start_ms": 444970,
      "end_ms": 449400,
      "text": "但是说对于我们对于我们啊践行公益道路的"
    },
    {
      "ordinal": 168,
      "start_ms": 449400,
      "end_ms": 451590,
      "text": "包括我们说我倡议"
    },
    {
      "ordinal": 169,
      "start_ms": 456889,
      "end_ms": 459049,
      "text": "劳动者的切身长远利益"
    },
    {
      "ordinal": 170,
      "start_ms": 460969,
      "end_ms": 464340,
      "text": "国际主义理想的行动者啊"
    },
    {
      "ordinal": 171,
      "start_ms": 464340,
      "end_ms": 468810,
      "text": "就坚决摒弃啊知识付费这种形式"
    },
    {
      "ordinal": 172,
      "start_ms": 468810,
      "end_ms": 471600,
      "text": "坚决不搞知识付费啊"
    },
    {
      "ordinal": 173,
      "start_ms": 474990,
      "end_ms": 476700,
      "text": "用这个辩证唯物主义"
    },
    {
      "ordinal": 174,
      "start_ms": 476700,
      "end_ms": 479300,
      "text": "历史唯物主义分析出来的一些啊"
    },
    {
      "ordinal": 175,
      "start_ms": 479300,
      "end_ms": 482600,
      "text": "对于社会运行的机制规律的总结啊"
    },
    {
      "ordinal": 176,
      "start_ms": 482600,
      "end_ms": 485820,
      "text": "对于这个进一步发展变化的"
    },
    {
      "ordinal": 177,
      "start_ms": 485820,
      "end_ms": 487380,
      "text": "一个趋势的一个预测啊"
    },
    {
      "ordinal": 178,
      "start_ms": 487380,
      "end_ms": 489720,
      "text": "所有这些东西绝对不付钱啊"
    },
    {
      "ordinal": 179,
      "start_ms": 489720,
      "end_ms": 491360,
      "text": "不绝对不不用来卖"
    },
    {
      "ordinal": 180,
      "start_ms": 492120,
      "end_ms": 493880,
      "text": "因为这些知识生产出来"
    },
    {
      "ordinal": 181,
      "start_ms": 493880,
      "end_ms": 496530,
      "text": "这些知识本来就要惠及劳动群众的"
    },
    {
      "ordinal": 182,
      "start_ms": 496530,
      "end_ms": 498570,
      "text": "当时群众已经就是说很难"
    },
    {
      "ordinal": 183,
      "start_ms": 498570,
      "end_ms": 500550,
      "text": "就是说已经在这些知识上面"
    },
    {
      "ordinal": 184,
      "start_ms": 500550,
      "end_ms": 503490,
      "text": "在这些专业内容上面已经隔了一层了"
    },
    {
      "ordinal": 185,
      "start_ms": 503490,
      "end_ms": 504620,
      "text": "你还要卖钱"
    },
    {
      "ordinal": 186,
      "start_ms": 504840,
      "end_ms": 507640,
      "text": "越隔越远了啊"
    },
    {
      "ordinal": 187,
      "start_ms": 507680,
      "end_ms": 510780,
      "text": "所以说我们始终要践行的一个就是说"
    },
    {
      "ordinal": 188,
      "start_ms": 510780,
      "end_ms": 511800,
      "text": "哪怕现实当中"
    },
    {
      "ordinal": 189,
      "start_ms": 519130,
      "end_ms": 522659,
      "text": "没办法直接就是呃实现"
    },
    {
      "ordinal": 190,
      "start_ms": 522659,
      "end_ms": 525540,
      "text": "但是在知识传播上啊"
    },
    {
      "ordinal": 191,
      "start_ms": 525540,
      "end_ms": 529380,
      "text": "在这个文化传播啊"
    },
    {
      "ordinal": 192,
      "start_ms": 529380,
      "end_ms": 531280,
      "text": "思想探索方面"
    },
    {
      "ordinal": 193,
      "start_ms": 536950,
      "end_ms": 538300,
      "text": "这是个原则和底线"
    },
    {
      "ordinal": 194,
      "start_ms": 538300,
      "end_ms": 540420,
      "text": "也是一块试金石"
    },
    {
      "ordinal": 195,
      "start_ms": 541000,
      "end_ms": 542880,
      "text": "这个不是用来试左不左的"
    },
    {
      "ordinal": 196,
      "start_ms": 542880,
      "end_ms": 546270,
      "text": "只是用来试你到底是不是一个限时的活动价的"
    },
    {
      "ordinal": 197,
      "start_ms": 546270,
      "end_ms": 547500,
      "text": "那么对于这个佐伊二三"
    },
    {
      "ordinal": 198,
      "start_ms": 547500,
      "end_ms": 551450,
      "text": "我很明确的告诉你们所有人他不是好吧"
    },
    {
      "ordinal": 199,
      "start_ms": 551450,
      "end_ms": 553819,
      "text": "他就是个他就是个小学者"
    },
    {
      "ordinal": 200,
      "start_ms": 554960,
      "end_ms": 559600,
      "text": "那么另外一方面我们要讲的就是说他不是我"
    },
    {
      "ordinal": 201,
      "start_ms": 559600,
      "end_ms": 560320,
      "text": "我都跟他说了"
    },
    {
      "ordinal": 202,
      "start_ms": 560320,
      "end_ms": 561880,
      "text": "他不适合他喘一口气"
    },
    {
      "ordinal": 203,
      "start_ms": 562320,
      "end_ms": 563250,
      "text": "他不用"
    },
    {
      "ordinal": 204,
      "start_ms": 563250,
      "end_ms": 564240,
      "text": "他不用被人找了"
    },
    {
      "ordinal": 205,
      "start_ms": 564240,
      "end_ms": 564780,
      "text": "不用找了"
    },
    {
      "ordinal": 206,
      "start_ms": 564780,
      "end_ms": 565860,
      "text": "被被被人找到"
    },
    {
      "ordinal": 207,
      "start_ms": 565860,
      "end_ms": 567480,
      "text": "要写保证书什么的东西"
    },
    {
      "ordinal": 208,
      "start_ms": 567480,
      "end_ms": 569579,
      "text": "那另外一方面我要说的就是说"
    },
    {
      "ordinal": 209,
      "start_ms": 570600,
      "end_ms": 573920,
      "text": "也就是说那当年这个列宁他们还呃"
    },
    {
      "ordinal": 210,
      "start_ms": 573920,
      "end_ms": 577880,
      "text": "这个找那个地下报纸或者说那个小册子啊"
    },
    {
      "ordinal": 211,
      "start_ms": 577880,
      "end_ms": 581170,
      "text": "然后那个工人认捐呢啊买买了就给钱的啊"
    },
    {
      "ordinal": 212,
      "start_ms": 581170,
      "end_ms": 582790,
      "text": "那是头筹款形式啊"
    },
    {
      "ordinal": 213,
      "start_ms": 582790,
      "end_ms": 585910,
      "text": "就是当年这个呃比较激进的"
    },
    {
      "ordinal": 214,
      "start_ms": 585910,
      "end_ms": 589220,
      "text": "在当时的特定历史条件之下啊"
    },
    {
      "ordinal": 215,
      "start_ms": 589220,
      "end_ms": 592130,
      "text": "革命还要通过一种激进的地下暴"
    },
    {
      "ordinal": 216,
      "start_ms": 592130,
      "end_ms": 593540,
      "text": "暴力的这么一种形式"
    },
    {
      "ordinal": 217,
      "start_ms": 593540,
      "end_ms": 597199,
      "text": "它需要筹钱大量的资金来进行啊"
    },
    {
      "ordinal": 218,
      "start_ms": 597340,
      "end_ms": 601720,
      "text": "那么可以台面上相对公开的呃"
    },
    {
      "ordinal": 219,
      "start_ms": 601720,
      "end_ms": 607330,
      "text": "那个时代就是通过啊这个一个编辑部啊"
    },
    {
      "ordinal": 220,
      "start_ms": 607330,
      "end_ms": 609040,
      "text": "啊通过他的火星报啊"
    },
    {
      "ordinal": 221,
      "start_ms": 609040,
      "end_ms": 609880,
      "text": "明白吗"
    },
    {
      "ordinal": 222,
      "start_ms": 609880,
      "end_ms": 615040,
      "text": "通过他的这个在各个这个呃明白啊啊"
    },
    {
      "ordinal": 223,
      "start_ms": 615040,
      "end_ms": 618850,
      "text": "各个这个工人社区当中啊"
    },
    {
      "ordinal": 224,
      "start_ms": 618850,
      "end_ms": 621580,
      "text": "来去贩卖他的这个出版部啊"
    },
    {
      "ordinal": 225,
      "start_ms": 621580,
      "end_ms": 623590,
      "text": "当然是他地下出版部啊"
    },
    {
      "ordinal": 226,
      "start_ms": 623590,
      "end_ms": 626460,
      "text": "来筹集一个革命致敬革命经费的"
    },
    {
      "ordinal": 227,
      "start_ms": 626460,
      "end_ms": 629040,
      "text": "那就说这个佐123和他的团体和他的朋友"
    },
    {
      "ordinal": 228,
      "start_ms": 629040,
      "end_ms": 631779,
      "text": "有这个有这个有这个组织规模吧"
    },
    {
      "ordinal": 229,
      "start_ms": 631779,
      "end_ms": 633129,
      "text": "有这个行动路线吧"
    },
    {
      "ordinal": 230,
      "start_ms": 633129,
      "end_ms": 633969,
      "text": "没有啊"
    },
    {
      "ordinal": 231,
      "start_ms": 633969,
      "end_ms": 635170,
      "text": "我替他说了没有"
    },
    {
      "ordinal": 232,
      "start_ms": 635170,
      "end_ms": 635890,
      "text": "如果有的话"
    },
    {
      "ordinal": 233,
      "start_ms": 635890,
      "end_ms": 636730,
      "text": "他就抓起来"
    },
    {
      "ordinal": 234,
      "start_ms": 636730,
      "end_ms": 637630,
      "text": "然后说我替他说"
    },
    {
      "ordinal": 235,
      "start_ms": 637630,
      "end_ms": 639070,
      "text": "他没有吧"
    },
    {
      "ordinal": 236,
      "start_ms": 639070,
      "end_ms": 641950,
      "text": "所以你不要不要说说当年列宁为什么啊"
    },
    {
      "ordinal": 237,
      "start_ms": 641950,
      "end_ms": 643030,
      "text": "应报纸赚钱"
    },
    {
      "ordinal": 238,
      "start_ms": 643030,
      "end_ms": 644849,
      "text": "马克思应报纸赚钱啊"
    },
    {
      "ordinal": 239,
      "start_ms": 644849,
      "end_ms": 647069,
      "text": "你现在这个左翼要搞个什么啊"
    },
    {
      "ordinal": 240,
      "start_ms": 647069,
      "end_ms": 648149,
      "text": "知识星球付费"
    },
    {
      "ordinal": 241,
      "start_ms": 648149,
      "end_ms": 649920,
      "text": "我我就要说三道四"
    },
    {
      "ordinal": 242,
      "start_ms": 649980,
      "end_ms": 651000,
      "text": "他没有啊"
    },
    {
      "ordinal": 243,
      "start_ms": 651000,
      "end_ms": 651900,
      "text": "他不干这个事儿呀"
    },
    {
      "ordinal": 244,
      "start_ms": 651900,
      "end_ms": 652950,
      "text": "他们有本事啊"
    },
    {
      "ordinal": 245,
      "start_ms": 652950,
      "end_ms": 654720,
      "text": "啊他就是个文人"
    },
    {
      "ordinal": 246,
      "start_ms": 654720,
      "end_ms": 655740,
      "text": "造反10年不成的"
    },
    {
      "ordinal": 247,
      "start_ms": 655740,
      "end_ms": 656730,
      "text": "他没这个本事的"
    },
    {
      "ordinal": 248,
      "start_ms": 656730,
      "end_ms": 657870,
      "text": "好吧啊"
    },
    {
      "ordinal": 249,
      "start_ms": 657870,
      "end_ms": 659190,
      "text": "你们也不要做这个梦了"
    },
    {
      "ordinal": 250,
      "start_ms": 659190,
      "end_ms": 660180,
      "text": "好不啊"
    },
    {
      "ordinal": 251,
      "start_ms": 660180,
      "end_ms": 663300,
      "text": "那就是相当于就是说某个什么成功学家"
    },
    {
      "ordinal": 252,
      "start_ms": 663300,
      "end_ms": 665210,
      "text": "某个什么什么股票大师"
    },
    {
      "ordinal": 253,
      "start_ms": 665210,
      "end_ms": 667130,
      "text": "某个什么情感情感"
    },
    {
      "ordinal": 254,
      "start_ms": 667130,
      "end_ms": 668750,
      "text": "什么小天使类似的"
    },
    {
      "ordinal": 255,
      "start_ms": 668750,
      "end_ms": 670070,
      "text": "搞个什么知识星球"
    },
    {
      "ordinal": 256,
      "start_ms": 670070,
      "end_ms": 670730,
      "text": "他也搞一个"
    },
    {
      "ordinal": 257,
      "start_ms": 670730,
      "end_ms": 671620,
      "text": "仅此而已"
    },
    {
      "ordinal": 258,
      "start_ms": 671620,
      "end_ms": 673240,
      "text": "不要把这个人神圣化"
    },
    {
      "ordinal": 259,
      "start_ms": 673240,
      "end_ms": 675190,
      "text": "哎我从来没有把这个人神圣化了"
    },
    {
      "ordinal": 260,
      "start_ms": 675190,
      "end_ms": 677660,
      "text": "他也没有什么现实力量了好吧"
    },
    {
      "ordinal": 261,
      "start_ms": 677660,
      "end_ms": 678920,
      "text": "他有啥现实"
    },
    {
      "ordinal": 262,
      "start_ms": 678920,
      "end_ms": 680480,
      "text": "他如果有有现实力量"
    },
    {
      "ordinal": 263,
      "start_ms": 680480,
      "end_ms": 682700,
      "text": "我早就在圈子里面混不下去了啊"
    },
    {
      "ordinal": 264,
      "start_ms": 682700,
