{
  "bvid": "BV1p64y1t7vM",
  "page": 8,
  "source": "asr-local",
  "language": "Chinese",
  "model": {
    "model_name": "source://production/models/Qwen3-ASR-1.7B-hf",
    "revision": "bcd2b5b7f32b480ab5790554cfa8347f246a14f3"
  },
  "content_sha256": "dea5de7dddc50d9adb3b733b92efcb022e1ad0a14fa707454ea3468fa7a282b8",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 80,
      "end_ms": 9600,
      "text": "行，感觉，我看你这种不爽。我有力气。"
    },
    {
      "ordinal": 1,
      "start_ms": 14800,
      "end_ms": 19440,
      "text": "我在开车的时候都能唱上去，但是为什么坐到这里我就唱不上去了？"
    },
    {
      "ordinal": 2,
      "start_ms": 19520,
      "end_ms": 21120,
      "text": "因为我不够痞，你知道吗？"
    },
    {
      "ordinal": 3,
      "start_ms": 22240,
      "end_ms": 28640,
      "text": "太，太庄重了。不放松呀。"
    },
    {
      "ordinal": 4,
      "start_ms": 31840,
      "end_ms": 38240,
      "text": "不要问，不要说，一切尽在不言中。"
    },
    {
      "ordinal": 5,
      "start_ms": 38640,
      "end_ms": 44880,
      "text": "这一刻，围着烛光，让我们静静的度过。"
    },
    {
      "ordinal": 6,
      "start_ms": 45280,
      "end_ms": 57280,
      "text": "莫挥手，莫回头，当我唱起这首歌，怕只怕泪水轻轻的滑落。"
    },
    {
      "ordinal": 7,
      "start_ms": 58400,
      "end_ms": 70560,
      "text": "愿心中永远留着我的笑容，伴你走过每一个春夏秋冬。"
    },
    {
      "ordinal": 8,
      "start_ms": 71760,
      "end_ms": 78000,
      "text": "几许愁，几许忧，人生难免苦与痛。"
    },
    {
      "ordinal": 9,
      "start_ms": 78240,
      "end_ms": 84480,
      "text": "失去过，才能真正懂得去珍惜和拥有。"
    },
    {
      "ordinal": 10,
      "start_ms": 84800,
      "end_ms": 91040,
      "text": "情难舍，人难留，今朝一别各西东。"
    },
    {
      "ordinal": 11,
      "start_ms": 91440,
      "end_ms": 96720,
      "text": "冷和热，点点滴滴在心头。"
    },
    {
      "ordinal": 12,
      "start_ms": 98160,
      "end_ms": 102800,
      "text": "愿心中永远留着我的笑容，"
    },
    {
      "ordinal": 13,
      "start_ms": 104720,
      "end_ms": 111064,
      "text": "伴你走过每一个春夏秋冬。"
    },
    {
      "ordinal": 14,
      "start_ms": 111452,
      "end_ms": 119040,
      "text": "伤离别，离别虽然在眼前，说再见，"
    },
    {
      "ordinal": 15,
      "start_ms": 121200,
      "end_ms": 124000,
      "text": "再见不会太遥远。"
    },
    {
      "ordinal": 16,
      "start_ms": 124640,
      "end_ms": 135760,
      "text": "若有缘，有缘就能期待明天，你和我重逢在灿烂的季节。"
    },
    {
      "ordinal": 17,
      "start_ms": 138480,
      "end_ms": 143280,
      "text": "感觉有点流氓感觉。"
    },
    {
      "ordinal": 18,
      "start_ms": 171200,
      "end_ms": 214240,
      "text": "伤离别，离别虽然在眼前，说再见。"
    },
    {
      "ordinal": 19,
      "start_ms": 181145,
      "end_ms": 195625,
      "text": "再见不会太遥远，若有缘，有缘就能期待明天，你和我重逢在灿烂的季节。"
    },
    {
      "ordinal": 20,
      "start_ms": 197625,
      "end_ms": 206665,
      "text": "唱离别，离别虽然在眼前，说再见，唱不上去了啊啊！"
    },
    {
      "ordinal": 21,
      "start_ms": 207305,
      "end_ms": 213705,
      "text": "再见不会太遥远，唱离别，不要唱，唱不上去了，不好意思啊。"
    },
    {
      "ordinal": 22,
      "start_ms": 214025,
      "end_ms": 217625,
      "text": "离别虽然在眼前，啊，"
    },
    {
      "ordinal": 23,
      "start_ms": 218825,
      "end_ms": 220025,
      "text": "就这样应付应付了。"
    },
    {
      "ordinal": 24,
      "start_ms": 221865,
      "end_ms": 228665,
      "text": "再唱最后一句，若有缘，有缘就能期待明天，"
    },
    {
      "ordinal": 25,
      "start_ms": 230265,
      "end_ms": 234825,
      "text": "你和我重逢在灿烂的季节。"
    },
    {
      "ordinal": 26,
      "start_ms": 237145,
      "end_ms": 249785,
      "text": "不要问，不要说，一切尽在不言中，这一刻，围着烛光，让我们静静的度过。"
    },
    {
      "ordinal": 27,
      "start_ms": 250425,
      "end_ms": 268585,
      "text": "莫回首，莫回头，当我唱起这首歌，愿心中留着笑容，陪你度过每个春夏秋冬。"
    },
    {
      "ordinal": 28,
      "start_ms": 269145,
      "end_ms": 273785,
      "text": "歌唱变成一项折磨人的事业，就违背了他的原初的一个，"
    },
    {
      "ordinal": 29,
      "start_ms": 275865,
      "end_ms": 278505,
      "text": "原初的目的了啊，就这样。"
    },
    {
      "ordinal": 30,
      "start_ms": 279705,
      "end_ms": 281545,
      "text": "这种就是商业文化创。"
    }
  ],
