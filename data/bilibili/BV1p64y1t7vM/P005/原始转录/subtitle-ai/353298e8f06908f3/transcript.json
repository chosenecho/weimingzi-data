    },
    {
      "ordinal": 48,
      "start_ms": 268360,
      "end_ms": 271580,
      "text": "这个他还是妥的温柔同眠"
    },
    {
      "ordinal": 49,
      "start_ms": 271580,
      "end_ms": 273920,
      "text": "能改能解决什么问题啊"
    },
    {
      "ordinal": 50,
      "start_ms": 274140,
      "end_ms": 277020,
      "text": "睡觉的时候别人会抢你位置"
    },
    {
      "ordinal": 51,
      "start_ms": 278340,
      "end_ms": 280580,
      "text": "屁问题不能解决"
    },
    {
      "ordinal": 52,
      "start_ms": 286940,
      "end_ms": 288760,
      "text": "这个格局太低了啊"
    },
    {
      "ordinal": 53,
      "start_ms": 292330,
      "end_ms": 295000,
      "text": "完完全是自恋性的防御机制啊"
    },
