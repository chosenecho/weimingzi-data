    {
      "ordinal": 0,
      "start_ms": 44800,
      "end_ms": 47290,
      "text": "昨日向那东流水"
    },
    {
      "ordinal": 1,
      "start_ms": 47290,
      "end_ms": 50260,
      "text": "离我远去不可留"
    },
    {
      "ordinal": 2,
      "start_ms": 50420,
      "end_ms": 54760,
      "text": "今日乱我心多烦忧"
    },
    {
      "ordinal": 3,
      "start_ms": 55080,
      "end_ms": 57710,
      "text": "抽刀断水水更流"
    },
    {
      "ordinal": 4,
      "start_ms": 57710,
      "end_ms": 60540,
      "text": "举杯浇愁愁更愁"
    },
    {
      "ordinal": 5,
      "start_ms": 60860,
      "end_ms": 65480,
      "text": "明朝清风四飘流"
    },
    {
      "ordinal": 6,
      "start_ms": 68160,
      "end_ms": 70760,
      "text": "由来只有新人笑"
    },
    {
      "ordinal": 7,
      "start_ms": 70760,
      "end_ms": 73640,
      "text": "有谁听到旧人哭"
    },
    {
      "ordinal": 8,
      "start_ms": 73920,
      "end_ms": 77430,
      "text": "爱情两个字好辛苦"
    },
    {
      "ordinal": 9,
      "start_ms": 78550,
      "end_ms": 81180,
      "text": "是要问一个明白"
    },
    {
      "ordinal": 10,
      "start_ms": 81180,
      "end_ms": 83980,
      "text": "还是要装作糊涂"
    },
    {
      "ordinal": 11,
      "start_ms": 84340,
      "end_ms": 87980,
      "text": "知多知少难知足"
    },
    {
      "ordinal": 12,
      "start_ms": 91320,
      "end_ms": 96770,
      "text": "看似个鸳鸯蝴蝶不应该的年代"
    },
    {
      "ordinal": 13,
      "start_ms": 96770,
      "end_ms": 102220,
      "text": "可是谁又能摆脱人世间的悲哀"
    },
    {
      "ordinal": 14,
      "start_ms": 102620,
      "end_ms": 104540,
      "text": "花花世界"
    },
    {
      "ordinal": 15,
      "start_ms": 105560,
      "end_ms": 110760,
      "text": "鸳鸯蝴蝶在人间已是癫"
    },
    {
      "ordinal": 16,
      "start_ms": 110760,
      "end_ms": 113340,
      "text": "何苦要上青天"
    },
    {
      "ordinal": 17,
      "start_ms": 113340,
      "end_ms": 117000,
      "text": "不如温柔同眠"
    },
    {
      "ordinal": 18,
