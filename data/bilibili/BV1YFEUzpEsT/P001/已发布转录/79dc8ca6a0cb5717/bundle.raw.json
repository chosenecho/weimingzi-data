{"segments":[{"start":0.4,"end":2.44,"text":"就是有人说他五一的时候"},{"start":2.44,"end":4.89,"text":"在你这里买了5000块钱蔬菜嗯"},{"start":4.89,"end":5.79,"text":"没有没有"},{"start":5.79,"end":8.47,"text":"就是我看一下嗯"},{"start":8.47,"end":10.1,"text":"就是"},{"start":12.7,"end":16.96,"text":"就是就是这个是回家啊"},{"start":20.5,"end":23.52,"text":"嗯他有个这个是假的"},{"start":23.52,"end":24.8,"text":"就是这个是转账吧"},{"start":24.8,"end":26.76,"text":"应该是你借吗"},{"start":26.76,"end":27.68,"text":"也是你借吗"},{"start":27.68,"end":31.11,"text":"有这个是不是他到你这换了5000现金"},{"start":32.39,"end":33.73,"text":"一个就是换现金"},{"start":33.73,"end":35.33,"text":"没有人拿这么多菜"},{"start":35.33,"end":36.47,"text":"没买过蔬菜"},{"start":36.47,"end":37.27,"text":"没有没有"},{"start":37.27,"end":39.25,"text":"因为你是大规模哦"},{"start":39.25,"end":42.19,"text":"我这里就差不多5000块钱"},{"start":42.19,"end":43.93,"text":"要很多菜在外面吃"},{"start":43.93,"end":46.17,"text":"4月份到现在都没有人买过"},{"start":48.79,"end":50.57,"text":"那这个这个确实是你垫啊"},{"start":50.57,"end":51.84,"text":"这个确实是你店吗"},{"start":51.84,"end":54.5,"text":"江山是四川的"},{"start":54.5,"end":58.02,"text":"换一换啊"},{"start":58.02,"end":58.64,"text":"好的好的"},{"start":58.64,"end":60.08,"text":"谢谢阿姨"},{"start":60.28,"end":61.44,"text":"刚刚收不收"},{"start":61.44,"end":63.24,"text":"你别说风间诶"},{"start":63.24,"end":63.88,"text":"没停呢"},{"start":63.88,"end":64.56,"text":"你还不死"},{"start":64.56,"end":65.14,"text":"抽烟了"},{"start":66.26,"end":67.48,"text":"这不是假"}],"source":"subtitle"}
