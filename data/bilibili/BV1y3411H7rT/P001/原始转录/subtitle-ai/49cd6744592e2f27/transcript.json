    {
      "ordinal": 2,
      "start_ms": 12970,
      "end_ms": 15770,
      "text": "合体合体就变成这个东西了"
    },
    {
      "ordinal": 3,
      "start_ms": 15770,
      "end_ms": 16490,
      "text": "了解吗"
    },
    {
      "ordinal": 4,
      "start_ms": 16490,
      "end_ms": 20430,
      "text": "他是一个呃男人嘴巴里讲出来的一个女权"
