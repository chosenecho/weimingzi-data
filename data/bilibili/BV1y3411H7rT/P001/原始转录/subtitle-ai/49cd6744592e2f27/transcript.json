    {
      "ordinal": 6,
      "start_ms": 21630,
      "end_ms": 22799,
      "text": "一种女权主义"
    },
    {
      "ordinal": 7,
      "start_ms": 22799,
      "end_ms": 25379,
      "text": "然后呢他对于这种女权主义的抨击"
    },
    {
      "ordinal": 8,
      "start_ms": 25379,
      "end_ms": 27539,
      "text": "实际上是要以人道的标准"
    },
    {
      "ordinal": 9,
      "start_ms": 27539,
      "end_ms": 30040,
      "text": "他就呼吁一个人道上的平等啊"
