    {
      "ordinal": 56,
      "start_ms": 144819,
      "end_ms": 146439,
      "text": "真的蛇皮我是走不了的啊"
    },
    {
      "ordinal": 57,
      "start_ms": 146439,
      "end_ms": 147420,
      "text": "那就讲到这边啊"
