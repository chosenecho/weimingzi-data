    {
      "ordinal": 45,
      "start_ms": 116640,
      "end_ms": 118440,
      "text": "什么动物保护啊"
    },
    {
      "ordinal": 46,
      "start_ms": 118440,
      "end_ms": 121050,
      "text": "什么什么转基因啊"
    },
    {
      "ordinal": 47,
      "start_ms": 121050,
      "end_ms": 123420,
      "text": "什么哦哟哟随便搞一个东西"
