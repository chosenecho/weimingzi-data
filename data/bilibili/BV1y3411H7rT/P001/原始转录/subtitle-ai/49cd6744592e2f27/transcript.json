    {
      "ordinal": 35,
      "start_ms": 95760,
      "end_ms": 98580,
      "text": "环保也是要生存和升值的一个矛盾啊"
    },
    {
      "ordinal": 36,
      "start_ms": 98580,
      "end_ms": 100080,
      "text": "人类生存这一代人类生存"
    },
    {
      "ordinal": 37,
      "start_ms": 100080,
      "end_ms": 101940,
      "text": "但是下代还要还要升值呢"
