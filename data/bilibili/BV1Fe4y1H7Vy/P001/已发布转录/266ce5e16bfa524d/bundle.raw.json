tart":805.88,"end":810.28,"text":"就相对来说就令他们心里面有底气"},{"start":811.42,"end":816.33,"text":"饭就是说恶是逼迫劳动者廉价贱价"},{"start":816.33,"end":820.219,"text":"逼迫劳动者贱价出卖自己劳动"},{"start":820.3,"end":827.42,"text":"建家出卖自己劳动的一个很大的很重要的啊一个要素"},{"start":828.5,"end":831.56,"text":"我们先不讲其他什么发展机会啊"},{"start":831.56,"end":833.0,"text":"或者说医疗呀"},{"start":833.0,"end":835.01,"text":"或者说赚到钱了就可以"},{"start":835.01,"end":840.42,"text":"各方面的我们就是最最最基本的就是一个饿饿了就没办法出卖体力"},{"start":840.64,"end":843.46,"text":"还有第二点就是哪怕他不饿"},{"start":844.48,"end":845.66,"text":"营养不良"},{"start":849.4,"end":850.78,"text":"啊营养不良"},{"start":850.78,"end":852.959,"text":"他赚的钱少"},{"start":853.12,"end":855.94,"text":"营养不良导致他各方面的体力啊"},{"start":855.94,"end":856.87,"text":"经历啊"},{"start":856.87,"end":858.22,"text":"甚至说是智力"},{"start":858.22,"end":860.79,"text":"精神上的各种情绪啊"},{"start":860.79,"end":862.65,"text":"还有各种意志力啊"},{"start":862.65,"end":865.95,"text":"啊各种反思批判能力的种种都弱小"},{"start":865.95,"end":869.18,"text":"这个是降低劳动者的"},{"start":872.36,"end":874.9,"text":"劳动者的这个博弈能力呢"},{"start":880.2,"end":882.26,"text":"降低劳动者博弈能力了"},{"start":882.26,"end":884.18,"text":"那你就算啊"},{"start":884.18,"end":885.23,"text":"你就算啊"},{"start":885.23,"end":886.37,"text":"不是营养不良"},{"start":886.37,"end":888.06,"text":"你营养充足"},{"start":889.14,"end":892.79,"text":"但是你缺乏社交呀"},{"start":892.79,"end":893.24,"text":"没有"},{"start":893.24,"end":894.98,"text":"但就是都单独吃饭"},{"start":894.98,"end":897.66,"text":"或者说你的闲暇时间啊"},{"start":897.66,"end":898.5,"text":"无闲暇"},{"start":900.84,"end":902.85,"text":"或者说无限啊"},{"start":902.85,"end":906.459,"text":"我靠无闲暇无社交"},{"start":908.42,"end":911.98,"text":"吃饭就只能自己窝在一块吃啊"},{"start":911.98,"end":913.359,"text":"我我们啊"},{"start":913.4,"end":918.05,"text":"你哪怕你这甚至是一个商圈里面的这一群底层劳动者"},{"start":918.05,"end":920.78,"text":"他都不能够一起吃个饭"},{"start":920.78,"end":922.96,"text":"互相交流交流"},{"start":922.96,"end":923.83,"text":"无闲暇"},{"start":923.83,"end":924.9,"text":"无社交"},{"start":926.92,"end":930.24,"text":"关系互相之间没有关联不关联"},{"start":931.38,"end":934.64,"text":"那么这个时的是死劳动者"},{"start":934.64,"end":936.14,"text":"因为没有时间呀"},{"start":936.14,"end":937.76,"text":"他只是只有吃饭时间"},{"start":937.76,"end":939.08,"text":"吃完饭可能就要回家"},{"start":939.08,"end":941.68,"text":"他因为他时间被剥削的懂了"},{"start":941.68,"end":943.78,"text":"他在单位时间的薪资很少"},{"start":943.78,"end":946.06,"text":"一天要干12 三个小时"},{"start":946.42,"end":949.66,"text":"那他在工作场所唯一的空闲就是吃饭"},{"start":949.66,"end":953.8,"text":"他吃饭自己吃或者三五个人吃啊"},{"start":953.8,"end":956.62,"text":"这个就是劳动者啊"},{"start":956.62,"end":958.359,"text":"彼此孤立"},{"start":961.48,"end":964.099,"text":"疲于就是"},{"start":967.26,"end":969.17,"text":"啊疲于应对啊"},{"start":969.17,"end":972.48,"text":"但是那帮而资产阶级呢"},{"start":972.48,"end":974.4,"text":"他们是可以推杯换盏的"},{"start":974.4,"end":976.38,"text":"他们是有充分的时间去社交的"},{"start":976.38,"end":977.959,"text":"结成一个网络的"},{"start":978.9,"end":984.2,"text":"那么这通通的通通的都降低了议价能力"},{"start":984.2,"end":988.5,"text":"降低了劳动者的一线劳动者"},{"start":988.5,"end":992.099,"text":"一线底层体力劳动者的议价能力"},{"start":994.58,"end":997.06,"text":"那么我们因为这个被降低了"},{"start":997.06,"end":998.2,"text":"所以我们提高它"},{"start":998.2,"end":1000.84,"text":"我们要把这三件事情汇聚到一块血线"},{"start":1000.84,"end":1001.69,"text":"让他不饿"},{"start":1001.69,"end":1003.76,"text":"再让他能够得到营养的保障"},{"start":1003.76,"end":1005.95,"text":"第三个人呢有一定的闲暇"},{"start":1005.95,"end":1006.67,"text":"有一定的社交"},{"start":1006.67,"end":1007.9,"text":"有一定的关联"},{"start":1008.02,"end":1010.979,"text":"那就怎么样请客吃饭"},{"start":1014.38,"end":1017.94,"text":"并且为了让这件事情能够长久的做下去"},{"start":1017.94,"end":1023.12,"text":"我们平次不可能说每天或者隔天就有我们一周一次"},{"start":1023.28,"end":1024.48,"text":"一周一次呢"},{"start":1024.48,"end":1026.52,"text":"不至于使它淡掉啊"},{"start":1026.52,"end":1031.8,"text":"不至于不至于就是不至于淡淡漠的淡淡掉"},{"start":1031.8,"end":1034.94,"text":"淡忘忘掉这两周一次"},{"start":1034.94,"end":1037.069,"text":"属于这么记得一周一次没"},{"start":1037.069,"end":1038.45,"text":"就是我这样可以"},{"start":1038.45,"end":1041.329,"text":"比如营养星期四就叫营养星期四"},{"start":1041.329,"end":1043.369,"text":"这口号大家记得一个星期四"},{"start":1043.369,"end":1050.21,"text":"你说营养14营养营养什么呃"},{"start":1050.21,"end":1051.44,"text":"单数周星期四"},{"start":1051.44,"end":1052.7,"text":"这他妈谁知道"},{"start":1052.7,"end":1053.99,"text":"我靠啊"},{"start":1053.99,"end":1055.04,"text":"不至于淡忘啊"},{"start":1055.04,"end":1058.09,"text":"不至于淡忘一周一次"},{"start":1058.09,"end":1064.72,"text":"然后呢也不至于就是不至于不至于不至于很快吃干了"},{"start":1064.72,"end":1066.28,"text":"不至于很快吃光"},{"start":1066.28,"end":1069.52,"text":"了不至于太太快吧"},{"start":1069.52,"end":1072.34,"text":"这些东西啊不至于太负担太重啊"},{"start":1072.34,"end":1074.12,"text":"不至于负担太重"},{"start":1075.22,"end":1076.62,"text":"他会一直存在"},{"start":1076.62,"end":1080.14,"text":"但是以一个呃一个稳定的状态存在啊"},{"start":1080.14,"end":1081.64,"text":"那么出什么问题"},{"start":1081.64,"end":1084.1,"text":"我们啊还有一个就是一周一次的话"},{"start":1084.1,"end":1084.58,"text":"出问题的话"},{"start":1084.58,"end":1086.46,"text":"我们充足的时间来调整"},{"start":1086.46,"end":1090.03,"text":"并且调整了之后能够很快的见效啊"},{"start":1090.03,"end":1096.22,"text":"有时间充充足时空时间调整啊"},{"start":1098.44,"end":1101.7,"text":"然后调整之后及时反馈"},{"start":1101.7,"end":1103.44,"text":"又可以得到及时的一个反馈"},{"start":1103.44,"end":1104.95,"text":"重新再试错"},{"start":1104.95,"end":1108.61,"text":"那么我们一周一次这个安排是比较妥当的"},{"start":1108.61,"end":1111.25,"text":"我们就请客吃饭的这么一个活计"},{"start":1111.25,"end":1119.09,"text":"我们看能不能我们引导或者帮助劳动者当啊能够提高这个意见能力"},{"start":1119.09,"end":1122.33,"text":"我我不希望就是说我给他们一个星期"},{"start":1122.33,"end":1127.48,"text":"就这段比较有营养的这种餐食提供了之后"},{"start":1127.48,"end":1130.12,"text":"反而让他们更弱小了"},{"start":1130.12,"end":1133.57,"text":"或者反而让他们诶我反而让这个好处"},{"start":1133.57,"end":1134.83,"text":"我提供的这个饭的好处"},{"start":1134.83,"end":1135.73,"text":"让我更有力气"},{"start":1135.73,"end":1138.31,"text":"然后这个力气又被资本家夺走了"},{"start":1138.31,"end":1141.13,"text":"这是我不能容忍不愿意见到的"},{"start":1141.13,"end":1143.73,"text":"所以啊我会尽我一切努"},{"start":1143.73,"end":1148.82,"text":"力来促成我这顿饭吃了之后是能够提高"},{"start":1149.06,"end":1151.52,"text":"反其二行之啊"},{"start":1151.52,"end":1154.26,"text":"提高劳动者的意向能力的"},{"start":1154.5,"end":1156.36,"text":"提高劳动者意甲能力的"},{"start":1156.36,"end":1159.27,"text":"然后我还要说一点啊"},{"start":1159.27,"end":1164.87,"text":"我们会给一些名额给周边的大学里面的勤工俭学的学生啊"},{"start":1164.87,"end":1169.19,"text":"虽然他们不是一个直接的劳动工人阶级的一部分"},{"start":1169.19,"end":1172.64,"text":"但是啊他们是勤工俭学的学生啊"},{"start":1172.64,"end":1176.58,"text":"这个是我们要要要要欢迎的啊"},{"start":1176.58,"end":1180.0,"text":"我们也是要因为他们毕业了"},{"start":1180.0,"end":1181.8,"text":"也是其中的一份子啊"},{"start":1181.8,"end":1182.96,"text":"我们也是要"},{"start":1185.04,"end":1190.54,"text":"然后呢这个东西呢就是说比较好的餐食吃完了"},{"start":1190.54,"end":1196.02,"text":"就是说就是说每天就定量供应40~50份啊"},{"start":1196.16,"end":1198.26,"text":"就供应40~50万里面"},{"start":1198.26,"end":1199.94,"text":"其中有五分是我的工作人员的"},{"start":1199.94,"end":1201.38,"text":"你不我工作人员劳动者"},{"start":1201.74,"end":1204.179,"text":"那我在那群志愿者就苦哈哈"},{"start":1204.179,"end":1205.82,"text":"都是无产阶级"},{"start":1206.74,"end":1209.16,"text":"我的同伴全全无产阶级"},{"start":1209.16,"end":1212.61,"text":"这我也我实际上我不会好太多好吧"},{"start":1212.61,"end":1216.03,"text":"他们总共有五份是我自己人要要吃的饭啊"},{"start":1216.03,"end":1217.53,"text":"其他的40~50分的"},{"start":1217.53,"end":1223.88,"text":"那全都是给这个都是买菜自己烹饪的"},{"start":1223.88,"end":1225.899,"text":"买菜自己烹饪的"},{"start":1229.42,"end":1231.78,"text":"买菜自己烹饪有没有害啊"},{"start":1232.92,"end":1233.82,"text":"明白吧"},{"start":1234.16,"end":1235.36,"text":"没那么容易的"},{"start":1235.36,"end":1237.82,"text":"孩子好像没有这一横啊"},{"start":1237.82,"end":1239.34,"text":"我没文化不管了"},{"start":1241.1,"end":1242.74,"text":"轮到你自己真的写的时候"},{"start":1242.74,"end":1245.14,"text":"你也可能会问他到底是想家火呢"},{"start":1245.14,"end":1246.76,"text":"还是一个横加火烹啊"},{"start":1246.76,"end":1248.92,"text":"哼啊应该是这个对亨加火啊"},{"start":1248.92,"end":1249.78,"text":"没横"},{"start":1250.34,"end":1252.94,"text":"然后这份这些东西吃完了之后呢"},{"start":1252.94,"end":1255.04,"text":"我们会米饭会多烧一点"},{"start":1255.04,"end":1257.04,"text":"米饭会多烧一点"},{"start":1257.1,"end":1259.14,"text":"然后我们会有自热包"},{"start":1259.14,"end":1261.45,"text":"我们依然会有免费的"},{"start":1261.45,"end":1263.76,"text":"免费的或者说很低价的"},{"start":1263.76,"end":1265.08,"text":"