{
  "bvid": "BV1zi4y1q7Av",
  "page": 1,
  "source": "subtitle-ai",
  "language": "ai-zh",
  "model": null,
  "content_sha256": "b756632fc31ebf2da7b5d4df83d3c546843be384fa6acfc53483e3767c02d619",
  "segments": [
    {
      "ordinal": 0,
      "start_ms": 760,
      "end_ms": 1930,
      "text": "不浪费时间"
    },
    {
      "ordinal": 1,
      "start_ms": 1930,
      "end_ms": 3940,
      "text": "我要回十封信"
    },
    {
      "ordinal": 2,
      "start_ms": 5560,
      "end_ms": 6960,
      "text": "就"
    },
    {
      "ordinal": 3,
      "start_ms": 8340,
      "end_ms": 9920,
      "text": "出门有事要做啊"
    },
    {
      "ordinal": 4,
      "start_ms": 13340,
      "end_ms": 15140,
      "text": "一峰"
    },
    {
      "ordinal": 5,
      "start_ms": 31960,
      "end_ms": 33690,
      "text": "可以公开"
    },
    {
      "ordinal": 6,
      "start_ms": 34150,
      "end_ms": 35940,
      "text": "突然想给我写信"
    },
    {
      "ordinal": 7,
      "start_ms": 35940,
      "end_ms": 38610,
      "text": "因为他和他妈有一番通话"
    },
    {
      "ordinal": 8,
      "start_ms": 38610,
      "end_ms": 43760,
      "text": "说家里某个长辈又和她妈妈聊到"
    },
    {
      "ordinal": 9,
      "start_ms": 43760,
      "end_ms": 47250,
      "text": "让她以后清明节最好回去请假"
    },
    {
      "ordinal": 10,
      "start_ms": 47250,
      "end_ms": 48300,
      "text": "回去扫墓"
    },
    {
      "ordinal": 11,
      "start_ms": 48300,
      "end_ms": 51900,
      "text": "因为他爷爷奶奶遇了三男三女"
    },
    {
      "ordinal": 12,
      "start_ms": 51900,
      "end_ms": 54910,
      "text": "目前他的爷爷还有"
    },
    {
      "ordinal": 13,
      "start_ms": 54910,
      "end_ms": 57490,
      "text": "反正一些亲属已经去世了"
    },
    {
      "ordinal": 14,
      "start_ms": 57490,
      "end_ms": 61600,
      "text": "然后另外另外有两个亲属没有结婚"
    },
    {
      "ordinal": 15,
      "start_ms": 61600,
      "end_ms": 62890,
      "text": "也就是说"
    },
    {
      "ordinal": 16,
      "start_ms": 62890,
      "end_ms": 66390,
      "text": "未来祭拜先人的传统"
    },
    {
      "ordinal": 17,
      "start_ms": 66390,
      "end_ms": 68310,
      "text": "应该由他和他的弟弟来进行"
    },
    {
      "ordinal": 18,
      "start_ms": 68310,
      "end_ms": 69030,
      "text": "他是长子"
    },
    {
      "ordinal": 19,
      "start_ms": 69030,
      "end_ms": 70350,
      "text": "要学会如何扫墓"
    },
    {
      "ordinal": 20,
      "start_ms": 70350,
      "end_ms": 71010,
      "text": "对他来说"
    },
    {
      "ordinal": 21,
      "start_ms": 71010,
      "end_ms": 74055,
      "text": "这是件消耗金钱时间精力的无益的事情"
    },
    {
      "ordinal": 22,
      "start_ms": 74060,
      "end_ms": 75860,
      "text": "他需要花一天时间回家"
    },
    {
      "ordinal": 23,
      "start_ms": 75860,
      "end_ms": 79370,
      "text": "用一天的时间进行这些不知道什么的仪式"
    },
    {
      "ordinal": 24,
      "start_ms": 79370,
      "end_ms": 80810,
      "text": "又花一天时间回到工作地"
    },
    {
      "ordinal": 25,
      "start_ms": 80810,
      "end_ms": 81590,
      "text": "第二天还要上班"
    },
    {
      "ordinal": 26,
      "start_ms": 81590,
      "end_ms": 82490,
      "text": "这真的有必要吗"
    },
    {
      "ordinal": 27,
      "start_ms": 82490,
      "end_ms": 84350,
      "text": "为什么只有一个特定日子去祭拜"
    },
    {
      "ordinal": 28,
      "start_ms": 84350,
      "end_ms": 85550,
      "text": "死去的人才有意义"
    },
    {
      "ordinal": 29,
      "start_ms": 85550,
      "end_ms": 87770,
      "text": "我可以在年底请假探亲"
    },
    {
      "ordinal": 30,
      "start_ms": 87770,
      "end_ms": 89750,
      "text": "请探亲假20天回家过年"
    },
    {
      "ordinal": 31,
      "start_ms": 89750,
      "end_ms": 91310,
      "text": "在春节找一天去扫墓"
    },
    {
      "ordinal": 32,
      "start_ms": 91310,
      "end_ms": 93170,
      "text": "反正现在所有都经营公墓了"
    },
    {
      "ordinal": 33,
      "start_ms": 93170,
      "end_ms": 94580,
      "text": "也不过是上几炷香"
    },
    {
      "ordinal": 34,
      "start_ms": 94580,
      "end_ms": 97970,
      "text": "和自己最近的人心里念叨几句罢了"
    },
    {
      "ordinal": 35,
      "start_ms": 97970,
      "end_ms": 99380,
      "text": "至于更远些的亲人"
    },
    {
      "ordinal": 36,
      "start_ms": 99380,
      "end_ms": 100280,
      "text": "实在没什么感觉"
    },
    {
      "ordinal": 37,
      "start_ms": 100280,
      "end_ms": 101360,
      "text": "如果是因为传统"
    },
    {
      "ordinal": 38,
      "start_ms": 101360,
      "end_ms": 103860,
      "text": "那所接的接触到的许多劳务工人"
    },
    {
      "ordinal": 39,
      "start_ms": 103860,
      "end_ms": 104880,
      "text": "别说清明节"
    },
    {
      "ordinal": 40,
      "start_ms": 104880,
      "end_ms": 108750,
      "text": "就连端午什么什么什么各种节日都在进行"
    },
    {
      "ordinal": 41,
      "start_ms": 108750,
      "end_ms": 109770,
      "text": "充满汗水劳动"
    },
    {
      "ordinal": 42,
      "start_ms": 109770,
      "end_ms": 111040,
      "text": "传统真的存在吗"
    },
    {
      "ordinal": 43,
      "start_ms": 111040,
      "end_ms": 112600,
      "text": "我现在不由得胡思乱想"
    },
    {
      "ordinal": 44,
      "start_ms": 112600,
      "end_ms": 113980,
      "text": "这是否是一个预兆"
    },
    {
      "ordinal": 45,
      "start_ms": 113980,
      "end_ms": 114820,
      "text": "已经26岁了"
    },
    {
      "ordinal": 46,
      "start_ms": 114820,
      "end_ms": 117880,
      "text": "开始要面对买房结婚生子等一系列传统难题"
    },
    {
      "ordinal": 47,
      "start_ms": 117880,
      "end_ms": 120310,
      "text": "并不在意这些等周围一些人的话语"
    },
    {
      "ordinal": 48,
      "start_ms": 120310,
      "end_ms": 120910,
      "text": "呃"
    },
    {
      "ordinal": 49,
      "start_ms": 120910,
      "end_ms": 122110,
      "text": "什么又在跟他洗脑"
    },
    {
      "ordinal": 50,
      "start_ms": 122110,
      "end_ms": 122770,
      "text": "应该怎么做"
    },
    {
      "ordinal": 51,
      "start_ms": 123850,
      "end_ms": 125110,
      "text": "信件可公开啊"
    },
    {
      "ordinal": 52,
      "start_ms": 125110,
      "end_ms": 126760,
      "text": "这个小朋友比较无知啊"
    },
    {
      "ordinal": 53,
      "start_ms": 126760,
      "end_ms": 128720,
      "text": "呃具体问题具体分析"
    },
    {
      "ordinal": 54,
      "start_ms": 128720,
      "end_ms": 131180,
      "text": "他的爷爷奶奶生了三男三女"
    },
    {
      "ordinal": 55,
      "start_ms": 131180,
      "end_ms": 133980,
      "text": "目前她是这个家族的"
    },
    {
      "ordinal": 56,
      "start_ms": 133980,
      "end_ms": 135720,
      "text": "他和他的弟弟吗"
    },
    {
      "ordinal": 57,
      "start_ms": 135720,
      "end_ms": 137350,
      "text": "唯二继承人"
    },
    {
      "ordinal": 58,
      "start_ms": 137350,
      "end_ms": 139960,
      "text": "他和他的弟弟啊"
    },
    {
      "ordinal": 59,
      "start_ms": 139960,
      "end_ms": 141610,
      "text": "他是他又是长子"
    },
    {
      "ordinal": 60,
      "start_ms": 141610,
      "end_ms": 144030,
      "text": "他的他的"
    },
    {
      "ordinal": 61,
      "start_ms": 144610,
      "end_ms": 150550,
      "text": "也就是说他父亲的哥哥和弟弟都没有结婚"
    },
    {
      "ordinal": 62,
      "start_ms": 151690,
      "end_ms": 154060,
      "text": "意味着什么"
    },
    {
      "ordinal": 63,
      "start_ms": 155340,
      "end_ms": 156740,
      "text": "他是唯二继承人"
    },
    {
      "ordinal": 64,
      "start_ms": 158180,
      "end_ms": 161090,
      "text": "他的他的伯父和叔叔去世了之后"
    },
    {
      "ordinal": 65,
      "start_ms": 161090,
      "end_ms": 163420,
      "text": "财产都是他的"
    },
    {
      "ordinal": 66,
      "start_ms": 165060,
      "end_ms": 170370,
      "text": "所以你的母亲让你回去这个祭扫先人"
    },
    {
      "ordinal": 67,
      "start_ms": 170370,
      "end_ms": 172950,
      "text": "让你利用这些仪式"
    },
    {
      "ordinal": 68,
      "start_ms": 172950,
      "end_ms": 174340,
      "text": "利用这些"
    },
    {
      "ordinal": 69,
      "start_ms": 174340,
      "end_ms": 175810,
      "text": "你明白吗"
    },
    {
      "ordinal": 70,
      "start_ms": 175810,
      "end_ms": 177580,
      "text": "就说你作为一个年轻人"
    },
    {
      "ordinal": 71,
      "start_ms": 177580,
      "end_ms": 179829,
      "text": "你想不到这个关节点"
    },
    {
      "ordinal": 72,
      "start_ms": 179989,
      "end_ms": 181869,
      "text": "你是一个上班族"
    },
    {
      "ordinal": 73,
      "start_ms": 181869,
      "end_ms": 186820,
      "text": "你要利利用通过正儿八经上班往上爬"
    },
    {
      "ordinal": 74,
      "start_ms": 186820,
      "end_ms": 188320,
      "text": "想实现阶级跃迁"
    },
    {
      "ordinal": 75,
      "start_ms": 188320,
      "end_ms": 189640,
      "text": "可能性微乎其微"
    },
    {
      "ordinal": 76,
      "start_ms": 190720,
      "end_ms": 191770,
      "text": "几乎是零"
    },
    {
      "ordinal": 77,
      "start_ms": 191770,
      "end_ms": 194810,
      "text": "然后你清明节让你回去扫墓"
    },
    {
      "ordinal": 78,
      "start_ms": 195390,
      "end_ms": 197090,
      "text": "这不是个利益关系问题"
    },
    {
      "ordinal": 79,
      "start_ms": 197090,
      "end_ms": 201800,
      "text": "就是说这整个团体这个家族的利益"
    },
    {
      "ordinal": 80,
      "start_ms": 202200,
      "end_ms": 203360,
      "text": "要找接班人了"
    },
    {
      "ordinal": 81,
      "start_ms": 203360,
      "end_ms": 203900,
      "text": "你懂吧"
    },
    {
      "ordinal": 82,
      "start_ms": 203900,
      "end_ms": 204740,
      "text": "要找继承者"
    },
    {
      "ordinal": 83,
      "start_ms": 204740,
      "end_ms": 206650,
      "text": "要找接班人了"
    },
    {
      "ordinal": 84,
      "start_ms": 206650,
      "end_ms": 208450,
      "text": "你是你们这一支"
    },
    {
      "ordinal": 85,
      "start_ms": 208450,
      "end_ms": 213170,
      "text": "就说这是一个底层底层抱团斗争的一个事情"
    },
    {
      "ordinal": 86,
      "start_ms": 213170,
      "end_ms": 215750,
      "text": "你们一个你们一个团体"
    },
    {
      "ordinal": 87,
      "start_ms": 215750,
      "end_ms": 218030,
      "text": "一个家族抱团斗争"
    },
    {
      "ordinal": 88,
      "start_ms": 218030,
      "end_ms": 221175,
      "text": "最后这个权利是要交到你手上去的"
    },
    {
      "ordinal": 89,
      "start_ms": 221739,
      "end_ms": 222639,
      "text": "对不对"
    },
    {
      "ordinal": 90,
      "start_ms": 222639,
      "end_ms": 224499,
      "text": "那么多人积累那么多财富"
    },
    {
      "ordinal": 91,
      "start_ms": 224499,
      "end_ms": 227199,
      "text": "最后要有要有一两个人去掌舵啊"
    },
    {
      "ordinal": 92,
      "start_ms": 227199,
      "end_ms": 228339,
      "text": "一两个人去掌舵"
    },
    {
      "ordinal": 93,
      "start_ms": 228339,
      "end_ms": 228879,
      "text": "归根结底"
    },
    {
      "ordinal": 94,
      "start_ms": 228879,
      "end_ms": 233839,
      "text": "你要担负起家庭的家族的一个一个一个责任啊"
    },
    {
      "ordinal": 95,
      "start_ms": 233839,
      "end_ms": 236839,
      "text": "你要像一般的打工人"
    },
    {
      "ordinal": 96,
      "start_ms": 236839,
      "end_ms": 239329,
      "text": "一般的这个上班族"
    },
    {
      "ordinal": 97,
      "start_ms": 239329,
      "end_ms": 243710,
      "text": "那个靠什么"
    },
    {
      "ordinal": 98,
      "start_ms": 244050,
      "end_ms": 245990,
      "text": "也就是说我这样跟你说"
    },
    {
      "ordinal": 99,
      "start_ms": 245990,
      "end_ms": 249290,
      "text": "你想要通过增量实现阶级跃迁是不可能的"
    },
    {
      "ordinal": 100,
      "start_ms": 249290,
      "end_ms": 250490,
      "text": "你只能通过存量"
    },
    {
      "ordinal": 101,
      "start_ms": 250490,
      "end_ms": 252970,
      "text": "而你的长辈嗯"
    },
    {
      "ordinal": 102,
      "start_ms": 252970,
      "end_ms": 254740,
      "text": "他们都有某种存量啊"
    },
    {
      "ordinal": 103,
      "start_ms": 254740,
      "end_ms": 257480,
      "text": "或者说whatever"
    },
    {
      "ordinal": 104,
      "start_ms": 257480,
      "end_ms": 261250,
      "text": "在我看来就是我始终是这样认为的"
    },
    {
      "ordinal": 105,
      "start_ms": 261250,
      "end_ms": 264280,
      "text": "那个你要做小资产阶级"
    },
    {
      "ordinal": 106,
      "start_ms": 264280,
      "end_ms": 267360,
      "text": "在在这个职场里面可卷上去"
    },
    {
      "ordinal": 107,
      "start_ms": 267360,
      "end_ms": 268380,
      "text": "你卷一辈子"
    },
    {
      "ordinal": 108,
      "start_ms": 268380,
      "end_ms": 269910,
      "text": "你也是个打工的"
    },
    {
      "ordinal": 109,
      "start_ms": 269910,
      "end_ms": 273380,
      "text": "也是个奴才奴仆嗯"
    },
    {
      "ordinal": 110,
      "start_ms": 273380,
      "end_ms": 275150,
      "text": "也是个奴仆啊"
    },
    {
      "ordinal": 111,
      "start_ms": 275150,
      "end_ms": 281560,
      "text": "然后你更多的要扮演的其实说是一个群体"
    },
    {
      "ordinal": 112,
      "start_ms": 281560,
      "end_ms": 283630,
      "text": "血缘关系的群体"
    },
    {
      "ordinal": 113,
      "start_ms": 283630,
      "end_ms": 285130,
      "text": "这些人如何处置"
    },
    {
      "ordinal": 114,
      "start_ms": 285130,
      "end_ms": 286570,
      "text": "如何安置的问题"
    },
    {
      "ordinal": 115,
      "start_ms": 286570,
      "end_ms": 289210,
      "text": "这可是一个君主性的一个角色"
    },
    {
      "ordinal": 116,
      "start_ms": 289210,
      "end_ms": 290680,
      "text": "君主性的角色"
    },
    {
      "ordinal": 117,
      "start_ms": 290680,
      "end_ms": 291670,
      "text": "你在这个团体里面"
    },
    {
      "ordinal": 118,
      "start_ms": 291670,
      "end_ms": 293510,
      "text": "你是君主啊"
    },
    {
      "ordinal": 119,
      "start_ms": 293670,
      "end_ms": 295250,
      "text": "你长死啊"
    },
    {
      "ordinal": 120,
      "start_ms": 295250,
      "end_ms": 300850,
      "text": "呃他他父亲也也也那个"
    },
    {
      "ordinal": 121,
      "start_ms": 300850,
      "end_ms": 304930,
      "text": "反正他现在他就是他是这这这这这个群体里面"
    },
    {
      "ordinal": 122,
      "start_ms": 304930,
      "end_ms": 306104,
      "text": "超"
    },
    {
      "ordinal": 123,
      "start_ms": 307429,
      "end_ms": 310329,
      "text": "如果你如果你的这个直系亲属"
    },
    {
      "ordinal": 124,
      "start_ms": 310329,
      "end_ms": 313540,
      "text": "都失去这个与时俱进的"
    },
    {
      "ordinal": 125,
      "start_ms": 313540,
      "end_ms": 316450,
      "text": "或者说掌控雷电的那个能力的话"
    },
    {
      "ordinal": 126,
      "start_ms": 316450,
      "end_ms": 320400,
      "text": "你就是操持基本上一切事物的君主"
    },
    {
      "ordinal": 127,
      "start_ms": 321620,
      "end_ms": 324400,
      "text": "但很多年轻人不愿意承担这个角色问题"
    },
    {
      "ordinal": 128,
      "start_ms": 324400,
      "end_ms": 328720,
      "text": "就是说很多年轻人不愿意承担这个角色"
    },
    {
      "ordinal": 129,
      "start_ms": 329429,
      "end_ms": 330889,
      "text": "我有点不能理解啊"
    },
    {
      "ordinal": 130,
      "start_ms": 330889,
      "end_ms": 334189,
      "text": "就是说很多年轻人在你这个二十六七岁的时候"
    },
    {
      "ordinal": 131,
      "start_ms": 334189,
      "end_ms": 337850,
      "text": "看你孙权掌权的时候才多少岁啊"
    },
    {
      "ordinal": 132,
      "start_ms": 337850,
      "end_ms": 339080,
      "text": "十几岁对不对"
    },
    {
      "ordinal": 133,
      "start_ms": 339080,
      "end_ms": 341630,
      "text": "26岁你已经你也知道你已经26岁了"
    },
    {
      "ordinal": 134,
      "start_ms": 341630,
      "end_ms": 344450,
      "text": "要面对买房结婚生子一系列传统难题"
    },
    {
      "ordinal": 135,
      "start_ms": 344450,
      "end_ms": 347150,
      "text": "这个一系列传统难题不是你一个人面对的难题"
    },
    {
      "ordinal": 136,
      "start_ms": 347150,
      "end_ms": 348770,
      "text": "是一个家族面对的难题"
    },
    {
      "ordinal": 137,
      "start_ms": 348770,
      "end_ms": 350870,
      "text": "你可以调配所有的这些力量"
    },
    {
      "ordinal": 138,
      "start_ms": 350870,
      "end_ms": 353270,
      "text": "这些资源来实现你的目的"
    },
    {
      "ordinal": 139,
      "start_ms": 353270,
      "end_ms": 355070,
      "text": "你不是单打独斗的"
    },
    {
      "ordinal": 140,
      "start_ms": 355070,
      "end_ms": 356990,
      "text": "你在这个前现代共同体里面"
    },
    {
      "ordinal": 141,
      "start_ms": 356990,
      "end_ms": 357980,
      "text": "你是君主"
    },
    {
      "ordinal": 142,
      "start_ms": 357980,
      "end_ms": 358910,
      "text": "你是君主"
    },
    {
      "ordinal": 143,
      "start_ms": 358910,
      "end_ms": 361010,
      "text": "你明白什么叫做是君主吗"
    },
    {
      "ordinal": 144,
      "start_ms": 361010,
      "end_ms": 365390,
      "text": "你的所有利益是关关切连接到他们"
    },
    {
      "ordinal": 145,
      "start_ms": 365390,
      "end_ms": 365990,
      "text": "每一个人的"
    },
    {
      "ordinal": 146,
      "start_ms": 365990,
      "end_ms": 368390,
      "text": "每一个都要向你服务的"
    },
    {
      "ordinal": 147,
      "start_ms": 370500,
      "end_ms": 372200,
      "text": "这个这个你就想不通了"
    },
    {
      "ordinal": 148,
      "start_ms": 372200,
      "end_ms": 372740,
      "text": "对不对"
    },
    {
      "ordinal": 149,
      "start_ms": 373760,
      "end_ms": 375560,
      "text": "明白吗"
    },
    {
      "ordinal": 150,
      "start_ms": 379060,
      "end_ms": 380580,
      "text": "这个不是原子化的啊"
    },
    {
      "ordinal": 151,
      "start_ms": 380580,
      "end_ms": 381660,
      "text": "在中国的年轻人"
    },
    {
      "ordinal": 152,
      "start_ms": 381660,
      "end_ms": 384900,
      "text": "他的生存方式远远不是原子化的"
    },
    {
      "ordinal": 153,
      "start_ms": 384900,
      "end_ms": 392360,
      "text": "就让你呃这个回老家去扫个墓都不愿意的"
    },
    {
      "ordinal": 154,
      "start_ms": 392460,
      "end_ms": 396080,
      "text": "就不能理解不能理解这些人力都是为你可用的"
    },
    {
      "ordinal": 155,
      "start_ms": 396080,
      "end_ms": 397640,
      "text": "当然你看不上这些人力的"
    },
    {
      "ordinal": 156,
      "start_ms": 397640,
      "end_ms": 398720,
      "text": "都是老了嘛"
    },
    {
      "ordinal": 157,
      "start_ms": 398720,
      "end_ms": 402300,
      "text": "然后这里面的这些这些"
    },
    {
      "ordinal": 158,
      "start_ms": 404340,
      "end_ms": 408090,
      "text": "他们的人脉关系其实也是唯一可用的"
    },
    {
      "ordinal": 159,
      "start_ms": 408090,
      "end_ms": 409860,
      "text": "就是你看不上这些人脉关系的"
    },
    {
      "ordinal": 160,
      "start_ms": 409860,
      "end_ms": 410670,
      "text": "我说难听点"
    },
    {
      "ordinal": 161,
      "start_ms": 410670,
      "end_ms": 411810,
      "text": "大城市你混不下去"
    },
    {
      "ordinal": 162,
      "start_ms": 411810,
      "end_ms": 412290,
      "text": "回老家"
    },
    {
      "ordinal": 163,
      "start_ms": 412290,
      "end_ms": 414750,
      "text": "你要去搞个承包个什么东西"
    },
    {
      "ordinal": 164,
      "start_ms": 414750,
      "end_ms": 416190,
      "text": "要去做个什么生意"
    },
    {
      "ordinal": 165,
      "start_ms": 416190,
      "end_ms": 417980,
      "text": "都要去和他们打交道"
    },
    {
      "ordinal": 166,
      "start_ms": 417980,
      "end_ms": 419180,
      "text": "就是你看不上吧"
    },
    {
      "ordinal": 167,
      "start_ms": 419180,
      "end_ms": 420110,
      "text": "实事求是讲"
    },
    {
      "ordinal": 168,
      "start_ms": 420110,
      "end_ms": 421220,
      "text": "那我的兄弟姐妹"
    },
    {
      "ordinal": 169,
      "start_ms": 421220,
      "end_ms": 423140,
      "text": "也有一些没有接受过良好教育的"
    },
    {
      "ordinal": 170,
      "start_ms": 423140,
      "end_ms": 425010,
      "text": "我的一些堂兄弟表姐妹"
    },
    {
      "ordinal": 171,
      "start_ms": 425010,
      "end_ms": 426090,
      "text": "他回老家"
    },
    {
      "ordinal": 172,
      "start_ms": 426090,
      "end_ms": 430150,
      "text": "他就是要还是要和这些叔伯姑姑婶婶打交道"
    },
    {
      "ordinal": 173,
      "start_ms": 430150,
      "end_ms": 431290,
      "text": "靠他们的人际关系"
    },
    {
      "ordinal": 174,
      "start_ms": 431290,
      "end_ms": 433240,
      "text": "在村里面支个什么摊子"
    },
    {
      "ordinal": 175,
      "start_ms": 433240,
      "end_ms": 436640,
      "text": "开个什么店嗯"
    },
    {
      "ordinal": 176,
      "start_ms": 436640,
      "end_ms": 441780,
      "text": "主要是你你盘算到的东西盘算的不一样"
    },
    {
      "ordinal": 177,
      "start_ms": 441780,
      "end_ms": 442260,
      "text": "你知道吗"
    },
    {
      "ordinal": 178,
      "start_ms": 442260,
      "end_ms": 446870,
      "text": "你如果说是这个社会在呃突飞猛进的现代化啊"
    },
    {
      "ordinal": 179,
      "start_ms": 446870,
      "end_ms": 448310,
      "text": "突飞猛进的都是原子化"
    },
    {
      "ordinal": 180,
      "start_ms": 448310,
      "end_ms": 450640,
      "text": "个人到那个资本主义市场上去竞争"
    },
    {
      "ordinal": 181,
      "start_ms": 450640,
      "end_ms": 452380,
      "text": "比如说你现在找到工作"
    },
    {
      "ordinal": 182,
      "start_ms": 452380,
      "end_ms": 454360,
      "text": "还能让你在可见的5年到10年"
    },
    {
      "ordinal": 183,
      "start_ms": 454360,
      "end_ms": 457440,
      "text": "你的财产能够分翻两番乘以四"
    },
    {
      "ordinal": 184,
      "start_ms": 457440,
      "end_ms": 460710,
      "text": "比如说你的那个比如说你现在5000块钱一个月"
    },
    {
      "ordinal": 185,
      "start_ms": 460710,
      "end_ms": 466309,
      "text": "那过过5年你可以变成1万块钱一个月"
    },
    {
      "ordinal": 186,
      "start_ms": 466309,
      "end_ms": 468840,
      "text": "再过5年十年之后你2万块钱一个月"
    },
    {
      "ordinal": 187,
      "start_ms": 468840,
      "end_ms": 470610,
      "text": "如果是这么一个倾向的话"
    },
    {
      "ordinal": 188,
      "start_ms": 470610,
      "end_ms": 472800,
      "text": "那我觉得你就当我放屁好了"
    },
    {
      "ordinal": 189,
      "start_ms": 472800,
      "end_ms": 475440,
      "text": "但是如果说未来的5年可能6000块钱一个月"
    },
    {
      "ordinal": 190,
      "start_ms": 475440,
      "end_ms": 477240,
      "text": "在未来的再过5年"
    },
    {
      "ordinal": 191,
      "start_ms": 477240,
      "end_ms": 478500,
      "text": "你可能变成7000块钱"
    },
    {
      "ordinal": 192,
      "start_ms": 478500,
      "end_ms": 479070,
      "text": "一个月"
    },
    {
      "ordinal": 193,
      "start_ms": 479070,
      "end_ms": 480480,
      "text": "1000再涨2000"
    },
    {
      "ordinal": 194,
      "start_ms": 480480,
      "end_ms": 482040,
      "text": "就这么一个这么一个速度的话"
    },
    {
      "ordinal": 195,
      "start_ms": 482040,
      "end_ms": 483150,
      "text": "平均而言的话"
    },
    {
      "ordinal": 196,
      "start_ms": 483150,
      "end_ms": 486520,
      "text": "那我觉得实事求奖呃"
    },
    {
      "ordinal": 197,
      "start_ms": 486520,
      "end_ms": 492340,
      "text": "就作为一个现代的26岁的年轻人"
    },
    {
      "ordinal": 198,
      "start_ms": 493840,
      "end_ms": 497520,
      "text": "我觉得你要把这些东西要账都算清楚一点"
    },
    {
      "ordinal": 199,
      "start_ms": 497520,
      "end_ms": 500130,
      "text": "像一个君主一样去盘算自己的生活"
    },
    {
      "ordinal": 200,
      "start_ms": 500130,
      "end_ms": 503100,
      "text": "而不是说像一个小小小小奴才"
    },
    {
      "ordinal": 201,
      "start_ms": 503100,
      "end_ms": 505085,
      "text": "小秀才一样"
    },
    {
      "ordinal": 202,
      "start_ms": 507600,
      "end_ms": 509180,
      "text": "啊这个这个第一封信"
    },
    {
      "ordinal": 203,
      "start_ms": 509180,
      "end_ms": 510110,
      "text": "第一封信"
    },
    {
      "ordinal": 204,
      "start_ms": 510110,
      "end_ms": 514250,
      "text": "周围人的话语行动仿佛对你进行洗脑"
