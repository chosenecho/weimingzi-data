{"start":858.119,"end":859.139,"text":"刚离异的"},{"start":859.139,"end":863.309,"text":"刚刚这个作保关系被拆解掉了"},{"start":863.309,"end":865.87,"text":"他的一下发现诶没有人盯着我"},{"start":865.87,"end":866.83,"text":"啥都可以做了"},{"start":866.83,"end":868.15,"text":"对不对啊"},{"start":868.15,"end":870.43,"text":"而且他本身就对于这种家庭啊"},{"start":870.43,"end":875.94,"text":"或者说啊这个社会就是这个家族关系再生产"},{"start":875.94,"end":876.78,"text":"就是生孩子"},{"start":876.78,"end":879.42,"text":"生儿育女这件事情他可以破灭"},{"start":879.42,"end":883.22,"text":"这些人避免他走向极端和激进"},{"start":884.22,"end":885.89,"text":"我并不是说极端"},{"start":885.89,"end":888.2,"text":"我并不是说激进就有个极端是有问题"},{"start":888.2,"end":890.2,"text":"但并不是说激进就有问题"},{"start":890.2,"end":893.2,"text":"但是你这个激进要有正确的方向"},{"start":893.2,"end":896.68,"text":"往往这种刚刚从这种两性关系当中解离出来"},{"start":896.68,"end":899.74,"text":"家庭关系当中解离出来的就是有说不好听的"},{"start":899.74,"end":901.42,"text":"就像自由基一样的"},{"start":901.42,"end":902.89,"text":"它具有破坏性的"},{"start":902.89,"end":905.74,"text":"他自己并没有他明确的这个合成目的"},{"start":905.74,"end":909.519,"text":"综合的目的没有明确他的生活的意向"},{"start":909.519,"end":910.959,"text":"生活的计划"},{"start":910.959,"end":914.8,"text":"很多的抱负或者就是放纵啊"},{"start":916.56,"end":919.94,"text":"所以这个把视角着眼在什么"},{"start":919.94,"end":922.1,"text":"那女的就可以多花男的钱啊"},{"start":922.1,"end":924.62,"text":"因为法律一定会照顾这些女的啊"},{"start":924.62,"end":926.029,"text":"什么呃"},{"start":926.029,"end":926.959,"text":"他有财产"},{"start":926.959,"end":928.879,"text":"他要这个房屋什么"},{"start":928.879,"end":930.559,"text":"然后女的就可以挥霍又回来"},{"start":930.559,"end":931.699,"text":"又住又挥霍"},{"start":931.699,"end":933.569,"text":"又住又挥霍又住"},{"start":933.909,"end":936.449,"text":"这都是这这算啥啊"},{"start":936.449,"end":939.67,"text":"这还是看在一个男女的议题里面"},{"start":939.67,"end":943.69,"text":"但是对于治安当局或者对于这个立法当局"},{"start":943.69,"end":947.99,"text":"我觉得我们的视角你换我坐天下也是一样的"},{"start":947.99,"end":949.7,"text":"我不会有差别的"},{"start":949.7,"end":953.21,"text":"换成一个成熟老道的一个刑民专家"},{"start":953.21,"end":954.77,"text":"或者说立法专家"},{"start":954.77,"end":958.29,"text":"他首先要考虑的是在这种特定情景之下"},{"start":958.29,"end":959.37,"text":"解离出来的人"},{"start":959.37,"end":960.839,"text":"他的合法身份"},{"start":960.839,"end":962.639,"text":"并不是说他就解决就不合法了"},{"start":962.639,"end":964.559,"text":"他说合法性认证降低了"},{"start":964.559,"end":965.129,"text":"你知道吗"},{"start":965.129,"end":966.299,"text":"合法性的监视"},{"start":966.299,"end":967.949,"text":"合法性的控制管控"},{"start":967.949,"end":970.08,"text":"以及他本身遵守法律"},{"start":970.08,"end":975.629,"text":"遵守基本的一些治安的形式的规则的意愿"},{"start":975.629,"end":976.559,"text":"大大降低了"},{"start":976.559,"end":978.029,"text":"他可能这个婚姻失败"},{"start":978.029,"end":979.589,"text":"或者说家庭关系裂解"},{"start":979.589,"end":985.38,"text":"对他的整个的存在状态是极大的冲击啊"},{"start":985.38,"end":986.82,"text":"所以我觉得这是婚姻法"},{"start":986.82,"end":989.16,"text":"是在和这些治安方面的"},{"start":989.16,"end":991.32,"text":"或者说和整个的法治社会"},{"start":991.32,"end":994.05,"text":"法治社会治理的需求在打配合"},{"start":994.05,"end":996.03,"text":"不仅仅是一个财产的问题"},{"start":997.41,"end":1000.21,"text":"财产财产真的能搞定财产"},{"start":1000.21,"end":1002.37,"text":"那资产资产就会在乎财产的问题吗"},{"start":1002.37,"end":1005.08,"text":"他会在乎婚姻法里面怎么规定是狗屁财产"},{"start":1005.08,"end":1005.56,"text":"什么东西"},{"start":1005.56,"end":1008.95,"text":"他只用婚前协议把这些东西都给他排除掉了嘛"},{"start":1008.95,"end":1011.08,"text":"对不对"},{"start":1012.28,"end":1014.52,"text":"那你说穷人又有多少钱可以分的"},{"start":1014.52,"end":1018.54,"text":"那么对于这些议题有极大的热忱去讨论"},{"start":1018.54,"end":1021.35,"text":"说这个东西涉及了什么财产啊"},{"start":1021.35,"end":1023.51,"text":"什么什么婚姻就是合法的卖淫"},{"start":1023.51,"end":1025.25,"text":"什么喜欢讨论这些东西的"},{"start":1025.25,"end":1025.79,"text":"不好意思"},{"start":1025.79,"end":1028.38,"text":"小自然意志啊"},{"start":1028.38,"end":1030.88,"text":"因为你还有的玩儿"},{"start":1030.88,"end":1034.119,"text":"在这里面就是进行一个权衡利弊啊"},{"start":1034.119,"end":1035.95,"text":"什么勾心斗角这东西"},{"start":1035.95,"end":1038.74,"text":"但是对于无产阶级来讲"},{"start":1038.74,"end":1041.72,"text":"他婚姻其实就是一个一方面"},{"start":1041.72,"end":1042.53,"text":"他是互保"},{"start":1042.53,"end":1044.27,"text":"表明他正经过日子"},{"start":1044.27,"end":1047.45,"text":"然后希望社会上把自己看成是正经人"},{"start":1047.45,"end":1048.59,"text":"不再是魔怔人"},{"start":1048.59,"end":1052.0,"text":"把你当成是正经过日子的人来评价"},{"start":1052.0,"end":1052.72,"text":"其次呢"},{"start":1052.72,"end":1054.37,"text":"相互之间确实也是互相帮助"},{"start":1054.37,"end":1055.9,"text":"互相忠诚的"},{"start":1055.9,"end":1057.46,"text":"互相扶持的"},{"start":1057.46,"end":1059.56,"text":"信忠诚其实都不算什么"},{"start":1059.56,"end":1063.94,"text":"信忠诚如果有暴露出来是这个财务上不忠诚"},{"start":1063.94,"end":1067.289,"text":"或者说是这个分工协作上的不忠诚的话"},{"start":1067.289,"end":1068.399,"text":"那就不行了"},{"start":1068.399,"end":1069.65,"text":"对不对"},{"start":1070.52,"end":1073.25,"text":"所以去幻想是什么"},{"start":1073.25,"end":1077.06,"text":"婚姻的实质是什么一种性花钱的性享乐啊"},{"start":1077.06,"end":1079.46,"text":"或者婚姻的实质是一种什么经济关系啊"},{"start":1079.46,"end":1082.37,"text":"什么这些东西他都没有切中他的要点"},{"start":1082.37,"end":1083.87,"text":"没有切中一个实质"},{"start":1086.39,"end":1088.46,"text":"啊没有切中一个实质"},{"start":1088.8,"end":1091.76,"text":"马克思的思维在这里是更成熟的"},{"start":1091.76,"end":1092.54,"text":"恩格斯不太成熟"},{"start":1092.54,"end":1096.55,"text":"恩格斯喜欢搞经济还原论不是太成熟"},{"start":1096.55,"end":1101.17,"text":"他没有看到婚姻模式背后的实质的一个政治"},{"start":1101.17,"end":1102.9,"text":"组织模式"},{"start":1103.12,"end":1104.37,"text":"他总是喜欢"},{"start":1104.37,"end":1105.6,"text":"就马克思主义"},{"start":1105.6,"end":1108.5,"text":"并不是说一切都可以还原成经济关系"},{"start":1108.84,"end":1111.8,"text":"而是经济关系本身分工"},{"start":1111.8,"end":1113.86,"text":"劳动性的生产性的分工"},{"start":1113.86,"end":1116.56,"text":"那你夫妻生活当中也是有劳动的"},{"start":1116.56,"end":1117.46,"text":"生产性的内容"},{"start":1117.46,"end":1118.42,"text":"不仅是家务"},{"start":1118.42,"end":1119.56,"text":"还有你的社会评价"},{"start":1119.56,"end":1120.37,"text":"社会地位"},{"start":1120.37,"end":1122.01,"text":"家庭的形象"},{"start":1122.01,"end":1124.65,"text":"个人的生活方式"},{"start":1124.65,"end":1126.63,"text":"这也是被生产出来的东西"},{"start":1126.63,"end":1128.55,"text":"在这种生产过程当中也有分工"},{"start":1128.55,"end":1129.73,"text":"也有剥削"},{"start":1129.73,"end":1130.96,"text":"也有压迫"},{"start":1130.96,"end":1132.25,"text":"也有政治性"},{"start":1132.25,"end":1135.98,"text":"也有权力和反抗"},{"start":1136.14,"end":1138.29,"text":"那么很多人不去思考这些东西"},{"start":1138.29,"end":1139.64,"text":"所以说在这个意义上讲"},{"start":1139.64,"end":1141.91,"text":"我是不太看得上恩格斯"},{"start":1141.91,"end":1144.43,"text":"恩格斯老说他搞第二国际"},{"start":1144.43,"end":1146.47,"text":"最后不就搞导向经济决定论嘛"},{"start":1146.47,"end":1148.25,"text":"然后变成一种等待论"},{"start":1149.13,"end":1150.53,"text":"消极保守的投机"},{"start":1152.09,"end":1154.33,"text":"这个东西档次都不高的"},{"start":1154.55,"end":1155.71,"text":"所以我说了"},{"start":1157.03,"end":1158.94,"text":"你如果是个列宁主义者"},{"start":1158.94,"end":1162.57,"text":"不要因为有些人就引经据典弄个什么恩格斯"},{"start":1162.57,"end":1166.32,"text":"弄个什么什么玩意嗯"},{"start":1166.32,"end":1167.46,"text":"你很可笑"},{"start":1167.46,"end":1167.76,"text":"你知道吗"},{"start":1167.76,"end":1168.48,"text":"先去结个婚"},{"start":1168.48,"end":1173.759,"text":"或者先去对于人与人现实之间的权力关系"},{"start":1173.759,"end":1176.369,"text":"力量的力有基本的了解"},{"start":1176.369,"end":1180.549,"text":"一是人和人家庭成员之间"},{"start":1180.549,"end":1184.329,"text":"家庭成员和外部的社会评价的媒介之间"},{"start":1184.329,"end":1188.33,"text":"以及治安机构和你本人之间"},{"start":1188.44,"end":1190.72,"text":"你们都没有经历过这些事情"},{"start":1191.74,"end":1193.04,"text":"你们都很无知"},{"start":1193.04,"end":1194.48,"text":"就不要妄自评论"},{"start":1194.48,"end":1195.8,"text":"你可以有一些幻想"},{"start":1195.8,"end":1197.06,"text":"有一些是什么哦"},{"start":1197.06,"end":1197.96,"text":"这是什么"},{"start":1197.96,"end":1198.5,"text":"这是什么"},{"start":1198.5,"end":1199.22,"text":"这是什么"},{"start":1199.22,"end":1202.99,"text":"但都是处在一个非常幼稚懵懂的状态"},{"start":1202.99,"end":1205.57,"text":"盲目的追求婚姻的所谓纯洁性"},{"start":1205.57,"end":1208.03,"text":"圣洁性什么东西"},{"start":1210.42,"end":1211.58,"text":"对无产阶级来讲"},{"start":1211.58,"end":1213.56,"text":"婚姻其实更代表就是五个字"},{"start":1213.56,"end":1215.32,"text":"本分过日子"},{"start":1215.32,"end":1216.85,"text":"日本分"},{"start":1216.85,"end":1218.02,"text":"他是日子人"},{"start":1218.02,"end":1218.98,"text":"也是本分人"},{"start":1218.98,"end":1220.99,"text":"但是他是本分的日子人"},{"start":1220.99,"end":1223.83,"text":"那很有可能他就不是日子人"},{"start":1224.05,"end":1225.51,"text":"他也不简简"},{"start":1225.51,"end":1227.16,"text":"单单是个本分人"},{"start":1227.16,"end":1230.139,"text":"而是他是一个非常坚定的"},{"start":1230.359,"end":1231.969,"text":"也可以说很保守"},{"start":1231.969,"end":1234.339,"text":"但是这个保守不是那种浑浑噩噩的"},{"start":1234.339,"end":1236.589,"text":"保守是很锐利的"},{"start":1236.589,"end":1238.28,"text":"是很明确的"},{"start":1238.28,"end":1240.61,"text":"是很强硬的保守"},{"start":1240.61,"end":1243.46,"text":"那么这个其实和无产阶级的婚姻的底色"},{"start":1243.46,"end":1244.27,"text":"锐利的"},{"start":1244.27,"end":1247.08,"text":"强硬的坚定的保守"},{"start":1247.36,"end":1249.12,"text":"这里面也有某种爱情"},{"start":1249.12,"end":1251.94,"text":"这个爱情可能是城市小资人及学生小白领"},{"start":1251.94,"end":1256.35,"text":"他们不愿意去触碰的理解的一种爱情"},{"start":1256.81,"end":1258.57,"text":"这个爱情是一种坚定性的"},{"start":1258.57,"end":1261.33,"text":"对自己家庭的利益的一个强力的"},{"start":1261.33,"end":1263.28,"text":"非常强力的维持"},{"start":1263.62,"end":1268.5,"text":"一个非常强硬的一个一个互相保证"},{"start":1268.5,"end":1271.34,"text":"二人堡垒很强的"},{"start":1271.34,"end":1272.57,"text":"非常强硬的"},{"start":1272.57,"end":1275.75,"text":"然后这种二人堡垒他又家庭"},{"start":1275.75,"end":1278.389,"text":"家庭组合又会成为宗族"},{"start":1278.389,"end":1279.409,"text":"我说这关系"},{"start":1279.409,"end":1282.169,"text":"当然它是某种意义上是前现代的没错"},{"start":1282.169,"end":1285.139,"text":"但是他是现在普遍状态"},{"start":1285.139,"end":1291.0,"text":"但是治理这些这些小堡垒和堡垒群的呃"},{"start":1291.0,"end":1294.93,"text":"这个法律和治安力量他不是前现代的"},{"start":1294.93,"end":1296.58,"text":"它是现代的"},{"start":1296.58,"end":1297.87,"text":"他是现代人"},{"start":1297.87,"end":1301.02,"text":"所以他的思路是其实很明确的"},{"start":1301.02,"end":1302.93,"text":"就是我刚刚讲的那套理论"},{"start":1302.93,"end":1304.73,"text":"合法性的生产机制"},{"start":1304.73,"end":1306.38,"text":"社会评定评价"},{"start":1306.38,"end":1309.96,"text":"以及相应的这些权利义务关系"},{"start":1316.12,"end":1317.64,"text":"可能给一个城市给你们"},{"start":1317.64,"end":1318.12,"text":"给一个县"},{"start":1318.12,"end":1319.8,"text":"给你们去运运营一段时间"},{"start":1319.8,"end":1322.94,"text":"你就大概知道这个立法思路了"},{"start":1322.94,"end":1325.52,"text":"但你们既不拥有一个县"},{"start":1325.52,"end":1329.12,"text":"你们也未曾拥有过任何一段婚姻"},{"start":1329.12,"end":1334.28,"text":"也没有在婚姻当中和周围的十几20号人"},{"start":1334.28,"end":1338.29,"text":"上百号人打过实施的交道"},{"start":1338.29,"end":1340.45,"text":"就算浑浑噩噩的结婚了"},{"start":1340.45,"end":1343.15,"text":"也没有对于自己这些关系关联"},{"start":1343.15,"end":1344.83,"text":"有一个比较严肃的"},{"start":1344.83,"end":1348.63,"text":"比较现实的一个思考考虑"},{"start":1349.9,"end":1351.12,"text":"所以我就很纳闷"},{"start":1351.12,"end":1355.08,"text":"就一个一个刚刚当兵退伍的"},{"start":1355.08,"end":1360.059,"text":"什么什么一个都没结过婚纱"},{"start":1360.059,"end":1362.459,"text":"那一个我不知道他们结结没结过婚人"},{"start":1362.459,"end":1367.39,"text":"他们一个幼稚的小孩可以讨论这东西啊"},{"start":1367.39,"end":1368.38,"text":"那我就讲到这里"},{"start":1368.38,"end":1371.5,"text":"我希望你们不要妄自去评价"},{"start":1371.5,"end":1375.23,"text":"妄自去对这东西做模板化的理解"},{"start":1375.23,"end":1377.27,"text":"这都会造成悲剧的"},{"start":1377.27,"end":1378.65,"text":"我现身说法告诉你"},{"start":1378.65,"end":1380.63,"text":"如果你对婚姻有刻板印象的话"},{"start":1380.63,"end":1385.21,"text":"你很有可能会莫名其妙就会损失你的婚姻"},{"start":1385.21,"end":1390.34,"text":"或者说就伤害你和伴侣的情感或者怎么样的啊"},{"start":1390.34,"end":1392.17,"text":"这都是一种很无知的"},{"start":1392.17,"end":1394.9,"text":"低幼的可笑的"},{"start":1394.9,"end":1398.62,"text":"因为比如说你觉得你对自己生活方式不满意"},{"start":1398.62,"end":1401.2,"text":"或者说一个生存运行的方向不满意"},{"start":1401.2,"end":1404.089,"text":"其实你能做调整是很多的"},{"start":1404.089,"end":1406.069,"text":"是非常多的啊"},{"start":1406.069,"end":1409.54,"text":"能做的这个改变是非常多的婚姻"},{"start":1409.54,"end":1413.8,"text":"It shouldn't be the last one to adjust your marriage"},{"start":1413.8,"end":1415.38,"text":"不是刘备啊"},{"start":1415.38,"end":1418.26,"text":"跑到那个什么刘璋那边把他嫂子给娶了"},{"start":1418.26,"end":1421.8,"text":"是要和本地世家大族利益勾兑的"},{"start":1421.8,"end":1424.8,"text":"婚姻并不具有性啊"},{"start":1424.8,"end":1428.85,"text":"所以他并不妨碍你成为一个什么样的人"},{"start":1428.85,"end":1431.22,"text":"你不能成为那样一种人"},{"start":1431.22,"end":1432.889,"text":"不能过上那种生活"},{"start":1432.889,"end":1435.769,"text":"绝大部分是因为就是你的能力"},{"start":1436.909,"end":1441.31,"text":"以及你做的努力啊不够"},{"start":1441.31,"end":1444.91,"text":"或者你没有没有没有那个真正的勇气和决心"},{"start":1444.91,"end":1447.1,"text":"和真正脚踏实地的那个转变"},{"start":1447.1,"end":1449.38,"text":"去支撑你对于一种生活的追求"},{"start":1449.38,"end":1452.33,"text":"那就迁怒于伴侣指责"},{"start":1452.33,"end":1454.43,"text":"或者说要去消解瓦解你的婚姻"},{"start":1454.43,"end":1455.75,"text":"这是一个错误的选择"},{"start":1455.75,"end":1457.1,"text":"我明确告诉你"},{"start":1457.1,"end":1458.42,"text":"好吧啊"},{"start":1458.42,"end":1459.23,"text":"明确告诉你"},{"start":1459.23,"end":1460.82,"text":"那就讲到这里啊"},{"start":1460.82,"end":1463.34,"text":"那讲到这里也不要因为这些东西"},{"start":1463.34,"end":1465.02,"text":"这些视频内容就恐婚啊"},{"start":1465.02,"end":1465.89,"text":"就是拒婚"},{"start":1465.89,"end":1469.25,"text":"怎么样的婚姻"},{"start":1469.25,"end":1470.18,"text":"我再明确一点"},{"start":1470.18,"end":1474.13,"text":"他首先是在社会公众评价当中"},{"start":1474.13,"end":1479.189,"text":"一个啊互相做保证"},{"start":1479.189,"end":1483.0,"text":"做保人啊"},{"start":1483.0,"end":1485.07,"text":"所以我们在这里我们就要说"},{"start":1485.07,"end":1488.75,"text":"婚姻是前现代关系的一个现代的残余"},{"start":1489.51,"end":1492.17,"text":"现代社会当中可以普遍的"},{"start":1492.17,"end":1495.47,"text":"每个社会都有的一个残余"},{"start":1497.72,"end":1501.4,"text":"婚姻他是个共父共母的一个结构"},{"start":1501.4,"end":1502.9,"text":"Father in law"},{"start":1502.9,"end":1503.8,"text":"Mother in law"},{"start":1503.8,"end":1506.179,"text":"共父共母啊"},{"start":1506.179,"end":1508.459,"text":"所以在我们的树正学体系里面"},{"start":1508.459,"end":1514.86,"text":"它会被放在这个比较后面的环节啊"},{"start":1514.86,"end":1516.09,"text":"啊比较后面的环节"},{"start":1516.09,"end":1517.889,"text":"但是它是一个重要的环节"},{"start":1517.889,"end":1520.229,"text":"树正学体系它是个重要环节"},{"start":1520.229,"end":1522.929,"text":"比较后面的环节好吧"},{"start":1522.929,"end":1523.829,"text":"那就讲到这里啊"},{"start":1523.829,"end":1524.92,"text":"那就讲到这里"}],"source":"subtitle"}
