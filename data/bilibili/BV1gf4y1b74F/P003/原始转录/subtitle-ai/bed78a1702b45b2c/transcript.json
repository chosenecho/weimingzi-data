  "segments": [
    {
      "ordinal": 0,
      "start_ms": 1320,
      "end_ms": 3870,
      "text": "别人不把你当亲不亲"
    },
    {
      "ordinal": 1,
      "start_ms": 3870,
      "end_ms": 6170,
      "text": "什么分单积分啊"
    },
    {
      "ordinal": 2,
      "start_ms": 6170,
      "end_ms": 6710,
      "text": "清不清"
    },
    {
      "ordinal": 3,
      "start_ms": 6710,
      "end_ms": 8148,
      "text": "别人不把我当共同体"
    },
    {
      "ordinal": 4,
      "start_ms": 8148,
      "end_ms": 10309,
      "text": "就这种人刚刚那个说什么啊"
    },
    {
      "ordinal": 5,
      "start_ms": 10309,
      "end_ms": 12229,
      "text": "你在办公室里大吼一声的"
    },
    {
      "ordinal": 6,
      "start_ms": 12229,
      "end_ms": 14029,
      "text": "所以别人不把你当共同体的"
    },
    {
      "ordinal": 7,
      "start_ms": 14029,
      "end_ms": 14910,
      "text": "笑死了"
    },
    {
      "ordinal": 8,
      "start_ms": 14910,
      "end_ms": 17010,
      "text": "别人就不把你当共同体呢"
    },
    {
      "ordinal": 9,
      "start_ms": 17010,
      "end_ms": 18390,
      "text": "别人你知道别人拿别人吗"
    },
    {
      "ordinal": 10,
      "start_ms": 18390,
      "end_ms": 20340,
      "text": "你的同事会不把你当共同体吗"
    },
    {
      "ordinal": 11,
      "start_ms": 23680,
      "end_ms": 29660,
      "text": "等于说你的一个一个一个一个一个一个这个项目里面的十个同事"
    },
    {
      "ordinal": 12,
      "start_ms": 29860,
      "end_ms": 31900,
      "text": "除了一个那个主管负责之外"
    },
    {
      "ordinal": 13,
      "start_ms": 31900,
      "end_ms": 33220,
      "text": "其他九个全是奋斗逼"
    },
    {
      "ordinal": 14,
      "start_ms": 33220,
      "end_ms": 34060,
      "text": "或者全是舔狗"
    },
    {
      "ordinal": 15,
      "start_ms": 34060,
      "end_ms": 34840,
      "text": "全是死忠"
    },
    {
      "ordinal": 16,
      "start_ms": 38980,
      "end_ms": 40030,
      "text": "我靠全这种人"
    },
    {
      "ordinal": 17,
      "start_ms": 40030,
      "end_ms": 42260,
      "text": "就你一个大喊一声996"
    },
    {
      "ordinal": 18,
      "start_ms": 43040,
      "end_ms": 47170,
      "text": "然后你就不被这其他九个人全全都白治你了"
    },
    {
      "ordinal": 19,
      "start_ms": 47170,
      "end_ms": 48940,
      "text": "那我觉得你赶紧跑啊"
    },
    {
      "ordinal": 20,
      "start_ms": 48940,
      "end_ms": 49600,
      "text": "你神经病啊"
    },
    {
      "ordinal": 21,
      "start_ms": 49600,
      "end_ms": 51980,
      "text": "我靠这种情况你不快跑"
    },
    {
      "ordinal": 22,
      "start_ms": 52780,
      "end_ms": 55380,
      "text": "这种情况你不是就九个人骑你头上"
    },
    {
      "ordinal": 23,
      "start_ms": 55380,
      "end_ms": 57660,
      "text": "其他全是全是他们自己人"
    },
    {
      "ordinal": 24,
      "start_ms": 58560,
      "end_ms": 60350,
      "text": "我说的是极端情况"
    },
    {
      "ordinal": 25,
      "start_ms": 60350,
      "end_ms": 61599,
      "text": "大吼一声"
    },
    {
      "ordinal": 26,
      "start_ms": 61840,
      "end_ms": 64870,
      "text": "你平时你可以用另外的形式啊"
    },
    {
      "ordinal": 27,
      "start_ms": 64870,
      "end_ms": 66520,
      "text": "你看不能有另外的形式"
    },
    {
      "ordinal": 28,
      "start_ms": 66520,
      "end_ms": 68740,
      "text": "different kinds of with"
    },
    {
      "ordinal": 29,
      "start_ms": 68740,
      "end_ms": 69880,
      "text": "就是策略"
    },
    {
      "ordinal": 30,
      "start_ms": 69880,
      "end_ms": 71740,
      "text": "你可以有不同的形式啊"
    },
    {
      "ordinal": 31,
      "start_ms": 73720,
      "end_ms": 75840,
      "text": "你可以想办法想出路啊"
    },
    {
      "ordinal": 32,
      "start_ms": 75840,
      "end_ms": 76770,
      "text": "我再说一遍"
    },
    {
      "ordinal": 33,
      "start_ms": 76770,
      "end_ms": 78360,
      "text": "想办法想出路"
    },
    {
      "ordinal": 34,
      "start_ms": 78360,
      "end_ms": 80000,
      "text": "想办法想出路"
    },
    {
      "ordinal": 35,
      "start_ms": 80860,
      "end_ms": 83850,
      "text": "我觉得就是人活一张嘴"
    },
    {
      "ordinal": 36,
      "start_ms": 83850,
      "end_ms": 86340,
      "text": "一双手一双腿"
    },
    {
      "ordinal": 37,
      "start_ms": 86340,
      "end_ms": 87990,
      "text": "你吃得下手"
    },
    {
      "ordinal": 38,
      "start_ms": 87990,
      "end_ms": 89280,
      "text": "做的动脚"
    },
    {
      "ordinal": 39,
      "start_ms": 89280,
      "end_ms": 92300,
      "text": "能够选择你的去向就行啊"
    },
    {
      "ordinal": 40,
      "start_ms": 92960,
      "end_ms": 94280,
      "text": "就可以呀"
    },
    {
      "ordinal": 41,
      "start_ms": 94680,
      "end_ms": 96390,
      "text": "你学的那个技能"
    },
    {
      "ordinal": 42,
      "start_ms": 96390,
      "end_ms": 97860,
      "text": "只要它是个技能"
    },
    {
      "ordinal": 43,
      "start_ms": 97860,
      "end_ms": 102270,
      "text": "只要他能够为社会生产提供有序度对吧"
    },
    {
      "ordinal": 44,
      "start_ms": 102270,
      "end_ms": 103560,
      "text": "消费环节有序度"
    },
    {
      "ordinal": 45,
      "start_ms": 103560,
      "end_ms": 104520,
      "text": "生产环节有度"
    },
    {
      "ordinal": 46,
      "start_ms": 104520,
      "end_ms": 106539,
      "text": "分配环节有度有序度"
    },
    {
      "ordinal": 47,
      "start_ms": 107180,
      "end_ms": 109000,
      "text": "只要是有序度"
    },
    {
      "ordinal": 48,
      "start_ms": 109000,
      "end_ms": 110320,
      "text": "你可以作为一个人"
    },
    {
      "ordinal": 49,
      "start_ms": 110320,
      "end_ms": 111640,
      "text": "你愿意集中精神"
    },
    {
      "ordinal": 50,
      "start_ms": 111640,
      "end_ms": 117530,
      "text": "用你的自信思维去创造出有意义的有价值的这种结构出来"
    },
    {
      "ordinal": 51,
      "start_ms": 117530,
      "end_ms": 119380,
      "text": "我觉得你到哪里都能吃饭"
    },
    {
      "ordinal": 52,
      "start_ms": 120500,
      "end_ms": 123340,
      "text": "就是你要你要你要你要你要付出努力"
    },
    {
      "ordinal": 53,
      "start_ms": 123340,
      "end_ms": 126700,
      "text": "要积攒出一些成本和和你的筹码"
    },
    {
      "ordinal": 54,
      "start_ms": 126700,
      "end_ms": 128620,
      "text": "哪怕再小也是个筹码"
    },
    {
      "ordinal": 55,
      "start_ms": 129000,
      "end_ms": 130440,
      "text": "他能不能失信"
    },
    {
      "ordinal": 56,
      "start_ms": 130440,
      "end_ms": 131340,
      "text": "名单以后找到工作"
    },
    {
      "ordinal": 57,
      "start_ms": 131340,
      "end_ms": 132660,
      "text": "你别在这个圈子混的呀"
    },
    {
      "ordinal": 58,
      "start_ms": 132660,
      "end_ms": 135090,
      "text": "你根本就不做这一行不就行了"
    },
    {
      "ordinal": 59,
      "start_ms": 135090,
      "end_ms": 137419,
      "text": "你就是学这个学路径"
    },
    {
      "ordinal": 60,
      "start_ms": 137419,
      "end_ms": 137839,
      "text": "依赖了"
    },
    {
      "ordinal": 61,
      "start_ms": 137839,
      "end_ms": 138559,
      "text": "学了个代码"
    },
    {
      "ordinal": 62,
      "start_ms": 138559,
      "end_ms": 139699,
      "text": "就因为他们弄了个名单"
    },
    {
      "ordinal": 63,
      "start_ms": 139699,
      "end_ms": 142909,
      "text": "所以你要把你的青春血汗全都燃烧在这里面"
    },
    {
      "ordinal": 64,
      "start_ms": 142909,
      "end_ms": 146540,
      "text": "就因为那份名单还不一定有没有名单的"
    },
    {
      "ordinal": 65,
      "start_ms": 146540,
      "end_ms": 148100,
      "text": "有可能是骗你的"
    },
    {
      "ordinal": 66,
      "start_ms": 151800,
      "end_ms": 153470,
      "text": "你不能走吗"
    }
