{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed enrich operation payload v1",
  "description": "The trusted per-table policy further restricts fields and metadata keys. References, source evidence and media observations require semantic validation.",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$", "maxLength": 128},
      "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true}
    },
    "urls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048}},
    "relations": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["target_item_id", "kind", "evidence"],
        "properties": {
          "target_item_id": {"$ref": "#/$defs/recordId"},
          "kind": {"enum": ["has_full_text", "references_video", "references"]},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 4096}
        }
      }
    },
    "audio_ids": {"$ref": "#/$defs/references"},
    "article_item_ids": {"$ref": "#/$defs/references"},
    "item_ids": {"$ref": "#/$defs/references"}
  },
  "$defs": {
    "recordId": {"type": "string", "pattern": "^[a-z]-[0-9a-f]{24,64}$"},
    "references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/recordId"}}
  }
}
