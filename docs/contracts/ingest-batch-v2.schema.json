{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Current native four-entity ingest manifest, contract 2",
  "description": "The only accepted ingest contract. Payloads are complete native schema-3 records. Runtime validation additionally enforces file bytes, canonical digests, one-to-one entity operations, fixed source scope, consumer-owned permissions, identity/CAS rules and the whole candidate graph. No historical table or producer adapters exist.",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "kind", "record_schema_version", "batch_id", "target", "producer", "source_scope", "base_commit", "created_at", "requires_batches", "sources", "files", "operations"],
  "properties": {
    "contract_version": {"const": 2},
    "kind": {"const": "weimingzi_native_increment"},
    "record_schema_version": {"const": 3},
    "batch_id": {"$ref": "#/$defs/sha256"},
    "target": {"const": {"repository": "chosenecho/weimingzi-data", "branch": "main"}},
    "source_scope": {"const": {"platform": "bilibili", "target_uid": "23191782"}},
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "code_revision", "run_id"],
      "properties": {
        "name": {"const": "weimingzi-bilibili-ingest"},
        "code_revision": {"$ref": "#/$defs/commit"},
        "run_id": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}
      }
    },
    "base_commit": {"$ref": "#/$defs/commit"},
    "created_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "requires_batches": {"type": "array", "maxItems": 2000, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "sources": {"type": "array", "minItems": 1, "maxItems": 2000, "items": {"$ref": "#/$defs/source"}},
    "files": {"type": "array", "minItems": 1, "maxItems": 2000, "items": {"$ref": "#/$defs/file"}},
    "operations": {"type": "array", "minItems": 1, "maxItems": 2000, "items": {"$ref": "#/$defs/operation"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "safe": {"type": "string", "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "path": {"type": "string", "maxLength": 200, "pattern": "^records/(items|documents|assets|annotations)/[a-z]-[0-9a-f]{24,64}\\.json$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "namespace", "external_id", "publisher_uid", "url", "observed_at", "relation", "referenced_by"],
      "properties": {
        "source_id": {"$ref": "#/$defs/safe"},
        "namespace": {"enum": ["bilibili_bvid", "bilibili_dynamic", "bilibili_cvid", "bilibili_opus"]},
        "external_id": {"type": "string", "maxLength": 128},
        "publisher_uid": {"oneOf": [{"type": "string", "pattern": "^[0-9]{1,32}$"}, {"type": "null"}]},
        "url": {"type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://(?:(?:www|t|m)\\.)?bilibili\\.com(?::443)?/"},
        "observed_at": {"type": "string", "format": "date-time", "maxLength": 64},
        "relation": {"enum": ["target_publication", "referenced_content"]},
        "referenced_by": {"type": "array", "maxItems": 2000, "uniqueItems": true, "items": {"$ref": "#/$defs/safe"}},
        "cid": {"type": "string", "pattern": "^[0-9]{1,32}$"},
        "part_number": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {"if": {"properties": {"namespace": {"const": "bilibili_bvid"}}}, "then": {"properties": {"external_id": {"pattern": "^BV[0-9A-Za-z]{10}$"}}}, "else": {"properties": {"external_id": {"pattern": "^[0-9]{1,32}$"}}}},
        {"if": {"properties": {"relation": {"const": "target_publication"}}}, "then": {"properties": {"publisher_uid": {"const": "23191782"}, "referenced_by": {"maxItems": 0}}}, "else": {"properties": {"referenced_by": {"minItems": 1}}}},
        {"if": {"required": ["part_number"]}, "then": {"required": ["cid"], "properties": {"namespace": {"const": "bilibili_bvid"}}}},
        {"if": {"required": ["cid"]}, "then": {"properties": {"namespace": {"const": "bilibili_bvid"}}}}
      ]
    },
    "file": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216}}
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["op", "entity", "record_id", "path", "payload_sha256", "expected_record_sha256", "source_refs"],
      "properties": {
        "op": {"enum": ["insert", "replace"]},
        "entity": {"enum": ["items", "documents", "assets", "annotations"]},
        "record_id": {"type": "string", "pattern": "^[a-z]-[0-9a-f]{24,64}$"},
        "path": {"$ref": "#/$defs/path"},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "expected_record_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "source_refs": {"type": "array", "minItems": 1, "maxItems": 2000, "uniqueItems": true, "items": {"$ref": "#/$defs/safe"}}
      },
      "allOf": [{"if": {"properties": {"op": {"const": "insert"}}}, "then": {"properties": {"expected_record_sha256": {"type": "null"}}}, "else": {"properties": {"expected_record_sha256": {"$ref": "#/$defs/sha256"}}}}]
    }
  }
}
